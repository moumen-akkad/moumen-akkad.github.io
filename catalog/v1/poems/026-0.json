{"v":1,"poems":{"359C8FCB-88E1-53EC-B5B1-5ADCF3267A54":{"t":"أرتك بذات الضال منها معاصماً","p":26,"s":"أرتك بذات الضال منها معاصما","r":"437432","v":[["CB56A48E-9026-54AE-96EB-E25AEEC07BC7","أَرَتكَ بِذاتِ الضالِ مِنها مَعاصِماً","وَخَدّاً أَسيلاً كَالوَذيلَةِ ناعِما"]]},"90E802D7-B6A4-5D43-B666-CC2B495B2E91":{"t":"أرحلت من سلمى بغيرِ متاع","p":26,"s":"أرحلت من سلمى بغير متاع","r":"437417","v":[["48F6C404-FBEA-519D-93AB-C9481EB618EA","أَرَحَلتَ مِن سَلمى بِغَيرِ مَتاعِ","قَبلَ العُطاسِ وَرُعتَها بِوَداعِ"],["AAA3E56E-B252-55AF-ABE2-2BA265284ECA","مِن غَيرِ مَقلِيَةٍ وَإِنَّ حِبالَها","لَيسَت بِأَرمامٍ وَلا أَقطاعِ"],["7F8CF8B8-BC3D-5113-A95D-E86CAFC4CCB1","إِذ تَستَبيكَ بِأَصلَتِيٍّ ناعِمٍ","قامَت لِتَفتِنَهُ بِغَيرِ قِناعِ"],["7DB67F4B-48E9-538D-9A7A-2F17BAC47F51","وَمَهاً يَرُفُّ كَأَنَّهُ إِذ ذُقتَهُ","عانِيَّةٌ شُجَّت بِماءِ وِقاعِ"],["CE544ECD-E1A5-5AF6-8678-B4C77F0F00A4","أَو صَوبُ غادِيَةٍ أَدَرَّتهُ الصَبا","بِبَزيلِ أَزهَرَ مُدمَجٍ بِسَياعِ"],["878626D6-27D4-5145-B361-18DC38578A7B","فَرَأَيتُ أَنَّ الحُكمَ مُجتَنِبُ الصِبا","وَصَحَوتُ بَعدَ تَشَوُّقٍ وَرُواعِ"],["CA70C65E-A8D2-5B3E-9041-1A2CD8E2BBA8","فَتَسَلَّ حاجَتَها إِذا هِيَ أَعرَضَت","بِخَميصَةٍ سُرُحِ اليَدَينِ وِساعِ"],["BBA67937-D9EF-5971-9812-C08C5913FCB8","صَكّاءَ ذِعلِبَةٍ إِذا اِستَدبَرتَها","حَرَجٍ إِذا اِستَقبَلَتها هِلواعِ"],["3A68AF3F-F815-541E-B314-F299E86D4F0A","وَكَأَنَّ قِنطَرَةً بِمَوضِعِ كورِها","مَلساءَ بَينَ غَوامِضِ الأَنساعِ"],["AC1B1795-A952-5C92-9A11-325DDFBE62FB","وَإِذا تَعاوَرَتِ الحَصا أَخفافُها","دَوّى نَواديهِ بِظَهرِ القاعِ"],["654D5617-2226-5BBC-A8BE-BFE034C4882F","وَكَأَنَّ غارِبَها رَباوَةُ مَخرَمٍ","وَتَمُدُّ ثِنيَ جَديلِها بِشِراعِ"],["44C4BD0F-9EC2-5180-A661-DD098A6E6DE2","وَإِذا أَطَفتَ بِها أَطَفتَ بِكَلكَلٍ","نَبِضِ الفَرائِصِ مُجفَرِ الأَضلاعِ"],["1FA3C1C6-EF3E-5B21-950A-00546B9A0407","مَرِحَت يَداها لِلنَجاءِ كَأَنَّما","تَكرو بِكَفَّي لاعِبٍ في صاعِ"],["67A2E8FA-7943-5C0E-8F8F-AEA767FEF24A","فِعلَ السَريعَةِ بادَرَت جُدّادَها","قَبلَ المَساءِ تَهُمُّ بِالإِسراعِ"],["4755796F-B7CD-54C6-9ED7-E91FB9A2BB7B","فَلَأُهدِيَنَّ مَعَ الرِياحِ قَصيدَةً","مِنّي مُغَلغَلَةً إِلى القَعقاعِ"],["1A4854D0-0CA2-5256-A43D-28EF0ADE53F6","تَرِدُ المِياهَ فَما تَزالُ غَريبَةً","في القَومِ بَينَ تَمَثُّلٍ وَسَماعِ"],["8F50ABAA-46F1-5886-A11F-84E5B3B1F71C","وَإِذا المُلوكُ تَدافَعَت أَركانُها","أَفضَلتَ فَوقَ أَكُفِّهِم بِذِراعِ"],["960D12BC-3739-56CD-AF6D-6DE164CE0FD5","وَإِذا تَهيجُ الريحُ مِن صُرّادِها","ثَلجاً يُنيخُ النَيبَ بِالجَعجاعِ"],["1A8A9C71-D40E-5DCA-9F8D-19497CA43720","أَحلَلتَ بَيتَكَ بِالجَميعِ وَبَعضُهُم","مُتَفَرِّقٌ لِيَحُلَّ بِالأَوزاعِ"],["F380A3E2-D2DF-517D-B1EE-3F05B7D79870","وَلَأَنتَ أَجوَدُ مِن خَليجٍ مُفعَمٍ","مُتَراكِمِ الآذِيِّ ذي دُفّاعِ"],["FC45D438-AFC7-5911-800D-BC6356F17443","وَكَأَنَّ بُلقَ الخَيلِ في حافاتِهِ","يَرمي بِهِنَّ دَوالِيَ الزُرّاعِ"],["283C4657-5D2F-518E-A3CC-ACD70CFAC9E5","وَلَأَنتَ أَشجَعُ في الأَعادي كُلِّها","مِن مُخدِرٍ لَيثٍ مُعيدِ وِقاعِ"],["70B27685-53FE-5648-896E-C20EE4D1891C","يَأتي عَلى القَومِ الكَثيرِ سِلاحُهُم","فَيَبيتُ مِنهُ القَومُ في وَعواعِ"],["35F0F452-7EFE-5AC6-AD39-F5C67D4F3C08","أَنتَ الوَفِيُّ فَما تُذَمُّ وَبَعضُهُم","تودي بِذِمَّتِهِ عُقابُ مَلاعِ"],["34D435B5-E17A-582A-9C99-92D2AE4DD0CA","وَإِذا رَماهُ الكاشِحونَ رَماهُمُ","بِمَعابِلَ مَذروبَةٍ وَقِطاعِ"],["CCC9F525-6C0E-5A8D-A7F7-87661232AC29","وَلِذاكُمُ زَعَمَت تَميمٌ أَنَّهُ","أَهلُ السَماحَةِ وَالنَدى وَالباعِ"]]},"C72074BF-8F40-5D8F-9D5E-FC0E345B8796":{"t":"ألا اِنعم صباحاً أيها الربعُ واِسلم","p":26,"s":"ألا انعم صباحا أيها الربع واسلم","r":"437428","v":[["3A63FDE3-E4F5-5F84-9FF1-850DE913B8C6","أَلا اِنعِم صَباحاً أَيُّها الرَبعُ وَاِسلَمِ","نُحَيّيكَ عَن شَحطٍ وَإِن لَم تَكَلَّمِ"],["444B5872-5D4E-5F04-A420-02AA2C500991","وَقَد أَتَناسى الهَمَّ عِندَ اِحتِضارِهِ","بِناجٍ عَلَيهِ الصَيعَرِيَّةُ مُكدَمِ"],["C8269067-A1FE-5E91-864A-8925E702B36E","كُمَيتٍ كِنازِ اللَحمِ أَو حِميَرِيَّةٍ","مُواشِكَةٍ تَنفي الحَصا بِمُلَثَّمِ"],["4DEEDCD5-7DBF-59D4-B872-D1F68B33B8B1","كَأَنَّ عَلى أَنسائِهِ عِذقَ خَصبَةٍ","تَدَلّى مِنَ الكافورِ غَيرَ مُكَمَّمِ"],["32684083-C482-551E-9A26-7C7DFC5272FD","أَكَبَّت عَلَيها الهالِكِيَّةُ مُسلَماً","هُوَيلَةُ حَتّى زَيَّنَتهُ بِميشَمِ"]]},"0ACB4F12-8E0A-539B-9D81-D8E1122DA6AA":{"t":"أَبلغ ضبيعة أَن البلا","p":26,"s":"أبلغ ضبيعة أن البلا","r":"437406","v":[["5E43C1FE-D3CC-5D5F-86BC-F7F2303560DC","أَبلِغ ضُبَيعَة أَنَّ البِلا","دَ فيها لِذي حَسَبٍ مَهرَبُ"],["7B6359A3-4966-546D-9EB0-E404B7ABB85A","فَقَد يَجلِسُ القَومُ في أَصلِهِم","إِذا لَم يُضاموا وَإِن أَجدَبوا"],["5A77A0BD-DD3C-51C0-8573-21209ADCC2AB","فَإِنَّ الَّذي كُنتُمُ تَحذَرو","نَ جاءَت عُيونٌ بِهِ تَضرِبُ"],["62AB56EA-0996-5FD7-99D3-29CADAFB4A8C","فَلا تَجلِسوا غَرَضاً لِلمَنو","نِ حَذفاً كَما تُحذَفُ الأَرنَبُ"],["5FF40E45-3BC9-5DBA-AB84-FB4FC2D47917","وَسيروا عَلى إِثرِ أولاكُمُ","وَلا تَنظُروا مِثلَها وَاِذهَبوا"],["2A4BF191-7D00-5B28-B6E1-CE689DC83000","فَإِنَّ مَواليكُمُ أَصفَقوا","فَكُلُّهُمُ جَنبُهُ أَجرَبُ"],["C6FEF73D-5467-5F4D-811F-1098790DF4DB","وَإِنَّهُمُ قَد دَعَوا دَعوَةً","سَيَتبَعُها ذَنَبٌ أَهلَبُ"],["E54F6A87-9126-5F57-A4F6-3C91EBDF2AE1","سَتَحمِلُ قَوماً عَلى آلَةٍ","تَظَلُّ الرِماحُ بِهِم تَعلُبُ"],["F2135B0F-A8D5-54B8-BCF2-46F62FECCCE4","وَلَولا عُلالَةُ أَرماحِنا","لَظَلَّت نِساؤُهُمُ تُجنَبُ"],["029B7766-10EA-5E3A-91ED-6B0BDE63762E","فَإِن لَم تَكُن بِكُمُ مُنَّةٌ","يُبَلِّغُها البَلَدَ الأَركَبُ"],["3D1BEB00-76E1-566B-8778-B65BE77BBA33","فَذيخوا عَبيداً لِأَربابِكُم","فَإِن ساءَكُم ذاكُمُ فَاِغضَبوا"],["F14BB6F9-6FDB-5DA6-915C-D9D3C686CCF1","وَهَل يَجلِسُ القَومُ لا يُنكِرونَ","وَكُلُّهُمُ أَنفُهُ يُضرَبُ"],["7F34570A-970B-552E-A303-FF5961381E70","وَسيروا فَإِنّي لَكُم بِالرِضى","عَرانينَ شَيبانَ أَن تَقرَبوا"],["891935B5-4006-50E6-826E-8BCC8478F47A","فَلا هاهُناكَ وَلا هاهُنا","لَكُم مَوئِلٌ غَيرُهُم فَاِنصِبوا"],["817BFB38-F66C-509B-A3FC-CBCAC51C8317","لِفَرعِ نِزارٍ وَهُم أَصلُها","نَما بِهِمُ العِزُّ فَاِغلَولَبوا"],["52796AC1-FE5D-5EEE-B739-45C8335E547A","وَيَومَ العِيانَةِ عِندَ الكَثي","بِ يَومٌ أَشائِمُهُ تَنعَبُ"],["A3ED87FE-55A7-5F4E-87D7-DC638D1DA4AB","تَبيتُ المُلوكُ عَلى عَتبِها","وَشَيبانُ إِن غَضِبَت تُعتَبُ"],["B1424DB6-58F9-5A36-A1F8-BC159205857E","وَكَالشُهدِ بِالراحِ أَخلاقُهُم","وَأَحلامُهُم مِنهُما أَعذَبُ"],["8575110A-9FF3-59B3-8331-4E5DB51EE42D","وَكَالمِسكِ تُربُ مَقاماتِهِم","وَرَيّا قُبورِهِمُ أَطيَبُ"],["CD11F41A-B5C9-54E4-ADC6-771F602296A7","وَقَد كانَ سامَةُ في قَومِهِ","لَهُ مَأكَلٌ وَلَهُ مَشرَبُ"],["4EDFB3C7-CBD1-57AD-AC4A-805C3F97ECEA","فَساموهُ خَسفاً فَلَم يَرضَهُ","وَفي الأَرضِ عَن خَسفِهِم مَذهَبُ"],["EF79382F-629A-532F-892C-E3D357F06E2D","فَقالَ لِسامَةَ إِحدى النِسا","ءِ ما لَكَ يا سامُ لا تَركَبُ"],["2B0B1F92-A156-5B43-BEAD-A90CA1960EA4","أَكُلُّ البِلادِ بِها حارِسٌ","مُطِلٌّ وَضِرغامَةٌ أَغلَبُ"],["D2B3A510-978D-5A66-9875-8AD1C0D10860","فَقالَ بَلى إِنَّني راكِبٌ","وَإِنّي لِقَومِيَ مُستَعتِبُ"],["49429E47-3A28-59C4-B32F-DD68E19391E6","فَشَدَّ أَموناً بِأَنساعِها","بِنَخلَةَ إِذ دونَها كَبكَبُ"],["1C6BF85C-7D09-57A7-AFCD-D668EA5DEE27","فَجَنَّبَها الهَضبَ تَردي بِهِ","كَما شَجَرَ القارِبُ الأَحقَبُ"],["EA9F14E3-A82D-5805-96C3-B804B9D9E862","فَلَمّا أَتى بَلَداً سَرَّهُ","بِهِ مَرتَعٌ وَبِهِ مَعزَبُ"],["8B8B073D-D7FB-5773-829E-164B0484EC2D","وَحِصنٌ حَصينٌ لِأَبنائِهِم","وَريفٌ لِإِبلِهِمُ مُخصِبُ"],["1AE7CE95-B1FE-502A-A07E-B4095B38CE1C","تَذَكَّرَ لَمّا ثَوى قَومَهُ","وَمِن دونِهِم بَلَدٌ عُزَّبُ"],["47782F08-F889-5A0A-B8F7-EE498F232AF1","فَكَرَّت بِهِ حَرَجٌ ضامِرٌ","فَآبَت بِهِ صُلبُها أَحدَبُ"],["E20ED64D-AF36-5B61-81F7-0C06CD63B8E3","فَقالَ أَلا فَاِبشِروا وَاِظعَنوا","فَصارَت عِلافٌ وَلَم يُعقِبوا"],["61F23D7E-7079-586C-85C8-F26A423C6B1A","وَلَم يَنهَ رِحلَتَهُم في السَما","ءِ نَحسُ الخَراتَينِ وَالعَقرَبُ"],["15550735-A674-5C36-A1F3-0C7A9F2F4002","فَبَلَّغَهُ دَلَجٌ دائِبٌ","وَسَيرٌ إِذا صَدَحَ الجُندَبُ"],["035FB6AB-9FEC-5DAB-9100-3F843C9391ED","فَحينَ النَهارِ يَرى شَمسَهُ","وَحيناً يَلوحُ بِها كَوكَبُ"],["259AC027-8965-57AF-A67C-ABD00403346D","عُدَيَّةُ لَيسَ لَها ناصِرٌ","وَعَروى الَّتي هَدَمَ الثَعلَبُ"],["41DEF3AB-C394-530E-973A-C024EDB257BC","وَفي الناسِ مَن يَصِلُ الأَبعَدَينِ","وَيَشقى بِهِ الأَقرَبُ الأَقرَبُ"],["7AD723CE-B588-5C03-AD0F-82182F7A8FCB","دَعا شَجَرَ الأَرضِ داعيهِمُ","لِيَنصُرَهُ السِدرُ وَالأَثأَبُ"],["308DAA48-5791-5878-B0A9-14989B308C66","فَإِنَّ لَنا إِخوَةً يَحدِبونَ","عَلَينا وَعَن غَيرِنا غَيَّبوا"]]},"45F497A4-9A4C-5DE6-9E7B-C478C4C847D5":{"t":"أَصرمت حبل الوصل من فترِ","p":26,"s":"أصرمت حبل الوصل من فتر","r":"437412","v":[["1CAAABFC-D039-5F74-8DA8-C385C2F10B87","أَصَرَمتَ حَبلَ الوَصلِ مِن فِترِ","وَهَجَرتَها وَلَجَجتَ في الهَجرِ"],["EDB5F766-4066-5B73-889C-C26B26B8AD2B","وَسَمِعتَ حَلفَتَها الَّتي حَلَفَت","إِن كانَ سَمعُكَ غَيرَ ذي وَقرِ"],["0130537D-8FF8-5018-B335-21726899D642","نَظَرَت إِلَيكَ بِعَينِ جازِئَةٍ","في ظِلِّ بارِدَةٍ مِنَ السِدرِ"],["001D876A-9222-5040-B095-B20B832F5E6E","كَجُمانَةِ البَحرِيِّ جاءَ بِها","غَوّاصُها مِن لُجَّةِ البَحرِ"],["60BA48B9-7450-51C4-BD13-42628BFE60B7","صُلبُ الفُؤادِ رَئيسَ أَربَعَةٍ","مُتَخالِفي الأَلوانِ وَالنَجرِ"],["AA1759E0-02E8-5528-8F57-1A3C4CAAC132","فَتَنازَعوا حَتّى إِذا اِجتَمَعوا","أَلقَوا إِلَيهِ مَقالِدَ الأَمرِ"],["1E178583-FC95-50EB-AF4F-0EA079D7BB8E","وَغَلَت بِهِم سَجحاءُ جارِيَةٌ","تَهوي بِهِم في لَجَّةِ البَحرِ"],["D68A251A-A577-597B-9B34-CA852529FBF4","حَتّى إِذا ما ساءَ ظَنُّهُمُ","وَمَضى بِهِم شَهرٌ إِلى شَهرِ"],["5C7369CF-64C9-562B-83EE-134069EC62BF","أَلقى مَراسِيَهُ بِتَهلُكَةٍ","ثَبَتَت مَراسيها فَما تَجري"],["BF4ECA97-AB1C-5920-AD8F-7B6E3B16C08B","فَاِنصَبَّ أَسقَفُ رَأسُهُ لَبِدٌ","نُزِعَت رَباعيتاهُ لِلصَبرِ"],["398E7C47-058F-5BB2-9488-2B8446322190","أَشفى يَمُجُّ الزَيتَ مُلتَمِسٌ","ظَمآنُ مُلتَهِبٌ مِنَ الفَقرِ"],["DA1D528C-430C-51E3-A3A9-BE3866698CE0","قَتَلَت أَباهُ فَقالَ أَتبَعُهُ","أَو أَستَفيدُ رَغيبَةَ الدَهرِ"],["AD37C74B-3AF6-50A2-88E3-2B1CFBA9D7F5","نَصَفَ النَهارُ الماءُ غامِرُهُ","وَرَفيقُهُ بِالغَيبِ لا يَدري"],["FA3F8676-1C18-5F78-9452-99288618A241","فَأَصابَ مُنيَتَهُ فَجاءَ بِها","صَدَفِيَّةً كَمُضيئَةِ الجَمرِ"],["FBA03110-9B5A-5AE6-A60D-4D0B2C0A2ED1","يُعطى بِها ثَمَناً وَيَمنَعُها","وَيَقولُ صاحِبُهُ أَلا تَشري"],["C03827AD-474C-58E2-9FDA-78E83E013F97","وَتَرى الصَراري يَسجُدونَ لَها","وَيَضُمُّها بِيَدَيهِ لِلنَحرِ"],["F7809002-1FB8-5993-BE74-1993B8ABE28E","فَتِلكَ شِبهُ المالِكِيَّةِ إِذ","طَلَعَت بِبَهجَتِها مِنَ الخِدرِ"],["301FCE9D-FB20-5535-B1B7-4A328E813731","وَكَأَنَّ طَعمَ الزَنجَبيلِ بِهِ","إِذ ذُقتَهُ وَسُلافَةَ الخَمرِ"],["58D34AC5-5790-5E3B-B8AB-E15ED6D2583D","شِركاً بِماءِ الذَوبِ يَجمَعُهُ","في طَودِ أَيمَنَ في قُرى قَسرِ"],["0FFE71DE-EBA7-5D03-AE29-29CE716667BD","بَكَرَت تَعَرَّضُ في مَراتِعِها","فَوقَ الهِضابِ بِمَعقِلِ الوَبرِ"],["7E6182F9-A36A-5ED6-BE1C-DC11A75CEB5C","سودُ الرُؤوسِ لِصَوتِها زَجَلٌ","مَحفوفَةٌ بِمَسارِبٍ خُضرِ"],["05ABA56B-E300-5677-BA77-338CD29A01AB","وَيَظَلُّ يَجري في جَواشِنِها","حَتّى تَرَوَّحَ مَقصِرَ العَصرِ"],["401A3849-3BAC-50AC-B141-AF963173D46D","وَغَدَت لِمَسرَحِها وَخالَفَها","مُتَسَربِلٌ أَدَماً عَلى الصَدرِ"],["63B5E824-B47D-5B15-BDE2-E1678044792D","يَمشي بِمِحجَنِهِ وَقِربَتُهُ","مُتَلَطِّفاً كَتَلَطُّفِ الوَبرِ"],["A7216A12-B1A1-53A9-A98E-A44A92A33700","فَهَراقَ في طَرَفِ العَسيبِ إِلى","مُتَقَبِّلٍ لِنَواطِفٍ صُفرِ"],["99607589-4888-56B8-B99B-DC2810C6E997","حَتّى تَحَدَّرَ مِن عَوازِبِهِ","أُصُلاً بِسَبعِ ضَوائِنٍ وُفرِ"],["2CBB3CC2-8A90-532A-9218-021867020289","فَأَصابَ ما حَذَرَت وَلَو عَلِمَت","حَدَبَت عَلَيهِ بِضَيِّقٍ وَعرِ"],["CF55739F-0B37-54CC-8F18-80E2845D256F","وَجَناهُ مِن أُفُقٍ فَأَورَدَهُ","سَهلُ العِراقِ وَكانَ بِالحَضرِ"],["E51B72B5-B8F6-5267-9A21-D44AFB1D4DB9","وَإِلَيكَ أَعمَلتُ المَطِيَّةَ مِن","سَهلِ العِراقِ وَأَنتَ بِالقَهرِ"],["937644B1-063E-50A3-871F-CA0D8314B54C","قَيساً فَإِنَّ اللَهَ فَضَّلَهُ","بِمَناقِبٍ مَعروفَةٍ عَشرِ"],["5A1139B7-0DA5-5655-865A-2424A2099574","أَنتَ الرَئيسُ إِذا هُمُ نَزَلوا","وَتَواجَهوا كَالأُسدِ وَالنُمرِ"],["0B385897-A1E6-5C2B-BF40-2688EBB491CA","أَو فارِسُ اليَحمومِ يَتبَعُهُم","كَالطَلقِ يَتبَعُ لَيلَةَ البَدرِ"],["1ABBFE30-6ADD-53A5-B90D-94316D82D62F","لَو كُنتَ مِن شَيءٍ سِوى بَشَرٍ","كُنتَ المُنَوِّرَ لَيلَةَ البَدرِ"],["B3CEC302-4F12-5C64-8685-E0026D54508A","وَلَأَنتَ أَجوَدُ بِالعَطاءِ مِنَ ال","رَيّانِ لَمّا جادَ بِالقَطرِ"],["49567786-4B24-5C25-943E-666CA8012BF3","وَلَأَنتَ أَشجَعُ مِن أُسامَةَ إِذ","يَقَعُ الصُراخُ وَلُجَّ في الذُعرِ"],["C673EAF5-E0A0-5290-96BA-A99E318A8DD7","وَلَأَنتَ أَبيَتُ حينَ تَنطِقُ مِن","لُقمانَ لَمّا عَيَّ بِالأَمرِ"],["ED8F6727-316B-5AD2-B3A0-7CCA6F9FFFAB","وَلَأَنتَ أَوصَلُ مَن سَمِعتُ بِهِ","لِشَوابِكِ الأَرحامِ وَالصِهرِ"],["C90D2904-7770-5F5C-93B2-E10F7A88267F","وَلَأَنتَ أَحيا مِن مُخَبَّأَةٍ","عَذراءَ تَقطُنُ جانِبَ الكِسرِ"],["A77BC101-2AA4-5324-8B3B-A694BDF206DE","وَلَهُ جِفانٌ يَدلُجونَ بِها","لِلمُعتَفينَ وَلِلَّذي يَسرِ"]]},"D80DDFE6-3BFC-5612-B4BE-29BBE722B4D9":{"t":"أَيا جلندى يا اِبن مستكيرِ","p":26,"s":"أيا جلندى يا ابن مستكير","r":"437410","v":[["89B6A83F-D872-593D-86FF-3B95445292D4","أَيا جُلَندى يا اِبنَ مُستَكيرِ","يا خَيرَ مَن يَمشي مِنَ الذُكورِ"]]},"A1B680F5-D980-595A-95B0-B30CA785A4F8":{"t":"إِذ هي كالرشإِ المخروف زينها","p":26,"s":"إذ هي كالرشإ المخروف زينها","r":"437430","v":[["F4AADD40-511F-5185-B2B8-7B9440F1AE65","إِذ هِيَ كَالرَشَإِ المَخروفِ زَيَّنَها","مُكَردَسٌ كَطِلاءِ الخَمرِ مَنظومُ"]]},"550D88D0-CBF7-5E08-9C41-EB3E5FCB1BB0":{"t":"إِذا حاجة ولتك لا تستطيعها","p":26,"s":"إذا حاجة ولتك لا تستطيعها","r":"437418","v":[["0D9949EB-63EA-5CB3-B6E1-237C8ED17941","إِذا حاجَةٌ وَلَّتكَ لا تَستَطيعُها","فَخُذ طَرَفاً مِن غَيرِها حينَ تُسبَقُ"],["3827B00C-27EB-5B2C-9900-2398B8F1BB4B","فَذَلِكَ أَحرى أَن تَنالَ جَسيمَها","وَلَلقَصدُ أَبقى في المَسيرِ وأَلحَقُ"]]},"4EBF6FC5-5EF8-5F24-B065-7E4ABEF77E69":{"t":"إِني اِمرؤ مهد بغيب تحِية","p":26,"s":"إني امرؤ مهد بغيب تحية","r":"437413","v":[["12E1131B-3EFE-57B3-89A1-8634E45E965F","إِنّي اِمرُؤٌ مُهدٍ بِغَيبٍ تَحِيَّةً","إِلى اِبنِ الجُلَندى فارِسِ الخَيلِ جَيفَرِ"],["EBCAC555-B8B2-57FA-8998-7C3E06A20D79","بِها تُنفَضُ الأَحلاسُ وَالديكُ نائِمٌ","إِلى مُسنِفاتٍ آخِرَ اللَيلِ ضُمَّرِ"]]},"11034FA3-7335-56E0-BA19-99DAAA1B2E58":{"t":"بان الخليط ورفع الخرق","p":26,"s":"بان الخليط ورفع الخرق","r":"437419","v":[["32698CEA-1332-5AA2-BD4C-3DDC6562C9A6","بانَ الخَليطُ وَرُفِّعَ الخِرقُ","فَفُؤادُهُ في الحَيِّ مُعتَلِقُ"],["6CB13913-D6D8-5E3D-988A-D3575CD8A8F3","مَنَعوا طَلاقَهُمُ وَنائِلُهُم","يَومَ الفِراقِ وَرَهنُهُم غَلَقُ"],["6DDD2B0A-C02C-548E-BD6D-48FF4BD22B12","قَطَعوا المَزاهِرَ وَاِستَتَبَّ بِهِم","يَومَ الرَحيلِ لِلَعلَعٍ طُرُقُ"],["7D95320C-6160-57E3-A3D4-9BF3CAA84D69","تَرعى رِياضَ الأَخرَمَينِ لَهُم","فيها مَوارِدُ ماؤُها غَدَقُ"],["BFF55719-1C05-54E5-A40B-C1DC960E0ACE","بِكَثيبِ حَربَةَ أَو بِحَومَلَ أَو","مِن دونِهِ مِن عالِجٍ بُرَقُ"],["A52C592A-F981-5664-B586-543071862DF5","تامَت فُؤادَكَ إِذ لَهُ عَرَضَت","حَسَنٌ بِرَأيِ العَينِ ما تَمِقُ"],["4AE7EE66-830E-5D38-A91F-0904955B029C","بانَت وَصَدعٌ في الفُؤادِ بِها","صَدعُ الزُجاجَةِ لَيسَ يَتَّفِقُ"],["85FA4CB4-BC82-53AB-BB34-1B751A978874","وَكَأَنَّ غِزلانَ الصَرائِمِ إِذ","مَتَعَ النَهارُ وَأَرشَقَ الحَدَقُ"],["3C77F815-4AA8-52C1-895B-A619DA7CEB8B","وَمَهاً يَرِفُّ كَأَنَّهُ بَرَدٌ","نَزَلَ السَحابَةِ ماؤُهُ يَدِقُ"],["10DF2D8A-DBA9-51A0-9624-04EF223AA309","عانِيَّةٌ صِرفٌ مُعَتَّقَةٌ","يَسعى بِها ذو تومَةٍ لَبِقُ"],["E366670F-0FFD-569B-9AE3-0BA95FF1F2A8","يا اِبنَ الَّذي دانَت لِعِزِّهِمُ","بَذَخُ المُلوكِ وَدانَتِ السُوَقُ"],["DF5F98AE-30FC-5696-9A31-27CC4F7D520A","بَحرٌ مِنَ المَدّادِ ذو حَدَبٍ","سَهلُ الخَليفَةِ ما بِهِ غَلَقُ"],["017A4D5F-36BC-5AF1-8E5F-DF2597F45B98","وَأَغَرُّ تُقصِرُ دونَ غايَتِهِ","غُرُّ السَوابِقِ حينَ تَستَبِقُ"],["0C500780-CA54-5DD3-9BB7-595259DFF8BB","قَبلَ اِمرِئِ تُرجى فَواضِلُهُ","قَد نالَني مِن باعِهِ طَلَقُ"],["DF30F5DB-5C9C-5F3B-B042-54A99BD5840C","قَد نالَني مِنهُ عَلى عَوَزٍ","مِثلُ النَخيلِ صِغارُها السُحُقُ"],["F01B4552-1EF7-5C31-903A-E99284BAE1AD","غُلُبُ العُذوقِ عَلى كَوافِرِهِ","مُتَلَفِّعٌ بِالليفِ مُنتَطِقُ"],["62A1AF00-FCA8-55E4-81EA-752926EBC5F9","وَلَها إِذا لَحِقَت ثَمائِلُها","جَوزٌ أَعَمُّ وَمَشفَرٌ خَفِقُ"],["B9BCA6F8-2CD8-52B9-88CD-01B3972CDF12","مَن لَيسَ فيهِ حينَ تَسأَلُهُ","بَخَلٌ وَلا في صَفوِهِ رَنَقُ"],["DA60D09E-D220-5F4E-99DB-EB17292C9FC0","وَلَأَنتَ أَشجَعُ مِن أُسامَةَ إِذ","شُدَّ المَناطِقُ تَحتَها الحَلَقُ"],["3CFA51FA-DDF5-50B2-BA74-7126A96E9A7C","وَتَنازَلوا شُعثاً مَقادِمُهُم","مُتَوَسِّمينَ وَبَينَهُم حَنَقُ"],["6D417901-441B-50F6-95B7-9C3716A441F7","حَمَلوا السُيوفَ عَلى عَواتِقِهِم","وَعَلى الأَكُفِّ وَبَينَهُم عَلَقُ"],["67CC9E03-6CF9-583D-A00F-6ACAB648114F","وَتَزورُ أَرضَهُمُ بِذي لَجَبٍ","قَصدَ العَشِيِّ غُبوقُهُ المَرَقُ"],["E84FEE11-1A1F-5EBD-94CB-8C706A2CE3DF","كَغَماغِمِ الثيرانِ بَينَهُمُ","ضَربٌ تُغَمَّضُ دونَهُ الحَدَقُ"]]},"F0E050C1-FD38-5A11-A517-E373D160BD19":{"t":"بكرت لتحزِن عاشقاً طفل","p":26,"s":"بكرت لتحزن عاشقا طفل","r":"437422","v":[["2ECE9704-298A-531A-B8C3-FFC97567B2C9","بَكَرَت لِتُحزِنَ عاشِقاً طَفلُ","وَتَباعَدَت وَتَخَرَّمَ الوَصلُ"],["68FCB910-660F-58A8-A23F-FF187E5E16F7","أَوَ كُلَّما اِختَلَفَت نَوىً وَتَفَرَّقوا","لِفُؤادِهِ مِن أَجلِهِم تَبلُ"],["EA0D0755-4458-5F27-95FC-8E65F569F767","وَإِذا تُكَلِّمُنا تَرى عَجَباً","بَرَداً تَرَقرَقَ فَوقَهُ ضَحلُ"],["A2269E7A-DC66-5350-BEFF-243194801BC9","وَلَقَد أَرى ظُعُناً أُخَيِّلُها","تَخدي كَأَنَّ زُهاءَها نَخلُ"],["7D3E5A88-D5F8-580A-9E72-6B51806236A9","في الآلِ يَرفَعُها وَيَخفِضُها","ريعٌ كَأَنَّ مُتونَهُ سَحلُ"],["00D98833-D3FF-563D-AA45-99912570BD5D","عَقماً وَرَقماً ثُمَّ أَردَفَهُ","كِلَلٌ عَلى أَطرافِها الخَملُ"],["642F3EB9-C356-5EAC-B179-2985FE1F885D","كَدَمِ الرُعافِ عَلى مَآزِرِها","وَكَأَنَّهُنَّ ضَوامِراً إِجلُ"],["75C10B9F-B04F-5421-8ECC-426BFE492C17","وَلَقَد رَأَيتُ الفاعِلينَ وَفِعلَهُم","وَلِذي الرُقَيبَةِ مالِكٍ فَضلُ"],["43AAF50F-8CA8-542C-862E-F05873D13114","كَفّاهُ مُخلِفَةٌ وَمُتلِفَةٌ","وَعطاؤُهُ مُتَخَرِّقٌ جَزلُ"],["037EC160-ECA9-5AF1-8DE6-213927DE8AD5","يَهَبُ الجِيادَ كَأَنَّها عُسُبٌ","جُردٌ أَطارَ نَسيلَها البَقلُ"],["0EB270AF-847F-5858-8646-15553271CDE5","وَالضامِراتِ كَأَنَّها بَقَرٌ","تَقرو دَكادِكَ بَينَها الرَملُ"],["76AC98E3-827A-5F27-927B-3262C1A63765","وَالدُهمَ كَالعَيدانِ آزَرَها","وَسطَ الأَشاءِ مُكَمَّمٌ جَعلُ"],["E6B74925-5F77-53F3-B152-E67D1734A519","وَإِذا الشَمالُ حَدَت قَلائِصَها","رَتَكاً فَلَيسَ لِمالِكٍ مِثلُ"],["350AC60B-2EE7-5601-8D34-3B45048F9584","لِلضَيفِ وَالجارِ الغَريبِ وَلِل","طِفلِ التَريكِ كَأَنَّهُ رَألُ"],["7F4A8EFC-8C05-5677-96F2-DF3EAAB683A9","وَلَقَد تَناوَلَني بِنائِلِهِ","فَأَصابَني مِن مالِهِ سَجلُ"],["2ACD433A-D324-5BBC-8AE0-09C5EE1CADE0","مُتَبَعِّجُ التَيّارِ ذو حَدَبٍ","مُغرَورِبٍ تَيّارُهُ يَعلو"],["22119709-286C-5BF5-A53D-6FB700B89299","فَلَأَشكُرَنَّ فُضولَ نَعمَتِهِ","حَتّى أَموتَ وَفَضلُهُ فَضلُ"],["9520DF13-65D4-5ACF-88C5-B442ADEDA771","أَنتَ الشُجاعُ إِذا هُمُ نَزَلوا","عِندَ المَضيقِ وَفِعلُكَ الفِعلُ"]]},"10C89446-5946-5F4B-B600-93DF024160CD":{"t":"بِمحالة تقص الذباب بطرفها","p":26,"s":"بمحالة تقص الذباب بطرفها","r":"437435","v":[["07B57FF7-A55A-5EA8-9E40-5FDC595AB42F","بِمَحالَةٍ تَقِصُ الذُبابَ بِطَرفِها","خُلِقَت مَعاقِمُها عَلى مُطَوائِها"]]},"75792035-B18A-5C1C-B302-648DF44D8123":{"t":"جزى اللَه عنا والجزاء بكفه","p":26,"s":"جزى الله عنا والجزاء بكفه","r":"437433","v":[["8A6D5282-D1DA-5DAE-B5D5-559A2DE0CC69","جَزى اللَهُ عَنّا وَالجَزاءُ بِكَفِّهِ","عُمارَةَ عَبسٍ نَضرَةً وَسَلاما"],["522FDF67-8C4F-5331-9FBE-65399CD8ECA9","هُوَ المُشتَري مِن طَيِّءٍ بِخَميسِهِ","خُمَيسَ بنَ بَدرٍ رَجعَةً وَتَماما"]]},"B159C7B0-C282-5B20-AD5D-710BE1CFB2C5":{"t":"خلو سبيل بكرِنا إِن بكرنا","p":26,"s":"خلو سبيل بكرنا إن بكرنا","r":"437421","v":[["AC9DE0FF-5895-57E6-8310-3F89BC964C7F","خَلّو سَبيلَ بَكرِنا إِنَّ بَكرَنا","يَخُذُّ سَنامَ الأَكحَلِ المُتَماحِلِ"],["2158C63A-937F-5E5A-909F-C5A8073C0A2B","هُوَ القَيلُ يَمشي آخِذاً بَطنَ عَرعَرٍ","بِتَجفافِهِ كَأَنَّهُ في سَراوِلِ"]]},"3BD098C3-7DFD-51C0-8F81-A96CDC3972AD":{"t":"فإِن سركم أَن لا تؤوب لقاحكم","p":26,"s":"فإن سركم أن لا تؤوب لقاحكم","r":"437420","v":[["EDB76DFF-33BA-5325-9E32-ABF716B98485","فإِن سَرَّكُم أَن لا تَؤوبَ لِقاحُكُم","غِزاراً فَقولوا لِلمُسَيِّبِ يَلحَقِ"]]},"56130939-B0B2-5BC9-9317-FC94B7F8B5D5":{"t":"فلو صادموا الرأس الملفف حاجباً","p":26,"s":"فلو صادموا الرأس الملفف حاجبا","r":"437407","v":[["0727726F-F659-556B-98D9-F34E96D890A9","فَلَو صادَموا الرَأسَ المُلَفَّفَ حاجِباً","لَلاقى كَما لاقى الحِمارُ وَجُندَبُ"]]},"3E0F5A4D-4C72-5E90-A1CA-E17641A74155":{"t":"قصار الهم إِلا في صديق","p":26,"s":"قصار الهم إلا في صديق","r":"437404","v":[["DC4ED54B-0665-5CD4-BEBF-704FCD585394","قِصارُ الهَمِّ إِلّا في صَديقٍ","كَأَنَّ وِطابَهُمُ موشى الضَبابِ"]]},"ADEAE6DD-2385-5625-A444-F89C4F6BE03D":{"t":"كلفت بِليلى خدين الشباب","p":26,"s":"كلفت بليلى خدين الشباب","r":"437423","v":[["0008A873-ED97-5E92-8192-C39EB54C4EA6","كَلِفتُ بِلَيلى خَدينِ الشَبابِ","وَعالَجتُ مِنها زَماناً خَبالا"],["04E21CEE-B8E1-56F3-9A83-0962F1C8C257","لَها العَينُ وَالجيدُ مِن مُغزِلٍ","تُلاعِبُ في القَفَراتِ الغَزالا"],["09276C3E-8368-5B7C-8342-16176652F53C","كَأَنَّ السُلافَ بِأَنيابِها","يُخالِطُ في النَومِ عَذباً زُلالا"],["008364A0-0C6C-5778-92FB-B4F4A26D1A8B","وَكَيفَ تَذَّكَرُها بَعدَما","كَبِرتَ وَحلَّ المَشيبُ القَذالا"],["F415BCE9-087D-5119-A932-6A8F9ED7676A","فَدَع عَنكَ لَيلى وَأَترابَها","فَقَد تَقطَّعُ الغانِياتُ الوِصالا"],["105600EB-F026-5C29-8464-DA1538C25B30","فَإِمّا تَرَيني عَلى آلَةٍ","رَفَضتُ الصِبا وَلَبِستُ السِمالا"],["8E66D2FF-11C8-5EAB-B7E6-46BDF0C7F3D7","فَقَد أَقطَعُ الخَرقَ بَعدَ الخُروقِ","تَخالُ اليَرابيعَ فيهِ رِئالا"],["292E1525-1F22-5BAB-AFC1-1494E2AD2E5C","إِلى خَيرِ مُستَمطَرٍ كَفُّهُ","وَخَيرِ المَقاوِلِ عَمّاً وَخالا"],["D74E4581-C1E6-57E6-B845-61EE288C5BB9","تَخَلَّقَ في البَيتِ مِن حاشِدٍ","تَراهُ البَرِيَّةُ فيها هِلالا"],["EDCA1549-B583-5F4E-9276-75C7D3C19AC8","وَأَفضَلُ ذي يَمَنٍ كُلِّها","إِذا اِفتَقَدَ المُسنِتونَ السِجالا"],["26A69E50-59F3-57A7-A438-4DC1A7209AD9","فَقَحطانُ تَعلَمُ أَن لَيسَ حَيٌّ","مِنَ الناسِ أَكرَمَ مِنكُم فِعالا"],["D1466F42-253A-5601-B278-B70E70952A2A","وَأَنَّكَ مَرسى حُروبِ النِزالِ","إِذا كَرِهَ المُعلِمونَ النِزالا"],["A9057A52-E12C-5AD3-914E-3E46F5048116","تَقودُ الجِيادَ بِأَرسانِها","يُغادِرنَ في الفَلَواتِ النِقالا"],["AA4B0801-87D7-53BC-AC12-4CE4A9A785BE","شَماطيطَ تَمزَعُ مَزعَ الظِبا","وَتَفري فَلا الأَرضِ مِنها السِخالا"],["794443E5-18D8-50FF-A432-930B12673134","إِذا ما اِنتَضى التاجَ فَوقَ السَريرِ","فَلَن يَعدِلَ الناسُ مِنهُ قِبالا"],["16C22848-DA8B-559F-B1A6-FDB2A0904E83","يَسومُ البَرِيَّةَ سَومَ العَزيزِ","وَقَد لَبِسَ الدَهرُ حالاً فَحالا"],["1EB041C9-0FE6-5E5A-8AC9-961C42527DAD","وَما مُزبِدٌ مِن خَليجِ الفُراتِ","يَحُطُّ الصُخورَ وَيَعلو الجِبالا"],["610489BF-4B66-51E9-94F3-6BB5D72F047A","يَكُبُّ السِفينَ لِأَذقانِها","وَيَصرَعُ بِالعَبرِ أَثلاً وَضالا"],["FE3FE28A-3F4F-5AFE-B3A1-BCB7CA8DB5EC","بِأَجوَدَ مِنهُ إِذا جِئتَهُ","عَلى حادِثِ الدَهرِ يَوماً نَوالا"],["518FB1C2-DDDC-540A-AE32-465867D5C5B9","هَوَ الواهِبُ المِئَةَ المُصطَفاةَ","تُجاوِبُ مِنها العِشارُ الفِصالا"],["BB864060-AD75-538D-A9D4-504EC28ED719","وَكُلَّ أَمينِ الشَظا سابِحٍ","يَقطَعُ مِنهُ النَحيطُ الجِلالا"]]},"F9904364-1557-56C8-88C7-E9CF31A07ECA":{"t":"لسسن بقول الصيف حتى كأَنما","p":26,"s":"لسسن بقول الصيف حتى كأنما","r":"437411","v":[["881AB81B-FFB7-57ED-9CE7-5EA557A31648","لَسَسنَ بُقولَ الصَيفِ حَتّى كَأَنَّما","بَأَفواهِها مِن لَسِّ حُلَّبِها الصَقرُ"]]},"30285177-3FA4-599C-8829-86E0FCB2DD4A":{"t":"لعمري لئن جدت عداوة بينِنا","p":26,"s":"لعمري لئن جدت عداوة بيننا","r":"437431","v":[["8300B0B1-275A-5318-989D-04B9C49F5741","لَعَمري لَئِن جَدَّت عَداوَةُ بَينِنا","لِيَنتَحِيَن مَنّي عَلى الوَخمِ مَيسَمُ"],["46980042-696E-5412-8E91-55142FF4EB7E","فَأُقسِمُ أَن لَوِ اِلتَقَينا وَأَنتُمُ","لَكانَ لَكُم يَومٌ مِنَ الشَرِّ مُظلِمُ"],["2598C40F-D10C-524F-AE68-0C48D58E4482","رَأَوا نَعَماً سوداً فَهَمّوا بِأَخذِهِ","إِذا اِلتَفَّ مِن دونِ الجَميعِ المُزَنَّمُ"],["2C01DCDF-4BBF-5345-B3E7-4870C4445621","وَمِن دونِهِ طَعنٌ كَأَنَّ رَشاشَهُ","عَزالى مَزادٍ وَالأَسِنَّةُ تَرذُمُ"],["4E2C923F-40A8-51BC-B778-2F3979C2F0FC","أَلا تَتَّقونَ اللَهَ يا آلَ عامِرٍ","وَهَل يَتَّقي اللَهَ الأَبَلُّ المُصَمِّمُ"],["80BE6B42-7378-57AB-AF3B-73D553F7A79D","كَما اِمتَنَعَت أَولادُ يَقدُمَ مِنكُمُ","وَكانَ لَها وَلثٌ مِن العَقدِ مُحكَمُ"]]},"64AE85ED-E833-5DF5-B1DD-A93F36971E44":{"t":"لقد نظرت عنز إِلى الجزع نظرة","p":26,"s":"لقد نظرت عنز إلى الجزع نظرة","r":"437426","v":[["26F23BC0-A816-5888-90FD-2929ACC7F60F","لَقَد نَظَرَت عَنزٌ إِلى الجَزعِ نَظرَةً","إِلى مِثلِ مَوجِ المُفعَمِ المُتَلاطِمِ"],["E509CA77-3BD3-5385-8D32-22584CF1AD2F","إِلى حِميَرٍ إِذ وَجَّهوا مِن بِلادِهِم","تَضيقُ لَهُم لَأياً فُروجُ المَخارِمِ"],["C70C7EAD-212F-5B0C-8906-F8B27EA7BA14","رَأَت فَوقَ رَأسِ الكَلبِ شَخصاً بِكَفِّهِ","عَلى البُعدِ كِنفٌ أَو خَصيفَةَ لاحِمِ"],["6FB8C7B1-B16D-55A2-AD57-AE72817ADC17","فَكَذَّبَها سُكّانُ جَوٍّ فَصُبِّحوا","بِتِسعينَ أَلفاً كَالأُسودِ الضَراعِمِ"],["01C44428-4141-5127-A138-441C30FFC40A","وَما كَذَبَت عَنزٌ وَلَكِن تَبَيَّنَت","كَما أَبصَرَتنا بِنتَ قَيسِ بنِ عاصِمِ"]]},"ECCFA7A7-0F19-5E5E-86AD-2EC83D6656FB":{"t":"مررن على الشراف فذات رجلٍ","p":26,"s":"مررن على الشراف فذات رجل","r":"437434","v":[["0D847CEB-92DC-5495-9EE4-2E8AAEFCFAC2","مَرَرنَ عَلى الشِرافِ فَذاتِ رَجلٍ","وَنَكَّبنَ الذَرانِحَ بِاليَمينِ"]]},"F6508CD8-F9F9-5D88-8802-5D8B5F7281C2":{"t":"هم الربيع على من ضاف أرحلهم","p":26,"s":"هم الربيع على من ضاف أرحلهم","r":"437429","v":[["FB566A51-1319-5739-A179-62D123BA7AB6","هُمُ الرَبيعُ عَلى مَن ضافَ أَرحُلَهُم","وَفي العَدُوِّ مَناكيدٌ مَشائيمُ"]]},"82C155C6-5314-5D65-B6B0-A5D54757AD0D":{"t":"وشرب كرام حسان الوجوه","p":26,"s":"وشرب كرام حسان الوجوه","r":"437409","v":[["792C12D5-6DC4-57F3-AA4B-CC0B355C4C44","وَشَربٍ كِرامٍ حِسانِ الوُجوهِ","تُغاديهُمُ النَشَواتُ اِبتِكارا"],["3B567E52-4ACD-5EE3-824A-36F1A00BF784","كُمَيتٍ تَكادُ وَإِن لَم تَذُق","تُنَشّي إِذا الساقِيانِ اِستَدارا"],["E04D0B94-B7B4-5965-BB62-4F23CF3209A2","أَعاذِلَ لَمّا تَرَينَ الغَداةَ","وَقَنَّعَني الشَيبُ مِنهُ خِمارا"],["A239BC5F-F408-5968-9210-DDC15F51BF52","وَبانَ الشَبابُ فَوَدَّعتُهُ","وَطالَبتُهُ بَعدَ عَينٍ ضِمارا"],["DF2C1976-3E5F-55BC-A9E7-45153A445F3A","بِبَيداءَ مَجهولَةٍ قُطِّعَت","بِعاهِمَةٍ تَستَخِفُّ الضِفارا"],["938583C2-D42A-536D-9EE0-D3988D76BC71","تُرامي النُسوعَ بِحَيزومِها","نُدوباً وَبِالدَفِّ مِنها سِطارا"],["456E761C-21D6-5B96-A000-49E52E862D5E","جُمالِيَّةٍ أُجُدٍ سَهوَةٍ","يُلاحِمُ مِنها التَليلُ الفِقارا"],["8E8A68CB-4163-5ECA-AD01-B7EA4A52E119","كَأَنَّ عَلى الظَهرِ ديباجَةً","وَسودُ القَوائِمِ يُحسَبنَ قارا"]]},"1D42FD2F-DDE1-57A8-AC6D-9F16088144CC":{"t":"وصهباء يستوشي بذي اللبّ مثلها","p":26,"s":"وصهباء يستوشي بذي اللب مثلها","r":"437425","v":[["CF5B10AC-FF06-5591-9C3F-6E13F1C4394C","وَصَهباءَ يَستَوشي بِذي اللَبِّ مِثلَها","قَرَعتُ بِها نَفسي إِذا الديكُ أَعتَما"],["498987B6-1BB4-5A32-AD80-0139E5DEF222","تَمَزَّزتُها صِرفاً وَقارَعتُ دَنَّها","بِعودِ أَراكٍ بَعدَهُ فَتَرَنَّما"],["40D390D6-8CE6-5A38-B503-9E26C080D97C","يَمُدُّ إِلَيها جيدَهُ رَميَةَ الضُحى","كَهَزِّكَ بِالكَفِّ البَرِيِّ المُدَوَّما"]]},"0AA1FAC2-7EFF-5E8C-A3AE-D3613BBAE3A8":{"t":"وعين السخط تبصر كل عيب","p":26,"s":"وعين السخط تبصر كل عيب","r":"437427","v":[["954620C0-21F6-524B-82A2-D8B4ABC51791","وَعَينُ السُخطِ تُبصِرُ كُلَّ عَيبٍ","وَعَينُ أَخي الرِضا عَن ذاكَ تَعمى"]]},"430810A4-DED2-5926-9979-7D9A59A7A25C":{"t":"وقتيل مرَّة أثأرن فانه","p":26,"s":"وقتيل مرة أثأرن فانه","r":"437415","v":[["439B4272-77BF-5CEB-A55A-A62937094895","وَقَتيلُ مُرَّةَ أَثأَرَنَّ فَإِنَّهُ","فَرغٌ وَإِنَّ أَخاكُمُ لَم يَثأَرُ"]]},"ADEB67A6-DDBA-579E-AFC0-8EA5B3865CF8":{"t":"وقد أختلس الطعن","p":26,"s":"وقد أختلس الطعن","r":"437424","v":[["87A1962A-7D39-5376-8875-CE088B847B32","وَقَد أَختَلِسُ الطَعنَ","ةَ لا يَدمى لَها نَصلي"],["D323A98A-1A10-5BEC-99A5-8A0E5BDB937C","كَجَيبِ الدِفنِسِ الورها","ءَ ريعَت وَهيَ تَستَفلي"]]},"CA7BFF38-D1D8-5CD0-B4F5-3566B42A6AC9":{"t":"وكأن فاها كلما نبهتها","p":26,"s":"وكأن فاها كلما نبهتها","r":"437408","v":[["46343A16-3E47-54FC-916C-8155E1150526","وَكَأَنَّ فاها كَلَّما نَبَّهتُها","عانِيَّةٌ شُجَّت بِماءِ بَراحِ"]]},"CA359565-465D-56C8-9382-A670211B00E4":{"t":"ولو أَني دعوت بجو قو","p":26,"s":"ولو أني دعوت بجو قو","r":"437405","v":[["851B5421-299B-54C6-A100-FCAEFEB193B1","وَلَو أَنّي دَعَوتُ بِجَوِّ قَوٍّ","أَجابَتني بِعادِيَةٍ جِنابُ"],["095C7055-AA1D-56CE-93C5-A4422562E0F6","مَصاليتٌ لَدى الهَيجاءِ صيدٌ","لَهُم عَدَدٌ لَهُ لَجَبٌ وَغابُ"]]}}}