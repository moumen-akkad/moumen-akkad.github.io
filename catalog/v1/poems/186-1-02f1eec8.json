{"v":1,"poems":{"CB3BC6BD-7D54-5685-BF86-5274AB7DFF44":{"t":"وُجُودٌ وَحَسْبِي أَنْ أَقُولَ وُجُودُ","p":186,"s":"وجود وحسبي أن أقول وجود","r":"447418","v":[["74162D74-184A-58F4-8274-B37A81640CD6","وُجُودٌ وَحَسْبِي أَنْ أَقُولَ وُجُودُ","لَهُ كَرَمٌ مِنْهُ عَلَيْهِ وَجُودُ"],["01D38F9E-8CED-5223-8F21-AD9AE218CEA6","تَنَزَّهَ عَنْ نَعْتِ الكَمَالِ لأَنَّهُ","بِمَعْنَى اعْتِبَار النَّقْصِ فِيهِ يَؤُودُ"],["73B95A00-623A-5881-B70E-EA3EA9C8F794","وَلَكِنَّهُ فِيهِ الكَمَالُ وَضِدُّهُ","لَهُ مِنْهُ والمَجْمُوعُ فِيهِ صُموُدُ"],["EFB8CCE9-9379-5058-BC7C-1317DE50120C","وَأَشَرفُ أَشْكَالِ الكَنَائِفِ مَا بِهِ","اسْتَدَارَتْ كُرَاهُ فَهْيَ مِنْهُ سُعُودُ"],["0C9681FF-1024-5DC8-9B57-D1CE9D8CFA86","لِحَيْطَتِهَا الأَشْكَالَ فيها بِأَسْرِهَا","وَمِنْهَا إِلَيْهَا تَبْتَدِي وتَعوُدُ"],["BA381DF3-9114-524E-9CAD-CA50F5B379B4","وَقُوَّتُهَا تُعْطِي التَّنوُّعَ كُلَّهُ","فَلَيْسَ عَلَيْهَا في الكَمْالِ مَزِيدُ"],["88F502C5-3D24-5E8D-8162-E8C9B4B61324","سِوَى قُوَّةِ الإِطْلاقِ فَهْيَ مُحِيطَةٌ","بِسَطْوَتِهَا كُلُّ الكُرَاتِ تَبِيدُ"],["8824ED7B-6D5B-5DDB-9292-522E0EDAF2E8","كَذَا حَرَكَاتُ الدَّوْرِ أَشْرَفُ مَا بهِ","تَحَرُّكُ جِسْمٍ كَيْ يَنَالَ قُصُودُ"],["590D5FA7-7D06-5714-877F-5CDED9366C5C","فَتَشْمَلُ أَنْوَاعَ التَّحَرُّكِ كُلِّهِ","فَفِي كُلِّ آنٍ خَلْقُهُنَّ جَدِيدُ"],["D01EAFE2-CD00-5AD7-B548-E4771C992975","مَعَانٍ بِهَا مِنْهَا عَلَيْهَا أَدِلَةٌ","وْفِيهَا لَهَا فِيمَا تَرُومُ شُهودُ"],["A173179A-A774-5053-A6AA-7571301EACB1","وَلَوْلاَ انْخِرامُ الكُلِّ بِالقُوَّةِ الَّتِي","لإِطْلاَقِهَا فِي جَمْعِهِنَّ قُيوُدُ"],["2F7F61CB-3FB5-56F0-AF88-F779473492B6","لَمَا عُدِمَ المَوْجُوُد يَوْماً ولا انْقَضَتْ","رُسُومٌ بِأَنْوَاعِ البَلاَ وَحُدُودُ"],["9AA3BE97-7E4D-5074-B7F4-86E693CF9BF2","وَلَكِنَّهَا تَأْتِي النِّهَايَةَ وَصْفَهَا","فَلَيْسَ لَهَا في الدَّوْرِ قَطُّ جُموُدُ"],["865C1190-B1DD-59F8-9E02-D9B579A9C1CB","وَلَوْ وَقَفَتْ يَوْماً بِحَدٍ لَنَالَهَا","بِهِ عَدَمٌ هَيْهَاتَ وَهْيَ وُجوُدُ"]]},"848DAE32-C543-5FE9-9D61-FB876685154B":{"t":"يا بَرْقَ نَجْدٍ هَلْ حَكَيْتَ فُؤَادِي","p":186,"s":"يا برق نجد هل حكيت فؤادي","r":"447377","v":[["E75115F3-82B8-5687-921E-CFA9D138A40F","يا بَرْقَ نَجْدٍ هَلْ حَكَيْتَ فُؤَادِي","فِي ذَا التَّلَّهُبِ والخُفُوقِ البَادِي"],["3AB3BD80-CFDD-5229-A587-DC23852D8C7C","لَوْلاَ اشْتِرَاكُ هَوَاكُمَا لمْ تَسْفَحَا","دَمْعَيْكُمَا في سَفْحِ ذَاكَ الوَادِي"],["97392737-B6DA-5273-B8CF-14A12A0FDB01","أَتُرىَ سُوَيْكِنَةُ الحِمَى بِجَمَالِهَا","سَلَبَتْ رُقَادَكَ في الهَوى وَرُقَادِي"],["98E365F7-3065-5B16-B27E-6599D97D87AD","عَرَّضْتُ قَلْبِي يَوْمَ رَامَةَ إِذْ بَدَتْ","بِنَوَاظِرٍ تَحْكي حُدُودَ حِدَادِ"],["C365DE18-0143-52CE-829C-10C5EB52B4A6","وَسَأَلْتُهَا سَلْبِي لِعِلْمِيَ أَنْ مَنْ","سَلَبَتْهُ صَارَ أَمِيرَ ذَاكَ النَّادِي"],["B6E5FEFF-51F6-5AFA-930A-D71262F8FE04","وَأَغَنَّ تَعْشَقُ لَيْنَهُ قُضُبُ النَّقَا","إِنْ مَاسَ أَهْيَفُ قَدِّهِ الميَادِ"],["41E4110D-3B47-5138-BA32-1C989DD37F45","يسقِي الندِيمَ بِكَأْسِهِ وَبِلَحْظِهِ","وَبِثَغْرِهِ رَيّاً فَيُصْبِحُ صَادِي"],["2FF6D85C-F29A-5CBC-975F-8E40D93C1DBD","مَاذَاكَ إِلاَّ أَنَّ وَقَّادَ الجَوَى","بَيْنَ الجَوَانِحِ دَائِمُ الإِيْقَادِ"],["58066270-FE2E-5669-B330-DBB5F67B75A3","وَيَبِيتُ أَدْنَى لِلحَشَا مِنْ مُهْجَتِي","وَأَبِيتُ أَشْكُو مِنْهُ فَرْطَ بُعَادِ"],["014CCD59-5D0E-572F-972E-3107C8855C06","فَكَأَنَّمَا نَهْوَى اتحَادَ وَصِالِنَا","شَغَفاً وَنَكْرَهُ فُرْقَةَ التَّعْدَادِ"]]},"73F81750-DEAA-56BA-A683-8DAFC09A541F":{"t":"يَا أُهَيْلَ الحَيِّ مِنْ ذَاكَ الحِمَى","p":186,"s":"يا أهيل الحي من ذاك الحمى","r":"447390","v":[["CD9C7CE7-5623-56A5-8F18-AC89ABD66DB3","يَا أُهَيْلَ الحَيِّ مِنْ ذَاكَ الحِمَى","أَنْتُمُ المَقْصُودُ مِنْ كُلِّ الوُجُودْ"],["848BAC1E-0310-5D22-A2FD-6D2FF11AE32E","ظَبْيُّ أَبْيَاتِكُمُ ذَاكَ الَّذي","لاَ تَسَلْ مَا حَلَّ مِنْهُ بالأُسُودْ"],["2F4EA0A7-8257-5B1A-B657-C107D9D93478","وَسَقِيمُ الجَفْنِ قَدْ صَحَّ لَهُ","سُنَّةُ المَنْعِ وَإِبْطَالُ الوُعُودْ"]]},"BE68CA9B-CCFC-5B8A-8010-2C83EF6562DA":{"t":"يَا حَبَذَا الكاَسُ بِكَفِّ الحَبِيبْ","p":186,"s":"يا حبذا الكاس بكف الحبيب","r":"447324","v":[["AA5B3A04-E32B-51D8-8F1A-ED081923E939","يَا حَبَذَا الكاَسُ بِكَفِّ الحَبِيبْ","أَذَابَت الأَنَوْارَ وَسْطَ اللَّهِيبْ"],["EA49F80C-A892-58F5-B434-2A31119F401C","وحَبَذَا الرَّاحُ الَّتِي لَمْ تَزَلْ","تَصْرِفُنِي بِالسُّكْرِ حَتَّى أَغِيبْ"],["4B4F0D8C-76B0-5C9A-BB69-1470C7094EAF","يَا غُصْنَ البَانِ أَدِرْ وَرْدَهُ","والوَرْدُ في البَانِ لَعَمرِي عَجِيبْ"],["C499F710-5AAD-5A6F-B9EE-C10AACE48268","وَنَاوِلِ الأَقْمَارَ شُهْبَ الدُّجَى","يَا شمْسُ والأَمْرُ أَيْضاً غَرِيبْ"],["4C2B8542-440D-590A-BA0F-DBC87C4BFA66","أَفْدِيكَ مَا فِي صَبْوَتِي رَيْبَةٌ","وَلاَ لِسُلْوَانِي بِقَلْبِ تَصِيبْ"],["83D421A3-3F07-5124-A68D-53085EB2D274","فَاحْكُمْ بِمَا شئْتَ سِوَى جَفْوَتِي","فِعْلُ حَبِيبي كُلُّهُ لي حَبِيبْ"]]},"B1902F83-A0FD-5499-89B0-4D40DE527F85":{"t":"يَا خَدَّهُ وَثَنَايَا ثَغْرِهِ النّضِدِ","p":186,"s":"يا خده وثنايا ثغره النضد","r":"447412","v":[["DC9D56CD-3A98-52BE-AF9D-85EE6923DC31","يَا خَدَّهُ وَثَنَايَا ثَغْرِهِ النّضِدِ","مَنْ سَوّغَ الجَمْعَ بَيْنَ الجَمْرِ وَالبَرَدِ"],["D6007955-1F75-547A-9084-3647C7B8CD82","وَيَا تَلَهُّبَ قَلْبِي فِي مَحَاسِنِهِ","قَدْ أُعْجِزَ الدَّمْعُ أَنْ يُطْفِيكَ فَاتَّقِدِ"],["9E92AD6A-72BC-5869-BD89-97811B794D10","مَا ضَرَّ مِعْطَفَكَ البَّادِي تَأَوُّدُهُ","لَوْ كَانَ يُبْقِي تَثَنِّيةِ عَلى أَوَدِي"],["FCA4246B-903C-574C-89E6-CF428FFEE0A7","وَصَلْتَ هَجْرَكَ إِعْرِاضاً لِتَقْطَعَنِي","أَمَا كَفَاكَ الذِّي أَخْلَدْتَ فِي خَلَدِي"],["A490708D-6017-5D66-A0D6-307A3B56FA1A","لَوْ كَانَ يَعْلَمُ طَرْفِي أَنْ يَزيدَ ظَماً","فِي وِرْدِهِ مَاءَ ذَاكَ الحُسْنِ لَمْ يَرِدِ"],["CAE9E629-7A1F-51F2-AC69-F2F7C63B0995","فاليَوْمَ مِنْ فَرْطِ إِلْفِي بِالصَّبَابَةِ لَوْ","تَرُومُ نُقْصَانَ مَا أَلْقَى لَقُلْتُ زِدِ"],["819EB7F6-D233-554F-9651-609659097914","فَلاَ تُغِبْ نَاظِراً تَلْقَاكَ عَبْرَتُهُ","فالشَّمْسُ تُسْبِلُ دَمْعَ الأَعْيُنِ الرُّمُدِ"]]},"50F3799C-2651-5AC7-8B7C-A61AAC9B78B6":{"t":"يَا زَمَانَ الرِّضَا لَنَا هَلْ تَعُودُ","p":186,"s":"يا زمان الرضا لنا هل تعود","r":"447392","v":[["4BEB99F3-1D32-5146-A3BF-07B244572D0E","يَا زَمَانَ الرِّضَا لَنَا هَلْ تَعُودُ","وَلأَيَّامِ وَصْلِنَا هَلْ تُعِيدُ"],["DCA09950-7153-5BDA-8DC7-EACC7AB28100","وَعُهُودُ الحِمىَ كَمَا قَدْ عَهِدْنَا","حَبَذا لَوْ تَكُونُ تِلْكَ العُهُودُ"],["ACE8FCF6-A7FA-5A24-AE29-F2B0EDC6C0A7","كَمْ نَعِيمٍ لَنَا بِنُعْمَى تَقَضَّى","بِوصَالٍ قَدْ غَابَ عَنْهُ الحَسُودُ"],["134F02D2-A32F-5E0B-B634-7E7717068834","يَا أُهَيْلَ الحِمَى حَلَلْتُمْ بِقَلْبِي","جَنَّةً لِلغَرَامِ فِيهَا وَقُودُ"]]},"1B1CD07B-DC22-5171-9CB1-BA0AB9F8CF21":{"t":"يَا ساكِنينَ بِقَلْبِي","p":186,"s":"يا ساكنين بقلبي","r":"447327","v":[["CA767A8A-0431-5A6B-8CA4-6A0AEC9F7E0D","يَا ساكِنينَ بِقَلْبِي","مَتَى أَفُوزُ بِقُرْبِ"],["E6E344E5-5F37-5AD3-9A2A-B0E084D7DD7B","سَلَبَتُمُونِي وَلَكِنْ","أَنَا السَّعِيدُ بِسَلْبِي"],["FCB80DD3-FC68-5CB4-AE1D-11CE7661EB6A","يَا عُرْبَ وَاديَ المُصَلاَّ","لأَنْتُمُ خَيْرُ عُرْبِ"],["560F1F6B-4C06-5420-9B6D-9057D9463247","نَزِيلُكُم مُسْتَهَامُ","مُوَلَّهُ القَلْبِ مَسْبي"],["24C4423B-256C-56F9-80BD-53EEEA89D4D9","وَلَسْتُ أَسْلُو هَوَاكُمْ","حَاشَا غَرَامِي وَحُبِّي"],["1EC668F0-7ED6-5087-837B-2DDC805ED51F","إذا رَضِيتُمْ تَلاَفِي","فَذَاكَ مَطْلُوبُ قَلْبِي"],["67E2828B-4161-51AF-ADFE-E9CED92C9933","رُوحِي لَكُمْ إِنْ قَبِلْتُمْ","وَالرُّوحُ جَهْدُ المُحِبِّ"],["567C24C8-FDE0-51F1-9D44-955D9603AB74","أَنْتُمْ ذَخِيرَةُ قَلْبِي","يَوْمَ المَعَادِ وَحَسْبِي"],["B591484A-0BD5-5985-A601-2388A3B2A3F8","عَشِقْتُكُمْ وَبِحَقِّي","إِنْ تِهْتُ مِنْ فَرْطِ عُجْبي"],["5B02B810-220E-5E23-A8CB-DCDA97A0514E","وَمِلْتُ سُكْراً وَلِمْ لاَ","وَمِنْكُمُ كَانَ شُرْبي"],["339E525D-6A0F-5CE2-B3E8-101890F68F2A","وَقَدْ سَقَانِي حَبِيبي","وَخَصَّنِي دُونَ صَحْبِي"],["401B7B38-B8FF-5152-8D7B-E0264A4E0CAC","وَلَسْتُ بَعْدَ عَيَانِي","جَهْراً سَنَا وَجْهِ رَبِّي"],["0B546DB7-E8D2-574C-A7EC-3B5DFCC3EE95","أَصْبُو لِرَنْدٍ وَبَانٍ","وَذِكْرِ غَارٍ وَكُثْبِ"]]},"3F9F5E99-D36B-5B0D-8828-C40E64A5BA1F":{"t":"يَا سَيْفَ مُقْلَتِهِ سَكِرْتَ فَعَرْبِدِ","p":186,"s":"يا سيف مقلته سكرت فعربد","r":"447391","v":[["42C07892-5BD4-5DD5-912D-24E185AAF63F","يَا سَيْفَ مُقْلَتِهِ سَكِرْتَ فَعَرْبِدِ","كَيْفَ اشْتَهَرْتَ عَلى المُحِبِّ المُكْمَدِ"],["254C2CBE-612A-53B5-A656-9448E17CDF65","ورَمَيْتَ عَنْ قَوْسِ الفُتُورِ فَأَصْبَحَتْ","غَرَضاً لأَسْهُمِكَ القُلُوبُ فَسَدِّدِ"],["9ED3726A-C004-5BC1-883D-BD2CA38E602F","مَنْ لَمْ يَمُتْ بِعَذَابِ حُرْقَةِ قَلْبِهِ","مُتَنَعِّماً لاَ فَازَ مِنْكَ بِمَوْعِدِ"],["C90A122B-0BA9-5FEB-9BE2-6B8FF761E6FA","لِلصَّبِّ أُسْوَةُ خَالِ خَدِّكَ إِنَّهُ","مُتَمَتِّعُ فِي جَمْرِهِ المُتَوَقِّدِ"]]},"CD56550B-76A2-5E20-A609-EF677AFBB256":{"t":"يَا عَرَبَ الحَيِّ عُذَّلِي عَدَدُ","p":186,"s":"يا عرب الحي عذلي عدد","r":"447414","v":[["1F67AC88-4F93-5514-A472-E55FD361F42A","يَا عَرَبَ الحَيِّ عُذَّلِي عَدَدُ","وَيْلاَهُ أَيْنَ الرِّجَالُ وَالعُدَدُ"],["876B58BA-E28D-5795-86AF-795CDD8EEA25","مَا صَحَّ فِي حُبِّهِ سِوىَ سَقَمِي","بِكُمْ وَمَاتَ السُّلُو والجَلدُ"],["F398EFB9-2E14-57A1-B0EE-A411FD1CA1B9","عَهْدِي وَجِيدُ الكَثيِبِ طَوَّقَهُ","مِنْكُمْ بِطَوْقٍ كَالعِقْدِ يَنْتَضِدُ"],["735DD2E8-E8C9-522D-8D18-F3450BAD2A0A","يَزْدَادُ مِنْ مَاءِ ورْدِهِ عَطَشاً","لحِسُنِهِ كُلٌّ وَارِدٍ يَرِدُ"],["56334D0A-27F1-5B22-81AF-867128C2BB70","مِنْ كُلِّ رَامِي العُيُونِ مَعْرَكَةٌ","مَعْ وَجْنَتَيْهِ وَصُدْغُهُ الزَّرَدُ"]]},"85F6DCFA-4209-5294-996D-9474968DDAFB":{"t":"يَا نَسْمَةَ البَانِ هُبِّي","p":186,"s":"يا نسمة البان هبي","r":"447326","v":[["F9E0F870-EE86-5DEF-9ACF-31E32C4127E9","يَا نَسْمَةَ البَانِ هُبِّي","عَلَى رُسُومِ المُحِبِّ"],["913D468C-8E4F-578A-8AF3-9CEA466EEA6D","وَمَا عَلَيْكِ إِذَا مَا","وَقَّدْتِ نِيْرَانَ قَلْبي"],["B4AA0D7F-6EC5-5DA1-8110-9E2966A1E7A6","إنْ تَكْتُمِي سِرَّ لَيْلَى","فطِيبُهَا عَنْهَا يُبْنِي"],["D7CC5032-6546-5478-8AB5-8FB2ACF6C0EF","أَوْ لاَ فَمَا لَشَذَاهَا","يُسْبِي العُقُولَ وَيُصْبِي"],["F2D79D31-4E1F-561F-BCED-CA616F91AED3","أهْدَتْ إِليَّ حَدِيثاً","فَهِمْتَهُ دُونَ صَحْبِي"],["425090E8-037D-5859-9FD8-3867FF88D757","فَحَلَّ فِي الحَالِ سَلْبِي","دُونَ الجَمِيعِ وَنَهْبِي"],["AADA3CB7-C4C4-58EB-8034-DC0F0EA9E5D5","يَا طَالِباً حَيَّ لَيْلَى ذ","ذَاتِي حِمَاهَا فَطُفْ بِي"],["EB1A1530-191B-599C-8C55-D6AD02F17BF0","وَنَادِ بَاسْمِي تَجِدْهَا","عَلَى لِسَانِي تُلَبِيِّ"]]}}}