{"v":1,"poems":{"8AC13723-96CA-5C7E-B245-D8CAD081B4F3":{"t":"أَتاني أَخٌ مِن غَيبَةٍ كانَ غابَها","p":87,"s":"أتاني أخ من غيبة كان غابها","r":"474108","v":[["CF7CDCA2-9B26-5F67-8312-A3E2086228F7","أَتاني أَخٌ مِن غَيبَةٍ كانَ غابَها","وَكُنتُ إِذا ما غابَ أَنشُدُهُ رَكبا"],["E95A1BD8-7DEB-5154-ACAB-F1910C420AD8","فَجاءَ بِمَعروفٍ كَثيرٍ فَدَسَّهُ","كَما دَسَّ راعي السَوءِ في حِضنِهِ الوَطَبا"],["231176E8-4162-578E-89D0-300C281B4293","فَقُلتُ لَهُ هَل جِئتَني بِهِدِيَّةٍ","فَقالَ بِنَفسي قُلتُ أَتحِف بِها الكَلبا"],["D58E869E-1BD3-5F22-BF63-0E02283C96A8","هِيَ النَفسُ لا أَرثي لَها مِن بَلِيَّةٍ","وَلا أَتَمَنّى أَن رَأَيتُ لَها قُربا"]]},"63565D73-9711-5935-A4A5-F97EE9A23700":{"t":"أَمُحرِزُ ما نَظَرتُ إِلَيكَ إِلّا","p":87,"s":"أمحرز ما نظرت إليك إلا","r":"474113","v":[["7C49E9D4-27F7-5556-83F6-6266E729E05F","أَمُحرِزُ ما نَظَرتُ إِلَيكَ إِلّا","ذَكَرتُ مِنَ النِساءِ عَجوزَ لوطِ"],["1D0EC8C4-EB3B-5985-AD3C-5B39E815D4AE","أَرى شَعَراً بِخَدِّكَ غَيرَ حُلو","شَبيهاً حينَ يُمشَطُ بِالخُيوطِ"],["774C9D98-44D5-57A8-BE5D-8E92A5EE82CD","فَما شَيءٌ بِاَشبَهَ مِن عَجوزٍ","إِذا فَكَّرتَ مِن شَيخٍ سَنوطِ"]]},"ADA9722F-CA62-55E1-8391-EAD6EA34D4D3":{"t":"إِنَّ الخَليطَ نَسّاكَ أَجمَعُهُ","p":87,"s":"إن الخليط نساك أجمعه","r":"474141","v":[["C088C6A8-5F0F-5F05-AE41-EBBDF2692FA6","إِنَّ الخَليطَ نَسّاكَ أَجمَعُهُ","وَنَسّاكَ بَعدَ البَينِ مَربَعُهُ"],["DEB2806E-BF5F-5DA2-B526-C30DC9E7E918","وَأَجَنَّ قَلبُكَ مِن فِراقِهِمُ","شَوقاً فَكادَ الوَجهُ يَصدَعُهُ"],["5F15835C-19F2-5F1A-A5AB-BD393E1763BE","أَو كُلَّما دَعَتِ الحَبيبَ نَوىً","جادَت مَسارِبَهُنَّ أَدمُعُهُ"],["8C001A82-0589-50B6-A6B0-65439F4AF87E","فَكَأَنَّ سُنَّةُ مُحَلِّفٍ حَلَفا","فَالدَمعُ يَسبِقُهُ وَتَقرَعُهُ"],["F6676A7E-8878-58CA-9DB2-E955B966E5D5","وَإِذا أَقولُ صَحَت عَمايَتُهُ","عادَ الهَوى لِلقَلبِ يَردَعُهُ"],["4E1E9333-7789-5CF2-A3BC-2ADA83EEDDE9","فَرَمَيتُ بِالعَينَينِ ظَعنَهُمُ","فَدَنا فَأَروى الشِعرَ رَعرَعُهُ"],["8C851A75-CC68-5F31-A9D4-34BB4066D6FE","وَالبيدُ قَد نَشَرَت سَباسِبَها","آلاً تُسَربِلُهُ وَتَخلَعُهُ"],["EF4E8ED7-5CD5-52CB-A90B-1B9F1224DEE9","وَكَأَنَّهُم فَوقَ العُيونِ ضَحىً","نَخلٌ يَهابُ البَسرَ مونِعُهُ"],["ABF3040F-F77E-5708-8649-5E2673AD3DCA","هَبَّت لَهُ شَآمِيَةٌ","فَالآلُ يَخفَضُهُ وَيَرفَعُهُ"],["C05FF257-9977-595C-9E43-94E8C352928B","فَوقَ الهَوادِجِ رَبرَبٌ كَنُسٌ","مَيلَ الفُروعِ يَميدُ خِروَعُهُ"],["9030C7F8-DD51-5FB1-AC7D-A3243EB5F37B","هيفٌ خَراعِبُ يَأتَزِرنَ عَلى","رَملٍ تَميلُ بِهِنَّ أَكرُعُهُ"],["BED5467F-D7EA-542F-B9F7-8CA7343D6762","وَإِذا اِبتَسَمنَ جَلَونَ عَن بَرَدٍ","عَذبٍ كَأَنَّ الراحَ مَكرَعُهُ"],["8C95E334-BC09-57F0-B34D-517FE2846344","فيهِ جَوىً وَبِهِ الشِفاءُ لَهُ","مِن غُلَّةِ الحَرّانِ يَنقَعُهُ"],["5E064B9F-10CC-5878-AA28-7BA6E26E85C9","وَعَسلاً بِالعَشِيِّ وَحادِراً","أَمسى بِلَونيّهِنَّ مَردُعهُ مُكرَّرُ"],["B295CAE1-0AF2-58CE-B871-908E8B5FA2EE","فَأَرَجنَ مِن قَطَنٍ وَعَنبَرِهِ","وَذكِيُّ فَأَرِ المِسكِ يَسفَعُهُ"],["7A7EF63F-DEC0-5FB8-BFD2-B57202904A4E","فَسَقى بِلاداً هُنَّ ساكِنُها","غَيثٌ رُكامُ المِسكِ يَرفَعُهُ"],["FEB0B58D-B39D-59C2-93BC-3AB00A8B498A","جَودٌ تَزَجّي الريحُ عارِضَهُ","غَيثٌ كَثيرُ النَجدِ يُطلِعُهُ"],["206ADA87-5DF5-5E64-A04A-6A9C728E60A8","وَأَلَحَّ يَكسو الأُكمَ وابِلُهُ","بِصَدى مِنَ الأَعباءِ يُقلِعُهُ"],["1811D4BC-3281-5BFB-A97D-536A80619603","جافٍ عَنِ الدَفَّينِ مَرفَقُهُ","غَوجُ اللَبانِ أُمِرَّ مَصنَعُهُ"],["20D255DB-6D9A-50FF-97F7-0E14D6BFEF72","وَكَأَنَّ فَوقَ مُتونِهِ رَخَماً","أَوفى عَلى الأُذُنَينِ مَوضِعُهُ"],["18E4577F-D4E6-59B5-A8A4-D9732A9D077E","لِكَ المَصعُ أَعظَمُهُ","وَنَما عَلَيهِ النَيُّ يَقرَعُهُ"],["E42BB0B9-FEA0-58D3-80CF-31290D3B2F93","رَحبُ الفُروجِ كَأَنَّ قَنطَرَةً","حَيثُ التَقى في الصُلبِ أَضلُعُهُ"],["068CE071-F2E9-5690-AF33-71582D8231B7","مِن سِرِّ أَرحَبَ جانِبٌ سَدِسٌ","أَو بارِكٌ قَد مُدَّ مَضبَعُهُ"],["FE8BD6F9-3DE9-5622-9E83-A77E1283B127","شَظى المَروُ مَنسَمَهُ","صَكّاً يُغَنّي الشَدوَ وَعوَعُهُ"],["961A2247-91BB-5539-98CA-32A73766FB84","فَكَأَنَّهُ بَعدَ الكَلالِ وَقَد","جَفَّ الثَميلُ وَماجَ أَنسُعُهُ"],["C83BF0A5-40A3-5F0A-AAE0-DD4FA3E9F7EB","حَنَّت لَهُ نُصُعٌ مُجَلَّلَةٌ","حادٍ عَنِ الرُكبانِ مَدرَعُهُ"],["4845F33E-A222-571E-AF8E-53A90B17B0BC","مِن وَحشِ حَومَلَ مُفرَدٌ لَهِقٌ","أَحوى الفَرا وَالخَدُّ أَسفَعُهُ"],["7C5193DE-4CDD-5554-8BA7-E6C4BD1CEF62","سَلِبٌ قَشيبُ الرَوقِ أَسحَمُهُ","وَمُشَبَّهٌ بِالقارِ أَكرَعُهُ"],["D2F0D274-C99A-5CD3-A59C-3EACDD12D5C5","ظَلَّ النَهارَ يَرودُ مُؤتَنِفاً","أَفغى يَقودُ العَينَ مَربَعُهُ"],["8B0B1EE7-E7A4-5EF4-96AB-B43B25D50790","حَتّى إِذا أَفِدَ الزَمانُ رَأى","بَرقاً أَحالَ عَلَيهِ لُمَّعُهُ"],["AE1EFDCF-54C7-58F1-ACA0-16D4D4C152A4","فَنَمى إِلى سَدِرٍ بِمَربَكَةٍ","قَد كانَ يَلويهِ وَيَصنَعُهُ"],["B782C97D-6C71-527E-96E7-8105F7B2944C","في غَرقَدٍ هُدبٍ جَوانِبُهُ","نَجَفٍ يَلوذُ بِهِ وَيَمنَعُهُ"],["920A48E2-18AF-53A5-AF73-7B85AA71EDD1","حَتّى إِذا أَلقى أَكارِعَهُ","لِمَبيتِهِ فَأَطاعَ مَضجَعُهُ"],["7CA490C1-9CB1-5DB8-A998-5F48E3AE84A6","هَدَمَ الشَمالُ عَلَيهِ بُنيَتَهُ","فَاِبتُزَّ عَن عَينَيهِ مَهجَعُهُ"],["97903C7A-34CD-55F5-A480-65BF5B3A9352","فَاِحتَمَّ يَكحَلُ عَينَهِ سَهَدٌ","وَالماءُ يَركَبُهُ وَيَدفَعُهُ"],["35598307-474F-5529-8C88-E1B45530D2A5","يُسدي بِهِ وَيَبيتُ لَيلَتَهُ","خَضِلاً مِنَ التَهتانِ أَزمُعُهُ"],["AD29E01D-882A-51EE-9F9F-0F3A84D8C949","وَيُثيرُ رَونَقَهُ وَيُفزِعُهُ","وَقعٌ مِنَ الثُعبانِ يَسمَعُهُ"],["E13EFD26-8F14-56A7-B9C8-9E65165B46C2","وَيَظَلُّ يَركَبُ أَنفَهُ عَرَصاً","بِمبيتِهِ طَوراً وَيَتبَعُهُ"],["6BA021C9-6B6F-573B-BFD9-19C8E3F8FA95","وَأَفاقَ بَعدَ النَحسِ طائِرُهُ","وَجَلا ظَلامَ اللَيلِ يَقشَعُهُ"],["DFC376EC-2CE8-5F62-B46C-911AAF5B4383","فَغَدا كَنَصلِ السَيفِ مُضطَمِراً","وَحشاً بِظَهرِ الغَيبِ يَسمَعُهُ"],["B85C1A00-AF9A-522E-9CD3-A5197FF53554","فَكَأَنَّ سُندُسَةً لَها كَنَفٌ","جيبَت بِحَيثُ الرَوقُ يَرفَعُهُ"],["7D409462-3C9D-5266-94F8-2166356D10C9","فَغَدا لَهُ مِن سِنبِسٍ لَحمٌ","كَالسيدِ صَعلُ الرَأسِ أَصمَعُهُ"],["E03598CA-1208-5E0F-806A-80F20C841472","مُتَقَلِّداً قَوساً وَأَرشِيَةً","وَالنَبلُ في قَرنٍ يُقَعقِعُهُ"],["C028CCBB-135C-579D-B331-95727A4A6884","مَعَهُ ضَوارٍ مِن سَلوقَ لَهُ","طَوراً تُعانِدُهُ وَتَتبَعُهُ"],["6FA4C206-480B-5A87-8126-F37A69B15D42","أَشلاؤُها فَإِذا سَبَقنَ مَعاً","وَعَدا وَقورُ القَلبِ أَصمَعُهُ"],["D1E9F668-9C7D-5F87-9DD8-B8153EB0EE8E","دونَ المُجِدِّ وَفَوقَ مَهزِلُهُ","مُستَغرِزٌ لِلكَرِّ مُزمِعُهُ"],["E80C4804-5238-521B-B48B-0933C8765F54","فَلَحِقنَهُ هُبّى وَقَد طَمِعَت","غَضبانُ ثاني الجيدِ أَخضَعُهُ"],["C72F57AB-122E-54C6-9ACF-261D7EA3A941","يَنحو لَها الرَوقَينِ عَن سَرَبٍ","صَدقٌ بِجَلحِ الطَعنِ مُسرِعُهُ"],["448E8951-FE68-5AD2-9DB1-7DD257F20B1C","فَتَرى لَها طَمَعاً فَتَركَبُهُ","وَالمَرءُ أَحمَرُ حَيثُ مَطمَعُهُ"],["0AA565D3-1F73-5028-A2D4-83BEF12B39FE","فَلَهُ بَراثِنُ بَينَها وَبِها","نَضحٌ مِنَ الأَجوافِ تَدسَعُهُ"],["44386AB6-A5F1-5838-9472-B0049190091B","وَرَأى المُكَلَّفُ طَيرَهُ بَرَحَت","نَحساً وَلاقى المَوتَ أَجدَعُهُ"],["8A0D717B-3D44-5857-AFF1-4DCC3772D388","وَتَرَمَّلَت بِدَمٍ قَداماهُ وَقَد","أَوفى اللِحاقُ وَحانَ مَصرَعُهُ"],["CF7C94C8-FAA0-5A35-978E-633392B8E8A6","وَمَضى عَلى صَدرٍ كَأَنَّ بِهِ","جِنّاً يَطيفُ بِهِ وَيَنسَعُهُ"],["0D30F13D-00EB-5512-AAD3-681A2BDFC1F6","كَالكَوكَبِ الدُرِّيُّ مُسَّدِلاً","سَدّاً كَحِسِّ النارِ مَقمَعُهُ"],["D53E4BEE-C205-5846-8792-6AB1255FB73C","وَاِرفَضَّ عَن أَظلافِهِ وَبِها","فِلَقُ الحَصى وَيَطيرُ يَرمُعُهُ"],["F8F4D865-4EAE-5863-BD95-2E31F40AE7EC","مُستَقبِلاً وَجهَ الشَمالِ لَهُ","زَجَلٌ عَلى رَوقَيهِ يَقرَعُهُ"],["D3E6F748-ECD9-51DF-9505-694324D7C5AA","وَكَأَنَّما جَهَدَت أَلِيَّتُهُ","أَلّا تَمَسَّ الأَرضَ أَربَعُهُ"],["E703256C-6F58-5180-8B36-FF818651347E","وَيلَ أُمِّهِ حَمِشاً بِصَعدَتِهِ","وَمُوائِلاً إِذ جَدَّ مَفزَعُهُ"],["E5D80C61-AB94-5C59-ABB7-6DAE7CAC2425","وَمُلَعَّنٍ يَنأى بِسافِيَةٍ","غُفُلِ الصُوى حَدبٍ مُجَعجَعُهُ"],["294363EF-F032-5CF0-873A-F0EEED9B9C84","سُدمٌ مَناهِلَهُ تَهيمُ بِهِ","سِربُ القَطا الجَونِيِّ مَوقِعُهُ"],["05B6CE7B-6F0D-5ED1-802E-3315FDCA216D","نَفَرَت عَلى أَرجاءِ مَنهَلِهِ","خُلُطاً مِنَ الوُرّادِ يَجمَعُهُ"],["E0E25209-1A2B-5D18-A354-EBD962250062","وَاللَيلُ قَد أَلقى بَوانِيَهُ","وَالصُبحُ ذو طُرُقَينِ مَقنَعُهُ"],["089A3478-2167-5A06-997B-135088F26479","فَكَشَفتُ عَن ذي جَمَّةٍ عُصُباً","تَنزو عَلى بَرَّيهِ ضَفدَعُهُ"],["8C2B024B-B876-5A2F-942E-78ABB98556FD","فَثَنى لَهُ الرُكبَينِ ثُمَّ حَنا","فَاِستَدَّ بِالعَلباءِ أَخدَعُهُ"],["8A34D7EC-A6ED-5ECB-9D60-A1FD2CD68A16","وَكَأَنَّما اِرتَجَسَت مَلاغِمُهُ","بِالصَخرِ هَذا الماءَ يَجرَعُهُ"],["A28AD571-06DA-5685-A2C2-5FB339B43855","فَنَحا إِلى الحَيزومِ فَنَحا","الضَفيرُ وَكادَ يَقطَعُهُ"],["AAAFC93A-A1ED-5FB2-9215-EAF1145D05EF","فَحَمَيتُ مُقلَتَهُ وَقَد وَهَمَت","دَولاً يَصَبُّ بِهِ وَيُمنَعُهُ"],["1D6E6072-1AF7-5F55-9017-EF5EDEE519FD","وَغَدا لَهُ بِالبيدِ خَطرَفَةٌ","مُتَرَغِّماً غَضبانَ أَقدَعُهُ"],["E40CE33A-8EDB-599A-810D-B1359F73C217","تَكسو مَشافِرَهُ مُكَرَّرَةٌ","هَذا يَطيرُ عَلَيهِ خُرفُعُهُ"],["4E3EA8FC-ABE0-5DF1-BD47-323A5A998892","وَعُدولَةٍ عُنُدٍ مُبَرَّكَةٍ","حَيرانَ يَعوي حَيثُ مَشرَعُهُ"]]},"53E4CAA1-E384-543F-B803-E1AF4CCE4774":{"t":"إِنَّ بِالشَعبِ الَّذي دونَ سَلعٍ","p":87,"s":"إِنَّ بِالشَعبِ الَّذي دونَ سَلعٍ","r":"474117","v":[["1D45656A-E76A-50D3-9C21-0462D0963192","إِنَّ بِالشَعبِ الَّذي دونَ سَلعٍ","لَقَتيلاً دَمُهُ ما يُطَلُّ"],["A79E1217-3489-5749-864D-4D51065D6156","خَلَّفَ العِبءَ عَلَيَّ وَوَلّى","أَنا بِالعِبءِ لَهُ مُستَقِلُّ"],["9DDDF58D-5247-5B1B-8584-EC6F0F747A70","وَوَراءَ الثَأرِ مِنّي اِبنُ أُختٍ","مَصِعٌ عُقدَتُهُ ما تُحَلُّ"],["7B5578B2-47F2-50A9-9101-F521D14CA596","مُطرِقٌ يَرشُحُ سُمّاً كَما أَط","رَقَ أَفعى يَنفُثُ السُمَّ صِلُّ"],["347B842B-27C2-5EB0-A5E5-077543280BDD","خَبَرٌ ما نابَنا مُصمَئِلٌّ","جَلَّ حَتّى دَقَّ فيهِ الأَجَلُّ"],["63C27A7C-1945-55EF-A3CC-B0946AD28BFA","بَزَّني الدَهرُ وَكانَ غَشوماً","بِأَبي جارُهُ ما يَذِلُّ"],["D430EE46-D82A-57EB-8FFD-34D9418B1216","شامِسٌ في القُرِّ حَتّى إِذا ما","ذَكَتِ الشَعرى فَبَردٌ وَظِلُّ"],["54CA9DD0-F1E2-57EC-9B27-6EAAF128804C","يا بِسُ الجَنبَينِ مِن غَيرِ بُؤسٍ","وَنَدِيِّ الكَفَّينِ شَهمٌ مُدِلُّ"],["E3D05B50-63F4-55A2-8568-631A0A8D0C0B","ظاعِنٌ بِالحَزمِ حَتّى إِذا ما","حَلَّ الحَزمُ حَيثُ يَحِلُّ"],["B1E6C0C0-1151-5D71-82A3-9452D823CEC2","وَلَهُ طَعمانِ أَريٌ وَشَريٌ","وَكِلا الطَعمَينِ قَد ذاقَ كُلُّ"],["AE73F24C-5A4C-5EF3-B15F-79460B5E9E25","غَيثُ مُزنٍ غامِرٌ حَيثُ يُجدي","وَإِذا يَسطو فَلَيثٌ أَبَلُّ"],["E1F93D04-D879-54E3-BB10-14D09A8513B4","مُسبِلٌ في الحَيِّ أَحوى رِفَلٌّ","وَإِذا يَغزو فَسِمعٌ أَزَلُّ"],["B7DE48F4-B1E4-5509-B8B8-5FA90EDD6702","يَركَبُ الهَولَ وَحيداً وَلا يَص","حَبُهُ إِلّا اليَماني الأَفَلّ"],["0A025DA8-2F2C-5AB6-861E-07F412F52419","ُوَفُتُوٍّ هَجَّروا ثُمَّ أَسرَوا","لَيلَهُم حَتّى إِذا اِنجابَ حَلّوا"],["DBF73B47-7421-538C-B5F4-0D3D734E780D","كُلُّ ماضٍ قَد تَرَدّى بِماضٍ","كَسَنى البَرقِ إِذا ما يُسَلُّ"],["37C0AB56-C7E6-583C-A3A5-86F67D6B119F","فَاِدَّرَكنا الثَأرَ مِنهُم وَلَمّا","يَنجُ مِن لَحيانَ إِلّا الأَقَلُّ"],["C4A21E2C-79B0-55D3-A347-3A3A2DF051C0","فَاِحتَسَوا أَنفاسَ نَومٍ فَلَمّا","هَوَّموا رُعتَهُم فَاِشمَعَلّوا"],["A1F872CE-A416-5279-8698-A0536B399443","فَلَئِن فَلَّت هُذَيلٌ شَباهُ","لَبِما كانَ هُذَيلاً يَفُلُّ"],["A481AF55-2A8A-5C7C-BBC1-77E8AA3D41D7","وَبِما أَبرَكَها في مُناخٍ","جَعجَعٍ يَنقَبُ فيهِ الأَظَلُّ"],["4DE820AF-0CAA-5637-A8C9-D52AA907DA6E","وَبِما صَبَّحَها في ذَراها","مِنهُ بَعدَ القَتلِ نَهبٌ وَشَلُّ"],["D5F1592F-2E36-5089-B036-0916749223B6","صَلِيَت مِنهُ هُذَيلٌ بِخِرقٍ","لا يَمَلُّ الشَرَّ حَتّى يَمَلّوا"],["BF1E3557-6502-57A2-8357-E92F9B05F5AE","يُنهِلُ الصَعدَةَ حَتّى إِذا ما","نَهِلَت كانَ لَها مِنهُ عَلُّ"],["C96B2EC5-2FBB-5889-964D-35A6201CE736","تَضحَكُ الضَبعُ لِقَتلى هُذَيلٍ","وَتَرى الذِئبَ لَها يَستَهِلُّ"],["1A61FE94-225F-5EF7-9160-D5B93986A0B2","وَعِتاقُ الطَيرِ تَغدو بِطاناً","تَتَخَطّاهُم فَما تَستَقِلُّ"],["49E7D16E-B243-53C6-B6DE-EBF4211F0999","حَلَتِ الخَمرُ وَكانَت حَراماً","وَبِلَأيٍ ما أَلَمَّت تَحِلُّ"],["2A9EBF9F-8620-5CBE-9A00-068635D171F9","فَاِسقِنيها يا سَوادَ بنَ عَمرٍو","إِنَّ جِسمي بَعدَ خالي لَخَلُّ"]]},"72C7ECE6-0B31-5457-934C-048E7740F752":{"t":"إِنّي وَمَن وَسَجَ المَطِيُّ لَهُ","p":87,"s":"إني ومن وسج المطي له","r":"474138","v":[["6BB22DB2-B8B1-5C7A-B1FC-E924EA59EFFA","إِنّي وَمَن وَسَجَ المَطِيُّ لَهُ","حُدبَ الذُرى أَذقانُها رُجُفُ"],["F3632E29-EA63-598F-A246-056E2428271B","يَطرَحنَ بِالبيدِ السِحالَ إِذا","حَثَّ النَجاءَ الرَكبُ وَاِزدَهَفوا"],["7D023951-6248-5B3A-BFF6-05782A1D7C50","وَالمُحرِمينَ لِصَوتِهِم زَجَلٌ","بِفِناءِ كَعبَتِهِ إِذا هَتَفوا"],["7B8A0F8F-0102-5501-98F4-B9FCDDB98EC9","وَإِذا قَطَعنَ مَسافَ مَهمَهَةٍ","قَذَفٍ تَعَرَّضَ دونَها شَرَفُ"],["D37F7ACD-2A9E-514D-870D-1160778BF72C","وافَت بِهِم خوصٌ مُحَزَّمَةٌ","مِثلُ القِسِيِّ ضَوامِرٌ شُسُفُ"],["DAD4EA14-57BE-5168-94F5-53D8CD196F83","مِنّي إِلَيهِ غَيرَ ذي كَذِبٍ","ما إِن رَأى قَومٌ وَلا عَرَفوا"],["3B24E33F-2C83-54BA-9EC0-A150D3ED4801","في غابِرِ الناسِ الَّذين بَقوا","وَالفُرَّطِ الماضينَ إِذ سَلَفوا"],["ECF18470-29D0-5667-B3B3-B7CD54C83BDB","أَحَداً كَيَحيى في الطَعنِ إِذا","اِفتَرشَ القَنا وَتَضَعَضَعَ الحَجَفُ"],["CECDF9BD-0B96-5021-9B8E-E852C1E8C349","في مَعرَكٍ يُلقى الكَمِيُّ بِهِ","لِلوَجهِ مُنبَطِحاً وَيَنحَرِفُ"],["B3155DA8-C62F-50DD-8FF8-E2B488C3607C","وَإِذا أَكَبَّ القِرنُ يُتبِعُهُ","طَعناً دوَينَ صَلاهُ يَنخَسِفُ"],["D4016259-0AAC-5C06-9BC6-93BB9344E161","لِلَهِ دَرُّكَ أَيُّ ذي نُزُلٍ","في الحَربِ إِذ هَمّوا وَإِذ وَقَفوا"],["1EA92B35-E00D-52F8-A48F-194E0AB40230","لا تُخطِئُ الوَجعاءَ أَلَّتُهُ","وَلا تَصُدُّ إِذا هُم زَحَفوا"],["C4B1B14A-35FF-5676-96C2-8D83480CBD28","وَلَهُ جِيادٌ لا يُفَرِّطُها","الإِحلالُ وَالمِضمارُ وَالعَلَفُ"],["3DEE938C-09AE-50E5-8630-DA35BED344CD","جُردٌ يُهانُ لَها السَويقُ وَأَل","بانُ اللِقاح كَأَنَّها نُزُفُ"],["24A8621A-29A0-5B4C-97AC-B38EECCDE233","مُردٌ وَأَطفالٌ تَخالُهُم","دُرّاً تَطابَقَ فَوقَهُ الصَدَفُ"],["E5CFD55E-F8C0-5FEF-97C1-C3E4DA6BEE15","فَهُم لَدَيهِ يَعكِفونَ بِهِ","وَالمَرءُ مِنهُ اللِيَنُ وَاللُطُفُ"],["87580CF7-4D5A-5704-BB3A-C7E021F9EE46","وَمَتى يَشا يُجنَب لَهُ جَذَعٌ","نَهدٌ أَسيلُ الخَدِّ مُشتَرِفُ"],["6EE9F034-D172-5566-96DB-506CD13C8B05","يَمشي العِرَضنَةَ تَحتَ فارِسِهِ","عَبلَ الشَوى في مَتنِهِ قَطَفُ"],["0F427AC7-4FF9-58F9-833E-4DDF9B5A2A3D","رَبِذٌ إِذا عَرِقَت مَغابِنُهُ","ذَهَبَ السُكونُ وَأَقبَلَ العُنُفُ"],["AAC666AA-EACA-5A9F-A7C7-B1794375F3B3","فَأَعَدَّكَ ذاكَ لِسَرجِهِ وَلَهُ","في كُلِّ غادِيَةٍ لَها عُرُفُ"],["E0C69973-A7A6-5550-84B0-DC40414C2579","في حَقوِهِ عَرِدٌ تَقَدَّمَهُ","صَلعاءُ في خَرطومِها قَلَفُ"],["01D43C16-7EDE-509C-879A-5A605BF83952","جَرداءُ تَشحَذُ بِالبُزاقِ إِذا","دُعِيَت نَزالِ وَهَبَّ مُرتَدِفُ"],["01F8905C-A3DC-53D0-A6FE-074F79A34344","أَوفى عَلى قَيدِ الذِراعِ شَدي","دُ الجَلزِ في يافوخِهِ جَوفُ"],["1BF49DFF-7F4D-5520-A30E-75DC0E5C9357","خاظٍ مُمَرٌّ مَتنَهُ ضَرِمٌ","لا خانَهُ خَورٌ وَلا قَضَفُ"],["0C81BC0B-BD67-5828-91B1-F8FCB400C031","عَردُ المَجَسِ بِمَتنِهِ عُجَزٌ","في جِذرِهِ عَن فَخذِهِ جَنَفُ"],["286FE626-7D7D-5DE9-A7B9-B6395EE6D75F","فَلَو أَنَّ فَيّاضاً تَأَمَّلَهُ","نادى بِجُهدِ الوَيلِ يَلتَهِفُ"],["89490E25-491F-57BF-BC7D-379468C3C84E","وَإِذا تَمَسَّحَهُ لِعادَتِهِ","وَدَنا الطِعانُ فَمِدعَسٌ ثَقِفُ"],["756C14F6-3D5B-5E64-9C42-D93EDDBA357F","وَإِذا رَأى نَفَقاً رَبا وَنَزا","حَتّى يَكادُ لُعابُهُ يَكِفُ"],["028A9131-6479-5F70-B8D1-3D8A8129FF09","لا ناشِئاً يُبقي وَلا رَجُلاً","فَنِداً وَهَذا قَلبُهُ كَلِفُ"],["DFE5D7D9-BED6-5039-B614-1903C24F9655","يا لَيتَني أَدري أَمُنجِيَتي","وَجناءُ نادِيَةٌ بِها شَدَفُ"],["599F9979-8064-5E08-90A9-C4C7590EB2C4","مِن أَن تَعَلَّقَني حَبائِلُهُ","أَو أَن يُواري هامَتي لُجُفُ"],["E699C4E7-0505-5645-B143-EE5B7DEF95CE","وَلَقَد أَقولُ حِذارَ سَطوَتِهِ","إيهاً إِلَيكَ تَوَقَّ يا خَلَفُ"],["BF23BD0B-4A8A-5BFC-8EFF-2325A463C42D","وَلَو أَنَّ بَيتَكَ في ذُرى عَلَمٍ","مِن دونِ قُلَّةِ رَأسِهِ شَعَفُ"],["35C1167B-4E55-5465-A243-219B54FCE2C7","زَلِقٍ أَعاليهِ وَأَسفَلُهُ","وَعرُ التَنائِفِ بَينَها قُذُفُ"],["60FEA2A8-3669-584A-AD5B-338319DEA250","لَخَشيتُ عَردَكَ أَن يُبَيِّتَني","إِن لَم يَكُن لي عَنهُ مُنصَرَفُ"]]},"D6639147-46DF-5E28-8C95-20EF3090014E":{"t":"اِبعَث عَلى الكَذابِ في بَردِ السَحَر","p":87,"s":"ابعث على الكذاب في برد السحر","r":"474119","v":[["0891E7D7-B7E8-527F-B0B4-9C9741A32772","اِبعَث عَلى الكَذابِ في بَردِ السَحَر","حِيَّةَ غارٍ في مُنيفٍ مُشمَخِر"]]},"FBB78BA2-A431-5201-B879-9A6C1DC5AC68":{"t":"اِبعَث لَهُ مِنَ الرُتَيلى سَقَما","p":87,"s":"ابعث له من الرتيلى سقما","r":"474134","v":[["A1D8EA1E-942E-52BE-A2FE-60B46D73B5EF","اِبعَث لَهُ مِنَ الرُتَيلى سَقَما","مَذبوبَةً تَبعَثُ فيهِ أَلَما"],["DFD7DDD8-BAE2-507D-8B7A-E54922ADABFA","يَظَلُّ مِنهُ لَحمُهُ مُقَسَّما","دَهماءَ مِثَلَ العَنكبوتِ أَيِّما"],["302EBD5C-8368-5D96-AAA6-38C69C63B3A7","لَم تُبقِ بَعلاً لا وَلَم تُبقِ إِماءَ","جَزاءَ خَطّابٍ بِما تَأَثَّما"]]},"A78A9F6A-0D20-5FAD-AAA0-3E561D08086E":{"t":"اِبعَث لَهُ يا رَبِّ ذاتَ أَرجُلِ","p":87,"s":"ابعث له يا رب ذات أرجل","r":"474132","v":[["86651FE4-6DE0-5DB7-8B54-5095A7C34652","اِبعَث لَهُ يا رَبِّ ذاتَ أَرجُلِ","في فَمِها أَحجَنُ مِثلُ المِنجَلِ"],["39295BFB-72F0-570D-9FF0-68903245DB01","دَهماءَ مِثلَ العَنكَبوتِ المُحوِلِ","تَأخُذُهُ مِن تَحتِهِ وَمِن عَلِ"]]},"0C36EAB0-9072-5516-96F9-6C52BA0999D2":{"t":"سَقى حُجّاجَنا نَوءُ الثُرَيّ","p":87,"s":"سقى حجاجنا نوء الثري","r":"474115","v":[["E6320FF9-0B20-5600-95E9-A5082D60F8B5","سَقى حُجّاجَنا نَوءُ الثُرَيّا","عَلى ما كانَ مِن لُؤمٍ وَبُخلِ"],["1AFA9FD8-745F-5EE4-8F24-2ED8A03F98EF","هُمُ شَدّوا القِبابَ وَأَحرَزوها","فَلَو زادوا لَها باباً بِقُفلِ"],["C0FBAAD3-5A4B-51E9-9E20-2A816597B31D","وَقَد عَدّوا لَنا شَيئاً بِشَيءٍ","مُقايَضَةً لَهُ مِثلاً بِمِثلِ"],["5041C317-A55C-5BE2-808E-C03F4441376B","فَإشن أَهدَيتُ فاكِهَةً وَكَبشاً","وَعَشرَ دَجائِجٍ بَعَثوا بِنَعلِ"],["1898B380-4A97-5825-86BB-5EC9DEF27730","وَمِسواكَينِ طولُهُما ذِراعٌ","وَعَشرٍ مِن صِغارِ المُقلِ خَشلِ"],["90C187AB-F07C-54BD-A20B-F9F3C23DE453","فَإِن أَهدَيتُ ذاكَ لَيَحمِلوني","عَلى نَعلٍ فَدَقَّ اللَهُ رِجلي"],["73230B7D-7A0E-5869-8493-88E9D3FEC464","أُناسٌ ما ئِهونَ لَهُم رُواءٌ","تَغيمٌ سَماؤُهُم مِن غَيرِ وَبلِ"],["32B7C9A9-F8A7-5DDD-A96C-2C02D53C55FB","إِذا نُسِبوا فَحَيٌّ مِن قُرَيشٍ","وَلَكِنَّ الفِعالَ فِعالُ عُكلِ"]]},"234E9176-25D2-5963-AF6B-5905A687FEF7":{"t":"صَبَّ الإِلَهُ عَلى عُبَيدٍ حَيَّةً","p":87,"s":"صب الإله على عبيد حية","r":"474092","v":[["23951F62-B0BC-5D14-B57A-ED00904C818F","صَبَّ الإِلَهُ عَلى عُبَيدٍ حَيَّةً","لا تَنفَعُ النَفَثاتُ فيها وَالرُقى"],["8D5DF42F-5209-56DB-8527-0D1B9FBE5E1D","جَبَلِيَّةٌ تَسري إِذا ما جَنَّها","لَيلٌ وَتَكمُنُ بِالنَهارِ فَما تُرى"],["30B041B2-5BD0-544B-BE76-4780721B785C","مَهروتَةُ الشِدقَينِ يَنطُفُ نابُها","سُمّا تَرى ما إِن يُهابُ وَيُتَّقى"],["5E2B7227-6C69-561E-A6C5-0490E8C9429D","خَضِرَت لَها عُنُقٌ وَسائِرُ خَلقِها","بَضٌّ يَبينُ كَمِثلِ مِصابحِ الدُجى"],["8D094B0A-30E5-5863-9507-17D76D881B31","وَكَأَنَّ لَبِسَت بِأَعلى لَونِها","بُرداً مِنَ الأَثوابِ أَنهَجَهُ البِلى"],["E22540F0-AFC4-545D-B32D-22298AA6834F","رَقشاءُ تَقتَصِدُ الطَريقَ إِذا دَنا","مِنها المَساءُ كَأَنَّها ثِنيا رِشا"],["14FE2E15-4435-5670-B174-DFE8051995AA","قَرناءُ أَنساها الزَمانُ فَأَدرَكَت","عاداً فَلَيسَ لِنَهشِهِ مِنها شَفا"],["CB88AFD3-2866-5C23-AD21-015E8841B216","أَو حَيَّةً ذا طُفيَتَينِ أَحَلَّهُ","آباؤُهُ في شامِخٍ صَعبِ الذُرى"],["2DD53D08-4DB7-5D2E-9FF6-14B3103FC0C3","فَنَشا بِغارِ مُظلِمٍ أَرجاؤُهُ","لا الريحُ تُصرِدُهُ ولا بَردُ الشِتا"],["90885E4D-346A-59EA-96C3-802D2F41D95B","لَم تَغشَهُ شَمسٌ وَحالَفَ قَعرَهُ","فَنَهارُهُ وَمَساؤُهُ فيهِ سَوا"],["42DF05FB-95B6-5C88-82A4-4A9933537C20","لَو عَضَّ حَرفَي صَخرَةٍ لَتَطايَرَت","مِن نابِهِ فَلَقاً كَأَفلاقِ النَوى"],["B3AA6067-F6D9-54C7-AE2D-207D98F39182","أَو حالِكاً أَمّا النَهارُ فَكامِنٌ","مُتَطَرِّقٌ فَإِذا رَأى لَيلاً سَرى"],["5648A0B7-F567-5862-ABBE-3124786A7DC5","في عَينِهِ قَبَلٌ وَفي خَيشومِهِ","فَطَسٌ وَفي أَنيابِهِ مِثلُ المُدى"],["EAB0AD50-33A4-5D18-BC27-890354C639AA","يَلقى عُبَيداً ماشِياً مُتَفَضِّلاً","مُتَخَلِّقاً قَد مَلَّهُ طولُ السُرى"],["9B5626E1-FCBD-55E3-A2CD-3EE43F1DB10D","في لَيلَةٍ نَحسٍ يَحارُ هُداتُها","لا لابِساً خُفّاً يَقيهِ وَلا حِذا"],["0B5867AF-6180-5356-88FF-0FAD53714391","فَيَحوصُهُ في كَعبِهِ بِمُذَرَّبٍ","ماضٍ إِذا أَنحى عَلى عَظمٍ فَرى"]]},"62DC7536-DC8D-5BF9-9EC2-E42EEF951063":{"t":"فَلَمّا أَصاتَت عَصافيرُهُ","p":87,"s":"فلما أصاتت عصافيره","r":"474136","v":[["34BA0A2B-3F61-5712-9084-48C7739C4BA6","فَلَمّا أَصاتَت عَصافيرُهُ","وَلاحَت تَباشيرُ أَرواقِهِ"],["885B1CAF-4826-580E-93E8-D9F43C54DE8D","غَدا يَقتَري أُنُفاً عازِباً","وَيَلتَسُّ ناضِرَ أَوراقِهِ"]]},"138554C3-2688-56D6-AF62-C8AA599B33BF":{"t":"قَدكَ مِنّي صارِمٌ ما يُفَلُّ","p":87,"s":"قدك مني صارم ما يفل","r":"474143","v":[["D59ED113-BC5E-5974-9857-E73A38F7AD5F","قَدكَ مِنّي صارِمٌ ما يُفَلُّ","وَاِبنُ حَزمٍ عَقدُكَ لا يُحَلُّ"],["A2956257-A451-5162-8583-A12519F0BCCB","يَنثَني بِاللَومِ مِن عاذِليهِ","ما يُبالي أَكثَروا أَم أَقَلّوا"],["EAAF8B66-9C89-506E-A125-B211014B75AF","لِرَسولِ اللَهِ في أَقرَبيهِ","وَبَنيهِ حَيثُ ساروا وَحَلّوا"],["B661F4A1-96F3-51FF-B7DC-F78B547E52BE","عِندَهُ مَكنونُ نُصحٍ وَوَدَّ","خالِصٍ لَم يَقتَدِح فيهِ غِلُّ"],["22B4734F-8EBC-5709-A78A-0DF022E07855","أَهلُ بَيتٍ ما عَلى جاحِديهِم","حَقَّهُم في الزُرِ أَلّا يُضِلّوا"],["B50D6967-9B78-527E-A51D-DB0229954FB2","صَفوَةُ اللَهِ الأُلى مِن لَدُنهُ","لَهُمُ القَدرُ الأَعَزُّ الأَجَلُّ"],["E37A53D5-5B9B-554F-B3E1-8A4F9896C8FC","ما أَطاعَ اللَهَ قَومٌ تَوَلّوا","مَن سِواهُم بَل عَصَوهُ وَضَلّوا"],["4DE84BF6-FF73-58E2-B0AB-B2221E2284F8","وَبِهِم شُقَّ دُجى الغَيِّ عَنهُم","وَعَلى الإيمانِ وَالدينِ دُلّوا"],["3BC95389-D289-5B7C-872E-A5AD1626DFE3","وِبِهِم صُبَّت عَلى كُلِّ باغٍ","باذِخِ العِزِّ صَغارٌ وَذُلُّ"],["B14AD3AE-3B1C-52EA-9454-F5A268076983","غَصَبوهُم حَقَّهُم وَاِستَحَلّوا","ظالِموهُم مِنهُ ما لا يَحِلُّ"],["CB49ACD6-321E-5D02-BE0C-F5474F728CBA","وَاِقتَدَوا فيهِم بِما سَنَّ رِجسٌ","بارَزَ اللَهَ زَنيمٌ عُتُلُّ"],["30EE7DE8-02C1-5FF5-A7DD-68CC916AE8FF","لَم يُراقِب خَشيَةَ اللَهِ فيهِم","آصِرٌ مِنهُ وَلَم يُرعَ إِلُّ"],["FF247DC5-B37D-53FE-A072-48DDDA4164A4","فَهُمُ شَتّى قَتيلٍ صَريعٍ","دَمُهُ فيهِم حِذاراً يُطَلُّ"],["DD6436D4-761D-5ADA-90CD-FFFDB48845B5","وَأَسيرٌ في طِمارٍ عَلَيهِ","مِن حَديدِ القَينِ كَبلٌ وَغُلُّ"],["CA2ED517-DD40-5A0C-AC61-B77FA4D181C8","وَمُقيمٌ خاشِعٌ في عَدُوٍّ","مُستَضامٌ بَينَهُم مُستَذَلُّ"],["E5E8664D-4027-551A-B6C2-663CAECE93EA","لا عَلى جُرمٍ وَلا عَن شِقاقٍ","رَكِبوا الدَحضَ إِلَيهِم فَزَلّوا"],["007F809C-D062-53F2-9C1C-A2A266C50E5C","غَيرَ أَن فاءَ عَلى ظالِميهِم","بِهِمُ المُلكِ فَيءٌ وَظِلُّ"],["4B8E1167-BA8D-5C6D-96B7-6A08D69F3B74","وَأَن أَوفوا بِالنَبِيِّ المُصَفّى","جِدِّهِم مَأَثُرَةً لا تَقِلُّ"],["BA710D13-5A77-58E1-991F-435A3D9AFA10","وَبِنى اللَهُ لَهُم بَيتَ مَجدٍ","فِطرَةُ الدينِ بِهِ تَستَظِلُّ"],["AEB107AF-5782-5899-BD65-083A54731204","في جميلٍ بارَكَ اللَهُ فيهِ","لَم يَنَل ما خُوَّلوهُ جِبِلُّ"],["84CA72BE-4668-52F0-860D-CE00C68B18F2","وَاِرثوا مَخزونِ عِلمٍ عَلَيهِ","كُلُّ ذي عِلمٍ عِيالٌ وَكَلُّ"],["F45A5EBA-9327-505C-9A39-A6C37CEAAE07","وَعَلَيَّ ذو المَعالي أَبوهُم","كَرُمَ السامي بِهِ وَالمُدِلُّ"],["4622CC40-895F-5457-A2F6-CD64C3A885C6","عُلِّمَ الدينَ الَّذي مَن تَلاهُ","سالِكٌ سُبلَ الهُدى لا يَضِلُّ"],["914BB251-A028-5D08-87F6-724859E7DBBB","وَأَميرُ المُؤمِنينَ المُرَجّي","فَضلَهُ مُثريهِمُ وَالمُقِلُّ"],["EAFE5B8B-ABB2-5713-A26C-FA3F975334E6","باسِطٌ كَفَّيهِ فيهِم بِعَدلٍ","وَصَبيرَ صَوبُهُ مُستَهَلُّ"],["7A3E3C48-5CA5-5111-9C6B-FCCCBCA05803","عَن سَماءٍ لَهُم كُلَّ يَومٍ","ديمَةٌ مِنهُ وَوَبلٌ وَطَلُّ"],["96B4B1BC-05F5-52DF-9B11-F9EFFE9BD4F0","وَشِهابُ اللَهِ في كُلِّ خَطبِ","وَحُسامُ اللَهِ وَالنَقعُ يَعلو"],["DC6E4942-909C-549F-9B3D-1ACDE09C4B09","حَيثُ يَلقى في ظِلالِ المَنايا","كُلَّ لَيثٍ باسِلٍ وَهوَ فَلُّ"],["65DFB872-9C9D-52F1-9E16-A794EC35E7FF","جَسَدٌ يَعفوهُ طَيرٌ عَكوفٌ","وَضَوارٍ شُرَّعٌ فيهِ زُلُّ"],["128D38A7-E8FB-5F5E-9D9C-0CAA91242C33","مَكنَزٌ فيهِ مِن بَعدِ حَولٍ","لِلضِباعِ العُرجِ لَحمٌ مُصِلُّ"],["58CB9E21-562A-5025-B032-B706615AF1AD","بَطَلٌ أَغلَبُ في راحَتَيهِ","لِلقَنا وَالبيضِ نَهلٌ وَعَلُّ"],["231D5AAC-A7B4-58F0-9245-C8036BE30076","يَكرَهُ الأَبطالُ مِنهُ اِبنَ مَوتٍ","لا يَمَلُّ الحَربَ حَتّى يَمَلّوا"],["F71AB3A1-6732-517A-88E6-ED436812374E","يَحمَدُ العَضبُ اليَماني شَظاهُ","في الوَغى وَالسَمهَرِيُّ المِتَلُّ"],["043A37D9-4FAB-502A-A5E7-1FD16AB3F392","فَكَأَنَّ النَقعَ يَنشامُ عَنهُ","ضَيغَمٌ جَهمُ المُحَيّا رِفَلُّ"],["32ADEFD3-3DE1-51EF-B691-98FA0E76F83C","قَد غَدا يُضمِرُ بُغضاً وَيُبدي","بِغضَةً أَضغانُها لا تُسَلُّ"],["4C81A2B3-B0B1-5FE2-A82A-FF0B934D189B","شاوَرَ النَكراءَ في اللَهِ مِنهُ","شائِكُ الأَنيابِ يَقظانُ صِلُّ"],["2453384F-6C50-50E3-81DB-ED19FCAB69D8","لا الرُقى تَردَعُ مِنهُ وَلا مَن","مَسَّ حَدَّ النابِ مِنهُ يُبَلُّ"],["7463AA76-7B27-5D46-8A45-AA7F0522935F","مَوطِنٌ مِن عَهدِ لُقمانَ عادٍ","دونَهُ مِن قُلَلِ الحَزنِ تَلُّ"],["50BF2C1C-E616-50D1-8315-5352DDC25AEA","مُتَحامٍ لا يُؤَدّي إِلَيهِ","نُبُسَ الإِنسِ وَالا الجِنِّ حَلُّ"],["6B491D9B-3052-5B29-A2E5-49915F67F680","كَيبيسِ الجَزلِ إِلّا فَحيحاً","يُصهَرُ المَرءُ بِهِ أَو يُمَلُّ"],["3FEEB1B2-A5BA-5524-AF13-727F919167A5","لَو مَضَت عالِيَةُ الرُمحِ فيهِ","ما تَغَشّى اللَيطَ مِنهُ يُمَلُّ"],["0348DE60-E532-5D85-A214-8C3E62DA3852","أَو نَمَت أَذرُعُ أَلفٍ إِلَيهِ","رَجَعَت عَن نَفثِهِ وَهيَ شُلُّ"],["5F304567-5135-58C2-97A8-435E284C4305","كُلَّما مَدَّ المَطا وَتَمَطّى","فَحَصى المَعزاءِ مِنهُ يُصِلُّ"],["40EAF713-D792-5553-8BD8-B02BF331993E","عُد إِلى مَدحِ الَّذينَ عَلَيهِم","مِن يَمينِ اللَهِ ظِلٌّ فَظِلُّ"],["53198866-06D3-562D-8AC9-7EA75FAF6014","خَيرِ مَن خَبَّت بِهِم ذاتُ لَوثٍ","دامِياً لِلجَهدِ مِنها الأَظَلُّ"],["558F6FE5-7B0E-54F9-8C15-E725FCD0F8F6","في مَهارى ذُبَّلٍ كَالسَعالى","تَحتَ شُعثٍ قَد أَكَلوا وَكَلّوا"],["42BC0DF5-4003-5169-A53D-41927EFE0CFC","عامِدي الكَعبَةَ مِن كُلِّ فَجٍّ","كُلَّما أَعرَضَ شَخصٌ أَهَلّو"]]},"AA54743E-2D6E-50EE-8206-E0F622A7FF62":{"t":"لَنا صاحِبٌ مولَعٌ بِالخِلافِ","p":87,"s":"لنا صاحب مولع بالخلاف","r":"474094","v":[["E54E739E-9019-5427-9071-42FABE7DBC5D","لَنا صاحِبٌ مولَعٌ بِالخِلافِ","كَثيرُ الخَطاءِ قَليلُ الصَوابِ"],["8A176632-D052-5322-B6BF-B597814A3BD4","أَشَدُّ لَجاجاً مِنَ الخُنفُساءِ","وَأَزهى إِذا ما مَشى مِن غُرابِ"],["EEE9D9B8-B5CA-560C-A3E5-88783A0DC22F","إِذا ذَكَروا عِندَهُ عالِماً","رَبا حَسَداً أَو رَماهُ بِعابِ"],["E320D07A-04AD-5DEE-846F-ED5412C7B9DB","وَلَيسَ مِنَ العِلمِ في كَفِّهِ","ِذا ذُكِرَ العِلمُ غَيرُ التُرابِ"],["D82C3E4C-7B4A-53C3-87DA-75E41CF0704E","أَضاليلُ جَمَّعُها شَوكَرٌ","وَأُخرى مُوَلَّدَةً لِاِبنِ دابِ"]]},"34932757-946E-5313-8C57-1C02B42D6088":{"t":"لَهُ حَنجَرٌ رَحبٌ وَقَولٌ مُنَقَّحٌ","p":87,"s":"له حنجر رحب وقول منقح","r":"474130","v":[["1CA3EFF6-7770-5D29-86A8-A62049D5B850","لَهُ حَنجَرٌ رَحبٌ وَقَولٌ مُنَقَّحٌ","وَفَصلُ خِطابٍ لَيسَ فيهِ تَشادُقُ"],["143F7C01-0508-5260-A193-5041BDA12885","إِذا كانَ صَوتُ المَرءِ خَلفَ لَهاتِهِ","وَأَنحى بِأَشداقٍ لَهُنَّ شَقاشِقُ"],["9F1D7EA6-F6ED-58AF-B4D2-4ED42983DCB3","وَقَبقَبَ يَحكي مَقرَماً في هِبابِهِ","فَلَيسَ بِمَسبوقٍ وَلا هُوَ سابِقُ"]]},"728B88B1-7714-5D56-99FB-0326256D9D90":{"t":"لَهُ عُنُقٌ مُخضَرَّةٌ مَدَّ ظَهرِهِ","p":87,"s":"له عنق مخضرة مد ظهره","r":"474128","v":[["47740EAD-8684-5C4C-B5E6-7E071E8EC441","لَهُ عُنُقٌ مُخضَرَّةٌ مَدَّ ظَهرِهِ","وَشومٌ كَتَحبيرِ اليَماني المُرَقَّمِ"],["CF7CD80B-6D1B-544C-868A-1857C0B42046","إِلى هامَةٍ مِثلِ الرَحى مُستَديرَةٍ","بِها نُقَطٌ سودٌ وَعَينانِ كَالدَمِ"]]},"8F4A558C-6273-56E2-9D67-9D67F2867164":{"t":"نَأَت دارُ سَلمى فَشَطَّ المَزارُ","p":87,"s":"نأت دار سلمى فشط المزار","r":"474122","v":[["85449C85-1367-52F3-9025-7E18A3FAAE9F","نَأَت دارُ سَلمى فَشَطَّ المَزارُ","فَعَينايَ ما تَطعَمانِ الكَرى"],["4F576074-9260-5ED3-AB6D-529528C67294","وَمَرَّ بِفُرقَتِها بارِحٌ","فَصَدَّقَ ذاكَ غُرابُ النَوى"],["8932E774-7495-5538-9106-17799DABF521","فَأَضحَت بِبَغدانَ في مَنزِلٍ","لَهُ شُرُفاتٌ دُوَينَ السَما"],["500E051C-97D9-5B50-ADC2-A16F5D3A07D6","وَجَيشٌ وَرابِطَةٌ عِندَهُ","غِلاظُ الرِقابِ كَأُسدِ الشَرى"],["D16C637B-0B85-5336-A581-AFA1F4BAC67E","بِأَيديهِمُ مُحدَثاتُ الصِقالِ","سُرَيجِيَّةٌ يَختَلِبنَ الطُلى"],["03990188-AC63-53C1-9E94-B8064F29E339","وَمِن دونِها بَلَدٌ نازِحٌ","يُجيبُ بِهِ البومُ رَجعَ الصَدا"],["C37E5F1A-C2E5-5701-826D-E36BDC17B557","وَمِن مَنهَلٍ آجِنٍ ماؤُهُ","سُدىً لا يُعاذُ بِهِ قَد طَمى"],["0394809D-BC24-50F3-8548-D3779BCFF041","يَبيتُ الذِئابُ تَعاوى بِهِ","وَيُصبِحنَ في مَهَواتِ المَلا"],["AED1E8D4-1FF4-52D9-B4D0-19BBEA8ABB36","وَكَم دونَ بَيتِكَ مِن مَهمَهٍ","وَمِن أَسَدٍ جاحِرٍ في مَكى"],["1F893931-4AA9-578E-8C28-8B26C6918734","وَمِن حَنَشٍ لا يُجيبُ الرُقا","ةَ أَسمَرَ ذي حُمَةٍ كَالرَشا"],["DD57051A-671F-56F9-8E4C-EE4D36DD0FF4","أَصَمَّ صَموتٍ طَويلِ السُبا","تِ مُنهَرِتِ الشِدِقِ عاري القَرا"],["39548352-0464-521A-AB56-8FFE7B5599D2","لَهُ في اليَبيسِ نُفاثٌ يَطيرُ","عَلى جانِبَيهِ كَجَمرِ الغَضا"],["89CE448C-AE48-5043-8CD7-AB3977A0E98F","وَعَينانِ حُمرٌ مَآقيهِا","نَبِصّانِ في هامَةٍ كَالرَحا"],["B77850F8-EA0F-5967-98B2-9D7854E9B48B","إِذا ما تَثاءَبَ أَبدى لَهُ","مُذَرَّبَةً عُصُلاً كَالمُدى"],["3524D741-1511-5D3C-B197-E563E4BDF3FB","كَأَنَّ حَفيفَ الرَحى جَرسُهُ","إِذا اِصطَكَّ أَثناؤُهُ وَاِنطَوى"],["37C24E02-C519-5AA1-BB29-26B39D070982","وَلَو عَضَّ حَفَي صَفاةٍ إِذاً","لَأَنشَبَ أَنيابَهُ في الصَفا"],["1514B72E-9F84-57A2-96CC-85A7F5E99678","كَأَنَّ مَزاحِفَهُ أَنسُعٌ","خُرِزنَ فُرادى وَمِنها ثُنا"],["D500AB6E-6E3D-51C0-86BA-20093ABA6D3F","وَقَد شاقَني نَوحُ قُمرِيَّةٍ","طَروبِ العَشِيِّ هَتوفِ الضُحى"],["F7B30EE3-46C5-5F56-A041-5069882484CF","مِنَ الوُرقِ نَوّاحَةٍ باكَرَت","عَسيبَ أَشاءٍ بِذاتِ الغَصا"],["009B7829-4A61-5315-A9F7-DE363CE5C148","فَغَنَّت عَلَيهِ بِلَحنٍ لَها","يُهيِّجُ لِلصَبِّ ما قَد مَضى"],["B8E3D6AB-0D70-50AE-A6BA-13BA85AC7D94","مُطَوَّقَةٌ كَسِيَت زينَةً","بِدَعوَةِ نوحٍ لَها إِذ دَعا"],["0ADEAF60-493E-53BF-9320-47E202930875","فَلَم أَرَ باكِيَةً مِثلَها","تُبكي وَدَمعَتُها لا تُرى"],["B26C937A-B205-5213-80CB-B94910B3CB8C","أَضَلَّت فُرَيخاً فَطافَت لَهُ","وَقَد عَلِقَتهُ حِبالُ الرَدى"],["A02852DD-26A1-5087-BD58-531D9906BBE5","فَلَما بَدا اليَأسُ مِنهُ بَكَت","عَلَيهِ وَماذا يَرُدُّ البُكا"],["F6BEF6CE-98F5-5A0C-8389-06CA68668B98","وَقَد صادَهُ ضَرِمٌ مُلحَمٌ","خَفوقُ الجَناحِ حَثيثُ النَجا"],["9FAE11E6-686B-5B21-BBBD-4EA9D6F92655","حَديدُ المَخالِبِ عاري الوَظي","فِ ضارٍ مِنَ الزُرقِ فيهِ قَنا"],["8E8163CF-3CE1-5F22-8724-74EBCC77590D","تَرى الوَحشَ وَالطَيرَ مِن خَوفِهِ","جَواحِرَ مِنهُ إِذا ما اِغتَدى"],["6E97F31C-232A-5F45-9833-C1FE245B1051","فَباتَ عَذوباً عَلى مَرقَبٍ","بِشاهِقَةٍ صَعبَةِ المُرتَقى"],["C7560B54-12F0-5965-8B8B-3EC3C996577E","فَلَمّا أَضاءَ لَهُ صُبحَهُ","وَنَكَّبَ عَن مَنكِبَيهِ النَدى"],["15293BDE-7FDC-5A8E-887D-843487996608","وَحَتَّ بِمِخَلَبِهِ قارِناً","عَلى خَطمِهِ مِن دِماءِ القَطا"],["28087AC3-EC5B-5CFA-92EA-84270F8CBCD3","فَصَعَدَ في الجَوِّ ثُمَّ اِستَدارَ","فَطارَ حَشيشاً إِذا ما اِنصَمى"],["421D3EC7-2142-557C-9ACB-A194FE852F16","فَأَبصَرَ سِربَ قَطاً قارِبٍ","جَبى مَنهَلٍ لَم تَمِحه الدِلا"],["BE71104D-567B-53AB-997A-052221FED043","غَدَونَ بِأَسقِيَةٍ يَرتَوينَ","لِزُغبٍ مُطَرَّحَةٍ بِالفَلا"],["CF4F3317-7AC6-5E11-8E5E-F9D086BF2F86","يُبادِرنَ وِرداً فَلَم يَرعَوينَ","عَلى ما تَخَلَّفَ أَو ما وَنى"],["2D25478F-88D0-5F85-8FDB-E1FFBF29E150","تَذَكَّرنَ ذا عَرمَضٍ طامِياً","يَجولُ عَلى حافَتَيهِ الغُثا"],["70AF954F-EBD7-5A62-ABFD-8A8F10DEA01F","بِهِ رُفقَةٌ مِن قَطا وارِدٍ","وَأُخرى صَوادِرُ عَنهُ رِوا"],["2B54C8E2-93DA-5AA7-85B0-A9F97F079844","فَمَلَّأنَ أَسقِيَةً لَم تُشَدَّ","بِخَرزٍ وَقَد شُدَّ مِنها العُرى"],["D8548188-5292-574D-A6D4-81C7FD0EA8B2","فَأَقعَصَ مِنهُنَّ كُدرِيَّةً","وَمَزَّقَ حَيزومَها وَالحَشا"],["5A7E83AC-78D0-5057-A059-516563A8ACC2","فَطارَ وَغادَرَ أَشلاءَها","تَطيرُ الجَنوبُ بِها وَالصَبا"],["10B4AB68-1901-5DFA-B185-8E0E7CC5333F","يَخَلنَ حَفيفَ جَناحَيهِ إِذ","تَدَلّى مِنَ الجَوِّ بِرقاً بَدا"],["B4C3CFE3-21DD-5A5D-AB11-9FFD2DFED6CA","فَوَلَّينَ مُجتَهِداتِ النَجا","جَوافِلَ في طامِساتِ الصُوى"],["C54FD102-BA11-54AD-87AF-147AA944A493","فَاِبنَ عِطاشاً فَسَقَّينَهُنَّ","مُجاجاتِهِنَّ كَماءِ السَلا"],["FA811821-C8C3-53C6-BD80-8118FA23FEB9","فَبِتنَ يُراطِنَّ رُقشَ الظُهو","رِ حُمرَ الحَواصِلِ صُفرَ اللُهى"],["1D11D570-A0CA-578F-8C30-228A3C2FD7F7","فَذاكَ وَقَد إِغتَدي في الصَباحِ","بِأَجرَدَ كَالسَيِّدِ عَبلِ الشَوى"],["B21DD896-94E5-52C1-A14A-D0FE1F011E1B","طَويلِ الذِراعَينِ ضامي الكُعو","بِ نابي الحَماتَينِ عاري النَسا"],["2970CA61-9889-5C79-A06C-764F80CC5872","لَهُ كَفَلٌ أَيِّدٌ مُشرِفٌ","وَأَعمِدَةٌ لا تَشَكّى الوَجى"],["8A73BF47-8A74-5C18-B1AE-2DF3BEDA3F08","وَأُذنٌ مُوَلَّلَةٌ حَشرَةٌ","وَشِدقٌ رُحابٌ وَجَوفٌ هَوا"],["12DCD480-349D-5518-B4EA-97CCCDAD5DCE","وَلَحيانِ مُدّا إِلى مَنخَرٍ","رَحيبٍ وَفَرجٌ طُوالُ الخُطى"],["C49F70E0-D812-5E76-B392-52B72225C948","لَهُ تِسعَةٌ طُلنَ مِن بَعدِ أَن","قَصُرنَ لَهُ بِسعَةٌ في الشَوى"],["89D18683-5E41-5F2C-B5C2-3D697C3C7757","وَسَبعٌ عَرينَ وَسَبعٌ كُسينَ","وَخَمسٌ ظِماءٌ وَخَمسٌ رِوا"],["2B569161-13EE-5266-82CE-8DF978727FA4","وَتِسعٌ غِلاظٌ وَسَبعٌ رِقاقٌ","وَصَهوَةُ عَيرٍ وَمَتنٌ خَظا"],["A41212BA-FCC0-55C6-8B7C-A85E1508E89F","وَسَبعٌ قَرُبنَ وَسَبعٌ بَعُد","نَ مِنهُ فَما فيهِ عَيبٌ يُرى"],["1A783898-190B-59EB-83EE-3CFF93B6EF10","عَريضُ الثَماني حَديدُ الثَماني","شَديدُ الصِفاقِ شَديدُ المَطا"],["256F633C-5C0A-5A1E-9E9B-B11BBAA2D0A9","وَفيهِ مِنَ الطَيرِ خَمسٌ فَمَن","رَأى فَرَساً مِثلَهُ يُقتَنى"],["CB7AD967-39C7-5372-803C-9BDA45D70135","غُرابانِ فَوقَ قَطاةٍ لَهُ","وَنَسرٌ وَيَعسوبُهُ قَد بَدا"],["54F1C4FF-1F55-5487-B103-591B679F775C","كَأَنَّ بِمَنكِبِهِ إِن جَرى","جَناحاً يُقَلِّبُهُ في الهَوا"],["49450987-8DEB-5AC8-9C04-9478E47BD308","مَصَرنا لَهُ مِن خَيارِ اللِقا","حِ خَمساً مَجاليجَ كَومَ الذُرى"],["177FFF3F-0E93-560A-93AB-4D0C9B4DE231","يُغادي بِعُضٍّ لَهُ دائِباً","وَنَسقيهِ مِن حَلَبٍ ما اِشتَهى"],["CCBD974D-A1CC-534D-B399-6E1F710049BE","وَيُؤثَرُ بِالزادِ دونَ العِيالِ","وَفي كُلِّ سَيرٍ بِهِ يُقتَفى"],["CC5288BB-53FB-5099-A2B7-95DE3C9D0032","فَقاظَ صَنيعاً فَلَمّا شَتا","أَخَذناهُ بِالقُربِ حَتّى اِنطوى"],["7061A3C1-0F31-5D91-9AE6-3A89411444EE","فَهِجنا بِهِ عانَةً في الغُطاطِ","خِماصَ البُطونِ صِحاحَ العُجى"],["F73E6F46-A67F-5ADE-87FE-1D5D6ACB4F3C","يُثِرنَ الغُبارَ بِمَلثومَةٍ","وَيوقِدنَ بِالمَروِ نارَ الحَبا"],["E646DA0E-5784-598F-990D-0E16AC9F70A4","فَوَلَّينَ كَالبَرقِ في نَفرِهِنَّ","جَوافِلَ يَكسِرنَ صُمَّ الصَفا"],["FC012B82-1081-52F6-B942-8D3B5AF92D49","فَصَوَّبَهُ العَبدُ في إِثرِها","فَطَوراً يَغيبُ وَطَوراً يُرى"],["7D4CB7CD-418A-5FA9-A788-A18E53469795","فَجَدَّلَ خَمساً فَمِن مُقعَصٍ","وَشاصٍ كُراعاهُ دامي الكُلى"],["0FAFAC04-05DC-55D6-BC11-19D049A64F23","وَثِنتانِ خُضخِضَ قُصبُهُما","وَثالِثَةٌ شُحِّطَت بِالدِما"],["00176B09-9D8B-5536-BE8D-A2CA3CF10560","فَرُحنا بِصَيدٍ إِلى أَهلِنا","وَقَد جَلَّلَ الأَرضَ ثَوبُ الدُجى"],["BDDAB73A-091B-518C-AA5B-BC62EFDE2446","وَبِتنا نُقَسِّمُ أَعضاءَهُ","لِجارٍ وَيَأكُلُهُ مَن عَفا"],["191B3A05-464F-549D-AF7B-94F27F93BE7E","وَرُحنا بِهِ مِثلَ وَقفِ العَرو","سِ أَهيَفَ لا يَتَشَكّى الوَجى"],["B0647D0E-3BB0-5A9E-8B8F-DA8BB47BBFA7","وَباتَ النِساءُ يَغَدّينَهُ","وَيَأكُلنَ مِن صَيدِهِ المُشتَوى"],["296310E3-40C1-5DBD-9328-11428395FA13","وَقَد قَيَّدوهُ وَغَلّوا لَهُ","تَمايِمَ يُنفَثُ فيها الرُقى"]]},"C1838B6B-D63E-5F7E-99D9-A292FEEF3E92":{"t":"هَلّا أَتَيتَ بِقُمرِيٍّ أُرَبّيهِ","p":87,"s":"هلا أتيت بقمري أربيه","r":"474123","v":[["398CCEBE-98E8-56B3-98EB-51ECD446CAA4","هَلّا أَتَيتَ بِقُمرِيٍّ أُرَبّيهِ","اَو ساقَ حُرٍّ إِذا ما شِئتُ غَناني"],["DA16E773-94E9-5F5E-8649-0ED2CE0ECCF9","فَلَيسَ لِلبِرِّ وَالتَقوى حَجَجتَ وَلا","مِن خَشيَةِ اللَهِ يا يَحيى بنَ وَردانِ"],["564B9083-C6E1-535E-9FFB-13C695743339","كُنتُ الخَبيثَ إِذا شَدّوا مَحامِلَهُم","أَيّامَ مَكَّةَ أَنتَ الفاسِقُ الزاني"]]},"0A355251-5182-5ECC-A5E2-8F30D1305080":{"t":"يا رَبَّنا رَبَّ الشَمالِ وَالصَبا","p":87,"s":"يا ربنا رب الشمال والصبا","r":"474105","v":[["F3321B24-B6F0-5E7F-9459-D3908DB2BEBB","يا رَبَّنا رَبَّ الشَمالِ وَالصَبا","وَمَن سَعى بِالبَيتِ أَو تَحَصَّبا"],["39F0805C-7632-5A43-9F35-3F7DE5DADDA4","اِبعَث لَهُ تَحتَ الظَلامِ عَقرَبا","مُصفَرَّةً تَنمي إِلَيهِ خَبَبا"],["FDF6ACBE-3CA2-5A61-88B0-5EF6190F3DFF","تَسُلُّ مَحجوباً نَحيفاً نَيرَباً","أَكلَفَ لَو مَسَستَهُ لِأَندَبا"],["F43817B3-28C4-5872-85B5-7EAC5DB65058","كَأَنَّما تَمَسُّ مِنهُ حَرِبا","حَتّى إِذا خالَطتَهُ فَضَرَبا"],["5322097A-E9BE-5191-A455-A33608D06B35","أَتاكَ مِنهُ سائِلاً مُحَبَّباً","فَإِن نَجا فَاِبعَث إِلَيهِ القُرطُبا"],["272FB1A2-A1D3-5FE4-B9C3-A06B3D0EC3F8","يَمُرُّ يَفري سَبسَباً فَسَبسَبا","مُصَعِّداً دِماغَهُ مَصَوَّبا"],["B4B16CB0-C1BD-59B8-80BC-8CC18649B432","وَآكِلاً مِن لَحمِهِ وَشارِبا","جَزاءَ خَطّابٍ بِما تَحَوَّبا"]]},"CBEEDFCD-04D6-52BB-867C-8DE9F51DE078":{"t":"يَرَونَ المَوتَ دوني إِن رَأَوني","p":87,"s":"يرون الموت دوني إن رأوني","r":"474106","v":[["5BDEC504-99FD-52C4-A3B8-AB7330956F6C","يَرَونَ المَوتَ دوني إِن رَأَوني","وَصِلَّ صَفاً لِنابَيهِ ذُبابُ"],["A015A355-B0A8-567C-8BC1-45A00DBF6523","مِنَ المُتَحَرِّماتِ بِكَهفِ طَودٍ","حَرامٍ ما يُرامُ لَهُ جَنابُ"],["2E5F4BB5-922E-5FAF-BDE7-F55C640D8C28","أَبى الحاوونَ أَن يَطَئو حِماهُ","وَلا تَسري بِعَقوَتِهِ الذِئابُ"],["57C60272-B47F-58FB-83C9-C0D7CEE12058","كَأَنَّ دَماً أُميرَ عَلى قَراهُ","وَقَطراناً أُميرَ بِهِ كُبابُ"],["E14294B0-E9AC-5547-9092-7F86E0F53FE3","إِذا ما اِستَجرَسَ الأَصواتَ أَبدى","لِساناً دونَهُ المَوتُ العُبابُ"],["D4F09727-B52F-5083-BAB5-50FF1144634D","يَظَلُّ نَهارَهُ نَوماً سُباتاً","وَنَزوَتُهُ طُمورٌ وَاِنسِيابُ"],["19E197F5-93D8-5CC8-9F92-F9900F53B916","إِذا ما اللَيلُ أَلبَسَهُ دُجاهُ","سَرى أَصمى تَصيحُ لَهُ الشِعابُ"],["58092436-4DAE-5465-9518-B7A9E3F4598A","كَأَنَّ جَرادَةً تَشَرَت عَلَيهِ","جَناحاً فَاِرتَدى مِنها الحُبابُ"],["E1810274-E7EA-5F2B-92B5-C8D5116B0898","مَتى ما يَرمِ عَن عَينَيهِ شَخصاً","فَلَيسَ إِلى الحَياةِ لَهُ إِيابُ"]]}}}