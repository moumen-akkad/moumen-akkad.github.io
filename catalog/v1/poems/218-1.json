{"v":1,"poems":{"2AC3CDA1-D5ED-5380-A6A5-64D96F347BDF":{"t":"لِمُستَشار الغَرام قدمت اِعراضي","p":218,"s":"لمستشار الغرام قدمت اعراضي","r":"463578","v":[["A64310CD-E0EA-5072-87F3-DADB404FE339","لِمُستَشار الغَرام قدمت اِعراضي","بِاني لحكم المَحاسِن متبع راضي"],["7BD5A366-047A-590D-99B3-1AFFBE03D1E4","جَمالك اِللي محا رَسمي وَاِعراضي","طايِع أَوامِر لِحاظون ان عدل أَوجار"]]},"59485567-4BC9-5D3F-B29D-818323562D74":{"t":"م الهَدب وَلا الغَرام","p":218,"s":"م الهدب ولا الغرام","r":"463477","v":[["0ABE4B4F-5273-5452-AFB9-C4C8ABCFDF03","م الهَدب وَلا الغَرام","يا أَهيَف جراحي"],["A01F7E11-C597-5374-8E8F-9165C9637968","قال لي اِلقى أَقول لَك وَنام","وَاللَه صاحي"]]},"2E0A16FB-9508-59B3-B548-9C9C715259E9":{"t":"ما بال هذا الدَهر غَير عَهدِكُم","p":218,"s":"ما بال هذا الدهر غير عهدكم","r":"463517","v":[["E46BBD29-2716-53F5-A333-170EE9D55859","ما بال هذا الدَهر غَير عَهدِكُم","وَأَبان مِن بَعدِ التَواصُلِ صدكم"],["4673123E-6D81-5CFD-BECF-56314DA10E4A","فارَقتُموني بَعد التَجمع عَبدكم","وَالجَمع شَأن الدَهر وَالتَعويق"]]},"C2083D1A-1B13-5E01-AC76-859662EC14F6":{"t":"ما حيلَتي الا مُسامَرَة الدُجى","p":218,"s":"ما حيلتي الا مسامرة الدجى","r":"463469","v":[["0DCA31FB-58EF-5E33-94DA-4B743F4962EC","ما حيلَتي الا مُسامَرَة الدُجى","لِما اِستَحال الظَن وَاِنقَطَع الرَجا"],["BA470888-E0B0-5562-B2DA-167BEE5B71E4","لكِن لي بِجَمالِكُم حُسن التجا","وَمن التجى لكمو فَلَيسَ يَضيق"]]},"0829333F-7CE9-5ADE-ABE0-E8D11C998FEA":{"t":"ما زِلت أَهتِف بِالجَوى لما خَطر","p":218,"s":"ما زلت أهتف بالجوى لما خطر","r":"463537","v":[["EA9C767D-770C-5746-9DF5-D7BD8E334BA2","ما زِلت أَهتِف بِالجَوى لما خَطر","وَأَمرّغ الخدين في ذاكَ الاتر"],["A3765261-288C-51B9-9656-994CBA5FD051","وَأَقول مَصحوب السَلامَة يا قَمَر","داعيك اِن طالَ الصدود عَديم"]]},"5474FFB8-7176-5085-BA3C-C95A77B4C250":{"t":"ما كُنت أَدري ما الغَرامُ وَما بِهِ","p":218,"s":"ما كنت أدري ما الغرام وما به","r":"463401","v":[["23E41640-F8C6-5EF2-9725-53933ABB7F56","ما كُنت أَدري ما الغَرامُ وَما بِهِ","حَتّى رَماني الوَجد في أَعتابِه"],["8794044D-F8D4-5981-9B4C-291C8958C4ED","وَغَدَوتُ بوابا بسدة بابه","من بَعد قولي اِنَّني لَسَليم"]]},"5AC5C9A9-E5C2-5F25-AE05-4AE94289CFA9":{"t":"ما كُنتُ أَعهد ما بِالعَبدِ مِن أَسَف","p":218,"s":"ما كنت أعهد ما بالعبد من أسف","r":"463589","v":[["437F686D-45D9-5366-AE3F-0E8926EDCC81","ما كُنتُ أَعهد ما بِالعَبدِ مِن أَسَف","وَلا أَعي فيهِ حالا كانَ قَبل خَفي"],["3EF56CC7-90B9-5A48-9A31-A5DDCB087BC2","حَتّى تَقَلَّبت في أَحصاب حَرقَتِهِ","وَصِرتُ مِمّا ألاقى عاذِرا سلفى"],["3EEEA7A6-9452-521C-8B28-8A41D5D672F7","لا غرو اِن الصِبا يَأتي بِنَفحَتِكُم","وَكُلَّما مراغدو بِالغَرامِ هفى"],["E6388717-D816-5ACF-8F11-9938969A2AA1","وَلَم أَنَل مِن نَسيم الصُبحِ لي أَربا","يَشفى فُؤادي مِن التَسهيدِ وَالشَغف"],["1FE619C9-8797-5D59-8A48-F9425C319C97","لِما يَئِست وَلَم يَسمَح لململتي","قاضي الهَوى بِنَشيق من هَواك شَفى"],["F18E658A-20B2-56EE-A9C1-98CF2AF0512A","خاصَمت كل نَسيم فيكَ مبتَكرا","وَعفته بِخَيال مائِس الهيف"],["FF63CAB8-0F76-501B-9601-E46681B6CD4A","خلوت لِلخل خلواتي وَخلت بِها","خلو صدري من اللوعات وَاللَهف"],["05B1EE55-5CCA-5D51-97C0-438FA318992C","نَفيت طيب الكَرى لِلقَدِّ مُنتَظِرا","وَكَم شَكَوت بِقَلب خافِق رَجف"],["2E63A9A9-F569-58D0-B5E4-CF5A5CAA534E","فَيا لَهُ مِن خَيال غَرَّني وَنَأى","وَقَد رَماني بِسَهم السَهد وَالكَلف"],["04D0824A-9883-5CB0-BEED-5243212D329A","مَياس قَدك عِندي غَدوَة وَمسا","فَلا تَضن بِمرآه عَلى الدَنف"],["E1B1D237-6058-539D-BF37-EE1748DBE0CE","حر التَهاني وَوجدى وَاِحتِراق دمى","يَفيح وادي الغَضا عَمَّن سِواكَ خفى"],["3BFED320-E115-57A0-BFFC-5ABD296EB4A5","لما بَصرت بِما لا يَبصرون بِهِ","يا سامِرى فَلا تَعجَل عَلى تلفى"],["6291E3EA-2A70-5E50-9D22-D5B44880FB04","وَراجِع النَفسَ اِنّي قَد ضَلَلتُ بِها","عَمّا عَداكَ فَلَم أُبرِح وَلَم أَقف"],["CDC86694-8BA4-575E-9BB0-4B1758F9BE78","فَقالَ لي بِاِبتِسام من مُباسَمه","يا مُؤمِن القَلبَ لا تَحذَر وَلا تَخَف"],["C2F6285B-A0CC-50D5-B359-E34BEC7F3330","ما كُنتَ اِلّا خَيالا مَعفوى لقا","لا يَستَفيدُ الشَجى مِنّي سِوى الكَلف"]]},"11621DC5-79B0-54FD-9C68-9468DC8BFB7E":{"t":"ما لي بِلَوعَةٍ ذا الغَزال أَهيم","p":218,"s":"ما لي بلوعة ذا الغزال أهيم","r":"463624","v":[["9DFD7A95-2D0E-5648-B96E-316A40DDF349","ما لي بِلَوعَةٍ ذا الغَزال أَهيم","وَالجِسم مِنّي ناحِل وَسَقيم"],["29F0830C-67F6-59FE-8B74-BEB01DCDAF41","اِنَّ العَذابَ بِمُهجَتي لَأَليم","وَاللَه بِالقَلبِ الخَفوقِ عَليم"]]},"86F5609D-5BD9-56A7-9E79-F7AF3EF4DEF0":{"t":"ما لي لِما صَدني","p":218,"s":"ما لي لما صدني","r":"463515","v":[["9D09DE5C-9974-54EF-BFBC-26171CB215F3","ما لي لِما صَدني","تَرَكتُ في التيه سدى"],["F15C4FA2-9DA1-56DC-8F35-CEF036265E44","لا السامِري أَضَلَّني","وَلَم أُجاوِز مَوعِدا"],["336654D3-2385-56C8-95D1-2CF97B524E07","حَتّى أَقولَ أَسَفا","يا قَلبُ جَرَعت الرَدى"],["0C40B607-9799-5EA6-B2C1-C38DA9D19F15","ما ذاكَ اِلّا قَلبَهُ","طور بِهِ لبي النَدا"],["4BB2B62F-744D-5A8B-A55B-7E6E2E3FF65D","هبنى اِقتَرَفت زلة","فاقَت عَنِ الطورِ اِعتِدا"],["74249E54-C214-5618-94EE-7A2B74E55ECC","فَاِنَّني مِن آدَم","وَهُوَ اِمام لِلهُدى"],["8FFBADBB-0CE7-5C23-9294-CCE8A911B568","وَقَد عَصى مَولاهُ اِذ","مَدَّ اِلى البِرِّ يَدا"],["BDF9FDD1-6AF9-5D79-9269-4D3695D079B8","ثُمَّ اِجتَباهُ مَولاهُ اِذ","تابَ عَلَيهِ وَهُدى"]]},"E48BB124-E565-5F43-833E-D8539242CE47":{"t":"ماذا تَقولُ اِذا اِجتَمَعنا في غَد","p":218,"s":"ماذا تقول اذا اجتمعنا في غد","r":"463670","v":[["3452BACA-EC6A-5FF4-BF26-B4D9EED00625","ماذا تَقولُ اِذا اِجتَمَعنا في غَد","وَأَقولُ لِلرَحمن هذا قاتِلي"]]},"4C2002F5-EE3C-55B6-9518-43E17DE9CF33":{"t":"مال الفُؤاد لِغُصنِ بِاللُمى ثَمل","p":218,"s":"مال الفؤاد لغصن باللمى ثمل","r":"463411","v":[["2D41C5FB-D239-56C3-AAF5-498EDFDBA52E","مال الفُؤاد لِغُصنِ بِاللُمى ثَمل","مِن ميله لَعِبت أَيدى النَسيم بِهِ"],["BCE63B59-CAB5-5297-A19F-647063A6E1E7","أَمال جيد الظَبي مِن لينه شَغفا","وَالمَيل في الظَبي مِن أَقوى مَذاهِبُه"],["8DDE4B69-8DA6-5371-9BFB-80C74EB46EF3","وارَت ذَوائِبُه شَمسا فَغَرته","تَحتَ الشُعور كَليل في غَياهبه"],["2E83CE93-294C-5851-B55F-4963350DB9B8","شَب الجَوى بَينَ أَحشائي لِرؤيَتِه","فَقُمتُ وَاللَحظُ يَصمى في مَضارِبُه"],["0860C916-4A75-5E3B-A095-8BB0D2147CF0","سَأَلتَهُ رَحمَة مِن لَحظَة فَأَبى","وَزادَ قَلبي تَبريحاً بِحاجِبِه"],["F868032B-5441-5384-82E1-C6769E3FEAAD","مِن سِحرِ أَجفانِه هاروت قابَلَني","وَمُد في صَدغِهِ اِحدى عَقارِبِه"],["954CDAF8-9CB5-5145-BF7B-D15B6D2F9F35","وَكَنز مَبسضمِ الزاهى وَلُؤلُؤهِ","مُرصَد بافاع مِن ذَوائِبُه"],["BA9D6796-C94A-53CC-B3D3-A8BF0B9C0352","لِا رَأى حيرَتي فيهِ اِنتَنى عَجَبا","وَقالَ اِنَّ الهَوى يَودي بِصاحِبِهِ"],["217B3AC1-D74D-5F37-A540-E65C997D12C4","فَقُلتُ يا ازئا بِالصَبِّ تَعرف ذا","ما بالَ قَلبُكَ لا يَعنو لِواجِبِه"]]},"590C14A1-0057-5FAF-AEFD-A8841FC61180":{"t":"مالي بِعادل قَوامِكَ تايِه الاِفكار","p":218,"s":"مالي بعادل قوامك تايه الافكار","r":"463566","v":[["CBBF5F74-663B-5D88-8E3A-9386F6A4AAF1","مالي بِعادل قَوامِكَ تايِه الاِفكار","أَمسى وَأَصبَح وَتَسهيد الجُفون لي كار"],["5A2921CE-7FA7-513C-8670-7CC1608B22EC","وحق عَينيك مالي في هَواك اِنكار","دَعني أَبوس الاِنامِل وَاِشتَرى روحي"]]},"467F1B47-8F94-537C-96D0-30736B6A2692":{"t":"مجاب قَد دَعا وَالانس عيد","p":218,"s":"مجاب قد دعا والانس عيد","r":"463493","v":[["33B7094F-69DC-5669-9CA0-93D29362A6C4","مجاب قَد دَعا وَالانس عيد","وَأَروى القَلبَ بِالنيل الجَديد"],["2ADD4B59-3BC2-516D-945A-771EE899C3B3","وَقَد راقَت شُمولُ اليَومَ حَتّى","شَممنا العود في كف الفَريد"],["99A78DE0-73FD-5F49-A734-FEBBA014297D","طَرِبنا بِالزُهورِ وَبِالنَدامى","وَجاوَزنا السَعيدَ بِأَلف عيد"],["99A044F2-89C2-5F74-B8EF-8828BDD9CABA","يُعادُ مَع المَسَرَّة كُل حين","وَداعى الاِنس في عَيشِ رَغيد"],["CE64D6FA-15C3-5787-AFAA-32AB63AC62BE","وَاِن لامَ الخَلاة اِذا طَرِبنا","فَقُل لَهُم غَلَطتم في الشُهود"],["2F96EBC9-7C3D-5E68-A005-C84265CAC25D","وَغادَرَهُم بِغَفلَتِهِم وَحي","لِمَجلِسِنا عَلى رَغم العَتيد"],["328DF200-AA6B-5ED8-8F0A-DE1E5697C10C","اِلى مَ يَلومَني فيها رَقبي","وَأَمسى قائِلا هَم مِن مَزيد"],["A139FEDC-C840-5C4D-AAEC-2BF814695FBC","يُكلِّفُني العَذول بِضد قَصدي","وَمالي عَن هَواها مِن مُحيد"],["9DC3C012-4673-5604-AD60-F67114ABEF5B","وَلَيسَ عَلَيهِ وَزر في وَلَوعى","وَما المَولى بِظَلّامٍ لِلعَبيد"]]},"F0BEC77F-0EF3-5BC4-ACD3-CBBE16479B43":{"t":"ملك الفُؤادِ وَقد هَجَر","p":218,"s":"ملك الفؤاد وقد هجر","r":"463560","v":[["CBAFB3B2-C254-5564-9D4A-8B1F6BF2B35E","ملك الفُؤادِ وَقد هَجَر","بَدر المَحاسِن مُذ ظَهَر"],["56A17CD3-E010-54A3-9BEB-4AEF7153190A","عَذب الرِضاب مهفهف","يَسي المتيم بِالحور"],["2A7B6113-4023-53F7-BC2D-AB702DA716E6","ما حيلَتي في حبه","اِلّا الخُضوع لِما أَمَر"],["668D1894-4B50-5B88-BC98-B80CFA4407A0","مِن مُنجِدي وَجُفونِه","مِنها المُحِب عَلى خَطَر"],["31A0E248-C7B5-520D-981D-42E042C2ABE1","وَاحيرَتي في حُبِّه","وَاطول شَجوى بِالخَفَر"],["73F3F9F2-5125-5380-B054-FA3BEF491BEE","أَشكو الغَرامَ وَيَشتَكي","جِفن تَعَذَّبَ بِالسَهَرِ"],["D78259CC-D61B-52E5-BB05-448A25154F7F","يا قَلبُ حَسبُكَ ما جَرى","أَحرَقتَ جِسمي بِالشرر"],["A0B2C7FC-5E96-5203-B70B-40B8E7BAD4B2","رامَ الحَبيبُ لَك الضَنا","لَم ذا وَأَنتَ لَهُ مقر"],["306E111A-CEE7-5E53-AB0B-2B7C9268262D","لكِن تَعذيب الهَوى","ما لِلشَجِي مِنهُ مَفَر"],["C454B220-8239-58DC-9E03-E37107F19777","قابَلتَهُ مُتثنيا","ناهيكَ مِن غُصن خَطر"],["2D145B54-2290-5560-8E37-9173130C106A","وَرَأَيتَهُ مُتَبَسِّما","كَالبَدر لما أَن سَفَر"],["06AE1F00-7EB3-5041-9999-FE3A1EFDFE30","يا بَدرُ حكمك الهَوى","فَاِحكُم وَنفذ ما أَمَر"],["17363FB8-CC19-5962-87E6-DB9E99B709FA","أَلق الوِشاح وَخلني","أَصلي سَعيرا في سَقر"],["24576110-EC42-5518-803C-3EA6445F5181","وَعن العذار فَلا تَسل","وَلاِنت أَولى من عُذر"],["179DF8BD-487E-528F-BA8C-2A42E9D83F33","وَدَع الظلام عَلى الضيا","وَاِستُر بَطرَتَكَ الغُرر"],["5ACDAF51-461E-5460-BDEB-6D1CBAA99455","سامَت بِها الثَغر الَّذي","يَفتر عَن غالي الدُرَر"],["995A6D05-DFCB-5FC5-9C0A-58A4491558C0","وَاِصدَع بِحُسنِكَ اِفتَخر","تيها بجيدِك وَالطرر"],["84FB5EF4-651E-5AD0-ADA1-11B6A555CEC0","فَالشَمس تَخجَل عِندَما","تَبدو وَيَستَحي القَمَر"]]},"1EC60864-95EC-55AD-86E2-C3592DDDEF31":{"t":"من كَوكَب الاِقبال لاحَ سعود","p":218,"s":"من كوكب الاقبال لاح سعود","r":"463501","v":[["FFE1BF5C-16E4-511A-A696-BCFDBBA19479","من كَوكَب الاِقبال لاحَ سعود","سِحرا وَعَم ضِياؤُهُ المَشهود"],["A2C5C6EB-597A-52E8-B5A7-347129BB31C6","وَتبلجت درر العُلا وَتبرجت","وَتَنظَّمَت من حُسنِهِن عُقود"],["B87186C1-AD74-581C-8949-3F82B4E4AE5F","وَتَلألأت في الاِفق أَقمارُ الهُدى","وَتفتحت في الرَوضِ مِنهُ وُرود"],["36B7533C-4DBB-592E-90D6-0F08650DC87D","نور لَه في الخافِقينَ توهج","وَبروق لِلاِبصار مِنهُ شُهود"],["0DD8AC75-F6D2-5581-A931-BEEC9C94986F","وَالعيد أَقبل وَالمَسَرَّة أَشرَقَت","وَبَدا اِلَيكَ سُرورُهُ المَعهود"],["75A0A0F0-94A5-576C-8A67-B22D0A81B0AF","اللَهُ أَكبَر عيد مجد مُقبِل","شَغفا وَيَوم بِالهَنا مَسعود"],["D26F9411-5526-5267-A193-D2770E00602C","عيد بمينك قَد بَدَت آياتِه","وَالعيدان تك فيه فَهُوَ سَعيد"],["9D4C6FF0-4413-5355-999B-42F6A632AF45","لما غَدت أَيّامُكُم غرر المُنى","وافى لِيشرف بِالبَلقاء العيد"],["AFF38F91-CDE5-5D26-B028-315740A284CA","وَالدَهرُ يَجهَر بِالتَهاني قائِلاً","نِلت السعود وسرك التَأييد"],["1179D7B5-A8A0-587B-99D3-33B429694445","مَنعت ماهب الصبا وَيَكون في","أَضعاف أَمثال لَهُ التَعبيد"],["57BD51E4-69C8-529C-A331-83E42734F800","وَبَدا بِكَ الاِسعادُ وَالاِفضالُ وَال","إِقبال كل في حماك عبيد"],["311C5E19-B4EA-5614-8EA7-3CEA3EB2AADA","يا مَن سَرت في العالَمين صَفاته","أَنتَ المُنى وَالعَون وَالمَقصود"]]},"5A0E6F03-A6A6-5349-8BAC-7D362B6F0323":{"t":"مَرارة الصَبر خَصَت بِالحَلاوات","p":218,"s":"مرارة الصبر خصت بالحلاوات","r":"463445","v":[["0258E098-3A15-586B-B051-726BE596D8EC","مَرارة الصَبر خَصَت بِالحَلاوات","وَجَدت في مرها حُلو السَلامات"],["DBBE2B63-D4C3-5CDF-99D0-07E082908AAF","صِيانَتي في كُهوف الصَبرِ أَمنَع لي","مِن حِصن كسرى وَمِن أَعماق اغمات"],["C1D0D2C3-A519-5205-B017-1C8F7635A992","كَما باتَ دَهري يُريني نَهج ترببتي","فَيَنثَني بِقَبولي وَاِمتِثالاتي"],["A6A96DEF-8DFD-54DC-9CA0-F7500EBD16DB","وَما اِحتِجابي عَن عَيب أَتَيتُ بِهِ","وَاِنَّما الصون من شَأنى وَغاياتي"],["5F88C015-B5E9-5323-B25C-F9D377D4E658","وَكُلَّما شَب دَهري في مُعانَدَتي","لَم يَلقَ مِني لَه اِلّا اِطاعاتي"],["A251F42B-2BA3-5FE2-82FA-C8AA3C949BCF","كَم قابَلَتني لَيال ريحُها سعر","بَطيئَة السَير تَرمي بِالشَرارات"],["67444F7E-0653-5ECF-9D62-08B1704ACDE9","لاقيتُها بِجَميل الصَبرِ مِن جَلدي","وَبت أَسفى الثَرى مِن غَيث عبراتي"],["0489F624-228F-5F97-BCD9-39DEC7D1D121","كَم أَقعَدَتني أَيّامُ بصدمتها","وَقُمت بِالعَزمِ مَشهور العنايات"],["5D9F073A-7859-5494-B278-917ED4B64E0C","وَكَم حَليفَة سعد اِذ تَعنفني","تَقولُ سَعيك مَذموم النِهايات"],["B1B0165B-DA28-5A48-B3AB-51787A978C5B","فَأَخفِض الطرف من حُزن أكابِده","وَاِهمِل الدَمع من تِلكَ المَقالات"],["5B768BB9-2FE5-5A3A-9A04-42E5F3039B16","وَكَم لَصقت بِأَرض الظُلم ناصِيَتي","فَقُمتُ من سجدَتي أَتلو تَحِيّاتي"],["87932AB5-1D57-5031-952C-22BF7FD467E4","وَكَم شَكَرت بِفَضل العَدلِ عاذلتي","اِن أَحسَنتَ أَو اِطالَت في اِسآتي"],["16559B26-6059-54EB-931B-0D9D65D0AEB4","وَما مَنَحت بِيَوم قَد اِتى غلطا","بِالانسِ اِلّا وَقامَت فيهِ غاراتي"],["80A2E964-536C-5336-9BDA-4FBDAB0AE3FE","وَمُذ أَتَت عذلي تَبغي مُصادَرَتي","ظُلماً مَنحتهمو أَسنى الكَرامات"],["30A5133D-D389-5CA3-B477-0DE8FF495882","وَكُلَّما عددوا ذَنبا رَميت بِهِ","بَسَطت لِلعَفو راحات اِعتِرافاتي"],["B3238B40-6FA9-5BD7-A56B-1658FB992E17","وَكُلَّما حَرَّروا مَنشور مظلَمتي","وَاِثبَتوا في الوَرى ظُلما جِناياتي"],["49EA57AD-8EDC-5B87-9931-BF1DD93441B8","اِظهَرت شُكرى لَهُم بِالرَغمِ عَن اِسفى","وَكانَ ما كانَ مِن فَرط التِهاباتي"],["F4DFAC11-9E79-5298-A933-6A5D7DEB8A1E","وَلَم أَفه لِذَوى رد لِمَعرِفَتي","اِنَّ الحَبيب حَبيب في المَسَرّات"],["27DEB128-D702-513F-9BF7-0C2D2FFC24A4","أَقوم وَالضيم تَطويني تَوائِبه","طَيّ السجل وَلَم اِسمَعُه أَناتي"],["A0CC94C1-E2BE-5481-8E5A-847E19EE6FF2","أَخفى الأَسى اِن حَسود جاءَ يَسأَلني","لِأَين تَسعى وَأَومى لاِبنِها جاتي"],["FB7F08A2-F3BF-5ED4-9EB6-634BC2FD14D5","اِن ضَل سَعي فَهادى الصَبر يُرشِدُني","اِلى طَريقِ رَشادي وَاِستِقاماتي"],["425A0859-D54E-55E8-ADEF-7FD88FE03FCA","وَلَم ازَل اِشتَكي بثى وَمَظلَمَتي","لِعالم الجَهر مِني وَالخفيات"],["ACAAC335-B296-5639-BAC4-C9AC6536131B","علت ولاة الصفا اِشهى نَجائِبها","لتقنص الفوز مِن وادي المودات"],["E28A320A-388E-5394-B19C-4129E3BC05E1","وَبت بِاليَأسِ في بَطحاء متربتي","وَكان شغلي لضيمي دق راحاتي"],["4839B1A0-EF29-5125-A9BA-F4F72570ED2D","أَقول لِلصَّبرِ لا عتب عَلى زَمَن","أَعطى لِأَبنائِه أَسمى العطيات"],["A9BF7F99-ACDB-581A-93F7-EF713FDA6672","فَقال مَهلا وَلا تَغررك شَوكَتِهِم","فَالصَحو يَعقُبه سود الغَمامات"],["BCE78E1A-DCFF-5642-BFEB-52D4A004B3E0","فَلَيسَ كُل ملوم دام مُكتَئِباً","وَما السَعيدُ سَعيد لِلمُلاقاة"],["4D422CE9-966C-5F63-8A5E-E71766333B40","فَدَهرِهِم غرهم جَهلا وَما عَلِموا","اِنَّ الزَمانَ قَريب الاِلتِفاتات"],["1E9552D3-386F-5951-9744-7ADFD9BAE117","فَما تَوارَت بغاة الغَم من أَسفى","حَتّى أَناخوا بِاِجبال النكايات"],["232BCB5B-EED7-576F-AF09-C4AD288D4705","تَذكر الدَهر عادات لَه سَلَفَت","وَقَد نَسوها بِحانات الخَلاعات"],["6180DCAF-FDF1-5DC0-8A18-8D389FBDB523","وَرد دَهرى سِهام الحِقد صائِبَة","اليَهمو فَغَدوا في شَرَّ حالات"],["90A77756-78C2-5FC1-98B2-363B27F6C5C4","فَما اِستَطابوا أَمانيهِم وَلا قَنَصوا","حَتّى اِستَوينا بِكَهف الاِعتِكافات"],["04F3BCFE-E9AD-5D11-8162-B65748D692E3","قالَ الدهاة سِهام الدَهر قَد وَقَعَت","مِن ذلِكَ الجمع في كَشح وَلبات"],["96F4FE56-5211-5CC4-B6B1-7C2A7C5A3E78","فَقُلت أَنعم بِهِ مِن حاذِق فَطن","وَاِنه لَحقيق بِالعدالات"],["4ED6B5CD-AAAB-59BA-A40A-95FE105312EC","ظَنّوا الزَمانَ اِباح السَعد طالعهم","وَاِنَّهُ اِختَصَّ تحمى بِالنحوسات"],["353FEE9F-AA5C-5516-B1E6-7CD6163D48BD","وَالصَبر أَشهَدَني ما كنت اِغبطهم","عَلَيهِ عاد اِعتِبارا في العبارات"],["5C7B29CB-D21A-5D9F-8736-2C76E3548B8F","فَلا يَهولنك حرمان بليت بِهِ","وَلا يغرنك اِقبال غَدا آتي"],["52344296-5448-50C1-9C9C-B5ACED2AED3E","كِلاهُما وَالَّذي اِنشاكَ من علق","يَفنى وَبعدم في بَعض اللَميحات"],["F2CE6D23-6DA0-525D-9F70-1BA513C9D78F","اِينَ المُلوكِ الاولى كانَت اِوامِرُهُم","مَحدودَة كَسُيوفِ مُشرفيات"],["69371027-596B-5D3A-8B4B-94AC76904C81","تَمحى وَتثبت ما رامَت وَما رَفَضَت","بَينَ الاِنامِ بِاِقوالِ سميات"],["1F05A1B6-7898-5D6C-B843-0BDACEBF6D90","قَد اِحكُم الدَهر مرماهُم فَما لَبِثوا","حَتّى اِنطَووا في الثَرى طي السجلات"],["F9EDCA1C-5A10-5C7D-A9BD-904386C24737","فَكَم مَضى عَزمُهُم في عِز سَطوَتِهِم","قَولا وَفِعلا بِتَسديد الرِياسات"],["C4B3701A-DC0D-5706-BC43-1981A7319C5C","وَكَم سَرى في الوَرى مَنشور سلطتهم","شَرقا وَغَربا بِاِنواعِ السِياسات"],["30DC7C22-3C3F-5229-B972-34C9B8E33EB6","يَؤوب بِالعَجزِ اِقواهُم اِذا الم","بِهِ أَلَم وَيبدى شَر حَسرات"],["CD1A27C6-C724-5DEC-ACBA-C24078E8659C","يَلوذ ضَعفا بِأَذيالِ الطَبيب وَما","يَغنى الطَبيب لَدى فَتكِ المنيات"],["EBC3E705-AFBD-5FB8-A0AB-A24A95F6040B","وَكَم لِفَقد عَزيز مَنهمو سكبت","مَدامِعَ كُن بِالنعما مَصونات"],["63091BCF-6BC2-5615-A5D6-0A5EA54AE48B","وَطالَما أَحرَقت حَسراتِهِم كَبدا","تَضعضعت مِنهُ أَركان بِالنُعما مَصونات"],["71A8A5A6-0FEF-543E-8098-733AE11DF28D","فَلا تَقُل لي مَتاع وَهو عارِيَة","وَاليَأس عِندي راحات اِستِراحاتي"],["07051866-5F1B-57E6-AF20-D2E95ECB7408","وَقَد بَسَطت أَكف الذل ضارِعَة","لِخالِق الخَلق جبار السموات"],["7D68D7C8-7DC2-5EB8-B722-E652360A4A23","وَبت أَدعو عَليم السر قائِلَة","يا غافِرَ الذَنب جدلى بِاستِجابات"],["0CBD4DF4-41F9-5D3D-9DD8-5C7A307B5774","يا كاشِف الضُر عَن أَيوب مرحمة","حينَ اِستغاثَك من مس المَضَرّات"],["EC4BCD87-C1CC-5731-9888-EFD21A05A756","وَصاحِب الحوت قَد أَنحببته كرما","لِما دَعا بِاِبتِهال في الضَراعات"],["BE182D36-8404-58FF-91EB-BB482EA60C06","أَنقذته يا اله العَرش مِن ظُلم","لِظُلمَة النَفس لاقته بِاِعنات"],["CD8CD288-5F17-588C-A9D1-7A6E02890206","وَاِبيضت العَين من يَعقوب وَاِنسَكَبَت","حُزنا عَلى سُيوف في فَيض عِبرات"],["FEB3A6E3-0364-59B8-A357-7511C298333B","وَمُذ شَكا البث لِلرحمن عادَ لَهُ","نور العُيونِ قَرينا بِالمَسَرّات"],["CEE3B0B7-CAA6-5BA2-86EC-5EDC7492C64F","وَيوسف السَيد الصَديق حينَ دَعا","في ظُلمَة السِجن من بَعد الغِيابات"],["59AA0295-6674-54B7-A9BB-2E0C4F9E3065","أَوليته الحُكم وَالمُلك العَظيم كَما","آتَيتُهُ العِلم مِن اِسنى العِنايات"],["2154FDB8-BECB-5A09-83E7-461E79186276","وَمُذ عَلِمت بِاِخلاص الخَليل غَدا","وَالنار من حَولِهِ في رَوض جنات"],["3FB75A96-BA76-50F0-8BFA-2E8BC44FF99D","عادَت سَلاما وَبَردا بَعد ما اِشتَعَلَت","وَلَم يَفه من يَقين بِالشِكايات"],["4E5376D4-A910-5875-904F-29A79A8D35F4","وَقَد رَفَعَت يَمينَ الذُل داعِيَة","اِلَيكَ يا رَب أَرجو غَفر زلاتي"],["AA5C2488-338B-527B-8F7F-AA3A18A2B722","رَبّي اِلهي مَعبودي وَمُلتَجىء","اِلَيكَ أَرفَعُ بثى وَاِبتِهالاتي"],["4224AC5A-73F4-512A-9E45-5C477459ED6E","قَد ضَرَّني طَعن حسادي وَأَنتَ تَرى","ظُلمي وَعِلمُكَ يَغنى عَن سُؤالاتي"],["57375270-839F-5F05-BEAA-B5679C047377","فَاِمنُن عَلى بِالاف لِتُخرِجُني","مِنَ الضَلالِ اِلى سبل الهِدايات"],["539EF55F-C746-593F-83FB-A5E3DF0601C2","أَنت الخَبير بِحالي وَالبَصيرُ بِهِ","فَاِفتَج لِهذا الدعا بابَ الاِجابات"],["A6FF3C7A-8F4F-5180-8C55-313C10A288D4","فَكَيفَ أَشكو لِمَخلوق وَقَد لَجَأت","لَكَ الخَلائِق في يسر وَشدات"],["F3981FE0-EDEC-5B37-9B43-20975D572FC2","فَيا لَها من جراح كُلَّما اِتسعت","أَعيت طبيب رُغما عَن مُداواتي"],["96BA0136-003A-5B88-BD57-B8179C6AF474","أَنتَ الشَهيد عَلى قَول أَفوه بِهِ","ما دُمت عائِشة فَالحَمدُ غاياتي"]]},"92A9703C-2F16-5680-B54C-3D72D7C43A91":{"t":"مَلك الفُؤاد وَقَد وَشى","p":218,"s":"ملك الفؤاد وقد وشى","r":"463576","v":[["0A4B48AC-4BCA-56F3-B357-AC0ED7AF99A8","مَلك الفُؤاد وَقَد وَشى","بَدر تَكَنّى بِالرَشا"],["DA296CED-C1ED-5AA7-BDFD-1ADB9CA172BD","عَذب الرِضاب مهفهف","يَسبي الشَجي اِذا مَشى"],["45051C34-2469-502F-A307-90D390D634E4","ما حيلَتي في حبه","اِلّا سَعير في الحَشا"]]},"28C751A6-6FBD-5EAF-A405-D10B90FDC8D8":{"t":"مَنشور حُسنِكَ في الحَشا سَطرته","p":218,"s":"منشور حسنك في الحشا سطرته","r":"463461","v":[["4268EABD-1958-5D17-9251-BEDCDB3057F8","مَنشور حُسنِكَ في الحَشا سَطرته","وَرَقيم خَطِّكَ طالَما كَرَّرتَهُ"],["C95C0218-3B1E-57B4-A9CF-EA55055386EF","سَطر العذار تَلونه فَوَجَدُّتُه","يَومى لِسَفكِ دِمى قَد سَلَّمتُه"],["054FDE2E-5747-5248-9A04-A9E683B5F893","اِفنيت صَبرى في هَواك مُتَيَّما","وَقَضيت عُمري في جَمالِكَ مُغرَما"],["0F7E286C-1391-52D9-9E5D-4EEB929656F9","وَتَرَكتُ سَرى بِالتَجَلُّد مُبهَما","فَأَنَلتَني تيها أَبادَ وَأَعدَما"],["6BE41E10-E1E1-5BC7-B0A4-752651CA5327","جَفني لِبُعدِكَ بِالصُدودِ تَأَرَّقا","وَمَذاق عيشى مر وَالسَهد اِرتَقى"],["0FFB8A02-0313-53E1-B4FE-14B507C9C957","وَالقَلبُ مِن نارِ الغَرامِ تَحَرَّقا","قُل لي بِحَقِّكَ يا غَزال مَتى اللُقا"],["CBB8FAF6-AC4B-5768-89FA-5D731552A532","اِفديكَ مِن غُصن وَريق بِالحلى","تَزهو بِوَجناتِ وَريق قَد حَلا"],["861589A8-5D40-5FA2-9AB0-DE18DA329D96","وَتَغض جَفنا بِالنُعاسِ مُعسلا","فَاِسمَح بِرَشفِ لمى يَفوقُ السَلسَلا"],["07CEB535-2D7F-5CD9-9B23-225312DCC3EB","يا ظَبى في قَلبي عَلَيكَ حَرارَة","تَطفى لَظاها اِن سَمَحت زِيارَة"],["C6D886AB-F73F-5EA6-880B-DE4F0D6CEF89","حُلوُ الرِضابِ أَفي الوِصالِ مَرارَة","أَم في اِلتِفاتِكِ لِلشَجى خَسارَة"],["8F2ADC3F-CAA6-5C31-9F83-5A67995F1AB7","مَن ذا الَّذي أَغواكَ حَتّى خُنتَني","وَنَبَذتَ عَهدى بَعد ما قاسَمتَني"],["34D4D121-126F-5A05-B333-F10EBBAEA57E","يا مالِكاً قَلبي وَما مَلَكتَني","أَينَ الوُعودُ وَأَينَ ما بَشَّرتَني"],["1DFC5610-0BF7-5306-8999-1DDC4A5B9378","جَهل العَواذِل حالَتي فَجَلَوتَها","خاضوا بِسَرمَدا مَعى أَطلَقتها"],["71279FF6-59CC-567C-BEA9-4BBF057DF0B8","قالوا بِمُهجَتِهِ غَرام قلت ها","شَكوى بسر سَريرَتي أَعلَنتها"],["F64A428C-FDF0-5FC8-A0AD-A47FBAA64DAA","قَلبي بِكُل مشا بِهِ لَكَ قَد صَبا","حَتّى عَشِقتُ لِحُسنِ لَفتَتِكَ الظَبا"],["03E62EE5-0D4E-59E9-AFAD-F517EC30B5BA","وَلَكم رَأَيت مِنَ الهَوى مُستَغرِباً","أَشد وَلمن يَغدو أَمامى مَرحَبا"],["A4DFA045-ECBF-5673-B4A3-3642412C44C9","خاصَمت فيكَ عَشيرَتي وَتَرَكتَهُم","وَرَضيتُ حالَة وِحدَتي وَهَجَرتَهُم"],["0B60AC87-4144-5A24-B635-04C9FBFDE25E","وَاِلى السُلو دَعوا فَما لَبيتُهُم","نَصَحوا فَلَم أَعبَأ بِهِم وَعَصيتُهُم"],["DB96EA96-87BE-50B3-A0E4-3BFD162BA803","تَاللَه ما هذا غَزال بَل ملك","أَخَذَ القُلوب بِوِجنَتَيهِ بَل اِمتَلَك"],["DA9612FD-D259-53E5-8F54-9E4C81A199D6","يا بَدر تَم الحُسن وَالاِحسان لَك","عَطفا لِصبك فَالمُتَيَّم قَد هَلَك"],["D8EF8E2E-3266-5D24-830E-A9CCC1311F8E","ما بالُ قَلبِكَ لا يرق لِحالَتي","وَلَكَم رَئى اللاحى وَرق لِلَوعَتي"],["ECDE3396-90D1-58E0-A86B-34887A5BB970","قُل لي بِحَقِّكَ هَل أَتيتَ بزلة","حَتّى أُقاسي في الحَياةِ مُنيَتي"],["C6345AB5-F172-562D-AC05-92C3C5925188","العَبد يَرجو ف هَواكَ عِنايَة","وَيود يَوماً لَو سَمِعتُ شِكايَة"],["317773CA-606A-58A4-A2B0-2BE4CA451400","ذَهَبَ الزَمانُ وَما أَتيتُ جِنايَة","وَوَجَدت مَع هذا صَددوكَ غايَة"]]},"FDD13CAE-03CB-59DC-A584-C1D4973974A0":{"t":"مَوصول لُطفك لا أَفيكَ بِشُكرِه","p":218,"s":"موصول لطفك لا أفيك بشكره","r":"463431","v":[["5B2B0A79-26EC-5CE6-9BB5-4912778E70B0","مَوصول لُطفك لا أَفيكَ بِشُكرِه","صلتي اِلى نُعماكَ خَيرُ جَزائي"]]},"AE7C9A8C-49C1-5D74-A2EF-F39368A6D281":{"t":"مَولايَ كَم حَمل النَسيم سَلامي","p":218,"s":"مولاي كم حمل النسيم سلامي","r":"463727","v":[["053210FD-AEA1-51E0-939F-D870DD3E6E57","مَولايَ كَم حَمل النَسيم سَلامي","فَعَلامَ تَعنيفي وَطول مَلامي"],["0D823E05-A9A0-50CD-8CC2-62DCEB9B8862","وَلَكَم بَعَثتُ مَعَ البَريدِ رَسائِلاً","وَمَنَعتُ حَتّى الطيف في الأَحلام"],["79046E57-042A-55C6-8192-D91FB7C558B8","وَلَطالَما ضَحِكتُ بروق رَسائِلي","لَما بَكَت بِصَريرِها أَقلامي"],["7DDC290C-8C18-5B0B-989E-1C2B3FD5990E","فَسَل النَسيمَ عَنِ المُحِبِّ فَما بِهِ","الاِسهاد مَعَ مَزيد سَقامى"],["0D1173A7-C5C9-57C6-80B1-48041C141D4A","قَلبي بحبك يا غَزال مُتيم","يَشكو ظَماه لِثغرك البسام"],["E7602357-0102-5A96-A06B-9431C27F8B71","وَاِسأَل خَيالَكَ عَن هَوايَ فَاِنَّهُ","في اللَيلِ مَع طولِ النَهارِ أَمامي"],["BF050678-D7B0-50D4-A571-2E6A64C8F287","أَنا لا أَحولُ عَن الوِدادِ فَاِنَّني","في مَبدا الاِشواقِ مثل خِتامي"]]},"8F6D0B6E-40ED-54E8-9026-228B5DA0DD37":{"t":"مُذ قالَ حاجِبُه اِليّ تَعالي","p":218,"s":"مذ قال حاجبه الي تعالي","r":"463650","v":[["E9E56B9B-3DED-5FCB-952F-D4E5483A75B5","مُذ قالَ حاجِبُه اِليّ تَعالي","بِوَلائِه رقي عَليّ تَعالى"],["330BA0F9-306F-59CB-A68B-B85330469327","كَم ذا تَبارَكَ خالِقي وَتَعالى","في كُل مَعنى اِنَّهُ لَعَظيم"]]},"F27317A6-1A3E-59F8-86DA-B3BCD97CC3DB":{"t":"مُذ لاحَ مُشرِقاً بَعدَ البِعاد","p":218,"s":"مذ لاح مشرقا بعد البعاد","r":"463499","v":[["B8BF6B93-74F5-5E7D-B14B-1548C0205464","مُذ لاحَ مُشرِقاً بَعدَ البِعاد","وَشَفا بِدرياق اللُقا أَلَم الفُؤاد"],["2B236F3F-65F8-5962-AFAB-9B424A2924C9","ناديتُ عَدلي يا صَفا فَالاِنس","جَل الَّذي هَنى فُؤادي بِالمُراد"]]},"C8595158-9335-5D2A-A1D1-73494B801E38":{"t":"هَنى لنازِل يا صِبا بِحُضورِهِم","p":218,"s":"هنى لنازل يا صبا بحضورهم","r":"463562","v":[["22B48D8F-5C22-53D5-BD08-4302BA77F88A","هَنى لنازِل يا صِبا بِحُضورِهِم","وَتَحملي في الكَون نَفح عَبيرِهِم"],["AC8BA00D-5CF9-5682-85CF-30AF28C24B60","وَتَرددي سحرا لِشَرح صُدورِهِم","وَدَعى القُصو وَعَرجى بِقُصورِهِم"]]},"74ACDD88-F55E-588E-84BA-7C6F0B6AFC42":{"t":"وَاللَه ما هِمتُ حَظا بِاِسمِ داعِيَة","p":218,"s":"والله ما همت حظا باسم داعية","r":"463582","v":[["723E0006-0B43-576B-9F65-C8FB9F13A105","وَاللَه ما هِمتُ حَظا بِاِسمِ داعِيَة","اِلّا وَأَعقَبَ فيها الهَم مِن أَسفي"],["BE82ED0E-E61B-5EBF-B1B9-AFA51E80EE74","وَلا سَعيت بِأَقوى العَزم في أَرَب","اِلّا رَجَعت طَريح الاِرضِ في دَنَف"]]},"7509651B-5F08-50D0-A1E0-F1B484A14CCD":{"t":"وَعَذري الهَوى العَذري وَهُوَ يَمين","p":218,"s":"وعذري الهوى العذري وهو يمين","r":"463769","v":[["F1CC2529-6158-5562-81C7-18D04510FA8B","وَعَذري الهَوى العَذري وَهُوَ يَمين","بِهِ مقسم التبريج لَيسَ يَمين"],["3F57BA62-D7E7-55A4-A16E-6BE24BC40340","لا فَتك من ضَرب الصفاح تَبين","عُيون عَنِ السِحر المُبينِ تَبين"],["739C74BA-BF27-53C2-9255-51421644CF68","عَجِبتُ لَها تَنسى وَقَلبي حافِظ","وَاِنسانُها يَسبى النُهى وَهُوَ واعِظ"],["436D9AFC-347A-578F-BC8E-A2DF487B737D","وَأَعجَبُ مِن ذا الفَتك وَهي لَواحِظ","مراض صحاح ناعِسات يَواقِظ"],["22A88923-4D81-5B2A-A3CB-B2BBDD7F67F3","فَآها لها مَرضى عَلى شِدَّة القوى","وَهاروت عَن أَجفانِها السحر قَد رَوى"],["991140B7-5B46-5243-91FB-D44792F50401","وَلا ذَنب لِلوَلهان في لَوعَة الجَوى","اِذا أَبصَرَت قَلبا خَليا مِنَ الهَوى"],["E12FCF3A-2494-5A17-BFD6-F6AB93C900BF","يقاد لَها طوعا أَسيراً وَطالَما","أَضاعَت بِوادي التيه صَبا وَمغربا"],["7BBC312E-ED91-5671-AAE8-9E0A404A6997","وَكَم فوقت سَهما وَكَم سَفَكَت دَما","وَما جَردت من مُرهَفات وَاِنَّما"]]},"994B2A1B-CBF6-5908-9618-E3CA393075FF":{"t":"وَلى عَين لَها مَزن","p":218,"s":"ولى عين لها مزن","r":"463403","v":[["7EE8FB07-4579-5CBB-BEB3-93B28ED2BFAD","وَلى عَين لَها مَزن","كَطل دائِم الصَب"],["AE03E69B-C2EE-5EFD-A830-E03330974BB7","وَتِلكَ هِيَ الَّتي جابَت","عَذاب الحُب لِلصَب"]]},"B980300C-72B1-5FA1-B738-329406828F61":{"t":"وَلَه بِقَلبِكَ وَالدُموعُ سَواكِبُ","p":218,"s":"وله بقلبك والدموع سواكب","r":"463425","v":[["4E6195E9-8E75-542B-9DA9-D4AF2B72732C","وَلَه بِقَلبِكَ وَالدُموعُ سَواكِبُ","وَتَزَلزَلَت بِالوجدِ مِنك مَناكِب"],["24FE0B98-5DC4-5A63-A289-C5CF0506AE0F","فَكَأَنَّما سَقَطَت عَلَيكَ كَواكِب","وَتَصارَعَت بِالصَدرِ مِنك رجوم"]]},"1A1BDB7A-CD83-54AE-850B-B5FC545BBC56":{"t":"وَلَيلى ما كَفاها","p":218,"s":"وليلى ما كفاها","r":"463787","v":[["01C213F8-3113-5C9C-A71E-32928BE68A52","وَلَيلى ما كَفاها الهَجرُ حَتّى","أَرَتني جُرحَ قَلبي بِالعُيونِ"],["AB4B2B83-5D5B-55BB-A555-D56AFB9B7E66","وَما قَنَعتَ بِسَفكِ دِمى وَلكِن","أَباحَت في الهَوى عَرضي وَديق"],["A4058265-5ED3-594C-8DC1-ECB6B74367E4","فَقُلتُ لَها اِرحَمي الاِمى قالَت","بامى قَد بَليت فَمن مُعيني"],["E5282BB6-6C97-58A7-A525-4176FA132AFB","أَتَرحَمُ في الغَرام وَأَنت صب","وَهل في الحُب يا أُمّي اِرحَميني"]]},"E21F6154-5652-5CBD-9919-8D4FA677E41A":{"t":"وَلَيلى ما كَفاها الهَجرُ","p":218,"s":"وليلى ما كفاها الهجر","r":"463755","v":[["29C9CE50-FDBB-52D2-8533-F7754DB90928","وَلَيلى ما كَفاها الهَجرُ حَتّى","أَذاعَت بَعدَ كِتمانٍ شُجوني"],["C4C8CF07-A571-5BC0-BDAA-939C4D920164","وَحين تَبينت آيات وَجدي","أَباحَت في الهَوى عَرضي وَديق"],["697DB276-E306-5080-8E29-37D54D8D668F","فَقُلتُ لَها اِرحَمي الاِمى قالَت","جَننت وَفي الهَوى بَعضُ الجُنونِ"],["B1780865-CC36-5B02-8478-99546CE0994B","وَهبنى كُنت أَمك كَيفَ أَحنو","وَهَل في الحُبِّ يا أُمّي اِرحَميني"]]},"E5AAAD2B-82AD-5301-8DCA-40059A401E56":{"t":"وَلَيلى ما كَفاها الهَجرُ حَتّى","p":218,"s":"وليلى ما كفاها الهجر حتى","r":"463743","v":[["733FC05D-46EE-5F0C-8887-8012D16F51DF","وَلَيلى ما كَفاها الهَجرُ حَتّى","أَطلّت في دُجى لَيلى أَنينى"],["591321B4-DAFB-575F-AA23-023C3A421788","وَكل تَجلدي بِالصَبر لما","أَباحَت في الهَوى عَرضي وَديني"],["5D3E432F-414B-5A1A-A0EC-B744C082B90A","فَقُلتُ لَها اِرحَمي الاِمى قالَت","كَذا خَط اليَراعُ عَلى الجَبين"],["3E51B6A2-8182-559F-A893-DAE33BC11B25","فَدَع قَلَقَ الصِغارِ وَكُن صَبوراً","وَهَل في الحُبِّ يا أُمّي اِرحَميني"]]},"4030C177-2644-5531-91B0-31239A7FE0B7":{"t":"وَمتصف بِالنَحو أَعرب حسنه","p":218,"s":"ومتصف بالنحو أعرب حسنه","r":"463678","v":[["97DFFDAB-5F7D-53C8-BD7D-FB070E68D04E","وَمتصف بِالنَحو أَعرب حسنه","فَأَورَدَ اِشكالا غدا عَنهُ مَسؤلا"],["FFF0CC8A-2AE8-517E-B249-1AEE4CC8968A","سَقامى فعل لازِم وَصُدودِه","لَهُ فاعِل لَم صير القَلب مَفعولا"]]},"9AC9FD62-175A-5C16-A97E-EDA31F29A1D7":{"t":"يا أَلف أَهلا مَليك الحُسن أَهو قابِل","p":218,"s":"يا ألف أهلا مليك الحسن أهو قابل","r":"463668","v":[["ED9BA0D9-E2F5-5979-9468-16E03862BEF0","يا أَلف أَهلا مَليك الحُسن أَهو قابِل","وَكل مَضنى بِحُسن الاِمتِثال قابِل"],["1667E234-2E57-52B0-B3B4-8736B066B778","هاروت لحاظو أَتى بِالسِحر من بابِل","كَم مِن ضَنى تاهَت أَفكار وَقَلبه داب"]]},"DA48961C-7E5E-5799-BA8C-6922AB67929F":{"t":"يا بَدر رفقا بِالفُؤادِ فَاِنَّهُ","p":218,"s":"يا بدر رفقا بالفؤاد فانه","r":"463666","v":[["EB194689-9687-50B4-B94F-B6AC2D5EEA5B","يا بَدر رفقا بِالفُؤادِ فَاِنَّهُ","أَضحى بِمَعتَل النَسيمِ عَليلا"],["721D0E55-8078-54E3-AA57-7ACEDB379D5D","مِمّا يَحمله اِلَيكَ تَحِيَّة","في كُل يَوم بَكرة وَأَصيلا"],["0A759741-2E01-5166-9BCE-7553C594DA3F","فَلَهُ عَلى يَد أَدين بِشُكرِها","اِذ ما اِتَّخَذَت سِواه قَط رَسولا"],["8512E156-7A6D-5CE0-94D1-7AE13339112E","اِن رُمت اِبرازَ الضَميرِ فَاِنَّهُ","يَحتاجُ شَرحاً في هَواك طَويلا"],["4669D66F-9E19-57AE-AD04-679460D76F3C","دَنف أَضاع العُمر في لكِن وَلَو","وَعَسى وَلَم يَشف الكَلام عَليلا"],["76448705-E4A0-523A-AC9A-5350149D76DD","وَقَد اِكتَسى ضُعفا أَضر بِجِسمِهِ","حَتّى يَرى خمل القَميصِ ثَقيلا"]]},"B0C1D6F8-1F43-5CFC-A459-8711F4FE4FFC":{"t":"يا بَدرُ قَد صَدّقَت آمالي الَّتي","p":218,"s":"يا بدر قد صدقت آمالي التي","r":"463601","v":[["D9C84B2F-F470-538B-89E5-C223B84029CD","يا بَدرُ قَد صَدّقَت آمالي الَّتي","نَصر اللُقا بِها عَلى التَفريق"],["0A54F0A4-826C-5091-9855-780A93A362F3","لا زالَت الاِيّام تَهديكَ الوَفا","رَغمَ الوُشاةِ وَبغية الصَديق"]]},"C497A34B-F726-54D8-9CBF-E916E52BA10B":{"t":"يا بِغيَة الصَب رِفقا بِالفُؤاد فَقَد","p":218,"s":"يا بغية الصب رفقا بالفؤاد فقد","r":"463686","v":[["C8EE3072-A1AC-5726-828C-411072367960","يا بِغيَة الصَب رِفقا بِالفُؤاد فَقَد","أَشجاه ما بِكَ مِن تيه وَمِن مَيل"],["156370FC-3A5E-5B1D-B71E-502FAAD8BEEE","بِالصَدِّ أَلهَبت قَلباً أَنتِ ساكِنَه","هَلّا عَطَفت عَلى سَكناك يا أَملى"],["AE0EB219-0371-510F-942D-DD5A37FE8F9D","قابَلت طَيفِكَ لَيلا كَي أُعانِقُه","وَقُمتُ أَلثَم ثَغرا شيبَ بِالعَسَلِ"],["0BAFE48B-EE88-5359-897E-3E5F28F61394","فَأَغمِض الطَرف عَنى مُعرِضا وَنَأى","بِجانِبِ التيهِ مُذ وَلى عَل عَجل"],["6CF5A342-43B1-5E9A-BEBC-4A70CA5A334B","فَمُهجَتي أَحرَقت من حر ما وَجَدَت","وَمُقلَتي أَغرَقَت في دَمعِها الهطل"]]},"B7C668C9-2116-5EB1-8122-32A2F86D0285":{"t":"يا حَلو طبعك ظَريف","p":218,"s":"يا حلو طبعك ظريف","r":"463447","v":[["74CF12F2-6EEB-5F1C-AD5A-FD4069261883","يا حَلو طبعك ظَريف","وَاِنتَ فَريد في الصِفات"],["A8FC5057-7DE7-56B4-A9FB-108DA20ED9AB","وَكنت لين لَطيف","قال لي دا كان يَوم وَفات"]]},"04C0EFAF-3FCA-572E-808D-AE28C4AA45C9":{"t":"يا قَبر فَاِهنَأ بِالَّتي أَحرَزَتها","p":218,"s":"يا قبر فاهنأ بالتي أحرزتها","r":"463580","v":[["3A261DC8-1203-53E8-8C76-3F3F2021D669","يا قَبر فَاِهنَأ بِالَّتي أَحرَزَتها","هي درة في الدَرج لاحَت تَسطَع"],["6B89A120-D97D-51FE-B68D-1F8C92B3A89B","قَد خانَها الدَهرُ المُلَم فَأَصبَحَت","لِكُؤس أَسقام الضَنا تَتَجَرَّع"],["D7197285-7FEC-5EB2-BC65-44BDDBB2D4B4","ذاقَت مَريرَ السَقمِ مِن عَهدِ الصِبا","حَتّى قَضَت أَيّامَها تَتَوَجَّع"],["146B559B-5C24-5E40-BF52-4815EB8EE552","رَحَلَت وَقَد أَفنى النَزيفُ دِماءَها","وَالقَلبُ في حَسَراتِهِ يَتَصَدَّع"],["28BB7368-D444-580F-800C-8C5AADE4622E","كَم مِن طَبيب لَم يَكل وَطالَما","داوى وَلكِن داؤُها يَتَفَوَّع"],["CDD2920D-685E-58DD-AF43-8F49AF884C61","كَم لَيلَة باتَت تُساهِر نَجمُهُ","وَتَئِن مِمّا قَد حَوَتهُ الاِضلُع"],["1FF7735C-9F57-5555-972A-DB60349B9B6D","حَتّى أَتى أَمر الاله لَها اِدخُلي","لَحدا وَأَمرُ اللَهَ لا يَستَرجِع"],["95F325D1-2EB2-5C2E-9C17-FC434D6E2D70","يا رَب فَاِجعَل جَنَّة المَأوى لَها","دارا يَطيبُ نَعيمُها تَتَمَتَّع"],["2A7D7C45-96F2-5B87-AEA0-84718D2AD595","وَاِسكُب عَلى حَصبائِها سَحب الرِضا","فَضلا وَاِن تَكُ قَد سَقَّها الاِدمُع"],["A8AA1050-28AA-58F9-A400-9336E1F6465C","يَهنا لاِربابَ النَعيم نَعيمُهُم","طوبى لِمَن مِن نَهرِهِم يَتَضَلَّع"],["A53B0BE8-9CBB-56DA-858A-D89DA690A4EF","يا مَنهل التَشتيت حَسبُكَ ما جَرى","فَعُيونُنا قَد أَقسَمتُ لا تَهجَع"],["F9C9AF26-8762-53F3-8E9A-E9F0EC134F36","ما بالُ هذا الدَهر يَفجَأ بِالاِسى","أَلبابُنا وَلَكُم بِحُزنِ يَفجَع"],["09FE3062-7CC3-5AAF-BD0B-D655CEC7CFC4","ذَهب الاحبة وَاِستَقَلَّ رِكابُهم","يا لَيتَ روحى وَدعت اِذ وَدَعوا"],["374A35B0-C2B2-569B-9E6E-937C9DFACF16","يا لَيتَهُم طَلَبوا الفِداءَ فَهذِهِ","روحى وَلكِن لَيتَ لَيسَت تَنفَعُ"],["A33780FF-CD76-5DFC-A9D3-0E2C9A3CC6EA","وارادة المَولى تَعالى شَأنَهُ","حَتَمَت لَنا هذا فَماذا نَصنَعُ"]]},"66D02AAF-9A00-59AB-BF94-B5A611CEB7B9":{"t":"يا لَيل اِنَّكَ في الفِعال مُنافِق","p":218,"s":"يا ليل انك في الفعال منافق","r":"463612","v":[["F024EAE3-AB2A-5502-BB6A-137EEB30DE60","يا لَيل اِنَّكَ في الفِعال مُنافِق","هذا تَسهده وَذاكَ تُوافِق"],["4338B516-6A6C-5029-92F2-D245FF316C83","وَاِذا لِسَهد أَن فيكَ العاشِق","ضاعَفتَ شَكواه وَأَنتَ بَهيم"]]},"4636BE9F-05CF-558A-9EF4-FFB5F7363F74":{"t":"يا لَيل ها أَنا فيكَ ساه ساهِر","p":218,"s":"يا ليل ها أنا فيك ساه ساهر","r":"463558","v":[["D9E739A7-C09A-566C-A36E-F8562A7DCD3F","يا لَيل ها أَنا فيكَ ساه ساهِر","وَلِعِزَّة المَحبوبِ شاكَ شاكِر"],["2748787E-DC24-552D-80E0-AFF0B640DB20","يا لَيل قَد أَيقَنتَ اِنَّكَ كافِر","اِذ لَم يَكُن لي من دجاكَ رَحيم"]]},"9A3C2088-463A-58B0-A062-9C8D79BAF4F3":{"t":"يا مَن أَتى لِلجِسم يُبرىء سقمه","p":218,"s":"يا من أتى للجسم يبرىء سقمه","r":"463520","v":[["11313D3D-D0B7-579C-AA3E-29C8D9348D07","يا مَن أَتى لِلجِسم يُبرىء سقمه","وَيَظُن جالينوس بَعض عَبيدِه"],["7188A3B1-6F5D-5B24-9DA7-0954E2B9D72C","أَفنَيت بِالطِب الَّذي تَهذى بِهِ","أَمما وَقربت الرَدى بِبَعيده"],["054EEFD4-2DEA-5A87-A518-5F6720380380","وَزَعَمت أَنَّكَ قَد جَدَّدتَه","وَلَقَد أَضَعت قَديمُه بِجَديدُه"]]},"BBCA752A-7A2B-55BB-A2D2-C63F2070EFC9":{"t":"يا مَن أَضاعَ رِسالَة أَهدَيتُها","p":218,"s":"يا من أضاع رسالة أهديتها","r":"463638","v":[["9DCFCE80-9BAB-5B64-B411-03004145DAB0","يا مَن أَضاعَ رِسالَة أَهدَيتُها","تَرك الرِسالَة مِثل تَرك المُرسِل"],["D90B1976-983C-5B2C-B243-B4113BC265CD","حفظ الاِحِبَّةِ لِلمحب رَقاعَه","وَأَضَعتَ أَنتَ رِسالَة لتوسل"],["312984C0-6E65-506B-98AE-AB9995453395","وَعَلام تَطلُب ثانيا اِرسالَها","وَتَضيعها هدرا كَأَن لَم تُرسَل"],["583E1ED7-7B04-58DD-A46B-44425D4654F1","ما ثَم لَو رمت الاِعادَة نُسخَة","وَسِوى الَّتي اِتلَفَتها لَم اِنقَل"],["426FBECB-A289-5F9C-BD6F-B48DF1E5EA80","قَد قالَها فكرى مُحاضَرَة وَلَم","تَسطر لَدى وَقتَها بِالمهمل"],["B5429FA4-834F-50DD-970C-496A1F41FDE6","يا مفردا نظمت لَه عَلياؤُه","دور الثَناء عَلى الكَمالِ الافضَل"],["C7C7C85F-AF3D-58C8-98E6-3254B865750B","دَعني وَما فعل السقام فَاِن لي","جِسماً عَلى تِلكَ العِظامُ النحل"],["E8716E97-4AB8-5C60-8E5E-F4B3311AAE64","لي شاغِل بِالسَقمِ عَن اِرسالِ ما","تَبغى وَاِرسلها اِذا لَم أَشغل"],["6B6883DA-E2DA-5045-970F-457F79C8A3E5","لا بُد لِلتَنسيقِ مِن عَقل وَمن","فِكر وَمِن قَلب عَنِ الدُنيا خلى"]]},"92147B9D-832F-510C-835F-046EB5484B4D":{"t":"يا مَن أُفاخِر في مَحَبَّتِهِ وَمن","p":218,"s":"يا من أفاخر في محبته ومن","r":"463574","v":[["2518949F-A838-5EE7-BBA3-4632579A1D71","يا مَن أُفاخِر في مَحَبَّتِهِ وَمن","أَصبو اِذا ذَكر اِسمُه في مَجلس"],["D1EC2C1A-2FCF-5A35-8CEF-B9415BA3E424","الوَرد لَوفى الخَد صاحِب شَوكَة","فَلَم اِرتَضى بعلو قَدر النَرجِس"],["BC9E4FE6-680F-54BB-953C-21B29F0D7CB6","ما بال سَهم اللَحظ حل بِمُهجَتي","أَواه من أَفعال هاتيكَ القَسي"],["11965AD0-417F-5902-A124-275DBFD09B21","يَسطو وَلا يَخشى مَلامَة لائِم","وَيَجور وَهو محكم في الاِنفس"],["3AEBF2AA-8043-5563-96BF-B811D6E0F445","فَفُؤاده كَالصَلدِ اِلّا أَنَّهُ","تَزهو مَحاسِنَهُ بِروض السُندُس"]]},"26BA2898-1EA4-5402-A7EE-C0BCDD6EB1DF":{"t":"يا مَن اِذا ذكراسمه أَشتاقَه","p":218,"s":"يا من اذا ذكراسمه أشتاقه","r":"463597","v":[["0EC83F3F-C282-5051-A6C8-1CDDC7F90DFC","يا مَن اِذا ذكراسمه أَشتاقَه","رِففا بِصَب سَعَرت أَشواقه"],["75D768A7-713E-52C9-80E2-040C59F3ED45","سَكَنَ الهَوى بِفُؤادِهِ فَتَلَهَّبَت","نارُ الصَميمِ وَقَد دَنا أَحراقَه"],["7178D08F-9432-549B-9DF3-5702F470CC0A","فَغَدا يَقولُ مِنَ الصَبابَةِ لِلصِّبا","مَهلا فَقَلبي هَزَّني اِشفاقَه"],["D04D8EE1-507D-5AA6-8B49-1A56D6324463","هَل تَحمِلينَ اِلى الحَبيبِ رِسالَة","أَجرى مِياه مَدادَها اِغراقه"],["6C4D7560-1A86-55FD-8558-D5BE51FE2CBC","كَتَب السُطورَ وَقَد أَفاضَ مَدامِعا","تَشكو لَهيبَ جَميعُها آماقَه"],["CC1143D1-512C-5D25-AD8F-1CB60D71096C","لِما رَأى صَد الرِفاقِ عَنِ الوَفا","شَرَحتَ حَديثُ شُجونِه أَوراقَه"],["A69A5013-7728-58D4-BFAD-D7ECF508910A","فَغَدا يردد مِن هَواهُ قائِلاً","يا مَن اِذا ذَكَرَ اِسمُه أَشتاقَه"]]},"02E0FCE3-8139-575D-99B8-D5A67AF0E2D0":{"t":"يا مَن تنزه عن شبه يماثله","p":218,"s":"يا من تنزه عن شبه يماثله","r":"463705","v":[["A9428127-3211-5D22-B7AB-3EA31121A15C","يا مَن تنزه عن شبه يماثله","في غرة الحسن أَو فى رقة الشيم"],["F341B9A0-787F-5197-A040-7CCA9BA45510","أَنَرتَ بِالحُسنِ مُشكاة الجَمالِ وَقَد","ضاءَت بِأَنوارِكَ الدنيا مِنَ الظُلمِ"],["23C122B2-9A57-5BF9-AA07-1E86E033F2CC","لَو خالَكَ البَدرُ يَوماً قالَ مُندَهِشاً","أَنتَ الصَباح وَأَنتَ النور للامم"],["7A90E66B-08C1-5E9F-A817-F8FA7273A7EE","أَنا المسر بَل بِالاِعذار مِن كلفى","اِذا اِلتَقَينا وَأَنتَ الرائِقُ الوَسم"],["E239F15C-C0E7-55E7-8DE5-D2B3F99ED3D5","طوبى لِعَين بِذياك السَنا اِكتَحَلَت","اِنسانَها في سِوى اللَذّاتِ لَم يَنم"],["59DE1E03-D204-57CA-AADA-14A1A86B0597","فَيا رَعى اللَه اِحداقا لَهُ نَظَرت","قَدما وَحيا لِسانا فازَ بِالكَلم"],["AF92A2E3-64CF-5995-BFB8-A811DBA14493","أَيّام وافى وَكانَ الوَقتُ مُبتَسِما","صَفوا وَكُنّا بِشَمل مِنهُ مُنتَظِم"],["6980DD12-13E2-59F6-A3E7-583B3A22B73C","أَسير حُبِّكَ يا بَدرا نبرى شجنا","حَتّى كانَ الهَوى يَهواهُ من قدم"],["00B21FA5-11E7-510F-AD5F-132EAC392707","شَمس الفَصاحَةِ أَضحَت مِنكَ مُشرِقَة","فَيا لَها نِعمة من أَكبَر النِعَم"],["02FCCF32-9EC4-5748-8DD0-DB4555E60408","فَكَيفَ بي وَبقولي اِن يُحيطُ عَلى","قُصور باعى بِما أَحرَزتُ مِن كَرَم"],["A56B5321-E89C-5CE0-B3EB-12B30EAF6A71","وَهذِهِ كَلِمات قادَها شَغف","اِلَيكَ لَولاهُ لَم تبرز مِنَ القَلَم"],["BD3ED3A0-32AF-5739-B403-6A498816CF3C","جاءَت وَمن خَجَل تَمشي عَلى عَجل","تَخافُ عِند لُقاها زلة القَدم"],["04FDF891-B23C-5035-9C6C-CCB1F401A82A","فحبها بِقبول فهي راجِيَة","غرفا من البَحرِ أَو رَشفا مِن الديم"]]},"3A749EA7-2CB2-5440-A671-61A68C825D5D":{"t":"يا مَن قالَ الوَرى لِما غَدَت","p":218,"s":"يا من قال الورى لما غدت","r":"463513","v":[["6647BA27-9B50-5264-830D-5433DF9C209E","يا مَن قالَ الوَرى لِما غَدَت","عَينُ الزَمانِ بِنورِ مَظهَرِهِ تَسود"],["9F9D31B9-3EE5-5FF1-9DC6-38A49465528D","رَب السَعادَة وَالسِيادَة وَالعُلا","لا زالَ بابُكَ كَعبَة كَراكِل الوُجود"],["652E2AD6-0946-5FF7-8D76-07185567545F","أَلبَستَ فَرق العَصر تيجان البَها","حَتّى غَدا لَكَ شاكِراً كُل الوُجود"],["86AC2F53-D0DA-5968-BCC3-1FDD5B4ECDA5","لا زِلتَ في أُفقِ المَعالي كَوكَباً","يَقضي عَلى الدُنيا سَناؤُكَ بِالسُعود"],["E6C70C28-7130-56B2-B305-6CCC1E145093","وَبَقيتَ في شَرَفِ وَمَجد باهِر","تَسموا مَواكِبُهُ عَلى رَغمِ الحَسود"]]},"D0E7434F-1300-5F61-ACE0-826AC07D5F16":{"t":"يامَن أَتى لِلقَبرِ يَقرَأ طَرسَه","p":218,"s":"يامن أتى للقبر يقرأ طرسه","r":"463509","v":[["ED406A34-E4B7-588F-B8D5-1747D72A77BA","يامَن أَتى لِلقَبرِ يَقرَأ طَرسَه","مَهلا فَلَيسَ كِتابُهُ بِمِداد"],["E53377E6-99C1-5B92-BE81-84297A644FBC","وَأَعد لَهُ نَظرا فان حُروفَهُ","كَتَبَت بِذوب العَينِ وَالاِكبادِ"],["DCEE365C-6821-5014-94B6-26A979ED33CF","ما خَضَبَت كَفا وَلكِن حُروفُهُ","قَد خَضَبوا راحاتِهِم بِسَواد"],["AF8F5F24-0192-5269-A059-5D92840D2AD3","ما زَيَّنوا بِمَلابِسَ مَنقوشَة","أَبَدا وَلكِن زَيَّنوا بِحداد"],["B80690E0-A5D7-5DB8-885C-C48454110D27","تَبّا لِدَهر خانَها وَاِغتالَها","مِن خُدرِها كَفَريَة الآساد"],["A12CFAE8-3874-5A39-B5F9-8831A932B5B4","وَفَريدَة لَم تَدرِ قيمَتُها الوَرى","قَد باعَها الغَواص بَيعَ كَساد"],["07C5D3D8-B8D4-5523-96D6-8B0C747DD616","نَظمت بِعِقد المَوت وَهُوَ مُفصَل","بِجَواهِر في نُظُمُهُنَّ جِياد"],["2A1F7BED-7551-5FB0-B74B-1EC1002F4B8B","وَجَدتُ وَأَعدَمها الزَمانُ حَياتِها","ما أَقرَبُ الاِعدام لِلاِيجاد"],["C2504AB4-274E-5D4A-ACB7-90666B23BE9F","وَاِخلَولَقَت يَبدو لَنا اِصلاحَها","عَلَنا فَعاجَلَها الرَدى بِفَساد"],["2580A70C-D8BA-517E-9716-8D089FACBEFB","جاءَ الطَبيبُ يَجِس نَبضَ ذِراعَها","فَرَأى التَأَثُّرَ لَيسَ كَالمُعادِ"],["892B0211-F5C4-5637-BBC6-E667F9761B43","فَتَنَفَّسَ الصُعَداءُ مَرّاتٍ وَقَد","أَعيا وَقالَ اليَومَ ضَلَّ رَشادي"],["285C3A75-E031-5510-BA60-B775603508C0","فَتَهدت جَزعا وَقالَت سيدي","أَأَموتُ قَبلَ التُربِ وَالاِنداد"],["2FA69A12-8358-53B2-A04B-ED678D076166","وَأَسيرُ مِن دون الاِنام وَكَم أَرى","لِلدَّهرِ قَبلَ المَوتِ مِن رُواد"],["1CF6B6CC-2C81-56D2-AA51-7A48C1E4D762","أَواهُ مِن فعل الزَمانِ وَمكره","مَكر الزَمان يَزَل بِالاِطواد"],["93DDB605-5CCF-564D-8117-8A35FAABF93F","بَلغ العدو مَع الحَسود مُرادَهُ","وَاِحسَرتا اِذ لَم أَفُز بِمُرادي"],["85AB5A2D-27D1-5729-AF71-BB7EB390D9AF","فَبَقيت بَعدَ حَياتِها تَنتابَني","نَوب الرَدى حَتى لَزَمتَ وُسادى"],["B6425527-28B4-5EFA-A643-B5B2FCEAC660","أَحَبيبَتي كَيفَ الرِضا بتشتت","قَد ضَرَّ بِالاِخوان وَالاولاد"],["A874E784-EF6C-54A4-81BD-FD85117A727F","وَمَتى يَكون وَالتي ما عِشت لا","أَرضاهُ لِلغُرَباء وَالآحاد"],["D28E9756-2F68-5623-B959-D3984C41949C","يا قَبرُ مَهلا ما قَد حَظيت بِدُرَّة","جَلت عَن الاِمثالِ وَالاِنداد"],["E9D11462-2FAA-5965-80E3-29F13E771B81","أَنا بي اِلى ما قَد ضَمَمت تَشوق","يا لَيتَني أَسعدَت بِالتَرداد"],["6BE9EBF5-4B13-53D8-B390-572FCC3D3311","كَنزُ اللآلىء كَيفَ يَحتُم دَرجه","يا لَيتَها شَلت يَدُ اللِحاد"]]},"C08B5814-2CEB-5E69-B6D2-313DB4012808":{"t":"يَكفي صُدودكَ يا غَزال","p":218,"s":"يكفي صدودك يا غزال","r":"463632","v":[["4BD2EB13-21D7-5582-932A-D69C567ACE64","يَكفي صُدودكَ يا غَزال","عَطفا لِعُشاقِ الجَمال"],["560916B9-85B4-53C4-825A-93F33F96B0CC","الحاظِكَ المَرضى الكِحال","هاروت عَنها قَد رَوى"]]}}}