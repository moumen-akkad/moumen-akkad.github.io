{"v":1,"poems":{"FF86B1D2-DDEB-5F24-9A69-3B0359C5C78D":{"t":"أغارَ الحُسنْ","p":224,"s":"أغار الحسن","r":"477786","v":[["BB2BEFF9-978A-5A5E-ACDA-41F3B413E7E1","أغار الحُسن وجنتهُ لهيبا","ليمنع نَمل عارضه دَبيبا"],["D90EF600-E44A-5FA1-9E7D-48B8DEDCE57A","وافرغه الصبا قًمرا فلمٌا","تلظّت نار وجنته أذيبا"],["7708D3DF-85A3-57EE-B9AA-02AE44FCA46F","اذا آسترشفت من برد الثنايا","أخافُعليهِمن نفسي لهيبا"],["9BFC52F1-9F4B-5825-9176-1698AA4E09F6","تغنى حجله فحسبتُ غصناً","ثنتهُ صباً فاوقع عندليبا"],["E041A3C4-6DD9-5117-A316-4019573D1596","اذا هضم الصبا كشحيه أوفى","بردفٍ ماج مرتجاً كثيبا"],["241E6D14-8921-5E68-9A44-A3FF15FCCB1D","فها انا منثنٍ ادنو اليهِ","اذا ما اهتز معتدلاً رطيبا"],["522C462E-52E8-52CE-8A0D-3133CF9B42A1","وهل انا راجع بعناقِ ظَبيُ","رشاً قد تيم الرشَأ الرَبيبا"],["296CE7B9-C7D5-57DF-AFF3-993C3578965F","فانعم ما على الغبراء عيشٌ","محبٌ بات مُعتنقا حَبيبا"],["013F155A-3C1C-510E-98E9-7BE7737D8067","سفرت لناظري زهراً مندٌى","فدع لي طيب نشرك ان يطيبا"],["A5DA8EC3-2C4A-5999-872F-3654E4C789B6","إذا منه أنستَ غريب حُسنٍ","أتاكَ بغيرهِ حُسناً غريبا"],["E5159EAB-4FE2-5A2E-995E-5BDD87EDCF9D","وتحسب وجهه قمرا فيرنو","فتحسب لحظهُ سيفَاً قشيبا"],["C052E74F-FD38-51EC-911E-F064EDF8FA98","اذا رمتُ السلوَّ اشتد وجدي","وزاد على الوجيبِ بهِ وَجيبا"],["847A0C16-6965-5B0F-9D61-11FA3EB35500","وعيشك أيها الرشأ المفَدٌى","لعيشي دون وصلك لن يطيبا"],["E08563CA-AB08-5F03-9740-A62780764FDF","ولست امدُّ لي امداً بعيداً","اذا ما كنت لي فيهِ قَريبا"],["690AA224-093B-56F4-9426-9091BBDD21AA","فذات الطوق لو نظرت اليهِ","لاصبح جيدها منهُ سَليبا"],["E7905203-B8CC-562B-8026-DF9CD4974048","وصورٌ قرطه صنما فخَرٌتْ","له الاصداغ تعبده صَليبا"],["79D1AC35-CA72-595E-A3B9-D7CB353BD193","متى ما كافر الظلماء يدعو","لمرسل شعره لبى مُجيبا"],["D6689D9C-3497-584E-BE4F-3DC88B9BE5D7","فلمٌا لاحَ حيٌرَ كُل لُبٍ","فلم تر عند مرآه لبيبا"],["A676670E-DEBB-599B-AFE3-1C890FE84E24","رشاً تعشو النواظر منهُ نوراً","فلا اخشى بنظرتهِ الرقيبا"],["621BE21A-7AFF-57FA-9FA3-29B36B63998A","أغار الشمس لما واجَهتهُ","بمطلعِها فودٌت أن تغيبا"],["1075967C-F715-51D6-9FE0-61C883A8C7C2","واخجل قرصها فاحمرَّ حتى","حسبتُ شعاعها الكف الخضيبا"],["5A18BEA5-454D-5E8C-A6E3-F2FBDFDCF668","ولاح لها بمطلعها اضطراب","اتنحو الافق ام تنحو المغيبا"],["DB87C1D5-8E88-51ED-A943-246E177CB8A4","هوىً قد ضاق صدر الصب فيه","ولازمه فعاد به رحيبا"],["F7CD5A88-DCE4-55CC-A325-97E554C08CAA","اقام بعينه فغدى سُهاداً","وحلَّ بقلبه فغدى وجيبا"],["C61E95E1-5D06-56B2-9DFE-3DFFF2D5668E","فلست ترى الهوى الا غريبا","ولا معنىً به الا غريبا"],["EFF50705-08C5-56F0-8B1F-215B06BD0977","ولستُ اقول هذا الشعر الا","فخارا او عتاباً او نسيبا"],["6702D653-BAD7-5B0A-8BE3-D44D36F82AA8","واني قد قرضت الشعر حسناً","لذكرك ألا لان ادُعى أديبا"],["A123497B-3D0B-58E2-A33E-CE11F1079B8E","ولستُ كسائر الشعراء شعري","تعوٌدَ أن يُثاب ولا يُثيبا"],["6BB1F555-F060-50F5-A1B5-6BF7D96CCEFA","لقد سفرت به الظلماء حتى","غدى وضح الصباح بها قشيبا"]]},"F6260603-07A4-54EB-B138-14C46A6CBD2E":{"t":"تبسٌم كالبرق","p":224,"s":"تبسم كالبرق","r":"477787","v":[["D63AB8A3-C59B-53CF-B755-E81BE19218F2","تبسَّم كالبرق لمَّا آئتلق","رشاً خاتَل القلب حتى آعتلقْ"],["D9F65B65-62B4-57C1-873C-57A32B1B9B7E","ولاحَ لنا مرسلاً شِعره","فكانَ الضياء وكان الغسَقْ"],["99553A3C-5930-5608-AA3D-6E31DEC0F0EF","كأنَّ سنا نوره صارِمُ","اصيب الصباحُ بهِ فآنفَلَقْ"],["289D677D-3CA1-51C0-9077-D29B3FBF7124","فما حاكَ من شعره مطرفاً","من الليلِ الاّ وفيه إنخَرَق"],["A663C198-B75C-5E91-BD60-283A55FF6B25","بدى والثريَّا بأفق السما","كعنقود فاكهة في طَبق"],["018E3AE2-C2A0-5883-93BE-7AC23DF9ABF2","فأخجل بدر السما وجههُ","فذا الطلّ راشح ذاكَ العَرق"],["8EC11F71-5E02-53C6-B2FC-4AB47E8170D0","وجنَّ سهيل الى وجنتَيه","فها هو في الافقِ رهن القلق"],["DABC015B-579B-5A3C-B54B-E39BAAD2490A","يجورُ النطّاق على خصرهِ","فها هو منذعر المنتطَق"],["6989CE5C-1A73-5BE2-9FEE-8F69550B5FF8","بخَدٌيهِ وردُ زها زهرَهُ","لِما قد سقَته القلوب العلق"],["FF1714D3-95AA-5FD7-BE21-42930862EA6F","أقام به خالّه حارساً","يذود عن الزهر سحر الحدق"],["F81A2B05-814D-5C86-8740-D0451763651A","فصُنه بنهديك هب إنٌهُ","صَلا نار خدّيك حتى احترق"],["D2FB6714-0D6F-587C-8C7C-282FF811CAA6","فقد ماج ماء الصبا فيهما","ألم تخشَ ان يعتريه الغَرقْ"],["95F9F1BE-48C2-5583-A842-FAB9B5E3E40C","رشاً خامر السكر إخلاقَهُ","فبات يُرى فيه مثل النَزقْ"],["32547620-6DB1-5086-B1E8-28953645C94D","ثناياهُ والواو من صِدغِه","هما علَّمانيَ عطف النسَق"],["00A5882E-FF80-5AB0-8291-0BA3A38D908B","فبتُّ ومن ريقهِ خمرتي","ولم أحتسي كاس ساقٍ رَهَق"],["220BBCC4-9AF2-5B69-A324-5595B0F03949","ولم اسأمِ الراح لكنّني","تركتُ الرقيقَ بأخذ الأرقّ"],["DB85DBFA-1AA6-5233-95BD-6DE3946CEAFC","سقى بقعة الكرخ من ملعبٍ","ملث القطار مُديم الغَدَق"],["DD7C3F68-8EA3-57F4-8581-03F9613DC9CF","سكوب يحاكي بتسكابِه","غُروب السواقي اذ ما اندفق"],["C5D5500C-9E2E-55D6-BADE-C68384961D38","فلي عندها لا درتْ عُذّلي","فتاةٌ تضيء ضياء الفلق"],["5E477067-4BB4-55AE-B95F-FA0D4668DB9F","على انها لم تنلني سِوى","شهيّ المقّبل والمُعتنَق"],["631397F4-7C6A-52CB-B352-AF9FEC28A5B7","وكنّا رضيعي لبان الهوى","لنا كلُّ ما راق منه ورَق"],["172377F3-8496-5445-9CCF-AE705BF78170","ومذ جاء حق الحجى بالمشيب","وكان الصبا باطلاً قد زهق"],["C03C01FF-CDB0-5D53-A3D5-082F66F44C1C","لَوتْ جيدَها والهوى عاكِف","وذلك باقٍ بقاء الرَمَق"],["2764A8D3-C7B1-5AF2-B1C5-E9AEB9AA5655","ومذ فلق الشَّيب قد حفّ بي","تلَتْ قُل اعوذ بربّ الفلق"]]},"9476BFED-F1E8-5086-B2CC-0FB2BECDF797":{"t":"حادي الضعون","p":224,"s":"حادي الضعون","r":"477791","v":[["F8805A66-193C-518F-B873-7859374222C9","من نازح يحدو العراقَ ضعونهُ","قلب سرى لَّما اهاج شجونه"],["63F2107F-B03E-5F6C-8008-E74B4671A232","ومودعٍ للركبِ وَدَّ بانهُ","لو قد اسالَ مع الدموع عيونه"],["172CFCFD-B8C6-545D-BE20-A25BE511BBC5","لم تقطعَ الاظعان مِيلاً في السّرُى","الا وكحَّل بالسهادِ جفونه"],["77868BA0-C03B-59B0-B22A-31CEE5610562","قطعت بهم سهل الغميم وحزنه","فسقى الغميم سهوله وحزونه"],["553D2A94-FF8E-5A08-A84B-01E5517A0D3D","مِن كل اوطف ماتغنىَّ رعدهُ","الا وارخص بالدموعِ شؤونه"],["C8858B11-2DBE-5A58-90DE-CCDFD829ABE4","فترى الدموع تخاله بحراً طَمى","وترى الحُمول تخالهن سفينه"],["6622F588-D886-5EF3-8045-50F27A825778","وذكرت في ذي البان ميس قدودهم","فغدوت من شغَف اضمَّ غصونه"],["4DED268E-3D18-5F8F-9AC4-189BC79A1841","قالوا اشابَ البينُ مِفرق رأسه","صدَقوا ولكنَ قد اشابَ عيوْنه"],["9648C2AA-EE40-51F4-8A37-FAF6A9C1AD53","ياقلبُ حسبُك بالغرام رهينةً","شطَّ الغريم وما قضاكَ ديونه"],["3AA1766F-48B2-5220-9206-C787500DCD72","لم ينُسني عنه السرور بعودتي","ان سرّ من خلق الهوى محزونه"],["859C6A69-4B3F-58CF-AB91-0707B60F30C5","كلا ولا النكبات تطرق ساحتي","اذ ليس غادي القلب الا دونه"],["4CC33E70-0EB8-5258-892A-AD69A44E7E85","وكأنني من حيّ قومي سامرٌ","حَسب النقا بالاجرعينَ حجونه"],["81422D9F-4FCB-5031-A5E3-4A7549491692","فلأ نهكن القلبَ من حسراتهِ","يوم التَّرحُل او يجنَ جُنونه"],["B57DDD5B-5B5E-5FC6-8A9D-DB58F8A76434","ما عاطشٌ اورى الاوامُ بقلبه","لَهَباً وقد شرب الاوام عُيونه"],["D0936882-4F9D-5A1E-A300-EFC35DBE5978","حتى اذا وجد المعينُ بقربه","وجد الرُّكيَّ وقد اضلّ معينه"],["D9DE38CA-1DCF-5358-A6CB-6A5DCDB95966","فغدى يعضُ على الا ناملُ حسرة","نَدَماً ويصفِق بالشمال يمينه"],["429FB668-E7F0-542E-B8B7-54CABC7E3A16","وغدى يكذبُ بالحياة لنفسه","لَّما حدى حادي الضُعون ضُعونه"]]},"B6349065-CC52-54CE-B87B-AF685C5DFA5C":{"t":"سائق العيس","p":224,"s":"سائق العيس","r":"477789","v":[["5BF5927C-758B-546F-AE79-2D5BE3E9AF84","سائقَ العيس هَلْ تُريح الرِكابا","حيثُ رَبعي أُمَيمَة و رَبابا"],["FF3F266F-AAF6-579B-8E9C-895B61514982","فلتلك الرسوم تحكي خطوطاً","ولتلك الديار تحكي الكِتابا"],["0AB59A15-D5F2-56B2-A398-CD04B6F31ED2","علَّنا ان نبِلٌ حَرٌ غليل","زادَ بالبَينِ حُرقةً وألتهابا"],["8C8820A2-B30B-5F2F-A15A-1AD076865B3C","حيثُ تغدو مدامعي كقطارٍ","وجفوني تروح تحكي السحابا"],["AE2FE321-3021-5BEF-8FAE-E1B540E8B860","سائلاً والمجيب سائل دمعي","هل ترى ويك سائل قد اجابا"],["722B8B71-EFB2-5264-8EB4-9782828ED5A9","مَن عذيري من العذول سحيرا","اذ رأى الدمع ليس يفنى إنصِبابا"],["173989C2-1810-54D2-A130-F707040F2E47","كيفَ أصغي لِعاذلٍ لَستُ أدري","خطأً قال في الهوى أمْ صوابا"],["4A5DF36C-4265-57CB-8CA8-9475E1BFFBF0","ليس يرجو بذاك قرب حبيب","كيف ترجو من الحبيب إقتِرابا"],["D95C513C-C1A7-5A9D-9CA6-3D5EAF22BCF5","سلبَ القلب طرفه إذ رَماني","سهم عشقٍ مسدداً فأصابا"],["4F041A49-BCC4-5BDD-BDF6-11605BE2E4DF","لا تلوماه سالباً ولتلوما","اظلعي حيث أمكنَتهُ إستلابا"],["40A54BA4-4C67-5480-999A-A6B85612844E","قد اصيب الفؤاد بالعشق لَّما","خفت للعين اذ رنت أن تُصابا"],["2FBDB1F0-2BC8-563C-90E3-0917D5CAF413","اين تلك القباب من ارض نجدٍ","أترى البين حلّ تلك القبابا"],["BD17A2DD-C265-5065-A44A-D1F60BEB1AA5","لك في الحيّ نظرة لمهاتٍ","راهب الدير لو رآها تصابى"],["2682A1CA-601F-5668-8E5D-539E8AA25868","لو رأى الغصن قدَّها ما تثنٌى","حين تهتزّ نشوة وشبابا"]]},"CAD5E5BC-653A-5684-BC74-73366B5ABBB9":{"t":"شمسُ الحُميٌا","p":224,"s":"شمس الحميا","r":"477785","v":[["4732FFB7-2F1A-5454-BFCF-8ACF6EDA927F","شمس الحمياّ تجلتْ في يد الساقي","فشعَّ ضوء سَناها بين آفاق"],["9A77EC7E-4FDE-531F-ABD9-556158443492","سترتها بفمي كي لا تنمّ بنا","فأججتْ شُعلةً مابينَ آماقي"],["02AB08FE-75F1-5C15-B66B-E5E719039592","تشدو أباريقها بالسكب مفصحة","يشرى السليم فهذي رقية الراقي"],["DCF8D510-5BDB-5DB4-AE15-4E65219CC664","خذها كواكب أكوابٍيشعشعُها","ما يحتسي الطرف من أقداح أحداق"],["666A4DCD-B6C0-5A9A-B9A0-0604CF0BE64D","تسعى اليك بها خود مراشفها","أهنى وأعذب ممّا في يد الساقي"],["DEBC3DF9-74E5-59C7-87B8-0762D8E8D397","ماشاك عقرب صدغيها مُقبٌلها","الا ومن ريقها يُرقى بدرياق"],["5BE664A2-1341-5264-B4C3-BF52E04A700F","مسودَّة الجعد لو لا ضوء غرّتها","لَما هَدَتني إليها نارَ أشواقي"],["2E16A132-FD25-5B49-B3D3-36FB8142B20A","يهدي اليك بمرآها ومسمعها","جمال يوسف في الحان اسحاق"],["09F66884-5087-5C03-ADC4-DC09D4949FB4","هيفآء لو لا كثيب من روادفها","فرَّ النطاقان من نزع وإقلاق"],["ABD1F3E8-EBF8-5C77-A823-E438EEF6674F","ماهَّبت الريح الا آستمسكتْ بيديْ","تِربٍ لها وإعتراها فضلُ إشفاق"],["0E468E71-0378-5F1C-9B19-EFF042380B9D","قالت خذي بيدي فالريح قد خفقتْ","تهدُّني بنسيم هبَّ خفٌاق"],["24A586CD-44B5-5345-B445-6C974AA60EBC","جال الوشاح بكشحيها متى نهضتْ","تسعى اليك وضاق الحجلُ بالساق"],["79C6CDA8-E2E7-5747-A972-7FEF55C4547C","لا تلبس الوشي الاّ كي يزان بها","كما يُزان سواد الكحل بالماق"],["21D5193A-A2CE-5AAD-8EF3-46FD899BAE29","تزيد حسناً اذا ما زدتها نظراً","كالروض غبَّ رفيف القطر مهراق"],["22FF8D64-64A3-51A4-8810-F74747EF544A","تلك التي تركت جسمي بها مَرضا","وحرضت كي تذيبَ القلب أشواقي"],["5F5586B5-FFD8-54E0-AEF8-FDAE7B9E815B","وآستجمعتْ واثقات الحسن فآجتمتْ","لها المودّة من قلبي واعلاقي"],["3508D105-98AB-5270-8B98-887BCFCCC456","ضممتُها فتثنٌتْ وهي قائلة","بالغنج رفقا لقد قصَّمتَ اطواقي"],["52637B53-DDE5-5537-A32D-15814D198E0A","رقتْ محاسنها حتى لو آتْخذتْ","عرشا بناظرتي لم تدر آماقي"],["4996F6B3-613D-58EE-A709-990960ECEB3B","وبتُ أسقي وباتت وهي ساقيتي","نحسو الكؤس ونسقي الارض بالباقي"],["340DF45C-76CF-5D1F-AE0A-169A954CB1F7","في مربع نسجتْ ايدي الربيع له","مطارف الزهر من رَندٍ وطبَّاق"],["3FFA5A07-F86D-512E-B164-5E3DBB89A866","تشدو العنادل في ارجائه طربا","والغصن يسحب فيه ذيل اوراق"],["BDDD5077-7332-5815-9A1E-F07D21B7495E","كأنما النرجس الغضُّ الجنيّ به","نواظر خُلقتْ من غير أحداق"],["E925C5AF-BAFB-54E1-A176-4C54D70FB6C7","والنهر مطٌرِدُ والزهر منعكِسُ","والناي ما بَينَ تقييدٍ وإطلاقِ"]]},"F8078354-779A-5FAC-854B-0E676841A5AF":{"t":"في صباه","p":224,"s":"في صباه","r":"477788","v":[["B229828E-55CE-504D-8D6D-7DD27FDF31DF","هَلْ إنعَقدَت أكاليل الشِعور","على غيرِالأهِلٌةِ والبِدورِ"],["5195B1FA-416D-562B-9611-4D2AD0CCA7F4","وهَلْ سَفِرَتْ براقِعُ مِنْ شقِيقٍ","عَلى الوَجناتُ مِنْ نارٍونور"],["B1606602-F516-5E41-991E-FD76F8F48BDB","خدودٌ بالجمالِ مورداٌتُ","والحاظ فترنَ عن الفتورِ"],["E97D4CAB-24A0-5565-8B6D-0BD6C86127EF","وأجسامُ تَكادُ تَذوبُ لُطفاً","باكبادٍ تقِدٌ مِنَ الصخورِ"],["ECAB2698-C2A8-5373-A838-A4B723AB61BE","وانسُ من ظباء الحي تعدوا","أنيساتُ المجالس غيرَ نورِ"],["087E3400-8A7D-56DE-8833-0E990D56C004","تبرٌجها الملاعِبُ والمَلاهي","مفضضٌة المَباسم والنحورِ"],["89903376-FEB8-5FE2-BF18-0445A0ABD03F","فما ادري ثغوراً من عِقودٍ","تُفَصٌل أم عِقوداً مِنْ ثغُورِ"],["99FB3C9F-9E84-5F15-99CD-18A055478EA2","معاطفَهنٌ أغصان المَغاني","وأوجُهُهُنٌ أقمارَ الخِدورِ"],["ACCF058C-B9F1-59BE-9B52-F225CD6DE9B2","جُزِينَ الرمل في أحقافِ رَملٍ","تَكاد تَسِلٌ أثناء الخِصورِ"],["35095DAE-0BAF-51BB-956C-32B68C2BA769","وارَّجن الحمى باريج مِسكٍ","ركَبْنَ حقاقَه فوقَ الصِدور"],["57F18417-C074-5746-B284-2DD025E2683B","مراشِفَهُنٌ والمُقَل السَواهي","تُريكَ الحُسنَ في جورٍ وجور"],["B213AE28-1B92-56AE-AF74-23FCA424686B","وفي وجناتهن رياضُ حُسنٍ","واقمارٌ فمن نور ونور"],["A03BB7A9-DFF6-5AA2-8827-CB2EEE895B85","فلم نعرف محولاً في ربوع","ولم ندرك سراراً في شهور"],["1039A0C2-08D0-509A-B812-D59E36BE991F","ومخطفة الحشا تختال تيهاً","كخوط البان في كفٌي هَصور"],["D5320DD5-8952-5B2A-93E2-63C72B4DB27A","إذا بَرَزت أذالَتْ ليل شِعرٍ","فتبرز بالستورِ مِنَ الستور"],["003303AE-1C37-5A1A-8013-0A3872D95A87","ولو سَفِرَت لَجَلٌلَها سناها","فتحجب بالسفورِ عَن السِفور"],["DA24E6FF-BC6F-575E-B17A-B5766B1C5146","ترى نظري اذا طلَعَتْ إليها","على صدقِ الهَوى نظَر الغيور"],["B50D3B79-9D41-5797-8F7C-A657BB76B462","تُعاطيني على نَغم الأغاني","وتشُدٌني على نَطَف الخِمور"],["DC0A89B1-414F-55AB-BE74-22BC92C4ADA2","حمياَّ عتقَّ العصَّار منها","مجدَدٌةُ البَشاشة والسِرور"],["0325BC0C-4E85-56EE-A0EC-22D1047467E2","أضَأنا في سَناها وأستَنِرنا","فما ندري العشىّ من البِكور"],["F1D6A86C-4FEB-5197-92C7-D4C49093AB22","لَقَدْ لَمَعَتْ بمُرتَبَعي فأضحى","سَواءُ طُورَ سيناءُ وطوري"],["BD12DE88-E1DB-5344-A177-201099AA8B8B","اذا نَظرَتَ نمير الماءَ قالتْ","فَغضٌ الطَرف إنٌكَ مِنْ نمير"]]},"80CBF7F5-8FEB-5D38-A27B-611C98AA779A":{"t":"ناعس الأجفان","p":224,"s":"ناعس الأجفان","r":"477790","v":[["E10555E2-4B96-5E0E-AC72-277780CD153F","حَّتام ياقلبُ وراء الملاح","تصفق من وجدك راحاً براح"],["19E414F5-82CE-5318-AE0C-3878A96E5017","كم راعك الوجدْ وكم جئتني","من مرهف الاجفان تشكو الجراح"],["1A971940-E2BB-5B0C-B423-6A92C52FB4E3","جدّ الهوى ياقلب فاجرع به","كاس حمام ما به من مزاح"],["C44F16E9-5227-5BB5-ACB3-C3D9C3BCEBE8","من حامل شكوى ضعيف الهوى","من ناعس الاجفان شاك السلاح"],["D4BF712B-ECF7-5C5E-9989-7B6AA268F4C8","ياصاحب الخصر النحيل الذي","يحكي خيالا منه بالطيف لاح"],["38E41FF1-AC53-5535-8605-4BA1813C786E","اوهى قواه الثقل من ردفه","فراح يشكو ضعفه للوشاح"],["A308F387-A34B-5841-AAFB-A57851154B6A","تفديك نفس الصب مهلا فقد","افسدت من كان حليف الصلاح"],["51A7A5F9-6D41-5A46-B69B-4B72F7C699D0","كم بت من لوعة يوم النوى","مطارحا بالنوح ذات الجناح"],["FA76CF56-A881-55D9-89A3-EED3020772CD","حتى خفى النجم وغاب الدجى","وقبلت عيني محيا الصباح"],["F75EFD4A-98C6-540F-AF5F-29CDE39F9CC6","يامدلّجا ينشر طيب الكرى","على الروابي حين يطوي البطاح"],["14C67159-880D-51D7-BD27-30BDEFF544F0","ان شمت ذاك البرق من حيهم","او شمَّ عرنينك طيب الرياح"],["2224DEC8-3796-587D-9108-88B0CAE3B0EE","فاخضع وجز في حيهم ناشدا","قلبا معنى بالثنايا اراح"],["843E9392-AC3C-5D2E-9DBD-A2FD6167BEDF","اسكره الشوق فاضحى لِقى","يحسبه الرائون نشوان راح"],["6CA5C0B7-34A4-5CB4-9053-8A108A9ED74D","يرتاع من قدٍّ تثنى ولا","يروعه في الحرب هزّ الرماح"],["53914774-E6A8-5646-894A-CF4328300544","بات اسير الوجد لم يفده","فادٍ ولا منت عليه الملاح"],["7155D7FD-1A28-56B3-9F49-367BFA5F3CD6","يقذفه الوجد بكف الجوى","ولو قضى نحبا به لاستراح"]]},"6D3E5A74-ACB1-55A1-B00E-D7C52B0C709B":{"t":"يا يوسف الحسن فيك الصب قد ليما","p":224,"s":"يا يوسف الحسن فيك الصب قد ليما","r":"477781","v":[["09236E8D-4456-525F-979D-4D807EDEA5B1","يا يوسف الحسن فيك الصب قد ليما","فأن رأوك هووا للأرض تعظيما"],["A6255E30-05A9-5614-86F2-1310BC7BA506","لُحْ كوكباً وإمشِ غُصناً والتفِتْ ريما","فأن عداكَ آسمها لم تعدك السيما"],["83BC463C-C0C7-55BA-A9BC-69404FA23021","وجه اغرّ وجيدٌ زانه جِيدُ","وقامةٌ تخجل الخطيّ تقويما"],["EDB0E475-D6C0-5F4F-950F-CE1F118A2D0E","يامن تجلّ عن التمثيل صورته","أأنتَ مثَّلتَ روح الحسن تجسيما"],["C90F449E-0725-5A64-8253-B5E67075BC47","نطقت بالشعر سحراً فيك حين بدا","هاروت طرفُكَ يُنشي السحر تعليما"],["F49E9F61-D08B-593A-BB45-C15EDFDFAC88","فلو رأتك النصارى في كنائسها","مصوراً رّبعت فيكَ الأقانيما"],["43274A24-F2F2-5EB4-A0C0-E203FF6F0924","إذا سفرتَ تولىَّ المتقيّ صنَماً","وإن نظرتَ توقىٌ الضيغمُ الريما"],["395CCD65-CD2D-537F-A8E8-483F78BE229C","مَن لي بألمي نعيمي بالعذاب به","والحبّ ان تجد التعذيب تنعيما"],["28FA0F89-F361-5B46-91DE-47330A73B4FB","لو لم تكن جنة الفردوس وجنته","لم يسقني الريق سلسالا وتنسيما"],["537A1865-86A5-5B9A-B283-9ECBE6AE8868","ألقى الوشاحَ على خِصرٍ توهمٌه","فكيف وشٌحَ بالمرئيُ موهوما"],["9EFCE028-6A7C-59CE-AD85-5D65F98A9E13","ورجَّ احقاف رملٍ في غلائلِهِ","يكاد ينقدّ عنها الكشح مهضوما"],["65BF9FED-D6AB-5DC4-A3F5-8E468093C432","ان ألٌمَالحِجل ساقيه فلا عجبٌ","فقد شكى من دقيق الدرز تأليما"],["5B526037-A4AF-5BE7-81C1-4476B5571BFB","الردف والساق رداً مشَيِهِ بهرا","والدرع منقدّة والحجل مفصوما"],["03E8C400-1F1F-5B98-B0A8-CA7D5C4F458A","في وجهه رُسمت آيات مصحفه","تُتلى ولم يخش قاريهن تأثيما"],["A12249A7-A54D-5CBB-A735-C743A9811C86","ذي نون حاجبه لو حاؤه آتصلت","في ميم مبسمه لم تعدُ حاميما"],["80872A8D-7885-5652-A8D3-D0A3F7F2E9F3","ولحن معبد يجري في تكلٌمِهِ","إنْ أدمجَ اللفظ ترقيقاً وتَرخيما"],["75A6909E-802D-560E-9083-935763D8023F","يانازلي الرمل من نجد احبكم","وان هجرتم ففيما هجركم فيما"],["A8B712C7-AC50-537D-82D2-EAEDBE5C2571","ألستُمُ انتُمُ رَيحانَ أنفسُنا","دونَ الرياحينَ مَجنيٌاً ومَشموما"],["57ABD216-46E4-5DDB-8811-C0BAA97351FF","إن ينأ شخصكم فليدنو طيفكمُ","لو أن للعين إغفاءً وتَهويما"],["A7BB97AA-6349-5090-A66F-0C5AB58FBDC2","هل توردون ظمآءً عذب منهلِكُم","أمْ تصدرون الاماني حِوٌماً هِيما"],["6BC789F7-6EC5-5FDF-B5B0-23E888C38FCB","لي بينكم لا أطال الله بينكمُ","غضيض طرفٍ يردّ الطرف مسجوما"],["F69A37EC-D06C-51C0-B37A-F1F7B5E5B66C","انا رضيع هواه منذ نشأتِهِ","ونشأتي لم تردني عنه مفطوما"],["1A59B0CD-622C-54B2-9FB0-034EBACBBFCE","ما حلتُ عنه ولا عن عهد صبوته","وان أطال الجفا عزماً وتَصميما"],["E9AD5B59-471B-50E7-B528-FCEAC8CB93EB","حرمَّت وصلي كما حللتَ سفكَ دَمي","صدقتُ شرعك تحليلا وتَحريما"],["FF9D527D-483D-52FC-BA4E-0CE01CDA7992","ياجائراً وعلى عَمْدٍ أحَكُمٌهُ","أعدِلْ وجرْ بالذي ولاّك تحكيما"],["8FB3D6C5-C7EB-5D16-B43A-E6ECF06972A1","لك الصبا والجوى لي والعُلى لعَلي","وقل (لهادي) الهدى طرداً وتقسيما"]]},"A20A6923-2EC5-59F9-A2BB-8F80798275E1":{"t":"ياغزال الكرخ","p":224,"s":"ياغزال الكرخ","r":"477784","v":[["9211F73D-8F56-528D-AD7C-9BAB4187E7C5","هزَّت الزورآء اعطاف الصَفا","فصفت لي رغدةُ العيش الهَني"],["4683DA8C-A604-51FC-B5DF-12066C6F56BF","فارعَ مِن عهدك ما قد سَلفا","وأعِدْ يافتنةَ المُفتَتِن"],["53E11BC6-53C2-5DFD-AAFB-72312E511B06","عارض الشمسَ جبيناً بجبين","لنرى أيكما أسنى سَنا"],["E95FE9C2-A981-5CE2-BC9A-6F11CCAFD574","وآسب في عطفك عطفَ الياسمين","وآنثن غصناً إذا الغصنُ انثنى"],["C5A06ACE-591B-55CE-81D8-39D55E438A20","حبَّذا لو قلبُك القاسي يلِين","انما عطفك كان الأليَنا"],["3796F2C9-A3A7-5147-9ADB-1061EDEB346B","فانعطفْ أنت اذا ما انعطفا","قدُّك المهزوز هزَّ الغُصنا"],["95D22610-E929-5654-9F6C-0616406DF033","انّ في خدّك روضاً شغفا","مقلة الرآئي وكفَّ المجتنى"],["C6FBC85B-08C1-5FC3-B630-CA6B9997A1B9","ياغزال الكرخ واوجدي عليك","كاد سري فيك أن يُنتَهكا"],["92C6E26E-87FB-52F5-AFBB-F412394D36D4","هذه الصهبآء والكأسُ لديك","وغرامي في هواك إحتَنكا"],["A72EFD8B-2A3B-5B3B-A308-5E2D863E94F0","فآسقني كأساً وخُذْ كأساً اليك","فلذيذُ العيش أن نشتركا"],["2680A5DC-A452-52C1-B598-70C9F1A18B63","إترع الأقداح راحاً قرقفاً","وآسقني وآشرب او آشرب واسقني"],["01D7DBD7-274E-5F2D-9FE8-302B7C9A564A","فلمُاك العذبُ أحلى مرشفا","من دم الكرم ومآء المُزن"],["D298D825-ECDA-5A88-8D9B-5A4583A4A4FB","مِن طُلا فيها الندىُّ ابتسما","إذ سرتْ تأرجُ في نشر العبير"],["D57F97DE-21B8-5EEC-8C08-571E9B910C49","أطلعتْ شمس سناها أنجما","مِن حباب ولها البدرُ مُدير"],["30D66B67-8EC3-5994-A1A8-82E0F665BAA3","والسما أرضٌ أو الأرض السما","إذ غدتْ تلك كهذي تستنير"],["B2E3BBE4-54B4-56FE-9CA6-BEC176717BDE","في ربوع ألبستها مطرفا","أنملُ الزهر من الوشي السنى"],["CB452E9B-8B4A-524B-B4F4-B0E5985E72C7","وحمامُ البُشر فيها هَتَفا","مُعربا في لحنهِ لم يلحنِ"],["95F69B1D-9C5A-54AA-80A4-C4C41A69657F","وُحميا الكاس لما صفقَتْ","أخذتْ تجلى عروساً بيدَيه"],["0219B488-4A1A-5431-842C-B7D108A15A2F","خلتها في ثغره قَد عُتقتْ","زمناً واعتُصرتْ من وجنتيه"],["7778811E-CA6E-5056-B0DA-49082676D5BF","مِن بروق بالثنايا ائتلَقَتْ","في عقيق الجزع أعنى شفتيه"],["93C684F5-9BBB-5AA5-844E-4F00ECB234F7","كشف سترَ الدجى فانكشفا","وانجلى الأفق بصبح بينّ"],["A17F1F11-9059-535F-ACCF-031000763607","اكسبتنا إذ سقتنا نطفا","خفة الطبع وثقل الألسن"],["AF665042-78C8-5A9E-AC78-79FD7012C6B6","أيها العذال كفّوا عَذلَكُم","بالهوى العذري عذري اتضحا"],["66A33415-43D9-545F-B07A-81561C02F135","وامنحوا يا اهل نجد وصلكم","مستهاما يتشكى البرحا"],["3C43ACE8-2044-5D19-BC70-8C99C4A2F52E","واذكروني مثل ذكراي لكم","ربّ ذكرى قرّبتْ من نزحا"],["0FC53679-E0BC-5A67-9135-F1E7E17306F4","الوفا ياعرب يا اهل الوفا","لا تخونوا عهد مَن لم يَخُنِ"],["F0E1CECC-EA77-50E4-81A1-B063B86CF7D2","لا تقولوا صدّ عنا وجفا","عندكم روحي وعندي بدَني"]]},"5F919FE3-BDE8-50C6-955A-F79C17F88594":{"t":"يامُعير الغصن","p":224,"s":"يامعير الغصن","r":"477783","v":[["3FA03C19-5E81-5CF3-B5CA-72F8B3CE15DD","يامُعير الغصن قداً اهيفا","ومعير الريم مرضى الحدق"],["7F76C6C8-4E45-5E50-8FEA-80F8B8568A33","هل الى وصلك من بعد الجفا","بلغلةٌ تنعشُ باقي رمقي"],["3B29B8A1-36CD-5949-9827-1EDB69B03633","همتُ في حبك والحبّ هيام","فلي اللومُ ولا لومٍ عليكْ"],["219E9819-E18B-558D-B7C2-06D23A3138C5","وتعاصيتُ على داعي الغرام","فوقعتُ اليوم طوعاً في يديك"],["3DF596F3-13BB-5996-931A-49E804B37C10","كلّما رمتُ أعاصيكَ الزمام","جذبتني سورة الحبّ اليك"],["04127FD8-7CE9-5346-9367-A4D4BBD69B24","وإذا جال فؤادي وقفا","حول مغناك فلم ينطلق"],["C920F6AE-8DC1-58CB-939B-7AC29DEC9556","وعلى نادي هواك اعتكفا","فغدى مأمنه في فرق"],["06F16310-8E2B-544E-B0C9-6C78ACB15150","أنت ياذا الدلّ والحسن البديع","لي بثّ لْك لو تسمعه"],["477FD01F-8003-549F-B69A-642699625AFB","بنتَ عن جنبي وقد كنت الضجيع","فنبا بعدك بي مضجعه"],["6FF22BDC-7807-5067-8040-35FFC10B8738","قد وصلت الحبل في الفي شفيع","وبلا ذنب بدا تقطعه"],["DCABC921-1DB5-53B7-888D-A9FC4CB7E863","انّ من راع فؤادي بالجفا","كلّف القلب بما لم يطق"],["4DA824B6-C363-5D45-AF73-E0ACF2071FF3","آه من ذي قوة قد ضعُفا","بالهوى ليت الهوى لم يُخلق"],["38A02064-F471-5182-9C83-E8DF63345E29","بتُ من حبّك ذا طرف قريح","محرقي وجدي ودمعي غامري"],["308AB726-8222-5809-B32E-E49EE229E9DA","خضل الأردان ذا قلب جريح","أتحرَّى كل برق حاجري"],["EFC2C5F0-C480-5527-9850-D9902D3B9F8C","مالقى القيسان قيس بن ذريح","ما ألاقيه وقيس العامري"],["0B1BCC5F-B4EA-5867-8A0C-8AB006CE741F","لا ولا عروة فيما سلفا","بعض ما لاقيتُ في الحب لقي"],["E6C054AB-B332-569D-9CD7-5126B5E8D742","ليت دين الحبّ لمّا خُلقا","لم تقم بيعته في عنقي"],["FD768862-26AE-56D1-B657-45E7CF879E25","اصبحتْ روحي في مثل الخلال","مذ تلاشى الجسم في علّته"],["1DB328A9-9E19-5337-9A6E-701FC9F3CF3B","وانا اصبحت عن شخصي مثال","بارزاً للناس في صورته"],["F6803B70-5AD8-5396-8DE3-64D9ECB3E125","مَن رآني خالتي طيف الخيال","وآعتراه الشكُ في يقظته"],["1952EBFD-B072-5224-A83C-F926F1B5DF50","اثرَ النمل على صُمّ الصفا","تركتْ مقلته من رمقي"],["2DBEF927-46A7-5649-96B7-895BDDFB78A1","لستُ الحاه على ما اتلفا","انّما اشكره في ما بقي"],["5D1BF410-BED1-5C73-9004-321AECFA9312","خلق الرحمن جسمي والضنا","ناظري والدمع قلبي والوجيب"],["EC0D0BBA-D568-5A4A-9A53-B12C6D649423","مقلتي والسهد روحي والعنا","اضلعي والوجد لبّي واللهيب"],["ACE40EF3-D665-5716-9C9D-44F622E2A991","سبعة في سبعة قد قرُنا","ان هذا لهو الخلق العجيب"],["86354847-CCC6-575B-BB6D-6D88FC00F3B9","وعلى الوفُق جرى ما آختلفا","دأبُها جارٍ بهذا النّسق"],["1890CEB6-6BFF-5AED-A3BB-3D904889A6E5","حسبي الله جسيباً وكفى","من تباريح أهاجتْ حُرقي"],["A2EB4313-E221-51FE-A40A-2193B913D903","فآسقني كاساً وخذ كاساً اليك","فلذيذ العيش ان نشتركا"],["87AED2B4-B4C6-5191-938C-DCC8BEC54493","وإذا جدتَ بها من شفيتك","فآسقنيها وخذ الأولى لكا"],["5927E8A4-3ED3-5969-A7CF-162669C41085","او فحسبي خمرة من ناظريك","أذهبتْ نسكي وأضحتْ منسكا"],["5EB3584F-BE34-56E1-BED2-23EA269D68D6","وآغتنم صفوك قبل الرنق","ان صفا العيش فما كان الصفا"]]}}}