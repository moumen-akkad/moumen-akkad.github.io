{"v":1,"poems":{"24E13D58-A8F2-5473-8C36-6F0710085D91":{"t":"ولا تعطِ ودَّكَ غيرَ الثقاتِ","p":107,"s":"ولا تعط ودك غير الثقات","r":"464617","v":[["6B608005-2CFB-5D9B-955D-C7671889BF7C","ولا تعطِ ودَّكَ غيرَ الثقاتِ","وصفو المودة إلا لبيبا"],["EF4A743D-BCB8-58A9-9732-0385C1EF5412","إذَا ما الْفَتَى كانَ ذَا مُسْكَةٍ","فإنَّ لِحاليهِ مِنْهَ طَبيبا"],["7BE8FF47-7619-57CF-A694-7AC8819FE8D8","فبعضَ الموّدَةِ عند الاخاءِ","وَبَعْضُ العداوة كي تَسْتَنيبا"],["A0D899E1-E84C-575A-AB11-7CEC6DE0DE1F","فإنَّ المُحِبَّ يَكُونُ الْبِغيضَ","وَإنَّ الْبِغيضَ يَكُونُ الحبيبا"]]},"C9C0D0E7-B618-5CE4-AF2F-B79D9DCC5F42":{"t":"ولستُ أرجو انتصافاً منكَ ما ذرفتْ","p":107,"s":"ولست أرجو انتصافا منك ما ذرفت","r":"464994","v":[["8F8A2AC2-B75A-5F4F-963F-E0EB9B74E08D","ولستُ أرجو انتصافاً منكَ ما ذرفتْ","عَيني دُموعاً، وأَنْتَ الخَصْمُ والحَكَمُ"]]},"A963C357-6519-5E68-924C-9DF5C1C73F63":{"t":"ولستُ بقائلٍ قذعاً ولكنْ","p":107,"s":"ولست بقائل قذعا ولكن","r":"464775","v":[["12B296E7-4D4A-5E6F-8C04-A72218F1F2C8","ولستُ بقائلٍ قذعاً، ولكنْ","لأمرٍ ماتعبَّدكَ العبيدُ!"]]},"4C48C47C-A905-5474-BAE8-F19B6DCEBDF7":{"t":"ولمَّا وَرَدْنا ماءَ بِيشةَ لَم يَكُنْ","p":107,"s":"ولما وردنا ماء بيشة لم يكن","r":"464645","v":[["CE959D9E-E0FF-5211-B358-9C646D9D8592","ولمَّا وَرَدْنا ماءَ بِيشةَ لَم يَكُنْ","تَكَدَّرَ إِلاَّ مِنْ دِمَاءِ التَّرائِبِ"],["60AE52B6-1893-5360-B8C6-193D6F2EDA37","سقينا عتاقَ الخيلِ منه، فلم تذقْ","سِوَى مَذْقَةٍ لم تَروِ غُلَّةَ شارِب"]]},"CA048D0E-4667-5859-BE6F-25AF95705EEE":{"t":"ولمّا أبى إلاّ جماحاً فؤادهُ","p":107,"s":"ولما أبى إلا جماحا فؤاده","r":"464734","v":[["3D57A473-F5BE-589D-83C6-F5E6E361D62B","ولمّا أبى إلاّ جماحاً فؤادهُ","ولمْ يسلُ عنْ ليلى بمالٍ ولا أهلِ"],["B38EE07A-7679-5C21-9E6A-7C92C0338B95","تَسلَّى بأُخرَى غيرِها، فإذا التي","تَسلَّى بها تُغْري بِلَيْلَى وَلاَ تُسْلي"]]},"5CB42C81-9BE3-5E20-900A-76265DA561C9":{"t":"ولمّا رأَيتُ السَّيفَ جلَّلَ جَعفَراً","p":107,"s":"ولما رأيت السيف جلل جعفرا","r":"464784","v":[["422828F2-7212-5615-9D25-986770F45690","ولمّا رأَيتُ السَّيفَ جلَّلَ جَعفَراً","ونادى منادٍ للخليفةِ في يحيى"],["7DCC9BFF-8AD9-5AEA-BDBA-4AC1C06B1EF9","بكيت على الدنيا، وأيقنتُ أنما","قُصارَى الفتَى فيها مُفارقةُ الدُّنيا"]]},"A5596A16-DFBB-57EA-93F9-7F9648300A5A":{"t":"وما تاهَ على الناسِ","p":107,"s":"وما تاه على الناس","r":"464612","v":[["B23C38D5-A528-50D5-91EA-7495A265EED0","وما تاهَ على الناسِ","شريفٌ يا أَبا سَعْدِ"],["E5B317BB-35D1-5394-8C73-E721814340CC","فتهْ ما شئتَ إذ كنتَ","بلا أصلٍ ولا جدِّ"],["D2036951-7BD0-55B2-9202-42BD801E08B1","وإِذْ حَظُّكَ في الأشبا","هِ بينَ الحُرِّ والعبدِ"],["5BF06606-5D99-5F19-9597-2D7D28F49127","وإذ قاذفكَ المفحـ","شُ في أمنٍ من الحدِّ"]]},"D33F3E29-1956-5154-BE68-28A77487F85F":{"t":"ومغنٍّ إنْ تغنّى","p":107,"s":"ومغن إن تغنى","r":"465002","v":[["99AA26F5-2C19-500C-A2FE-75A02761004C","ومغنٍّ إنْ تغنّى","أَوْرَثَ النَّدمانَ همّا"],["6F2CC6E8-C680-5FBE-97D1-E3FD9E14D4B2","أحسنُ الأقوامِ حالاً","فيهِ مَنْ كانَ أَصَمّا"]]},"7B6B7707-1AAE-5C67-A458-B997D072F5AB":{"t":"ومنَ الناسِ منْ يحبكِ حباً","p":107,"s":"ومن الناس من يحبك حبا","r":"464837","v":[["DA67FCAF-5C1E-5059-9751-956E2AF0803C","ومنَ الناسِ منْ يحبكِ حباً","ظاهِرَ الوُدِّ ليسَ بالتَّقْصيرِ"],["7D7D27DF-0516-573C-886B-674EDF890573","وإذا ما خبرتهُ شهدَ الطر","فُ على حبهِ بما في الضميرِ"],["913962A8-1EE5-5DF9-AAD7-A49CA1E5AB12","وإذا مَا بَحَثْتَ قُلتَ: بِهذا","ثِقةٌ لي ورأسُ مالٍ كبيرِ"],["C5787539-50FB-581A-B61F-4573B48F36C7","فإِذَا ما سَألتَهُ رُبْعَ فَلْسٍ","الْحَقَ الوُدَّ باللَّطِيفِ الخَبِيرِ"]]},"0328D305-2B40-5601-B652-BAF7FC1C5428":{"t":"ومَا المرء إِلاَّ الأَصغَرانِ: لِسانُهُ","p":107,"s":"وما المرء إلا الأصغران: لسانه","r":"464669","v":[["4D2CAA9A-5867-5BF9-804C-039EA3268B31","ومَا المرء إِلاَّ الأَصغَرانِ: لِسانُهُ","ومَعقولُهُ، والجسمُ خَلْقٌ مُصوَّرُ"],["81038AE6-4403-564D-9269-77663AC9415F","وإِنْ طُرَّةٌ راقَتْكَ فانظرْ فرُبَّما","أَمرَّ مَذاقُ العُودِ والعُودُ أَخضَرُ"]]},"47282FE6-9971-575E-A449-09F8D23138F0":{"t":"ونُبِئتُ كلْباً مِن كلاَبٍ يَسُّبُني","p":107,"s":"ونبئت كلبا من كلاب يسبني","r":"464707","v":[["6CF2C7E5-550C-50F3-A281-ACBD89D878DA","ونُبِئتُ كلْباً مِن كلاَبٍ يَسُّبُني","ومرُّ كلابٍ يقطعُ الصَّلَواتِ"],["637827CD-235F-5F7D-8A12-1C3CC3A51406","فإنْ أَنا لم أُعلِمْ كِلاَباً بِأَنَّها","كلابٌ، وأني باسل النقماتِ"],["90F21A00-098E-5E91-96D6-CDEF3898B48C","فَكَانَ إِذنْ مِن قيسِ عَيلانِ والدي","وكانتَ إذن أمي من الحبطاتِ"]]},"F1CF4401-C290-5FE8-B457-7191F2764F01":{"t":"وَمَا مِن دُونِ عِرضِكَ للقَوافي","p":107,"s":"وما من دون عرضك للقوافي","r":"464728","v":[["941EA0BA-E634-556A-9685-CF62A1A27153","وَمَا مِن دُونِ عِرضِكَ للقَوافي","شبا قفلٍ يشدُّ ولا رتاجِ"],["69F5CEC2-C476-5F3F-8D95-8D4DFF601EA8","لَحجْتَ فَعادَ ذَاكَ عَلَيكَ ذَمّاً","وأَسْبابُ البَلاءِ مِنَ اللَّجَاجِ"]]},"B1719C8A-433D-51AF-9B11-849344FA6CB6":{"t":"وَمَيثاءَ خضراءَ زَرِبيَّةٍ","p":107,"s":"وميثاء خضراء زربية","r":"465034","v":[["731CC956-344C-592C-8049-3D1191A26DD5","وَمَيثاءَ خضراءَ زَرِبيَّةٍ","بهَا النَّوْرُ يَزْهرُ مِنْ كلِّ فَنْ"],["4D45DFE6-173C-54A5-8AD7-E26D441D88E9","ضَحُوكاً، إِذَا لاعَتْهُ الرِّياحُ","تأودَ كالشاربِ المرجحنْ"],["91461C7A-BA62-5DE9-BE10-4DF56DA594F5","فشبَّهَ صحبيَ نوّارها","بِديباجِ كِسرَى وَعَصْبِ اليَمَنْ"],["FBE1C442-C64F-55FA-9530-A31050BCB004","فقلتُ: بعدتمْ، ولكنني","أشبِّههُ بجنابِ الحسنْ"],["1CA9DB35-0C96-5056-AA0B-9030C15EDAC3","فتًى لا يَرَى المَالَ إِلاَّ العَطاءَ","ولا الكنزَ إلاّ اعتقادَ المننْ"]]},"2761B445-5E5B-5575-B7D4-95526030A542":{"t":"وَوَجْهٍ كَوَجْهِ الغُولِ فيهِ سَمَاجَةٌ","p":107,"s":"ووجه كوجه الغول فيه سماجة","r":"464857","v":[["0D742867-DD0A-531A-AA69-994D1CEB4177","وَوَجْهٍ كَوَجْهِ الغُولِ فيهِ سَمَاجَةٌ","مفوهةٌ شوهاءُ ذاتُ مشافرِ"]]},"9E939403-7A00-5453-9C3D-601C9F310C93":{"t":"يا آل بسام في المخازي","p":107,"s":"يا آل بسام في المخازي","r":"464974","v":[["4CC7CF45-1EDD-59DF-A75A-9F09E3E68E84","يا آل بسام في المخازي،","وعابِسي الوَجْهِ في السُّؤَالِ"],["DD7F7211-E99A-53C2-8732-2451D1D0EAE5","حواجِبٌ كالحِبالِ سُودٌ","إلى عثانين كالمخالي"],["2665D121-81DA-5FE3-82DF-38443AB85634","وأوجهٌ جَهْمةٌ غِلاظٌ","عطلٌ منَ الحسنِ والجمالِ"]]},"67594A95-7A56-5748-8191-7490994BCE13":{"t":"يا أَبا سعدِ قَوصَرَهْ","p":107,"s":"يا أبا سعد قوصره","r":"464859","v":[["3973106C-4E50-5910-BCDC-4E2FF60F99CB","يا أَبا سعدِ قَوصَرَهْ","زانِي الأُختِ وَالمَرَهْ"],["EF498B08-C601-5169-95A2-61C98EDB1240","لَو تَراهُ مجّبِياً","خلتهُ عقدَ قنطرهُ"],["27B64ED9-2B07-521E-9711-FD0C79EC66E1","أَو ترَى الأ.. في استِهِ","قلتَ: ساقٌ بمقطرهْ"],["842EEAC8-8537-5026-93C9-A5F752DAFA36","أَو تراهُ يَلوكُهُ","قلتَ: زبدُُ بسكرَّهْ"],["2BE0AC4F-452A-5D02-BE12-0372EE14A35D","أو تَراهُ يَشُمُّهُ","قلتَ: مِسْكٌ بعَنْبَرهْ"],["4C2352A5-A406-5F03-8BC2-F11E2FDC4665","أجَّجَ العبدُ نارهُ","وهو للنارِ كندرهْ"],["9D551FAE-6D02-502C-B321-1DF122A97D3B","أَبَدَ الدَّهْرِ خَلْفَهُ","فارسٌ في المؤخَّرهْ!"]]},"7E10E580-E509-57D3-BF8A-1377DA822FCF":{"t":"يا حَسرةً تَتَردَّدْ","p":107,"s":"يا حسرة تتردد","r":"464592","v":[["C87FEED9-824B-57CB-B268-94E2461664E1","يا حَسرةً تَتَردَّدْ","وعبرةً ليسَ تنفدْ"],["50AF111C-4A40-584D-9AA6-062F8F68CBA7","علَى عليِّ بنِ مُوسَى","بنِ جعفرِ بنِ مَحَمَّدْ"],["839BD458-EBF1-5937-8299-81E440DB9C17","قضى غريباً بطوسٍ","مثلَ الحسامِ المجرَّدِ"]]},"0C3A815B-D767-51A7-8A9E-2AA267C6F5F3":{"t":"يا رَبْعُ أيْنَ تَوَجَّهَتْ سَلْمَى","p":107,"s":"يا ربع أين توجهت سلمى","r":"464576","v":[["FC312313-6271-551F-8D2A-EB05583E2427","يا رَبْعُ أيْنَ تَوَجَّهَتْ سَلْمَى","أَمَضَتْ، فمهجةَ نَفْسِهِ أَمْضَى"],["330A7CC4-7AC6-57B6-A27F-E5E8280CD4B9","لا أبتغي سقيا السحابِ لها:","في مُقلتي خَلَفٌ مِن السُّقْيا"]]},"229FB113-3D03-54AF-A107-600A2CEE0DC3":{"t":"يا رُكبَتي خُزَزٍ وَسَاقَ نَعَامةٍ","p":107,"s":"يا ركبتي خزز وساق نعامة","r":"464832","v":[["B236464C-5CFB-5221-8351-EAC899FC94CB","يا رُكبَتي خُزَزٍ وَسَاقَ نَعَامةٍ","وزَبيلَ كنّاسٍ وَرَأْسَ بِعير"],["912D4083-6008-55BB-8952-6D4F46D8376E","يا منْ أشبهها بحمى نافضٍ","قطاعةٍ للظهرِ ذاتِ زفيرِ"],["1F78C967-E897-50C8-B0A2-A83C3F76597A","صدغاكِ قدْ شمطا ونحركِ يابسٌ","والصدر منكِ كجؤجؤِ الطنبورِ"],["C4C061F1-924B-5DF1-AB54-AFAE42D559B3","يا منْ معانقها يبيتُ كأنهُ","في مَحْبِسٍ قَمِلٍ، وفي ساجُورِ"],["592F93E7-3EE7-531E-9642-04795275C9F9","قبلتها، فوجدتُ لدغة ريقها","فوقَ اللِّسَّانِ كَلَسْعَةِ الزُّنبُورِ"]]},"78E49BA0-0CF8-5851-A12B-0591F34B4AB2":{"t":"يا سلمَ ذات الوضحِ العذابِ","p":107,"s":"يا سلم ذات الوضح العذاب","r":"464627","v":[["A179121C-B03F-5ECA-ACAC-9AF0451AB158","يا سلمَ ذات الوضحِ العذابِ","وَربَّةً المِعصَمِ ذِي الْخِضابِ"],["216F2E3C-EA3C-51DC-8480-B2CD9676E422","والكفلِ الرجراجِ في الحقابِ","والفاحمِ الأسودَ كالغرابِ"],["156AD040-2C5F-5803-B6E7-3C05059A9DBE","بِحَقِّ تِلكَ القُبَلِ الطِيَابِ","بَعدَ التَّجنّي منكِ والعِتاب"],["51FB451D-5DAB-5DC0-9564-9B77C360D7F5","إلاّ كشفتٍ اليومَ عنّي ما بي","جاء مشيبي، ومضى شبابي"],["068F5037-6EDA-5926-9311-1ECDBE34EDE0","وزال عنّي أهوجُ التصابي","فلم أَجرْ عَنْ منهجِ الصَّوابِ"]]},"D8C476A6-D91A-5E7E-84AC-AC99BCFC347C":{"t":"يا عجباً للمرتجَي فضْلهُ :","p":107,"s":"يا عجبا للمرتجي فضله :","r":"464899","v":[["BDAEFD90-39F7-5842-A874-567246B496F7","يا عجباً للمرتجَي فضْلهُ:","لقدْ رجَا ما ليسَ بالنافعِ"],["5919FBE0-9059-5FAE-A1C2-0B77D0C055B0","جئنا بهِ يشفعُ في حاجةٍ","فاحتاجَ في الاِذنِ إلى شافعٍ"]]},"4EF20252-9C5E-5DC4-A36D-A22837C80593":{"t":"يا مَعْشَرَ الأَجنادِ لا تَقنطُوا","p":107,"s":"يا معشر الأجناد لا تقنطوا","r":"464879","v":[["08F493AB-58DA-5B08-9648-40F16CB85BD4","يا مَعْشَرَ الأَجنادِ لا تَقنطُوا","خذوا عطاياكمْ ولا تسخطوا"],["8C5044C6-A521-5165-AE6A-3B441BFF1762","فَسَوفَ تُعطَونَ حُنينيَّةً","يلتذها الأمرَدُ والأشمطُ"],["5B499069-D4FB-57BE-9700-0C9943670B45","والمعبَدِيَّاتُ لِقُوَّادِكمْ","لا تدخلُ الكيسَ ولا تربطُ"],["8A14F85E-2008-5BB1-B343-90F31C4ABF60","وهكذا يرزقُ أصحابهُ","خَلِيفَةٌ مُصًحَفُهُ الْبَرْبَطُ"],["1E754962-6BC2-5FBD-8490-7984A6552422","قدْ ختمَ الصَّكَّ بأرزاقكمْ","وَصَحَّحَ الْعَزمَ، فلَمْ تُغْمَطوا"],["3CB2580A-ACC7-548D-B3B5-68295407292D","بيعةُ إبراهيمَ مشؤومةُُ","تُقْتَلُ فيها الخَلقُ أَو تُقحطُ"]]},"93EEC5A7-541F-5C37-981B-6B98C7C7F26D":{"t":"يا مَن يُقلِّبُ طُوماراً وَيلثُمه","p":107,"s":"يا من يقلب طومارا ويلثمه","r":"464841","v":[["A94BF51D-5337-5F6E-9B16-117E80DB3D90","يا مَن يُقلِّبُ طُوماراً وَيلثُمه","ماذا بقلبكَ منْ حبَّ الطواميرِ"],["CACC326E-A40E-5B9E-AAA3-DD5E2084D551","فيهِ مشابهُ من شيء تسرُّ بهِ","طولاً بطولِ، وتدويراً بتدويرِ"],["124510F8-48A2-55B0-B4D0-DE378C89E853","لو كُنْتَ تَجْمَعُ أَمْوالاً كَجَمْعِكها","إِذَنْ جَمَعْتَ بُيوتاً مِن دَنَانيرِ"]]},"D92BB36F-AA80-5277-B57E-6726CE6981FF":{"t":"يا هَيْثَما يابنَ عُثمانَ الَّذِي افَتَخَرَتْ","p":107,"s":"يا هيثما يابن عثمان الذي افتخرت","r":"464810","v":[["56F8064C-EE35-525A-96FF-7D066CB6C542","يا هَيْثَما يابنَ عُثمانَ الَّذِي افَتَخَرَتْ","به المكارمُ، والأيام تفتخرُ"],["8752753F-2526-5EA6-AE2D-BAAC32BB836A","أضحتْ ربيعةُ والأحياءُ منْ يمنٍ","تبهى بنجدتهِ لا وحدها مضرُ"]]},"37274180-A987-56D9-B9B9-7305204B07A9":{"t":"ياجَوادَ اللِّسانِ مِن غيرِ فِعْلٍ","p":107,"s":"ياجواد اللسان من غير فعل","r":"465026","v":[["B4B0A294-EFEC-5A90-AFCA-B6A70F217D47","ياجَوادَ اللِّسانِ مِن غيرِ فِعْلٍ","ليتَ في راحَتيكَ جُودَ اللِّسانِ"],["DB5A895D-F316-59F6-90B0-75E23B975959","عَينَ مِهرانَ قد لَطَمْتَ مِراراً","فاتقِ ذا الجلالِ في مهرانِ"],["6304F28F-6893-5545-A81E-5CF60CA042A8","عرتَ عيناً، فدعْ لمهرانَ عيناً","لا تدعهُ يطوفُ في العميانِ"]]},"AB36FB1A-6C58-5898-A8C8-8E7F171348B8":{"t":"يلوِّثُ لِحيةَ عَرُضَتْ وَطَالَتْ","p":107,"s":"يلوث لحية عرضت وطالت","r":"464865","v":[["E04E357C-DC0E-525E-8F88-786D69CE049D","يلوِّثُ لِحيةَ عَرُضَتْ وَطَالَتْ","ويمرثها كتمريثِ الخميرهْ"],["84B731E9-215A-59C6-83AF-4D884FDC81C6","فيا لكِ لِحيةَ وَضْرَى، وَشَيْباً","كأنكَ قد أكلتَ بها مضيرهْ"]]},"357C107E-82C6-5CBB-A9CC-0DD249186DCD":{"t":"يَا بُؤْسَ لِلْفَضْلِ لَو لَم يَأْتِ مَا عَابَهْ","p":107,"s":"يا بؤس للفضل لو لم يأت ما عابه","r":"464697","v":[["22D3085D-9AAE-5967-9849-0AAEE288070D","يَا بُؤْسَ لِلْفَضْلِ لَو لَم يَأْتِ مَا عَابَهْ","يستفرغُ السمَّ من صماءَ قرضابهْ"],["BCCA138E-1A0C-52D1-B9FE-57F3FEFF5C04","مَا إنْ يَزَالُ- وَفِيهِ الْعَيْبُ يَجْمعُهُ-","جهلاً، لأعراضِ أهلِ المجدِ عيابهْ"],["4CB4CE66-C803-53A7-A6EC-B239875505E4","إِنْ عابَني لَمْ يَعِبْ إِلاَّ مُؤَدِّبَهُ","ونَفسَهُ عَابَ لمَّا عابَ أدّابَهْ"],["DD3CF7FE-18FF-5046-8B66-A3BDB6F91AA4","فَكَانَ كالكَلْبِ ضَرَّاهُ مُكلِّبُهُ","لصيدهِ، فعدا فاصطادَ كلاّبهُ"],["24B2A872-A679-50A6-8765-BB033AA668BE","إنْ يغدرنَّ فإنَّ الغدرَ ألبسهُ","من الأبوَّةِ والأجدادِ جِلبابَهْ"],["1DE4FD39-A8D7-51DD-AA68-B4D738D7175C","تلكَ المساعي إذا ما أخَّرتْ رجلاً","أَحَبَّ للِنَّاسِ عَيباً كالَّذِي عَابَهْ"],["48B556BF-22E0-5EE2-9945-165E11946980","كذاكَ من كان هدمُ المجدِ عادتهُ","فإنه لبناةِ المجدِ عيابهْ"]]},"9940B306-1FEF-5EDF-90DA-DED8A75C271C":{"t":"يَقولُ زِيادٌ قِفْ بَصَحْبِكَ مَرَّةً","p":107,"s":"يقول زياد قف بصحبك مرة","r":"464897","v":[["D3E28BC3-09CC-59A6-BFD7-07EB726F2F88","يَقولُ زِيادٌ قِفْ بَصَحْبِكَ مَرَّةً","على الرَّبْعِ، مالي والوَقوفَ عَلَى الرَبعِ"],["C4C58373-41FC-54D5-95A3-A529DF0E8C67","أَدِرْهَا عَلَى فَقْدِ الحَبيبِ فَرُبَّما","شربتُ على نأيِ الأحبَّةِ والفجعِ"],["893DE25B-3B0B-5506-A7BB-14EBBA642A28","فما بلغتني الكأسُ إلا شربتهُا","وإلاّ سقيتُ الأرضَ كأساً منْ الدَّمعِ"]]},"40C8D541-947A-5C4F-A02B-A60881BAB937":{"t":"يُشفى غليلكَ في الدِّيارِ بقدرِ ما","p":107,"s":"يشفى غليلك في الديار بقدر ما","r":"464993","v":[["64EA419D-F4EB-5380-B702-5CF15681A88D","يُشفى غليلكَ في الدِّيارِ بقدرِ ما","فاضتْ بها منْ مقلتيكَ سجومُ"],["6C5E6CBE-8E3E-5768-8E6D-3B7718F887F9","فإذا انْقَضَتْ حُرقُ البُكا عادَ الهوى","وترادَفتْكَ مَعَ الْهُمُومِ هُمُومُ"]]},"238ABE10-6546-593B-814E-331614A0B849":{"t":"يُصافِحُ المَوتَ بوجهٍ دامِ","p":107,"s":"يصافح الموت بوجه دام","r":"465012","v":[["611E2814-F118-5F22-B168-A951E7EB6A27","يُصافِحُ المَوتَ بوجهٍ دامِ","حرٍّ رقيقٍ واضحٍ بسامِ"],["478DC394-4EA6-5FC8-9DA2-B3A983FCD761","يسلُّ منْ فكيَّه كالحسامِ","صفيحةً تلعبُ بالكلامِ"]]}}}