{"v":1,"poems":{"47869CBC-408B-5E97-BD92-4184ED6E4131":{"t":"تراءَت وأستارٌ منَ البَيْتِ دونَها","p":29,"s":"تراءت وأستار من البيت دونها","r":"436680","v":[["7A8D26E6-848E-5EB9-95FE-D89B6BB3CC29","تراءَت وأستارٌ منَ البَيْتِ دونَها","إلَينا وحانَت غَفَلةُ المُتَفقِّدِ"],["EF01A003-EFD2-5CDC-905D-F20888FF6D78","بِعَينَي مَهاةٍ يَحدُرُ الدَّمعُ منهُما","بَريمَينِ شَتَّى من دُموعٍ وإِثمِدِ"],["993B254E-5AD3-5359-AAE1-26BA028B6F75","وَجيدِ غزالٍ شادِنٍ فَردَت لهُ","من الحَلي سمطَي لُؤلُؤٍ وزَبرجَدِ"]]},"34686E9F-7182-5DD0-BAEE-7CC8BA847D4A":{"t":"دافعتُ عَنهُ بِشِعريَ إذْ","p":29,"s":"دافعت عنه بشعري إذ","r":"436679","v":[["791B21A1-D4C7-585D-91CC-80AD22ABCBF6","دافعتُ عَنهُ بِشِعريَ إذْ","كان لِقَومي في الفِداءِ جَحَدْ"],["A8881D0C-6B39-527B-83F7-CA2A769D84BD","فكان فيهِ ما أتاكَ وفي","تِسعينَ أسرَى مُقْرَنينَ صَفدْ"],["4E47147D-0799-5777-81AE-DFFD3CCA5C76","دافعَ قَومي في الكَتيبَةِ إذْ","طارَ لأطرافِ الظُّباتِ وَقَدْ"],["B01EC1E1-10B3-5695-B048-C54A295D79BC","فأصبَحوا عندَ ابنِ جَفنةَ في الـ","أغلال مِنهمْ والحَديدِ عُقَدْ"],["D28472C1-8EF6-501B-B37D-21B4C8A73DC0","إذ مُخنَبٌ في المُخنَبينَ وفي النَّـ","ـهكَةِ غَيٌّ بادِئٌ ورَشَدْ"]]},"973B6DAC-6A9E-5FC3-88A4-9CCAACF161A7":{"t":"ذهبتَ من الهِجران في غير مذهب","p":29,"s":"ذهبت من الهجران في غير مذهب","r":"436678","v":[["F1693369-FE82-5ADC-B4FF-74CB723912D8","ذهبتَ من الهِجران في غير مذهب","ولم يَكُ حقّاً كلُّ هذا التجنُّبِ"],["407C7B6F-0D73-5E8F-89D0-E8E022D09433","لَيالِيَ لا تَبْلى نصيحَةُ بَينِنا","لَيالِي حَلُّوا بالسِّتار فَغُرَّبِ"],["23CCA984-ECC6-5626-9AAA-5C039F069938","مُبَتّلة كأنَّ أنضاءَ حَليِها","على شادِنٍ من صاحَةٍ مترببِ"],["58839569-9156-5E8B-98B4-2AE0DF3B1839","مَحالٌ كأجوازِ الجَرادِ ولؤلؤٌ","من القَلَقِيِّ والكَبيسِ المُلَوَّبِ"],["FED2D110-3185-582F-8284-CBFF920A52A0","إِذا ألحَمَ الواشونَ لِلشَّرِّ بَينَنا","تَبلَّغَ رَسُّ الحُب غيرُ المُكَذَّبِ"],["E6DED5B5-F43E-5734-81C7-33774C6B7AB4","ومَا أنت أم ما ذِكرُها رَبَعِيَّةً","تَحُلُّ بإِيرٍ أو بأكنافِ شُربُبِ"],["7EF1FB7F-21F5-5B38-AFC0-9549D45C31DE","أطَعتَ الوُشاةَ والمُشاةَ بِصُرمِها","فقد أنهَجَت حِبالُها للتّقَضُّبِ"],["91A830CC-9811-5989-A46B-FCC421024A69","وقد وَعَدَتكَ موعِدا لو وَفَت به","كمَوعودِ عُرقُوبٍ أخاه بِيَثرِبِ"],["69C4C0E4-80CD-5532-9166-0F53A86690AA","وقالتْ: وإِن يُبخَلْ عليكَ ويُعتَللْ","تَشَكَّ وإن يكشف غرانك تدربِ"],["846A17F0-F61D-5C58-B682-DDB9C1B744A7","فقلتَ لها: فِيئِي فما تَستَفِزُّني","ذواتُ العُيونِ والبَنانِ المخضبِ"],["6233CA78-42BE-57B1-A613-2CDCD7515AA1","ففاءت كما فاءت من الأدم مُغزِلٌ","بِبِيشَةَ تَرعى في أراكٍ وحُلَّبِ"],["A482015F-5BB0-50E5-AD0F-6C6181CD2A58","فَعِشنا بِها من الشَّبابِ مُلاوَةً","فأنجَحَ آياتُ الرَّسولِ المُخَبَّبِ"],["4789AC57-0B1C-5EB6-81BB-F59A2D0AE314","فإِنَّكَ لم تَقطَعْ لُبَانَةَ عاشقٍ","بمثل بُكورٍ أو رَواحٍ مُؤَوِّبِ"],["6325FAAB-BBBA-597E-BD4F-14AE465F3F51","بِمُجفَرةِ الجَنبَينِ حَرفٍ شِملَّةٍ","كَهمَّكَ مِرقالٍ على الأينِ ذِعِلبِ"],["FC3DE1ED-ADFE-5E54-BF57-7616863306BC","إذا ما ضَربتُ الدَّفَّ أوصُلتُ صَوْلَةً","تَرقَّبُ مني، غير أدنى ترَقُّبِ"],["1E1162F2-DB5A-5FF5-B4D9-1A152E4158DB","بعَينٍ كمِرآةِ الصَّناعِ تُديرُها","لِمَحجَرِها منَ النَّصيف المنقَّب"],["3E495F36-E534-526F-BDEC-A43D5DF26FF0","كأنَّ بِحاذَيها إذا ما تَشذَّرت","عَثاكيل عِذقٍ من سُمَيحةَ مُرطِبِ"],["16B8E250-CC23-5610-99C4-90707AE58A87","تَذُبُّ به طَوراً وطوراً تُمِرُّةُ","كذَبِّ البَشير بالرِّداءِ المُهدَّبِ"],["FE2B3909-C2BD-5707-9229-EEA03EEEFEE7","وقد أغتَدي والطَّيرُ في وُكُناتِها","وماءُ النَّدى يجري على كلِّ مِذنَبِ"],["0E2CC1EE-CDD8-5224-A234-51F04088697A","بِمُنجَرِدٍ قَيدِ الأوابِدِ لاحَهُ","طِرادُ الهَوادي كلَّ شأوٍ مُغرِّبِ"],["77CDB678-73E2-5C7E-A0D4-465ABCBB9011","بغَوجٍ لَبانُهُ يُتَمُّ بَريمُهُ","على نَفْثِ راقٍ خَشيَةَ العينِ مُجلِبِ"],["E01C0DD8-9EF9-513F-A9B8-6AC9897F23F8","كُمَيتٍ كلَونِ الأُرجُوان نشرتَه","لِبَيع الرِّداءِ في الصُّوان المُكعَّبِ"],["7D24BAA8-004F-5098-B1B5-7CF380B82069","مُمَرٍّ كَعَقدِ الأندَريّ يَزينُهُ","مع العتقِ خَلقٌ مُفعَمٌ غَيرُ جَأنَبِ"],["4CF2BB7F-47F5-545E-98C1-CB84637F8163","لهُ حُرَّتانِ تَعرِفُ العِتقَ فيهما","كَسامِعَتيْ مَذعورةٍ وَسطَ رَبربِ"],["BD856A98-E09F-5B2C-A116-50F73DF4CA46","وجَوفٌ هَواء تحت مَتْنٍ كأنَّه","من الهضبةِ الخَلقاءِ زُحلوقُ مَلعبِ"],["66A9E8D5-6E5B-57CB-A0B4-9C242C3DD0A7","قطاةٌ ككُردوسِ المحالة أشرفت","إلى سَندٍ مِثلِ الغَبيطِ المُذَاَّبِ"],["BE8AC0FF-4EDD-5FE0-9B10-934A0DD6D910","وغُلبٌ كأعناق الضِّباع مَضيغُها","سِلامُ الشَّظى يَغشى بها كل مركب"],["6F0B2A02-FFD0-5C89-A597-4AA0D1159011","وسُمْرٌ يُفَلِّقن الظِّراب كأنَّها","حِجارةُ غَيلٍ وارِساتٌ بطُحلُبِ"],["DFEE199F-19AD-5FC2-94A1-38F450BCD270","إذا ما اقتَضَينا لم نُخاتِلْ بِجُنَّةٍ","ولكنْ نُنادي من بعيدٍ: ألا اركبِ!"],["87FADF0F-65B5-5E00-9741-C7742EB10DFB","أخا ثِقةٍ لا يلعَنُ الحيُّ شخصَهُ","صَبوراً على العِلاَّتِ غَيرِ مُسبَّبِ"],["E78BD759-FE92-5ABD-B00B-F31060890AB7","إِذا أنفَدُوا زادا فإنَّ عِنانَهُ","وأكرُعَهُ مستعمَلاً خَيرُ مكسبِ"],["B61A210C-1324-5DD8-9ECD-9F3DDA544BC1","رأينا شِياها يَرتَعِينَ خَميلَةً","كَمَشْيِ العذارى في المُلاءِ المُهدَّبِ"],["8A48C030-D63A-5F8D-B4F6-0ACB588E96CE","فَبينا تَمارِينا وعَقدُ عِذاره","خَرجنَ عَلينا كالجُمانِ المُثقَّبِ"],["08C3B916-02D4-58EB-8C85-0E8C417FB352","فَأتبعَ آثار الشِّياهِ بصادِقٍ","حثيثٍ كَغيثِ الرائحِ المُتَحلِّبِ"],["CD7B8E5A-DEBC-5788-94AB-1398E7C9E153","ترى الفأر عن مسترغب القدرِ لائحاً","على جَددِ الصَّحراءِ من شدٍّ مُلهبِ"],["85D31FC2-4E14-5109-BFA3-0F7DD929DCF9","خَفى الفأرَ مِن أنفاقهِ فكأنَّما","تَخلَّله شُؤبوبُ غيثٍ مُنقِّبِ"],["8CF469FD-DB03-5B54-A510-208D8E2F883D","فظلَّ لثيرانِ الصَّريمِ غَماغِمٌ","يُداعِسُهُنَّ بالنَّضِيِّ المُعلَّبِ"],["A17E34AE-F5EC-5A81-B5C0-21E1B58EFE26","فَهاوٍ على حُرِّ الجَبينِ ومُتَّقِ","بِمِدراتِه كأنَّها ذَلْقُ مِشعَبِ"],["9A1090C6-E528-5012-B480-4F038484BD0E","وعادى عِداءً بين ثَورٍ ونَعجةٍ","وتَيسٍ شَبوبٍ كالهَشيمة قرهَبِ"],["65742883-E87E-50D9-9D98-5DD33E21C3B8","فقُلنا: ألا قد كان صيدٌ لِقانصٍ","فَخَبُّوا علينا فضلَ بُردٍ مُطنَّبِ"],["89B6D7C4-679A-54A0-A9AB-CE8E6F4357EF","فظلَّ الكفُّ يختَلِفن بحانذٍ","إلى جؤجُؤٍ مِثلِ المَداك المُخَضَّبِ"],["CA34F8BA-0A76-5309-A141-A4C723784F99","كأنَّ عُيوب الوحش حولِ خبائنا","وأرحُلِنا الجَزعُ الَّذي لَم يُثقَّبِ"],["4BA61422-600E-5620-8426-358C5913A3E0","ورُحنا كأنَّا جُواثى عَشِيَّةً","نُعالي النِّعاج بَينَ عِدلٍ ومُحقَبِ"],["7B661C32-714F-56E9-B023-C03379D5F47D","وراحَ كشاةِ الرَّبل ينفُض رأسَه","أذاةً بهِ من صائكٍ مُتَحلِّبِ"],["72A13ED3-3936-5439-9614-5A47DA8736C5","وراحَ يُباري في الجِنابِ قَلُوصَنا","عزيزاً علينا كالحُبابِ المُسيَّبِ"]]},"2B399251-154E-55A5-9126-EADDD863D896":{"t":"طَحَا بكَ قَلبٌ في الحِسان طروبُ","p":29,"s":"طحا بك قلب في الحسان طروب","r":"436677","v":[["FCA714A5-F016-53A9-8BB8-84DE53405B4C","طَحَا بكَ قَلبٌ في الحِسان طروبُ","بُعيْد الشَّبابِ عصرَ حانَ مشيبُ"],["B3427FF4-ED45-59A6-AD54-6BEACEAE4DB4","تُكلِّفُني ليلَى وَقد شَطَّ ولْيُها","وعادتْ عوادٍ بينَنا وخُطُوبُ"],["05FA2C29-1A03-5CD3-A1C0-25A6E902E769","مُنعَّمةٌ لا يُسْتطاعُ كلامُها","على بابِها من أن تُزارَ رقيبُ"],["C51130DF-1238-55AE-A724-A976401CC823","إذا غاب عنها البعْلُ لم تُفْشِ سِرَّهُ","وتُرْضي إيابَ البَعْل حينَ يَؤُوبُ"],["1669A8B7-92C8-5358-9A82-C6D68577D260","فلا تَعْدِلي بَيْني وبينَ مُغَمَّرٍ","سقَتكِ رَوايا المُزن حيث تَصوبُ"],["47B40DC1-C430-5640-9F6A-CA1F540CD950","سقاكِ يمانٍ ذُو حَبيٍّ وعارِضٍ","تَروحُ به جُنْحَ العَشيِّ جُنوبُ"],["392AEC89-B0F1-5FEC-B75D-FD891DD2DF9D","وما أنتَ أم ما ذِكرُها رَبَعِيَّةً","يُخَطُّ لها من ثَرْمَداء قَليبُ"],["D390029C-934F-5177-8687-500AB8DE53B9","فإنْ تَسألوني بالنِّساء فإنَّني","بصيرٌ بأدواءِ النِّساء طبيبُ"],["2DCE5095-80B8-56A7-8E57-F9A9EAA43517","إذا شاب رأسُ المَرْءِ أو قَلَّ مالهُ","فليس له من وُدِّهِنَّ نصيبُ"],["416BF7BD-C944-5EBD-98B9-EDC9CDCB160A","يُرِدْنَ ثَراءَ المالِ حيثُ عَلِمْنَهُ","وشرْخُ الشَّباب عنْدَهُنَّ عجيبُ"],["2A1DBD74-75A4-5CCF-8A57-14AC94B3E7AA","فَدعها وسلِّ الهمَّ عنك بِجِسرةٍ","كَهَمِّكَ فيها بالرِّادفِ خبيبُ"],["03E6E5D1-69B7-5C8E-93CA-D7B83ECEDE9D","وناجِيَةٍ أفْنَى رَكِيبَ ضُلوعِها","وحارِكَها تَهَجُّرٌ فدُؤوبُ"],["AE9AEC9E-CB50-50F4-89ED-4430B1CC3D2A","وتصبحُ عنِ غبِّ السُّرى وكأنها","مُوَلَّعة تخشى القَنيص شَبوبُ"],["DC79FB90-F33A-5872-9E01-C96E9A8E59DE","تَعفَّق بالأرْطى لها وأرادها","رجالٌ فَبَذَّتْ نَبْلَهم وَكَليببُ"],["37CF5486-8BB7-5770-8796-3A74562AE68A","إلى الحارث الوهَّاب أعلمتُ ناقتي","لِكلكِلها والقُصْريْين وجيبُ"],["E0D8DFB7-6E06-5204-A372-C0BD6C7E5A1E","لتِبُلغني دار امرئٍ كان نائياً","فقد قرَّبتني من نداكَ قَروبُ"],["BD325C1A-9D6C-5E01-B559-DE4600F8C1F1","إلَيكَ ـ أبيت اللَّعْنَ ـ كان وجيفُها","بِمُشتبِهاتٍ هَوْلُهُنَّ مَهيبُ"],["F4F15345-1EFC-5785-B81A-3A274D40F1B3","تتَّبعُ أفْياءَ الظِّلالِ عَشيَّةً","على طُرُقٍ كأنَّهُن سُبُوبُ"],["14EE85B1-87DE-548F-8734-42230349DF3C","هداني إليك الفرقدانِ ولا حِبٌ","لهُ فوقَ أصواءِ المتانِ علوبُ"],["B33BC200-1E48-5218-8DF7-9A5E0C934FA9","بها جيفُ الحسرى فأمَّا عِظامُها","فبيضٌ وأمَّا جِلدُها فَصليبُ"],["0B6EE78F-4438-5B95-81AC-7F10549E5D47","فأوردتُها ماءً كأنَّ جِمامَهُ","مِنَ الأجْنِ حنَّاءٌ معا وصبيبُ"],["3FEFDC2B-7C03-5DB8-89E8-D38EBD420AF3","تُراد على دِمْن الحياضِ فإنْ تَعف","فإنَّ المُندَّى رِحْلَةٌ فرُكوبُ"],["8C4B2D8A-83AE-545B-B2CE-169016A78D7B","وأنتَ امرؤٌ أفضَت إليك أمانتي","وقبلكَ ربَّتني فَضِعتُ رُبوبُ"],["7FC36522-9C22-5EAD-BDAB-FEE28D88A64E","فأدت بنو عَوفِ بنِ كعب رَبيبها","وغُودِرَ في بعض الجُنودِ رَبيبُ"],["11F3BB1C-59BF-5026-B840-26708FF125BA","فواللهِ لولا فارسُ الجونِ منهمُ","لاڑبوا خزايا والإيابُ حَبيبُ"],["F3DE5DFE-4D73-5477-A7A2-7A82157965ED","تُقدمُه حتَّى تغيبَ حُجُوله","وأنت لبَيض الدَّارعين ضروبُ"],["22790886-4161-5A3A-B07A-843542389E93","مُظاهرُ سِربَالي حَديد عليهِما","عَقيلا سُيوفٍ مِخذَمٌ وَرسوبُ"],["E7946B9A-3740-553E-9A5D-7161B8C86095","فَجالدتَهُم حتَّى اتّضقوك بكبشهمْ","وقد حانَ من شمسِ النَّهارِ غُروبُ"],["C5BC882D-87F2-535D-B67F-52293E598D84","وَقاتَل من غسَّان أهْلُ حِفاظِها","وهِنبٌ وقاسٌ جالدت وشَبيبُ"],["2AC799AA-EAA0-5029-9828-EA9C6BD8EBC5","تَخشخشُ أبدانُ الحديدِ عليهِمُ","كما خَشخَشت يبسَ الحصاد جنوبُ"],["22AB9F9D-BCFB-573B-89C6-333FC67386A5","ودُ بنفسٍ، لا يُجادُ بمثلها","وأنتَ بها يوْم اللّقاء تطيبُ"],["9D9DEE1A-A995-5375-832C-22564C172CD6","كأنَّ الرجال الأوس تحت لَبانِه","وما جَمعتْ جَلٌّ، معاً، وعتيبُ"],["8353C6B3-0585-51E6-82AC-78F684AA2DE0","رغا فَوقَهم سَقب السَّماءِ فداحصٌ","بِشكَّتِه لم يُستلَبْ وسليبُ"],["7C164247-71EF-516C-9BC8-1446F1A1769B","كأنَّهُمُ صابَتْ عليهمْ سحابةٌ","صَواعِقُها لِطَيرهنَّ دبيبُ"],["43E70C3F-433B-570F-A915-F12E64D19DE7","فَلَمْ تنجُ إلا شطبةٌ بِلجامِها","وإلاّ طِمِرٌّ كالقناة نَجيبُ"],["6569999A-D366-5FBB-B60D-F7C4F10EB28A","وإِلا كميٌّ ذوِ حِفاظٍ، كَأنَّهُ","بما ابتَلَّ من حد الظُّبات خصيبُ"],["26982FEE-C7DC-5532-9BED-7695F72D0001","وفي كُلِّ حيٍ قد خَطَبت بنعمة","فحُقَّ لِشأسٍ من نَداكَ ذَنوبُ"],["61FF114C-8C47-53B5-B2BE-295A49F61669","وما مِثْلُهُ في النَّاس إلا قبيلُهُ","مُساوٍ، ولا دانٍ لَذاكَ قَريبُ"],["619D8BE7-AC7C-510C-9079-16D0FCCBBFD1","فلا تَحْرِمنِّي نائلاً عن جَنابَةٍ","فإنِّي امرؤ وَسطَ القباب غريبُ"]]},"52B80348-1782-5342-90D7-51B5D4B73BE4":{"t":"قُدَيديمةَ التَّجريبِ والحِلمِ أنَّنِي","p":29,"s":"قديديمة التجريب والحلم أنني","r":"436699","v":[["7E2B7BA8-04E5-59E9-8405-FF843247D6C1","قُدَيديمةَ التَّجريبِ والحِلمِ أنَّنِي","أرى غَفَلاتِ العيشِ قبل التَّجارِبِ"]]},"B389321E-D987-5E15-B39A-69C8F5CDDFA9":{"t":"كأنَّ ابنةَ الزَّيدِيِّ يومَ لَقيتُها","p":29,"s":"كأن ابنة الزيدي يوم لقيتها","r":"436705","v":[["4D72AA4F-3453-5CD5-A127-98227A9C1B25","كأنَّ ابنةَ الزَّيدِيِّ يومَ لَقيتُها","هُنَيدَةَ مَكحولُ المَدامعِ مُرشِقُ"],["2CD73E3A-B174-5A0D-A7CE-D27AE90FAA84","تُراعي خَذولاً ينفُض المُرْد شادِناً","تَنوشُ من الضَّال القِذافَ وتَعلَقُ"],["BC11908A-3D16-5BA9-A7FA-FBA4573BE7A3","وقلتُ لها يوماً بوادي مُبايِضٍ:","ألا كلُّ عانٍ غَيرَ عَانيكِ يُعتَقُ"],["18F15E1A-5A19-59D4-A9E1-CF3BD611DF37","يُصادِفُ يوما منْ مليكٍ سَماحةً","فيأخُذُ عَرْضَ المالِ أو يتَصدَّقُ"],["743EB5CE-F0DF-5643-BF29-987B56C4B1ED","وذَكَّرِنيها بعدما قد نَسيتُها","ديارٌ علاها وابِل مُتَبِعِّقُ"],["9997DBB4-B9C0-582F-A769-75CA56CDADE0","بأكنافِ شَمَّاتٍ كأنَّ رُسومَها","قَضيمُ صَناعٍ في أديمٍ مُنمَّقُ"]]},"BB33DB07-04B1-5DE6-B454-01895193EED8":{"t":"كَأنَّ أعْيُنَها فِيها الحَوَاجِيلُ","p":29,"s":"كأن أعينها فيها الحواجيل","r":"436711","v":[["01F37E07-A0EE-560B-8C90-60C8662EB747","كَأنَّ أعْيُنَها فِيها الحَوَاجِيلُ","وقال في يوم الكُلاب الثاني: مَ"]]},"33BDF858-7C64-548B-91E9-BA6305F8C75D":{"t":"للماءِ والنَّارِ في قَلبي وفي كَبِدي","p":29,"s":"للماء والنار في قلبي وفي كبدي","r":"436702","v":[["9B4937B4-ACBE-5DA2-816B-1751FDA432B5","للماءِ والنَّارِ في قَلبي وفي كَبِدي","من قِسمة الشَّوق ساعورٌ وناعورُ"]]},"4E20D2D7-7140-5119-82EA-CA0578F522F0":{"t":"لَحَى اللهُ دهرّا ذَعذَع المالَ كلَّهُ","p":29,"s":"لحى الله دهرا ذعذع المال كله","r":"436708","v":[["B5089049-9144-53C9-B42C-E6B79BA666E9","لَحَى اللهُ دهرّا ذَعذَع المالَ كلَّهُ","وسوَّدَ أشباهَ الإِماءَ العَوارِكِ"]]},"8B9D0E87-CCD9-5694-AF50-B69EBD890B28":{"t":"مَنْ رَجلٌ أحبُوهُ رَحلي وناقَتي","p":29,"s":"من رجل أحبوه رحلي وناقتي","r":"436712","v":[["80069277-E6B3-5961-8359-FD2F943D7F15","مَنْ رَجلٌ أحبُوهُ رَحلي وناقَتي","يُبَلِّغُ عني الشِّعرَ إذ ماتَ قَائلُه"],["32E70567-0219-553B-ADC8-160B3A035DA4","نَذيراً وما يُغني النَّذيرُ بِشَبوَةٍ","لِمن شاؤهُ حَولَ البَديِّ وجامِلُه"],["1E452E57-38EC-54D5-B904-9F4F32E6CFF0","فقُل لِتميمٍ تَجعَلِ الرَّملَ دونَها","وغيرُ تَميم في الهزاهز جاهِلُه"],["1D1C3A1A-543F-58FE-8AE2-9BE0639342C0","فإنَّ أبا قابوسَ بَيني وبَينها","بِأرعَنَ يَنفي الطَّيرَ حُمرٍ مَناقِلهْ"],["7BA79924-4F98-5B48-A2A0-328FD1A8549C","إذا ارتَحلُوا أصَمَّ كلَّ مُؤَيِّةٍ","وكلَّ مُهيبٍ نَقرُه وَصَواهِلُهْ"],["7DB1BF6E-8519-5FC1-A011-E615C670AA45","فلا أعرِفَنْ سَبْياً تُمًدُّ ثُدِيُّهُ","إلى مُعرِضٍ عن صِهرِه لا يُواصِلُهُ"]]},"38CD5065-93B6-540A-95F8-3AF307C31C0A":{"t":"هل ما علمتَ وما استُودِعتَ مكتومُ","p":29,"s":"هل ما علمت وما استودعت مكتوم","r":"435845","v":[["19BB7B76-8650-57BB-9D44-0ED42A81F39E","هل ما علمتَ وما استُودِعتَ مكتومُ","أم حبْلُها إذ نأتْكَ اليوم مصرومُ"],["BA49BE9E-3D91-55C2-A890-7B8D7745DF2A","أمْ هل كبيرٌ بكى لم يَقضِ عَبرتَهُ","إثرَ الأحِبَّة يوم البيْنِ مشكومُ"],["4FEF11E9-1C7C-5B06-8CEE-9F0CC9798FF2","لم أدْرِ بالبَيْنِ حتَّى أزمَعوا ظَعنا","كلُّ الجمالِ، قُبيْل الصُّبْحِ مَزموم"],["670C6ED7-650C-50A9-84F1-F306F2C16C73","رَدَّ الإماءُ جِمالَ الحَيَّ فاحتملوا","فكلُّها بالتَّزِيدِيَّاتِ مَعْكومُ"],["9B467F37-A708-5528-AC8D-140E0F2BB9F7","عَقْلاً ورَقْما تَظَلُّ الطَّيرُ تَتْبعُه","كأنَّه من دَمِ الأجْوافِ مَدْمومُ"],["C26A877E-F5F7-5835-9D62-79A3BE56BC40","يحملَن أتْرُجَّةً نَضْجُ العَبيرِ بها","كأنَّ تَطْيابَها في الأنف مشمومُ"],["D725B368-F84A-54AC-97C2-775F0905BED6","كأنَّ فارةَ مِسكٍ في مَفارِقِها","لِلباسط المُتعاطي وَهوَ مزكومُ"],["6A8B2D42-C9DA-5BFF-80E6-626EBBCD25EE","فالعينُ منِّي كأنَّ غربٌ تحُطُّ به","دَهْماءُ حارِكُها بالقِتْبِ مَخْزومُ"],["E63EA269-0A43-51A7-8934-5BA12765B786","قد عُرِّيَتْ حِقْبةً حتَّى استطفَّ لها","كِترٌ كحافة كِير القَينِ مَلمومُ"],["229A2EC8-337E-534A-B8C2-E0733145C2F3","كأنَّ غِسْلَة خِطمِيٍّ بمِشفَرِها","في الخدِّ منها وفي اللَّحْيينِ تلغيمُ"],["9554F8F3-F926-51E5-A55E-1491EEECF258","قد أدْبر العُرُّ عنها وَهْي شَامِلُها","من ناصع القَطِران الصِّرف تدسيمُ"],["48CC92D2-F4D9-5748-B76C-9E746C000054","تسْقي مَذانِبَ قد زالتْ عَصيفتُها","حُدورُها من أتِيِّ الماءِ مطمومُ"],["C4030EA7-E76D-565D-97B3-1DBD3C5E436B","من ذكر سلمى، وما ذكري الأوان لها","إلاَّ السَّفاهُ وظنُّ الغَيبِ تَرجيمُ"],["8BAEE551-E64F-5DBC-A25C-3985830E5637","صفر الوشاحينِ ملءُ الدِّرع خَرعبةٌ","كأنَّها رَشأٌ في البَيتِ مَلزومُ"],["C378C63C-07C6-59FA-ADBB-D61836269495","هل تُلحِقَنِّي بأُولي القوم، إذا شحطوا","جُلْذِيَّةٌ كأتان الضَّحل عُلكومُ"],["7B8B51B2-C076-52D0-93B4-040710163FE8","تُلاحظ السَّوط شزراً وهي ضامزةٌ","كما توجَّس طاوي الكشح موشوم"],["9C6108C3-5F88-5E97-A134-C28C4EC5E3A5","كأنَّها خاضِبٌ زُعْرٌ قوائمُه","أجْنَى له بالْلِّوَى شَرْيٌ وتَنُّومُ"],["5B4BC118-BC2F-5A04-A530-0BBC6FC7E48A","يَظلُّ في الحَنظَلِ الخُطْبان يَنقُفه","وما اسْتَطفَّ من التَّنُّوم مخذومُ"],["E3968B47-4B92-5102-8E34-BC2946DA3802","فُوهٌ كشَقِّ العَصا لأياً تبيُّنُهُ","أسكُّ ما يسمَع الأصوات مَصْلوم"],["EBAAFFA6-8F90-5BFF-9FDC-4B982BD29582","حتَّى تذكَّرَ بيْضاتٍ وهيَّجَه","يومُ رذاذٍ عليه الرِّيحُ مغْيومُ"],["DDACC245-C2FC-5DD6-B14A-AF92FE5A0809","فلا تَزَيُّدُه في مَشيهِ نَفِقٌ","ولا الزَّفيفُ دُويَن الشَّدِّ مَسؤومُ"],["C2CA2E0D-EE14-56D2-85CB-FFDF53D6F65F","يكادُ مَنسِمُه يَختلُّ مُقْلَتَهُ","كأنَّه حاذِرٌ لِلنَّخْسِ مَشْهومُ"],["52701663-9857-5298-A797-85626E8E7380","يَأوي إلى خُرَّقٍ زُعْرٍ قَوادِمُها","كأنَّهُنَّ إِذا بَرَّكْنَ جُرْثومُ"],["087C85D2-F2F4-5224-9594-EC0A218DB5BF","وضَّاعةٌ كعِصِيّ الشّرع جُؤجؤه","كأنَّه بِتَناهِي الرَّوض عُلْجومُ"],["F3B8B821-C445-58B9-98F9-95F6D45CAA48","حتَّى تلافَى وقَرنُ الشَّمسِ مُرتفعٌ","أُدحيَّ عرسين فيه البَيْض مركومُ"],["FAAD63EC-8966-5579-94ED-2223E50D80CD","يُوحي إليها بإنقاضٍ ونَقْنَقَةٍ","كما تَراطَنُ في أفْدانِها الرُّومُ"],["9018C2CB-60A4-5C1E-BC26-1F9E0879F20F","صَعلٌ كأنَّ جناحَيه وجُؤجؤَه","بَيْتٌ أطافتْ بِه خرقاءُ مهجومُ"],["D3CB3FF6-CA27-5270-BB47-49700B38F1BB","تَحُفُّهُ هِقْلَةٌ سَطْعاءُ خاضِعةٌ","تُجيبُهُ بِزِمارٍ فيه تَرْنيمُ"],["20345250-95F7-55C1-828F-3E0B1A566080","بل كلُّ قوم، وإِن عزُّوا وإن كثُروا","عَريفُهم بِأثافي الشَّرِّ مَرْجومُ"],["0038FE73-1A80-5019-9341-D78AC1FBF818","والجودُ نافِيَةٌ لِلمالِ مُهْلِكَةٌ","والبُخلُ مبقٍ لأهليه ومذمومُ"],["B6D2E38E-C1D1-549E-84A6-8FB01CD5A158","والمالُ صوفُ قرارٍ يَلعبونَ بهِ","على نِقادَتهِ وافٍ ومَجلومُ"],["FA86B880-F4F0-5443-A537-3B07099EBE9E","والحَمدُ لا يُشتَرى إلاَّ لهُ ثَمَنٌ","مِمَّا تَضِنُّ بهِ النُّفوسُ مَعلومُ"],["77F8C385-D6DC-59EB-9B8B-2E670A795DFC","والجَهلُ ذو عَرَضٍ لا يُستَرادُ لهُ","والحِلمُ آونَةً في النَّاسِ مَعدومُ"],["C1C5EB69-1697-52A8-8716-045EAB820314","ومُطعَمُ الغُنمِ يَومَ الغُنم مُطعَمُه","أنَّى تَوَجَّهَ وَالمحَرومُ محرومُ"],["5627B1DB-5759-5ECB-A739-F1555180B2C8","ومَن تَعرَّض لِلغربانِ يَزجُرُها","على سَلامَتهِ لابُدَّ مَشؤومُ"],["E37852B0-4A9E-52B8-BF72-1AC236245DF3","وكلُّ بَيتٍ وإن طالَت إقامَتُه","على دَعائِمِه لا بُدَّ مَهدُومُ"],["AC3118CE-90B5-5850-A108-B7837641DEC4","قد أشهَدُ الشَّربَ فيهم مِزهرٌ رَنِمٌ","والقومُ تَصرَعُهم صَهباءُ خُرطومُ"],["140250F5-0F19-5D9F-B229-F8EC9B1292E8","كأسُ عَزيزٍ منَ الأعنابِ عَتَّقها","لِبعضِ أَربابِها حانِيَّةٌ، حُومُ"],["27C7FE70-D515-5952-A0EC-E17087491825","تَشفي الصُّداعَ ولا يؤذيكَ صالِبُها","ولا يُخالِطُها في الرأسِ تَدويمُ"],["8FC28A75-0F7C-5692-AC4D-BBC042C8ADF8","عانِيَّةٌ قُرقُفٌ لم تُطُّلَع سنةً","يُجِنُّها مُدمَجٌ بالطِّينِ، مختومُ"],["CA6C4B8F-E4F5-56CE-BB04-DD7554A49A84","ظلَّت تُرقرِقُ في النَّاجودِ يَصفقها","وليدُ أعْجَمَ بالكَتَّان مَفدومُ"],["EB970357-68CC-5DF9-AF81-811C20F8F0A1","كأنَّ إبريقَهُم ظَبيٌ على شَرفٍ","مُفدَّمٌ بِسبَا الكَتانِ ملثومُ"],["14247BAC-63BE-534B-AE83-779A2F5348FC","أبيضُ أبرَزَهُ للضِّحِّ راقِبُه","مُقلَّدٌ قُضُبَ الرِّيحانِ مَفغومُ"],["2CE45AD8-9AE8-55B4-959B-AB39A3742A1E","وقد غَدَوتُ على قِرني يُشَيِّعُني","ماضٍ أخو ثِقَةٍ بالخَير مَوسومُ"],["B0B965A1-40A2-5C5B-AAF0-37A079D5CF4C","وقد عَلَوتُ قُتُودَ الرَّحلِ يَسعَفُني","يَوم تَجيءُ به الجوزاءُ مسمومُ"],["3721AFAA-30F8-5C68-9E45-CFF7384DB517","حامٍ، كأنَّ أُوارَ النَّارِ شامِلُهُ","دونَ الثِّيابِ ورأسُ المرءِ مَعمومُ"],["BF36ED95-9E20-5F84-B672-B5D58BFFE926","وقد أقودُ أمامَ الحيِّ سَلْهَبَةً","يَهدي بها نَسبٌ في الحيِّ معلومُ"],["C3C33721-6C9C-5EB7-964A-49F2117735BD","لا في شَظاها ولا أرساغِها عَنَتٌ","ولا السَّنابِكُ أفناهُنَّ تَقليمُ"],["5A11D957-149E-5443-AAC9-0468D5AF062E","سُلاَّءَةٌ كعصا النَّهدِيِّ غُلَّ بها","ذو فَيئةٍ من نَوى قُرَّانَ معجومُ"],["6C4DEE8B-60EF-5DF9-91E3-7BF57ACD7EED","تَتبعُ جُونا إذا ما هُيِّجت زَجِلتْ","كأنَّ دفاً على عَلياءَ مَهزومُ"],["020E323B-0004-51B7-BAD7-E7D9FD894A7E","يَهدي بها أكْلفُ الخدَّين مُختبِرٌ","من الجِمال كثيرُ اللَّحمِ، عَيثومُ"],["BA32C515-6351-5117-9D6D-96E9D01B883A","إذا تَزَغَّمَ من حافاتِها رُبَعٌ","حنَّت شغاميمُ في حافاتها كُومُ"],["9118684B-9FA7-5E8E-8249-BC2C3E359B38","وقد أصاحِبُ فِتيانا طَعامُهُمُ","خُضرُ المَزادِ ولَحمٌ فيه تنشيمُ"],["24A06B00-EC00-5784-91D8-09C47C7FE41F","وقد يَسَرت إذا الجوعُ كُلّفه","معقب من قِداح النَّبعِ مقرومُ"],["C4972720-F6A7-51A7-AAD8-AB2D393046BC","لَو يَيسِرونَ بِخيلٍ قد يَسَرتُ بها","وكلُّ ما يَسرَ الأقوامُ مغرومُ"]]},"D1F03F79-06E6-54A5-BE2A-C0AC6D4BC235":{"t":"ودَوّيَّةٍ لا يُهتَدى لِفَلاتِها","p":29,"s":"ودوية لا يهتدى لفلاتها","r":"436700","v":[["F30B8D5E-BCE1-5940-B736-ECA23344BEA1","ودَوّيَّةٍ لا يُهتَدى لِفَلاتِها","بِعِرفانِ أعلامٍ ولا ضوءِ كوكبِ"]]},"DFA4481D-1C4A-5CC5-BB67-14D0206FD321":{"t":"وشامِتٍ بيَ لا تَخفَى عداوَتُهُ","p":29,"s":"وشامت بي لا تخفى عداوته","r":"436686","v":[["4F977028-1B78-5E28-AB59-F574818CAA13","وشامِتٍ بيَ لا تَخفَى عداوَتُهُ","إِذا حِمامِيَ ساقَتهُ المَقاديرُ"],["A60C0433-79A9-5855-BCF2-1255D3E6DCE9","إِذا تَضمَّنَني بَيتٌ بِرابِيَةٍ","آبُوا سِراعا وأمسىَ وهْو مهجورُ"],["B56B6BFF-F66E-5360-BBE7-A52C1991D747","فلا يغُرَّنْكَ جريِّ الثَّوبَ مُعتَجِراً","إنِّي فِيَّ عند الجِدِّ تَشْمِيرُ"],["42B6C9C5-3AE7-5296-A566-EE319F2D0EA6","كأنِّي لمْ أقُل يَوماً لِعادِيَةٍ:","شُدُّوا ولا فتيَةٍ في موكبٍ سيروا"],["5DBF3399-64E2-5F9E-8366-C961EED01424","ساروا جميعاً وقد طالَ الوَجيفُ بهمْ","حتَّى بَدا واضِحُ الأقراب مشهورُ"],["9E9F6FA1-40AE-546D-B285-D0757E627556","ولم أصَبِّحْ جِمامَ الماءِ طاوِيَةً","بِالقَوم وِردُهمُ لِلخمسِ تبكير"],["9AED4E0D-44BA-50A6-9D05-E6641D4F99D9","أورَدتُها وصُدورُ العيسِ مُسنَفةٌ","والصُّبحُ بالكوكب الدُّري مَنحور"],["D57B4CF4-8096-57FD-B835-AE5BD49879A2","تَباشَروا بعدما طال الوَجيفُ بِهم","بالصُّبح لمَّا بَدَت منهُ تَباشيرُ"],["EF6DCD45-ECAE-51D4-A560-1CCE330209F8","بَدَت سوابِقُ من أُولاهُ نُعرِفُها","وكِبْرُهُ في سوادِ اللَّيلِ مستورُ"]]},"E8299394-53F3-5965-BC20-54C9EF3E531D":{"t":"وفي الحَيِّ بَيضاءُ العَوارِضِ ثَوبُها","p":29,"s":"وفي الحي بيضاء العوارض ثوبها","r":"436687","v":[["3128BBBA-A515-5C3F-A2DF-D857EFC7B141","وفي الحَيِّ بَيضاءُ العَوارِضِ ثَوبُها","إِذا ما اسبَكرَّت لِلشَّبابِ قَشيبُ"],["665485B2-CF9E-59F7-B1C8-813A2D94EB1F","وَعِيسٍ بَرَيناها كأنَّ عُيونَها","قَواريرُ في أذهانِهِنَّ نُضوبُ"],["50A73448-3600-568D-A6CE-70F7BDDD6949","ولستَ لإنسيٍّ ولكنْ لِمَلأَكٍ","تَنزَّلَ من جَوِّ السَّماءِ يَصوبُ"],["4BF3BFB0-71C6-5EF9-9ED5-9D825E8AA27E","وأنتَ أزلتَ الخُنزُوانَةَ عنهمُ","بِضَربٍ له فوقَ الشُّؤونِ وجيبُ"],["B3CD76CD-1A34-5DCE-B904-6340E2E21CB5","وأنتَ الّذي آثارُهُ في عَدُوِّهِ","منَ البُؤسِ والنُّعمَى لهُنَّ نُدوبُ"]]},"15500E31-A0D3-5EC1-9E33-44CA8E736B59":{"t":"وقال في خِلْفِ بني نهشل وبني يربوع أمسَى بَنُو نَهْشَلٍ نَيَّانُ دُونَهمُ","p":29,"s":"وقال في خلف بني نهشل وبني يربوع أمسى بنو نهشل نيان دونهم","r":"436704","v":[["F8EE0C15-2975-5E9F-A289-102750AF9753","وقال في خِلْفِ بني نهشل وبني يربوع أمسَى بَنُو نَهْشَلٍ نَيَّانُ دُونَهمُ","المُطعِمونَ ابنَ جارِهمْ إذا جاعا"],["354ABEC8-76D6-58BD-BAE7-5BA78FC12051","كأنَّ زَيدَ مَناةَ بَعدَهمْ غَنَمٌ","صاحَ الرِّعاءُ بها أنْ تَهبِطَ القاعا"],["6F75B399-0F87-536F-AC7F-25F190674A35","أبِلغْ بَني نَهشَلٍ عنِّي مُغَلْغَلَةٌ","أنَّ الحِمَى بعدَهُم والثَّغرَ قَد ضاعا"]]},"923726FA-7AC6-525D-A9A8-99BC2F2AE245":{"t":"ومَولىً كمَولى الزِّبرِقان دَمَلتُه","p":29,"s":"ومولى كمولى الزبرقان دملته","r":"436685","v":[["C2DD33FF-8ACB-5979-9BF4-775F3378D7A4","ومَولىً كمَولى الزِّبرِقان دَمَلتُه","كما دُمِلَتْ ساقٌ تُهاضُ بها وَقْرُ"],["2CE08E59-475A-59D6-AAB4-AC0C63607710","إِذا ما أحالَت والجَبائرُ فوقَها","أتى الحَولُ لا بُرءٌ جبَيرٌ ولا كَسْرُ"],["8CA60E94-C23D-52EF-86B7-BC1AAAFAA8BE","تَراهُ كأنَّ اللهَ يَجدَعُ أنفَه","وعَينَيهِ إِنْ مولاهُ ثابَ له وَفْرُ"],["C295E609-61CC-58AE-B3DE-3FD465CEC3FE","تَرى الشَّرَّ قد أفنى دَوائرَ وَجهِه","كضبِّ الكُدى أفنَى أنامِلَه الحَفر"]]},"65AA5F41-1414-5C38-8C4A-FFAEF32B598D":{"t":"ونحنُ جَلبنا من ضَريَّةَ خَلَينا","p":29,"s":"ونحن جلبنا من ضرية خلينا","r":"436703","v":[["B9B808FC-ADED-593C-8902-60734013ABD4","ونحنُ جَلبنا من ضَريَّةَ خَلَينا","نُكَلِّفُها حدَّ الإكامِ قطائطا"],["7CF182DF-8C5D-5C05-9E0B-25F3FE611FCA","سِراعاً يَزِلُّ الماءُ عن حَجَباتِها","نُكَلِّفُها غَولاً بطيناً وغائطا"],["6CF0BE96-0228-50E0-9080-A25E5D3E0EDF","يُحَتُّ يَبيسُ الماءِ عن حَجَبَاتِها","ويشكُونَ آثارَ السِّياطِ خَوابِطا"],["8DE6A886-C448-5E89-B7C2-3287D458B554","فأدركَهُمْ دونَ الهُيَيْمَاءِ مُقصِرا","وقد كانَ شَأوا بالِغَ الجَهدِ باسِطا"],["DBE82D69-7D19-5CE5-B972-E9A38E5BD6DF","أصَبنَ الطَّريفَ والطَّريفَ بنَ مالِكٍ","وكانَ شِفاءً لو أصبَنَ المَلاقِطا"],["4FF448AB-A648-55FC-9BCB-366A2AA4C3FB","إذاً عَرَفُوا ما قدَّمُوا لِنُفوسِهِمْ","من الشَّرِّ إِنَّ الشَّرّ مُردٍ أراهِطا"],["81B5815A-0A02-5D6C-9824-0892E55428AE","فلَم أرَيوماً كان أكثرَ باكياً","وأكثرَ مَغبوطاً يُجَلِّ وغابطا"]]},"353045EF-74DA-5B20-A680-27D17FB85F13":{"t":"وهل أسوَى بَراقشُ حين أسوي","p":29,"s":"وهل أسوى براقش حين أسوي","r":"436707","v":[["66608313-A3D0-57A2-B75A-5DC42BF27A27","وهل أسوَى بَراقشُ حين أسوي","ببَلقَعةٍ ومُنبَسِطٍ أنيقِ"],["4C4F19B5-609E-565C-9A57-F79FFC966D72","وحَلُّو من مَعِينٍ يومَ حَلَّوا","لِعِزِّهِمُ لَدَى الفَجِّ العَميقِ"]]},"4821F5F0-7581-56D6-AF70-E1DFB6ADF18E":{"t":"ويروى له يصف حمار الوحش: يُطَرِّدُ عاناتٍ بِرهبَى فبَطنُه","p":29,"s":"ويروى له يصف حمار الوحش: يطرد عانات برهبى فبطنه","r":"436706","v":[["D08E6E14-1185-500D-8650-F48DF590D59E","ويروى له يصف حمار الوحش: يُطَرِّدُ عاناتٍ بِرهبَى فبَطنُه","خَميصٌ كطَيِّ الرّازِقيَّةِ مُحنِقُ"]]},"F04D1F49-DF6A-5217-B05D-C06CA6CF920A":{"t":"وَأخي مُحافَظَةٍ طَليقٍ وَجهُهُ","p":29,"s":"وأخي محافظة طليق وجهه","r":"436682","v":[["BC7D41BD-FEA2-5BDC-9694-C0C7D0A3FEB7","وَأخي مُحافَظَةٍ طَليقٍ وَجهُهُ","هَشٍ جَرَرتُ له الشِّواءَ بمِسعَرِ"],["5BDA8F0B-2F2B-55D5-929C-24AB34F5E873","مِن بازِلٍ ضُرِبَت بِأبيضَ بَاتِرٍ","بِيَدَي أغرَّ يَجُرُّ فضلَ المِئزَرِ"],["EEAF7768-369F-5E40-A1FB-64AA742ACB4C","ثم راحوا عَبقُ المِسكِ بِهمْ","يُلحِفون الأرض هُدَّابَ الأزُرْ"],["770A5CA5-4938-5C8E-BE8C-3A377156F435","ورفَعتُ راحِلَةً كأنَّ ضُلوعَها","من نَصِّ راكِبِها سقائفُ عَرعرِ"],["5AA3A8DC-1E1C-58F4-B1C5-305C96B36417","حرَجا إِذا هاج السَّرابُ على الصُّوى","واستَنَّ في أُفُقِ السَّماءِ الأغبَرِ"]]},"B5406E29-696B-5A3D-8A09-56BA63B634F8":{"t":"وَدَّ نُفَيْرٌ لِلمَكاوِرِ أنَّهُمْ","p":29,"s":"ود نفير للمكاور أنهم","r":"436681","v":[["EC42CB7D-D601-50ED-91A4-F1BBFBD24034","وَدَّ نُفَيْرٌ لِلمَكاوِرِ أنَّهُمْ","بِنَجرانَ في شاءِ الحِجازِ المُوقَّرِ"],["AFDBC9C5-9AAE-5EC8-8BA5-C37F2E467C90","أسَعياً إلى نَجرانَ في شَهرِ ناجِرٍ","حُفاةً وأعيا كلُّ أعيَس مِسفَرِ"],["01F1752E-5A8F-50BA-9AED-AD43191AC8E2","وَقَرَّت لهمْ عَيني بيَومِ حُذُنَّةٍ","كأنَّهُمُ تَذبيحُ شاءٍ مُعتَّرِ"],["63C68087-0A4B-5CB3-8FD1-C135EC100DD8","عَمَدتُم إلى شِلوٍ تُنوذِرَ قَبلَكمْ","كَثيرِ عظام الرَّأس ضخم المُذمَّر"]]},"DB5BBE19-A166-5517-9164-5C17B3CA737F":{"t":"وَيْلُمِّ لذَّاتِ الشَّبابِ مَعيشةً","p":29,"s":"ويلم لذات الشباب معيشة","r":"436701","v":[["EB80640F-1269-551D-82B2-B5E7BB3E289A","وَيْلُمِّ لذَّاتِ الشَّبابِ مَعيشةً","معَ الكُثْرِ يُعطاهُ الفتى المُتلِفُ النَّدِي"],["D3E05E98-93A2-5FF5-BE05-8550DB3A6827","وقد يَعقِلُ القُلُّ الفتى دونَ همُّه","وقد كان لولا القُلُّ طَلاَّعَ أنجُدِ"],["D9EF5BDE-27DF-5E71-A6EB-2393C4CD4E22","وقد أقطعُ الخَرْق المخوفَ به الرَّدى","بعَنْس كجَفنِ الفارسيِّ المُسرَّدِ"],["BAE4F3A8-A0A7-5EF5-89CE-DABB6F4F27BC","كأنَّ ذِراعَيْها على الخَلِّ بَعدَ ما","وَنِينَ ذِراعا ماتِحٍ مُتَجرِّدِ"]]}}}