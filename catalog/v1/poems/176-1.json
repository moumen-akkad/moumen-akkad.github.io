317E61AC87C","يا مخلفا ظن كيكاووس حين أتى","يغزو معاقل إسلام وتوحيد"],["31020556-B870-5DB4-943B-F54624B5663B","في جحفل عذبات الكفر خافقة","من جانبيه بسعي غير مسعود"],["8EEBC4D4-9E82-5C90-A489-263C66099A91","فاستقبلته من الأعراب شرذمة","فبددت شمله في المهمه البيد"],["B8D72AE2-7B12-5714-A1CE-846E9A4B5AFE","نجا وأسلم للخرصان أسرته","فسيد القوم رزق النسر والسيد"],["5C571F7D-DC33-5E5F-A2C0-160533C2C31E","لو شاء شاه ارمن ما فاته دمه","لكن عفا عن أسير القلب مطرود"],["7241CFD9-F6B9-52C4-B4DD-84A9202F2268","ورد أسراه بعد السلب في نعم","ولو أطاق لأحيا كل مفقود"],["D25281D6-E59A-55A0-BA22-841F2B106BB7","هذا هو الجود لا قعبان من لبن","والجود بالنفس أقصى غاية الجود"],["0BA45709-6066-5F26-9B41-34E32CFD9036","وسائل عن أبي الفتح اختصرت له","صفاته في مقام غير مجحود"]]},"5966B07F-FFAB-5DCF-9401-601CF9B19761":{"t":"واقفة بلا تعب","p":176,"s":"واقفة بلا تعب","r":"455921","v":[["9A4EF1DB-A44B-548C-8239-0A6163E0D0D8","واقفة بلا تعب","تشكو من الصب لهب"],["48101A59-7122-5A7A-A0BC-FC015F8F84D9","كأنها في حسنها","وقد أتين بالعجب"],["78C0FB1E-4ADC-5C61-89E3-EEFB4214BD06","فوارة من فضة","تمج ماء من ذهب"]]},"C217B911-D90E-565A-9007-B5442E00886E":{"t":"وبي هندسي الشكل يسبيك لحظه","p":176,"s":"وبي هندسي الشكل يسبيك لحظه","r":"455914","v":[["89A5852F-F219-5512-9A98-CEE4527F4A37","وبي هندسي الشكل يسبيك لحظه","وخال وخد بالعذار مطرز"],["13B8F403-0998-50D2-874C-1B7A00D8FF3F","ومذ خط بيكار الجمال بخده","عذارا علمنا أنما الخال مركز وقال يمدح الصاحب نجم الدين بن المجاور العزيزي"]]},"0CEFCA4D-05B9-54EC-8732-B8B33BF0148A":{"t":"وحق الهوى عن ذكركم ليس لي شغل","p":176,"s":"وحق الهوى عن ذكركم ليس لي شغل","r":"455917","v":[["E75AC117-0CBC-5C23-9B39-1873B17A6C5D","وحق الهوى عن ذكركم ليس لي شغل","وما أنا من ينسى المودة أو يسلو"],["2B375EC0-982F-53C8-80B6-217BEDC3BB4B","حرام على عيني ترى غير حسنكم","جمالا وسمعي... عدل"],["793855C7-C798-5D34-AE65-F9BB08A33014","تعشقتكم طفلا وهمت بكم فتى","وأنفقت عمري فيكم وأنا كهل"],["FF467438-5091-50B5-9349-D564D4A84677","وما كان أهنى العيش لولا تقلت","ليالي... الصبر عن داركم يحلو"],["B0BCAD24-F4F2-5D1E-AAA5-31E36E024680","رعى الله قلبا أنتم في ربوعه","وسهد طرفي.........."],["2850363D-4E71-5411-A6CF-E0B7CF51EFA4","وما زالت العشاق في مذهب الهوى","يفرقها بين ويجمعها شمل"],["6E49D787-4DF0-59C7-BD36-B21F7898ACC2","وصب يعاني الغانيات وقلبه","تكلمه الألحاظ والحدق النجل"],["A30DA6D4-0306-5B91-9500-25813837E3D3","ومن يعشق البيض الحسان تيقنت","شمائره بالقطع إن حصل الوصل"],["FA467663-A10E-56CA-AC84-B488764A5141","ألا إن قلبي قد أصابته أسهم","من البين حتى النصل صادفه النصل"],["DA39A8B8-79B0-5B93-8E78-9EB831B801B9","كأن مقادير الزمان قسيه","رماني بها والحادثات لها نبل"],["459FF223-A9CB-5E8C-9F49-B500647C4F55","كم غرض فيه للحظ رشاق","يجرحه وهو جريح الآماق"],["17849BAE-3E84-579A-BE51-443EC0C8C828","حظي بعد بعدها والإحراق","طويل هجر وهجير أشواق"],["259C8967-A271-5D0C-B3F8-067159E8F190","ذات ذوابات وثغر براق","أبيضه لأسوديها درياق"],["889CB40B-DE2F-511F-9460-DD16E5258A7F","لو نقل الخاتم وهو سفاق","من خنصري لخصرها لما ضاق"],["BFA2E3CB-61EA-5B72-BD1D-F495B9A63E9E","للقلب أسر والدموع إطلاق","في حبها فالدمع جار سباق"],["78C17054-7FF9-5185-8CE1-523B54C49122","وروضة أبدع فيها الخلاق","لحسن مرأى وبطيب استنشاق"],["6159347F-0C28-5E7E-B209-6156978DED69","تبسم عن دمع غرام رقراق","رصع كالجوهر فوق الأوراق"],["BBC107EA-1DCB-548E-B188-0A6CCD2F807F","حكى على الأغصان درا متلاق","أو منن الفاضل فوق الأعناق"],["65B936BC-5EBD-5A74-8650-5269D3300673","له يد قد قابلت باستحقاق","بقبض أرواح وبسط أرزاق"],["CE1992D8-2718-568B-A189-69247CC1AB14","كم صرف العامل حرف قد فاق","فوعده للخطب منه إشفاق"],["9FE5D577-EAA3-58D7-9F41-98632F953A27","دوحة أفضال تفوق الآفاق","زكت فروعا ثم طابت أعراق"],["1D10022A-CBBC-50E6-A734-3CE470628DAD","للبشر في مرآه لمع براق","يولي من استسقى وليا غيداق"],["13CBAACF-ED92-580D-83A7-9B4BD01194C5","قلدني بيض الأيادي أطواق","أما ترى سجعي بين الأوراق"],["54DF47E6-4290-50AF-BA6E-59566204A5A6","أقام للذة فينا أسواق","يردفها من سر قلب إشراق"],["8843ADFB-1E2B-5A8C-B61A-18C4C7A1E002","إني وإن حذوت حذو الحذاق","مقصر لصيغة الإستغراق"],["BDE2D320-C72D-5FD8-B54D-2E935A88E653","هل يلحق النجم العلي لحاق","أو قلة مثل خضم دفاق"],["36ACFF71-DE2B-51E9-87C5-D4FC9E87CAE3","هنئت عاما قد أتاك يشتاق","تفني ألوفا منه في عز باق وله"]]},"2E3E11E6-D005-5E62-9E73-535521464360":{"t":"وحق من بدل نومي بالسهر","p":176,"s":"وحق من بدل نومي بالسهر","r":"455901","v":[["A42818CE-49CE-50B4-B234-C0AE93F63EC4","وحق من بدل نومي بالسهر","وعذب القلب بأنواع الفكر"],["C1BDF4E8-9CE6-56D8-AEA8-A48D7BE095B3","وأسقم الجفن بسقم جفنه","وأسهر الطرف وللقلب أسر"],["9F7DCECB-11F4-536E-8B2E-F68A91B223FF","ما خلت ذاك الوجه لما أن بدا","في جنح ليل شعره إلا قمر"],["2547D80E-5970-5052-97DB-2E6A452BE9C3","وهو فما ظن دموع مقلتي","بما جرى من فيضها إلا مطر"],["B3B81F5C-0B58-593E-84F5-BD16A82E050E","أحور والفتور حشو جفنه","يا حبذا ذاك الفتور والحور"],["74B0DA29-AF65-5058-8D55-6B91196D9E13","مر بنا يخطر في مشيته","والقلب من خطرته على خطر"],["6993BD7F-3DB2-53F1-A474-80D6FF9A0C23","هز لنا من قده رمحا ومن","ألحاظه يا عاذلي سيفا شهر"],["FC7E33C4-455E-5689-AF8C-591ACD5580DB","مخالف إن قلت دع زيارتي","زار وإن قلت له صلني هجر"],["25B01C02-6182-59A2-900C-DB0A45431C24","والله ما عاتبته إلا وفي","ولا وفيت عهده إلا غدر وقال يهنيء علم الدين ابن الصاحب بالعافية"]]},"CDF41B79-A54D-5027-802B-E3921C5F511B":{"t":"وغيد تعاودوا بليل الوقود","p":176,"s":"وغيد تعاودوا بليل الوقود","r":"455887","v":[["0C91196D-8F8E-5F75-AC5F-1D0DD71C616F","وغيد تعاودوا بليل الوقود","وشيطان طرفي لهم يسرق"]]},"77D7D012-9D51-5A19-9561-1DD4A80EBF95":{"t":"ولما رأيت الليل أسود فاحما","p":176,"s":"ولما رأيت الليل أسود فاحما","r":"455846","v":[["8E990E58-B79E-58BD-BF96-E92CCF3C4A71","ولما رأيت الليل أسود فاحما","وللبحر وجه أبيض راق مرآه"],["46CD73AF-E3F0-5CA3-9EA9-C950714DFA55","تذكرت من موسى خصالا كريمة","سواد سطاه أو بياض عطاياه وقال يصف سواد الغيم والهلال والشهب ارتجالا آ"]]},"94525F55-5E4B-598F-BCC4-2F140E42E4C6":{"t":"ويح قلب المحب ماذا يقاسي","p":176,"s":"ويح قلب المحب ماذا يقاسي","r":"455884","v":[["1265FC24-23A9-5AE2-98BE-F97802AD00C9","ويح قلب المحب ماذا يقاسي","كل قلب عليه كالصخر قاس"],["F1D394B8-09B4-5442-929F-A248E2F37C35","يا جفوني أين الدموع فقد أحرق","قلبي توقد الأنفاس"],["49C68077-4FDF-5DFE-9359-1B70D23360E3","وجد وجدي بحب لاه وأودى","بفؤادي تذكاره وهو ناس"],["11809787-CC86-53B9-8FDE-9F889B05E010","من بني الترك لين العطف قاسي","القلب سهل الخداع صعب المراس"],["B0613C34-9FA0-5E0E-9FFF-3A7DC735F74C","ضيق العين وهو من صفة البخل","فإن جاد كان ضد القياس"],["C24FDD78-E96F-53AA-8553-5E02505FDC56","جذب القوس فاكتسب وجنتاه","ثوب ورد طرازه من آس"],["B403B1C6-4448-5589-B45F-E6F6F046BE8F","ورمى عن قوسين سهمين هذا","في فؤادي وذاك في القرطاس"],["3035B6DF-D04C-5A93-8E0F-A6607FAAFBEC","فهو تحت السلاح ليث عرين","وهو فوق الفراش ظبي كناس"],["FDDD80B0-AFE8-5D44-B2AE-46AFE861EE7D","يا نديمي بالله عن بذكراه","وموه عن ريقه بالكاس"],["A12927B5-DC68-522B-829E-4B6C8757A7C8","واغتنم لذة الزمان فما جلق","إلا باللهو والإيناس"],["E49055B8-BBA7-54DC-B510-C468D28BE39F","حبذا النيربان من نهر ثورا","واخضرار المروج من باناس"],["E90D3171-6A23-5691-8651-B90D9BB7C3FA","والنسيم الذي يمر على الغوطة","ريان عاطر الأنفاس"],["EF06F16C-A6F5-56E5-AC7B-73CA5402DDD8","بلدة حلها الوزير فمرعاها","خصيب والناس في أعراس"],["CD4AAA4B-2FB4-5658-A263-8DD5C9E51557","قل لرائيه قل أعوذ برب الناس","هذا الوزير رب الناس"],["C3E4E022-3AB7-5B96-B4A5-AC14A41DDDA5","هيبة تملأ القلوب وشخص","تمتلي منه أعين الجلاس"],["DFB80E87-B150-5152-8349-AE2DDD7392F7","وذكاء يستفيض الأبحر السبع","وحلم له تخر الرواسي وقال"]]},"719D6E16-8471-5F8C-951D-DA606CD42E2F":{"t":"ويملأ غيره كيسا فكيسا","p":176,"s":"ويملأ غيره كيسا فكيسا","r":"455836","v":[["214529EF-B124-5E99-A097-E99B8F27E514","ويملأ غيره كيسا فكيسا","وملء زمانه كرم وعدل"],["57460334-D0AF-5A07-9D89-A220FE037C0C","وقالوا حفظ هذا المال عقل","فقال نعم وبعض العقل جهل"],["1B5FB150-2685-5C41-88C2-5DB72F4D63E2","فليس يذمه إلا مطايا","إلى أبوابه تنضى وسبل"],["16CBF956-D8B7-5577-806A-71DAEB41524B","تملكه البلاد قنا وجرد","وبتر من يطاولها يذل"],["E0904955-FA9D-5232-850A-2F9185ADF806","إذا انبثت عساكره اتساعا","تضايق دونها حزن وسهل"],["C9972491-7C56-5D9F-802F-68EC0EC46B14","بوارقها لعين الشمس داء","وعثيرها لعين الشمس كحل"],["F0DA3CB6-8287-5A33-9B54-B50F59EE95E6","تأمل في الكنانة منه سهما","سديدا لا يطيش ولا يزل"],["ABAF3FF5-2DBE-54BC-9E8D-EBABB1C7336B","ففتاه وراسله اختصاصا","ورواه الحديث وذاك فضل"],["ECFC4383-186D-5E9A-8FDA-A29A82377456","فزادت هذه النعمى ودامت","عليه فإنه للخير أهل وقال يمدحه"]]},"C888EF5B-5FC3-548B-9A87-78A950DA8850":{"t":"يا بارقا أذكر الحشى حزنه","p":176,"s":"يا بارقا أذكر الحشى حزنه","r":"455824","v":[["E1F4ED7D-D35F-51A9-B348-7964CFE3D57C","يا بارقا أذكر الحشى حزنه","منزلنا بالعقيق من سكنه"],["84DF5266-7846-5BE6-9ED0-B38E5CF90EBA","ومرتع اللهو يانع خضر","أم غير الدهر بعدنا دمنه"],["107966CF-AB63-5453-9B3C-171887A63ADF","يا برق هذا جسمي يذوب ضنى","ومهجتي بالعقيق مرتهنه"],["3AE2887C-0927-5852-AE56-4D3D1F5AACE3","يا برق أشكو عساك تخبرهم","وكل من هام يشتكي شجنه"],["A0529A92-2F78-5F9D-BE77-2B01F4D357BC","بلغ حديث الحمى وساكنه","لمغرم أنحل الهوى بدنه"],["C60CDB57-2898-5845-91A0-A16EB3B1EFFF","أسمعه ذكر الحبيب مقتربا","فقد أصمت عذاله أذنه"],["D7A0E7AB-493E-5581-96F3-9178A95C3A97","هم آنسوه لكن بوحشتهم","ونفروا عن جفونه وسنه"],["10C4CF95-068B-5925-8B60-C7D38295FB9C","أشقى المحبين عادم وطرا","فكيف إن كان عادما وطنه"],["9FDB2948-C6B2-56E6-B95F-C44438AA23B3","سقيا لأيامنا التي سلفت","كانت بطيب الوصال مقترنه"],["165BA736-50AD-5089-B943-626F427484EC","لو بيع يوم منها وكيف به","كنت بعمري مسترخصا ثمنه"]]},"596C6993-7249-5F65-B798-F2DE644A0610":{"t":"يا رائد القوم هذا النبت والزهر","p":176,"s":"يا رائد القوم هذا النبت والزهر","r":"455866","v":[["EE41E01F-09C5-599A-A35E-BF55E4B63EB5","يا رائد القوم هذا النبت والزهر","يا شائم البرق هذا البحر والمطر"],["DE3A493E-3998-5335-9CBF-905245F7B367","يا خابط الليل لا تهديه بارقة","بشراك بشراك هذا الشمس والقمر"],["F9B359AE-F8D4-5E66-9FA8-C904FF0D0CC7","عيسى وموسى فذا يحيا الأنام به","وذا به حجر الأرزاق ينفجر"],["23A81BDE-6CF0-5048-8ECA-877B0E18B1B1","فرعان من خير أصل طاهر بسقا","ما أنجب الأصل إلا أنجب الثمر"],["528EBB3C-A819-5647-944F-B953478CDA56","ملكان حلا من العلياء في شرف","سام أشم منيع المرتقى وعر"],["C92FEE99-B7E1-55CD-A618-945167CFF023","حيث النوال قريب المجتنى خضل","ومنهل الفضل سلسال الندى خضر"],["5C146623-457D-5EE9-BAD5-2D3CDD938D76","أنظرهما واستمع آثار جودهما","حتى يوافق طيب المخبر الخبر"],["3FFDC7EA-64D9-5E18-85DD-89FB750181F9","مدا على الأرض ظل العدل فاشتبهت","فيه الظهائر والآصال والبكر"],["3CDB1E1F-0D01-5931-9609-9A830F79A899","بآل أيوب قر الملك وانحسرت","عن صفحتي مائة الأقذار والكدر"],["4D7B1621-67C3-5CAC-97B7-B56E84810F93","خذ ما تراه ودع شيئا سمعت به","هذا هو الصدق لا ما تكذب السير"],["D08DBF09-343B-51E4-8F48-A7E0B538C30B","الله يا آل شاذي شاد مجدكم","وما بنى ربنا لا يهدم البشر"],["F09E89B3-B8DF-50DB-9ACC-0C1A6A10CDE2","والله خيب ما ظنوه وانتظروا","والله حقق ما نرجو وندخر"],["2FFA4776-4B7A-5480-91DB-B6EE5D9FA7B8","ردوا السيوف إلى الإغماد واحتكموا","فيما أردتم فقد أغناكم القدر"]]},"6A0C3AA1-57E4-557A-89E8-34ADA43FABBD":{"t":"يا ساكني السفح كم عين بكم سفحت","p":176,"s":"يا ساكني السفح كم عين بكم سفحت","r":"455817","v":[["30E46FC3-2F01-577C-9006-AB0C68FBA2A1","يا ساكني السفح كم عين بكم سفحت","نزحتم فهي بعد البعد قد نزحت"],["C1FCC4E8-707C-5C2A-835A-31C35E82094C","لهفي لظبية إنس منكم نفرت","لا بل هي الشمس زالت بعدما جنحت آ"],["276680CC-6AC4-5754-A90B-703C7C0D5A89","بيضاء حجبها الواشون حين سرت","عني فلو لمحت صبغ الدجى لمحت"],["A53857CE-0029-5EBB-9DF9-65E66B9157DC","يقتص من وجنتيها لحظ عاشقها","إن ضرجت قلبه باللحظ أو جرحت"],["1F3806C8-F517-536D-B983-23B968FC2E1A","من لي بسلم وفي أجفان مقلتها","للحرب بيض حداد قط ما صفحت"],["2C2B4BB6-ED01-5A58-A794-60016B7837AC","يهتز بين وشاحيها قضيب نقا","حمائم الحلي في أفنائه صدحت"],["EF299631-75E7-55C5-92DD-3E908B06767D","وأسود الخال في محمر وجنتها","كمسكة نفحت في جمرة لفحت"],["8E1CED8B-BF6F-53C9-A46A-71EDA8FE4835","لها جفون وأعطاف عجبت لها","بالسقم صحت وبالسكر الشديد صحت"],["C7CA6242-8E3C-5771-A67D-B45D48669718","وروضة وجنات الورد قد خجلت","فيها ضحى وعيون النرجس انفتحت"],["5080DC6B-D185-5505-9A8E-AB5EC58CAEDE","تشاجر الطير في أشجارها سحرا","ومالت القضب للتعنيق فاصطلحت"],["3CF4959A-4A34-5E7E-8222-3EC2A9FD676C","والقطر قد رش ثوب الدوح حين رأى","مجامر الزهر من أذياله نفحت"],["4CAC73EA-3364-56E5-A301-A9B070E69C0D","باكرتها وحمام الروض نافرة","عن البروج بكف الصبح إذ وضحت"],["47AB0723-FB45-5C5C-BAB4-39FDB5293CC7","ما بين غدران ماء كاللجين صفت","وأكؤس كنضار ذائب طفحت"],["B38B2509-0FBD-5A61-9DCE-6A6D2AE8FC89","بكر إذا ابن سماء مسها لبست","ثوب الحباب حياء منه واتشحت"],["FB1C4708-F5D9-5D98-BE1C-A7E72CA1EC50","تشعشعت في يد الساقي وقد مزجت","كأنها بنصال الماء قد ذبحت"],["69E3E609-5B76-5ACF-A7AC-558C735CE78A","يسعى بها أهيف خفت معاطفه","لكن روادفه من ثقلها رجحت"],["117B582E-1CCD-5E0B-8641-E70EA59096FE","للحسن ماء ومرعى فوق وجنته","ربيع عيني فيه كلما سرحت"],["250F0285-270D-574C-A9DC-9521DDFD4DA8","قالوا تعشق سوى هذا فقلت لهم","لي همة لدني قط ما طمحت"],["5A7BF7BA-2307-5040-A439-6F7BC283C53C","في أحسن الناس أشعاري إذا نسبت","وفي أجل ملوك الأرض إن مدحت"],["7038E0C5-B4AF-5C65-93BE-A94B0F600B99","يا طالب الرزق إن سدت مذاهبه","قل يا أبا الفتح يا موسى وقد فتحت"],["22746EED-9FF6-5760-BDB9-44A1B587CE9A","لله كم روضت يمناه من زمن","جدب وراضت جياد الجود إذ جمحت"],["B3E8BBA9-76D9-57E7-BB72-DE76211FA8E8","يخفي عطاياه والأيام تظهرها","هيهات تخفي رياح المسك إن نفحت"],["BF524C7F-5D33-5EBD-9066-8C63B4B2A262","سامى السماك علوا فاستطال ولو","ناوت ندى يده الأنواء لافتضحت"],["4B9E0A69-7674-5E85-906F-0FD5072AFDB4","ملك إذا التطمت أمواج عسكره","سبحت والخيل بالأبطال قد سبحت"],["A197059F-87F1-57E7-A510-4836D84DA4E0","ريح إذا ركضت رعد إذا صهلت","برق سنابكها في الصخر قد قدحت"],["69169572-2DD1-5CBB-80E1-9C2302D482A7","جرد إذا لاعبت أعطافها ملئت","تيها وإن لمحت أقرانها مرحت"],["4E65B5E0-883D-5E69-8227-C4AF59648A4E","تلقى الأسنة عن فرسانها كرما","فكل جارحة منها قد انجرحت"],["BB801501-B8D7-5964-BF80-425321FF25F3","يحملن أسدا لها سمر القنا أجم","في معرك الموت لا أقعت ولا كلحت"],["3D1843BC-1514-53B4-AD02-C8830E12F6BE","يصلى أمامهم نار الوغى ملك","ضاقت بأعدائه الأرض التي انفسحت"],["FAEF7A04-AB3A-5055-85A9-0BC411C1D69A","إن كان أضحكهم وعك ألم به","فلتبكهم بعد هذا صحة صلحت"],["790696A6-5633-5C39-8CDB-59D316766661","أصبحت كالشمس ما شينت بمنقصة","بعد الكسوف إذا أنوارها وضحت"]]},"AF8B55B7-FF23-5DFA-A231-D5EE5F8F88E7":{"t":"يا طيف يا أكرم طيف قد طرق","p":176,"s":"يا طيف يا أكرم طيف قد طرق","r":"455892","v":[["D8D12AF0-12F2-552A-90E5-D01467CF83B0","يا طيف يا أكرم طيف قد طرق","لمثله تعقد أجفان الحدق"],["0702A125-3110-5421-8F30-029F3BD13DF4","تراكضت خيل دموعي ودمي","في حلبة الخد فللحمر السبق"],["2872BA9B-538E-5F60-877B-5BB74741F049","جدت فلولا أن أراك زائرا","ما عتقت عيني من رق الأرق"],["FAF13BC8-68FE-5C3B-897E-F68A7EE6A4BA","هل من سبيل أن أروي عطشي","من برد الثغر الذي قد اتسق"],["1A26D41F-8945-5594-95B8-0E68A3454C99","مهفهف جبينه وشعره","ينتسبان للصباح والغسق"],["336DDA2B-B4B5-5835-8085-C128024D1299","خضرة خديه ربيع ناظري","كالغصن في أول إخراج الورق"],["06A5676D-0B9C-58A4-97B4-A552B3A60B4F","حلو اللمى يميل من خمر الصبى","طوبى لمن قبله أو اعتنق"],["B0C231A0-4258-5FBC-950D-FC79DF618CE2","حذار من جمرة خديه فقد","تجاسر الخال عليه فاحترق"],["068EE708-7AC2-5D8F-A590-5AD5ED0AF132","يا أيها العاذل ما لي سلوة","عنه ولا حبي له كما اتفق"],["24A0BFF6-0C68-5587-8644-EB45098499BD","دع الفؤاد عند ذكر حبه","يخفق فالعذر له إذا خفق"],["6E225D8D-027B-5B5C-989C-D5EB390438DF","ما كنت يا طيب زمان وصله","من دولة الصاحب إلا مسترق وقال"]]},"52EEDF91-FFDB-51A1-B611-45A12587EBB0":{"t":"يا قلب كم ذا اللجج الفاضح","p":176,"s":"يا قلب كم ذا اللجج الفاضح","r":"455864","v":[["34B40ECA-418D-50A8-BBC1-E221D3B30737","يا قلب كم ذا اللجج الفاضح","راح بك البارح والسانح"],["4AD1D94E-21D0-51C2-AA69-2B7CEF3A733C","شقيت في الحب وأشقيتني","ورب جد جره مازح"],["A2208589-4EDA-5F80-8EF8-473F43CE9367","هويته بدرا على بانه","على نقا مثقلة راجح"],["6A061B95-001B-5122-ACEE-497B97F8D559","الليل في طرته مبهم","على جبين صبحه واضح"],["F882416A-B91E-503C-908D-28BB35B9C1C0","كأنما العارض في خده","نمل إلى شهد اللمى سارح"],["EA67D56B-1748-509E-AC52-52606E1495D1","لو ذقت لا ذقت جنى ريقه","من دره الناصع يا ناصح"],["44A69A98-8CCB-5E8B-9C7C-769B7D710C1B","عذرت من أنت له لائم","رحمت من أنت له كاشح"],["14EC0A11-A693-5A2B-A8A9-203D00F1EBA4","تظنه لما رنا وانثنى","أعزل وهو السائف الرامح"],["C20A68C6-B342-5AE9-8082-592F983FB1D6","القلب مني طائر خافق","واللحظ منه كاسر جارح"],["496ACEC0-A6B2-5145-A8BB-4139D34FEA80","سقى وزاد الكأس من طرفه","فكلنا من سكره طافح"],["F812B7DE-5D8E-52B5-8ADA-0F53A12F65CD","راح تطير النار من دنها","كأنما بازلها قادح"],["031F6488-64D3-569F-9DAF-2FF0DDE66539","أنكرها الخمار ضنا بها","حتى هدانا عرفها الفائح"],["8F905870-C929-515C-84E0-D6B07752A658","فزنا بها عذراء غانية","بختمها ما افتضها فاتح"],["947C7E6D-1756-5E88-97A6-483E59A52A27","يا نائما والنجم في غربه","والصبح من مشرقه لائح"],["9EC4F6B7-E84D-5041-A269-942FB92A6E7A","دع كدر العيش وخذ ما صفا","تحي ويشق الدائب الكادح"],["C17856A0-6910-517B-A124-8CFA75D24D95","قد نضح الطل رداء الربا","واشتجر الباغم والصادح"],["6AF71A67-6951-5251-BA74-E67B8B5F7FC8","وجادت الدنيا على أهلها","واصطلح الأشرف والصالح"]]},"9EA4995D-4A3B-50A9-9842-895E969544FA":{"t":"يا ملك الأرض وإن كان في","p":176,"s":"يا ملك الأرض وإن كان في","r":"455810","v":[["104619BF-4378-5442-BE22-2FC3EA52D717","يا ملك الأرض وإن كان في","حصونه يا ملك الفرقد"],["0A97DC6D-47E3-5E87-94E2-387E184BB7E5","ملاتها بالخيل والرجل والبيض","المواضي والقنا الأملد"],["749F4F98-B1A3-502D-8C9D-6AEEE57D12AB","تكاد أن تزحف يوم الوغى","إلى العدى من أفقها الأبعد"],["3D2C259C-290A-50B6-8B93-7F2FBE1930D1","لبست منها تاج ملك على","كسرى أنو شروان لم يعقد وقال يمدحه"]]},"5A431489-6422-5DD3-BCA9-4BB3DDD07733":{"t":"يا من حكى الجنة في خيمة","p":176,"s":"يا من حكى الجنة في خيمة","r":"455850","v":[["95811705-FE38-5C4C-8505-2DD2EAF6790F","يا من حكى الجنة في خيمة","بوابها المحسن رضوان"],["9749DB01-4C8F-500F-831C-4EE1DA5F2EEE","الإنس والوحش قيام بها","والطير أجناس وألوان"],["51C0CE0E-6BD5-50F3-BDB9-A9D73F518CB2","يا سيد الأملاك بين لنا","أأنت موسى أم سليمان واندفقت في مجلس الأنس جرة ذهب فقال ارتجالا"]]},"8B9ECC72-3FC4-56BF-963B-AA76B6D2C916":{"t":"يا نار أشواقي لا تخمدي","p":176,"s":"يا نار أشواقي لا تخمدي","r":"455809","v":[["B2AB66EC-C8A9-5723-9C57-E1EF44891177","يا نار أشواقي لا تخمدي","لعل ضيف الطيف أن يهتدي"],["92D954C1-697D-5114-BA77-F68120FD96A2","حسبته ماء فصادفته","لمع سراب ليس يروي الصدي"],["68E2A916-0469-57CE-93B1-0D29D9F58530","تكلفت عيني له هجعة","كنغبة الطائر في المورد"],["92FE9DB2-1CCD-51D4-A94D-1D1AB59BCF17","صور في مرآتها صورة","تجل عن لمس فم أو يد"],["5AB9D51A-3436-550A-BA63-F25D5DD97B64","إن نعمت في الليل روحي به","فسوف يشقى جسدي في غد"],["17DBE50F-B39A-552B-9B0C-F96821DF3449","الصد والهجران قد جمعا","بالله قل لي فبمن أقتدي"],["69B34912-7A8C-57CB-882C-A3BA13D568B0","أشكو إلى الله ملولا إذا","قلت انتهى في هجره يبتدي"],["99441BAB-B651-5C38-B3DE-171E40127EA4","البدر في مكسر شربوشه","حف بليل الشعر الأسود"],["96ECFDF2-E690-5552-AF5C-8D9AA231CE10","ريان في قرطقه جدول","لكن له قلب من الجلمد"],["72004928-CF4F-5E44-BCF4-FAFFED9DE0E2","كأنما هيمانه برزخ","يمنع موج الردف أن يعتدي"],["A149B1D0-F216-56F2-BAAF-93086CC1F340","غازلنا من نرجس ذابل","وافتر عن نور أقاح ندى"],["D569E232-B91B-50AB-91CF-F48CB97E5EC0","وقام يلوي صدغه قائلا","لا تغترر بي فكذا موعدي"],["56E4FC72-A8A3-519C-A9E0-FB42022592E0","فقلت يا لله مات الوفا","فقال موسى لم يمت خذ يدي"],["A64122CA-5D44-5095-B011-50900CA8C69F","الملك الأشرف شاه ارمن","رب المعالي والندى والندي"],["BEB1AE34-E174-5F23-9EA5-658F44814914","ملك له الفضل على آدم","والفضل لا يكسب بالمولد"],["4718F431-5F0F-5937-9FFD-9E4BED4077C8","لو لم تر الأملاك في صلبه","غرته الغراء لم تسجد"],["0108806F-B966-5C20-A413-5B25D1E8B2FB","الطاعن النجلاء مكحولة","ناب لها النقع عن الإثمد"],["FFC7753A-CFF3-5CF1-A8C1-3AE3DD1022A2","والضارب الفوهاء مفترة","عن صارم كالمبسم الأدرد"],["027C6A5D-D6FD-5A45-9A71-7B45B646E7A5","يصدى إذا أرواه ماء الطلى","وأعجب الأشياء ري الصدي"],["FCC05BB8-BBD6-5AC8-9AA1-85D46B465857","تقول للخرصان أسيافه","بنا كفيت الطعن لا ترعدي"],["F604888C-22D5-5286-8A9F-55280993E3B6","نحن بسد الثغر أو فتحه","أدرى وقد قمنا به فاقعدي"],["06576F1E-92CD-5329-9CAA-22125B69DDCD","سله تجد أفتى جميع الورى","فليهتد السائل أو يجتد"],["9DAF4E13-8860-5E0F-B504-CAF73246DAE7","يزري على قبح عبوس الحيا","حياؤه الطلق الجميل الندي"]]},"FBA94B9A-F0FD-5602-BEE4-F21423327F2D":{"t":"يستوجب النصر من صحت عزائمه","p":176,"s":"يستوجب النصر من صحت عزائمه","r":"455909","v":[["F03436A5-1904-5263-8CD2-1BC5B28E2F16","يستوجب النصر من صحت عزائمه","ويقتني الشكر من عمت مكارمه"],["3F90DFD2-9472-5C38-8E26-0F37F362DD11","بالنفس والمال نال المجد طالبه","إن العظيم لمن هانت عظائمه"],["281AE12E-C4CB-55FF-8B43-153F773193C7","في كل دور لهذا الدين منتظر","يشيده بعدما تخفى معالمه"],["F44BD6FD-EDDB-521E-99F9-A896831F6198","فاليوم كل إمامي يوافقنا","بأن شاه ارمن المهدي قائمه"],["2370D38A-2C15-55ED-859D-205A9120CB77","من يملأ الأرض عدلا بعدما ملئت","جورا وتكشف عماها صوارمه"],["198DC18C-7237-54EC-BE6C-0C5AA520E0CF","يا يوم دمياط ما أبقيت من شرف","لمن تقدم إلا أنت هادمه"],["65FEB8E2-101F-5524-A258-1D662589A483","عذراء نادت على بعد فأنقذها","ملك غيور مصونات كرائمه"],["73F2E676-40E1-5F5D-91A9-9CC67C27EE9F","رأت بنو الأصفر الأعلام طالعة","والنقع يرمد عين الشمس فاحمه"],["D1578E26-2FD7-5397-A09D-F030EEB826D8","والجيش يلتف قطراه على ملك","كالليث يزأر حوليه ضراغمه"],["5EF1F324-7A45-5C3E-A6F0-0B61BBB74117","والجو يبكي سهاما كلما ضحكت","عن كل برق يماني غمائمه"],["FAD3E11B-AAD9-5B33-B71E-47475A1C517C","وكل طرف إذا طال الطراد به","يطير من جلده لولا شكائمه"],["7BF6D131-0352-57B5-9151-7C262B8B9AAC","وديون دمياط بحر حال بينهما","من الظبي ليس ينجو منه عائمه"],["6CA62B91-39C2-55A6-8CB5-227A5E14B16B","صاحوا الأمان فلا سيف نضته يد","منهم ولا حملت طرفا قوائمه"],["D64F80DF-274B-589A-B187-B8F6C65E4E86","ذلوا لملك أعز الله صاحبه","موسى سليمانه والسيف خاتمه"],["1EF8E865-641A-58AF-A64E-A1BFB12C3DD7","وسلموها وردوا أهلها ومضوا","والثغر من فرح يفتر باسمه"],["0943964C-3D14-580B-9C00-6C9818F994B6","كأنهم أبصروا ما قد مضى زمنا","كما يرى مزعج الأحلام نائمه"],["89AAB724-0DFE-5246-A289-858A4BA7D51C","طهرت محرابها العالي ومنبرها","من رجسهم بعدما ارتجت قوائمه"],["BEE51F51-F073-516C-890E-52B7B5955AD1","وقمت تكسر تمثال المسيح به","برغم من هو باللاهوت لاثمه"],["2B8FA1F4-7809-5612-9131-7C2C56912D4A","أشبهت جدك إبراهيم واتفقت","على عزائمك العليا عزائمه"],["31AAF5AE-AC74-5209-8DDB-39219298ABCD","قل للكماة وسرته سلامته","أشد موت الفتى عار يلائمه"],["82CF0FA5-66D7-568D-99AC-7F61023D7B08","عادوا بخزي إلى أوطانهم ومضوا","فكل بيت تلقاهم مآتمه"],["B07B73C1-3E98-5CD7-A347-8D9958D78807","تبكي القسوس على أسرى ملوكهم","وذاك ذل قضى بالعدل ظالمه"],["DF28EAD0-588B-54C6-B7EE-DEC2B8F9B2DA","يا باذلا في سبيل الله مهجته","لله لا للذي حازت مغانمه"],["447B6F9E-8E76-5F3D-BC4A-D45EEB4A8700","لولاك زلزل قبر المصطفى ووهى","وأصبح البيت قد حلت محارمه"],["E0D644AF-9E0C-5F92-9A6A-2AA7012EE6A4","قضيت في الغرب مفروض الجهاد ولو","فرغت للشرق ما قامت أعاجمه"],["329E3F96-EA38-53EB-9852-0E36DC8CD5CF","أنسيت من فتح عمورية شرفا","ومات دون أبي تمام ناظمه"],["465A3FC1-B70A-5222-9D5C-7813DFABCBB9","أقول للحاسد المحزون ذا ملك","نال السعادة مذ مدت تمائمه"],["97A29C37-7D25-53FA-81E9-80346826A331","ماذا عطية نجم دار في فلك","النجم والفلك الدوار خادمه"],["5EA25125-B322-542C-AA24-D78483FB308A","هذا اختصاص إلهي ومرتبة","ما في الملوك عليها من يزاحمه"],["99A9AD89-9201-5ED6-B3B4-4C890906001D","مولاي عذري سقم قد برى جسدي","وكيف ينهض من قصت قوادمه"],["0BD871CD-8B2F-5E3C-B09E-9208995C2C6A","قالوا تأخرت والتأخير ينقضني","من جود من عمت الدنيا مكارمه"],["ED990028-7B2D-5E84-9F0C-8FD4AA10B197","لا أرهب الدهر أن يثني مؤونته","لا أختشي قطع رزقي وهو قاسمه"],["4D78714E-2CF8-51D3-A8FB-41D7DE87FDD8","لا فارقت ألسن المداح دولته","فأحسن الروض ما غنت حمائمه وقال أيضا"]]}}}