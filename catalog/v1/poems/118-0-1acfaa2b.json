{"v":1,"poems":{"10438160-2360-54E2-A0F2-ECC88A9D7D37":{"t":"أشار لحظي بعين علم","p":118,"s":"أشار لحظي بعين علم","r":"450245","v":[["500C76E7-7801-57DE-938E-C85402F9D3FA","أشار لحظي بعين علِــم","بخالصٍ من خِفّي وَهْم"],["94C7D0BA-B088-5715-A4A6-208C9B44EBB4","و لائحٌ لاح في ضميـري","أدقّ من فهم وهم همّي"],["0BCAE297-94E5-5D4B-90C2-B586DEAC524F","و خضتُ في لجّ بحر فكري","أمُرُّ فيه كمرّ سهـــم"],["9DB37B2C-1B93-50DB-8021-9C7A42AFC4BE","و طار قلبي بريش شوقـي","مركّب في جناح عزمي"],["EBF9172C-BCF0-5CEB-A293-336078883803","إلى الذي عن سُئلتُ عنـه","رمزت رمزاً و لم اسمّي"],["7FC1C4F0-3C33-5D89-87C1-E66281F9F318","حتّى إذا جُزْتُ كل حــدّ","في فلوات الدنّو أَهْمِـي"],["C925EDBB-94AD-56B8-9A9D-3B565D4F42A6","نظرت إذ ذاك في سَجَـالٍ","فما تجاوزتُ حدّ رَسْمي"],["876FB978-B80B-55AA-B631-7D217A3AA134","فجئتُ مستسلما إليــه","حدّ قيادي بكفّ سلْمـي"],["FCDB2649-386E-54A7-9AD4-F36D035859FF","قد وسم الحبّ منه قلبي","بميسم الشوق أي وسـم"],["0E0E1D4C-51FC-58FD-BACD-1A650CA0632A","و غاب عنّي شهود ذاتي","بالقرب حتّى نسيتُ اسمي"]]},"CF5A6B3B-823C-5B7A-9965-01ECAA4FAC24":{"t":"أقتلوني ياتقاتي","p":118,"s":"أقتلوني ياتقاتي","r":"450248","v":[["CD41BB48-6FF5-555B-9A38-EF140BBBBC79","أُقْتُلُوني يا ثقاتـــي","إنّ في قتـْلي حياتــــي"],["B3EBC65E-8084-5C11-97CD-B4D57BA3CBB3","و مماتـي في حياتـي","و حياتي في مماتـي"],["74281B32-5D92-568A-A457-6B597E560DCF","أنّ عنـدي محْو ذاتـي","من أجّل المكرمـات"],["CB0DE796-CD84-5B4C-AC65-5A895ABC32DF","و بقائـي في صفاتـي","من قبيح السّيّئــات"],["918B8A36-45CE-5251-A4E4-369FD9A0E1AF","سَئِمَتْ نفسـي حياتـي","في الرسوم الباليـات"],["A96200FA-FAD6-5DFF-AF53-08850BAE00BF","فاقتلونـي واحرقونـي","بعظامـي الفانيــات"],["B4A821E1-EE55-5B4B-8F6D-15A43ECADDB4","ثم مـرّوا برفاتـــي","في القبور الدارسـات"],["CBC7A897-53E5-53B8-BB15-E4F568B5FE35","تجدوا سـرّ حبيبــي","في طوايا الباقيــات"],["88478E93-499D-54B8-8F63-C2BB92D89DDB","إننـي شيـخ كبيــر","في علوّ الدارجــات"],["A130F41D-1B07-5267-B568-FE50576FEAAC","ثم إنـّي صرتُ طفـلا","في حجور المرضعات"],["F49E9A07-FEDB-5D88-8578-3879CFDB150E","ساكنـاً في لحد قبــر","في أراضٍ سبَخــات"],["0372AF44-472B-5F4D-B1FB-C2794A05463F","وَلدَتْ أُمّــي أباهـا","أنَّ ذا من عجبـاتـي"],["E08CF493-B0E2-5C8C-8FE1-77307ED03AD6","فبناتـــي بَعْـدَ أنْ كـ","ـن بناتـي أخواتــــي"],["0E21199D-62B5-5ACC-886B-09DAD17A1E01","ليس من فعل زمــان","لا و لا فعل الزنــات"],["B1563EEB-D815-57D7-967A-8DB294B1356C","فاجمعوا الأجزاء جمعاً","من جسـورٍ نيــرات"],["3791EC02-3D72-5E4D-9A87-F009E8C0813C","من هـواء ثم نــار","ثم من ماء فـــرات"],["85A6AD96-D186-5EBE-AE9B-14A92B2B154B","فازْرعوا الكلّ بأرضٍ","تـُرْبُها تـرب مـوات"],["A017DAA8-58B4-5E03-A78E-6E0A7ACCB126","وتعاهـدها بســقي","من كـؤوس دائـرات"],["7A628D2C-5AB7-5418-81B6-05E604F42721","من جـوارٍساقيـات","و سـواقٍجاريــات"],["9ABB65F5-6EBE-5137-A4A1-8D240B6C8A7C","فإذا أتممت سبعـــا","أنبتـَتْ خير نبــات"]]},"58FF0186-DDB8-5977-8B05-87143A2C0695":{"t":"الأهوال أمانات عند أهلها","p":118,"s":"الأهوال أمانات عند أهلها","r":"450243","v":[["BE5195EE-1817-54B9-BD32-4A2FAB76FE86","مَن سارروه فأبدى كلّما ستـروا","و لم يراع اتّصالاً كان غَشَّاشـا"],["72972340-025B-5387-B873-47A1F8E96B82","إذا النفوس أذاعت سرّ ما علمت","فكل ما خلت من عقلها حاشـا"],["B54EC34E-C7BD-5FF9-ACB3-26948993D803","من لم يصن سرّ مولاه و سيّـده","لم يأمنوه على الأسرار ما عاشا"],["C3302D54-D314-5379-9C9A-D7EC8FA18BE8","و عاقبوه على ما كان من زَلَـَل","و أبدلوه مكان الأُنْس ايحاشــا"],["42041BD7-8D1B-551D-AED2-DE9D0EAFD29E","و جانبوه فلم يصلح لِقُرْبِهِـــم","لمّا رأوه على الأسرار نبَّاشــا"],["A0CB9267-F82D-5D33-9185-44257F6FBE3E","من أطلعوه على سرّ فنمَّ بـــه","فذاك مثل يبين الناس طيّاشــا"],["7BA047AE-06E1-59C6-B0F3-2E8CE1AD7B32","هم أهل السرِّ و للأسرار قد خُلقوا","لا يصبرون على ما كان فحَّاشا"],["11DD5175-9DF0-5696-B8D1-EBEA07B91857","لا يقبلون مذيعاً في مجالسهــم","و لا يحبّون سِتْراً كان وَشْواشا"],["214900C7-65A6-5ECF-8F91-21F036AA2D48","لا يصطفون مضيفاً بعْض سرّهم","حاشا جلالهم من ذلِكم حاشـا"],["1620C55F-6011-5A0F-B304-D5F363A587A6","فَكُنْ لهم و بهم في كلّ نائبــةٍ","إليهم ما بقي الدهر هشَّاشــا"]]},"EEDA6EC7-7863-52D2-A19E-F66F3B2A56D7":{"t":"التلبية","p":118,"s":"التلبية","r":"450239","v":[["7386B9E7-BE44-5ECC-8577-22A534DC30F3","لبّيكَ لبّيكَ يا سرّي و نجوائـــي","لبّيك لبّيك يا قصدي و معنائـي"],["9FC4651F-F6DF-5BD2-90D8-3A2133AE7095","أدعوك بلْ أنت تدعوني إليك فهـلْ","ناديتُ إيّاك أم ناجيتَ إيّائـــي"],["8453CEA6-716E-5AED-B768-A99C82BE6774","يا عين عين وجودي يا مدى هممي","يا منطقي و عباراتي و إيمائـي"],["7AA5FA6D-648A-562C-9FD5-96E5354DF1CC","يا كلّ كلّي يا سمعي و يا بصري","يا جملتي و تباعيضي و أجزائي"],["7A7DAE66-6E4F-5EDD-8DC5-3AEF91CAD52D","يا كلّ كـلّي و كلّ الكـلّ ملتبس","و كل كـلّك ملبوس بمعنائــي"],["45A07784-0EC3-5CB6-88C0-C70DD74D0B19","يا من به عُلقَتْ روحي فقد تلفت","وجدا فصرتَ رهينا تحت أهوائي"],["B2EC15E3-3C3B-50FC-AE1C-0A6D6BBF3229","أبكي على شجني من فرقتي وطني","طوعاً و يسعدني بالنوح أعدائـي"],["9D88AFB6-7071-5A1F-925E-4C8436832EB8","أدنو فيبعدني خوف فيقلقنــي","شوق تمكّن في مكنون أحشائـي"],["8410951C-38B4-50AC-9797-379492E84A38","فكيف أصنع في حبّ كَلِفْتُ به","مولاي قد ملّ من سقمي أطبّائـي"],["CE82A21C-9F65-5B29-A722-B76464988E6C","قالوا تداوَ به منه فقلت لهـم","يا قوم هل يتداوى الداء بالدائـي"],["5197548D-7045-51E5-8911-980BDAA2C38C","حبّي لمولاي أضناني و أسقمني","فكيف أشكو إلى مولاي مولائـي"],["6FE1A284-34D1-5828-AB2C-FF119368E84D","اّني لأرمقه و القلب يعرفـه","فما يترجم عنه غير ايمائـــي"],["A86EC9A8-1303-518C-A007-295DBE0AB58C","يا ويحَ روحي من روحي فوا أسفي","عليَّ منّي فإنّي اصل بلوائـــي"],["9F8E6797-F460-515C-9101-FE535E2E689F","كانّني غَرق تبدو أناملــه","تَغوثُّاً و هو في بحر من المـاء"],["4C509486-3881-5AEF-9BF6-F633CFC124F8","وليس يَعْلَم ما لاقيت من احدٍ","إلا الذي حلَّ منّي في سويدائـي"],["FF87916B-0669-5307-B9CE-6A9F90148493","ذاك العليم بما لاقيت من دنفٍ","و في مشيئِتِه موتي و إحيائــي"],["577581DF-EFFF-555D-A1AC-B32998D77480","يا غاية السؤل و المأمول يا سكني","يا عيش روحي يا ديني و دنيائي"],["05C1D347-5448-51F9-AB8A-1986556C0B5A","قُلْ لي فَدَيْتُكَ يا سمعي و يا بصري","لِمْ ذا اللجاجة في بُعدي و إقصائي"],["EBD7DC5F-1974-5892-B46F-2A80412F7415","إِن كنتَ بالغيب عن عينيَّ مُحْتَجِباً","فالقلب يرعاك في الأبعاد و النائي"]]},"FE55460C-F263-5635-86CD-3A9ADD1DFF7A":{"t":"جواب إلى شبلي","p":118,"s":"جواب إلى شبلي","r":"450241","v":[["C587E759-0F32-5B1E-800C-0061586B719C","يا موضع الناظر من ناظـري","و يا مكان السرّ من خاطـري"],["5C2CCEC1-619E-5856-8025-C082FDD2E859","يا جملة الكلّ التي كلهــــا","أحبّ من بعضي و من سائري"],["24C5E9E4-B96A-57C0-BF1D-03BF94D5AD31","تراك ترثي للذي قلبــــه","مُعَلَق في مخلبي طائــــر"],["CE1610E9-F0F3-53A2-B47A-B3500896BF48","مدَلَهٌ حيرانُ مستوحـــشٌ","يهرب من قفر إلى آخـــر"],["49FE78D8-ED68-5B8F-8113-69804F4193D2","يسري و ما يدري و أسراره","تسري كلمح البارق النائــر"],["1AF6812E-EAB5-5741-A78E-779500C1D15E","كسرعة الوهم لِمَنْ وهمه","على دقيق الغامض الغابـر"],["1D5E8030-4EC1-5974-B5F5-6EEF19F5BEB1","في لجّ بحر الفكر تجري به","لطائف من قدرة القـــادر"]]},"817E7414-E9C7-5D68-9CEE-52F5283357B4":{"t":"جواب في حقيقة الإيمان","p":118,"s":"جواب في حقيقة الإيمان","r":"450240","v":[["559ECC36-C3B1-5144-A249-60441F9DC3E0","للعلم أهلٌ و للإيمان ترتيــــب","و للعلـــــوم و أْهلِيها تجاريب"],["564547A1-E596-53EB-B259-917C6D448BB7","و العلم علمان منبوذ و مكتســب","و البحر بحران مركوب و مرهوب"],["3096F6BD-A091-545D-8DF0-2EC50474E3E9","و الدهر يومان مذموم و ممتــدح","و الناس اثنان ممنوح و مسلــوب"],["FD478F4C-4405-52D5-B191-F41385EC8B7F","فاسَمعْ بقلبك ما يأتيك عن ثقـــةٍ","و انظرْ بفهمك فالتمييز موهــوب"],["2B1268FF-F5AE-56B7-AF67-B69EF0CF70AE","إني ارتقيتُ إلى طودٍ بلا قـــدمٍ","له مَراقٍ على غيري مصاعيـــب"],["67811935-3A4B-5AB0-AA30-D758A067C248","و خُضْتُ بحراً و لم يرسب به قدمي","خاضَتْهُ روحي و قلبي منه مرغـوب"],["A150C4FC-6C22-51FC-85D7-2EBC87E2FF83","حَصْبَاؤُه جوهرٌ لم تَدْنُ منـه يــدٌ","لكــنه بِيَدِ الأفهــام منهـــوب"],["6D9F6EC7-3EB7-5354-B31C-8974908134C4","شربتُ من مائــه رَياً بغير فــم","و الماء قد كان بالأفواه مشـــروب"],["01AD7CD2-4B7C-504C-ABB6-B42EACC2BF5C","لأن روحي قديماً فيه قدْ عطشــتْ","و الجسم [ما] ماسَهُ من قبل تركيــب"],["369C7FC6-5DA8-5680-9663-080A0C9B686F","إنـي يتيمٌ و لي أبٌ أَلوُذ بــــه","قلبــي لِغيْبَتِهِ ما عشـْــتُ مكروب"],["E5FC551D-AB04-5722-8F01-844510EB4ACC","أعمى بَصيرٌ و إنـي أبْلَه فَطِــنٌ","و لــي كلام إذا ما شئتُ مقلــوب"],["3019EDAF-ABCF-5F44-A238-526AD8B4CD9B","ذُوِ فَتَا عرفوا [ما] قد عرفت فَهْـمُ","صَحْبِيَ ومن يُحْظ بالخيرات مصحوب"],["E5A25C65-88D5-58AE-B9E0-FA0DC3692A32","تعارفَتْ في قديم الذّر أَنْفُسهـــم","فأشرقَتْ شمسهم و الدهــر غربيـب"]]},"4568AE8B-0E54-5F20-A0E3-08C9E0B13785":{"t":"عجبت منك ومني","p":118,"s":"عجبت منك ومني","r":"450247","v":[["C7E50959-5B6B-55C2-B642-CCBB5C348654","عجبتُ منك و منـّـي","يا مُنـْيـَةَ المُتـَمَنّـِي"],["60152B60-F419-5D85-A74F-8812DAD8537B","أدنيتـَني منك حتـّـى","ظننتُ أنـّك أنـّــي"],["7F524CDA-0D98-5C00-AF43-40747C4983EF","وغبتُ في الوجد حتـّى","أفنيتنـَي بك عنـّــي"],["AAFFF1CF-FBA4-5322-A2F8-23C785FAB948","يا نعمتي في حياتــي","و راحتي بعد دفنـــي"],["E5DA5C77-128D-5E7E-9390-DB0F53E92F6D","ما لي بغيرك أُنــسٌ","من حيث خوفي وأمنـي"],["43DC6D1B-7CA1-55B5-95F9-A081CFAE3DAA","يا من رياض معانيـهْ","قد حّويْـت كل فنـّـي"],["481C13F6-6026-5A54-9543-2996EA9C13F5","وإن تمنيْت شيْــــاً","فأنت كل التمنـّـــي"]]},"82EF4785-CDAE-5D98-983B-BB4C7B51BD08":{"t":"لم يبق بيني و بين الحق تبياني","p":118,"s":"لم يبق بيني و بين الحق تبياني","r":"450246","v":[["6FC844E4-6FE0-5211-8D2F-8A493BB3490D","لم يبق بيني و بين الحقّ تِبْيَانـي","و لا دليل و لا آيات برهــان"],["E66C4DB0-333A-5E27-AFA5-C9EC05571174","هذا تجلّى طلوع الحقِّ نائــرةً","قد أَزْهَرَتْ في تلأليها بسلطـان"],["220CEF3C-BF89-5FA1-91CC-DDF86860A976","كان الدليل له منه إليه بــــه","مِن شاهدِ الحقِّبل عِلماً بِتِبْيـان"],["1D6B8147-E5AC-558F-A08B-CD5E1A58D4C1","كان الدليل له منه به و لــــه","حقـًّا وجدناه في تنزيل فـُرقان"],["A24DB30F-30F3-5400-A1FA-FC5DB1EAF7A4","لا يستدلُّ على الباري بصنعتــه","و أَنْتُمُ حَدَثٌ يـُنْـبـِي بأزمـان"],["F09B77D2-6246-56D4-A64E-B6A8D3462C97","هذا وجودي و تصريحي و معتقدي","هذا تـَوَحـُّدُ توحيدي و إيماني"],["A3A5D3BA-E394-5FD1-B872-2C9C87E51E96","هذا عبارة أهل الانفراد بـــه","ذوي المعارف في سرّ و إعلان"],["6F843EBD-94FE-5493-B032-03821FDD9F07","هذا وجودُ وجودِ الواجدينَ لـه","بني التجانـُسِأصحابي وخُلَّاني"]]},"52D8C746-A05C-5072-9938-418B9CDDFC23":{"t":"مختارات (13-16)","p":118,"s":"مختارات (13-16)","r":"450253","v":[["510ED502-4947-57DE-B0B5-5026695FA799","فما لي بُعْدٌ بَعْدَ بُعْدِكَ بَعْدَمــــــا","تـَيَقـَّنْتُ أنّ القرب والبُعد واحد"],["2E971D66-74D9-5A74-BCFA-77BC615F1567","وإنّي وإن أُهْجِرتُ فـَالهَجْرُ صاحبـي","وكيف يصحّ الهجر والحُبّ واجد"],["E5644B4E-3076-5396-ACA9-9A776C3BABAC","لك الحمد في التوفيق في محضِخالصٍ","لعبدٍ زكـّيٍما لغيرك ساجــد"],["BA5B2727-A17A-5E99-8FB1-ADCD7268D434","لا تـَلمنّي فاللوم منـّي بعيـد","وأَجِرْ سيـّدي فإنـّي وحيد"],["C724052B-74FB-5B9F-8B59-A2A873832DF0","إنّ في الوعد وَعْدك الحقّ حقاً","إنّ في البدء بدء أمري شديد"],["FF148856-726E-58E1-BFAB-AAE91B90777D","مَن أراد الكتاب هذا خطابـي","فاقرؤُا وأعلموا بأنّي شهيـد"],["3F7ED6A9-6DA6-52B5-B195-0311C4AE07AD","قد تصبّرتُ و هل يصـ","ـبرُ قلبي عــن فؤادي"],["986D5439-6FA0-5339-B27C-DC03B32580F1","مازجَتْ روحُك روحي","في دنـّوٍ وبعــادي"],["A1D45455-22BB-5CE3-8DC2-E75342493342","فأنا أنت كمــا أنـّ","ـك أنـّـي و مـــرادي"],["EA1C8126-9C74-5933-82D0-AD0930836001","أنتم ملكتم فؤادي","فهِمْت في كلّ وادي"],["7CFFAD79-C5EF-5584-B747-4E8E14376375","ودقّ على فؤادي","فقد عدمت رقادي"],["75953901-58FD-55C3-B369-ABBCE0314642","أنا غريبا وحيدا","بكم يطول إِنفرادي"]]},"55D4AEA0-915E-538B-9463-F3171D2F6386":{"t":"مختارات (17-20)","p":118,"s":"مختارات (17-20)","r":"450254","v":[["02601276-1AC1-5371-B8A3-B1DE07104E84","حقيقة الحقّ مُسْتـنِـيَر","صارخه بالنبا خبيــر"],["82576380-C95D-523F-9C0F-7E22B0E22F1F","حقيقة الحقِّقد تجلـَّتْ","مَطْلب من رامها عسير"],["A53B459C-9BB7-5DF3-A0CD-D3E3F3E4C181","أنت المُوَلـِّهُ لي لا الذكر ولَّهنـي","حاشا لقلبي أَنْ يَعْلَق به ذِكَـرى"],["92953F4A-B54A-5E58-9A98-8624A4E80CCD","الذكر واسطةٌ تـُخْفِيك عن نظري","إذا توشـَّحَهُ من خاطري فكري"],["3021C411-AEAA-5747-B8B7-34B438F6F599","مواجِيدُ حَقٍّأَوْجَدَ الحـــقُّ كـُلَّها","و إِنْ عجزَتْ عنْها فهوم الاكابر"],["CB011655-C784-5931-8BB2-7C59D4545290","وما الوجد إلا خطرة ثم نظـــرة","تـُنَشـّي لهيبا بين تلك السرائر"],["06EEA570-4BFE-51E1-9C50-40958E23B0FD","إذا سكن الحقُّ السريرةَ ضُوعفـتْ","ثلاثة أحوال لأهل البصائـــر"],["8E960DEC-ADC0-5E5A-BF5C-105CF713B31F","فحالٌ تـُبيدُ السرَّ عن كنْهِوجِــدِه","وتـُحْضِرُهُ بالوجد في حال حائر"],["6D43F259-5CBA-5879-A091-37AC4F77B857","و حالٌ به زُمَّتْ قوى السرّ فآنـْثنَتْ","إلى مُنـْظِرِ أفناه عن كلّ ناظر"],["5967D56C-7881-5B72-9E3B-B8325D7EDA4E","إذا بلغ الصبُّ الكمال من الفَتَى","ويذهل عن وصل الحبيب من السُّكر"],["8EB59F3B-6DA2-5281-8D5C-87B8DE51477B","فيشهد صدْقاً حيث أشهده الهوى","بأنّ صلاة العاشقين من الكفـــر"],["2780FF6D-943B-50FE-962C-2AC1789930FA","إذا بلغ الصبُّ الكمال من الهوى","وغاب عن المذكور في سطوة الذكر"],["9E7D3192-BB86-5E4B-87DA-DF8E7663311F","فشاهد حقـّاً حين يشهده الهوى","بأنّ صلاة العارفين من الكفـــر"]]},"C8EEB062-1BD7-5CC1-9B2C-A38E5A14ACFC":{"t":"مختارات (21-24)","p":118,"s":"مختارات (21-24)","r":"450255","v":[["CDE19DDC-66E3-5D7F-87FF-37D05275DF48","عَقـُدْ النبوّة مِصْباح من النــور","مُعَلَّقُ الوَحي في مشكاة تأمــور"],["5DB3762C-F012-56D7-9E13-7A4C1D9F30C1","بالله يُنْـفَخُ نَفْـخ الروح في جَلَدِي","بخاطري نَفْخَ اسرافيلَ في الصور"],["BB10DBF9-4C15-5582-9682-20B3852434AF","إذا تجلّى لطــوري أن يُكـَلّمني","رَأَيْتُ في غيبتي موسى على الطور"],["6321EB25-D76D-5B88-8E1D-18F6CDF77DC8","لأَنوار نور الدين في الخلق أنوارُ","و للسرّ في سرّ المسرّين أسرار"],["7BFCD1DD-22ED-5BA7-94DB-B0BE8B7796A3","وللكون في الأكوان كون مُكَـوّن","يكنُّ له قلبي و يهدي و يختـار"],["653AB7E9-0D0C-552E-A9F0-0DA9C62DD4E5","تأمّلْ بعين العقل ما أنا واصـف","فللعقلِأسماع وُعَاة و أبصـار"],["0F58BE64-4061-5E86-BAD8-0C365FEB3997","سكنتَ قلبي و فيه منك أســــرار","فليَهْنِك الدار بلْ فليهنك الجـارُ"],["573E9B47-8D59-5944-855D-3BBA106DB1D2","ما فيه غيرك من سرٍّ عَلِمْتُ بـــه","فأنْظُرْ بعينك هل في الدار ديّار"],["C9E74E7F-C5A2-5E2A-A4E2-23191C0C3C59","و ليلة الهجرِإنْ طالتْ و إن قَصُرَتْ","فمؤنسي أملٌ فيه وتذكـــار"],["CECB088F-FA0A-566F-B220-2FC3F0E6D176","الحبّ ما دام مكتوماً على خطــرٍ","وغاية الأمْنِ أن تدنو من الحـــذر"],["7E55A77D-4C54-5722-B2B0-E7C781D47CDD","و أطيب الحبّ ما نمّ الحديث بــه","كالنارِ لا تأتِ نفعاً و هي في الحجـر"],["32F04E9A-6F7B-56D2-A4B1-1F56F9B64DB8","من بعْدِ ما حضر السحاب و اجتمعا","الأعوانُ و امتطّ أسمى صاحب الخبر"],["54498FA8-F724-5109-A9D2-720C82A13B25","أرجُو لنفسي براء من محبّتكـــم","إذا تبرّأت من سَمعي ومن بصــري"]]},"9E898FFF-A96C-57CB-9F54-32A171C39E17":{"t":"مختارات (25-30)","p":118,"s":"مختارات (25-30)","r":"450256","v":[["A93BB17D-BF39-5BC8-930F-AA15D9C22FB7","غِبْتَ و ما غبتَ عن ضميري","و صرْتَ فرحتي و سروري"],["2879A258-7CBB-55BE-BDDB-4C154D0B8FC4","وانفصل الفصل بافتـــراق","فصار في غيبتي حضوري"],["CFF057A3-A0AF-5839-911E-BBFF90166FBF","فأنت في سرّ غيبِ همّـــي","أخفى من الوهم في ضميري"],["CB3864E1-C53E-57D8-BD39-55F73294FDC3","تؤنسني بالنهار حقــــاً","وأنت عند الدجى سميري"],["89021A69-D04E-5F26-AE6E-CE093139E516","يا شمس يا بدر يا نهار","أنت لنا جنـّة و نـار"],["2DC62A1B-AA0B-59A4-AC75-3928109F52DC","تَجنُّبُ الإثِم فيك ثم إثمٌ","وخاصّية العار فيك عار"],["9714E6C5-0C1D-5963-8B55-2F5684BB958E","يخلعُ فيك العذار قـومٌ","وكيف من لا له عـذار"],["60AE182F-F9DE-543D-A168-3FEFE00A29AE","أحرف أربع بها هام قلبي","و تلاشت بها همومي و فكري"],["1122EBC7-F396-55B0-BAFF-0D471CD8E590","ألِفٌ تألف الخلائق بالصنـْـ","ـعِولامٌ على الملامة تجـري"],["A1CA7EF7-BF1E-5213-A3BF-E90C7BAE9D99","ثمّ لامٌ زيادة في المعانـي","ثمَّ هاءٌ أهيمُ بهـا أتــدري"],["9ABB00A7-A8F1-51B5-8148-18FB81F255E1","جحودي فيك تقديس","و عقلي فيك تهويـس"],["CA8C6628-5BA6-5CE4-9DFA-7AB1D8376490","و مـــا آدم إلاك","و من في البين إبليس"],["31832449-19B2-583C-A00F-91604FB4B734","جُنُوني لك تقديـس","و ظنّي فيك تهويـس"],["740D30E4-A6E6-5C48-9F08-CF73E4A07814","و قد حيّرني حِـبٌّ","وطرْفٌ فيه تقويــس"],["BB9454AE-15C3-5280-9A9B-A6B8DBA00BBB","و قد دلّ دليل الحُبّ","أن القرب تَـلْبيــس"],["0208DBC6-8823-5216-837C-98671C700C5D","فـمــن آدم إلاك","ومن في البين إبليـس"],["E74C44D1-24D9-55E4-BAC6-37CD05105589","حويتُ بكـُلّي كلّ حُبِّك يا قـُدْسي","تكاشفني حتـّى كأنـّك في نفسـي"],["4C1AC758-D93F-5F0E-9B81-571C22FD8488","أُقلّب قلبي في سواك فــلا أرى","سوى وحشتي منه و منك به أُنْسـي"],["72D9CA11-D5C2-519D-8E31-30C651CD5B3C","فها أنا في حَبس الحياة مجمَّــع","من الأنس فاقبضْني إليك من الحبْس"]]},"2E2DE69D-0B37-558C-9333-5CA1589F63AA":{"t":"مختارات (31- 34)","p":118,"s":"مختارات (31- 34)","r":"450257","v":[["E241DEE2-C5E5-5FA1-A498-3AE219D344F3","والله ما طلعت شمسٌ ولا غربت","إلا و حبّـك مقـرون بأنفاسـي"],["4E688307-B253-5191-9BD6-83E2D2E8CEB5","ولا خلوتُ إلى قوم أحدّثهــم","إلا و أنت حديثي بين جلاســي"],["8AE10F6D-F438-59A6-8199-83CB5835EE73","ولا ذكرتك محزوناً و لا فَرِحا","إلا و أنت بقلبي بين وسواســـي"],["67251E3A-CA83-5231-A65F-A9ED81413058","ولا هممت بشرب الماء من عطش","إلا رَأَيْتُ خيالاً منك في الكـــأس"],["5CF4BB14-1278-5C9B-AA88-6AFB8BF658FC","ولو قدرتُ على الإتيان جئتـُكم","سعياً على الوجه أو مشياً على الرأس"],["3FB7736F-F8BF-5303-B790-7D87E7DC9F54","ويا فتى الحيّ إن غّنيت لي طربا","فغّنـني وأسفا من قلبك القاســـي"],["33C8EDCF-BC94-5188-8382-69C37A728570","ما لي وللناس كم يلحونني سفها","ديني لنفسي ودين الناس للنـــاس"],["7B90D345-DB92-51CC-B04A-CFE505EDD592","يا نسيم الروح قولي للرشـا","لم يزدني الـِورْد إلا عطشـا"],["50351033-1900-5845-BAFD-6740A823EE9C","لي حبيبٌ حبّه وسط الحشـا","إن يشا يمشي على خدّي مشا"],["C6759D42-6D65-5EC8-932D-B1E4D959C8B9","روحه روحي وروحي روحه","إن يشا شئتُ وإن شئتُ يشـا"],["FECAA2A0-E1E7-5131-AB65-83689ADC689B","عجبتُ لكلّي كيف يحمله بعضـــي","ومن ثقل بعضي ليس تحملني أرضــي"],["A9CE5C9D-985B-5CE6-A072-ADFFAF78E9EF","لئن كان في بسط من الأرض مَضْجَعٌ","فبعضي على بسط من الأرض في قبضي"],["270FFD87-CC70-54F2-8A06-BBC734CC279B","ما زلتُ أطفو في بحار الهوى","يـرفـعـني المَـوْجُ و انحطُّ"],["20F75577-15C2-5541-9AF2-017A14B88753","فتارةً يـرفعـني مَـوْجُـهـا","وتـارة أهــوى وانـغــطّ"],["C26F5861-E771-5831-B56B-D70228F15A81","حتّى إذا صيَّرني في الـهوى","إلى مـكـان مـا لـه شــطّ"],["2A8943E8-B2FB-54FF-A38B-11A7A8003582","ناديتُ يا من لم أَبُـح بِاسمـه","ولم أَخُـنْـهُ في الهــوى قطّ"],["CD9370A3-6E68-5F6B-95A1-FC69F91001A7","تقيك نفسي السُّـوء من حاكم","ما كان هذا بيننــا شــرط"]]},"4E709E9F-0532-5731-9392-ACA9015E13BF":{"t":"مختارات (35- 40)","p":118,"s":"مختارات (35- 40)","r":"450258","v":[["D8BF6377-82C4-598D-9841-296128506D5C","مكانُك من قلبي هو القلب كـلّــه","فليس لخلقٍفي مكانك موضـــع"],["F25DEFA2-D107-52A3-9704-C7ACD558CFDA","وحَطَّتْك روحي بين جلدي وأعظامي","فكيف تراني إن فقدتك اصنـــع"],["4BCE1F0A-82B7-5834-AC13-1AA93E5DF276","إذا ذكرتك كاد الشوق يقلقني","وغفلتي عنك أحزانٌ وأوجاع"],["EE45D358-5D6A-5EF6-87FD-8702788CBAF6","وصار كلّي قلوباً فيك داعية","للسقم فيها وللآلام إســراع"],["FA503DF1-B8A2-5151-B7C5-D56E414E7D3D","نديمي غير منسـوبٍ","إلى شيءٍ من الحيـف"],["E7FF216F-7E91-56D3-9C5B-C8A424B31E20","سقاني مثلما يشـرب","كفعل الضيف بالضيف"],["B89DE7F5-ABEA-5986-B79B-CF33AC0F9016","فلما دارت الكــأس","دعا بالنطع و السيـف"],["B67E4A60-6E3A-5EFF-9CFA-EA5B7CBA0ABA","كذا من يشرب الراح","مع التِـّنين في الصيف"],["77516CC6-E2D8-5AE4-A17D-50CB6B2F701E","صَيَّرني الحقّ بالحقيقـةْ","بالعهد والعقد والوثيقـةْ"],["C12F83B4-CBC5-5DEA-BB97-2BF8800F99A4","شَاهَدََ سرّي بلا ضميري","هذاك سرّي وذا الطريقةْ"],["0DF36DFC-F2F0-536A-ABAB-B9D444C2DAE1","وَحِّدْنِي واحدي بتوحيِد صِدْقٍ","مـا إلـيه من المسـالك طَرقُ"],["56E6F69D-ECFC-5D17-A689-C023CD221271","أنا الحقُّ و الحقُّ للحقِّ حـقٌّ","لاَبِـسٌ ذاتَـهُ فما ثـمّ فَــرْقُ"],["D075862F-08B3-527A-BD63-A10CBBCD5D69","قد تَجَلّتْ طوالعٌ زاهــراتٌ","يتـشعشعْنَ في لـوامـع بَـرْقِ"],["2B036B4C-F381-516E-A028-99C8AF012A92","ركوبُ الحقيقة للحقِّ حـقُّ","ومعنى العبارة فيه تدقّ"],["602F0A49-7DFC-54F9-B6D0-68794B3057A2","رَكِبْتُ الوجودَ بعين الوجودِ","وقلبي على قسوةٍ لا يَرِقّ"]]},"E716EF10-392F-530E-B03C-9436CB3EB33F":{"t":"مختارات (41- 45)","p":118,"s":"مختارات (41- 45)","r":"450259","v":[["7B963243-1CF8-5C66-B773-BD615A668864","جبلتْ روحك في روحي كما","تجبل العنبر بالمسك الفتقْ"],["ACF21043-FD5C-5408-9820-14E2E355238B","فإذا مسَّـك شيءٌ مسَّـنــي","فإذاً أنت أنا لا نفتــرقْ"],["D8EE49F1-DDBC-597B-AD68-F7FA0DBD7113","دَخَلْتَ بناسوتي لديك على الخلق","ولولاك لاهوتِي خَرجْتُ من الصِدْق"],["4DE61D82-7268-5709-80A8-B1C8D956B07C","فإنّ لسان العلم للنطق و الهدى","وإنّ لسان الغيب جلّ عن النطــق"],["CDC7534D-CF09-5929-8B59-33A700FDDE93","ظهرتَ لقومٍوالتبستَ لفتيــةٍ","فتاهوا وضلّوا واحتجبتَ عن الخلـق"],["32FE6B8D-6EF3-55CF-8D3E-09678888B116","فتظهر للألباب في الغرب تارةً","وطورا على الألباب تغرب في الشرق"],["1CC44449-AD98-559B-A7E0-569416434C96","فيك معنى يدعو النفوسَ إليك","ودليل يدلّ منك عليْـك"],["1AB7263C-AE17-58B9-8369-B31CCB24C47D","لِـيَ قلـبٌ له إليك عيـونٌ","ناظراتٌ وكلُّهُ في يدَيْك"],["FDF5ABBA-4B9A-5386-8915-1CF5D342BDC6","هّمي بـه وَلٌَـه عـليـك","يا من إشارتنا إليك"],["B9B1CEC8-F9A8-51DB-B6AB-CCAE20D512E3","روحان ضمهما الهَوَى","فيمِدْحَتِك وفي لديـك"],["8170D18D-03BA-5791-95AB-28FBF0BD23FF","دُنْيَا تُخَادِعُنِي كأنّـي","لستُ أعرف حالهـا"],["DC0A701C-5977-5288-A54A-4E497B9A4055","ذمّ الِإلـهُ حرامهــا","وأنا اجتنبت حلالهـا"],["FC8E0AC9-3B09-5A6E-B572-E89C4CEAEFA7","مدَّتْ إلـىَّ يمينهــا","فرددْتها وشمالهــا"],["35B68344-3571-57B6-900C-43D77A45D5FA","ورايتـُها محتاجــة","فوهبتُ جملتها لهـا"],["68F14B7E-6369-538C-9857-D2C0B20B9235","ومتى عرفت وصالها","حتـّى أخاف ملالها"]]},"E140553B-5B30-5ABE-B4E8-C8F0BDF0A6D4":{"t":"مختارات (46- 50)","p":118,"s":"مختارات (46- 50)","r":"450260","v":[["B17365A2-BDFF-51C7-BE9E-B4E89F019656","عليـك يا نفـس بالتسلّــي","العـزّ بالزهد و التخلّـي"],["6B5FED53-876A-5125-9C4E-BE5F6C1CC979","عليـك بالطلْــعة التــي","مشكاتها الكشف و التجلّي"],["A333AADC-A812-52D1-B292-4B4246B50D8C","قد قام بعضي ببعض بعضي","و هام كلـي بكـلّ كلـي"],["1408663D-CFED-582A-85D8-248A2E26988D","مُزِجت روحك في روحي كما","تمزج الخمرة بالماء الزلال"],["675C6A28-78C9-533F-AE6F-BEBB9BE15CF1","فـإذا مسَّـك شيء مسّنــي","فإذاً أنت أنا في كلّ حـال"],["72C5CD82-3ACF-5C84-9D86-D62258C3CF25","نِعْمَ الإِعَانَةُ رَمْزٌ في خفا لُطُـف","في بارقٍلاحَ فيها من حُلَى خِـلـَلـِهْ"],["1581930D-3BD4-59D7-AFAE-E629CC79B501","والحال يرمقني طوراً وأَرْمُـقـُهُ","إن شا يغشى على الإخوان من قـُلَـلِـهْ"],["8877A10B-0A76-5260-A89E-606903E1E67B","حال إليه رأى به فيه بـِهـِمّتـه","عن فيض بحرٍ من التمويه من مِـلَـِلـهْ"],["42B21248-CF15-555F-A92F-C2788951FF24","فالكـلّ يشهده كـُلّاً وأشهــده","مع الحقيقة لا بالشخص من طـلـلـهْ"],["DD4054CC-2C44-5D3A-806C-7873CA8F93A0","ثلاثة أحرف لا عُجْـمَ فيهـا","ومعجومانِوانقطع الكـلام"],["F22C3E21-E153-547E-B295-E164A3F0478D","فمعجـومٌ يشاكـل واجديِـهِ","ومتروكٌ يُصَـدّقـُهُ الأنـام"],["AD9412E4-D989-51E7-AA18-801A141BCA92","وباقي الحَرْفِمرموزٌ مُعَمَّى","فلا سفر ينـال و لا مقـام"],["117AA958-87F1-5A68-B9C0-5BCE77B9870B","تفكّرتُ في الأديان جدَّ تحقّقٍ","فألفيتها اصلاً له شُعَباً جّما"],["55EF2CAF-3842-58C9-BDE5-51E94DD8179D","فلا تـَطْلُبَنْ للمرء ديناً فإنّه يُصَدُّ","عن الأصل الوثيق وإنّما"],["18873BB2-3D50-5DA7-996D-6A4AC8A15F00","يطالبه اصلٌ يعبِّر عنده","جميعُ المعالي والمعاني فـَيَفْهَمَـا"]]},"5CF691A2-2E45-5A55-9CE7-B25009CA46AE":{"t":"مختارات (5-8)","p":118,"s":"مختارات (5-8)","r":"450251","v":[["5A5CA5C6-09A7-5BF6-BE00-1F39F574A2DC","سبحان من اظهر ناسوتـُهُ","سـّر سنا لاهوتِه الثاقـب"],["79F3E30F-BD59-55AF-9FEC-F223B0650875","ثم بـدا في خلقه ظاهـراً","في صورة الآكل و الشارب"],["336B4BDD-99C6-54B1-BFDD-8C0C40B0E13D","حتـّى لقد عَايـَنَهُ خَلْقـُه","كلحْظِة الحاجب بالحاجـب"],["2435A3E9-DB87-51E5-AF4F-2CE385B26080","كتبتُ ولم أكـُتبْ إليك و إنـّما","كتبتُ على روحي بغير كتابِ"],["410B2E8E-6D87-5A9B-8105-7530B06C067C","و ذلك أنّ الروح لا فرق بينها","و بين مُحِبـيِّها بِفَصْلِ خطابِ"],["78CCD6F5-99F7-5217-999D-0666BCCE8FC3","أُريدُك لا أريدك للثواب","و لكنـّي أريـدك للعقـاب"],["07BFDF04-9EBC-5368-8A23-E14A170EE0E9","فكلّ مآربي قد نِلْتُ منها","سوى ملذوذِ وجدي بالعَذَاب"],["CFFF359D-DCF5-5E06-A33A-A6F9794E0E32","فكلّ مآربي قد نِلْتُ منها","سوى ملذوذِ وجدي بالعَذَاب"],["DDB689BD-0ABB-52EE-9F88-F561BD7E1E45","كَفَى حَزَناً أنّي أُناديـك دائمـــا","كأنـّي بعيدٌ أو كأنـّك غائب"],["92A58D11-E49B-5EB8-A924-CCECE7BD6820","و أَطْلُبُ منك الفضل من غير رغبةٍ","فلم أر قبلي زاهدا فيك راغب"],["714BE8D5-ED83-5685-BAD8-14D16C4948EE","كَفَى حَزَناً أنّي أُناديـك دائمـــا","كأنـّي بعيدٌ أو كأنـّك غائب"],["3EAB5B87-74A0-5C77-95DA-9472D853C403","و أَطْلُبُ منك الفضل من غير رغبةٍ","فلم أر قبلي زاهدا فيك راغب"]]},"F91ECD7A-FC0A-53E2-93BB-6EFCF2B759BA":{"t":"مختارات (51- 55)","p":118,"s":"مختارات (51- 55)","r":"450261","v":[["5206FB87-D2D1-58C0-98E3-5BD3ABFE88DA","يا لائمي في هواه كم تلوم فـَلَوْ","عرَفْتَ منـه الـذي عنيت لـم تـَلُمِ"],["8FAE2C79-C640-52DA-BF90-21792829D190","للناس حجّ ولي حجّ إلى سـكني","تُهْدَى الأضاحي وأُهْدِي مُهْجَتِي وَدَمِي"],["88AA0F3F-4EEC-5103-9599-32AA9E22A962","تطوف بالبيت قومٌ لا بجـارحةٍ","باللهِ طافوا فأغنـاهم عـن الحَــرَمِ"],["BEE1BF84-AC13-540B-924C-7F19DBEA3C55","بدا لك سـرٌّ طال عنـك اكتتامه","ولاح صباحٌ كنت أنت ظلامه"],["7B6989CC-DC4C-56D3-985C-86C91A918D7F","وأنت حجاب القلب عن سرّ غيبه","ولولاك لم يطبع عليه خاتمـه"],["930C7EE1-C7DF-54D8-ABCC-551E703955CB","هيكليّ الجسم نوريّ الصميم","صمديّ الروح ديّـان عليـم"],["B780D4AD-20C4-5822-B92E-CC7FEA5F1015","عـاد بالـروح إلى أربابها","فبقي الهيكل في الترب رميم"],["B3E7067F-FFB5-58E2-99EB-262BA790FCDA","حملتم القلب ما لا يحمل البدن،","والقلب يحمل ما لا تحمل البدن"],["EE29E54C-63DF-577E-AA6A-33D652D98BA2","يا ليتني كنت أدنى من يلوذ بكم","عينا - لأنظركم - أو ليتني أذن"],["153A25B4-FD41-504A-A101-FCE3B3758919","لم يبق وبيني وبين الحق تبياني","ولا دليل بآيات وبرهان"],["5324303A-F365-5431-B99C-93D0579AFA78","هذا تجلي طلوع الحق: نائرة","قد أزهرت في تلاليها بسلطان"],["16352780-0CA9-5019-B5BE-55E2554EF676","لا يعرف الحق إلا من يعرفه","لا يعرف القدمي المحدث الفاني"],["676D11B8-ABA0-5AD4-A99B-879EE41F7877","لا يستدل على الباري بصنعته","رأيتم حدثا ينبي عن أزمان؟"],["19D1EF16-9B80-5805-A34E-1F04CBE9B424","كان الدليل له منه إليه به","من شاهد الحق في تنزيل فرقان"],["5D6B31C0-F971-5486-92DE-8D8EE23689BF","كان الدليل له منه به وله","حقاً وجدنا به علما بتبيان"],["B6BBF3E0-1717-5E13-BEB3-3FA9881DD81B","هذي عبارة أهل الانفراد به","ذوي المعارف في سر وإعلان"],["B6B467C8-B337-5D2C-B97A-435DFCE3DBE2","هذا وجود وجود الواجدين له","بني التجانس: أصحابي وخلاني"],["566FD889-EFBE-5F61-ABCE-73514FF9A886","أنت بين الشغاف والقلب تجري","مثل جري الدموع من أجفاني"],["2BD05D86-18CB-53FE-904D-02AF0C674DF2","وتحل الضمير جوف فؤادي","كحلول الأرواح في الأبدان"],["505D0B08-93EB-5289-BCB8-6361331E748A","ليس من ساكن تحرك إلا","أنت حركته خفي المكان"],["0016BA3B-F9FE-557B-B24F-A63D06A4B699","يا هلالا بدا لأربع عشر","فثمان وأربع واثنتان"],["7F5E89F8-762F-51DE-8103-E14505C4704E","آأنت أم أنا هذا في إلهين؟","حاشاي حاشاي مِن إثبـات أثـنَـيْـنِ"],["BB8BF900-3A0E-549A-8A6F-35D1B907957F","هــويةٌ لـك في لايئتي ابَــداً","كـلّي على الكلّ تلبيسٌ بـِوَجْـهـَيْـنِ"],["00C5D38E-653A-5ADE-953D-1351011EA131","فـَأَيْنَ ذاتك عنّي حيث كنت أرى","فـقد تـفرد ذاتـي حيت لا أيــني"],["8A3432C4-1608-5991-8A8E-FC1B46D8D138","ونور وجهك؟ مقصوداً بناظرتي","في باطن القلب، أم في ناظر العين؟"],["FB0EA2DE-8C96-50FD-9E6F-649F4843BC32","بَيْنِـي وبَيْنـك إنّيٌ يُزاحِمُنِــي","فارفعْ بـِأنـَّك إنّـي مِـن الـبـيـن"]]},"2A40E811-EAD3-5281-B41C-D080D9AA2EF7":{"t":"مختارات (56- 60)","p":118,"s":"مختارات (56- 60)","r":"450262","v":[["8E63DC88-3893-554E-8ED5-F82D782332C8","ألا أبْـلـِغْ أحبّـائي بأنّــي","ركبتُ البحر وانكَسرَ السفينةْ"],["0B5CB8FE-2A96-50F8-93E0-F4DEE1B77300","على دين الصليب يكون موتي","و لا البطحا أريد ولا المدينة"],["EBC958AF-29CC-5CE9-A6CF-15610E6B3C56","أنا مَن أهوى ومَن أهوى أنا","نحن روحانِحَلَلْـنا بدنا"],["F5947105-0039-5CD5-9754-8E91858B09FE","فـإذا أبصرتـَني أبصرتـَهُ","و إذا أبصرتـَهُ أبصرتـَنـا"],["490DA1EF-8909-5E6A-992B-77F35A1BAE3D","يا غـافلاً لجهالـةٍ عن شأني","هلّا عـرفـتَ حقيقتـي وبيانـي"],["D9DEF588-78CF-564E-BE26-6CE62BFB9ABF","أعِبـادة لِلَّهِ ستـّة أحــرفٍ","مِـن بينها حرفـان معجومــان"],["22940751-AFB6-52AD-B434-01308EC94D55","حرفان اصليّ وآخُـر شَكْلُـه","في العجـم منسوب إلى إيـماني"],["6910C6E6-2BB1-5790-B5D4-0C9B345C0AAF","فإذا بدا رأس الحروف أمامها","حرفٌ يقـوم مقـام حرف ثـان"],["CBF6FD42-A9F6-52DF-B7D0-F321CFDD802F","أبصرتَني بمكان موسى قائما","في النور فوق الطور حين تراني"],["02797F38-D8A1-5CE4-B320-8F0798211FF3","خاطَبنِي الحقّ من جناني","فكان علمي عـلى لساني"],["55B61CEF-00F5-5392-8FE8-48CC7E5E0E7C","قربّني منه بَعْـدَ بُعْــدٍ","وخصَّني الله و اصطفاني"],["A89B987F-BFEF-597C-A30B-B3E783ED907C","كـذا اجتباني وأَدناني وشرّفنــي","والكـلّ بالكـلّ أوصاني وعرّفني"],["2F48D21E-52DD-5FA1-B617-07F2114D928E","لم يبق في القلب والأحشاءِ جارحةٌ","إلّا وأعْـرفه فـيـهـا ويعرفنـي"]]},"819A415C-F1F5-5C09-BBB5-E37AC108CD77":{"t":"مختارات (61- 65)","p":118,"s":"مختارات (61- 65)","r":"450263","v":[["F3464883-C984-595B-B683-4832EBD09A67","أنْتَ بين الشغاف والقلب تجري","مثل جري الدموع من أجفاني"],["71FC1658-578B-57C0-B365-FFD109A5F4BE","وتُحِلُّ الضميرَ جوفَ فــؤادي","كحلول الأرواح فـي الأبدان"],["D06AA4CE-755F-5A42-8243-B290E71D1CDB","ليس من ســاكنٍتَحَرَّكَ إلّا","أنت حَرَّكْتَهُ خَفَّي المكــان"],["FC9E7353-5730-5A7C-8E76-F2F8C1DBFEA0","يا هـلالاً بدا لأربع عشـرٍ","لثمـانٍوأربـعٍو اثنــان"],["5A253A9B-E2EC-5484-9DC5-04304524A92D","حَمَّلْتَ بالقلب ما لا يحمل البَدَنُ","والقلب يحمل ما لا تحمل البُـدُن"],["69B1F7DA-3521-5D10-81D4-08810D60745D","يا ليتني كنتُ أدنى من يلوذ بكم","عينـاً لانظركـم أم ليتنـي أُذن"],["36CE858C-5AEF-5490-945E-51D6DA2620D5","بيَان بيان الحـقّ أنت بيانـه","وكـل بيـانٍأنت منـه لسانـهُ"],["2C7BB675-DDC7-5725-BD9F-A699E75C5335","أشرتُ إلى حقٍّبحقٍوكل من","أشـار إلى حقّ فأنْـتَ أَمـانـهُ"],["13F42BF8-BDA2-574A-8FC7-C1C9BEB030B9","تشير بحقِّالحقّ والحق ناطقٌ","وكـل لسـانٍقـد أتـاك أوانـهُ"],["98678F25-139B-54E6-9274-8F37E01D2FE6","إذا كان نعْت الحقّ للحقّ بَيّنـاً","فما بالُهُ في الناس يَخْفَـي مكانـه"],["2BC34493-9304-55BA-BBF8-CAEC3E257381","رقَـيـبَـانِمنّي شاهدَانِلحُبِّــهِ","واثنـانِمنّـي شـاهـدَانِتـرانـي"],["992D1D62-257D-5B65-BE8A-30C9ABBAEDE3","فما جـال في سرّي لغيرك خاطـر","ولا قـال إلا فـي هـواك لسـانـي"],["4ADB3F95-9C43-5088-8520-2EB7DECFB124","فإِنْ رُمْتُ شرقاً أنت في الشرق شرقهُ","وإن رمـتُ غرباً أنت نصب عيانـي"],["A11C3D28-83DA-5162-B341-13E616C83B56","وإن رمتُ فوقاً أنت في الفوق فوقه","وإن رمـتُ تحتا أنـت كـل مكـان"],["6143EA67-491B-5F72-9CB9-1FE9F610EDA0","وأنـت محـلّ الكـلّ بـل لا محلّهُ","وأنـت بكـلّ الكـلّ ليـس بـِفـانِ"],["21B1B7C8-CFAF-52AC-A078-183A7C0B134C","فقلبي وروحي والضمير وخاطري","وتـرداد أنفـاسي وعقـد جنـانـي"],["42D74AA7-8D58-5FD3-A8CB-AAB7D04EEADD","أرجعْ إلى الله إنّ الغـايةَ الله","فـلا إِلـهَ إذا بالغْتَ إلّا هــو"],["F183A2D2-A23F-5ECE-A89B-633AB65E0A44","وإنّه لمَـعَ الخَلْق الذين لهـم","في الميم والعين والتقديس معناه"],["783F8C59-1306-5D73-A96C-2059A0709DB0","معناه في شفَتي من حلّ معتقداً","عن التهجّي إلى خلقٍله فاهـوا"],["0DA84476-1763-5341-AF0B-B4756E1A9739","فإنْ تشكّ فدِبّرْ قول صاحبكم","حتّى يقول بـِنَفْيِالشكّ هذا هو"],["66F56E9B-E774-5239-BF7C-6C3E01A4F9B6","فالميـم يفتح أعلاه وأسفلـه","والعيـن بفتـح أقصـاه وأدناه"]]},"3F6863E5-927D-515B-91A8-1F4EAE700042":{"t":"مختارات (66- 69)","p":118,"s":"مختارات (66- 69)","r":"450264","v":[["8898D238-9552-5E89-9DB6-83C186A8821C","من رامه بالعقل مسترشدا","أسرحَهُ في حيرة تلهـو"],["22B40DFD-067B-53DB-9BDA-EC6B5839886B","قد شاب بالتلبيس أسرارهُ","يقول في حيرته هَلْ هو"],["908B52A8-878E-5204-8660-56FBFE4D1803","لستُ بالتوحيدِ ألهـو","غير أنّي عنه أسْهـو"],["C43EF551-C204-51BC-8364-7DF5D0086013","كيف أسهو كيف ألهو","وصحيح أنّـني هـو"],["141D2FB9-5A22-524B-B02E-221AD667E931","يا سـرّ سـرّي تدقّ حتّى","تُخفي على وهم كل حّيِ"],["0B3A21DD-F606-5024-BD1B-D6EC2F99E4B7","وظـاهـرا باطناً تجـلّى","في كلّ شيء لكل شـيء"],["14F9E97D-6AD9-5BAC-9D98-8EC3DA6EB624","لئن اعتذاري إليك جهـلٌ","وعُظْم شكّي وفرط عيِّ"],["FB7AFFAA-F32B-5A94-ABCB-E133E03BB0BA","يا جملةَ الكلّ لسْتَ غيري","فما اعتذاري إذاً إلــيِّ"],["7FE80D2D-6DB4-5038-B506-BCAF95A2B878","اسمٌ مع الخلق قد تاهوا به وَلَهاً","ليعلموا منه معنىً من معانيه"],["D1959C95-6771-5674-9717-240BF2E2F535","والله لا يصلوا منه إلى سبـبٍ","حتّى يكون الذي أبداه يبديـه"]]},"89C55F28-495C-529C-BC99-36EBC873DC8B":{"t":"مختارات (9-12)","p":118,"s":"مختارات (9-12)","r":"450252","v":[["66444170-53CA-522F-B8CE-E7DCB13BDA16","طَلَعَتْ شمس من أحبّ بلَيّلٍ فـ","ـاستنارت فما عليها من غروب"],["A69AB53E-C565-507A-806E-DC106427D521","عن شمس النهار تطلع باليلـ","ـلِ وشمس القلوب ليس تغيـب"],["AAAD7E55-F09B-50A9-A14B-87428FA8472E","رأَيتُ ربّي بعين قلبِ","فقلتُ من أنت قال أنت"],["813D8F91-A2B0-5A6D-A35A-17A7F9074557","فليس للأين منك أينٌ","و ليس أين بحيثُ أنت"],["521A115C-AA8A-54FB-B5F1-4F3668105E95","و ليس للوهم منك وهمٌ","فيعلم الوهم أين أنت"],["2BE96BE8-D368-5EED-9B1A-8E286911055E","أنت الذي حُزْتَ كل أين","بنحو لا أينَ فأينَ أنت"],["7A26A06E-C294-59F8-95CB-FD3B9A0F3040","و في فنائي فنا فنائي","و في فنائي وجدت أنت"],["F8EDC25F-F40D-5C84-BA74-A885620AD884","لي حبيبٌ أزور في الخلـوات","حاضر غائب عن اللحظات"],["D158BDBC-05EB-5199-B655-9A6ABC461DC8","ما تراني أصغي إليه بسمــع","كي أعي ما يقول من كلمات"],["B15030A8-6E21-53C6-BFFB-29B55DB15CED","كلمات من غير شكل ولا نطق","و لا مثل نغمة الأصــوات"],["1FCB2353-0201-5F77-A108-9CBA385C7B8A","فكأنّـي مخاطب كنت إيــًّاه","على خاطري بذاتي لذاتــي"],["8546AFFE-6472-5FD4-9FA6-E302AF16F229","حاضـر غائب قريب بعيــدٌ","وهو لم تحوه رسوم الصفات"],["08518BBD-D5E9-5027-8CF2-3E771DBDF1EA","هو أدل من الضمير إلى الوهم","و أخفى من لائح الخطـرات"],["9A70B0CF-1F86-5002-9D85-F312D4A2EEA7","سرّ السرائر مَطْــوِيٌّ بـِاثـْبَات","في جانب الأُفْقِمن نور بـِطيَّات"],["5CC60D08-CC31-51BF-9EDC-3E24DFD28FF8","فكيف والكيف معروف بظاهــره","فالغيب باطنه للذاتِ بالـــذات"],["365E589E-9F3D-5BE8-AF55-B85B05DF0645","تـَاهَ الخلائقُ في عمياءَ مظلمــةٍ","قصدا و لم يعرفوا غير الإشارات"],["F268FB8E-4885-545C-B196-FC497DFB3BBA","بالظنّ و الوهم نحو الحقّ مطلبهـم","نحوَ الهواء يناجون السمــاوات"],["5D6EB722-1978-5D38-9AEF-51FF83308033","و الــربّ بينهم في كـل منقـلب","مُحِلَّ حالاتهم في كل ساعــات"],["0DD7F9D6-0D6B-5B99-84B1-FA3E969432D1","و ما خلوا منه طرف عين لو علموا","و ما خلا منهم في كل أوقــات"]]},"9AE0ED09-F761-5455-B34F-78E5DF186732":{"t":"مختارات1 (1-4)","p":118,"s":"مختارات1 (1-4)","r":"450250","v":[["3A3742B2-3B27-5775-8D1A-91ACC11F91B5","و أيّ أرض تخلو منك حتّى","تعالوا يطلبونك في السمـاء"],["30145739-7225-53CA-B39E-F02FD78ACE01","تراهم ينظرون إليك جهـراً","وهم لا يبصرون من العماء"],["4724CFAB-C8EB-55DE-B685-79F5A5C5DA09","إلى كم أنت في بحر الخطايــا","تبارز من يراك و لا تـــراه"],["A0D2B10E-0E2D-526A-BF18-E62F492DAE08","وسمتـُك سمت ذي ورعٍتـِقّي","و فعْلك فعل متـّبع هـــواه"],["5479D531-D2E9-5A3F-B71E-5D3501FC1DA9","فيـا من بات يخلو بالمعاصـي","وعين الله شــاهدة تـــراه"],["29AA4933-F1ED-5ED0-A48F-4566D05DD72C","أتطمع أن تنــال العفو ممّــا","عصمتَ و أنت لم تطلب رضاه"],["5D09326C-0A95-560B-97CF-27F8DD20CFB6","فـَتـُبْ قبل الممات وقبل يـوم","يلاقي العبد ما كسـبت يــداه"],["10AF42B2-4A0E-54FE-A58E-9CD3BD39A76A","أتفرح بالذنـوب والخطـايــا","و تنسـاه و لا أحد ســـواه"],["70BF8871-EC3B-5CFC-AEF8-15DB120BBCE3","كانـت لقلبي أهواءٌ مفرّقــة","فاستجمعَتْ مـُذْ راءَتـْك العين أهوائي"],["05D61BA1-C95E-5980-8662-CD3FE890A697","فصار يحسدني من كنت احسده","وصرتُ مولى الورى مُذْ صرتَ مولائي"],["701F8AD3-DF58-5076-B1CD-86643B2A9540","ما لامني فيك أحبابي و أعدائي","إلّـا لغفلتهم عن عظـم بلوائــــي"],["76AA1C7C-AC8C-59A6-84EC-950D2608D476","تركتُ للناس دنياهم و دينهـم","شغلاً بحبـّك يا ديني و دنيائــــي"],["E91D237E-A0C0-5570-B598-7FB9B987CE0C","أشعلتَ في كبدي نارين واحدة","بين الضلوع و أخرى بين أحشائــي"],["C86316A2-B57B-54DE-94DC-31C1C4B94D7E","إذا دهمَتـْك خيول البعـــاد","ونادى الاياس بقطع الرجـا"],["41947B66-6D8F-55C6-991F-3E2D9B6D5EC3","فخُذْ في شمالك ترس الخضوع","و شـُدّ اليمين بسيف البكـا"],["FDACC38D-DA86-5034-964C-EC0DE3B16E64","و نَـفْسَـك نَفْسَك كُنْ خائفـاً","على حذر من كمين الجفـا"],["955FDF77-68EE-5D29-B3A7-4CC7DA413619","فإن جاء الهجر في ظلمـــة","فسِرْ في مشاعل نور لصفا"],["C64A3BAF-5F5C-58C0-83EF-C9C5AC3C8501","فقـُلْ للحبيب ترى ذلـّــتي","فجُدْ لي بعفوك قبل اللقــا"],["1078BB8B-7FE7-5DCC-AF79-C35BC0449293","فـَوَ الحُبِّ لا تنثنِي راجعــاً","عن الحِبِّ إلّا بِعَوْضِالمنـا"]]},"08ACFE2C-F8A0-59EB-9A86-12EFE5AB8DAA":{"t":"مراحل على الطريق","p":118,"s":"مراحل على الطريق","r":"450242","v":[["692D6E5E-0C89-5544-97B6-9D5A63D79922","سكوتٌ ثم صمتٌ ثم خَرْسُ","و عِلْمٌ ثم وَجْدٌ ثم رَمْـــس"],["838D6931-E8D8-5903-B500-3EBB966970E0","و طينٌ ثم نارٌ ثم نـــورٌ","و بردٌ ثم ظلّ ثم شمـــس"],["3AC40871-1277-58F8-91F5-637A96F777D0","و حَزْنٌ ثم سهل ثم قَفْـٌـر","و نهر ثم بَحْرٌ ثم يَبْــــس"],["C1DA795B-9349-538E-B39A-3D77B6F9424B","و سكر ثم صَحْوٌ ثم شوقٌ","و قرب ثم وفر ثم أُنْــــس"],["D4D97DF6-B7A0-5763-8E9D-128F48C4D4C8","و قَبْضٌ ثم بسط ثم مَحْوٌ","و فرق ثم جمع ثم طَمْـــس"],["2AE1ED67-D6E3-5451-BB8B-63A2470009D7","و أَخْذٌ ثم ردّ ثم جـذبٌ","و وصف ثم كشف ثم لبــس"],["36692505-3BCB-5D53-BD31-D892E34EA569","عبارات لأقوامٍ تسـاوتْ","لديهم هذه الدنيا و فِلْــــس"],["E8E99055-9A72-540D-8EB6-8F8FA70CEC3B","و أصوات وراء الباب لكن","عبارات الورى في القرب همس"],["E3FF27CF-5579-52D4-BA67-D9B41025112C","وآخر ما يَؤول إليه عَبْـٌد","إذا بلغ المدَى حظّ و نفـــس"],["7973CFC6-F5E9-5BB8-B76F-4BD179D035AF","لأنّ الخلق خدّام الأمانـي","و حقّ الحقّ في التحقيق قُـدْس"]]},"CD295D41-7B01-5DF5-BDC3-3EFBC1E6DB0A":{"t":"ناي (في وصف فقد حاله)","p":118,"s":"ناي (في وصف فقد حاله)","r":"450244","v":[["49E4784B-AF68-5030-96E3-788A2D678A68","أَنْعَى إليك نفوساً طاح شاهدُها","فيما وراء الحيثِ يَلْقَى شاهد القِدَم"],["C42B6C5A-705E-55CC-9330-508E14F863B1","أنْعي إليك قلوباً طالما هَطَلَتْ","سحائبُ الوحي فيها أبْحُر الحكـم"],["CC6EF4B5-5CD6-55BB-A1BF-AC226F888BFC","أنعي إليك لسان الحق مُذ زمن","أودى و تذكاره في الوهم كالعـدم"],["75F1BCE3-162D-5E0D-88D5-AADE2098A66D","أنعي إليك بيانا تستكين له","أقوال كل فصيحٍمِقْوَل فهـــم"],["6F3DF2FC-3940-5864-8E5F-C89EB26DCDD1","أنعي إليك أشارات العقول معاً","لم يبق منهنّ إلا دارس الرمــم"],["64A259EC-442D-5212-9EFA-F1079E051C94","أنعي و حُبِّك أخلاقاً لِطائفةٍ","كانت مطاياهم من مكمد الكظـم"],["34CE3689-89D3-5836-9561-63590273DF2E","مَضَى الجميع فلا عين و لا أثـُر","مُضِيَّ عادٍ و فـُقـْدانَ الأُلى إِرَم"],["DA289209-E377-5053-8566-50582B58FA21","و خَلّفوا معشراً يجرون لبستهم","أعْمى من البهم بلْ أعمى من النعم"]]}}}