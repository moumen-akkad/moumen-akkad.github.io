{"v":1,"poems":{"3CA78D0D-534B-58F4-AAEE-372F58807F98":{"t":"وَاخَجَلَتَا للِطَّيْفِ لَمَا سَرَى","p":152,"s":"واخجلتا للطيف لما سرى","r":"466117","v":[["DB253423-7FDA-51E5-8D8E-178D77BCC775","وَاخَجَلَتَا للِطَّيْفِ لَمَا سَرَى","في خطرِ الليلِ إلى ساهرِ"],["2EC0A556-D18F-543D-9047-716540967790","زِيَارَة ضَاعَتْ وَلَكِنَّهَا","جنايةٌ الشوقِ على الزائرِ"]]},"6D5F95A7-8B04-5661-8734-120C0CAFBD01":{"t":"وَقَتْكَ صُرُوفُ الدَّهْرِ يَا ابْنَ مُقَلَّدٍ","p":152,"s":"وقتك صروف الدهر يا ابن مقلد","r":"466002","v":[["8E788629-4795-5F9E-ABE9-93FE7D65F7F2","وَقَتْكَ صُرُوفُ الدَّهْرِ يَا ابْنَ مُقَلَّدٍ","ولا زلتَ تدعو سعدَها فتجيبُ"],["4C4C7AC7-6404-51B9-8196-925517B63918","وراحتْ رزاياهَا عليكَ شفيقةً","كأنَّ الخطوبَ الطارقاتِ قلوبُ"],["6D2D7502-CEF6-5E05-B12A-49A5218EF4A0","وَلا صَحِبَتْ كَفَّاكَ غَيْرَ صَوَارِم","لها في صدورِ الدارعينَ وجيبُ"],["B4CEBD87-57B9-502F-810D-64CA9FF77B9F","تُنفرَ عنكَ الحادثاتِ كأنهَا","غوان وبيضُ المرهفاتِ مشيبُ"],["AE6A8A88-2689-5B14-B4DF-11BA1B8253F0","فقدْ زالَ داء كنتَ فيمَا أماطَهُ","كمَا ثُقِّفَ الخطيُّ وهوَ صليبُ"],["CB3C9973-5C01-51EF-8F4B-13F7E86537B3","وَقَدْ يُصْقَلُ الهِنْدِيَُّوَهْوَ مُذَرَّب","ويسمحُ عطفُ المرءِ وهوَ أديبُ"]]},"1D9150DC-F3EA-5AEF-99A0-271CFCFC77F9":{"t":"وَلَيْلَةَ وَصْلٍ غَابَ عَنَّا رَقِيْبُهَا","p":152,"s":"وليلة وصل غاب عنا رقيبها","r":"466105","v":[["048F99F6-E0C5-5EA7-B8E5-D16A89DC1DAF","وَلَيْلَةَ وَصْلٍ غَابَ عَنَّا رَقِيْبُهَا","معَ الدهرِ لا عادَ إلى آخرِ الدهرِ"],["70E8C155-E0F5-5D99-B142-8A1F8F8A4B12","نَهَيْنَا بِهَا جُنْحِ الظَّلامِ فَمَا بَدَتْ","أَوَائِلُهُ حَتَّى خَلَطْنَاهُ بِالفَجْرِ"]]},"8060B7E5-5389-558D-89DB-94ECEBFC78C1":{"t":"وَمُعَذَّلٍ جَارٍ عَلَى غُلَوَائهِ","p":152,"s":"ومعذل جار على غلوائه","r":"465990","v":[["89A8FAF3-496F-5B7A-A7A0-2737BE5AF521","وَمُعَذَّلٍ جَارٍ عَلَى غُلَوَائهِ","يُروى حديثُ نداهُ عنْ أعدائهِ"],["75B0357A-A893-51F4-BD10-EC4B0AF259BF","لدنٍ كعاليةِ القناةِ يخفُّ في","عَزَمَاتِهِ وَيَميدُ في أَهوَائهِ"],["08C00C6B-9D4A-50FF-A1E7-58B668EB6F39","ثَمِلُ الشَّمَائلِ مَالَ في أَعْطَافِهِ","وَوِدَادِهِ وَنَعِيمِهِ وَشَقَائهِ"],["5E0153A0-B29F-5E12-AF82-2C7BF4B2E8A1","عجلتْ عليهِ يدُ الحِمامِ وعودهُ","ريانُ منْ خمرِ الشبابِ ومائهِ"],["976C9B7F-F26A-5435-A51C-97360823AAF4","وتتابعتْ هفواتهُ ولربمَا","فلَّ الخطوبَ بخطرَةٍ من رائهِ"],["DEFA4A8A-ABC7-5056-AF7C-9FBDF01BF8CF","عَجَباً لِحَدِّ السَّيْفِ كَيْفَ أَصَاَبهُ","وَمَضَاؤهُ في الرَّوْع دُونَ مَضَائهِ"],["E77655F8-2E54-534E-8B5C-5201789E9894","وَلِمَصْعَبٍ مَلأَ الزَّمَانَ هَدِيرُهُ","قادوهُ بعدَ شماسهِ وإبائهِ"],["515A6326-9ECC-53E0-8054-F0FC910E7C06","إنْ يرفعوهُ فقدْ غنُوا بعلائهِ","أو يشهروهُ فقدْ كفوا بثنائهِ"],["FE12DE64-421F-5554-8C35-A9B12E0AC713","أَوْ تُبْدِع الأَعْدَاء فيه فَسُنَّةٌ","للدَّهرِ جاريةٌ على نُظرائهِ"],["463EFB33-FAA8-5E55-8CEA-8866108F992D","لا يَفْرَحُونَ بِهَا فَكَمْ مِنْ شَامِتٍ","بحمامهِ ولعلهُ في دائهِ"],["6389DA18-7BC0-5229-9CB8-22D536A3E536","يَا صَاحِبَ الجَدَثِ الغَرِيبِ وَدُونَهُ","خطرٌ يُعَدُّ مسافةً في نائهِ"],["906E8975-AF4B-577F-A95B-777C2FCB0EA3","ذَكَرَ الغَمَامُ عَلَى ثَرَاكَ عَلاَقةً","تَجْري بِهَا العَبَرَاتُ مِنْ أَنْوَائهِ"],["7F1F389F-AF6B-5D53-8383-44429192E5F8","وَتَنَفَّسَتْ فِيهِ الرِّيَاحُ مَرِيضَةً","من حرِّ نارِ الحُزنِ أو برحائهِ"],["A4CF3BB7-100C-5890-9F23-545C426D1BF9","فلقدْ جفوتُكَ رهبةً ولربمَا","هجرَ الصديقُ وأنتَ في أحشائهِ"]]},"D23D7055-F7F9-5D81-9D2C-A6899D5E7BD8":{"t":"وَهَبَّتْ لَهُ رِيْحُ الصِّبَا فَأَرَيْتَهُ لِمَنْ دِمَنٌ بَيْنَ الغُوَيْرِ وَأَرْبُعُ","p":152,"s":"وهبت له ريح الصبا فأريته لمن دمن بين الغوير وأربع","r":"466141","v":[["EEA5AC33-157C-553F-B24A-64E462BDD08F","وَهَبَّتْ لَهُ رِيْحُ الصِّبَا فَأَرَيْتَهُ لِمَنْ دِمَنٌ بَيْنَ الغُوَيْرِ وَأَرْبُعُ","تَوَّهُمَهَا جِفْنُ مِنَ الدَّمْعِ مُتْرَعُ"],["AD94B54A-D4F4-5957-A3C4-759B878A644B","محاها صبوحُ الغين بعدَ غبوقهِ","وَهَبَّتْ بِهَا رِيْحُ الصِّبَا وَهِيَ زَعْزَعُ"],["9A9EE9CE-4A40-5E57-8E59-F9C48E39EF56","يَقُولُ صِحَابِي هَلْ نَسِيْمُ حَدِيْقَةٍ","تنفسَ أمْ ذكرُ الهوى يتضوعُ"],["B06FC187-77D5-5D05-B664-204A3EC168E2","فأقسمتُ ما أدري أركبٌ تناشدُوا","عَلَى الدَّارِ أَمْ لَحْنُ الحَمَائِمِ تَسْجَعُ"],["21722BD9-FAE0-558A-95B8-052DB5303D5C","ونارٌ على الجرعاءِ يدعو بها الدجَا","إِلَى الطَرْفِ أَمْ بِيْضُ القَوَاضبِ تَلْمَعُ"],["1128568A-B193-5AA3-B329-E6EA23AEB165","وَقُلْتُ لِسَعْدٍ والنُّعامى تَنُوشُهُ","وقدْ أثملَ الركبَ الحنينُ المرجعُ"],["A75A6DB3-4C1A-5BAD-9222-EA476B6C449B","تصاممْ عنِ الأنضاءِ أو فالتمسْ لهَا","فؤاداً يعاطيها الغرامَ ويجزعُ"],["551876A9-8C86-5D6C-9CE2-CD79E3D72B62","ودعْ عنكَ إيماضَ البروقِ فإنَّها","صوارمُ في سرِّ الجوائحِ تقطعُ"],["25F983FF-28CE-53D8-93E4-456690C8396B","فَلَمَّا أَبَى إِلاَّ نِزَاعاً فُؤادُهُ","شَجَانِي جَوَاهُ فَالعَزُولُ المُفْجَعُ"],["9A7A6437-256B-590F-AE63-C5960A7C7D0F","وَهَبَّتْ لَهُ رِيْحُ الصِّبَا فَأَرَيْتَهُ","فؤادَ الحزينِ كيفَ يمضِي ويرجعُ"],["3B68262C-5FF6-55EC-832F-572E266894B5","خليليَّ إنْ لمْ تعرفَا زفرةَ النوَى","وَلَمْ تُسْعِدَانِي فَانْظُرا كَيْفَ أَصْنَعُ"],["47E240CE-F013-53C7-A7F9-9E044B87EFDE","تَجَاهَلْتُ حَتَى أَنْكَرَتْنِي خَفَاجَةٌ","وقالتْ بمَا ضلَّ الأعزُّ المشيعُ"],["AEB6E57D-8733-5199-80DD-E42ACD71D42A","وأصبحتُ أرجُو أنْ تعودَ أنايتي","وَلَيْسَ لِمَنْ تَطْوِي المَنِيَّةُ مَرجَعُ"],["24733C1A-E97F-50B5-8524-D6DD3489F845","توقد أسى ما ذلكَ العهدُ عائدٌ","عَلَيْكَ وَلا فِي قُرْبِ غَيْدَاءَ مَطْمَعُ"],["ADC4B642-DDE2-544A-B51E-4CAECA415B18","بَنِي عَامِرٍ يَلقُونَ بِي جَمْرَةَ العِدَى","وأنصركُمْ واليومَ بالنقعِ أشفعُ"],["B180BCE3-7108-5242-9163-FE09113A6913","ويسهرُني منْ شفَّ جسمي فراقهُ","فَأنْظُرُ طَرْفَا في العَشِيْرَةِ يَهْجَعُ"],["095F8380-C7DD-5D72-957F-06B83D5A668E","تَحَامَوْا ورُودَ الصَّبْرِ أَو فَاتْبَعُوا فَتَى","يقومُ بما قامَ الكريمُ السميدعُ"]]},"CCC4DFEE-BCA8-5A86-8F55-DB8A06124170":{"t":"يا إخوتي منْ مالكِ بنِ كنانةٍ","p":152,"s":"يا إخوتي من مالك بن كنانة","r":"466018","v":[["216FBE58-9FFE-5E55-A64B-1D4BB9A328B4","يا إخوتي منْ مالكِ بنِ كنانةٍ","حيثُ السيوفُ تطولُ بالأحسابِ"],["41155174-229F-5DE0-9481-F2EDCD0A6278","لا تسألوا عني الخيالَ فإنهُ","مَا زَارَني مِنْكُمْ فَيَعْلَمُ مَا بي"],["BF15A56A-E8A8-5ABB-9EF5-C9684B8BB41C","وَاسْتَخْبِرُوا لَيْلاً رَعَيْتُ نُجًومَهُ","فنضا ولمْ ينصلْ دجاهُ شبابي"],["8BF1EB36-4ED0-5D40-95A8-7A77E711F660","سَهِرَتْ كَواكِبُهُ مَعي وَبَعُدْتُمُ","أنتمْ كواكبهُ وهنَّ صحابي"]]},"DAFAF060-C7E2-5405-8862-9C47C6886E69":{"t":"يا غائباً ببعادهِ وحمامهِ","p":152,"s":"يا غائبا ببعاده وحمامه","r":"466239","v":[["61AE6F87-CE99-5D93-BF0F-759D421DA53A","يا غائباً ببعادهِ وحمامهِ","جارَ الزمانُ عليكَ في أحكامهِ"],["60F275AA-A9D2-5C60-B8A2-208C03B9473D","لِتَطِل لَيَالِي الدَّهْرِ بَعْدَكَ إنَّهُ","سَيَّانْ بَيْن صَبَاحِهِ وَظَلامِهِ"],["ACD8F70B-0A70-58F8-8253-2F910FFBE6DA","سودتهُ في ناظري كأنمَا","خلعتْ لياليهِ علَى أيامهِ"]]},"37B6695D-6A45-5666-96A6-0E6BC696EA53":{"t":"ياَ حَبِيْبَا وُدُّهُ لِلنَّـ","p":152,"s":"يا حبيبا وده للنـ","r":"466183","v":[["63834926-D1F0-5BF5-91E7-C95E1137B32C","ياَ حَبِيْبَا وُدُّهُ لِلنَّـ","ـاسِ تمثالُ النفاقِ"],["1D177EFC-4091-5623-A5F7-879094F7F4FA","أَنْتَ بَدْرُ التَمِّ لَكِنْ","لكَ عهدٌ في المحاقِ"],["3CF493D2-FF58-512C-9AF2-89A53F493CBB","قدْ بلوناكَ علَى حَا","لِ التَّنائي وَالتَّلاقِي"]]},"1B97F663-9ECE-5906-B6B3-899DA635462A":{"t":"يقصرُ مالي في الحوادثِ عنْ بذلي","p":152,"s":"يقصر مالي في الحوادث عن بذلي","r":"466206","v":[["DA983B84-A440-5372-AFF3-0166D45FC89B","يقصرُ مالي في الحوادثِ عنْ بذلي","فمَا عذرُ دهرٍ لا يجودُ علَى مثلي"],["51CC2C95-A08B-595E-B50B-1AA431792B0B","رَمَتْنِي رِجَالٌ بِالوَعِيْدِ كَأنَّمَا","تَرُومُ مَرَامِي أوْ تُنَازِعُنِي فَضْلِي"],["ADAE6BAF-5FB1-5588-982D-5364B9919888","وقدْ أمنُوا أنْ يمنعَ السبَّ منْ فمِي","فهلْ أمنُوا أنْ يمنعَ الضربَ منْ نصلي"],["5B928BCF-24D3-5AD4-B7A4-242AEB210190","وَيَحْسَبُني دَهْرِي أَرُومُ عَطَاءَهُ","فَيُوسِعُني قَبْلَ السَّؤالِ مِنَ البُخْلِ"],["AE8FABD1-A673-5B35-9CC2-7E8154B39B09","وَهَلْ كُنْتُ أرضَى أنْ أنَالَ حُطَامَهُ","وأعلمُ أنَّ الحظَّ فيهِ معَ الجهلِ"],["386BA4A5-6C34-58F9-A00B-BADC813DEC88","أنِفْتُ مِنَ الدُّنْيَا فَمَا طلَبَتْ يَدِي","ولاَ طمعتْ نفسِي ولاَ وخدتْ إبلي"],["C5BBE40B-E2E9-5858-9CD1-A3C190DC5103","وَمَنْ كَانَ فِي بَرْدِ القَنَاعَةِ رَافِلاً","أصابَ الغنى في الفقرِ والخصبَ في المحلِ"],["E2AA4924-DED8-5C48-A8FE-6A7A66901CD9","أُلامُ إذَا مَا نَاوَشَ الدَّهْرُ جَانِبي","وأيُّ حسامٍ لا يحادثُ بالصقلِ"],["BEF3B954-B439-5418-8244-657A3821A428","وَمَا هُو فِي مَا بَيْنَنَا مِنْ ضَغِيْنَةٍ","بمطرحِ قولي ولاَ جاهل فعلي"],["0B677467-70D4-5F86-A619-915F237E33A2","وَكُنْتُ أُمَنِّي النَّفْسَ بَنْدا مِنَ الغِنَى","يُحَسِنُ مُعْرُوفِي وَيُوسِعُ فِي فَ"],["F293344B-B907-5312-81BA-CF44C8AD0215","أَمَّا وَقَدْ فَارَقْتُ آل عُذَيْبَةٍ","فلاَ خيرَ في حزنٍ منَ العيشِ أو سهلِ"],["2071106C-2DCC-5619-A7D5-E82D5C9F5787","ألا إنَّمَا وَارَيْتِ يَا أُمَّ عَامِرٍ","عهودَ الصبا بينَ الصفائحِ والرملِ"]]},"29989C88-C0F1-5713-A8E9-3A2A60F71B16":{"t":"يَا حَادِيَ الأَظْعَانِ أَيْنَ تَمِيْلُ","p":152,"s":"يا حادي الأظعان أين تميل","r":"466192","v":[["81A649E5-0C5D-5A2D-830C-97E75BDAC648","يَا حَادِيَ الأَظْعَانِ أَيْنَ تَمِيْلُ","هيَ وجرة وسؤالُها تعليلُ"],["78879073-10D6-5E6A-B57C-B8C4CB33F049","ما هذهِ في الربعِ أولُ وقفةٍ","وَقَفْتَ فينشُدُ قَاتِلاً مَقْتُولُ"],["E53434C5-BE07-5027-B3BA-B26EB127DB47","عُجْنَا بِنَاحِلِ رَسْمِهِ فَتَحَيَّرَتْ","فيهِ دموعٌ ما لهنَّ مسيلُ"],["A3290016-6F98-5192-A363-C594E15353BE","وتحملتْ ليد السحابِ طلولهُ","منَّا ونحنُ سحائبٌ وطلولُ"],["93CB0BF5-DF42-5E5A-B452-AEC8407E1DEE","وعلَى العذيبِ ولا أغشكَ بانةٌ","مَا ظِلُّها لَولا السِّقَام ظَلِيلُ"],["113AD56A-589C-52A3-A42C-2EFEF2AF107C","ومرنح في الكورِ تحسبهُ الصبَا","غصناً يميدُ بمرهَا ويميلُ"],["0F28933E-249F-577F-8B36-0863DDC16E60","حَمَلَتْ إلَيْهِ تَحِيَّةً وَنَسِيمُهَا","أَبَداً عَلَى دينِ الغَرَامِ رَسُولُ"],["0B4B5675-2A1D-5224-85BD-13CD2B2C8852","مَا كُنْتُ تُخْبِرُ قَبْلَهَا عَنْ حَاجِرٍ","إلاَّ وطيبكَ شاهدٌ مقبولُ"],["2EF4D0FF-73F9-5BED-A0B7-531B8EF63029","وتبثُّ ما كتمَ الأقاحُ ولوْ درَى","مَا كَانَ مِنْكَ لِثَغْرِهِ تَقْبِيْلُ"],["8E6F727C-F3AA-5EAE-82DC-6FCE6673C6E1","وَفَوارِس أَلِفُوا القَنَا فَكَأنَّهُ","قَبْلُ الطِّعَانِ بِبَوعِهِم مَوْصُولُ"],["2B335177-7B18-5475-98E2-8C83DFA08547","ذعروا الظلامَ فما يمرُّ عليهمُ","إلاَّ وعقدُ نجومهِ محلولُ"],["A65B14E7-FDEC-55E3-9099-89EF91596124","طَمَحَتْ بِهِمْ آمَالُهُمْ وَلِواؤهُمْ","قدرٌ بما وعدَ الكرامُ مطولُ"],["58FE568A-F46E-58C2-AD94-E49423E7F6D8","ومطوحٍ ركبَ الخداعَ مطيةً","مَا ظَهْرُها يَومَ اللِّقَاء ذَلُولُ"],["1DE108B6-B04A-5918-B9E8-4065A098F24E","كيفَ اهتديتَ لعامرٍ ورعالُها","سدف وسترُ مجالِها مسدولُ"],["6CDF8F0E-6FAE-50CA-8459-1B9FD4C7D8AF","جمحتْ بكَ الخيلاءُ حتَّى هجتهَا","شَنْعَاء ثَارَ صَرِيعُهَا مَطْلُولُ"],["6AB7209D-B007-5AF5-ABE6-EC673C60D83C","وَبَدَتْ مَخَائِلُهَا لَدَيْكَ مُضِيئةً","لوْ كانَ عندكَ للصباحِ دليلُ"],["9218B9A0-F2EF-5A7E-A9E6-6F7039ADFD90","وَظَنَنْتَ عَوْفاً بِالطِّعَانِ بِجِيْلَةً","ظنٌّ لعمركَ بالحمامِ جميلُ"],["94F5D9A0-B49D-5A12-AFE7-E37490E5E76B","أوَ ما بسنجارٍ لقومكَ مصرعٌ","شَهِدَت بِهِ فِي المُرَهِفَات فُلُولُ"],["FE79CF0D-B225-5187-B346-EE6035B3D8E0","طَلَبُوا النَّجَاءَ فَكَانَ فِي أعْمَارِهِمْ","قصرٌ وفي سمرِ الذوابلِ طولُ"],["0DA42E9D-19ED-5ADF-AE87-EC60916771D0","فذرِ العراقَ طريدةً مبذولةً","سبقَ الأسنةُ سرحهَا المشلولُ"],["ABCAC365-2D0E-5688-880A-42C7D2F76B8F","وامنعْ حليفكَ بالعراقِ وقلْ لهُ","هَيْهَات ذَادَ عَنْ الفُرَاتِ النَّيْلُ"],["EEF5CB39-2E81-5FA4-823D-CA8D7A2816FB","وحذارِ منْ كلأ الجزيرةِ إنهُ","مرعَى بأطرافِ الرماحِ وبيلُ"],["679E13DC-1ABF-5AB1-AB2E-E956ED287EC2","صحتْ فليسَ سوَى الجفونِ مريضةً","فيهَا ولا غيرُ النسيمِ عليلُ"],["06C31427-A541-5417-8091-C44E269DD6F7","وَثَنَى زَعِيْمُ الدِّيْنِ فَضْلَ جِمَاحِهَا","فَاللَّيْلُ فَجرٌ وَالرِّيَاحُ قبُولُ"],["48236877-1523-5456-AF4E-D1914E236B0E","إنْ كَانَ حَلَّ بِهَا وَفَارَقَ دَارَهُ","فَاللَّيْثُ يُفْرَقُ بَأسَهُ لا الفِيْلُ"],["DC5DDD0A-7C3A-5697-B01D-928653B64A7E","نَشْوَانَ يَخْطِرُ لِلْنَّدَى في هزَّةٍ","علموا بها أنَّ السماحَ شمولُ"],["9FFBBD3E-5EFA-54A2-B596-9B8C88E7E741","يغتالُ بادرةَ الخطوبِ بريثةٍ","وينالُ أقصى الحزمِ وهوَ عجولُ"],["502F6BF0-5C79-5DA2-AD99-E55A74A1AE06","عَطِرَ الثَّنَاءَ تَضَوَّعَتْ أَوْصَافُهُ","طِيباً فَكُلُّ فَمٍ بِهِ مَعْلُولُ"],["B0405BFB-5605-55DB-BEF5-0E390720BF79","مَا كَانَ يُعْلَمُ قَبْلَ فَيْضِ نَوَالِهِ","أنَّ الغَمَامَ إذَا اسْتَهَلَّ بَخِيْلُ"],["73D3D3E5-33A0-514A-8EFF-16300C554473","فرقتْ عزائمهُ فشابَ لهَا الدجَا","خَوْفَا وَأَثَّرَ في الهِلالِ نُحُولُ"],["7E968A22-06A8-5485-BDAB-86092040E204","لَو أَنَّ للأَّيَامِ نَارَ ذَكَائِهِ","مَا كانَ فيها بكرة وأصيلُ"],["C0406C61-8BAC-5D1F-B187-BAE2A189FF65","شَرَف بَنُو عَبْدِ الرَّحِيم عِمَادُهُ","ولربمَا تضعِ الفروعَ أصولُ"],["C124C06B-9CB8-5493-B611-1C2197B9EA9F","أبقَى بهِ عبقَ الثناءِ لرهطهِ","والحمدُ حظٌ للكرامِ جزيلُ"],["DC665A80-491E-59A2-88AF-B9F5F6E167EA","قَوْمٌ إِذَا نَضبَ الكَلامُ وَأَظْلَمَتْ","للنَّاطِقِيْنَ خَوَاطِرٌ وَعُقُولُ"],["5A97E6DB-6568-529F-902D-5FEE72944E5D","شامُوا مضاربَ ألسنٍ عربيةٍ","تفري وماضي المرهفاتِ كليلُ"],["8D7D5E0D-B6B2-5245-B4FD-300D988CD8ED","إنْ فاَتَهُمْ بَرْدٌ يُلاثُ وَمِنْبَرٌ","فَلَهُمْ سَرِيْرُ المُلْكِ وَالإكْلِيْلُ"],["E977A774-5EEA-51D2-99F2-A4EF41B76A4B","نسبٌ هدى زهرَ النجوم منارهُ","وسواهُ فقعُ قرارهِ مجهولُ"],["7B2E6EF5-2217-58EA-97E0-1ED93421F38B","يا جامعَ الآمالِ وهيَ بدائدٌ","ومروضَ الأيامِ وهيَ محولُ"],["C7ACE79C-3C25-56B0-A74A-CB44D3FD360E","أعْني كَمَالَكَ أنْ تُعَدَّ فَضِيلَةٌ","كالصُّبْحِ لا رَثْمٌ وَلا تَحْجِيْلُ"],["6A237FF9-7916-5871-8FA0-C5152D52AE59","لولاكَ ما ارتجتْ الأكفُّ فلمْ يكنْ","فِي الدَّهْرِ لا أَمَلٌ وَلا مَأمُولُ"],["B596802D-7C51-5E81-BA8F-264A416F839F","مَا ضَرَّ نَاشِرَة وَرَأيُكَ فِيْهِمُ","أنْ لا يفارقَ غمدهُ مصقولُ"],["0F4CF27F-F7A9-580A-86FC-8CEF5377D934","قلْ للأميرِ أبي الأغرِّ ودونهُ","للطَّالِبِيْنَ سَبَاسِبٌ وَهُجُولُ"],["D9B3D485-D7FF-5B91-8CE3-DC3EAF4E10DB","عاداتُ جدكَ في العدَا منصورةٌ","أبداً وسيفكَ ضامنٌ وكفيلُ"],["10363F91-7BAD-5FD4-8950-685A26F69582","أسلفتَ جوثةَ منةً مشهورة","فَوَفَتْ بِحَمْدِكَ وَالوَفَاءُ قَلِيْلُ"],["07162FCA-BDDE-5CBE-9096-7F7AFAAED9FD","وثوى ابنُ عمكَ بالعراقِ وقومهُ","كالذودِ حنَّ وفحلهُ معقولُ"],["5790D2ED-4E5A-51BD-A05C-389E88ED0584","ما صدهمْ عنكَ الجفاءُ وإنمَا","مَالُوا مَعَ الأيَّامِ حَيْثُ تَمِيْلُ"],["5ABF2AAC-6DE1-58C9-B509-03BB30CA735D","وَغَرِيْبَةٍ دَارَتْ وَمَا نَبْغِي بِهَا","إِلاَّ الوِدَادَ فَهَلْ إليْهِ سَبِيْلُ"],["7B5A9F4B-FA4F-5864-A4F5-8D258776BA45","إن شُفِّعَتْ آمَالُهَا فِي نَيْلِهِ","فلتسمعِ الفصحاءُ كيفَ أقولُ"]]},"DBD775C8-6196-5FCF-B505-5D9C4EB26685":{"t":"يَا دِمْنَةً في الطُّلُولِ دَارِسَةً","p":152,"s":"يا دمنة في الطلول دارسة","r":"466044","v":[["9E76C50D-BEBF-53CC-9C8B-4CE33D5D81FE","يَا دِمْنَةً في الطُّلُولِ دَارِسَةً","أضيعُ ما كنتُ حينَ أنشدهَا"],["2E3C0A4E-1108-5C1B-9774-8B69706E126A","وَيْلاه كَمْ زَفْرَةٍ أُرَدِّدُهَا","فِيْكِ وَكَمْ عَبْرَةٍ أُبَدِّدُهَا"]]},"D81BD83B-4C92-5563-B7C6-04A0FC5B53C8":{"t":"يَا رَاكِبَ العِرْمِسَ الوَجْنَاءَ مُعْتَرِضَا","p":152,"s":"يا راكب العرمس الوجناء معترضا","r":"466153","v":[["01393756-0D4A-5895-B641-0FFA4AC7BCF6","يَا رَاكِبَ العِرْمِسَ الوَجْنَاءَ مُعْتَرِضَا","دُونَ العُذَيْبِ عَلَى مَيْثٍ وَأَجَرَاعِ"],["D1425CAF-6183-5D82-9FD7-D261C31AE0CD","بلغْ خفاجةَ عنِّي إنْ مررتَ بهَا","وَنَادِهَا لا أَجَابَتْ دَعْوَةَ الدَّاعِي"],["C6A62CCA-1E3D-5909-A286-E4747FDF68E3","يا خيبَ اللهُ منْ يرجُو نوالكمُ","كَمْ تَمْنَعُونِي آمَالِي وَأَطْمَاعِي"],["01C1C96E-6D61-5454-838D-730E9B574C7C","وتلبسونَ الهوينَا وابنُ عمكمُ","في ساحةِ الذلِّ مقذوفاً بجعجاعِ"],["CD78EEBE-C29E-5275-A63F-58BAB7D4D222","ظَنَنْتُمُ المَجْدَ أَذْوَاداً مُهَمَّلَةً","وثلةً صاحَ في أرجائها الرَّاعي"],["0F9D3D4A-3EAF-5430-943B-EC5A89ABF34F","فَرَوَّعَ الله جَارِي إِنْ جَزَيْتُكُمُ","إِلاَّ بِمُنْصَلتٍ كَالنَّجْمِ قَطَّاعِ"],["555C63BC-0CF8-5E1C-B035-1201C6CFC1F4","أنَا ابنُ منْ لمْ يدعْ ذخراً لوارثهِ","إِلاَّ الجِيَادُ وَسُمْراً ذَاتَ زَعْزَاعِ"],["5C8BE27D-0117-5411-BC86-AC4778C253BA","داني القِرَى لا يذمُّ الذئبُ صحبتهُ","ولا يَقِرُّ عَلَى هَمٍّ وَأَذْمَاعِ"],["0DCFF2AE-21A4-5F00-9632-23C3FF48F856","ذَنْبِي إِلَى القَوْمِ أَنِّي مَا حَمَلْتُ لَهُمْ","قَلْبَا ذَلِيْلاً وَكفّا غَيْرَ مِضْيَاعِ"],["CDE218A1-4C9C-590B-8B68-A16DBB6BF385","وأنكرُوا بي أسقاماً مؤرقةً","ولوعةً تتوارَى بينَ أضلاعي"],["CAFD3A72-9745-5A9B-A257-1403E7F1DDB0","وَمَا عَلَيْهِمْ إِذَا مَا قُلْتُ مِنْ طَرَبٍ","يا ديمةَ الغيثِ حيِّي سرحةَ القاعِ"],["50D40DA2-3E0B-51C6-A326-B8C625DBCC3E","نعمْ أحبُّ سُليمَى فاهجروا عذَلي","فَالقَلْبُ قَلْبِيَ وَالأَوْجَاعُ أَوْجَاعِي"],["3F43979D-739E-5FC0-8AEB-5B5C3B2648B2","وإنْ دعاني الهوَى لبيتُ دعوتهُ","والحبُّ أكرمُ ما لبيتُ منْ داعي"]]},"C771823F-FAA2-572E-87A7-CB795C5CC9A5":{"t":"يَا لغَنيٍّ مَا لِنَادِيكُمُ","p":152,"s":"يا لغني ما لناديكم","r":"466095","v":[["D0E803A6-6667-572B-9D38-550F15A5F446","يَا لغَنيٍّ مَا لِنَادِيكُمُ","قَدْ فَقَدَ الطَّارِقَ وَالسَّامِرَا"],["7F0E24E9-8E94-5CD8-A57C-FE346F007B45","وأهمِلَ السرح بأرجائهِ","لا ذائداً فيهِ ولا عاقِرَا"],["8F771094-382E-5FDC-B8DD-A859877CC803","لعلَّ عضباً للردَى بائراً","أصابَ عضبَ الدولةِ الباترَا"],["C55770D2-E06F-5DCF-B4C1-9398E81464BF","مَا وَجَدَ الوَارِثُ مِنْ بَعْدِهِ","إِلاَّ حَدِيْثَا فِي العُلا سَائِرَا"],["EC8AA308-7FE4-5B65-B960-1DEFF7DC9086","راحَ بنجلاء كلابيةً","تَسْفَحُ جُوداً فِي الثَّرَى قَاطِرَا"],["B4EF835F-46B9-5846-9756-4CD6BB784956","فَمَا لَهَذَا البَيِتِ مِنْ عَامِرٍ","لمْ يُبقِ بيتاً للندى عامِرَا"]]},"5A124FFD-E8A3-5305-82AA-32521E2F10E3":{"t":"يَا مَنْ رُمَيْتُ بِعَتْبِهِ حَاشَاكَ مِنْ","p":152,"s":"يا من رميت بعتبه حاشاك من","r":"466135","v":[["73A8B95D-6C8B-59B5-BBDB-C516825A2F20","يَا مَنْ رُمَيْتُ بِعَتْبِهِ حَاشَاكَ مِنْ","عَتْبٍ يَعُزُّ عَليَّ أَوْ إِعْرَاضِ"],["F6A5B2FD-4D94-563D-9824-EB520BBC0261","لِي أُسْوَةٌ فِيْمَا فَعَلْتُ وَلَسْتُ مَنْ","تخفَى عليهِ إشارةُ الأغراضِ"],["9EB080B2-EDAD-52A8-B3C6-655BA314DCEA","لولا هواكَ وجدتُني وخلائقي","شَمْسٌ وَسَيْفِي بِالقَطِيْعَةِ مَاضِي"],["24102F10-4DB9-56CA-AE51-A2B8C68D5438","فَاعْطِفْ عَلَيَّ وَلا تَكُنْ مُتَسَرِّعَا","فيما أحاذرهُ وخصمي راضِي"],["560F1DC1-B473-5116-B97C-359D66700DFA","وَمِنَ العَجَائِبِ أَنْ تَكُونَ قَضِيَّةٌ","يَرْضَى الخُصُومُ بِهَا وَيَأْبَى القَاضِي"]]},"CF0654D1-0CB8-522D-8E62-5DA7FA6C79BA":{"t":"يَا مُنْفِذَا مَاءَ الجُّفُونِ","p":152,"s":"يا منفذا ماء الجفون","r":"466272","v":[["888B85B4-B383-5093-97EA-1E50C074DC64","يَا مُنْفِذَا مَاءَ الجُّفُونِ","وَكُنْتُ أُنْفِقُهُ عَلَيْهِ"],["EBE98862-192C-5573-98B0-F929BB78D88D","إنْ لمْ تكنْ عيني فأنتَ","ـت أعَزُّ مَنْ نَظَرَتْ إلَيْهِ"]]},"322CD3B4-5A1E-5054-B21E-3F56F1C948E1":{"t":"يَا ناق إنْ أثرَى العذيبُ وروضَا","p":152,"s":"يا ناق إن أثرى العذيب وروضا","r":"466133","v":[["0E1A98A5-8935-59B3-A964-26CAD37D9C25","يَا ناق إنْ أثرَى العذيبُ وروضَا","فلنَا ديون بالأسنةِ تقتضَى"],["5416D8A7-21BE-5C27-B681-8191F26F8B0C","قدْ ماطلَ القدرُ الجموحُ بوعدهِ","فيهَا وآنَ لمغمدٍ أنْ ينتضَى"],["B4A5F8A5-73E7-5164-A903-DF4EA1D7F6A4","بيني وبينَ الذلِّ عزُّ قناعةٍ","نَبَذَ الجَمَامَ ابَاؤهَا وَتَبَرَّضَا"],["ADBB2E8E-6BB7-598C-A18C-317F4ECA58F1","وَسِنَانُ مُطَّرِدِ الكُعُوبِ مُثَقَّفٌ","كالصلِّ صرحَ بالوعيدِ ونضنضَا"],["C8120D38-2751-5CB5-8F8A-EA608585BC79","حُبُّ الغِنَى عَقَلَ اللِّئَامَ وَفَاتَهُ","طَيَّانُ أَتْرَبَ بِالثَّنَاءِ وَأَنْفَضَا"],["E20D323D-FABF-51CC-A968-85AC5E56CBAA","غصبَ السراحَ علَى بقيةِ زادهَا","وقرَى فأمحضَ للضيوفِ وأنحضَا"],["95D1EB2B-90E0-5711-83E9-FCA5145AF4F8","عرضْ ثراءكَ للخطوبِ وشلهُ","شلَّ الطريدةِ قبلَ أنْ يتعرضَا"],["9479BCCC-2F05-5484-B66F-91DFAB41D89C","وَأَنْبُذْ غِنَاكَ فَمَا رُزِيْتَ بِذَاهِبٍ","لمْ يبدُ عندكَ نفعهُ حتَّى مضَى"],["BCC0A803-7F49-59DA-BA04-5766B530F1A3","إنْ راعَني وضحُ المشيبِ فإنهُ","بَرْقٌ تَأَلَّقَ بِالخُطُوبِ وَأَوْمَضَا"],["D585AFE5-B282-5D5F-A64B-9B20E8C245F6","وَلَقَدْ أَضَاءَ وَأَظْلَمَتْ أَيَّامَهُ","حتَّى عرفتُ بهِ السوادَ الأبيضَا"],["3E9F3721-E156-5C55-A338-1A78A10349E4","وبجانبِ العلمينِ شاكٍ سرهُ","إنِّي رعيتُ لهُ النجومَ وغمضَا"],["E2165E75-C75A-5798-8959-126A0675DABB","ومرنحٍ فطنَ النسيمُ بوجدهِ","فروَى لهُ خبرَ العذيبِ معرضَا"],["69E2485A-B7D9-5DCB-8EE0-FB342DA48199","نَمْ وَاحْمَدِ اللَّيْلَ القَصِيْرَ فَلَيْلُهُ","بَادِي الهُمُومَ فَلا انْقَضَيْنَ وَلا انْقَضَى"],["C20CF794-1B84-561C-9EAE-0528B419BA27","وسلِ الصباحَ وقدْ أقامَ بحاجرٍ","إنْ كانَ أضمرَ أنْ يمرَّ علَى الفضَا"],["2C5B9FCD-7CB9-576E-BD5E-FCB709777D42","ذمَّ الزمانَ فمَا وجدتُ صروفهُ","إِلاَّ ذَلُولاً في القِيَادِ وَرَيِّضَا"],["C62DD08D-3B73-5B10-9AAF-DF978964F6CB","صفحتْ نوائبهُ عنِ ابنِ مقلدٍ","كرماً فكيفَ ألومهُ فيمَا مضى"],["F0103D05-7333-586F-B19D-3879245B78F4","ولقدْ ألمَّ بهِ فأظهرَ فضلهُ","والنارُ لا تشتبُّ حتَّى تحتضَى"],["CB4756B8-2F65-5676-B4AF-C4C003DAE9E4","راضَ الزمانَ فأصبحتْ أخلاقهُ","وَأَعَادَ صَبْغَ شَبَابِهِ لَمَّا نَضَا"],["C9C48C19-72D1-54C7-91A5-5E83518E545B","منْ معشرٍ بذلُوا النفوسَ سماحةً","وحمُوا بيوتَ المجدِ أنْ تتقوضَا"],["8466A0BA-EE0D-5D64-BE2C-29211BF4B74C","عادتْ بهمْ ظلمُ الخطوبِ مضيئةً","وَالجَدْبُ مُوشِيُّ البُرود مُرَوَضَا"],["20BCE823-CDF9-5E3F-9ED8-FF93911DA55F","لَولا مُخَالَطَةُ الصَّوَارِمِ وَالقَنَا","مَنَعَ السَّمَاحُ أَكُفَّهُمْ أَنْ تُقْبَضَا"],["9827373D-A5CF-56DD-96ED-C4600A4B40D2","قومٌ إذا استنجدتهمْ لملمةٍ","ملأتْ عليكَ جيادهمْ رحبَ الفضَا"],["1717F6FE-2471-5CE8-A087-DF275B553EE6","السُّمْرُ تَشرَعُ وَالدُّرُوعُ تَصُونُهَا","سُحْبِ السِّهَامِ كَأَنَّهَا رُسُلُ القَضَا"],["A3D8BDFA-7E83-5F94-ACA5-16195EB5F141","وَالنَّقْعُ يُسْفِرُ بِالظُّبَا فَكَأَنَّهُ","غضبٌ تبسمَ بينهُ لمعُ الرضَا"],["596C924F-CABC-5DCE-BD75-2CBC037996FA","أَسْيَافُهُم في رَاهِطٍ مَعْرُوفَةٌ","مَنَعَتْ دَعَائِمَ عِزَّهِمْ أَنْ يُدْحَضَا"],["0A6873C6-811B-5507-8679-B070FA3A0036","وَتَقَلَّدَ العُمَرِي مِنْ إِيْمَانِهِمْ","عاراً يطولُ عليهِ حتى يرحضَا"],["2C7F1614-ED4E-5BCD-97C7-FBC2D1B27581","يَا مَنْ إِذَا مَا ذَادَ عَنْ أَحْسَابِهِمْ","يَوْمَ النِّضَالِ أَصَابَ لَمَّا أَنْبَضَا"],["1C8C0D0F-3169-5A25-9B30-FE8B8D5B5230","خفضْ عليكَ فكمْ ظفرتَ بغايةٍ","وكبَا وراءكَ جاهدٌ ما خفضَا"],["1C41D1D9-531E-5ADF-9CE0-294E60B2A558","بيني وبينكَ ذمةٌ مرعيةٌ","حاشَا مرائرُ عهدِها أنْ تنقضَا"],["912EA78B-B0FD-5A10-BC16-B2F6CC6C542B","عَيْنُ الحَوَادِثِ دُونَهَا مَطْرُوفَةٌ","نظرَ المحبّ سلا وعاودَ مبغضَا"],["4EF3A46F-F5E3-52D8-816E-E32C1A431A4E","فَأَصِخِ إِلَيَّ وَللِحَدِيْثِ شُجُونُهُ","حَتَّى أَبُثَّكَ مَا أمَضَّ وَأَرْمَضَا"],["73A0D77D-237E-5767-A496-C574CE31EFAE","مَا أَخَّرَتْنِي عَنْ جَنَابِكَ هِمَّةٌ","وَجَدَتْ مِنَ الأَهْوَاءِ عَنْكَ مُعَوَّضَا"],["8A0EBF84-CAF9-59D7-A7E4-F636F4F9BFF4","لكنهُ قدرٌ أناخَ ركائبي","قَسْراً وَقَيَّدَ هِمَّتِي أَنْ تَنْهَضَا"],["FE52F823-518A-5026-8BDB-E4073EB60C6B","وعلمتَ أنكَ كالنسيمِ مخلدٌ","أبداً وليسَ يصحُّ حتى يقبضَا"],["E799A508-8B64-5B6B-B511-F888FDDE2C7A","فَاغْفِرْ لِخِلٍّ لَو أَبِيْعَ هَوَاكُمُ","بِحَيَاتِهِ هَجَرَ الحَيَاةَ وَأَعْرَضَا"],["943FC3FA-5882-5D37-A07C-06EBEF04C333","وفداكَ صبٌّ بالثراءِ محرمٌ","بسطَ البنانَ عليهِ حتى يقبضَا"],["7348A567-5253-5438-B196-98E053789D62","نَبَذَ الإبَاءَ فَإنْ تَنَكَّرَ حَادِثٍ","أَلْقَى مَقَالِدُهُ إِلَيْهِ وَفَوَّضَا"],["04E4E2E6-C4D4-59D9-ACE5-73081CDF6161","واسمعْ شواردَ لا تملُّ غريبهَا","حتى تملَّ منَ البقاءِ وتغرضَا"],["F48D19AD-427B-5AD6-8469-6B908210D1CF","قدْ كانَ يسهلُ خاطِري فكأنهُ","سَئِمَتْ رَكاَئِبُهُ الرِّيَاضَ فَأَحْمَضَا"],["D353AFA1-2CCF-5AFF-AAAF-A047E0671EDD","فِكْرٌ أَقُودُ بِهِ الجُمُوحَ كَأَنَّمَا","طبعُ الرضيِّ لهُ وعلمُ المرتضَى"]]},"917342DF-CF94-5448-A59A-E726FFA43043":{"t":"يَا نديمي علَى الهمومِ ويَا حَا","p":152,"s":"يا نديمي على الهموم ويا حا","r":"466254","v":[["67876AB8-DA8A-5BFF-B4A4-B616F88087BF","يَا نديمي علَى الهمومِ ويَا حَا","ملَ عنِّي في الدهرِ خوفاً وأمنَا"],["EB9184CC-7173-58FD-8BE5-154E494535FD","كمْ رعينَا الخطوبَ حلواً ومراً","وقطعنَا الزمانَ سهلاً وحزنَا"],["ACA82F20-2739-55C6-B6FB-7989D6A3D9DB","وَرَمَتْنَا صُرُوفُهُ بِهَنَّاتٍ","هُنَّ أَمْضَى مِنَ الأسِنَّةِ طَعْنَا"],["943BF12D-FAE5-5D14-9CA9-7127F2D6C00B","وعبوس فإنْ تبسمَ كأنَ اللؤمَ","منْ ذلكَ التبسمِ يجنَى"],["7B5B8F33-CA54-54C5-93D1-D446F3F6A633","ربَّ عينٍ إلى الدنيةِ شزراً","ء وأخرَى عنِ المكارمِ وسنا"]]},"B36717CD-5342-53C9-B75B-E3A18D75705C":{"t":"يَا نَازِحَا حَكَمَتْ عَلَـ","p":152,"s":"يا نازحا حكمت علـ","r":"466262","v":[["079E9F8B-56A7-5618-89F0-C2BBC8C93A75","يَا نَازِحَا حَكَمَتْ عَلَـ","ـيَّ بِبُعْدِهِ نُوَبُ الزَّمَانِ"],["4F188AE7-2CAD-5B0E-B745-0892715C2B0F","منْ لي بقربِ الدارِ","ـكَ وَلا أرَاكَ وَلا تَرَانِي"],["3C65B50C-90F9-566C-A18B-9FC74389197C","مَا كُنْتُ أحْسَبُ أنَّنِي","أرْضَى بِهَجْرِكَ فِي الأمَانِي"]]},"64686313-C3C9-5645-A5B6-F7F89624A9E8":{"t":"يَا نَاصِرَ الأمْرِ الَّذِي بِسُيُوفِهِ يَا نَاصِرَ الأمْرِ الَّذِي بِسُيُوفِهِ","p":152,"s":"يا ناصر الأمر الذي بسيوفه يا ناصر الأمر الذي بسيوفه","r":"466249","v":[["10EEDE21-BA04-555F-A8D0-DB56319080D4","يَا نَاصِرَ الأمْرِ الَّذِي بِسُيُوفِهِ يَا نَاصِرَ الأمْرِ الَّذِي بِسُيُوفِهِ","ذُلَّتْ أَعَادِيْهِ وَعَزَّ الدِّيْنُ"],["E0C381CA-3083-528C-9FBE-DEFA9A96EB77","أرهفتَ في ظلمِ الخطوبِ عزائماً","تُثْني بِهَا الأقْدَارُ وَهِي سُكُونُ"],["1DA614D6-4BE7-5208-BC28-AD15070C0DE2","أكْثَرْتُ حَاجَاتِي إليك مُثْقَّلاً","ورجاء مثلكَ كالحديثِ شجونُ"],["1060755D-FBBA-5B58-8FC7-1AABB85A399A","إنْ كنتَ واهبهَا فجودكَ غامرٌ","أو شَافِعَا فِيْهَا فَأنْتَ مَكِيْنُ"]]},"0A850F81-BBEF-5E9E-A256-1B96AEA5A432":{"t":"يَا نَسِيْمَ الصَّبَا تَحَمَّلْ ومَازلـ","p":152,"s":"يا نسيم الصبا تحمل ومازلـ","r":"466181","v":[["527E191D-C116-5071-B00B-3A2364A9BD82","يَا نَسِيْمَ الصَّبَا تَحَمَّلْ ومَازلـ","زلتَ معنَّى في خدمةِ العشاقِ"],["F17ABCC0-7B47-58D9-9BCD-DDFFF0A7BC91","حاجةٌ خفَّ حملُهَا ولهَا مِنْ","ثقيلٍ يبقى علَى الأعناقِ"],["9D0F2479-3927-5386-B467-1FDB26AF79C5","وتعرضْ بمنزلٍ في كفر طا","ب كثير الزُّوَّارِ والطُّراقِ"],["5D6831E0-3157-5AD6-87DB-4D26E7E0E28F","كيفَ يُسْتَطْلِقُ المُنَى مِنْ يَدِ الدهـ","ـرِ وَتَبغِي نَشَائِدُ الأرْزَاقِ"],["0CE018C0-C170-5B8C-9EC0-F28C3CED001C","فَاقِر مِنِّي لَهُ السَّلامَ فَقَدْ قِيْـ","قيلَ بلاغُ السلامِ بعضُ التلاقي"],["2C45719B-F8A7-5052-BCBB-AAB59DC61275","ثُمَّ قُلْ يَا بَنِي كِنَانَةَ مَا أَسْـ","ما حلتمُ عنِ الميثاقِ"],["0283F62F-F4DE-5247-8650-F82FC20E7469","أوْ بحكمِ المودعينَ إذا","لَهُ أن يَسير نَحْوَ العِرَاقِ"],["345D5A27-8D47-5151-95EE-AC3D9A9D0706","كلفٌ يخجلُ القلوبَ بدعوَا","هُ وشوق عادٍ عن الأشواقِ"],["731987CB-105A-5D33-91B7-3C11A19FB148","واحتراقٌ في العقلِ قدْ كادَ أنْ","يمزجَ عندي أخلاقهُم بالنفاقِ"],["4270BB49-7A6D-586E-9EBD-7C1441CD40A9","ثُمَّ يَا صَاحِبَ الجِنَايَةِ مِنْهُمْ","قدْ لقينَا في البعدِ ما لمْ تلاقِ"],["44F0B880-9903-554B-A1BE-5FB38F93F149","كَيْفَ تَرْضَى بِمُقْلَةٍ تَألَفُ النَّو","م وَدَمْعٌ يُصَانُ فِي الآمَاقِ"],["4832EC07-5B56-5A8F-9043-8554BAB8596B","وَزَمَانُ الصِّبَا يَمُرُّ وَقَدْ أنـ","أنفقَ أيامَه زمانُ الفراقِ"],["F61D7ADA-ADC2-5B77-8E30-189BDC2C5F37","وَاللَّيَالِي تَمْضِي سِرَاعا وَمَا يقـ","يقبلُ منَها إحالةً في البواقي"],["386EFEBC-EAA5-5E30-86B5-91E0FEBA69D9","فَاجِر فِي حَلْبَةِ الخَلاعَةِ مَا دُمْـ","ـتَ بِحُكْمِ الشَّبَابِ شَرُط السِّبَاقِ"],["1FC1BB5A-581A-5C0C-B37D-6C71AA494C9F","واعتمدْ مذهبَ الشريفِ فقدْ قَا","لَ النَّصَابي رِيَاضَةُ الأخْلاقِ"]]},"6D23F183-1A9B-5DB7-A4F6-C0A2AE2EBC6B":{"t":"يَقُولُونَ شُهُبُ اللَّيْلِ تَحَكُّمُ فِيْهِمُ","p":152,"s":"يقولون شهب الليل تحكم فيهم","r":"466232","v":[["5CEA1FEC-96C8-52DA-9774-29F6A5123CA3","يَقُولُونَ شُهُبُ اللَّيْلِ تَحَكُّمُ فِيْهِمُ","وأقسمُ ما سارتْ بعدلٍ ولا ظلمِ"],["182545EA-F7C9-5004-A64C-07C451C15B55","إذا فكرَ الإنسانُ في الدهرِ لم يجدْ","بَيَانَاً وَألفَى جَهْلَهُ غَايَةَ العِلْمِ"],["C290259B-BD19-5450-BCDC-114174BDA036","فعش فيهمُ أعمَى وإنْ كنتَ مبصراً","سفيهاً وإنْ نزهتَ نفسكَ بالحلمِ"],["E3C9BBA7-424A-592B-A61D-D8FF79DE1537","فَمَا العَيْشُ إلاَّ مَا غَنِمْتُ نَهَابَهُ","ولا العمرُ إلاّ طارق زارَ في حلمِ"],["F6872845-36FB-50D2-9DFF-591E06A872F4","لعمري لقدْ أنحَى الزمانُ بحربهِ","عَلَيَّ وَلَكنْ مَا جَنَحْتُ إلى السِّلْمِ"]]},"3A8D50C9-C315-51D0-9629-D176B3860EEE":{"t":"يُحَارِبُني فِي كُلِّ نَائِبَةٍ دَهْرِي","p":152,"s":"يحاربني في كل نائبة دهري","r":"466103","v":[["AB6581C0-6FC2-5CFC-BF46-759375C64F3F","يُحَارِبُني فِي كُلِّ نَائِبَةٍ دَهْرِي","كأنَّ الرزايا تدركُ الفخرَ في قسري"],["1B765E95-3D65-549A-89D6-22A7F37C755F","أَضُمُّ لِسَعْدٍ شَارِدَ المَجْدِ وَالعُلَى","وسعدٌ يراني بالتشاوسِ والشزرِ"],["A97683F7-31DB-5103-B582-1180BA387BC3","يحاولُ أنْ أرضَى الدنيةَ طائعاً","وأغدو بلا نابٍ يروعُ ولا ظفرِ"],["F30FF17D-AC47-5B28-BD6B-FF8DA5D97713","وَمِنْ دُون ذُلِّي عُصْبَةٌ عَامِرِيَّةَ","يلوونَ أعطافَ المثقفةِ السمرِ"],["2BD82E26-096E-5F1B-84A6-BC7118F4E6D2","إذا فوقَ الوسميُّ إبرادَ حاجرٍ","واثرت شِعَابُ الوَادِيَيْنِ مِنْ القَطْرِ"],["D2363B6D-D3EB-54B6-B6F4-89901477DEAE","فلاَ تأمنُوا أنْ تسمعُوهَا مرنةً","بقرعِ العوالي والمهندةِ البترِ"],["3C810F62-9328-59C3-934E-0F36A2BE5E3A","يقولُ أبو حزنِ طلبنَا لكَ الغِنى","فَلِمَ أَخَذَتْ كَفَّاكَ فِي طَلَبِ الفَقْرِ"],["FB13D4D9-8775-586F-981D-BE98E1AE305C","فَقُلْتُ رَأَيْتُ المَالَ يَبْلَى حُطَامُهُ","وَتَبْقَى أَحَادِيْثُ الرِّجَالِ مَعَ الدَّهْرِ"],["4CFEBC8A-1B76-5806-9B4B-C20987380D10","وشيبانُ لباني فلمَّا بلوتهُ","تقاعسَ عنِّي والأسنةُ في نحري"],["0694D1E5-0F36-5595-A545-DFF969999025","تحملَ عارَ الذلِّ واطرحَ الردَى","وطوقَها شنعاءَ أبقى منَ الذكرِ"],["101DB1D6-22B9-5561-BF6A-72470FC7404D","وَقَارَعَني ذُلاَّنِ عَيْش عَلَى النَّدَى","كَمَا قَارَعَ الغَيْرانُ عَنْ بَيْضَةِ الخِدْرِ"],["A4FEDD9C-8DBD-50AE-BA21-736A3C389CDA","أغادرتموهَا في الشريفِ خوامساً","طَلائِحَ لَمْ تَعْسِف بِسوقٍ وَلا زَجْرِ"],["26AB6AEE-1CDB-5C02-9FBA-0D306CC6D89D","فهلْ فيكمُ أنْ تمنعُوا نزواتِها","بميسم عارٍ فيكمُ ثابتَ الذكرِ"],["D9881916-BD5A-571A-8ABE-A1FC0C665A87","أَرُمْتُمْ مَدِيحي وَاطَّرَحْتُم ثَوَابَهُ","وَهَلْ تُمْلِكُ الحَسْنَاء إِلاَّ عَلَى مَهْرِ"],["A1416B1A-BE3D-5CA2-B1BE-87966DBC02F4","فَمَا لِي أَرْضَى مِنْكُمْ بِدَنِيَّةٍ","تَحُضُّ الرِّجَالَ الأَبْعَدِيْنَ عَلَى نَصْرِي"],["B0611185-C4C9-53BC-B736-0C54DE323BED","وفي الحيِّ محمودُ بنُ نصرِ بنِ صالحٍ","أخو الغارةِ الشعواء والكرم الدثرِ"],["0BCFA1BB-9176-5B80-B904-54D244CFA99D","أقلها من الحي اللئيم ونادها","مراحكَ هذَا آخرُ العهدِ بالضرِّ"],["E6BF0579-59B6-57AC-A3A1-C6EE0B13CD29","فإن هي حنَّت في بيوت بن صالح","فلا عقلتْ إلاَّ قيوداً منَ العقرِ"],["8B88618F-22E7-5AA7-82D5-216BDBCE7FDC","مِنَ القَوْم صَالَ الدَّهْرُ إِلاَّ عَلَيْهِمُ","وَصَالُوا بِبِيْضِ الهِنْدِ حَتَّى عَلَى الدَّهْرِ"],["E049D3BB-0ED3-5F36-921F-1680B5F4E700","لَهُمْ فِي قِرَاعِ المَحْلِ أَيْدٍ كَأَنَّمَا","يعدونَهَا وقفاً علَى الحججِ الغبرِ"],["F59292AC-EDF3-5F18-8725-C25430480A44","إذا سئلُوا خلتَ الندَى في أكفهمْ","تشربَ ماء في وجوههمُ الغرِّ"],["DF8FD7EE-6091-5B2D-9544-5687928E2E06","وإنْ أخصبُوا بالطعنِ عادُوا منَ الندَى","سراعاً إلى داعي الخصاصةِ والعُسرِ"],["B369152E-01F4-53FE-9859-B88E8A9391FD","تَمِيْسُ بِهِمْ فِي طَاعَةِ الجُودِ هَزَّة","كَمَا طَرِبَ النَّشْوَانُ مِنْ نَشْوَةِ الخَمْرِ"],["FBFA6DF1-738E-52DB-8A53-6A7AED7C6BE0","وَمَا كاَثرَتْ جُنْحِ الظَّلاَمِ سُوَامُهُمْ","فَرَوَّحَهَا الرِّعْيَانُ إِلاَّ عَلَى النَّحْرِ"],["D8D129CC-35C0-566B-97CC-166CDD3F76D4","إذا انتسبُوا خلتَ السماءَ تهافتتْ","عَلَيْهِمْ وَبَانَتْ مِنْ كَوَاكِبِهَا الزُهْرِ"],["75758815-6C31-5E3A-8597-01C836DBF485","هُمُ البيضُ إِلاَّ أَنَّهُمْ وَاصَلُوا القِرَى","وقدُّو الطلَى والبيضُ تفري ولا تقري"],["DB322CA3-A7AE-5FFC-B6CB-59E432D0EAAC","وُجُوهٌ كايماضِ الصَّوَارِم أشْرَقَتْ","منَ الحسبِ الوضاحِ والنائلِ الغمرِ"],["18BCBF6D-47E6-5B73-B0C2-2FF1DE4672E7","وَخَيْلٌ تَبَارَى بالرِّمَاح كَأَنَّمَا","أغارَت علَى ما في الرماحِ منَ الضمرِ"],["95805087-C11E-5EE6-8D7D-5F74DF248FA7","وبيضٌ بهَا ماء الفرندِ كأنهُ","دُمُوعُ الغَوَادِي جُلْنَ فِي حَدَقِ الزَّهْرِ"],["6494188C-56F2-50F5-B74A-E7EE4B5E5FE1","حَبِيْبٌ إِلَيْهِمْ أَنْ تِلمَّ مُلِمَّةٌ","وتطرفهمْ فيما أصابُوا منَ الوفرِ"],["B792CFE7-ACFE-5EA7-906F-B31B71643F4A","هُمْ ظَفَرُوا بِالعِزِّ عَنْ سَيْفِ صَالِحٍ","وغرِّ المعالي عنْ ثمالٍ وعنْ نصرِ"],["11D6CE9A-EB12-5A91-9126-7900600A8496","وَنَالُوا بِعزِّ الدَّوْلَةِ المَجْدَ شَائِداً","لَمَّا أَثَّلُوهُ مِنْ عَلاء وَمِنْ فَخْرِ"],["06B1BAE5-2660-5DAF-A144-D975A52F9258","فتىً ذللَ الأيامَ حتَّى تثقفتْ","عَلَى الهوْنِ وَانْقَادَ الزَّمَانُ عَلَى القِسْرِ"],["26026242-5E11-5C04-9F1F-DAD6F5E90A37","إذَا شردَ المعروفُ أوْ جمعَ العُلى","رَأَيْتَ الفِعَالَ السَّهْلِ فِي المَطْلَبِ الوَعْرِ"],["0B2661D2-7A37-5418-9B6B-F13AA453E436","أشدَّ احتقاراً للردَى منْ حسامهِ","وأدنى إلى شرِّ الأعادي منَ الذعرِ"],["F221498C-1416-5791-9DE9-6E5F8EAFD748","لهُ خلقٌ في المحلِ غيثٌ وفي الصبا","نسيمٌ وفي جنحِ الدجا غرةُ الفجرِ"],["F9C80A9E-16D7-59C1-9F4F-3771812641F3","حدوتُ إليهِ المدحَ حراً وطالمَا","بَخِلْتُ بِهِ حَتَى تَقَاعَسَ فِي فِكْرِي"],["2CF23F4E-E3A3-53E8-8E5D-B50A891137F3","وَأَكْبَرْتُ قَدْرِي أَنْ يَجُودَ بِهِ فَمِي","ونزهتُ نفسي أنْ يجيشَ بهِ صدري"],["2D2E2CAE-5548-5F2A-82C6-FC74283868F9","فَجَادَ عَلَى إِحْجَامِهِ بِشَوَارِد","جَوَائِلَ فِي الآفَاقِ مِصْراً إِلَى مِصْرِ"],["1B827439-F073-5BB1-90BE-9AB42F07CF26","إِذَا غَرَّدَ الحَادِي بِهَا خَفَرْتَ بِهِ","حَنِيْنَاً وَأَضْحَى وَهُوَ حَاسِدُهَا يَطْرِي"]]}}}