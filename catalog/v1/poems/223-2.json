{"v":1,"poems":{"896B2A69-7D01-5B7D-BC00-F963F6D7CA3F":{"t":"يا شهودي حقق بمشهودي","p":223,"s":"يا شهودي حقق بمشهودي","r":"476160","v":[["759816CF-554D-5A5D-9CBF-4B8B86EEB233","يا شهودي حقق بمشهودي","سر محو الوجود"],["560783A1-FAF3-5AB4-B417-DDCB0D92572D","وافن طورا عن كل موجود","عند ذاك الشهود"],["56863C9F-EB3E-5EE4-887E-DA26FA2786BC","لاح لي ينجلى سنا بدري","من خلال الستور"],["442ADAD7-EBC4-55C4-800A-0E2926A4810F","وتبدى معناه في سري","بالخفا والظهور"],["310686E7-4584-5C32-9649-5DF9EAA0527B","أطلع الحظ ليلة القدر","في بروج السرور"],["123A2405-16A5-5547-8854-61DAC1C5533D","وجلا السعد بالهنا عمري","فالليالي سعود"],["0A39BCA0-91AB-5B7D-B487-CAE1A253D8F5","ملأ الكون نور محبوبي","فأزال الظلام"],["A3357382-F9C0-5172-A9CF-D0FA07F22787","وأتى يوسفي ليعقوبي","بحصول المرام"],["A5BF9442-9E2C-5B21-A7D9-17A4DDC9117E","يا بقايا كونيتي ذوبي","وانشإي بالغرام"],["9F85E035-C6FD-58C6-8640-E02094437CD4","حيث أني قد نلت مطلوبي","ونزعت القيود"],["0A2AFDD0-D5E1-50CA-9DF3-7EA5DFEAAD05","برزت لي أنوار من أهوى","بصنوف المدد"],["0E0415E4-33A4-5451-A9C4-42E98C07C4EC","ثم حلت طلاسم الفحوى","بعد طول المدد"],["7880C449-1A14-5AF5-B7C5-0A2AE8DC6C99","وبمنشور غايتي القصوى","ووثيق السند"],["3E24F673-476A-53C5-8754-153004BDF582","طاب وقتي بالبر والتقوى","والوفا بالعهود"],["16D03AB2-A50A-57B6-B7D0-FEEE53834B9D","يا عذولي رأيت بي حالك","فجهلت الصواب"],["5075846D-24D9-5895-A0C8-1F0CC055EDD7","وانعكاسا كرهت أفعالك","يا لهذا الحجاب"],["FA013345-4B2F-59E8-B13B-01283FC1FE6F","أنت لما واليت آمالك","وشربت السراب"],["25CEF58C-7558-5C9B-B8AB-649C9AC4879B","حط ربي بالرد أقوالك","وحباني الصعود"],["A399FCC7-3514-50DA-918D-174350E635E4","أنا بالله مظهري حافل","بالفخار العجيب"],["46929B55-98F9-507F-A173-C13A7A2BAD49","ولتأييد شأنه كافل","عزم طه الحبيب"],["1E7CE5F8-2B72-5D71-8EF6-4C1112D81AD5","والرفاعي شبله الكامل","ألحسيب النسيب"],["D6E2557F-F1AF-5F31-8885-F12C8F96E4EC","مد باعي بباعه الطائل","فقهرت الحسود"],["D95B7126-1F79-5148-AACF-9F86E4A3CD47","وصلاة المهيمن القادر","للرسول العظيم"],["92A72561-7FAF-5111-9519-E2F10FE8B9CE","نور عيني ذخري أبي الطاهر","ذي الجناب الكريم"],["6BE7FB00-B087-57E3-8817-B13918DC4D77","وإلى أهل بيته العامر","بالكمال الصميم"],["E1484F88-57D8-5428-B92E-F21FCB039BB8","ولصحب حازوا العلا الباهر","بإمام الوجود"]]},"0F51F12E-F8A1-5D85-A809-F1C276B3D349":{"t":"يا صاحب القبر المنير بيثرب","p":223,"s":"يا صاحب القبر المنير بيثرب","r":"476101","v":[["EAC6195D-09D0-511E-A268-75C79ED8DBAE","يا صاحب القبر المنير بيثرب","لك قد مددت وليس لي وجه يدي"],["984B036D-9629-5961-B660-E305C7BBED7D","وجه رسول الله بوجهك لي وجد","لأنال آمالي وأقهر حسدي"],["CEACB8DF-A17D-5763-8404-D8FAEFAB6E10","وانظر بعين العفو سود صحائفي","ليضيئي دهرا خط حظي الاسود"],["B5CE98F3-F481-5849-A861-2C1AA0F4B979","غوثاه يا سيف المهمن إنني","بحديد بطشك قد قرعت المعتدي"],["39F57693-23E5-5D15-B955-04F074A27397","ليل النوائب طال فابلج فجره","بإغاثة يا نجدة المستنجد"],["6210A50D-307D-54AD-A2B9-37024C2E074B","بدد بسيفك يا أمين الله ما","جمع العدو وصر له بالمرصد"],["8698A579-84F7-559C-AB11-637B43136688","حتى أقول له انتصرت بخائب","وأنا انتصرت بسر جاه محمد"]]},"CCDB2EB8-B481-5167-ACC3-9A78DCF01ADB":{"t":"يا غصن نعمان","p":223,"s":"يا غصن نعمان","r":"476175","v":[["4BCC50B3-D090-5187-8ED1-87FAF2BD6224","يا غصن نعمان","عطفك ما آن"],["62C3BCD4-4157-5805-951F-83ED0CEE1CB3","عبدك حقا","للقرب ظمآن"],["3EEE8041-1BB1-5CD4-B336-DDBB316C43E6","بلطف معناك","أرفق بمضناك"],["A2DE52C5-37BC-5224-99C1-2FF3820FEDE0","قد ضاء مجلاك","للإنس والجان"],["160C9E11-1B9A-5EA3-9DC9-37154600CF2C","كم فيك مغرم","مثلي مهيم"],["405F7287-57C7-5CF5-8044-2D4F8C49659C","أنعم تكرم","فالقلب ولهان"],["BDFE8E48-B77D-5374-AB90-6F514BA4F3EA","ناجتك أرواح","باسمك ترتاح"],["CE89087E-D8D5-587A-B75E-31497F03CA19","والعشق فضاح","والوجد نيران"],["5973FAFA-FF07-516D-942F-16932C019337","للشوق إضرام","والقلب قد هام"],["6A1B5F2F-32B2-5249-874C-313D38F28AD0","عليك من لام","لا كان من كان"],["7F908190-D12D-5CE7-89B2-E47E81959FD1","أدمت صدك","أطلت وعدك"],["ECD16C79-30B8-54A9-93CB-5AFA402D4BEE","عبدك عهدك","في الحب ما خان"],["E7ABCE87-704F-548C-BB41-1AA23B65F271","عليك صلى","مولاك فضلا"],["42FC0624-7E1D-5322-8F32-841DA4AF760B","ما رحت تجلى","والبدر حيران"]]},"EF1591F6-DBA4-5AA4-B1AB-8BEA765C061E":{"t":"يا كتابا الغيوب","p":223,"s":"يا كتابا الغيوب","r":"476182","v":[["227A4918-C966-5D81-9E30-D95E51653522","يا كتابا الغيوب","قد لجأنا إليك"],["6B35ACB6-38D1-5E23-A039-7F95951A1867","يا شفاء القلوب","الصلاة عليك"],["3A2DEAD7-C61D-5EE9-9E46-8E29FC0B060C","أنت مجلى الجلال","في نظام الجمال"],["9BC512F5-7B2A-5FE7-A002-3933A11DD9BF","كل هذا النوال","فاض من راحتيك"],["AF63E1AA-5409-5AD2-AE39-034DEEAB3AFF","أنت روح الوجود","كنز فضل وجود"],["3C65B730-CA5F-58BE-8BD3-56436EE3C6D3","في مقام الشهود","كل فضل لديك"],["FC89FBC3-9DA6-5E28-A4C3-3BF430E8EC15","أنت سر الكتاب","عنك فصل الخطاب"],["1FC43D70-FC0E-5A06-916A-672E3FECD4F9","وبيوم الحساب","فالرجوع إليك"],["25FA2D76-D9C1-50B2-BF33-ABBF0B98AE3C","أنت بالإفتتاح","ختم حزب النجاح"],["496612D6-8787-5C00-88F4-4EA98C0C1056","ومنار الصلاح","لاح من مظهريك"],["EA5DD069-D520-5D80-BB2F-41AFF5F2E84F","أنت في العالمين","روح جسم اليقين"],["264A61C5-CBEA-5BA2-A88D-EFD9CF5162F5","موكب المرسلين","قام بين يديك"],["A667C044-D13F-5C8D-9B00-FF34DA80E792","أنت هادي الأمم","أنت بحر الكرم"],["F30B9A1B-8748-5123-86AE-EDC885632C26","أنت صبح النعم","فج من بردتيك"],["1C3B5135-18D2-5EDB-BA61-0672F604C276","أنت طه الرسول","تاج أهل القبول"],["E428899E-2848-5BD7-9125-F1716F8FFF4C","كل همي يزول","باعتمادي عليك"],["72D3CAC0-5C5F-5A44-AE83-D77C4A4E7DDD","روح هذا الحقير","عبدك المستجير"],["1A571BCC-F3E5-54B1-AFD3-49F9D08CF1F5","بالغرام الوفير","قبلت قدميك"],["C65FC14D-7965-5A1C-A276-0503383AF567","وعليك السلام","يا رسول الأنام"],["579E9794-76BF-5403-AF81-AF0ABFBFF8C4","ما شدا مستهام","بالصلاة عليك"]]},"7DE0FF8D-BF10-53E2-A1FC-2D77840A2FBF":{"t":"يا مرسلا لاذ الورى بجنابه","p":223,"s":"يا مرسلا لاذ الورى بجنابه","r":"476084","v":[["42F8925D-BE8C-5FDA-BDD1-3C5C9C789C94","يا مرسلا لاذ الورى بجنابه","وتمثل الأكوان في أعتابه"],["FCDA055A-38A0-5B47-A406-1D7539EFD522","وببابه وقفت صدور أولي النهى","ومشت ملائكة العلى بركابه"],["4051474A-57B2-53CF-80EF-1ECACC356951","ولجوده مدت أيادي الانبياء","تأدبا ومشوا على آدابه"],["CC531E25-609A-5809-89C9-E89F63AB8EA8","عطفا بحقك يا شفيع المذنبين","فإن دمعي هاج يحز سحابه"],["F36F857D-8D8B-53DD-A75B-B01D52AB68E5","وامنن علي بنظرة وارحم فؤادا","مسه جيش النوى بحرابه"],["F2FB4BAF-BD35-5591-A3F4-CB2DB31008F7","صلى عليك الله يا من لألأت","أنوار سر الله في محرابه"],["B31A03A1-5B5E-5510-883E-56772512481F","والآل آلك والصحابة كلهم","ما غاب فيك القلب عن آرابه"]]},"9B1D5680-E241-51AD-AF9B-79314AD3F289":{"t":"يا مصطفى آمالنا بك","p":223,"s":"يا مصطفى آمالنا بك","r":"476075","v":[["3243CC43-066D-5852-942A-E69869E05F77","يا مصطفى آمالنا بك","فاطو البشائر في جوابك"],["DB83B045-7A31-5A8F-8140-15038A168627","هذي عريضة مذنب","رفع الشؤن إلى جنابك"],["E2C5FC98-CF76-57FF-BACD-CC0E9E634EDF","وافى إليك وحمله","قد حطه أبدا ببابك"],["BAF0F6EA-E260-51CC-8F7A-DFE14951D689","فأغث إذا يا مصطفى","عبدا وقيعا في رحابك"],["F9817361-C03B-5E84-8D86-AC425DA1908C","فلأنت أكرم من يفيض","الغوث حيث الخطب حابك"],["F3C1F5B6-FA4F-5C49-B5BF-555DFE5648FE","لما ارتقيت إلى العلى","مشت الملائك في ركابك"],["3CAECD64-4B8F-52B0-80CA-D4EC4084A0B2","صل سيدي حبلي فلي","حبل اعتصام بانتسابك"],["6B9F74FD-BFCF-565B-A9B6-A9D433E5911B","وعليك صلى الله والآل","الأولى وعلى صاحبك"],["BB321CF4-7265-540B-8675-93BBF29A2474","والتابعين ومن تمسك","بالشريعة لاقترابك"],["14B9A936-C5D7-5390-AD94-D3FD96787903","ما فاز ظام قد دعاك","بكل بر من سحابك"]]},"BDB446A1-FC9C-557C-ABE2-AA7649D4A5D4":{"t":"يا من له الفخر انتهى","p":223,"s":"يا من له الفخر انتهى","r":"476150","v":[["983E9C66-5431-58FA-8ECD-FBBAC185F29E","يا من له الفخر انتهى","وببابه سجد السهى"],["AF9B287D-4FD9-515D-80CA-4C910DB1750A","ولمجده انتسب العلى","وبنوره الكون ازدهى"],["CF95ADD7-B454-52D1-98B6-A322F47BEC1C","وله الغطارف أخرست","ولقد تكلمت المها"],["D0BAADCE-A25D-584E-82BA-2FF51161F33E","وهو الرسول المجتبى","والغوث إن كرب دهى"],["9B2D24C6-81A9-5A8F-B90E-E1BC7C964612","قلب عن الرحمن في","كل المواطن ما لها"],["92291FCD-87FA-5E01-8283-41FCB37BAEC4","ولسان معرفة له","نشر المهيمن ما اشتهى"],["619D11DC-25FA-5E63-A3FF-3FCD145C9B78","وبه الإله تكرما","أهدى البرية سبلها"],["D52749E5-6D26-596C-971C-7ECB84F2023E","هي فرعه في نشئها","إذ كان غيبا أصلها"],["6A58B2D0-3D30-54B4-86BB-6D0119C5A028","كم عقدة تحت العمى","بلطيف لفت حلها"],["507D0455-A549-5B85-BED1-96977530C6F7","وعصابة غدارة","بالطرف منه أذلها"],["C7A54B07-F8D0-5AB9-99A0-ACA9C85ACBA5","وبسهم دولة قلبه","دار البوار أحلها"],["D8DD6780-1376-5A4C-8B6F-9E9456ADDD45","إن أزمة عظمت وأو","تركف كرب نبلها"],["F5A3D861-9EA3-5711-9847-BFC5DF5B9925","أو مدلهم مذ دهي","صبر الضعيف له وهي"],["43895024-43F1-5543-8508-980C6056BF9B","فالجأ أخي بباب طه","إنه كفؤ لها"]]},"99EB7440-2328-5D9F-8631-931EC9E61044":{"t":"يا من له راحة كالبحر وابلها","p":223,"s":"يا من له راحة كالبحر وابلها","r":"476090","v":[["5003CA70-74DB-51A5-976C-63650A51BE4F","يا من له راحة كالبحر وابلها","ولن يرد فتى وافى يؤملها"],["51B20BA8-5EF3-5916-A4DA-D92387B32269","ها مهجتي في الخفا ناداك قائلها","في حالة البعد روحي كنت أرسلها"],["C9E6DFBF-A170-5CDE-867C-2324CFB8F29F","إلى رحابك يا سر الوجود سرت","وفي المحبة سرا في الفنا أسرت"],["7F3C8CB9-D168-53DB-AF36-E0085DED9ACE","بالحب مذ طمست بين الورى ظهرت","وهذه نوبة الأشباح قد حضرت"]]},"32656ED8-D518-5021-A675-DDCF11C3DF5D":{"t":"يا نبيا علا على الأنبياء","p":223,"s":"يا نبيا علا على الأنبياء","r":"476066","v":[["6FCF621E-D296-5BA7-A220-3F27564F40D9","يا نبيا علا على الأنبياء","بمقام التعظيم والاصطفاء"],["4ACF39E0-814B-51DA-9C1F-00C213282977","وسما وارتقى السما وتسامى","قدره في المراتب العلياء"],["605344A9-C6C2-5928-859B-0DEEB803AD4C","فهو في هيئة الجلالة فرد","في المعالي من مبدأ الأشياء"],["F432412D-0053-588C-AB39-B9F2B3592150","وهو في مظهر العناية نور","غالب ضوءه على الأضواء"],["8098226A-960F-5E74-9DFD-66653DDBF822","درة السر كنز كل المعاني","أصلها من حقيقة الأسماء"],["7C372D7B-7214-513C-A402-73C3A93A8EA8","جوهر الفخر نور عين البرايا","منتهى سرها من الإبتداء"],["126062A4-5034-5E22-B308-68C6539BD16C","معدن المجد روح جسم المعالي","مظهر الحق في سلوك الفناء"],["3DC7A73F-F767-5A91-8B41-38DBDAF50830","أصل سر الأشياء في كل سر","بجلي المعنى وبالإخفاء"],["5D022D6A-B24E-5BE6-A735-2B746114A3A9","عين وجه المقصود من كل لب","سلم الذاهبين للإهتداء"],["193D353C-5ECA-581E-91F1-FC8F226C520F","مظهر المجد هيكل السعد مولى الخلق","من قبل خلق طين وماء"],["6DBA61BA-B56B-5384-A404-335A4C25E1D4","صولة الله في الوجود ومجلى","نور عين الكمال في كل رائي"],["90C20CD0-2112-513D-8AEF-9C5D198A54F2","هيبة الحق قر في كل قلب","شأنه فانجلى بسر علائي"],["C467152C-E3E0-5176-B728-211BE2ACEA54","سطوة الغيب دولة الرب حقا","حكمة الأمر سيد الأصفياء"],["FC1CC2C8-9433-553F-8602-305FA5F753E5","علم شرف الإله به الأرض","كما دار ذكره في السماء"],["8D33C582-E49E-5598-8877-B49F8C18A611","طيب طابت البرية فيه","طاب ذاتا وطاب فيه ثنائي"],["1A383768-5F88-594B-80AF-13074F88DF0B","أول الأنبياء خلقا وأبهى الكل","خلقا وخيرهم لاقتداء"],["DA993C88-5279-5BBF-9545-21541A1DA6F3","جامع السر معدن البر والخير","وكنز النوال للفقراء"],["7E9F01BB-DBD2-5687-86A3-6CCAA2F3B98C","سيد المرسلين غوث المنادي","كعبة الإعتصام للغرباء"],["44B018D0-2819-532A-B9F1-EF9C8BDE5394","سيف قدس سطا بكل عدو","وولي يحمي من الأعداء"],["4710F11C-3C8D-5D26-9272-F54C55F7E419","باب لطف لكل من قرع الباب","بذل يجود بالإعطاء"],["2F24A8DA-EBB2-52E1-89ED-9945F4542B46","ترجمان الرحمن في كل شأن","وتجلى قبوله للدعاء"],["BF02420C-E1CE-5DA1-A88B-7F5339C01588","كاف كن قبل كون كل مكين","نون كان الأمان للشفعاء"],["373FEF40-7C15-5702-BEE3-8D3EDA2F7CCE","صاد صبح القبول من غير شك","ميم معنى الوجود للأشياء"],["36020A77-F759-5CC1-8582-65B198D0CB5E","يا إمام الهدى ويا خير هاد","وعمادي يوم اللقا وحمائي"],["A4DDBF6F-44C1-5578-BBB2-C31817BC468E","يا حبيب الديان يا نور عرش الله","حقا يا خاتم الأنبياء"],["C840A794-CAEA-5724-83CF-6618742458DD","يا ملاذ اللاجين يا ملجأ الراجين","جهرا يا موئل الضعفاء"],["52958A3A-5C31-55FB-B2CA-052C06629461","كن نصيري وكافلي ومعيني","وعياذي في شدتي ورخائي"],["BAAF3AF5-CB70-5A73-8900-C685A047E532","واكفني ما أراه من هم دهري","واحمني العمر من خفي القضاء"],["52AE80BF-F35B-5DE9-8837-4F0B195C669D","وأثبني إخلاص قلب وصدق","واشف يا عمدتي 