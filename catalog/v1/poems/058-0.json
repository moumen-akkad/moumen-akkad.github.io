{"v":1,"poems":{"F9D43B42-89CC-5F43-A8C8-67FF2F866E37":{"t":"أبقَى الحوادثُ من خَليـ","p":58,"s":"أبقى الحوادث من خليـ","r":"441269","v":[["C81F2053-B57E-5794-93F6-61F5CB5FB007","أبقَى الحوادثُ من خَليـ","ـلِكَ مثلَ جَندلَةِ المراجِمْ"],["2AD2DFF1-F3E8-5370-BA60-A11B2984AAB0","صُلْباً إذا خَارَ الرّجا","لُ أبَلّ ممتنِعَ الشّكائِمْ"],["4191AAAF-C237-559F-9933-90281566A152","قد رَامَني الأعداءُ قَبْـ","لكَ فامتنعتُ عَنِ المظالمْ"]]},"4AE06102-27DE-5801-BF7C-A9FF94C804AC":{"t":"أتاِنيَ أمْرٌ فيه للنّاسِ غُمةٌ","p":58,"s":"أتاني أمر فيه للناس غمة","r":"441263","v":[["BE52D997-B1A4-5C69-92AB-12EB26A34A81","أتاِنيَ أمْرٌ فيه للنّاسِ غُمةٌ","وفيه بُكاءٌ للعُيُونِ طَويلُ"],["ED110CBA-AB1C-5789-A40D-3B8E6DB356D6","وفيه فَنَاءٌ شامِلٌ وخَزَايةٌ","وفيه اجتداعٌ للأُنوفِ أصيلُ"],["A0C13699-85F9-53CC-8D24-05F84DB917E5","مُصَابُ أَميرِ المؤمنينَ وَهَدَّةٌ","تكادُ لهاَ صُمُّ الجبالِ تزولُ"],["BD3BDC9B-E9CA-5B54-ADC8-4892F2721194","فلِلهِ عينَا منْ رأى مِثلَ هَالكٍ","أصِيبَ بلا ذنبٍ، وذاكَ جليلُ"],["5C7E9268-DE22-5416-B243-02579C845CAD","تَداعتْ عليهِ بالمدينةِ عصبَةٌ","فَريقانِ منها: قاتِلٌ وخذولُ"],["EC9CFAB6-14F9-5D1C-AE6C-E3EE5130DB5A","دعاهمْ، فَصَمُّوا عنه عندَ جوابِهِ","وذاكُمْ عَلى ما في النفوسِ دَليلُ"],["358809A5-ED2B-59FF-82AF-6C247035401B","نَدِمْتُ عَلَى ما كانَ من تَبَعِي الهَوَى","وقَصْرِيَ فيه: حَسْرَةٌ وعويلُ"],["D504BB5A-45D4-543C-8E33-5F9A9008DF6B","سأنْعَى أبا عمْروٍ بِكلّ مثقّفٍ","وبيضٍ لها في الدّراعينَ صَليلُ"],["70252C72-57DD-5CAA-A580-65F79774B53C","تَرَكْتُكَ للقومِ الذينَ هُمُ هُمُ","شجاكَ، فماذا بعدَ ذاكَ أقولُ!"],["334A5A24-A909-59DD-96D5-3C90EB2BA9B8","فَلَسْتُ مُقيماً ما حَيِيِتُ ببلدةٍ","أجُرُّ بها ذَيْلِي، وأنت قتيلُ"],["EF12AA97-BDF5-59A4-9931-D903D4ACF5F6","فلا نومَ حتّى تُشْجَرَ الخيلُ بالقنا","ويُشفَى من القومِ الغواةِ غَليلُ"],["E77CF794-B1AD-57B2-8055-17600D3C8EB5","ونَطحنهُمْ طَحْنَ الرّحَى بِثفالها","وذاكَ بما أَسْدَوا إليكَ قليلُ"],["36862B41-070A-5D32-9C0A-2E89FD8B8932","فَأمّا التي فيها مودّةُ بينِنَا","فليس إليها ما حَييتَ سبيلُ"],["D1253BFE-E2A8-522F-88EB-4517732BFED5","سَأُلْقِحُها حَرْباً عَواناً مُلِحّةً","وإنّي بها منْ عامنا لكفيلُ"]]},"27EC6157-CC09-5572-B0E8-55C088CD7F16":{"t":"أرَى العفْوَ عَنْ عُليَا قُريشٍ وسِيلَةً","p":58,"s":"أرى العفو عن عليا قريش وسيلة","r":"441248","v":[["E0A1E229-34F9-51D1-8567-102482DA1141","أرَى العفْوَ عَنْ عُليَا قُريشٍ وسِيلَةً","إلى اللهِ في اليومِ العَبُوسِ القُمَاطِرِ"],["8D64BDFE-6B9E-52C5-B0B1-AA121ED869CF","ولسْتُ أرَى قتلِي فَتىً ذا قرابَةٍ","لَهُ نَسَبٌ في حَيِّ كَعْبٍ وعَامرِ"],["E10BD8D3-D44D-5C6D-A95F-7506C89E838A","بَلِ العَفْوَ عنْهُ بعدَمَا خابَ قدحُهُ","وزَلّتْ به إحْدَى الجُدودِ العَواثِرِ"],["F8CC034F-E1B6-5CD0-9390-DE2E43D23EEA","وكانَ أبوهُ يوْمَ صِفّينَ مُحنَقاً","عَلَيْنا فَأَرْدتْهُ رِمَاحُ يُحابِرِ"]]},"37B0BFF6-A5E7-52ED-961E-1080FFF05CAF":{"t":"أصَخرُ بنُ حربٍ لا نَعدكَ سيّداً","p":58,"s":"أصخر بن حرب لا نعدك سيدا","r":"441284","v":[["29F48DE7-45FF-5C4C-A156-ED031AD65C59","أصَخرُ بنُ حربٍ لا نَعدكَ سيّداً","فَسُدْ غَيْرَنَا إنْ كنت لَسْتَ بسَيّدِ"]]},"F8E6B64C-2847-542B-BE33-5A16603FD96E":{"t":"أغَرَّ رجَالاً من قريشٍ تتابعوا","p":58,"s":"أغر رجالا من قريش تتابعوا","r":"441272","v":[["26C56F16-7BFD-5223-BE5E-4F3958358F5A","أغَرَّ رجَالاً من قريشٍ، تتابعوا","عَلى سَفَهٍ، منّي الحَيَا والتكَرّمُ"]]},"4B3CEBF6-6DC8-51CC-8752-706C85B363AC":{"t":"أكانَ الجبانُ يَرَى أنّه","p":58,"s":"أكان الجبان يرى أنه","r":"441261","v":[["BB9E1C87-AFB3-5937-9844-48A87B8CEBA0","أكانَ الجبانُ يَرَى أنّه","يُدافِعُ عَنْهُ الفِرارُ الأجَلْ"],["AC03DBFB-090E-53B1-9938-F6AA31DB0E35","فقد تُدرِكُ الحادثاتُ الجبانَ","ويسلمُ منها الشجاعُ البْطل"]]},"E5CACD41-3FAC-5B8E-828D-A5E33CD89951":{"t":"ألاَ يا سعدُ قد أظهرتَ شكّاً","p":58,"s":"ألا يا سعد قد أظهرت شكا","r":"441228","v":[["9DAF892A-6620-5DED-A005-192A6419DB81","ألاَ يا سعدُ، قد أظهرتَ شكّاً","وشَكُّ المرء في الأحداثِ داءُ"],["CBD44ADB-F042-5C40-B4D2-E9E786BAE47C","عَلَى أَيِّ الأمورِ وقفتَ حَقّاً","يُرَى أو باطلاً، فَلَهُ دواءُ"],["60875BDD-2070-5BEA-A0EE-24A1843B31C6","وقَدْ قالَ الّنِبيّ، وحَدّ حدّاً","يُحِلّ به من الناسِ الدّماءُ:"],["2FFB7236-04BD-5C17-B184-EC7869391350","ثَلاثٌ: قاتِلٌ نفساً وزانٍ","ومرتَدّ مَضَى فيه القضَاءُ"],["81550940-CE97-5266-B60C-5C2A2B3C8AA9","فإنْ يكنِ الإمامُ يَلُمّ مِنْها","بِواحِدَةٍ فَلَيسَ لَهُ وَلاءُ"],["FA592299-38E1-545E-981A-95DFD2EEFDCE","وإلاّ فالذي جِئتُمْ حَرَامٌ","وقاتِلُهُ، وخاذِله سواءُ"],["ACF538BE-2468-5EC7-AB6D-7728F887FE5F","وهذا حكمُهُ، لا شَكّ فيه","كما أنّ السّماءَ هِي السّماءُ"],["136588C3-B024-56E5-BD86-742B232D1212","وخيرُ القولِ ما أوجزتَ فيه","وفي إكثاركَ الدّاءُ العَيَاءُ"],["7D8C28EF-ED29-573F-B617-5DFAC932ED71","أبا عَمْروٍ، دَعوتُكُ في رِجالٍ","فجازَ عَراقِيَ الدّلْوِ الرّشاءُ"],["E4D482E6-D91C-5715-B1CA-78A1E1DE9FB5","فأمّا إذْ أبيتَ فليسَ بَيْني","وبينَكَ حُرْمَةٌ، ذَهَبَ الرّجاءُ"],["178F0C99-07E5-59C0-8299-473B9B308597","سِوى قولي إذا اجتمعت قريشٌ:","عَلَى سَعْدٍ مِنَ اللهِ العَفَاءُ"]]},"A7E94BA7-5BDE-5673-B04D-0207CA113970":{"t":"ألاَ يا عمرو عمرو قبيلِ سهمٍ","p":58,"s":"ألا يا عمرو عمرو قبيل سهم","r":"441268","v":[["D3A6DFA5-99BC-5A5F-8216-85E80A9B30B7","ألاَ يا عمرو، عمرو قبيلِ سهمٍ","لقد أخطأتَ رأيكَ في عَقيلِ"],["5C6DA7CB-20D0-501D-A9BB-EDAECD456F94","بُليتَ بِحَيّةٍ صَمّاءَ، باتَتْ","تَلَفّتُ- أينَ مُلْتَمَسُ القبيل"],["108C68BD-4D39-5E7B-85D4-2E998436D3B7","بِعَيْنٍ تَنْفُذُ البيداءَ لحظاً","ونابٍ غيرِ موصولٍ، كليلِ"],["66131700-B683-51FA-9CCC-AE0ACBABFA32","وقد كانتْ ترجُمهُ قريشٌ","على عَمياءَ مِنْ قالٍ، وقيلِ"],["D1DFAE01-0B7A-5FAD-A5A0-6B0D15F31D68","ألاَ للهِ درُّ أبي يَزيدٍ","لهرْجِ الأمرِ والخطْبِ الجليلِ"],["1C32CDF3-F6CA-589D-AA11-7FF8B4999870","فما خاصَمْتُ مِثْلَكَ من خصِيمٍ","ولا حاولتُ مثلكَ منْ حويلِ"],["9C4D0DF5-C66C-5E51-A2F9-3F74355F030B","أتاني زائراً، ورأى عليّا","قليلَ المالَ منقطِعَ الخَليلِ"],["D24FA1D7-E86A-52AE-B1D2-6DEF2498D713","فقيلَ له: معاويةُ بنُ حربٍ","فَمَالَ أبو يَزيدَ إلى مُمِيلِ"],["2B9827B5-6235-561B-83C2-21BD1BA98DE0","فَأَجْزَلتُ العطاء له، ودَبّتْ","عقاربُهُ لِسالفَةِ الدّخولِ"],["90C5D64E-C73B-50DD-BEB1-AB4EC69527D7","فلم يرضَ الكثيرَ، وقد أراهُ","سَخُوطاً للكثيرِ وَلِلْقَلِيلِ"]]},"E9B7C7AC-BE49-592E-A93C-11CB3BF107C3":{"t":"أمَا والذي نادى مِنَ الطّورِ عبدَهُ","p":58,"s":"أما والذي نادى من الطور عبده","r":"441271","v":[["7791B915-9DA5-5AD9-86E6-765B8535BD23","أمَا والذي نادى مِنَ الطّورِ عبدَهُ","نِداءً سمَيعاً فاستجابَ وسَلمَا"],["5712E4F3-8569-53A2-BB6E-5861CA38B290","لقد كِدتُ، لولا الله لا شىءَ غيرُهُ","تبارَكَ ربّي ذو العلى، أنْ أصمِّمَا"],["E83FA698-8077-58D9-939A-F905602EA60B","ولكِنّني رَوّيتُ في الحِلْمِ والنُّهَى","وقَدْ قال فيه ذو المقال، فَأَحكما"]]},"F9CA9275-8B07-534D-BD50-81F9547E0C27":{"t":"أوَاضِعُ رجْلٍ فوْقَ أخرَى يعُدّنا","p":58,"s":"أواضع رجل فوق أخرى يعدنا","r":"441240","v":[["59541A93-2527-5CEB-BC48-7F309EFA37A1","أوَاضِعُ رجْلٍ فوْقَ أخرَى يعُدّنا","عدَيدَ الحَصَى، ما إنْ تزالُ تكاثِرُ"],["C69688C2-7AED-56F7-8BCA-A97B34173652","وأُمّكُمُ تُزْجِي تُؤَاماً لِبَعْلِها","وأمُّ أخيكُمْ نزرَةُ الولْدِ عاقِرُ"]]},"16F4A7FE-91F7-5594-A0E6-1DFAB0837EBA":{"t":"أَالانَ لمّا أَلْقَتِ الحربُ بَرْكَها","p":58,"s":"أالان لما ألقت الحرب بركها","r":"441265","v":[["C2DC12FB-C4DA-512F-AB13-BDE690E942C2","أَالانَ لمّا أَلْقَتِ الحربُ بَرْكَها","وقام بنا الأمرُ الجليلُ على رِجْلِ"],["BBAEE50F-08B1-5846-B45C-3B5E9CEE50CF","غَمزتَ قنَاتي بعدَ ستينَ حجّةً","تِباعاً كأنّي لا أمِرّ، ولا أحْلِي"],["93993B40-766D-58EA-BDDC-2CDC9F051E44","أتيتَ بأمْرٍ، فيه للشامِ فتنةٌ","وفي دونِ ما أظهرتَه زَلّةُ النَّعْلِ"],["0EE41C81-24F7-5617-A72E-024B4B7DA0FA","فقلتُ لكَ القولَ الذي ليس ضائراً","ولو ضَرّ لم يضررْكَ حملُكَ لي ثقْلِي"],["F43CF1D7-5B34-50E7-AA40-F61D58D9AA20","فعاتبتني في كلّ يومٍ وليلةٍ","كأنّ الذي أبليكَ ليس كما أبْلِي"],["0CDD0FCE-121C-51D1-9D9A-9E3D3C6A4F6E","فيا قبَحَ اللهُ العتَابَ وأهلَهُ","ألم تَرَ ما أصبحتُ فيه من الشُّغْلِ!"],["50A4483F-3E71-59BF-A2EE-38E41E512FD3","فدع ذا ولكن هل لك اليوم حيلةٌ","تردُّ بها قوماً مراجلهم تفلي"],["6F7BD04F-92AF-57F8-9687-42119BF6FAC0","دَعَاهُمْ عَلِيٌّ، فاستجابوا لدعوةٍ","أحبَّ إليهمْ من ثَرا المالِ والأَهْلِ"],["D6C79B15-BCB8-570B-BA39-B4861E4F6A48","إذا قلتُ هابوا حَوْمَةَ الموتِ، أَرَقَلُوا","إلى الموتِ إرقالَ الهَلُوكِ إلى الفَحْلِ"]]},"2D937C85-1015-5D8B-9F88-4A20A89A61F4":{"t":"أَبْلِغْ لَدَيْكَ أَبَا أَيّوبَ مَأْلُكةً","p":58,"s":"أبلغ لديك أبا أيوب مألكة","r":"441237","v":[["5F41DAE5-37EA-595F-B170-F478E3DC9E8B","أَبْلِغْ لَدَيْكَ أَبَا أَيّوبَ مَأْلُكةً","أنّا وقومَك مِثْلُ الذّئبِ والنَّقَدِ"],["41D93BDC-1A01-5D78-A6B0-F5B917B190ED","إمّا قَتَلْتُمْ أميرَ المؤمنينَ فَلاَ","تَرْجُوا الهَوَادَةَ عندِي آخِرَ الأَبَدِ"],["BE89B934-481F-5731-AC25-29936FF7D7BD","إنّ الذي نِلْتُمُوهُ ظَالِمينَ لَهُ","أَبْقَتْ حَرارتُهُ صَدْعاً عَلَى كَبِدي"],["C61DA0FC-6247-55DB-881D-D9C43EEDA25B","إنّي حَلفْتُ يميناً غيرَ كاذبةٍ","لقَدْ قتلتُمْ إمَاماً غيرَ ذي أوَدِ"],["514BCD6B-D8E5-5EA0-9B5D-6B617AD706AD","لا تحسَبُوا أنّنِي أنْسى مصيبتَهُ","وفي البلاد من الأنصارِ مِن أَحَدِ"],["30844766-A107-5011-B559-704ABAF7F8C0","أَعْزِز- عَلَيّ- بِأَمْرٍ لَسْتَ نائِلهُ","وَاجْهَدْ علينا، فلسنا بيضة البَلَدِ"],["2486EA7B-90F5-5923-A8D0-FA04F24BBECA","قَدْ أبدلَ اللهُ منكم خَيْرَ ذي كَلَعٍ","واليَحْصُبِيِّينَ، أَهْلَ الحَقّ في الجَنَدِ"],["BA0A402B-7D7F-50E6-A348-B688D512451C","إنّ العراقَ لنا فَقْعٌ بِقَرْقَرَةٍ","أو شَحْمَةٌ بَزّها شاوٍ، ولم يَكَدِ"],["ACE93700-7548-500D-8B3F-36DD6396653D","والشامُ ينْزِلها الأبرارُ، بلدَتهُا","أمْنٌ، وحومَتُها عريسَةُ الأسَدِ"]]},"A4C62330-9799-5AD0-8B42-F6593B053282":{"t":"أَدِمْ إدامَةَ حِصْنٍ أو خُذَنْ بيدي","p":58,"s":"أدم إدامة حصن أو خذن بيدي","r":"441270","v":[["D943D859-2FFE-557C-B7A6-96388E5A6534","أَدِمْ إدامَةَ حِصْنٍ أو خُذَنْ بيدي","حَرْباً ضَروساً تَشُبُّ الجَزْلَ والضّرَمَا"],["216B4F1B-2A4C-5F5E-9AFC-ABBB606EDFDC","في جارِكُمْ وابنكُمْ إذْ كانَ مَقْتَلُهُ","شَنْعاءَ، شَيّبتِ الأصداغَ واللَّمَمَا"],["97BFF450-AB80-5CC1-AEDD-6E08CAAE87E2","أعيَا المسُودُ بها، والسّيّدون، فلم","يوجَدْ لها غيرنُا مَوْلىً، ولا حكَمَا"]]},"DC6BC163-53B3-5B34-B4E8-163AAEEA3400":{"t":"أَلاَ قُلْ لأسمَاءِ المُنَى أُمّ مالكٍ :","p":58,"s":"ألا قل لأسماء المنى أم مالك :","r":"441259","v":[["BA13D3DA-2C23-5F75-9D0F-7267C8667B93","أَلاَ قُلْ لأسمَاءِ المُنَى، أُمّ مالكٍ:","فإنّي - لعَمْرُ اللهِ- أَهلكْتُ مالِكا"]]},"B8123A6E-1027-5D1C-AF68-5C841B983E9D":{"t":"أَلاَ قُلْ لعبد اللهِ واخصُصْ مُحمّداً","p":58,"s":"ألا قل لعبد الله واخصص محمدا","r":"441260","v":[["8F70155C-C6B3-5F80-ACB1-2443011199F8","أَلاَ قُلْ لعبد اللهِ، واخصُصْ مُحمّداً","وفارسَنَا المأمونَ، سعدَ بنَ مالكَ"],["2A75BDE0-AB5F-51AA-B1D3-5C66FD738F07","ثلاثةُ رَهْطٍ من صِحابِ مُحَمّدٍ","نجومٌ ومأوىً للرجالِ الصّعَالكِ"],["54D2896A-205D-5FBA-89ED-FFE3178B425B","إلا كخبرونا والحوادث جمّةٌ","وما الناس إلا بين ناج وهالك"],["7E353386-C195-5AFA-8E70-6CC6B7670EDD","أَحِلٌّ لَكُمْ قَتْلُ الإمامِ بِذَنْبِهِ","فَلستُمْ لأَهْلِ الجَوْرِ أَوّلَ تاركِ"],["DB73F797-7252-57C3-A002-0112632C1465","وإلاّ يَكنْ ذَنباً أحاطَ بقتلهِ","ففي تركه، واللهِ، إحدَى المهالكِ"],["0C4E9E9C-002B-5C8D-85C9-0462522FF2F5","وإمّا وَقَفْتُمْ بَيْنَ حَقّ وباطلٍ","تَوَقُّفَ نِسْوانٍ إماءِ عَواركِ"],["0C8E82E5-BB0F-5B44-A229-91E2C8C93400","وَمَا القولُ إلاّ نَصْرَهُ أو قِتالَهُ","أمانَةُ قَوْمٍ بُدّلَتْ غَيْرَ ذلكِ"],["5C482E4D-360B-5D98-850B-792331169198","فإنْ تنصرونا، تنصروا أهلَ حُرْمةٍ","وفي خَذْلنا، ياقومِ، جَبُّ الحواركِ"]]},"29CC3A7C-E323-5585-8EF3-C8C3A342AC1F":{"t":"أَلاَ للهِ من هفواتِ عمروٍ","p":58,"s":"ألا لله من هفوات عمرو","r":"441251","v":[["C00732CD-6FE9-506B-91EE-B9711DC3FC6C","أَلاَ للهِ من هفواتِ عمروٍ","يُعاتِبُني عَلَى تركي بِرازِي"],["A9864B3D-A1B6-5CFF-B180-705B91550765","فَقَدْ لاَقَى أبا حَسَن، عَلِيّا","فآبَ الوائليّ مَآبَ خازي"],["4F770BBB-9410-5508-91B5-D71CB696995E","فَلَو لم يُبْدِ عورتَه للاقَى","به ليثاً يُذَلِّلُ كلَّ نازي"],["5308F49B-BF17-5EDE-95EB-10E964CFF845","له كفّ، كأنّ براحتَيْها","منايا القومِ يخطِفُ خطْفَ بازي"],["9A2EE6C8-26E1-57D3-A5C8-86F2F7594105","فإنْ تكنِ المنايا أخطأَته","فقد غَنّى بها أَهْلُ الحجاز!"]]},"07B13268-33D3-5AFD-91BC-28E736286D60":{"t":"إذا أنا أعطيتُ القليلَ شكوتُمُ","p":58,"s":"إذا أنا أعطيت القليل شكوتم","r":"441242","v":[["5A702C8D-F69D-523A-B0B5-0351D5C5CA8D","إذا أنا أعطيتُ القليلَ شكوتُمُ","وإنْ أنا أعطيتُ الكثيرَ فَلا شكْرُ"],["E0E36FD6-C218-574E-AAD3-4B916FD123E8","ومَا لمْتُ نَفْسي في قضَاءِ حقوقكمْ","وقَد كانَ لي فيما اعتذرتُ به عُذْرُ"],["58D1C5CE-77E3-5F14-8EEC-EBE430342EA4","وأَمْنَحُكُمْ مالي، وتُكْفَرُ نِعْمَتِي","وتَشتُمُ عِرْضي في مجالسها فِهْرُ"],["6F7F6CC3-8F29-57E9-8505-9DF51A8DB350","إذا العذرُ لم يُقبَلْ، ولم يَنفعِ الأسَى","وضَاقتْ قلوبٌ منهُمُ حَشْوُها الغِمْرُ"],["01760DE3-8F10-51D6-A943-06A466DC82EB","فكيفَ أداوِي داءكُمْ، ودواؤُكمْ","يزيدكُم غيّاً؟! فقد عظُمُ الأمْرُ"],["DF357F26-9C4A-597F-AFD3-7B077FC8B564","سَأَحْرِمُكُمْ حَتّى يَذِلّ صِعَابُكمْ","وأبلَغُ شَىْءٍ في صلاحكُمُ الفَقْرُ"]]},"EBAE5974-C3BC-56D9-AC9A-0BE8341CD3A5":{"t":"إذا راحَ في قُوهِيّةٍ مُتَلَبّساً","p":58,"s":"إذا راح في قوهية متلبسا","r":"441282","v":[["EF43B070-D541-5247-B44F-3AB87A461FC6","إذا راحَ في قُوهِيّةٍ مُتَلَبّساً","تقُلْ: جُعلٌ، يَسْتنّ في لَبنٍ محضِ"],["7561A17B-0110-5B43-80AE-9605A6A4D10F","وأقسمُ لو خرّتْ مِن استِكَ بيضَةٌ","لما انكسرتْ مِنْ قربِ بعضك من بَعضِ"]]},"E132AB7E-321F-5646-98C3-30DB05BB8095":{"t":"إذا سار مَنْ دونَ امرىء وأمَامَهُ","p":58,"s":"إذا سار من دون امرىء وأمامه","r":"441280","v":[["DCD0C891-0AED-5AF5-9C0E-4B65171E2F81","إذا سار مَنْ دونَ امرىء وأمَامَهُ","وأَوْحَشَ مِنْ إخوانه فهْوَ سائر"]]},"3AF429E7-33A6-55BC-A4CB-19B8E260C1A4":{"t":"إذا قالَ لم يَتْرُكْ مَقَالاً ولم يقفْ","p":58,"s":"إذا قال لم يترك مقالا ولم يقف","r":"441246","v":[["9FC70E6B-262C-50FA-B74B-E96F6D4F4CD3","إذا قالَ لم يَتْرُكْ مَقَالاً، ولم يقفْ","لعيّ، ولم يثنِ اللسانَ على هجرِ"],["E820C224-3036-53C8-AB22-7F717D0DD4FE","يُصَرّفُ بالقولِ اللِسَانَ إذا انتحَى","وينظرُ في أعطافهِ نظرَ الصقر"]]},"273D34DF-5C38-5808-A1A6-4DE11EE2A075":{"t":"إذا قلتُ: قد وَلّتْ رَبيعَةُ أَقْبَلَتْ","p":58,"s":"إذا قلت: قد ولت ربيعة أقبلت","r":"441236","v":[["A0C22B8E-BA4A-53E0-916B-57A86BEC2E64","إذا قلتُ: قد وَلّتْ رَبيعَةُ، أَقْبَلَتْ","كتائِبُ منهمْ كالجبالِ، تُجالِدُ"]]},"27AE9554-7476-59AC-AFDA-045A689E86AD":{"t":"إذا لَمْ أَعُدْ بالحِلْمِ منّي عليكمُ","p":58,"s":"إذا لم أعد بالحلم مني عليكم","r":"441275","v":[["E5DA9E04-B975-5ABE-9D0E-0D4CEA51B66D","إذا لَمْ أَعُدْ بالحِلْمِ منّي عليكمُ","فَمَنْ ذا الذي بَعْدِي يُؤَمَّلُ للحِلْمِ!"],["6FA0ED3D-2C6E-5024-A946-4EFE0ED2CB02","خذْيِها هَنيئاً، واذكري فِعْلَ مَاجدٍ","جزاكِ عَلى حربِ العداوةِ بالسلْمِ"]]},"C7C6D509-2308-5EE2-8582-859C07C7C496":{"t":"إنّما مَوْضِعُ سِرّ المرءِ إنْ","p":58,"s":"إنما موضع سر المرء إن","r":"441234","v":[["24BE0898-0DCF-5412-9C8A-59E622C74111","إنّما مَوْضِعُ سِرّ المرءِ، إنْ","باحَ بالسّرّ، أخوهُ المنْتَصحْ"],["FE999CF8-A79C-56C2-9875-6EC04E02224E","فإذا بُحْتَ بِسِّر فإلى","ناصحٍ، يَسْتُرُهُ أو لا تَبُحْ"]]},"4C54634A-2E4F-579F-9DC2-4C4AAB401FBC":{"t":"إنْ تُناقِشْ يكنْ نِقاشُكَ يا ربْ","p":58,"s":"إن تناقش يكن نقاشك يا رب","r":"441230","v":[["9AF6EEBE-F763-50A8-BFCE-2A92CD47410E","إنْ تُناقِشْ يكنْ نِقاشُكَ يا ربْ","بِ عذاباً، لا طوقَ لي بالعذابِ"],["18166192-E025-5362-BEE6-03D0499AF544","أو تجاوزْ، فأنتَ ربٌّ رحيمٌ","عن مُسيءِ ذُنوبُهُ كالتّرابِ"]]},"79AF2AEA-20B2-5426-A27D-ECE79CE7C5F6":{"t":"تطاوَلَ ليلِي واعترتْنِي وساوسِي","p":58,"s":"تطاول ليلي واعترتني وساوسي","r":"441252","v":[["5ED12862-A302-5D25-A7C7-D94F2AF1613E","تطاوَلَ ليلِي واعترتْنِي وساوسِي","لآتٍ أَتَى بالتُّرَّهَاتِ البَسَابِسِ"],["0D9ACA17-BBEE-597D-B257-B4D21A041331","أتانا جَرِيرٌ، والحوادِثُ جمّةٌ","بتلكَ التي فيها اجتداعُ المَعَاطِسِ"],["FDD524BD-C9BB-5539-A855-1DDF0170E9AE","أكابدُهُ والسّيفُ بيني وبينَهُ","ولستُ لأَثْوابِ الدِّنيّ بلابِسِ"],["62A27EB4-346C-545E-8B81-283444D96DC5","إنِ الشّامُ أَعْطَتْ طَاعَةً يُمَنِيّةً","تَواصَفَها أَشيَاخُها في المجالِسِ"],["8931A9DA-C486-5394-B1B2-D5B7E56BB60E","فإنْ يُجْمِعُوا أَصْدِمْ عَلِيّا بِجَبْهَةٍ","تفُتُّ عليْهِ كلَّ رَطْبٍ ويابِسِ"],["6440C9C9-37BA-5DDD-9097-A2F4DACD8407","وإنّي لأَرجو خَيْرَ مانالَ نائِلٌ","وَمَا أَنا من مُلْكِ العِراقِ بِآيِسِ"],["DA116902-2E72-55DD-B4FB-7D7FA9A91754","وإلاّ يَكونوا عِنْدَ ظَنّي بنصرهِمْ","وإنْ يخلفوا ظنّي يكن كفّ عابسِ"]]},"422DC2A8-A12B-5DE9-A080-BAF49288701A":{"t":"تطَاولتُ للضحَاكِ حتّى رددتُهُ","p":58,"s":"تطاولت للضحاك حتى رددته","r":"441247","v":[["73F89035-D6EB-500D-9565-04AE159B2E14","تطَاولتُ للضحَاكِ حتّى رددتُهُ","إلى حَسَبٍ في قومه متقاصِرِ"]]},"7A3E4B10-DE48-5C63-87A4-16E88434BF05":{"t":"تقُولُ قُريشٌ حِينَ خفّتْ حلوُمُهَا","p":58,"s":"تقول قريش حين خفت حلومها","r":"441249","v":[["FF1839B3-D063-5868-8ED5-CFA186A3C4E6","تقُولُ قُريشٌ حِينَ خفّتْ حلوُمُهَا","نَظُنُّ ابنَ هِنْدٍ هَائِباً لابنِ جَعْفَرِ"],["BDB52D8A-50B9-52F4-8173-0BBA4A2B6781","فمِنْ ثَمّ يقضِي ألْفٍ ألْفٍ ديونَهُ","وحَاجَتُهُ مَقْضِيّةٌ لم تُؤَّخَّرِ"],["61CFA314-83A8-5F56-A263-60FFDCC8A6DD","فَقُلْتُ: دَعُوا لي، لا أَبا لأَبِيكُمُ","فما مِنْكُمُ قَيْضٌ لَهُ، غيرُ أَعْوَرِ"],["9243B386-E61C-55DF-95F4-BCDDBF4E03A7","ألَيْسَ فَتى البطحَاءِ مَا تنكرونَهُ","وأَوّلَ مَنْ أُثْنِي بِتَقْواهُ خِنْصَرِي"],["F72BF03A-2591-5045-88F3-CF458B959FA1","وكان أبو جعفْرَ قد سادَ قومَهُ","ولم يَكُ في الحَرْبِ العَوانِ بِحَيْدَرِ"],["C0541969-9885-5A32-B25C-722B99431C1F","فَما أَلْفُ،ألفٍ فاسْكُتُوا، لابنِ جَعْفَرٍ","كثيرٌ، ولا أَمْثَالُها لي بمُنْكَرِ"],["EA5842F9-4392-55A8-93FC-16EFE769CAF6","ولا تحسدوُهُ، وافعَلُوا كفعالِهِ","ولن تدرِكُوهُ كُلّ ممْشَى ومحضَرِ"]]},"F7C5EBE4-A7CB-5AC7-9669-93A475AE53AB":{"t":"تَدَارَكَ ما ضَيّعْتَ مِن بَعْدِ خِبْرَةٍ","p":58,"s":"تدارك ما ضيعت من بعد خبرة","r":"441244","v":[["1EE94D41-AB38-5159-9131-8A8AFEFBF87E","تَدَارَكَ ما ضَيّعْتَ مِن بَعْدِ خِبْرَةٍ","وأنتَ أَرِيبٌ بالأُمُورِ خَبيرُ"],["2FDCB3EF-3394-5A16-A6ED-D9AFFCB831DD","أمَا حسَنٌ فابنُ الذي كانَ قبلَهُ","إذا سَارَ الموتَ حيْثُ يسِيرُ"],["BB8328F9-D611-5B28-A2E8-275E11455B2A","وهَل يَلِدُ الريبالُ إلاّ نِظيرَهُ","فذا حَسَنٌ شِبْهٌ لَهُ ونَظِيرُ"],["3D4233EF-F5A1-582E-9330-D0FBCFAD63AE","ولكنّه لو يُوزَنُ الحِلْمُ والحِجَا","بِرأيٍ لقالوا، فاعلمنّ: ثَبيرُ"]]},"628406B8-B90A-55DD-9C1E-D21CC2B13313":{"t":"حُرَيثُ أَلَمْ تَعْلَمْ وجَهْلُكَ ضَائِرُ","p":58,"s":"حريث ألم تعلم وجهلك ضائر","r":"441243","v":[["365E3034-BCD2-5563-B66E-427A09EBE3A4","حُرَيثُ، أَلَمْ تَعْلَمْ، وجَهْلُكَ ضَائِرُ","بِأَنّ عَلِيّاً للفوارسِ قَاهِرُ"],["BFB7ED87-EB48-5812-B14F-B1BAA1162FEF","وأنّ عَلِياً لم يُبارِزْهُ فارِسٌ","مِن الناسِ إلاّ أقصدَتْهُ الأظافِرُ؟"],["0A131F84-FAD8-5D93-B84A-EE5232613DF2","أمرتُكَ أمْراً حازماً فعَصِيتَني","فَجَدُّك إذْ لم تَقْبَلِ النُّصْحَ عاثِرُ"],["9E26558D-582C-58B7-8AF4-45A9D7AC4B6B","ودلّاكَ عمرٌو، والحوادِثُ جمّةٌ","غروراً، وما جرّتْ عليكَ المقادِرُ"],["887E28E6-D051-515E-8508-6E5888968CE8","وظَنّ حريْثٌ أنّ عمْراً نصيحُهُ","وقد يهلِكُ الإنسانَ مَنْ لا يحاذِرُ"],["F5F4BACD-08E9-510D-BB51-8D815B3B1C1C","أيركبُ عمرٌو رأسَهُ خوفَ سيفهِ","ويصْلِي حُريثاً، إنّه لفرافِرُ؟"]]},"D547390C-4B2B-53A9-977A-D9CCF8B31058":{"t":"دعوتُ ابنَ عَبّاسٍ إلى حَدّ خُطَّةٍ","p":58,"s":"دعوت ابن عباس إلى حد خطة","r":"441264","v":[["B706F0FB-8B56-5393-B49B-61E110C164C9","دعوتُ ابنَ عَبّاسٍ إلى حَدّ خُطَّةٍ","وكانَ امرأَ أُهدِي إليه رَسَائلي"],["6B14F0E6-6975-50A3-A5AF-7C5B8E2196F7","فأخْلَفَ ظنّي، والحوادثُ جمّةٌ","ولم يَكُ فيما قال منّي بواصِلِ"],["7A3D3AFB-C821-53E0-B3D3-DEFC4DE5DC94","وما كان فيما جاء ما يستحقّهُ","ومَا زاد أنْ أَغلَى عليه مَراجلي"],["3CECE8BC-0EDF-5BD8-912D-DE5DE326CB24","فقلْ لابن عبّاسٍ: تُراكَ مُفرّقاً","بقولك مَنْ حَولي، وأنّكَ آكلي"],["115038FD-4B0E-5304-AD43-91E8E86A3FA0","وقل لابن عباسٍ: تُراكَ مخَوّفاً","بجهلكَ حِلْمِي، إنّني غيرُ غافلِ"],["BE633F00-E74E-5E61-A520-1F51BACF79E3","فَأبْرقْ، وأرعِدْ ما استطعتَ فإنّني","إليكَ بما يشجيك سَبْطُ الأناملِ"]]},"CEE5993C-DBD1-5F5C-8E14-27D1BFB88A64":{"t":"رُبّ ساعٍ لِقَاعِدِ","p":58,"s":"رب ساع لقاعد","r":"441238","v":[["EAB01ED9-BB9D-5627-9AFB-AA4BF1F272D3","رُبّ ساعٍ لِقَاعِدِ","واسلمي أمّ خالدِ"]]},"25CFE6AC-C0B6-562F-8619-651F0C63ED09":{"t":"سَأكفيكَ ما عندي فقُلْ لابن عَامِرٍ","p":58,"s":"سأكفيك ما عندي فقل لابن عامر","r":"441256","v":[["28FAE7F7-E51F-56F1-B988-6C1389F62337","سَأكفيكَ ما عندي، فقُلْ لابن عَامِرٍ","وصاحِبِ مصرٍ يَكفيانِ الذي أكْفي"],["90DA9B2C-D48D-5DC3-A2A3-BBEE0C758B10","وإلاّ فإنّي، والذي أنا عبده","مَليءٌ بضبطي ما أمامي، ومَا خَلْفي"],["E5A2923F-9FE9-5633-BA3A-B5E4C539AE65","ولَسْتُ بذي وجهينِ، ألقاك بالذي","تريدُ، ويُخْفِي في السَّريرِة ما يُخْفِي"],["61B20F17-EE53-565B-AE6C-2EABC4D06F58","لأنّي إذا عِرضي لكَ اليومَ دونهَمْ","وحَتفُكَ فيما يَنْتِجُونَ به حَتْفَي"]]},"760182CD-A62E-5A4E-8CAD-A785C0314950":{"t":"شجاعٌ إذا ما أمْكَنَتْنيَ فُرْصَةٌ","p":58,"s":"شجاع إذا ما أمكنتني فرصة","r":"441288","v":[["0FFB602F-42C5-5AE7-8096-7C8BEB5FD516","شجاعٌ إذا ما أمْكَنَتْنيَ فُرْصَةٌ","وإنْ لم تكنْ لي فُرصةٌ فجبانُ"]]},"D5DECDF8-4E35-5B75-BF47-6E2D8C67DB29":{"t":"صرمْتُ سفاهتي وأرحتُ حلمي","p":58,"s":"صرمت سفاهتي وأرحت حلمي","r":"441253","v":[["9C85C6B3-D8F0-59DD-8043-5D36F80FD36D","صرمْتُ سفاهتي، وأرحتُ حلمي","وفِيّ عَلَى تحمّلِيَ اعتراضُ"],["18EA0C24-3312-51A9-ADB8-552B93233831","على أنّي أُجيبُ إذا دعتني","إلى حاجاتها الحَدَقُ المِراضُ"]]},"BF03723B-BEE2-5C94-A3BF-7100CD390B95":{"t":"طلبَ الأَبْلَقَ العَقُوقَ فَلَمّا","p":58,"s":"طلب الأبلق العقوق فلما","r":"441258","v":[["5BB0E297-BC05-5099-B11A-D3DFDB39906B","طلبَ الأَبْلَقَ العَقُوقَ فَلَمّا","لمْ ينلْهُ أرادَ بيْضَ الأنُوقِ"]]},"A3DFE4D9-9034-5EBD-B182-536B39361E7A":{"t":"فإنْ أكُ في شرارِكُم قليلاً","p":58,"s":"فإن أك في شراركم قليلا","r":"441281","v":[["C409B261-B706-5E8A-924C-34C71F364761","فإنْ أكُ في شرارِكُم قليلاً","فإنّي في خياركُم كثيرُ"],["F49BAFC0-9832-5702-A656-2BD639A6C5A7","بُغاث الطّيْر أكثرها فِراخاً","وأمُّ الصّقْرِ مِقْلاتٌ نَزُورُ"]]},"06A125BC-BCF5-5559-99C3-F70915932173":{"t":"فإنْ ماتَ لم تُفْلح مزينةُ بَعْدَهُ","p":58,"s":"فإن مات لم تفلح مزينة بعده","r":"441286","v":[["3A6D2CE9-7479-529E-A7D3-8DA13F1A3495","فإنْ ماتَ لم تُفْلح مزينةُ بَعْدَهُ","فنوطي عليه- يامُزَيْنُ- التمائما"]]},"B6CB311E-4BDD-5E5E-9501-F4B1313B144C":{"t":"فلا تَعْجَلا واستغورا الله إنّهُ","p":58,"s":"فلا تعجلا واستغورا الله إنه","r":"441239","v":[["B80C4600-5661-5D60-9BB8-C9A4AA5B3B24","فلا تَعْجَلا، واستغورا الله إنّهُ","إذا اللهُ سنّى عَقْدَ شَيْءِ تَيَسّرا"]]},"7D7E531F-4402-5B8B-B0DD-CA0FC52501B8":{"t":"فَهَلْ مِنْ خالدٍ إنْ ما هلكْنا","p":58,"s":"فهل من خالد إن ما هلكنا","r":"441279","v":[["BE3BCB8D-AA9E-536F-BD73-AC6D8E1502A7","فَهَلْ مِنْ خالدٍ إنْ ما هلكْنا","وَهَلْ بالموتِ يا للنّاسِ عارُ"]]},"F6C8BDCF-954F-541C-8D0B-3A09B4F7278E":{"t":"قَدْ عِشْتُ في الدّهرِ ألواناً عَلَى خُلُقٍ","p":58,"s":"قد عشت في الدهر ألوانا على خلق","r":"441254","v":[["011733DA-D3EA-5E6A-9AD4-EE8F35BF42A9","قَدْ عِشْتُ في الدّهرِ ألواناً عَلَى خُلُقٍ","شَتّى، وقاسَيْتُ فيه اللِّينَ والطَّبَعَا"],["B053EF4D-777A-56F5-B5D7-E0078F0B34F9","كُلاّ لبسْتُ، فلا النعمَاءُ تبْطرُني","ولا تعودْتُ من مكروهها جشَعَا"],["243DB8BB-9C85-5226-8F24-4A972DC18B31","لا يمْلأُ الأمْرُ صَدْري قبْلَ مصدرِهِ","ولا أضيقُ به ذَرْعاً إذا وَقَعَا"]]},"EC76F64A-C82D-5F7C-B22C-593E41799ECD":{"t":"كَتَارَكَةٍ بَيْضَها بالعَراءِ","p":58,"s":"كتاركة بيضها بالعراء","r":"441235","v":[["106DE06C-E57E-55AB-A78F-AEAB26E8CC36","كَتَارَكَةٍ بَيْضَها بالعَراءِ","ومُلْحفَةٍ بَيْضَ أُخْرَى جَنَاحا"]]},"30CCA92C-7A54-511C-9F8A-F22E473D12E8":{"t":"لعَمْرِي لقدْ عمّرتُ في الدهْرِ بُرهةً","p":58,"s":"لعمري لقد عمرت في الدهر برهة","r":"441245","v":[["03A7D7E7-1EB9-5049-9D94-A49B055696A8","لعَمْرِي، لقدْ عمّرتُ في الدهْرِ بُرهةً","ودانتْ لي الدنيا بِوَقْعِ البواتِرِ"],["4433CCF8-432E-5B2E-BE76-B2DDD64C0606","وأعطِيتُ المالِ والحكْمَ والنُّهَى","ولي سَلَّمَتْ كُلُّ الملوكِ الجبابرِ"],["EF8C3456-46B6-5BD6-8FB3-8E6E5959B73B","فأضْحَى الذي قد كانَ مِمّا يسرّني","كَحُكْمٍ مَضَى في المُزْمَنَاتِ الغَوابِرِ"],["BAB07227-4656-5E1A-B934-DB96F2173158","فيا ليتني لم أعنِ في الملكِ سَاعةً","ولم أسعَ في لذاتِ عيشٍ نواضرِ"],["C41F5A8D-E0F5-5C0D-8B12-090EECF56C4D","وكنتُ كذي طِمْرَيْنِ عاشَ ببلغةٍ","فلم يَكُ حتى زارَ ضِيقَ المقابرِ"]]},"54D32B65-204D-5E17-B504-3B6EE6451D55":{"t":"لقد رَضيَ الشنّيُّ من بعد عَتبِهِ","p":58,"s":"لقد رضي الشني من بعد عتبه","r":"441232","v":[["797C2801-9E7F-574E-9565-6EC74EC88046","لقد رَضيَ الشنّيُّ من بعد عَتبِهِ","فأيسرِْبـ ما يَرضَى به صَاحِبُ العيبِ"]]},"AAE0C084-79C1-53E9-AD51-0221E4F0B816":{"t":"لقدْ جَمَعْتُ لكمْ مِنْ جَمْعِ ذي حَسَبٍ","p":58,"s":"لقد جمعت لكم من جمع ذي حسب","r":"441229","v":[["A876A9AA-DACC-5D41-8AD9-B83DA93859BC","لقدْ جَمَعْتُ لكمْ مِنْ جَمْعِ ذي حَسَبٍ","وقَدْ كَفَيْتُكُم التّرْحَالَ والنّصبَا"]]},"A887E831-D700-57B2-8067-D21EF3902C8D":{"t":"للهِ دَرُّ زِيَادٍ أيَّما رَجُلٍ","p":58,"s":"لله در زياد أيما رجل","r":"441241","v":[["ADDA2A7F-3890-5434-BCD3-50E41987515A","للهِ دَرُّ زِيَادٍ أيَّما رَجُلٍ","لو كان يعلَمُ ما يأتي، وما يذَرُ"],["31EF75D9-3D87-5D18-AF18-72DA8EE378C2","تَنْسَى أباكَ وقد حَقّتْ مَقالَتُهُ","إذْ تخطُبُ الناسَ، والوالي لنا عُمرُ"],["2898C026-3EC8-5D52-9D9B-FAB6403FDE2B","فَافخرْ بوالدِكَ الأَدْنَى ووالدِنَا","إنّ ابنَ حَرْبٍ لَهُ في قَوْمَهَ خَطَرُ"],["4F535551-82E1-5F0A-8627-97F07F6AC3DF","إنّ انتهازَكَ قَوْماً لا تُنَاسِبُهُم","عدُّ الأنامِل، عارٌ، ليْسَ يغتفَرُ"],["C8B20E28-D2AF-5128-918C-808AE424E124","فانزِلْ بعِيداً، فإنّ الله باعدهُمْ","عن فضلٍ به يعلُو الورى مضَرُ"],["04A56582-2534-57B6-AD1B-D6E6A4D7A1AE","فالرأْيُ مطرَفٌ، والعقْلُ تجربَةٌ","فيها لصاحبها الإيرادُ والصَّدَرُ"]]},"757E6C6F-7EAA-5BF2-A9F4-1A44A1082E41":{"t":"لمالُ المرْءِ يُصْلِحُهُ فَيُغْني","p":58,"s":"لمال المرء يصلحه فيغني","r":"441283","v":[["E1C9E184-4D54-516F-95EC-2E112DD8B79B","لمالُ المرْءِ يُصْلِحُهُ فَيُغْني","مفاقرَهُ أعفُّ منَ القنوعِ"],["C7DBA08D-4FC4-5901-BB82-40F44BADAA37","يَسُدُّ به نوائبَ تَعَتَرِيهِ","منَ الأيامِ كالنهرِ الشروعِ"]]},"464BE579-E5BA-5403-98B4-72B2E9BDA6C5":{"t":"ليس بيني وبينَ قَيْسٍ عِتَابٌ","p":58,"s":"ليس بيني وبين قيس عتاب","r":"609070","v":[["D4B24FA3-A6FA-5589-9B04-AC0D7FAEA7FA","ليس بيني وبينَ قَيْسٍ عِتَابٌ","غيرُ طَعْنِ الكُلَى وضَرْبِ الرّقابِ"]]},"3DBAD95B-F6B6-54BD-97C0-D343EEA5B68D":{"t":"ليسَ منْ قد غذاهُ طفلاً صغيراً","p":58,"s":"ليس من قد غذاه طفلا صغيرا","r":"441267","v":[["0F4AD2EF-48AE-51AA-A0F7-F12C786D3E29","ليسَ منْ قد غذاهُ طفلاً صغيراً","وسقاهُ من ثَدْيهِ بالخذولِ"],["E05A34B9-3AFB-5BEE-B123-AA0EC328B980","هي أولَى بهِ وأقرَبُ رُحمْاً","من أبيه، وفي قضاء الرسولِ"],["681F29A3-4002-5D33-810F-EB7034CA9938","أنّهُ ما حَنَتْ عليه، وَرَقّتْ","هي أوْلَى بذا الغلامِ الجميلِ"]]},"F7E2BB80-C845-5799-8D98-F5E4543CAC97":{"t":"لَعمري لقد أنصفْتُ والنَّصفُ عَادَتي","p":58,"s":"لعمري لقد أنصفت والنصف عادتي","r":"441277","v":[["C6A5DDCC-25AD-5A81-A273-D8827DE4A783","لَعمري، لقد أنصفْتُ، والنَّصفُ عَادَتي","وعايَنَ طَعْنَاً في العَجاجِ المُعَاينُ"],["ADF40DF0-6E4A-5B40-9500-8F3A81BD0C4F","ولولا رَجائي أنْ تؤوبُوا بنهزَةٍ","وأنْ تَغْسِلُوا عاراً وَعَتْهُ الكنائنُ"],["F2FD359C-6225-5C96-BEFD-E786545BAC85","لناديتُ للهيَجا رجالاً سِواكُمُ","ولكنّما تحمي الملوكَ البطائنُ"],["08533ECA-B060-5402-A0CE-978E1610777F","أتدرونَ منْ لاقيتمُ، فلَّ جيشكُمْ","لَقِيتُمْ لُيوثاً أَصْحَرَتْها العَرَائنُ"],["AEE66EE6-7118-50AF-BC31-9042640C458A","لقيتُمْ صَناديدَ العِراقِ ومَنْ بِهمْ","إذا جاشَتِ الهِيجاءُ تُحْمَى الظّعائنُ"],["3B812FF6-B97D-59EB-AA30-D4BEEF321283","ومَا كانَ مِنْكُم فارِسٌ دونَ فارِسٍ","ولكِنّهُ ما قَدّر اللهُ كائنُ!"]]},"4F3684B7-003E-5E4B-9875-F71427FE22B1":{"t":"ما أحسنَ العدلَ والإنصاف من عَمَلٍ","p":58,"s":"ما أحسن العدل والإنصاف من عمل","r":"441266","v":[["54D13ADD-D62F-5EB3-BB3C-19CFDD5ABB12","ما أحسنَ العدلَ والإنصاف من عَمَلٍ","وأقبحَ الطيشَ، ثم النَّفْشَ في الرجُلِ"]]},"B901787E-834E-5C42-8291-58A6D8D02E0F":{"t":"ما ألبثتْكَ الدنانيرُ التي بعثَتْ","p":58,"s":"ما ألبثتك الدنانير التي بعثت","r":"441276","v":[["4970DA80-D729-5131-A87F-7AAEB809C5B4","ما ألبثتْكَ الدنانيرُ التي بعثَتْ","أنْ لَوّنَتْكَ، أَبا العُريانِ، ألوانا"],["A19510C2-3616-51D1-9AA0-19FEF3813E1A","أمْسَى إليك زيادٌ في أرومتهِ","نُكْراً، فأصبَحَ ما أنكرتَ عِرْفانا"],["0066432C-6FFC-5249-84C9-A0170E68C6DF","للهِ دَرُّ زيادٍ لو تَعَجّلَها","كانَتْ له دونَ ما يخشاه قُربانا"]]},"07AC1BAF-4520-5C65-922F-5CB64D8F00EB":{"t":"نَفَى النّومُ ما لا تَبْتَغِيهِ الأَضالعُ","p":58,"s":"نفى النوم ما لا تبتغيه الأضالع","r":"441255","v":[["0986D3C0-DA36-5EC7-AC0D-92290A7EA7FF","نَفَى النّومُ ما لا تَبْتَغِيهِ الأَضالعُ","وكلُّ امرىءٍ يوماً إلى الصّدقِ راجعُ"],["30ADAF37-6D2F-540B-BAC5-DCC8466DB709","فيا عمرو، قد لاحَتْ عيونٌ كثيرةٌ","فيا ليتَ شِعْري، عمرُ، ما أنت صانعُ؟"],["3D20531E-19CC-5000-90CC-F778E3A03FAD","ويا ليتَ شعري عَنْ حديثٍ ضَمِنْتَهُ","أتحمله، يا عمرو ما أنت ضالِعُ؟"],["1C7EFDC6-04E6-5E6A-9C87-900184E9A126","وقال رجالٌ: إنّ عمراً يُريدُها","فقلت لهم: عمروٌ ليَ، اليومَ، تابعُ"],["3943A72B-EFC0-5841-A960-11935186EF74","فإنْ تَكُ قد أبطأْتَ عنّي تبادَرَتْ","إليكَ بتحْقِيقِ الظّنونِ الأصابعُ"],["09F20E7F-701A-5181-A56B-E36C98756016","فإنّي، وربّ الراقصاتِ عَشِيّةً","خَوَاضِعَ بالرُّكبانِ، والنّقْعُ ساطِعُ"],["15FE9FA5-1789-510F-B16D-2A0358BCC98D","بكَ اليومَ في عَقْدِ الخلافةِ واثقٌ","ومن دون ما ظنّوا به السُّمُّ ناقِعُ"],["31FB0E7E-D782-5E49-88AE-5896048F7499","فَأسرع بها، أو أبطِ في غيرِ رِيبَةٍ","ولا تعْدُ، الأمر الذي حُمّ واقِعُ"]]},"7423B152-896C-5526-A50A-6D3D4A4049E2":{"t":"وإنّ سَفَاهَ الشّيخِ لا حِلْمَ بَعْدَه","p":58,"s":"وإن سفاه الشيخ لا حلم بعده","r":"441273","v":[["2BBFA817-BEC2-50F1-936C-0420E92AE976","وإنّ سَفَاهَ الشّيخِ لا حِلْمَ بَعْدَه","وإنّ الفتَى بعدَ السّفاهةِ يحلَمُ"]]},"4EE6FB80-6105-5604-88C8-39A7C09B07FC":{"t":"وما قَتلَ السفاهةَ مثلُ حلمٍ","p":58,"s":"وما قتل السفاهة مثل حلم","r":"441274","v":[["5AF34545-18CD-5605-A290-DFA57576F8E8","وما قَتلَ السفاهةَ مثلُ حلمٍ","يَعودُ بهِ على الجَهْلِ الحليمُ"],["1AAEBD21-22BF-5F3B-8E8F-282E41FFDDB5","فلا تسفهْ، وإنْ مليتَ غيظاً","عَلَى أحدٍ فإنّ الفحشَ لُومُ"],["7C3A2114-65E5-508F-B1BB-4A7410D5BDA9","ولا تقطعْ أخاً لكَ عِنْدَ ذَنْبٍ","فإنّ الذنبَ يعفوهُ الكريمُ"]]},"25908B92-B7E8-5F88-A75F-0664DF146C39":{"t":"ومستعجِبٍ مِمّا يَرى مِنْ أناتِنا","p":58,"s":"ومستعجب مما يرى من أناتنا","r":"441287","v":[["A697081D-5E7A-594E-9322-AEA0E9C185F2","ومستعجِبٍ مِمّا يَرى مِنْ أناتِنا","ولو زَبنتْهُ الحربُ لم يترمرمِ"]]},"69AAA55C-49EF-5805-B8DC-BA4A748696BF":{"t":"وَقَتْكَ وأسبابُ المنايا كثيرةٌ","p":58,"s":"وقتك وأسباب المنايا كثيرة","r":"441231","v":[["475DE3F8-9367-5F9E-9DC8-0FB0B5AEF6FF","وَقَتْكَ، وأسبابُ المنايا كثيرةٌ","مَنِيّةُ شيخٍ من لُؤَيِّ بنِ غالبِ"],["73BF20A1-3832-530C-B6AD-244A41528FF1","فيا عمرو، مهلاً، إنّما أنت عَمُّه","وصاحبُهُ دونَ الرّجَالِ الأقاربِ"],["184E032B-CA78-5AD7-908F-B63351041D2D","نَجَوتَ، وَقَدْ بَلّ المَرادِيُّ سَيْفَهُ","من ابن أبي، شيخِ الأباطِحِ، طَالبِ"],["BCE483EA-6681-5992-8EA4-AE3D2C9D54FD","ويَضْرِبُني بالسّيْفِ أخَرُ مِثْلُهُ","فكانتْ عليه تِلكَ ضرْبَةَ لازبِ"],["A433EC49-2D6A-5FFE-9A69-58A245010488","وأَنْتَ تُنَاغِي كُلَّ يَوْمٍ وَلَيْلَةٍ","بمصْرِكَ بِيضاً كالظِّباءِ الشّوازبِ"]]},"7B34DAE0-DD7A-5FD2-95A7-580C0F8EAC35":{"t":"يا حسينُ بنَ عَليّ ليس ما","p":58,"s":"يا حسين بن علي ليس ما","r":"441262","v":[["69B5D2C6-1C96-569B-9CDC-D2D0543B8B50","يا حسينُ، بنَ عَليّ ليس ما","جِئتَ بالسّائغِ يَوْماً في العِلَلْ"],["4A2DD034-394A-5038-B357-9DC23565E87E","أَخْذُكَ المالَ، ولم تُؤْمَرْ به","إنّ هذا من حُسيْنٍ لعَجَلْ"],["4B5657C0-4E0C-5736-BCEF-09AA65FCA91F","يا حسينُ، بنَ عَلّي ذا الأمَلْ","لك بعدي وثبْةٌ، لا تُحتمَلْ"],["DDF89BD3-7242-550E-9CF6-5E7CFD5769E3","وبودّي أنّني شاهدُها","فَأليِهَا مِنْكَ بالخُلقِ الأجَلْ"],["C7582CC6-AE0A-5BB4-B77F-E55F8859F4B0","ليس بعدي لكَ مَنْ يحْمِلُها","ليسَ بين المالِ والوَثْبِ عَمَلْ"],["14499640-7ED1-58BE-BDA2-512C1C9F6C85","إنّني أَرهَبُ أنْ تَصلَى بِمَنْ","عنده قَدْ سَبَقَ السّيْفُ العَذَلْ"]]},"7AFB3F1E-2537-5B8C-9078-B36D87CC76AA":{"t":"يا صَخْرُ لا تُسْلِمَنْ يوماً فتفضَحَنا","p":58,"s":"يا صخر لا تسلمن يوما فتفضحنا","r":"441257","v":[["BD11544A-5F94-5EB6-947B-F8D79360914D","يا صَخْرُ، لا تُسْلِمَنْ يوماً فتفضَحَنا","بعد الذين ببَدْرٍ أصبحُوا فِرَقا"],["B4B1449D-F82B-58E1-B9D2-ED1C2AA21F23","خَالي وعَمّي وعَمُّ الأمّ ثالثُهُمْ","وحَنْظَلُ الخيرِ قد أهدى لي الأَرَقَا"],["D3916A1B-220E-5DEE-BBC5-8840BBD2C1E3","لا تَرْكَنَنَّ إلى أَمْرٍ تُكَلّفُنا","والراقصاتِ، به في مكّةَ الخُرُقا"],["11B7D281-B379-58F8-83AF-9B9F4F2081A5","فالموتُ أهونُ من قَولِ العداةِ، لَقَدْ","حَادَ ابنُ حَرْبٍ عن العُزّى إذاً فَرقَا"]]},"27EE8032-8366-51B2-B5CA-FDC53DDCD138":{"t":"ياعمرو إنّكَ قد قَشَرْتَ لي العَصَا","p":58,"s":"ياعمرو إنك قد قشرت لي العصا","r":"441250","v":[["101CBE2E-4BC9-5265-8406-2AB221B08BC7","ياعمرو، إنّكَ قد قَشَرْتَ لي العَصَا","برضاكَ في وسط العجاجِ بِرازِي"],["22036168-9A3D-530C-A0EF-E4947F77D30A","ياعمرو، إنّكَ قد أَشَرْتَ بِظِنّةٍ","إنّ المبارِزَ كالجُدَيّ النّازِي"],["44B9D011-F314-5D0A-A874-28BC9E119863","ما للملوكِ وللبرَازِ، وإنّما","حَتْفُ المبارز خَطْفةٌ للبازي"],["8ABBABB8-E6E3-5B49-B11C-D27FDDF43830","ولقد أعدتَ، فقلتُ: مَزْحَةُ مَازِحٍ","والمزح يحملُهُ مقالُ الهازي"],["16101EC8-2B56-5D06-82B7-E9E37C24F637","فإذا الذي منتْكَ نفسُك خالياً","قتلِي، جزَاكَ بِمَا نويْتَ الجازي"],["18ADC43C-73AD-5B78-A2F6-0B800F994AFB","فلقد كَشَفْتَ قِنَاعها مَذْمُومَةً","ولقد لبستَ بها ثيابَ الخَازِي"]]},"BA285E91-7BFE-5B9B-A52B-0762CAAF06D7":{"t":"يموتُ الصالحونَ وأنتَ حيُّ","p":58,"s":"يموت الصالحون وأنت حي","r":"441233","v":[["A1206653-C408-5CD5-BB7C-482F4A71D60C","يموتُ الصالحونَ، وأنتَ حيُّ","تَخَطّاكَ المنايا، لا تموتُ"]]}}}