{"v":1,"poems":{"C942F137-191E-5CF7-A407-D2FB40EB244F":{"t":"أبلغ ضبيعة كهلها ووليدها","p":20,"s":"أبلغ ضبيعة كهلها ووليدها","r":"437304","v":[["1EE7F30F-3314-547E-B8DB-9CABF40FC692","أَبلِغ ضُبيعَةَ كَهلَها وَوَليدَها","وَالحَربُ تَنبو بِالرِجالِ وَتَضرِسُ"],["C2E04CE7-0716-57A7-869B-57031DE74EF7","القَومُ آتُوكُم بِأَرعَنَ جَحفَلٍ","حَنِقينَ إِلاّ تَفرِسوهُم تُفرَسوا"],["1656A808-53AD-513B-9E02-D2548BBD9945","خَيرٌ مِنَ القَومِ العُصاةِ أَميرَهُم","يا قومِ فَاِستَحيوا النِساءُ الجُلَّسُ"],["BE95401C-A19C-5B3B-9264-490B5609FCD1","ما إِن أزَالُ أَذُبُّ عَنكُم كاشِحاً","قَد كادَ مِن حَنَقٍ بِسَمٍّ يَقلِسُ"],["4DED79A2-05CB-5A41-B39A-35D535B1A0E7","أَتقَولُ هُم مَنَعوا حَنيفَةَ حَقَّهُم","بَعدَ الكَفالَةِ وَالتَوَثُّقِ أَم نَسوا"],["A5F1F943-A386-5632-A156-27D9AF0E21B2","لَم يَعلَموا أَن قَد مَشى حَذَرَ الخَزى","بِالسَيفِ لِلمَوتِ اِبنُ بَدرَةَ بَيهَسُ"]]},"5EEE9309-1C07-5783-AFF9-9ABEF6EA16C6":{"t":"أعاذل إِن المرء رهن مصيبة","p":20,"s":"أعاذل إن المرء رهن مصيبة","r":"437306","v":[["9B55E64C-31AF-5B42-995E-83F3188BDE87","أَعاذِلُ إِنَّ المَرءَ رَهنُ مُصيبَةٍ","صَريعٌ لِعافي الطَيرِ أَو سوفَ يُرمَسُ"],["AA9CD0B4-D365-53A4-9EBD-755706E6A3A6","فَلا تَقبَلَن ضَيماً مَخافَةَ ميتَةٍ","وَموتَن بِها حُرّاً وَجِلدُكَ أَملَسُ"],["E6E0A941-52AF-5047-A7E3-AC80501F6113","فَما الناسُ إِلاّ ما رَأَوا وَتَحَدَّثوا","وَما العَجزُ إِلا أَن يُضاموا فَيَجلِسُوا"],["98609789-FE35-5458-8E11-5288498C55CA","فَمِن طَلَبِ الأَوتارِ ما حَزَّ أَنفَهُ","قَصيرٌ وَخاضَ المَوتَ بِالسَيفِ بَيهَسُ"],["C6E5D219-A099-59E2-A754-963A680C8696","نَعامةُ لَمّا صَرَّعَ القَومُ رَهطَهُ","تَبَيَّنَ في أثَوابِهِ كَيفَ يَلبَسُ"],["E4B8F5CE-00B6-5477-96E9-B33C6FF93962","أَلَم تَرَ أَنَّ الجونَ أصبحَ راسِياً","تُطيفُ بِهِ الأَيامُ ما يَتَأَيَّسُ"],["9248E117-4BE6-57F3-A1C8-FF0B5F2C92D3","عَصى تُبَّعاً أَيّامَ أُهلِكَتِ القُرى","يُطانُ عَلى صُمِّ الصَفِحِ وَيُكلَسُ"],["91C7411E-EE76-57ED-AC5F-98ED26E540A5","هَلُمَّ إِلَيها قَد أُثيرَت زُروعُها","وَعادَت عَليها المَنجَنونُ تَكَدَّسُ"],["D09E6A63-462E-52F3-BA77-3FB7DB71EF21","وَذاكَ أَوانُ العِرضِ حَيَّ ذُبابُهُ","زَنابيرُهُ وَالأَزرَقُ المُتَلَمِّسُ"],["6724F3F8-D16A-5FE1-8768-F4E6DC1681E9","فَإِن يُقبِلوا بِالوُدِّ نُقبِل بِمِثلِهِ","وَإِلاّ فَإِنّا نَحنُ آبى وَأشمَسُ"],["F1E0EE68-DEA0-5EF2-A455-ADB9A4F84033","وَجَمعُ بَني قُرّانَ فَاِعرِض عَلَيهِمِ","فَإِن يَقبَلوا هاتا الَّتي نَحنُ نُوبَسُ"],["9FE44D7F-7BB6-5E01-B9A9-DC72A6A45353","يَكونُ نَذيرٌ مِن وَرائِيَ جُنَّةً","وَيَمنَعُني مِنهُم جُلَيٌّ وَأَحمَسُ"],["4D494E7E-29F6-52DE-BF12-FF7ECBC2A9BB","فَإِن يَكُ عَنّا في حُبَيبٍ تَثاقُلٌ","فَقد كانَ فينا مِقنَبٌ ما يُعَرِّسُ"]]},"33A70720-BE83-59CF-824F-C2DB0A1B2102":{"t":"ألا أبلِغا أفناء سعدِ بن مالكٍ","p":20,"s":"ألا أبلغا أفناء سعد بن مالك","r":"437284","v":[["A0769E9B-81C0-535A-84D4-366B6FED4931","أَلا أَبلِغا أَفناءَ سَعدِ بنِ مالِكٍ","رِسالَةَ مَن قَد صارَ في الغُربِ جانِبُه"]]},"DF2E793C-9377-5326-A904-306A511C9117":{"t":"ألك السدير وبارِق","p":20,"s":"ألك السدير وبارق","r":"437313","v":[["B6394850-C1FF-50EF-8B27-15C44A873926","أَلَكَ السَديرُ وَبارِقٌ","وَمُبائِضٌ وَلَكَ الخَوَرنَق"],["34623DD2-A9EF-5332-9675-A57310BEA1A0","وَالقَصرُ ذو الشُرُفاتِ مِن","سِندادَ وَالنَخلُ المُبَسَّق"],["01B9C602-1FCB-5B4F-9F1F-1BE5125ADE52","وَالغَمرُ ذو الأَحَساءِ وَال","لَذّاتُ مِن صاعٍ وَدَيسَق"],["D0B9F6F2-6932-56FC-82E5-FDC4C21CDC15","وَالثَعلَبِيَّةُ كُلُّها","وَالبَدوُ مِن عانٍ وَمُطلَق"],["8730DE23-6719-5815-8F31-12ED4CD0B4F5","وَتَظَلُّ في دُوّامَةِ ال","مَولودِ يُظلَمُها تَحَرَّق"],["6A809062-367E-5EA8-82A6-34EB8D89CD3B","فَلَئِن تَعِش فَليَبلُغَن","أَرماحُنا مِنكَ المُخَنَّق"],["63C6F0A8-2000-5ABE-BA3B-146E251E7247","أَبقَت لَنا الأَيامُ وَال","لَزَباتُ وَالعانِيِ المُرَهَّق"],["49980DA5-F16D-5352-9126-EB8F89AF3E68","جُرداً بِأَطنابِ البُيو","تِ تُعَلُّ مِن حَلَبٍ وَتُغبَق"],["B9E8C094-F766-5217-8E3E-9EE4CD68D300","وَمُثَقَّفاتٍ ذُبَّلاً","حُصداً أَسِنَّتُها تَأَلَّق"],["10755267-8C51-5A59-9F46-CD107283563D","وَالبَيضَ وَالزَغفَ المُضا","عَفَ سَردُهُ حَلَقٌ مُوَثَّق"],["529CBCAB-0820-5429-BCBD-01404C90F363","وَصَوارِماً نَعصى بِها","فِيها لَنا حِصنٌ وَمَلزَق"],["F318320F-860F-584F-91E0-B2A8BBAF1453","وَمَحَلَّةً زَوراءَ في","حافاتِها العِقبانُ تَخفِق"],["BE3BCDD9-4AA8-535E-AD0D-B15183DBD3A0","وَإِذا فَزِعتَ رَأَيتَنا","حَلَقاً وَعادِيَةً وَرَزدَق"],["FF120D1B-E51A-5592-88D6-7ECB3DB39611","ما لِلُّيوثِ وَأَنتَ جا","مِعُها بِرَأيِكَ لا تُفَرَّق"],["3C31C077-08E8-5720-9D1D-B1C34A4B95AF","وَالظُلمُ مَربوطٌ بِأَف","نِيَةِ البُيوتِ أَغَرُّ أَبلَق"]]},"56A3D19C-6467-5725-8A78-7BCAC2B69587":{"t":"أيها السائلي فإِني غريب","p":20,"s":"أيها السائلي فإني غريب","r":"437325","v":[["7A4E9C4A-97E2-5288-9769-850357BE912A","أَيُّها السَائلي فَإِنّي غَريبٌ","نازِحٌ عَن مَحَلَّتي وَصَمِيمي"]]},"ACDE2FE4-5AA4-586A-9252-5C78A6142F4D":{"t":"أَخوك الذي إِن رِبتَه قال إِنما","p":20,"s":"أخوك الذي إن ربته قال إنما","r":"437283","v":[["038CD4B6-9556-5105-A279-8998B9144BE0","أَخوكَ الَّذي إِن رِبتَهُ قالَ إِنَّما","أَرِبتُ وَإِن لايَنتَهُ لانَ جانِبُه"]]},"13585F46-55A7-578D-9DD1-09C5BFE59618":{"t":"أَنت مثبور غوِي مترف","p":20,"s":"أنت مثبور غوي مترف","r":"437281","v":[["7C118EA2-B91C-5040-B73C-DD2BDE0EE50C","أَنتَ مَثبورٌ غَوِيٌ مُترَفٌ","ذو غَواياتٍ وَمَسرورٌ بَطِرُ"]]},"09F3BBB5-360D-5863-871B-D02FCB7E4323":{"t":"إن الحبيبة حبها لم ينفد","p":20,"s":"إن الحبيبة حبها لم ينفد","r":"437290","v":[["A679D69E-EF08-50A7-9383-75989C66EF50","إِنَّ الحَبيبَةَ حُبُّها لَم يَنفَدِ","وَاليَأسُ يُسلي لَو سَلَوتَ أَخادَدِ"],["21568B92-2957-5236-B711-41B87D1E8031","قَد طالَ ما أَحبَبتَها وَوَدِدتَها","لَو كانَ يُغني عَنكَ طولُ تَوَدُّدِ"],["277EC2ED-E6D3-5AC2-A8F1-A0D544C4C40D","إنَّ العِراقَ وَأَهلَهُ كانُوا الهَوى","فَإِذا نَأى بي وُدُّهُم فَليَبعُدِ"],["6C0513A9-9D2E-56D1-AE61-8BDBC04666A1","فَلتَترُكَنَّهُمُ بِلَيلٍ ناقَتي","تَذَرُ السِماكَ وَتَهتَدي بِالفَرقَدِ"],["1E6D221D-83D8-52FF-8E16-1CBAB1124928","تَعدو إِذا وَقَعَ المُمَرُّ بِدَفِّها","عَدوَ النَحوصِ تَخافُ ضيقَ المَرصَدِ"],["C562992F-A995-54FE-8F0D-4A3783D750D9","أُجُدٌ إِذا اِستَنفَرتُها مِن مَبرَكٍ","حُلِبَت مَغابِنُها بِرُبٍّ مُعقَدِ"],["AA5663BB-9767-5087-AE60-201398ED7167","وَإِذا الرِكابُ تَواكَلَت بَعدَ السُرى","وَجَرى السَرابُ عَلى مُتونِ الجَدجَدِ"],["1C628A15-50E3-57FE-8AE4-EBDEE5792DFE","مَرِحَت وَطاحَ المَروُ مِن أَخفافِها","جَذبَ القَرينَةِ لِلنَجاءِ الأَجرَدِ"],["B11758C5-AA2D-5269-9739-9B8A4EF9BE50","لِبِلادِ قَومٍ لا يُرامُ هَدِيُّهُم","وَهَدِيُّ قَومٍ آخَرينَ هُوَ الرَدِي"],["6FF44030-3578-5BBA-A35E-57AB73A874E1","كَطُرَيفَةَ بنِ العَبدِ كانَ هَدِيَّهُم","ضَربوا قَذالَةَ رَأسِهِ بِمُهَنَّدِ"],["EED9A6A7-FD88-55C1-B49A-26BA8E0FD183","وَاِبنى أُمامَةَ قَد أَخَذتَ كِلَيهِما","وَإِخالُ أنَّكَ ثالِثٌ بِالأَسوَدِ"],["CE256752-6A9A-545D-9E96-6896E19663B0","إِنَّ الخيانَةَ وَالمَغالَةَ وَالخَنا","وَالغَدرَ أَترُكُهُ بِبَلدَةِ مُفسِدِ"],["BA59915C-45B7-598F-AF59-13A5B5D6BC30","مَلِكٌ يُلاعِبُ أُمَّهُ وَقَطِينَها","رِخوَ المَفاصِلِ أيرُهُ كالمِروَدِ"],["9E4CC6DB-AA1D-563B-BD5D-E659137F046C","بِالبابِ يَطلُبُ كُلَّ طالِبِ حاجَةٍ","فَإِذا خَلا فَالمَرءُ غَيرُ مُسَدَّدِ"],["C29803A1-1EFC-582C-B7C2-CB5B54B62F59","فَإِذا حَلَلتُ وَدونَ بَيتَي غاوَةٌ","فَاِبرُق بِأَرضِكَ ما بَدا لَكَ وارعُدِ"],["4E1AD83B-4EAC-5629-AB83-32AF632639F7","أَبَني قِلابَةَ لَم تَكُن عاداتُكُم","أَخذَ الدَنِيَّةِ قَبلَ خُطَّةِ مِعضَدِ"],["8CA71A75-E87D-56BA-B121-DA61B971A7B2","لَن يَرحَضَ السَوءاتَ عن أَحسابِكُم","نَعَمُ الحَواثِرِ إِذ تُساقُ لِمَعبَدِ"],["57D3AC2A-BDA1-5120-8576-1C636EC9C7FF","فَالعَبدُ عَبدُكُمُ اِقتُلوا بِأَخيكُمُ","كالعَيرِ أَعرَضَ جَنبَهُ لِلمِطرَدِ"]]},"E439DE13-8C5B-5217-8AB0-B137753A2ADF":{"t":"إن الهوان حمار القوم يعرِفه","p":20,"s":"إن الهوان حمار القوم يعرفه","r":"437291","v":[["2601E210-3BAD-5FF1-A1C6-BBF436AFE9E8","إِنَّ الهَوانَ حِمارُ القَومِ يَعرِفُهُ","والحُرُّ يُنكِرُهُ والرَّسلَةُ الأُجُدُ"],["5E12D3DF-FA6C-536A-B57E-55CF42F8A2FD","كونوا كَبَكرٍ كَما قَد كانَ أَوَّلُكُم","وَلا تَكونوا كَعَبدِ القَيسِ إِذ قَعَدوا"],["F391767E-8C8A-5F6E-B3E8-73AB633869DD","يُعطونَ ما سُئِلوا وَالخَطُّ مَنزِلُهُم","كَما أَكَبَّ عَلى ذِي بَطنِهِ الفَهَدُ"],["7EA034EA-BFE1-5C64-B06B-B52577872368","وَلَن يُقيمَ عَلى خَسفٍ يُسامُ بِهِ","إِلاّ الأَذَلاّنِ عَيرُ الأَهلِ وَالوَتِدُ"],["2811C0F5-89DE-50CE-9C55-268092D113CD","هَذا عَلى الخَسفِ مَربوطٌ بِرُمَّتهِ","وَذا يُشَجُّ فما يَرثي لَهُ أَحَدُ"],["68DC96C2-55F5-5A30-A21B-82EE17C3AFA5","فَإِن أَقَمتُم عَلى ضَيمٍ يُرادُ بِكُم","فَإِنَّ رَحلي لَكُم وَالٍ وَمُعتَمَدُ"],["03F604CC-A0F1-5BD6-8244-956C632423B7","كونوا كَسامَةَ إِذا شَعفٌ مَنازِلُهُ","إِذ قِيلَ جَيشٌ وَجَيشٌ حافِظٌ رَصَدُ"],["83398E4C-F8CB-5091-8FC7-6C5FBC54A022","شَدَّ المَطيَّةَ بِالأَنساعِ فَاِنحَرَفَت","عُرضَ التَنوفَةِ حَتّى مَسَّها النَجَدُ"],["23FB5034-A2BA-509F-A25C-341957B72802","وَفي البِلادِ إِذا ما خِفتَ نائِرَةً","مَشهورَةً عَن وُلاةِ السَوءِ مُبتَعَدُ"]]},"3CADED92-915E-5019-9EBE-DEC536164DD0":{"t":"إِذا جاوزت من ذات عرقٍ ثنية","p":20,"s":"إذا جاوزت من ذات عرق ثنية","r":"437294","v":[["0007FB25-C901-5977-8D06-B0D05CE2E177","إِذا جاوَزَت مِن ذاتِ عِرقٍ ثِنَّيةً","فقُل لأبي قابوسَ ما شِئتَ فارعُدِ"]]},"327564E5-5E55-5BB2-86E4-BAB930E21D5E":{"t":"إِلى كل قوم سلم يرتقى به","p":20,"s":"إلى كل قوم سلم يرتقى به","r":"437311","v":[["CB9F2040-812C-54B2-B8E4-C2502A909874","إِلى كُلِّ قَومٍ سُلَّمٌ يُرتَقَى بِهِ","وَلَيسَ إِلَينا في السَلاليمِ مَطلَعُ"],["24F6BA0E-0A44-538D-9FD3-4E5916E7760E","وَيَهرُبُ مِنّا كُلُّ وَحشٍ وَيَنتَهي","إِلى وَحشِنا وَحشُ الفَلاةِ وَيَرتَعُ"]]},"8A8826C2-E826-562D-9EC4-5C47D9A417B2":{"t":"إِني كساني أبو قابوس مرفلة","p":20,"s":"إني كساني أبو قابوس مرفلة","r":"437309","v":[["82A138E9-41E6-5A8D-96EA-4E7B31A4FF0F","إِنّي كَساني أَبو قابوسَ مُرفَلَةً","كَأَنَّها سَلخُ أَبكارِ المَخارِيطِ"]]},"1F907A16-E774-5004-9F98-88FDE650CAB5":{"t":"إِني لقطاع اللبانة والهوى","p":20,"s":"إني لقطاع اللبانة والهوى","r":"437302","v":[["037164A9-EC17-5CF6-8AA7-FA89EBA04DC8","إِنّي لَقَطّاعُ اللُبانَةِ وَالهَوى","إِذا ما حِبالُ الغانِياتِ تَلَبَّسُ"],["C4A7FE80-9BBF-53F4-A4AD-80AA4CA68D34","وَأَدماءَ مِن حُرِّ الهِجانِ كَأَنَّها","بِحُرِّ الصَريمِ نابِىءٌ مُتَوَجِّسُ"],["675E3E43-6C1D-5B92-9BBD-DD624BE2EF42","لَهُ جُدَدٌ سودٌ كَأَنَّ أَرَندَجاً","بِأَكرُعِهِ وَبِالذِراعَينِ سُندُسُ"],["2ADAAEA0-CAF6-5395-BF13-464B6E908FBD","وَبِالوَجهِ دِيباجٌ وَفَوقَ سَراتِهِ","دَيابوذَةٌ وَالرَوقُ أَسحَمُ أَملَسُ"],["FD79914B-F306-5C33-AFBF-3497A4D98E30","يَجولُ بِذي الأَرطى كَأَنَّ سَراتَهُ","كَبَرقٍ نَزيعٍ وَالسَحابَةُ تَرجُسُ"],["56AD2148-0C16-5524-BA70-A3DBF4300FA9","فَباتَ إِلى أَرطاةِ حِقفٍ كَأَنَّما","إِلى دَفِّها مِن آخِرِ اللَيلِ مُعرِسُ"],["7DB015A1-603B-5B4A-8F18-5CF4990307F7","إِلى رَبِّها قَيسٍ تَروحُ وَتَغتَدي","فَلا فَرِحٌ قَيسٌ وَلا مُتَعَبِّسُ"],["3AED9222-7943-560F-BDBD-2CBB2B99C25E","تَناوَلَني مِن أَرضِهِ وَسَمائِهِ","بِرَحبِ ذِراعٍ ماجِدٌ مُتَأَنِّسُ"],["685FA376-D05D-5CE3-B444-D709275C3BC4","إِذا بَلَغَت قَيسَ اليَمانِيَّ ناقَتي","فَأَيَّ خَليلٍ بَعدَ قَيسٍ تَلَمَّسُ"],["0FA4D7DE-5EBB-5709-93E5-DA6F2A430136","لَعَمري لَنِعمَ المَرءُ قَيسٌ إِذا اِنتَهى","إِلى بابِهِ راجٍ لَهُ لَيسَ يَحبِسُ"]]},"09C614B1-EDA9-5A28-BBFB-D2A4C57C87A4":{"t":"إِنّ شر الناس من يكشر لي","p":20,"s":"إن شر الناس من يكشر لي","r":"437322","v":[["FF93CF63-95E2-55E2-A655-DBAB504C7989","إِنَّ شَرَّ الناسِ مَن يَكشِرُ لي","حينَ أَلقاهُ وَإِن غِبتُ شَتَم"]]},"83949C30-4717-575F-8C59-2212B28160FC":{"t":"تعيرني سلمى وليس بقضأة","p":20,"s":"تعيرني سلمى وليس بقضأة","r":"437321","v":[["EBAD96F6-B7F2-5B76-9619-A683C4ED97D2","تُعَيِّرُني سَلمى وَلَيسَ بِقُضأَةٍ","وَلو كُنتَ مِن سَلمى تَفَرَّعتَ دارِما"]]},"52D0B24D-55D8-5CB2-8678-C0D449841290":{"t":"تفرق أَهلي من مقيمٍ وظاعنٍ","p":20,"s":"تفرق أهلي من مقيم وظاعن","r":"437310","v":[["5964EDE8-EE89-56BC-921A-F4EF3B0A4295","تَفَرَّقَ أَهلي مِن مُقيمٍ وَظاعِنٍ","فَلِلَّهِ دَرّي أَيَّ أَهلِيَ أَتبَعُ"],["1BE6B9FF-EF2B-5A78-84FC-54356E0304F0","أَقامَ الَّذينَ لا أُبالي فِراقَهُم","وَشَطَّ الَّذينَ بَينَهُم أَتَوقَّعُ"],["5247EF43-AF27-53FE-B8B3-31A40AC1C70C","عَلى كُلِّهِم آسَى وَلِلأَصلِ زُلفَةٌ","فَزَحزِح عَنِ الأَدنَينَ أَن يَتَصَدَّعوا"],["DCF9E151-4E84-5AF1-9F0D-E098DA28B7A5","وَفارَقَ أَهلي أَهلَ عَوفِ بنِ عامرٍ","وَكانَت خَوى عَوفٍ قَديماَ تَطَلَّعُ"],["CD5D8985-8A9D-59D2-BD7C-53FED496398D","قَضَى اِبنُ مُعاذٍ مَرَّةً دونَ قَومهِ","بِعَيبٍ وَأَمري ما يَكادُ يُجَمَّعُ"],["DEB179B4-F520-53DE-BAFA-E988D80369E3","أَمَرتُهمُ أَمري بمُنعَرَجِ الِلوى","وَلا أَمرَ لِلمَعصِيِّ إلاّ مُضَيَّعُ"],["AC187FB9-1207-5FAA-90EF-0C2630B5B8DE","أَلِكني إِلى قَومي ضُبَيعَةَ إِنَّهُم","أُناسي فَلومُوا بَعدَ ذَلِكَ أَو دَعُوا"],["D461ECFE-A2DA-5B1C-87F6-9D848A6C744B","وَقَد كانَ أَخوالي كَريماً جِوارُهُم","وَلَكِنَّ أَصلَ العودِ مِن حَيثُ يُنزَعُ"],["45AB4279-7332-5909-80D0-409D9ABACF20","فَلا تَحسِبَنّي خاذِلاً مُتَخَلِّفاً","وَلا عَينُ صَيدٍ مِن هَوايَ وَلَعلَعُ"],["4F329CB9-F729-5359-A981-AA5C6EBA1146","وَلَكِنَّني أَغرَبتُ في جَيشِ طَوَّسٍ","وَكَانَت مَعَدٌّ كُلَّ أَوبٍ تَصَدَّعُ"]]},"0E1A9C61-7A21-5426-A4ED-C718A9C43997":{"t":"جزاني أخو لخمٍ على ذات بينِنا","p":20,"s":"جزاني أخو لخم على ذات بيننا","r":"437286","v":[["A47FE85B-9DCF-5351-B6D2-03C158488475","جَزاني أَخو لَخمٍ عَلى ذاتِ بَينِنا","جَزاءَ سِنمارَ وَما كانَ ذا ذَنبِ"]]},"8F8ABBA2-C0FB-506D-81F7-3D5670BE26E4":{"t":"خليلي إِما مت يوماً وزحزِحت","p":20,"s":"خليلي إما مت يوما وزحزحت","r":"437296","v":[["5E5EBDC8-E6E0-5090-A11F-14B23D4E2A9E","خَليلَيَّ إِمّا مُتُّ يَوماً وَزُحزِحَت","مَناياكُما فيما يُزَحزِحُهُ الدَهرُ"],["BE7B797B-4599-562A-AF8B-2C60792C8696","فَمُرّا عَلى قَبري فَقُوما فَسَلِّما","وَقُولا سَقاكَ الغَيثُ وَالقَطرُ يا قَبرُ"],["91C95D63-A306-512F-9316-30F7935B2170","كَأَنَّ الَّذي غَيَّبتَ لَم يَلهُ ساعَةً","مِنَ الدَهرِ وَالدُنيا لَها وَرَقٌ نَضرُ"],["C1A66259-26CE-55BD-9CB6-C15DE5C07AFA","وَلَم تَسقِهِ مِنها بِعَذبٍ مُمَتِّعٍ","بَرُودٍ حَمَتهُ القَومَ رَجراجَةٌ بِكرُ"],["353D432E-1071-5733-AF23-E95384405050","وَلَم يَصطَبِح في يَومِ حَرٍّ وَقِرَّةٍ","حُمَيّا فَدَبَّت في مَفاصلِهِ الخَمرُ"],["363A3347-57D4-5BA0-8A4D-BF272D3D3D7D","وَلَم يَرُعِ العِيسَ الكَوانِسَ بالضُحى","بِأَسرارِ مَولِيٍّ أَلِدَّتُهُ صُفرُ"],["C723DDBE-F8C2-59D6-8F7E-B2EB912DC059","لَسَسنَ بُقولَ الصَيفِ حَتّى كَأَنَّما","بِأَلسُنِها مِن لَسِّ حُلَّبِها الصَقرُ"],["9D72262F-4A08-5DBB-A3D3-B85DCD966104","وَلَم يَمدَحِ القَرمَ الهُمامَ بِكَفِّهِ","لَطائِمُ يُسقَى مِن فَواضِلِها القَفرُ"],["4F3B7A9D-E836-51F6-9571-E44BE242E6CA","رَمى نَحوَهُ في الناسِ وَالناسُ حَولَهُ","وَذو يَسرَةٍ عِلبٌ مَناكِبُهُ سُعرُ"],["03C677D3-02C8-5F05-B896-11B34BFE7093","وَمَأطورَةٌ شَدَّ العَسيفانِ أَطرَها","إِساراً وَأَطراً فَاِستَوى الأَطرُ وَالأَسرُ"],["F9717B3F-8F72-5445-A649-D9657DA442DB","تُرامِقُهُ المِقلادُ حَتّى تَمَكَّنَت","إلَيهِ طَوالَ البابِ مَرَّدَهُ الجَدرُ"],["7983F7AC-9F0F-5951-8B8C-3F7E4A9A4E08","فَخافَ وَقَد حَلَّت لَهُ مِن فُؤادِهِ","مَحَلَّ جَليلِ الشَأنِ قَدَّمَهُ الأَمرُ"]]},"C8033ADB-2DE1-588E-9EC7-23C18C819703":{"t":"سر قد أنى لك أيها المتحوس","p":20,"s":"سر قد أنى لك أيها المتحوس","r":"437300","v":[["4525E8F8-789F-5C81-82D0-86A1B039D31F","سِر قَد أَنَى لَكَ أَيُّها المُتَحَوِّسُ","فالدارُ قَد كادَت لِعَهدِكَ تُدرَسُ"]]},"097F5492-E191-58AC-90C1-CB690D769EBD":{"t":"صبا من بعد سلوته فؤادي","p":20,"s":"صبا من بعد سلوته فؤادي","r":"437293","v":[["0C68CFDE-AFF2-5189-85B9-0E7FFE6D08F9","صَبا مِن بَعدِ سَلوَتِه فُؤادي","وأَسمَحَ لِلقَرينَةِ بِاِنقيادِ"],["69298636-9AD9-5EFF-94E4-54B91BDDECF9","كَأَنّي شارِبٌ يَومَ اِستَبَدُّوا","وَحَثَّ بِهِم لَدَى المَوماةِ حادِ"],["E5011552-63A5-57AF-B4F8-CFAE47B8333F","عُقاراً عُتِّقَت في الدَنِّ حَتّى","كَأَنَّ حَبابَها حَدَقُ الجَرادِ"],["7E8EF9EE-9A43-57DE-A1EE-7269D8038F80","جَمادِ لَها جَمادِ وَلا تَقولي","لَها أَبَداً إِذا ذُكِرَت حَمادِ"],["01239590-34B3-5A13-88EB-CAA6798CCFD3","فَإِمّا حُبُّها عَرَضاً وَإِمّا","بَشاشَةُ كُلِّ عِلقٍٍ مُستَفادِ"],["658D06D9-4F9B-5B58-BE41-01AF7DFC67A7","وَأَعلَمُ عِلمَ حَقٍّ غَيرَ ظَنٍّ","وَتَقوى اللَهِ مِن خَيرِ العَتادِ"],["EBF47792-41AC-5BBE-BE68-81F2C9EB9E74","لَحِفظُ المالِ أيسَرُ مِن بُغاهُ","وَسَيرٍ في البِلادِ بِغَيرِ زادِ"],["8B341857-E87D-56AD-8040-F05785517D72","وَإِصلاحُ القَليلِ يَزيدُ فيهِ","وَلا يَبقَى الكَثيرُ مَعَ الفَسادِ"]]},"7CA8D5CB-0FB4-564A-B103-327AE42169B7":{"t":"عرفت لأِصحاب النجائب حدة","p":20,"s":"عرفت لأصحاب النجائب حدة","r":"437315","v":[["4C2CAEF9-78AF-5468-91C5-CBA8B19901D0","عَرَفتُ لأَِصحابِ النَجائِبِ حِدَّةً","إِذا عَرفوا لي في العُصورِ الأَوائِلِ"]]},"ACB70083-D4A3-54D7-A493-92A8BDAF755B":{"t":"عصاني فما لاقى الرشاد وإِنما","p":20,"s":"عصاني فما لاقى الرشاد وإنما","r":"437289","v":[["10F53025-CB63-5DA0-A0FC-7FEB2CF8773A","عَصاني فَما لاقَى الرَشادَ وَإِنَّما","تَبَيَّنَ مِن أَمرِ الغَوِيِّ عَواقِبُه"],["C5891ADC-B232-55F9-B621-18D13C126F6D","فَأَصبَحَ مَحمولاً عَلى ظَهرِ أَلَّةٍ","يَمُجُّ نَجِيعَ الجَوفِ مِنهُ تَرائِبُه"],["042B51FC-10CD-5CF7-8890-128C24856685","فَإِلاّ تَجلَّلَها يُعالوكَ فَوقَها","وَكيفَ تَوَقَّى ظَهرَ ما أَنتَ راكِبُه"]]},"63C97F94-E0AE-5703-8530-110ACCF21E5E":{"t":"فاجتاب أرطاة فلاذ بدفئها","p":20,"s":"فاجتاب أرطاة فلاذ بدفئها","r":"437301","v":[["984E54ED-B74C-5110-BE39-08D91A68FA64","فَاِجتَابَ أَرطاةً فَلاذَ بِدِفئِها","والعَينُ بِالجَونِ المِثالِيَ تَرجُسُ"]]},"2182154C-69C1-5B51-8F49-F3BD0B3F590C":{"t":"فبهراً لمن غرت صحيفة منذرٍ","p":20,"s":"فبهرا لمن غرت صحيفة منذر","r":"437297","v":[["7E915E11-3920-50AC-9192-95E27DCE3976","فَبَهراً لِمَن غَرَّت صَحيفَةُ مُنذِرٍ","وَإِن كانَ عَقدٌ مِنهُمُ مُتَظاهِرُ"],["4D07E70D-E8ED-5EAC-8F89-6C55F96FE0BA","لَقَد كانَ فيكُم لَو وَفَيتُم لِجارِكُم","لِحىً وَرِقابٌ عَردَةٌ وَمَناخِرُ"]]},"C9092F08-12D2-5F06-BB58-F2FB8EB7EE19":{"t":"فكأنما هي من تقادم عهدها","p":20,"s":"فكأنما هي من تقادم عهدها","r":"437298","v":[["93832002-FC55-59EA-8533-58755F9DC71B","فَكَأَنَّما هِيَ مِن تَقادُمِ عَهدِها","رِقٌ أُتيحَ كِتابُها مَسطورُ"]]},"9DB7177B-1A86-5425-8982-C392455DAEF0":{"t":"فلو أن محموماً بخيبر مدنفاً","p":20,"s":"فلو أن محموما بخيبر مدنفا","r":"437288","v":[["36F539DF-24DE-53BB-B255-BD8D773EDAFF","فَلَو أَنَّ مَحموماً بِخَيبَرَ مُدنَفاً","تَنَشَّقَ رَيّاها لَأَقلَعَ صالِبُه"]]},"044D205B-3B06-5013-BACC-82C9ACA1AD5D":{"t":"قلت لقومي حين جاء اِبن مالك","p":20,"s":"قلت لقومي حين جاء ابن مالك","r":"437319","v":[["09AF3B0B-1DFA-5861-BA88-084A547A13DF","قُلتُ لِقَومي حينَ جاءَ اِبنُ مالِكٍ","خُذوا حَقَّكُم مِن عُجبِها المُتَقَسَّمِ"],["F69EC821-7D13-504B-9D9F-4FC6B11CA7DC","وَإِنّي لَأَحميها وَأُعطي رِقابَها","وَأَمنَعُها وَالخَيلُ تَعثُرُ بِالدَمِ"]]},"133B6F45-61B9-515C-B0CD-B42C7C5FB9A4":{"t":"قليتك فاقليني فلا وصل بيننا","p":20,"s":"قليتك فاقليني فلا وصل بيننا","r":"437287","v":[["8E12B29C-2943-5F3A-87AE-094FF24BF854","قَلَيتُكِ فَاِقلِيني فَلا وَصلَ بَينَنا","كَذَلِكَ مَن يَستَغنِ يَستَغنِ صاحِبُه"],["78F4440C-270B-53B2-9A87-E18F3CD3530F","خَليلٌ بَدا لي النُّصحُ مِنهُ فَلَم أَكُن","لِأَصرِمَهُ ما سَوَّغَ الماءَ شارِبُه"],["8BDFDAF6-9DD6-5F64-AAF4-E34C1131E23C","عَصاني فَما لاقى الرَشادَ وَإِنَّما","تَبَيَّنُ عَن أَمرِ الغَوِيِّ عَواقِبُه"],["A6D1AA78-2989-5C11-B2CB-DDCBDDF9B760","عَصاني فَما لاقى الرَشادَ وَإِنَّما","تَبَيَّنُ عَن أَمرِ الغَوِيِّ عَواقِبُه"]]},"5DB04C28-D150-5C50-A201-10B07E8E400F":{"t":"كأنما لونها والصبح منقشع","p":20,"s":"كأنما لونها والصبح منقشع","r":"437307","v":[["A4EFE2C9-E8E7-56F1-8A63-CF00AD13DE95","كَأَنَّما لَونُها وَالصُبحُ مُنقَشِعٌ","قَبلَ الغَزالَةِ أَلوانُ الحَماطيطِ"]]},"EA13780E-B142-5CD2-A7D7-EC228190324C":{"t":"لسنا كمن حلت إياد دارها","p":20,"s":"لسنا كمن حلت إياد دارها","r":"437295","v":[["E9375569-574F-526A-BD0F-A9E7DED0E95B","لَسنا كَمَن حَلَّت إيادٌ دارَها","تَكريتَ تَنظُرُ حَبَّها أَن يُحصَدا"]]},"BD24773F-407F-5825-8E52-EBE15A29423A":{"t":"لعلك يوماً أن يسرك أنني","p":20,"s":"لعلك يوما أن يسرك أنني","r":"437282","v":[["945C359C-68D9-5B0A-8129-FB9AF57D13B5","لَعلَّكَ يَوماً أَن يَسُرَّكَ أَنَّني","شَهِدتُ وَقد رَمَّت عِظاميَ في قَبري"],["1AC1D7F8-B2D4-51D6-947E-3AD15DA6A16F","فتُصبِحُ مَظلوماً تُسامُ دَنِيَّةً","حَريصاً عَلى مِثلي فَقيراً إِلى نَصري"],["2D52A010-BEC8-5D9E-9154-2651C9B52938","وَيَهجُرُكَ الإِخوانُ بَعدي وَتُبتَلى","وَيَنصُرُني مِنكَ المَليكُ فَلا تَدرِي"],["7D700BF0-6E86-5F23-B9BF-CD0869E7E651","وَلَو كُنتُ حَيّاً قَبلَ ذَلِكَ لَم تُرَم","لَهُ خُطَّةٌ خَسفاً وَشووِرتَ في الأَمرِ"]]},"20C604E2-3822-5AE0-8235-52CC0563A99B":{"t":"لكنه حوض من أودى بإِخوته","p":20,"s":"لكنه حوض من أودى بإخوته","r":"437292","v":[["859F1CFC-7A05-5D84-A10D-5E9686B1D345","لَكِنَّهُ حَوضُ مَن أَودَى بِإِخوَتِهِ","رَيبُ المَنُونِ فَأَضحَى بَيضَةَ البَلَدِ"],["98419ED3-716F-5BB5-89C9-77DB58E1D40D","لَو كانَ يُشكى إلى الأَمواتِ ما لَقِيَ ال","أَحياءُ بَعدَهُمُ مِن شِدَّةِ الكَمَدِ"],["60462264-050A-5743-8931-FB6DD70070D5","ثُمَّ اِشتَكَيتُ لَأَشكاني وَساكِنُهُ","قَبرٌ بِسِنجارَ أَو قَبرٌ عَلى قَهَدِ"]]},"670FC1C1-8E63-5A57-9E17-95A35399C1AC":{"t":"لم يرجعوا من خشية الموت والرّدى","p":20,"s":"لم يرجعوا من خشية الموت والردى","r":"437285","v":[["BB9FA8F1-F92E-519E-9A75-6710517E0AC4","لَم يَرجِعوا مِن خَشيَةِ المَوتِ وَالرَّدى","وَقَد جَلَبَتها مِن بَعيدٍ جَوالِبُ"],["3CF4C575-8B33-579D-98F0-AF9593473F6B","سَيَمنَعُها مِن أَن تَرُدَّ حَفيظَةً","فَوارِسُ صَعبٍ وَالكُماةُ مُحَارِبُ"]]},"F54485E3-7045-562E-B66F-92F6D52DABA2":{"t":"محبوكة حبكت منها نمانمها","p":20,"s":"محبوكة حبكت منها نمانمها","r":"437308","v":[["361859D8-AE82-5E05-A82E-DAA4CE94C0A3","مَحبوكَةً حُبِكَت مِنها نَمانِمُها","مِنَ المُدَمقَسِ أَو مِن فاخِرِ الطُوطِ"]]},"D7796AE7-3750-587F-9755-208CF16AE289":{"t":"من الدارِمِيين الذين دماؤهم","p":20,"s":"من الدارميين الذين دماؤهم","r":"437318","v":[["EA0C2A0B-95CC-5D69-B49E-51514F423DD4","مِنَ الدارِمِيِّينَ الَّذينَ دِماؤَهُمُ","شِفاءٌ مِنَ الداءِ المَجَنَّةِ وَالخَبلِ"]]},"67DC26DB-3DD1-565E-864B-1B4CE581A73B":{"t":"من مبلغ الشعراء عن أخويهِم","p":20,"s":"من مبلغ الشعراء عن أخويهم","r":"437299","v":[["F8771286-1838-5029-9BE1-7E8A66E5120D","مَن مُبلِغُ الشُعَراءِ عَن أَخَوَيهِمَ","خَبَراً فَتَصدُقَهُم بِذاكَ الأَنفُسُ"],["E5D4F4E8-BBFF-569A-86CF-6B3333A816C2","أَودَى الَّذي عَلِقَ الصَحيفَةَ مِنهُما","وَنَجا حِذارَ حِبائِهِ المُتَلَمِّسُ"],["A26F52E8-FF95-5D0F-A2F5-856DFFA509C1","أَلقَى صَحيفَتَهُ وَنَجَّت كورَهُ","عَنسٌ مُداخِلَةُ الفَقارَةِ عِرمِسُ"],["92FF9139-F34A-5B2E-A936-65DFFECA9E22","عَنسٌ إِذا ضَمَرَت تَعَزَّزَ لَحمُها","وَإِذا تُشَدُّ بِنِسعِها لا تَنبِسُ"],["9C171875-BFDF-50CB-8937-4E1A0CD4A097","وَجناءُ قد طَبَخَ الهَواجِرُ لَحمَها","وَكَأَنَّ نُقبَتَها أَديمٌ أَملَسُ"],["B7D8D378-67E7-5B04-9F6E-5E52D02284BB","وَتَكادُ مِن جَزَعٍ يَطيرُ فؤادُها","إِن صاحَ مُكَّاءُ الضُحى مُتَنَكِّسُ"],["801503F0-62ED-5689-8F72-7A53D516B649","أَلقِ الصَحيفَةَ لا أبَا لَكَ إِنَّهُ","يُخشى عَلَيكَ مِنَ الحِباءِ النِقرِسُ"],["DAD8D6BD-D92A-5D49-BB90-3E68AC443674","وَعَلِمتُ أَنّي قَد مُنِيتُ بِنَيطَلٍ","إِذ قيلَ كانَ مِن آلِ دَوفَنَ قَومَسُ"],["E630F7C1-FCA9-5922-B596-302F9A34FF8A","وَفَرَرتُ خَشيَةَ أَن يَكونَ حِباؤُهُ","عاراً يُسَبُّ بهِ قَبيليَ أَحمَسُ"],["9FBB87B4-9743-5F13-9100-12FF34AE066D","وَتَرَكتُ حَيَّ بَني ضُبَيعَةَ خَشيَةً","أَن يُوتَروا بِدَمي وَجِلدِيَ أَملَسُ"],["F986A06B-4505-506E-806F-CE7154FE7530","ثَكِلَتكَ يا اِبنَ العَبدِ أُمُّكَ سادِراً","أَبِساحَةِ المَلِكِ الهُمامِ تَمَرَّسُ"]]},"8B106C33-1ECF-54F9-B6F1-14E9504392A5":{"t":"وألقيتها في الثني من جنب كافرٍ","p":20,"s":"وألقيتها في الثني من جنب كافر","r":"437317","v":[["0B313DBD-FF1C-55F1-81C3-6BE6B73537EF","وَأَلقَيتُها في الثِنيِ مِن جَنبِ كافِرٍ","كَذلِكَ أَقنو كُلَّ قِطٍّ مُضَلِّلِ"],["14834515-35B2-5E29-82A6-43EBF981CB45","رَمَيتُ بِها حَتّى رَأيتُ مِدادَها","يَطوفُ بِها التَيّارُ في كُلِّ جَدوَلِ"]]},"F67CA289-EDAA-5C54-A2B3-B3A77C8CCBF8":{"t":"وعليه من لأم الكتائب لأمة","p":20,"s":"وعليه من لأم الكتائب لأمة","r":"437305","v":[["B7B7B440-F7CE-5A4F-B3CA-354962C79F9D","وَعَليهِ مِن لَأمِ الكَتائِبِ لَأمَةٌ","فَضفاضَةٌ فيما يَقومُ وَيَجلِسُ"]]},"F9FA345F-EABD-536B-9393-8783DDD8AEB2":{"t":"وقد أتناسى الهم عند اِحتضارِه","p":20,"s":"وقد أتناسى الهم عند احتضاره","r":"437324","v":[["BC34AB28-5CEE-5C3E-8AAA-8235FC4D4420","وَقَد أَتَناسى الهَمَّ عِندَ اِحتِضارِهِ","بِناجٍ عَلَيهِ الصَيعَرِيَّةُ مُكدَمِ"],["CA29D873-E3F7-5DFF-A852-1495389FC7A8","كُمَيتٍ كِنازِ اللَحمِ أَو حِميَرِيَّةٍ","مُواشِكَةٍ تَنفي الحَصَى بِمُلَثَّمِ"],["3A6892B8-4669-5062-A82A-915394AEED12","كَأَنَّ عَلى إِنسائِهِ عِذقَ خَصبَةٍ","تَدَلَّى مِنَ الكافورِ غَيرَ مُكَمَّمِ"]]},"9481942F-215C-514E-B9CB-036E808256F4":{"t":"ومستنبح تستكشف الريح ثوبه","p":20,"s":"ومستنبح تستكشف الريح ثوبه","r":"437323","v":[["19E2F6F4-2182-5B6B-B407-F426C320AE27","وَمُستَنبحٍ تَستَكشِفُ الريحُ ثَوبَهُ","لِيَسقُطَ عَنهُ وَهوَ بالثَوبِ مُعصِمُ"],["51B2E707-2E75-52D9-B68D-1771F9D83F29","عَوى في سَوادِ الَليلِ بَعدَ اِعتِسافِهِ","لِيَنبَحَ كَلبٌ أَو لِيوقِظَ نُوَّمُ"],["FD8010A7-1B11-5AC1-922F-0DA7435EB29E","فَجاوَبَهُ مُستَسمِعُ الصَوتِ لِلنَّدى","لَهُ عِندَ إِتيانِ المُحِبِّينَ مَطَعُم"],["A0CB94DD-5469-5D3F-B07D-7286F57E91DA","يَكادُ إِذا ما أَبصَرَ الضَيفَ مُقبِلاً","يُكَلِّمُهُ مِن حُبِّهِ وَهوَ أَعجَمُ"]]},"B5318BD7-219E-5276-9063-179E657F82B8":{"t":"ومن يبغ أَو يسعى على الناس ظالماً","p":20,"s":"ومن يبغ أو يسعى على الناس ظالما","r":"437326","v":[["62CF558E-1798-55DB-AAF9-2CBB82984C52","وَمَن يَبغِ أَو يَسعى عَلى الناسِ ظالِماً","يَقَع غَيرَ شَكٍّ لِليَدينِ وَلِلفَمِ"]]},"C69D28CB-0F0F-5F92-843C-97927B991749":{"t":"يا آل بكرٍ أَلا للَّه أُمكم","p":20,"s":"يا آل بكر ألا لله أمكم","r":"437303","v":[["870863AB-179F-5D7B-B2EF-C3CBF90FA95C","يا آلَ بَكرٍ أَلا لِلَّهِ أُمُّكُمُ","طالَ الثَواءُ وَثَوبُ العَجزِ مَلبُوسُ"],["809F8029-32AD-54E6-9570-A76172183786","أَغنَيتُ شَأني فَأَغنوا اليَومَ شَأنَكُمُ","وَاِستَحمِقوا في مِراسِ الحَربِ أَو كيسوا"],["2968D79D-ACB9-5E7E-BE73-0ADED9577DF2","إِنَّ عِلافاً وَمَن بِاللَوذِ مِن حَضَنٍ","لَمّا رَأَوا أنَّهُ دينٌ خَلابيسُ"],["321CA86B-5B7F-5AEF-A579-9C3BD94B5402","شَدُّوا الجِمالَ بِأَكوارٍ عَلى عَجَلٍ","والظُلمُ يُنكِرُهُ القَومُ المَكاييسُ"],["BB376615-21FF-5985-BD64-67212DCD7931","كانوا كَسامَةَ إِذ شَعفٌ مَنازِلُهُ","ثُمَّ اِستَمَرَّت بِهِ البُزلُ القَناعِيسُ"],["4633A9B3-5990-5DF5-A685-F9A45F3E2A8D","حَنَّت قَلوصِي بِها وَاللَيلُ مُطَّرِقٌ","بَعدَ الهُدُوِّ وَشاقَتها النَواقيسُ"],["7A61B0CA-829D-561B-80D2-76127C3D7FFD","مَعقولَةٌ يَنظُرُ التَشريقَ راكِبُها","كَأَنَّها مِن هَوىً لِلرَّملِ مَسلوسُ"],["DDBEDB0C-597A-54AD-BB50-A384920B6E60","وَقد أَلاحَ سُهَيلٌ بَعدَما هَجَعوا","كَأَنَّه ضَرَمٌ بِالكَفِّ مَقبوسُ"],["2F88214C-7A23-565D-AC33-DAA6AB5AF01A","أَنَّى طَرِبتِ وَلَم تُلحَي عَلى طَرَبٍ","وَدونَ إِلفِكِ أَمراتٌ أَماليسُ"],["C040533D-F9F9-5479-896F-0773973DDAA3","حَنَّت إِلى نَخلَةَ القُصوى فَقُلتُ لَها","بَسلٌ عَليكِ أَلا تِلكَ الدَهاريسُ"],["59BF6516-3BC5-5723-94B1-123B3775E6D8","أُمّي شَآمِيَّةً إِذ لا عِراقَ لَنا","قَوماً نَوَدُّهُمُ إِذ قَومُنا شُوسُ"],["00EF70E5-C85C-5139-A513-6304FC6A18BD","لَن تَسلُكي سُبُلَ البَوباةِ مُنجِدَةً","ما عاشَ عَمرٌو وَما عُمِّرتَ قابوسُ"],["FDECF3F8-285C-5686-81D6-52F363E2C036","لَو كانَ مِن آلِ وَهبٍ بَينَنا عُصَبٌ","وَمِن نَذيرٍ وَمِن عَوفٍ مَحاميسُ"],["3F25AA2C-6AFF-5824-8902-EF18F2D08D4B","أَودى بِهِم مَن يُراديني وَأَعلَمُهُم","جُودَ الأَكُفِّ إِذا ما اِستَعسَرَ البوسُ"],["8E3C7263-F9F7-5DE9-8385-0CA76E23E4FC","يا حارِ إني لَمِن قَومٍ أولي حَسَبٍ","لا يَجهلون إِذا طاشَ الضَغابِيسُ"],["5A6C98D9-B589-5FF1-B494-B1277813FEC8","آلَيتَ حَبَّ العِراقِ الدَهرَ أَطعَمُهُ","وَالحَبُّ يَأكلُهُ في القَريَةِ السوسُ"],["AC1204D8-789C-5B37-8B3A-495DF03850C8","لَم تَدرِ بُصرى بِما آلَيتَ مِن قَسَمٍ","وَلا دِمَشقُ إِذا ديسَ الكَداديسُ"],["66338318-F1E6-58E2-AB6D-88576C6FD084","عَيَّرتُموني بِلا ذَنبٍ جِوارَكُمُ","هَذا نَصيبٌ مِنَ الجِيرانِ مَحسوسُ"],["E09DC330-86DB-51E0-B590-2ED2803F57CA","فَإِن تَبَدَّلتُ مِن قَومي عَدِيَّكُمُ","إِنِّي إِذاً لَضَعيفُ الرَأيِ مَألوسُ"],["D6D0CC58-6D48-59B7-9296-5A5B1933FA38","كَم دونَ أَسماءَ مِن مُستَعمَلٍ قَذَفٍ","وَمِن فَلاةٍ بِها تُستَودَعُ العيسُ"],["ED53E1B9-20C1-543D-8C9F-AC78B15FB3AF","وَمِن ذُرَى عَلَمٍ ناءٍ مَسافَتُهُ","كَأنَّهُ في حَبابِ الماءِ مَغموسُ"],["294297AB-79D8-55ED-8BCA-2864444E3828","جاوَزتُهُ بِأَمُونٍ ذاتِ مَعجَمَةٍ","تَنجو بِكَلكَلِها وَالرَأسُ مَعكوسُ"]]},"92594CD1-735E-5FBD-A55F-19540CE27CBF":{"t":"يعيرني أمي رِجال ولا أَرى","p":20,"s":"يعيرني أمي رجال ولا أرى","r":"437312","v":[["9E8B77E0-9D01-5483-B663-01FD99BCF337","يُعيِّرُني أمِّي رِجالٌ ولا أَرى","أَخا كَرَمٍ إلِاّ بِأَن يَتَكَرَّما"],["883EAF94-1FED-5D25-A66A-87F539D63C32","وَمَن كانَ ذا عِرضٍ كَريمٍ فَلم يَصُن","لَهُ حَسَباً كانَ اللَئيمَ المُذَمَّما"],["93ED8DBE-64EA-5B2E-B254-E270A7BC0527","أَحارِثُ إِنّا لَو تُشاطُ دِماؤُنا","تَزَيَّلنَ حَتّى لا يَمَسَّ دَمٌ دَما"],["8CA5D9FC-85C7-5B01-BCDF-8AE946F5181B","أَمُنتَقِلاً مِن آلِ بُهثَةَ خِلتَني","أَلا إِنَّني مِنهُم وَإِن كُنتُ أَينَما"],["97AC98DE-DF20-5451-AA9A-54BE6A10D8CC","أَلا إنَّني مِنهُم وَعِرضِيَ عِرضَهُمُ","كَذي الأَنفِ يَحمي أَنفَهُ أَن يُكَشَّما"],["135AE7B4-AA13-565A-A643-FA1D73709261","وَإِنَّ نِصابي إِن سَألتَ وَأُسرَتي","مِنَ الناسِ حَيٌّ يَقتَنونَ المُزَنَّما"],["BF91D4AD-240C-5666-A806-48F2773F9ED2","وَكُنّا إِذا الجَبّارُ صَعَّرَ خَدَّهُ","أَقَمنا لَهُ مِن مَيلِهِ فَتَقَوَّما"],["E881793F-819F-5FF0-A3A4-04C4AFAE15BB","إِذا اِختَلَفَت يَوماً رَبيعَةُ صادَفَت","لَنا حَكَماً عَدلاً وَجَيشاً عَرَمرَما"],["5DFF201E-E086-5ED8-84F9-9D92E21ECBF9","لِذي الحِلمِ قَبلَ اليَومِ ما تُقرَعُ العَصا","وَما عُلِّمَ الإِنسانُ إِلا لِيَعلَما"],["D4C2E203-E63E-5B70-A539-A737A8607EC9","وَلو غَيرُ أَخوالي أَرادوا نَقيصَتي","جَعَلتُ لَهُم فَوقَ العَرانينِ ميسَما"],["2DEC0E1C-55A0-5597-AA2D-AB2AF54AE609","وَهَل لِيَ أُمٌّ غَيرُها إِن تَرَكتُها","أَبَى اللَهُ إِلاّ أَن أَكونَ لَها اِبنَما"],["4166850B-154E-57B7-BE25-E7DA54D18F05","وَما كُنتُ إِلا مِثلَ قاطِعِ كَفِّهِ","بِكَفٍّ لَهُ أُخرى فَأَصبَحَ أَجذَما"],["B3C3D881-7E6A-596E-992B-8D687BAB8B31","فَلَمّا اِستَقادَ الكَفَّ بِالكَفِّ لَم يَجِد","لَهُ دَرَكاً في أَن تَبِينا فَأَحجَما"],["2BD1E4EE-A916-51D7-9C80-48662B490918","يَداهُ أَصابَت هَذِهِ حَتفَ هذهِ","فَلَم تَجِدِ الأُخرى عَلَيها مُقَدَّما"],["84549658-06CE-5A9A-93FF-803F6574C84E","فَأَطرَقَ إِطراقَ الشُجاعِ وَلو يَرَى","مَساغاً لِنابَيهِ الشُجاعُ لَصَمَّما"],["37A0EB2D-41D3-5F4D-B99F-AA797ABC3994","وَقَد كُنتُ أَرجو أَن أَكونَ لِعَقبِهِم","زَنيماً فَما أُجرِرتُ أَن أَتَكَلَّما"],["D894B602-5B6A-5781-B591-1FBA29F59EE1","لِأُورِثَ بَعدي سُنَّةً يُقتَدَى بِها","وَأَجلوَ عَن ذي شُبهَةٍ أَن تَوَهَّما"],["95EF7EB7-310B-58D6-9FA2-2A5C2BB8AA8D","أَرى عُصَماً مِن نَصرِ بُهثَةَ دانِياً","وَيَدفَعُني عَن آلِ زَيدٍ فَبِئسَما"],["E54AA3E2-2DDD-55E4-9515-24F331AD5B84","إِذا لَم يَزَل حَبلُ القَرينَينِ يَلتَوي","فَلا بُدَّ يَوماً مِن قُوىً أَن تُجَذَّما"],["C9AA6391-A15B-52D6-8213-AA42C51F7AFA","إِذا ما أَديمُ القَومِ أنَهَجَهُ البِلَى","تَفَرَّى وَإِن كَتَّبتَهُ وَتَخَرَّما"]]}}}