{"v":1,"poems":{"6254F8C4-811D-58D2-842D-0CD08A555FC6":{"t":"وفاؤكما كالربع أشجاه طاسمه","p":124,"s":"وفاؤكما كالربع أشجاه طاسمه","r":"447614","v":[["3E133711-D8FB-5B0F-9D9B-B71DC4005FF4","وَفاؤكُما كالرَّبْع أشْجاهُ طاسمه","بأنْ تُسعِدا والدّمْعُ أشفاهُ ساجِمُهْ"],["0ECE8933-43E3-59D3-82D0-F4806553D447","وما أنَا إلاّ عاشِقٌ كلُّ عَاشِقٍ","أعَقُّ خَليلَيْهِ الصّفِيّينِ لائِمُهْ"],["F57EA8B1-528D-5C7D-B509-678994D588C1","وقَدْ يَتَزَيّا بالهَوَى غَيرُ أهْلِهِ","ويَستَصحِبُ الإنسانُ مَن لا يُلائمُهْ"],["7C8CCB85-5F86-5F3A-AE51-A468C1A461E1","بَليتُ بِلى الأطْلالِ إنْ لم أقِفْ بها","وُقوفَ شَحيحٍ ضاعَ في التُّرْبِ خاتمُهْ"],["939D1BC6-5DAC-5F4F-8797-952AAE257F9B","كَئيباً تَوَقّاني العَواذِلُ في الهَوَى","كمَا يَتَوَقّى رَيّضَ الخَيلِ حازِمُهْ"],["81B00F74-0A54-585B-B313-CD9E1BE3A861","قِفي تَغرَمِ الأولى من اللّحظِ مُهجتي","بثانِيَةٍ والمُتْلِفُ الشّيْءَ غارِمُهْ"],["22D37458-4891-51AB-8AE8-A39AE8453D2D","سَقاكِ وحَيّانَا بكِ الله إنّمَا","على العِيسِ نَوْرٌ والخدورُ كمائِمُهْ"],["5C7483D1-811B-5D01-8F2B-57D21C54B96F","وما حاجةُ الأظعانِ حَوْلَكِ في الدّجى","إلى قَمَرٍ ما واجدٌ لكِ عادِمُهْ"],["C8325DA0-150E-56B0-9F37-0DBD4BECA422","إذا ظَفِرَتْ منكِ العُيونُ بنَظرَةٍ","أثابَ بها مُعيي المَطيّ ورازِمُهْ"],["715F2857-641A-54E3-BEE1-8E51DC16E6A0","حَبيبٌ كأنّ الحُسنَ كانَ يُحِبّهُ","فآثَرَهُ أوْ جارَ في الحُسنِ قاسِمُهْ"],["28E5C25D-FCC1-5C94-8EF1-D9674FBA5C0C","تَحُولُ رِماحُ الخَطّ دونَ سِبائِهِ","وتُسبَى لَهُ منْ كلّ حَيٍّ كرائِمُهْ"],["7D9A73C9-563B-561C-B122-8687819322BA","وَيُضْحي غُبارُ الخَيلِ أدنَى سُتُورِهِ","وآخِرُها نَشْرُ الكِباءِ المُلازِمُهْ"],["CA3DCB43-5185-51FF-810D-89336DC5C5F7","وما اسْتَغْرَبَتْ عَيني فِراقاً رأيْتُهُ","ولا عَلّمَتْني غَيرَ ما القلبُ عالمُهْ"],["BBDA1C0B-3059-540F-938D-9E0EF976DD11","فَلا يَتَّهِمْني الكاشِحونَ فإنّني","رَعَيتُ الرّدى حتى حَلَتْ لي علاقمُهْ"],["6774E418-9504-5EDF-A600-DD191F4CCCA4","مُشِبُّ الذي يَبكي الشّبابَ مُشيبُهُ","فكَيفَ تَوَقّيهِ وبانِيهِ هادِمُهْ"],["B0420BD4-E636-5E30-9E0F-A21F029130F7","وتَكْمِلَةُ العَيشِ الصِّبا وعَقيبُهُ","وغائِبُ لَوْنِ العارِضَينِ وقادِمُهْ"],["F08AA8A5-CE64-5199-A956-E89288251A60","وما خَضَبَ النّاسُ البَياضَ لأنّهُ","قَبيحٌ ولكِنْ أحْسَنُ الشَّعرِ فاحِمُهْ"],["2426181D-852C-5DE5-854F-83F49BADFE67","وأحسَنُ مِنْ ماءِ الشّبيبَةِ كُلّهِ","حَيَا بارِقٍ في فازَةٍ أنا شائِمُهْ"],["724D90EC-9CE9-5775-8CB0-2C318096138A","عَلَيها رِياضٌ لم تَحُكْها سَحابَةٌ","وأغصانُ دَوْحٍ لمْ تُغَنِّ حَمَائِمُهْ"],["5CADE7EA-3DE8-5E45-9C16-F0D4848441B2","وفَوْقَ حَواشي كلّ ثَوْبٍ مُوَجَّهٍ","من الدُّرّ سِمْطٌ لم يُثَقّبْهُ ناظِمُهْ"],["C7B937FA-59D7-556F-86D8-B3E6E6AEE73A","تَرَى حَيَوانَ البَرّ مُصْطَلِحاً بِهِ","يُحارِبُ ضِدٌّ ضِدَّهُ ويُسالِمُهْ"],["577227EA-34DF-5541-8C52-6F0DDBF889F6","إذا ضَرَبَتْهُ الرّيحُ ماجَ كَأنّهُ","تجولُ مَذاكيه وتَدأى ضَراغِمُهْ"],["4ECF0BEB-608A-5B26-BC9B-2B90A7C88F38","وفي صورةِ الرّوميّ ذي التّاجِ ذِلّةٌ","لأبْلَجَ لا تيجانَ إلاّ عَمائِمُهْ"],["15E5BFC9-535C-50B2-8927-4E91CFD0239E","تُقَبّلُ أفْواهُ المُلُوكِ بِساطَهُ","ويَكْبُرُ عَنها كُمُّهُ وبَراجِمُهْ"],["D2DD6058-B4A9-51A3-A6B8-390822472AF7","قِياماً لمَنْ يَشفي مِنَ الدّاءِ كَيُّهُ","ومَن بَينَ أُذْنَيْ كلّ قَرْمٍ مَواسمُهْ"],["5F6003EF-5DD7-5F69-8575-EE57138C4AD9","قَبائِعُها تَحْتَ المَرافِقِ هَيْبَةً","وأنْفَذُ ممّا في الجُفُونِ عَزائِمُهْ"],["D372318C-35A0-59AD-ABA4-980FE99D59E2","لَهُ عَسكَرَا خَيْلٍ وطَيرٍ إذا رَمَى","بها عَسكَراً لم يَبقَ إلاّ جَماجمُهْ"],["107C7A0E-277E-592D-BA22-EF80B375EF98","أجِلّتُها مِنْ كلّ طاغٍ ثِيابُهُ","ومَوْطِئُها مِن كلّ باعٍ مَلاغمُهْ"],["DBD28449-2661-53E6-93C2-8F652E796E02","فَقَدْ مَلّ ضَوْءُ الصّبْحِ ممّا تُغيرُهُ","ومَلّ سَوادُ اللّيلِ ممّا تُزاحِمُهْ"],["77894D53-9093-5827-9BCF-AA35F0C6AA47","ومَلّ القَنَا ممّا تَدُقّ صُدورَهُ","ومَلّ حَديدُ الهِنْدِ ممّا تُلاطِمُهْ"],["EE4B5E70-5CDF-534F-8C5A-F47C57AF58F7","سَحابٌ مِنَ العِقبانِ يزْحَفُ تحتَها","سحابٌ إذا استَسقتْ سقتها صَوارِمُهْ"],["6C63A9A0-2565-5B78-A326-08300481D8F9","سلَكتُ صُروفَ الدّهرِ حتى لقيتُهُ","على ظَهرِ عَزْمٍ مُؤيَداتٍ قَوائِمُهْ"],["873CC49F-70DC-5B65-A5DB-0B09A0E00F0E","مَهالِكَ لم تَصْحَبْ بها الذئبَ نَفسُه","ولا حَمَلَتْ فيها الغُرابَ قَوادِمُهْ"],["919D2D3B-F9F7-58B0-A375-D98AD6C42AA1","فأبصَرْتُ بَدراً لا يَرَى البدرُ مِثْلَهُ","وخاطَبْتُ بحْراً لا يرى العِبرَ عائِمُهْ"],["7E128523-B89B-551D-A3FD-42E2D07F2718","غَضِبْتُ لَهُ لمّا رَأيْتُ صِفاتِهِ","بلا واصِفٍ والشِّعرُ تهذي طَماطِمُهْ"],["D20D2259-1D7C-54CA-AF75-224A148BB341","وكنتُ إذا يَمّمْتُ أرضاً بَعيدَةً","سرَيتُ فكنْتُ السرّ واللّيلُ كاتمُهْ"],["7C443B08-20BF-5966-AD4D-1081515F9A6B","لقد سَلّ سيفَ الدّولَةِ المَجدُ مُعلَماً","فلا المَجدُ مخفيه ولا الضّرْبُ ثالمُهْ"],["2C719140-4796-594C-B0D7-1471C26A1EE3","على عاتِقِ المَلْكِ الأغَرِّ نِجادُهُ","وفي يَدِ جَبّارِ السّماواتِ قائِمُهْ"],["076CE32C-5663-5BFC-8262-9A4B1D2F93D7","تُحارِبُهُ الأعداءُ وهْيَ عَبيدُهُ","وتَدّخِرُ الأمْوالَ وهْيَ غَنائِمُهْ"],["CCF071EA-49B3-5928-AC75-8D6EF4A830A2","ويَستَكبرُونَ الدّهرَ والدّهْرُ دونَهُ","ويَستَعظِمونَ المَوتَ والموْتُ خادمُهْ"],["9F2B6B3D-65EA-541F-B35E-96DC5644ACB5","وإنّ الذي سَمّى عَلِيّاً لَمُنْصِفٌ","وإنّ الذي سَمّاهُ سَيفاً لَظالمُهْ"],["00271308-6237-5ECC-933E-BABA64D6512F","وما كلُّ سَيفٍ يَقْطَعُ الهَامَ حَدُّهُ","وتَقْطَعُ لَزْباتِ الزّمانِ مَكارِمُهْ"]]},"52DF5A5B-50AD-5EB6-8391-2EC3B1E85871":{"t":"ومنتسب عندي إلى من أحبه","p":124,"s":"ومنتسب عندي إلى من أحبه","r":"447542","v":[["68D3078D-98B4-5777-9AAE-824C343B3FC7","ومُنْتَسِبٍ عِندي إلى مَنْ أُحِبّهُ","وللنَّبْلِ حَوْلي مِن يَدَيهِ حَفيفُ"],["4493AE9A-72EC-50CB-A72F-D189277BC3FA","فَهَيّجَ مِنْ شَوْقي وما من مَذَلّةٍ","حَنَنْتُ ولَكِنّ الكَريمَ ألُوفُ"],["80035AA2-4A16-56DC-A843-223AD2318FBE","وكلُّ وِدادٍ لا يَدومُ على الأذَى","دَوامَ وِدادي للحُسَينِ ضَعيفُ"],["05AC740F-8931-5528-AEE8-B01414EDDC00","فإنْ يكُنِ الفِعْلُ الذي ساءَ واحِداً","فأفْعالُهُ اللائي سَرَرْنَ أُلُوفُ"],["179E3572-C88D-5FE2-9584-71C12F4138DE","ونَفْسي لَهُ نَفْسي الفِداءُ لنَفْسِهِ","ولكِنّ بَعضَ المالِكينَ عَنيفُ"],["DEAAEB3C-C999-5D5B-A97C-02A331601B11","فإنْ كانَ يَبغي قَتْلَها يَكُ قاتِلاً","بكَفّيهِ فالقَتْلُ الشّريفُ شريفُ"]]},"6FD05FFB-E343-5014-BEE4-1E304820CDDF":{"t":"ومنزل ليس لنا بمنزل","p":124,"s":"ومنزل ليس لنا بمنزل","r":"447594","v":[["9C8E8359-CA2A-53FB-AFFC-ED7F0841C3FF","ومَنْزِلٍ لَيسَ لَنَا بمَنْزِلِ","ولا لغَيرِ الغَادِياتِ الهُطَّلِ"],["570C3265-6B34-593D-87A5-88DDB19DB0FE","نَدِيْ الخُزامَى أذْفَرِ القَرَنْفُلِ","مُحَلَّلٍ مِلْوَحْشِ لم يُحَلَّلِ"],["DCFE3CA4-942D-5868-83C9-0241797B143C","عَنّ لَنا فيهِ مُراعي مُغْزِلِ","مُحَيَّنُ النّفسِ بَعيدُ المَوْئِلِ"],["B98F5FAE-2750-5087-BCE9-052400E60E66","أغناهُ حُسنُ الجيدِ عن لُبسِ الحلي","وعادَةُ العُرْيِ عَنِ التّفَضّلِ"],["D4FD6215-F2E9-5E85-A21B-CE5C27C2C491","كأنّهُ مُضَمَّخٌ بصَنْدَلِ","مُعْتَرِضاً بمِثْلِ قَرْنِ الأيّلِ"],["C7E4A66D-4271-5549-BC00-EAEC8AB13FA1","يَحُولُ بَينَ الكَلْبِ والتأمّلِ","فَحَلَّ كَلاّبي وِثَاقَ الأحْبُلِ"],["B48C7661-F904-51B9-B9FD-C5910EA026C7","عَن أشْدَقٍ مُسَوْجَرٍ مُسَلسَلِ","أقَبَّ ساطٍ شَرِسٍ شَمَرْدَلِ"],["A26F8BF4-8B51-5974-BB5C-1040DD8B7E3D","مِنْها إذا يُثْغَ لَهُ لا يَغْزَلِ","مُؤجَّدِ الفِقْرَةِ رِخْوِ المَفْصِلِ"],["64D1E8BD-E427-5A6A-A051-29931E7A2834","لَهُ إذا أدْبَرَ لَحْظُ المُقْبِلِ","كأنّما يَنظُرُ مِنْ سَجَنْجَلِ"],["0DEB1780-E02A-59C1-82D0-A61D149E0B98","يَعْدو إذا أحْزَنَ عَدْوَ المُسْهِلِ","إذا تَلا جَاءَ المَدى وقَدْ تُلي"],["733AF2C4-6ABC-50D7-95B3-93EB0849F429","يُقْعي جُلُوسَ البَدَويّ المُصْطَلي","بأرْبَعٍ مَجْدولَةٍ لَمْ تُجْدَلِ"],["90F5917B-7E6B-58F0-924B-6641E83FBAE1","فُتْلِ الأيادي رَبِذاتِ الأرْجُلِ","آثارُها أمْثالُها في الجَنْدَلِ"],["4CEC11FB-2467-5079-88CC-6BCD74A6EA55","يَكادُ في الوَثْبِ مِنَ التّفَتّلِ","يَجْمَعُ بينَ مَتْنِهِ والكَلْكَلِ"],["450C2D03-72AB-572E-A821-34BECD5936CE","وبَينَ أعْلاهُ وبَينَ الأسْفَلِ","شَبيهُ وسْميّ الحِضارِ بالوَلي"],["7F1618FE-F671-5097-9400-A316ED440BAF","كأنّهُ مُضَبَّرٌ مِنْ جَرْوَلِ","مُوَثَّقٌ على رِماحٍ ذُبّلِ"],["CDC32971-59C3-58BE-8557-935792E17696","ذي ذَنَبٍ أجْرَدَ غَيرِ أعْزَلِ","يخطّ في الأرْضِ حسابَ الجُمّلِ"],["2F711762-E275-5EAF-8DB1-A42CFAF0263C","كأنّهُ مِنْ جِسْمِهِ بمَعْزِلِ","لوْ كانَ يُبلي السّوْطَ تحريكٌ بَلي"],["8F1A0FD1-A4E3-5B0E-944A-821FE2DACD30","نَيلُ المُنى وحُكمُ نَفسِ المُرْسِلِ","وعُقْلَةُ الظّبي وحَتفُ التَّتفُلِ"],["7EA202AB-5D7E-595C-89C5-56719E09EFAE","فانْبَرَيا فَذيّنِ تحتَ القَسطَلِ","قَد ضَمِنَ الآخِرُ قَتلَ الأوّلِ"],["A9A95363-517E-53F3-A9EB-487334D56EE2","في هَبوَةٍ كِلاهُما لم يَذْهَلِ","لا يأتَلي في تَرْكِ أنْ لا يأتَلي"],["29F98221-504F-5E85-80C7-86FAF81D3E88","مُقْتَحِماً على المَكانِ الأهْوَلِ","يخالُ طُولَ البحرِ عَرْض الجدولِ"],["A783CCB3-33A5-5EF0-BE9C-B265C2361BD5","حتى إذا قِيلَ لهُ نِلْتَ افْعَلِ","إفْتَرّ عن مَذرُوبَةٍ كالأنْصُلِ"],["0F3BF88F-B41B-516B-8B53-AC91483B8BE7","لا تَعْرِفُ العَهدَ بصَقلِ الصّيقلِ","مُرَكَّباتٍ في العَذابِ المُنْزَلِ"],["4DB544CB-999B-58E0-969F-E7E305ADCD9A","كأنّها من سُرْعَةٍ في الشّمْألِ","كأنّها مِنْ ثِقَلٍ في يَذْبُلِ"],["38117DBD-7BEF-52BF-A554-A49686A0F339","كأنّها مِن سَعَةٍ في هَوْجَلِ","كأنّهُ مِنْ عِلْمِهِ بالمَقتَلِ"],["9A8B4353-962B-581F-8E98-40CE5A7E1A9F","عَلّمَ بُقْراطَ فِصادَ الأكْحَلِ","فَحالَ ما للقَفْزِ للتَجَدّلِ"],["6F40323C-D069-5B2C-9AD9-453D01BB31B1","وصارَ ما في جِلْدِهِ في المِرْجَلِ،","فلم يَضِرْنا مَعْهُ فَقدُ الأجدَلِ"],["ECFA71F6-3C6E-5C6B-B5C1-5CF8E6FD6AE2","إذا بَقيتَ سالماً أبَا عَلي","فالمُلْكُ لله العَزيزِ ثُمّ لي"]]},"484A9032-4AAA-5A27-A024-AF813A489E77":{"t":"ووقت وفى بالدهر لي عند سيد","p":124,"s":"ووقت وفى بالدهر لي عند سيد","r":"447511","v":[["35BB9781-CC76-5269-87DE-5EEA043AA052","وَوَقْتٍ وَفَى بالدّهْرِ لي عندَ سَيّدٍ","وَفَى لي بأهْليهِ وزادَ كَثِيرَا"],["7D66408D-E3F7-5069-8A34-D07870514FA8","شرِبْتُ على استِحْسانِ ضَوْءِ جَبينِهِ","وزَهْرٍ تَرَى للماءِ فيهِ خَريرَا"],["750ED40C-8C00-539E-8AFC-4C5F04D5896E","غَدَا النّاسُ مِثْلَيْهِمْ به لاعدمتهُ","وأصْبَحَ دَهْري في ذَراهُ دُهُوراً"]]},"B537F131-6922-5454-8E3E-64553A601FCE":{"t":"يؤمم ذا السيف آماله","p":124,"s":"يؤمم ذا السيف آماله","r":"447573","v":[["1DA50603-2B87-501B-95F9-C35C92FC7993","يُؤمِّمُ ذا السّيفُ آمَالَهُ","وَلا يَفْعَلُ السّيفَ أفْعَالَهُ"],["A4005B6C-BED4-512F-A865-BE76ED7BB54A","إذا سارَ في مَهْمَهٍ عَمَّهُ","وَإنْ سارَ في جَبَلٍ طَالَهُ"],["3363E075-E14D-595D-8315-17FC3FCA8127","وَأنْتَ بِمَا نُلْتَنَا مَالِكٌ","يُثَمرُ مِنْ مَالِهِ مَالَهُ"],["5B1EB5DE-01FF-5DEC-B4CD-187268151D26","كأنّكَ ما بَيْنَنَا ضَيْغَمٌ","يُرَشِّحُ للفَرْسِ أشْبَالَهُ"]]},"E5FCF535-4C2D-5568-A465-F8066B19ACC9":{"t":"يا أخت خير أخ يا بنت خير أب","p":124,"s":"يا أخت خير أخ يا بنت خير أب","r":"441509","v":[["114641D0-7448-5098-AA79-FB183C419127","يا أُخْتَ خَيرِ أخٍ يا بِنْتَ خَيرِ أبِ","كِنَايَةً بهِمَا عَنْ أشرَفِ النّسَبِ"],["68E489C8-A895-5A2B-902E-CDA0B057B77E","أُجِلُّ قَدْرَكِ أنْ تُسْمَيْ مُؤبَّنَةً","وَمَنْ يَصِفْكِ فَقد سَمّاكِ للعَرَبِ"],["45049E5E-A198-5ED8-B749-6FB853B644B5","لا يَمْلِكُ الطّرِبُ المَحزُونُ مَنطِقَه","وَدَمْعَهُ وَهُمَا في قَبضَةِ الطّرَبِ"],["4308884B-B303-5B2A-9CB6-63EEF4283426","غدَرْتَ يا مَوْتُ كم أفنَيتَ من عدَدٍ","بمَنْ أصَبْتَ وكم أسكَتَّ من لجَبِ"],["7A2D5D2E-3538-560B-96CE-E5A7FDA852F8","وكم صَحِبْتَ أخَاهَا في مُنَازَلَةٍ","وكم سألتَ فلَمْ يَبخَلْ وَلم تَخِبِ"],["5F5C673E-9C09-5665-A181-92CAD6D9DAB6","طَوَى الجَزِيرَةَ حتى جاءَني خَبَرٌ","فَزِعْتُ فيهِ بآمالي إلى الكَذِبِ"],["BDED049A-3971-587A-B83A-83A47646A83C","حتى إذا لم يَدَعْ لي صِدْقُهُ أمَلاً","شَرِقْتُ بالدّمعِ حتى كادَ يشرَقُ بي"],["E6F68BF2-3CA2-575D-B0D4-4736683DC85E","تَعَثّرَتْ بهِ في الأفْوَاهِ ألْسُنُهَا","وَالبُرْدُ في الطُّرْقِ وَالأقلامُ في الكتبِ"],["148D7237-B174-5265-B243-F245A4BB64FC","كأنّ فَعْلَةَ لم تَمْلأ مَوَاكِبُهَا","دِيَارَ بَكْرٍ وَلم تَخْلَعْ ولم تَهَبِ"],["EA8BD85F-A3B2-5429-8168-8DE5F20B96EC","وَلم تَرُدّ حَيَاةً بَعْدَ تَوْلِيَةٍ","وَلم تُغِثْ داعِياً بالوَيلِ وَالحَرَبِ"],["2AF698FE-6AE3-5065-B3CA-05D24C9BD917","أرَى العرَاقَ طوِيلَ اللّيْلِ مُذ نُعِيَتْ","فكَيفَ لَيلُ فتى الفِتيانِ في حَلَبِ"],["A8B8CF79-21F2-51A5-8630-52EFF8C2FDF6","يَظُنّ أنّ فُؤادي غَيرُ مُلْتَهِبٍ","وَأنّ دَمْعَ جُفُوني غَيرُ مُنسكِبِ"],["80D8D171-3676-582E-B2A1-58D65864758D","بَلى وَحُرْمَةِ مَنْ كانَتْ مُرَاعِيَةً","لحُرْمَةِ المَجْدِ وَالقُصّادِ وَالأدَبِ"],["8894AD09-B914-58F5-8619-E22283F0EB69","وَمَن مَضَتْ غيرَ مَوْرُوثٍ خَلائِقُها","وَإنْ مَضَتْ يدُها موْرُوثَةَ النّشبِ"],["6EF6EC43-337D-5D3B-A814-EB04691EF94A","وَهَمُّهَا في العُلَى وَالمَجْدِ نَاشِئَةً","وَهَمُّ أتْرابِها في اللّهْوِ وَاللّعِبِ"],["62DDF961-DA77-5384-B33C-3456CAF09287","يَعلَمْنَ حينَ تُحَيّا حُسنَ مَبسِمِها","وَلَيسَ يَعلَمُ إلاّ الله بالشَّنَبِ"],["D8A919BC-370B-5053-87D6-2BB03CE14608","مَسَرّةٌ في قُلُوبِ الطّيبِ مَفِرقُهَا","وَحَسرَةٌ في قُلوبِ البَيضِ وَاليَلَبِ"],["F39B56C1-60FD-5D78-AB0C-4853EAE69B68","إذا رَأى وَرَآهَا رَأسَ لابِسِهِ","رَأى المَقانِعَ أعلى منهُ في الرُّتَبِ"],["9358638B-229C-511E-A094-45632DF11691","وَإنْ تكنْ خُلقتْ أُنثى لقد خُلِقتْ","كَرِيمَةً غَيرَ أُنثى العَقلِ وَالحَسبِ"],["067EED92-A540-5FAE-B5F0-0722FCD343E3","وَإنْ تكنْ تَغلِبُ الغَلباءُ عُنصُرَهَا","فإنّ في الخَمرِ معنًى لَيسَ في العِنَبِ"],["312AE36D-694A-54FC-9777-FB9FF9F90964","فَلَيْتَ طالِعَةَ الشّمْسَينِ غَائِبَةٌ","وَلَيتَ غائِبَةَ الشّمْسَينِ لم تَغِبِ"],["F0F15156-E57B-5B5F-98AC-03CCCB14E816","وَلَيْتَ عَينَ التي آبَ النّهارُ بهَا","فِداء عَينِ التي زَالَتْ وَلم تَؤبِ"],["B45C6769-4300-5545-AA16-D40F9F4B0A5B","فَمَا تَقَلّدَ بالياقُوتِ مُشْبِهُهَا","وَلا تَقَلّدَ بالهِنْدِيّةِ القُضُبِ"],["C3A43E57-55EA-56EB-AB1F-6D096ABA499C","وَلا ذكَرْتُ جَميلاً مِنْ صَنائِعِهَا","إلاّ بَكَيْتُ وَلا وُدٌّ بلا سَبَبِ"],["2E6C340C-3269-559A-BF72-FB3D7C8CBFC8","قَد كانَ كلّ حِجابٍ دونَ رُؤيَتها","فَمَا قَنِعتِ لها يا أرْضُ بالحُجُبِ"],["8AFEDE5A-669D-5C3C-B163-A10FC53319A7","وَلا رَأيْتِ عُيُونَ الإنْسِ تُدْرِكُها","فَهَلْ حَسَدْتِ عَلَيها أعينَ الشُّهبِ"],["5C45E58D-D5EB-5C83-9757-6C2A19D2D319","وَهَلْ سَمِعتِ سَلاماً لي ألمّ بهَا","فقَدْ أطَلْتُ وَما سَلّمتُ من كَثَبِ"],["F05C0F28-6D7F-5089-8B28-0B3113FA56F0","وَكَيْفَ يَبْلُغُ مَوْتَانَا التي دُفِنَتْ","وَقد يُقَصِّرُ عَنْ أحيائِنَا الغَيَبِ"],["11980127-A602-5EC8-8374-471BD8A515B3","يا أحسَنَ الصّبرِ زُرْ أوْلى القُلُوبِ بِهَا","وَقُلْ لصاحِبِهِ يا أنْفَعَ السُّحُبِ"],["80B70B8A-5343-5086-BBB4-415ACCFF1A6C","وَأكْرَمَ النّاسِ لا مُسْتَثْنِياً أحَداً","منَ الكِرامِ سوَى آبَائِكَ النُّجُبِ"],["BE0438E1-ADE8-57FF-B5B1-944CF2205A9A","قد كانَ قاسَمَكَ الشخصَينِ دهرُهُما","وَعاشَ دُرُّهُما المَفديُّ بالذّهَبِ"],["03862BEE-2E5C-54B8-B2A2-B34CEFD42201","وَعادَ في طَلَبِ المَترُوكِ تارِكُهُ","إنّا لَنغْفُلُ وَالأيّامُ في الطّلَبِ"],["B2C153EE-4255-5783-8A25-3E953384E40E","مَا كانَ أقصرَ وَقتاً كانَ بَيْنَهُمَا","كأنّهُ الوَقْتُ بَينَ الوِرْدِ وَالقَرَبِ"],["A1EE51CE-ECC0-593F-BEE1-DBD54F6C93FE","جَزَاكَ رَبُّكَ بالأحزانِ مَغْفِرَةً","فحزْنُ كلّ أخي حزْنٍ أخو الغضَبِ"],["81883B6C-7943-5D2D-9D3F-4067C3B56421","وَأنْتُمُ نَفَرٌ تَسْخُو نُفُوسُكُمُ","بِمَا يَهَبْنَ وَلا يَسخُونَ بالسَّلَبِ"],["F2C747C9-38C5-5DAF-9F78-4B523CD4727D","حَلَلْتُمُ من مُلُوكِ الأرْضِ كلّهِمِ","مَحَلَّ سُمرِ القَنَا من سائِرِ القَصَبِ"],["DF4623BC-D1BA-54F0-A570-455B7C314DF8","فَلا تَنَلْكَ اللّيالي، إنّ أيْدِيَهَا","إذا ضَرَبنَ كَسَرْنَ النَّبْعَ بالغَرَبِ"],["8167CD76-4D2A-56AE-BF88-13C3072319DA","وَلا يُعِنّ عَدُوّاً أنْتَ قاهِرُهُ","فإنّهُنّ يَصِدْنَ الصّقرَ بالخَرَبِ"],["D4E7B7B9-D114-5E2A-9DCA-7023804E8C9E","وَإنْ سَرَرْنَ بمَحْبُوبٍ فجَعْنَ بهِ","وَقَد أتَيْنَكَ في الحَالَينِ بالعَجَبِ"],["92E7B6C5-FC94-5D77-B4A7-BBE4FB793BB1","وَرُبّمَا احتَسَبَ الإنْسانُ غايَتَهَا","وَفاجَأتْهُ بأمْرٍ غَيرِ مُحْتَسَبِ"],["CDB7889A-9D36-52EE-80A5-EDE6800F0532","وَمَا قَضَى أحَدٌ مِنْهَا لُبَانَتَهُ","وَلا انْتَهَى أرَبٌ إلاّ إلى أرَبِ"],["F2BF67EC-D44C-580B-9B6A-6DD574B8B5DE","تَخالَفَ النّاسُ حتى لا اتّفاقَ لَهُمْ","إلاّ على شَجَبٍ وَالخُلفُ في الشجبِ"],["FFEB4E12-5124-5B78-84C5-CCBED993EDFD","فقِيلَ تَخلُصُ نَفْسُ المَرْءِ سَالمَةً","وَقيلَ تَشرَكُ جسْمَ المَرْءِ في العَطَبِ"],["4CDCD2D4-862F-5507-A345-D2350FEA61A9","وَمَنْ تَفَكّرَ في الدّنْيَا وَمُهْجَتهِ","أقامَهُ الفِكْرُ بَينَ العَجزِ وَالتّعَبِ"]]},"EC80AF40-5866-5361-AA5B-BD3587EA1DA2":{"t":"يا أكرم الناس في الفعال","p":124,"s":"يا أكرم الناس في الفعال","r":"447605","v":[["F177AB8A-D331-55E3-8DDC-DADCA4B53C8D","يا أكرَمَ النّاسِ في الفَعالِ","وأفْصَحَ النّاسِ في المَقَالِ"],["9E6E522F-2685-5F7A-8DEC-061703E514F3","إنْ قُلتَ في ذا البَخُورِ سَوْقاً","فهَكَذا قُلتَ في النّوالِ"]]},"14DF2341-A140-5A71-8824-73C77B3673AB":{"t":"يا أيها الملك الذي ندماؤه","p":124,"s":"يا أيها الملك الذي ندماؤه","r":"447563","v":[["8C7CE4CA-9475-5FF7-8582-AAD963D9BBA0","يا أيّها المَلِكُ الذي نُدَماؤهُ","شُرَكاؤهُ في مِلْكِهِ لا مُلكِهِ"],["9EBA7CB1-868D-562E-BD61-6B002C3701C2","في كلّ يَوْمٍ بَيْنَنا دَمُ كَرْمَةٍ","لكَ تَوْبَةٌ من تَوْبَةٍ من سَفكِهِ"],["E88C030C-9854-5B91-A6BD-BD27D9696DD4","والصّدقُ من شيَمِ الكرام فقلْ لنا","أمنَ الشّرابِ تَتوبُ أم من تركِهِ؟"]]},"C204D0AD-5050-51C4-A9FA-872F3D35769D":{"t":"يا بدر إنك والحديث شجون","p":124,"s":"يا بدر إنك والحديث شجون","r":"447664","v":[["3B7FF112-999C-5085-BCDD-EDD673E9FCE5","يا بَدْرُ إنّكَ والحَديثُ شُجُونُ","مَنْ لمْ يَكُنْ لِمثَالِهِ تَكْوِينُ"],["C5EFCBAA-36EB-535A-AABD-D0BA7DA3C215","لَعَظُمْتَ حتى لوْ تَكُونُ أمَانَةً","ما كانَ مُؤتَمَناً بها جِبْرِينُ"],["E44F206C-233C-5EFE-866B-C4EE8B0BD01A","بَعْضُ البريّةِ فَوْقَ بَعْضٍ خالِياً","فإذا حضَرْتَ فكُلُّ فَوْقٍ دُونُ"]]},"676B2F98-D377-5BFB-A208-019FA29C54CB":{"t":"يا ذا المعالي ومعدن الأدب","p":124,"s":"يا ذا المعالي ومعدن الأدب","r":"441518","v":[["0084B481-BF38-5FCC-A4A3-2EF6D1348A3D","يا ذا المَعالي ومَعْدِنَ الأدَبِ","سَيّدَنا وابنَ سَيّدِ العَرَبِ"],["2BA65523-E962-5C5A-B5E5-7D905E165FE9","أنْتَ عَليمٌ بكُلّ مُعْجِزَةٍ","ولَوْ سألْنا سِواكَ لمْ يُجِبِ"],["A96C574E-4A60-517F-BCCD-F954FC64C2C8","أهذِهِ قابَلَتْكَ راقِصَةً","أمْ رَفَعَتْ رِجْلَها منَ التّعَبِ"]]},"95CC5CAA-070D-533B-AAEE-9A0098102720":{"t":"يا من رأيت الحليم وغدا","p":124,"s":"يا من رأيت الحليم وغدا","r":"441561","v":[["4DE788E7-7245-5CD3-8314-27BCFF2C3177","يا مَنْ رَأيْتُ الحَليمَ وَغْدَا","بِهِ وحُرَّ المُلُوكِ عَبْدَا"],["837F140B-9600-5725-9C38-241EBC5C1BF3","مالَ عَليّ الشّرابُ جِدّا","وأنْتَ للمَكْرُماتِ أهْدَى"],["1B53BDFD-83F5-5C5F-BC6B-0A40C2421257","فإنْ تَفَضّلْتَ بانْصِرافي","عَدَدْتُهُ مِنْ لَدُنْكَ رِفْدَا"]]},"2117A954-E396-5474-940A-FAC13A6E2591":{"t":"يذكرني فاتكا حلمه","p":124,"s":"يذكرني فاتكا حلمه","r":"447651","v":[["B1BA792E-D6DF-5C06-9613-EF1E31AF8B80","يُذكّرُني فاتِكاً حِلْمُهُ","وَشَيْءٌ مِنَ النّدّ فيهِ اسمُهُ"],["A0FA527C-5B2B-5DFD-A026-B32A97E98FE5","وَلَسْتُ بِنَاسٍ وَلَكِنّني","يُجَدّدُ لي رِيحَهُ شَمُّهُ"],["3614659F-DA97-539B-A6B9-04585334DE8E","وَأيَّ فَتىً سَلَبَتْني المَنُو","نُ لم تَدْرِ ما وَلَدَتْ أُمُّهُ"],["1D26E76B-1AFB-5323-9944-A52038AE7DBB","وَلا مَا تَضُمّ إلى صَدْرِهَا","وَلَوْ عَلِمَتْ هالَهَا ضَمُّهُ"],["EF386FD1-07C6-5BF7-98D8-77554BDE624A","بمِصْرَ مُلُوكٌ لَهُمْ مَالُهُ","وَلَكِنّهُمْ مَا لَهُمْ هَمُّهُ"],["253E796E-4442-565B-A7BB-F01857AB56BF","فأجْوَدُ منْ جُودِهِمْ بُخلُهُ","وَأحْمَدُ مِنْ حَمْدِهِمْ ذَمُّهُ"],["092F0B59-7BA8-5D4F-8AE9-FD3E45909BF2","وَأشرَفُ مِنْ عَيْشِهِمْ مَوْتُهُ","وَأنْفَعُ مِنْ وَجْدِهِمْ عُدْمُهُ"],["B02A14EC-2401-55AD-8B32-17D57315BFF1","وَإنّ مَنِيّتَهُ عِنْدَهُ","لَكالخَمْرِ سُقّيَهُ كَرْمُهُ"],["351061AB-5594-5146-B10F-C44931D0B631","فذاكَ الذي عَبَّهُ مَاؤهُ","وَذاكَ الذي ذاقَهُ طَعْمُهُ"],["17BB4B8F-0BCB-5A8A-992A-5A7C1A809049","وَمَن ضاقَتِ الأرْضُ عَنْ نَفسه","حَرًى أن يَضِيقَ بها جِسمُهُ"]]},"12914D63-3AF6-545D-B6DD-DDF1634AE6B9":{"t":"يستعظمون أبياتا نأمت بها","p":124,"s":"يستعظمون أبياتا نأمت بها","r":"441556","v":[["6C1F299D-736A-5020-A9B5-D723178E7E1F","يَسْتَعْظِمُونَ أُبَيّاتاً نَأمْتُ بهَا","لا تَحْسُدُنّ على أنْ يَنْأمَ الأسَدَا"],["603BEF8E-2CCC-5C1C-B9C7-EB1B81D24936","لَوْ أنّ ثَمّ قُلُوباً يَعْقِلُونَ بهَا","أنْساهُمُ الذّعْرُ ممّا تحتَها الحَسَدَا"]]},"F991F0A7-BF35-5B64-AF30-B299DC4AB9BF":{"t":"يقاتلني عليك الليل جدا","p":124,"s":"يقاتلني عليك الليل جدا","r":"441540","v":[["349A5641-8108-526E-A81A-284E7D47FD10","يُقاتِلُني عَلَيْكَ اللّيْلُ جِدّاً","ومُنصَرَفي لَهُ أمضَى السّلاحِ"],["2153B565-7E26-5231-889C-984D829BF16A","لأنّي كُلّما فارَقْتَ طَرْفي","بَعيدٌ بَينَ جَفْني والصّباحِ"]]},"E14C8AA0-3520-5343-9644-BA8257CB3887":{"t":"يقل له القيام على الرؤوس","p":124,"s":"يقل له القيام على الرؤوس","r":"447523","v":[["017E91F2-CEAC-5554-A6A2-7DEAE61F429C","يَقِلّ لَهُ القِيامُ على الرّؤوسِ","وَبَذْلُ المُكْرَماتِ منَ النّفوسِ"],["915660C6-22D2-5298-B372-E5CB2DDC14AB","إذا خانَتْهُ في يَوْمٍ ضَحُوكٍ","فكَيفَ تكُونُ في يوْمٍ عَبُوسِ"]]}}}