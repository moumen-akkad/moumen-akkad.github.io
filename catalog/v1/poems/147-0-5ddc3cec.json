{"v":1,"poems":{"433DDA6B-8386-5D5A-B465-8C0B236BE6E5":{"t":"أبعْد ارتِحالِ الحَيِّ مِنْ جَو بار","p":147,"s":"أبعد ارتحال الحي من جو بار","r":"477660","v":[["C85AEE98-0C96-5FB0-865B-E81A3C70F912","أبعْد ارتِحالِ الحَيِّ مِنْ جَو بارقٍ","تُؤمِّلُ أنْ يَسلُو الهَوى قلبُ عاشقِ"],["33399DED-20BF-53EA-9F9C-1B877DA3D776","إذا أظمأتني الحادثاتُ وَلمْ أجد","سِوَى أسِنٍ مِنْ مائِها مُتَماذِقِ"],["F47FB5DD-A83C-51F8-AE1C-7DFA2132E5E6","شربْتُ سُلافَ السَّير تُقطَبُ كأسُهُ","لِفقدِ خليلٍ أو حَبيبٍ مُفارقِ"],["4AEC1895-A900-53E1-9A6F-1DD8600A3724","أنا ابنُ السّرى لا بل أبوها كأنّما","ركابيٍ على قلبٍ مِن الدَّهر خَافقِ"],["39494307-80E6-5E85-97D3-6D33F7A38502","صَفاً تحتَ كفِّ البين إنْ ظلَّ غامزي","وصاباً زُعافا إنْ عَرى البَيَنُ ذائِقي"],["EE65E7DF-5DDB-53B3-AE0B-262472BF8CD5","ألِفْتُ الفيافي فَهيَ تَحسبُ أنَّني","صُوَاها وعيسي من رِئالِ النَّقانقِ"],["4141E78C-DA31-57DC-9DDA-C3404C869E02","وَعلَّقتُ آمالي بأبيض صارمٍٍ","وأسَمر خَطيِّ وأجَردَ سابقِ"],["984C7486-5ED8-5775-A966-3B83990219EB","فقَرَّبنَ مِن نَيلِ العُلا كلّ شاسعٍ","وأدنينَ مِن بُعدِ المُنَى كلّ باسقِ"],["A38B92E3-9E61-550B-AFB8-7DA9CBDD070D","فلا تعذليني في تَسرُّعِ مُهجَتي","إلى حتفها بينَ القَنا والفَيالِقِ"],["2414D6EB-BA9F-5B58-8827-DBE0E42A588F","فلستُ مُريحاً مِن قَنا الخَطِّ راحَتي","ولا مُعتقاً عَن مَحملِ السَّيفِ عاتِقي"]]},"AB98401B-56E8-59EA-9B2D-2D7AD3C0095A":{"t":"أعبدَيَّ قَد أسأرتُما في جَوانحي","p":147,"s":"أعبدي قد أسأرتما في جوانحي","r":"477683","v":[["A21CF90A-5C29-5443-842E-953614239C75","أعبدَيَّ قَد أسأرتُما في جَوانحي","مِنَ الوَجْدِ داءً مُستكِناً وبادِيا"],["BBDA21EB-B50E-5356-86CB-A7FC3DDDC439","أسأتُمْ وللحُبٍِّ المُبرحِ حُجِّة","تَحسِّنُ في عَينيِّ تلك المَساويا"],["886485DA-45C0-57FA-963C-33FA9021D06D","لَئنْ بزَّنِي دَهري ببغدادَ نابهاً","وأصبحْتُ في أكنافِ شِرْوانَ عاريا"],["D193B380-7082-5AC0-AB93-C70052018BCB","فيا لَيتني لمْ آتِ بغدادَ نابهاً","وأصبحْتُ في أكنافِ شِرْوانَ عاريا"],["966BC40C-0BED-5379-B2C5-C2777D270F30","فلو كُنتُ فيها لمْ تُحْصِّ قوادِمي","ولا أخفَتِ الأشْواق مِنها الخَوافِيا"],["0AC9CD92-4822-5281-856F-2AF340A65107","فمزَّقتُ أثوابَ الفَلا بسوابقٍ","تَظلُّ بها الأنضاءُ تفلي الفَيافيا"],["009E7F7C-4237-552C-97ED-31A6A2E8308A","إذا ما أمالتني بها نَشوةُ الكَرَى","تَرَنَّحَ في كَفّي المُهندُ صافيا"],["5D9770E6-947E-5FB1-A9B3-11BBA7641F3C","وإن أنا طلّقتُ النَّهارَ بجَوزها","خَطبتُ خُدارياً مِنَ اللّيلِ داجيا"],["8E623892-A59A-5D02-8E7B-2E5F6C8196F3","وَمَنْ طلبَ الغاياتِ جَرَّعَ نَفسهُ","سُلافَ السُّرَى واستَنهضَ النَّجمَ ساقيا"]]},"ED9528FC-FC50-561A-A1B0-69EAA541E619":{"t":"أنعتُ كلباً لمْ يَصَب مِثالُه","p":147,"s":"أنعت كلبا لم يصب مثاله","r":"477669","v":[["82F592B3-EA3A-51AF-A8A9-8AF83AB3B4F7","أنعتُ كلباً لمْ يَصَب مِثالُه","يُطعِمُهُ مِن حِرِصهِ خِيالُهْ"],["AE20AFD0-522D-5C8E-8035-4CBB3968F4DA","مِثلَ الهزَبرْ سُلبتْ أشْبالُهْ","أو كالظَّليمِ ضَلَّ عنهُ رَالُهْ"],["0EAE6C43-8C76-54AE-8660-DB1DCA7F5B74","يَسأمُ مِن مَطالِهِ مَطالُه","وفي وَديقِ فَمهِ جِريالُهْ"]]},"B19FC218-B54E-5225-B849-8A42F36ADCBB":{"t":"أهيمُ بذكر الشِّرق والغَربِ دائباً","p":147,"s":"أهيم بذكر الشرق والغرب دائبا","r":"477625","v":[["B27C9D58-AD6C-57B7-8962-29F58DFC0417","أهيمُ بذكر الشِّرق والغَربِ دائباً","ومَا بيَ شَرقٌ للبلاد ولا غَربُ"],["83D31BDA-6250-5306-BB41-7C4CB9E15723","ولكنَ أوطانَاً نأتَ وأحبَّةً","فَقَدتُ مَتى أذكر عهودَهُم أصبُ"],["67DA17F2-2742-50A7-83C8-FDE9B3BE1400","إذا خطرت ذِكراهمُ في خَواطِري","تَناثرَ مِن أجفانِي اللؤلؤِ الرَّطبُ"],["0AF0AA91-3DED-5DA7-BE27-46DF308885BA","ولم أنسَ مَنْ ودَّعتُ بالشطِّ سُحرةً","وقد غَرَّدَ الحادونَ واستعجل الرَّكبُ"],["D9E6BF27-A1C2-52B8-917D-8C551F48BFF9","أليفانِ هذا سائرٌ نَحوَ غُربةٍ","وهذا مقيمٌ سارَ عنَ صدرِه القَلبُ"]]},"E2806309-A75B-5B5A-ABBA-A30798D139DC":{"t":"أيا بَصري عزّاً عليَّ ويا سَمعي","p":147,"s":"أيا بصري عزا علي ويا سمعي","r":"477654","v":[["5EAAB595-A2B0-57B4-963D-1B4266CA9E69","أيا بَصري عزّاً عليَّ ويا سَمعي","ويا مُسرفاً عندَ التِّضرُّع في مَنعي"],["B3FBC32B-9B55-508A-97F5-166946EC29F2","إذا كُنتَ مَطبُوعاً على الهَجر والجَفا","فَمنْ أينً لي صَبرٌ فأجَعلهُ طَبعي؟!"],["F9E149CD-3336-58DC-9E82-B65FD04D3DB2","سَلِ المطرَ الغَمرَ الذي عَمَّ أرضكُم","أجاَء بمقدارَ الذي فاضَ مِنْ دَمعي؟"]]},"130C3816-F51E-5E7C-8080-42DE8C271AA4":{"t":"أينفعُ قولي إنَّني لا أُحبِّهُ","p":147,"s":"أينفع قولي إنني لا أحبه","r":"477629","v":[["8C634A4A-BFFF-57C7-9EDE-F32BBC43D46D","أينفعُ قولي إنَّني لا أُحبِّهُ","وَدَمعي بما يُميله وَجدِيَ يكتبُ"],["CE10BA41-B8FE-5180-881D-12FB6E9F10FF","إذا قلتُ للواشِين لستُ بِعاشِقٍ","يقولُ لهُم فَيُضَ المدامعِ يَكذبُ"]]},"44CBE5D1-5D80-5F2C-80A7-780998BDBD1C":{"t":"إنِّي عَشقتُ صَغيراً","p":147,"s":"إني عشقت صغيرا","r":"477668","v":[["7D68E628-D925-5703-AEE1-0BBCD9F41A3B","إنِّي عَشقتُ صَغيراً","قَدْ دبَّ فيه الجَمالُ"],["B760DA1F-712D-5EBE-AF16-FBD6D20D288D","وكادَ يُفشي حَديثَ ال","فُضولِ مِنه الدَّلالُ"],["F6D838CF-7769-5847-B72B-5A859580DE53","لو مرَّ في طرُقِ الهَجْ","رِ لاعتراهُ ضَلالُ"],["6D8D9A66-E097-5AE0-9585-E51F346BE22E","يُريكَ بَدراً تماماً","في الحُسنِ وهوَ هِلالُ"]]},"25014377-7019-512F-B06E-FE1D3CF97D7A":{"t":"إنْ زارَني لَمْ أنْ مِن طيب زَوْرَتِهِ","p":147,"s":"إن زارني لم أن من طيب زورته","r":"477662","v":[["E308CA4A-3AF4-5D55-8D4F-8D4DF0464526","إنْ زارَني لَمْ أنْ مِن طيب زَوْرَتِهِ","وَإنْ جَفا لَمْ أنمْ شِدَّةِ الحرَقِ"],["33846C20-3EA0-569B-BAA2-C08BEC5B8B34","ففي الوصالِ جُفُوني غَيرُ راقِدةٍ","مِنَ السُّرورِ وفي الهجْرانِ مِن قَلقِ"],["A0B6A40A-2CC6-5CD8-8BCA-213117B9720F","إنّي لأخَشى حَريقاً إنْ عَلا نَفَسي","وأتقِي إنْ جَرى دَمْعي مِنَ الغَرَقِ"]]},"2CB2CD95-3BEB-58C3-9720-96A7FE51A2A1":{"t":"الشِّعرُ كالبحر في تلاطُمهِ","p":147,"s":"الشعر كالبحر في تلاطمه","r":"477657","v":[["D0AB04C8-B842-5EE4-9FE2-EBC3B05EF3FC","الشِّعرُ كالبحر في تلاطُمهِ","ما بينَ مَلفُوظِهِ وَسائغِهِ"],["674546ED-5FB4-57C5-BE07-0C033903C7E5","فَمِنهُ كالمِسكَ في لطائِمهِ","وَمنهُ كالمسكِ في مدابِغهِ"]]},"A740BBCD-D6B8-5BB8-A8FB-D298D2296DEB":{"t":"بدا خَطُّ مَن أهواهُ كالبَدر طالِعاً","p":147,"s":"بدا خط من أهواه كالبدر طالعا","r":"477630","v":[["763877B0-1239-562D-9E1D-24C7AAC38986","بدا خَطُّ مَن أهواهُ كالبَدر طالِعاً","وَعارِضهُ قَد لاحَ فيه وَزغَّبا"],["EBFA5514-4D86-5F5E-BC8D-528B6867DCF4","فكان كنملٍ دبَّ في العاج قَاصِداً","ليجتَزَّ في رِفقٍ من الصُّدغِ عَقرَبا"]]},"35D4D9BB-AB23-540D-B93B-BACFD9F221F3":{"t":"بَدرُ تِم عليّ ليسَ يَلينُ","p":147,"s":"بدر تم علي ليس يلين","r":"477680","v":[["0175BE9B-220B-5E09-B1B6-3E24E291407A","بَدرُ تِم عليّ ليسَ يَلينُ","خَابَ فيِما رَجَوتُ فيهِ الظّنُونُ"],["1158F920-A4EF-55FC-B4CD-762F0983035D","طالِباً للخِلافِ إنْ لَمْ أكنْ كا","نَ وإنْ كُنتُ حاضِراً لا يكونُ"],["AA79D79B-77AA-5F34-A331-A4BB2AE7657A","فَعَلي ذا ما نَلْتقي قَطُّ حتَّى","يَتلاقَى المُضافُ والتَّنوينُ"]]},"E2FBFE6D-D041-5029-AD16-0B51C5559FD4":{"t":"بَينَ كَريمين منزلٌ واسِع","p":147,"s":"بين كريمين منزل واسع","r":"477655","v":[["7DF9318B-6088-57EB-895B-48EB786D62F0","بَينَ كَريمين منزلٌ واسِع","والوُدُّ حالٌ تُقربُ الشِّاسعْ"],["FF8F6278-92FA-58B0-8C19-7BA283A182E0","والبيتُ إن ضاقَ عن ثمانيةٍ","مُتسعٌ بالودِادِ للتِّاسعْ"]]},"CA930D16-1A15-57C4-B487-DE94038A2A3F":{"t":"تَذكَّرَ نَجداً والحِمَى فَبكَى وَجدا","p":147,"s":"تذكر نجدا والحمى فبكى وجدا","r":"477636","v":[["9C137BCF-3E17-5319-A75E-200A2F2FF788","تَذكَّرَ نَجداً والحِمَى فَبكَى وَجدا","وقال سَقى اللهُ الحَمى وسَقى نَجْدا"],["4DE28AF5-6055-5D19-9853-3B8639FD22EF","وَحيَّتهُ أنفاسُ الخزامَى عَشيَّةً","فهاجتْ إلى الوَجِدِ القديِمِ لهُ وَجْدا"],["D12BC582-8DF8-52DA-95BE-8FF09DFFE78C","فأظهرَ سُلواناً وأضمَرَ لَوعَةً","إذا طُفئتْ نِيرانُها وقدَت وَقْدا"],["670923FB-4CC2-5DA3-B157-366D777421E7","وَلو أنَّهُ أعطى الصَّبابةَ حُكمَها","لأبدى الذي أخفَى وأخفى الذي أبدى"],["E95CCBE8-A821-5240-95DF-604D17C2F0E6","وَلم أنسهُ والسُّكرُ يفتلُ قَدَّهُ","إذا ما تَثنَّى كِدتُ أعقِدهُ عَقدا"]]},"9AEB7124-33FF-56B6-92E3-9AFD1E8FC94A":{"t":"جُدْ وإنْ شِئتَ لا تَجُد","p":147,"s":"جد وإن شئت لا تجد","r":"477637","v":[["49E42B4E-0A98-5E05-B8BC-3BB6071BBDF9","جُدْ وإنْ شِئتَ لا تَجُد","إنْ تَخلَّصت لمْ أعُد"],["3436654D-9B65-5DA9-AD68-B36C856A1A47","إنَّما منكَ غرَّنِي","كِلمٌ طَعمُها الشّهدْ"],["85E374D0-C210-50B2-96A8-91F5F298984A","لستُ في الناسِ واحداً","قَتلتهُ اللّحَى الجُدُدْ"]]},"CAD31037-4FAC-5B79-9FA6-B3C21B71FC54":{"t":"حالتْ عليَّ القَيروانُ بحالِها","p":147,"s":"حالت علي القيروان بحالها","r":"477650","v":[["61201805-1CAB-5C6F-8719-C4AB61A73DA7","حالتْ عليَّ القَيروانُ بحالِها","عمَّا عَهدتُ العَيشَ فَهوَ مُنغَّصُ"],["313D378A-B855-5259-AA5D-5D0B8D23FB48","فَخرابُها في كلِّ يومٍ زائدٌ","وَصُبابَةُ المعمُور فيها تَنقُصُ"],["01958545-1A36-5A27-A6B9-CF1759E44378","إنْ كان أرخَصَني الزَّمانُ فإنَّهُ","أسدَى إليَّ بِضائعاً لا ترخُصُ"],["9EB44D53-9D58-541D-9902-93FEEC2108EA","أو كان غيرَ مِنْ طِباعي مَوضعي","فالخَمرُ إن تركَتْ وعاها تَقرُصُ"],["DB85B8A9-3156-5B00-B820-570DBC7F8DF5","كيفَ الرجُوعُ وطِرفُ حالي عاثرُ","وَجناحُ أمالي الكسيرُ مُقصَّصُ"]]},"FAE1B4AB-47BD-599C-81EA-21D090250707":{"t":"حكَى فَرسي اللّيلَ في لَونِهِ","p":147,"s":"حكى فرسي الليل في لونه","r":"477643","v":[["16314B5E-8E74-584E-A6D2-0C9858897D81","حكَى فَرسي اللّيلَ في لَونِهِ","فقابلَهُ البَدرُ عندَ اضطِرار"],["68F3778F-DD6D-58FC-A373-908EC1194AEE","فكانَ لهُ غُرَّةً في التَّمامِ","وَنَعلاً لِحافِرهِ في السِّرار"]]},"5117A7B7-6EA8-5A92-9EB9-0BEDCA0E7A5F":{"t":"خَطَرتْ فكادَ الوُرقُ يَسْجعُ فوْقها","p":147,"s":"خطرت فكاد الورق يسجع فوقها","r":"477681","v":[["056A1763-3863-51E0-8D3F-787922FF1EF9","خَطَرتْ فكادَ الوُرقُ يَسْجعُ فوْقها","إنَّ الحَمامَ لَمُغْرَمٌ بالبانِ"],["200AC710-C9ED-5D6A-9797-B40A834DAACB","مِنْ مَعْشَرٍ نَشرُوا على هامِ الرُّبا","للطَّارقينَ ذوائبَ النِّيرانِ"]]},"8846CE07-B5FA-52BF-95D9-24AAD792F1C0":{"t":"دعتنيَ عَيناكِ نَحوَ الصِّبا","p":147,"s":"دعتني عيناك نحو الصبا","r":"477656","v":[["322AD037-AAA7-570D-9F3D-0541EB3583CA","دعتنيَ عَيناكِ نَحوَ الصِّبا","دُعاءً تكررَ في كُل ساعهُ"],["FA6905B8-E41C-5156-8CDC-4F094BBE9A7D","ولولا وَحقكِ عُذرُ المشيبِ","لَقلتُ لِعينَيكِ سمعاً وَطاعهْ"]]},"F53A0D3E-0047-5085-BB99-911FB4322EC6":{"t":"دَعني أسِرْ في البلادِ مُلتَمساً","p":147,"s":"دعني أسر في البلاد ملتمسا","r":"477682","v":[["DF0D6C6B-4772-5F0E-9602-441B30ACF35B","دَعني أسِرْ في البلادِ مُلتَمساً","فَضلَة مالٍ إنْ لم يفَرْ زانا"],["E79CE27C-48B4-5794-AEAB-04F0CA0F9E71","فبيْذقُ الرُّخّ وهو إيْسَرُما","في الدِّسْتِ إنْ سارَ صارَ فِرْزانا"]]},"DE8D6B50-1502-57E0-848A-A64BEC534213":{"t":"ذَهَبنا فأذهبنا الهُمومَ بشَمعَةٍ","p":147,"s":"ذهبنا فأذهبنا الهموم بشمعة","r":"477639","v":[["B3C0FFAF-2E60-55BC-82B7-C5BA5CFE0C0C","ذَهَبنا فأذهبنا الهُمومَ بشَمعَةٍ","غَنينا بها عَن طَلعةِ الشَّمسِ والبَدرِ"],["A1065E76-772A-5B3E-93D6-3D984B189CE5","أقولُ وجسمي ذائبٌ مِثلُ جِسمِها","وَدمعتُها تَجري كما دَمعتي تَجري"],["E26CAA04-5C7E-54A3-B0E2-022224A96F68","كلانا لَعمري ذو بَيانٍ من الهَوى","فَنارُكِ مِن جَمرٍ وناريَ مِن هَجْرِ"],["4E81543E-5D08-5450-8564-1FCBD478F54B","وَأنتِ على ما قَد تُقاسِينً مِنْ أذىً","فَصدرُكِ في نارٍ وناريَ في صَدري"]]},"8F60623E-9869-52CA-8B3C-0F191D0CD06E":{"t":"رُبَّ لَيلٍ أبطا علَيَّ فلّما","p":147,"s":"رب ليل أبطا علي فلما","r":"477679","v":[["AC15B657-89DB-5D5B-84E6-AD0B495C737D","رُبَّ لَيلٍ أبطا علَيَّ فلّما","مَدَّ ضافي دُجاهُ ما استَبطِاني"],["24E7B7D8-8375-5A3A-9594-B1BBCF05FF6F","جِئتُ أسعَى إليهِ سَعْيَ زُلالِ ال","ماءِ يَستَنُّ في حَشا الظَّمآنِ"],["F4F08854-9188-5F27-82B5-3E7CD56EDEFB","ظَلتُ أسري بمِثله فيه حتّى","خِلْتَني قَد أحاطَ بي لَيْلانِ"],["69DDC813-CDDA-560A-A84C-F6E81C96DC96","فَهوَ طَرفٌ لهُ خِضابِي سَوادٌ","أنا فيهِ كَهيْئةِ الإنسانِ"]]},"6AD659CF-A977-520E-96CE-87EE9B6A8BE0":{"t":"سَمتُ بنَفسي غَداةَ الرَّحيلِ","p":147,"s":"سمت بنفسي غداة الرحيل","r":"477671","v":[["D3A23823-2B37-5C07-96CD-724AED425794","سَمتُ بنَفسي غَداةَ الرَّحيلِ","غَراماً على القَمرِ الآفلِ"],["4CCD545F-6B29-5EE5-A4CC-1DF602B77C82","وَبتُّ أفضُّ ختامَ الجُفونِ","وأبكي على الجَسدِ النَّاحِلِ"],["1CA9CC03-9E98-5777-A96B-1C3701C7FB47","وَمنَ عَجَبِ العِشقِ أنَّ القَتيل","يَحِنُّ ويَصبُو إلى القاتِل!"]]},"B6124A09-35F6-5C32-ABD1-C47BA756EAEB":{"t":"طاقةٌ نغَّصت عَليَّ شَبابي","p":147,"s":"طاقة نغصت علي شبابي","r":"477678","v":[["C37D0341-F536-5275-814B-82BCC9C03434","طاقةٌ نغَّصت عَليَّ شَبابي","فتَعمَّدتُ نتفَها غَيرَ وانِ"],["F01DA26F-80CC-5D43-9E76-0D9AC867BB85","فأقامتْ عِندَ المكانِ ونابَت","عِندَ نتفي مِن غَيرها طاقتانِ"],["AB6E04AF-F63F-5B07-AFBD-42FE17F42CBB","قلتُ ماذا هذا لَعَمرُ التَّصابي","لِشبابي وَجدَّتي مِحْنَتانِ"],["3B8D56B5-37A9-573D-87CA-E958DF61A6EE","قالتا قَدْ جَرِى مِنَ الرَّسمِ للسُّل","لطانِ أخذُ البرَاةِ قَبلَ الجَانِ"],["19596008-F8F8-599D-9AF0-185D11798DD5","وإن ازددت في الجَفاءِ فَلا تُنْ","كِرْ قُدومي عَليكَ مَعْ أعْوانِ"]]},"0E1987EE-CD53-5C97-BCDB-D130B00636CE":{"t":"ظَبيٌ إذا حرَّكَ أصداغَهُ","p":147,"s":"ظبي إذا حرك أصداغه","r":"477641","v":[["7AD76799-6579-5CFE-9784-28C706647EE2","ظَبيٌ إذا حرَّكَ أصداغَهُ","لمْ يلتفت خَلقٌ إلى العِطْرِ"],["F478E414-76E6-5F07-99B8-D849A9FD1E21","غَنَّى بشعري مُنشِداً ليْتني ال","لفظ الَّذي أودَعتَهُ شِعريَ"],["0816ABE9-6378-5931-B9E9-F612BDDB0111","فكلّما كرَّرَ إنشادَهُ","قبلتُهُ فيهِ ولَم يَدْرِ"]]},"82B6AD7C-27B7-5CC5-B6D8-C1226B152339":{"t":"على اليُمن باكرتَ الفِصادَ مُشَمِّراً","p":147,"s":"على اليمن باكرت الفصاد مشمرا","r":"477640","v":[["AF763AF8-BEF1-52E9-A01B-9248971E0822","على اليُمن باكرتَ الفِصادَ مُشَمِّراً","يَمِينَ جَوادٍ للعَطاءِ مُشَمَّرهْ"],["247A67D3-A302-5965-84FA-6D687AF55C94","مَددت أبَا سَعْدٍ إلى صدر مِبضعٍ","يَداً تُصدرُ الآمالَ عنَهُ مُنشَّرهْ"],["2E3ED3C1-FA15-561B-A588-9DE9136CD81B","وَما خِلتُ أنَّ الجُودَ تَجري له دَمٌ","فما كان أجرى ذا الطَّبيبَ وأحْسرهْ"],["AB45B5C6-9496-50B0-B234-79E87F56FC36","أظنّ لهُ مِن لطفِه بلباقةٍ","بَصِيرةَ بُقراطٍ وإقدامَ عَنتَرهْ"]]},"D5AD3067-FD3A-55B5-B2A9-197A7B32BEFA":{"t":"عَليٌّ لا تَصل وَبنِ","p":147,"s":"علي لا تصل وبن","r":"477677","v":[["83229A49-46C0-5098-A746-E07F376807FC","عَليٌّ لا تَصل وَبنِ","فقلبي غَيرُ مُرْتَهنِ"],["333C804D-5F0D-5FA8-93AD-2765E51B1041","غَضبتَ فَزِدْ ودُمْ غَضَباً","فإنّي عَن رضاكَ غَني"],["4328E6B8-F5EC-52D9-A80D-A38A299147A8","أتُخفي بغْْضَتي سِرّاً","وَتبدِي الحُبَّ في العَلنِ؟"],["CCD6FF49-7AF4-5D22-A182-71F9FE44A6F5","لقد غَرَّتكَ في مَيلي","إليك كَواذبُ الظِنَنِ"],["2CA87A90-0471-5D89-877D-15EE596C4C39","أتطْمعُ أن أزيدَ هوىً","وَوُدك لي على دَخَنِ"],["A0C62CD9-DB19-5F3C-9411-6BBA9F51845C","إذا فسدَتْ يدٌ قُطِعَتْ","ليَسلَمَ سائِرُ البَدَنِ"]]},"AEE13A36-D015-57C3-8BBC-2BFF6B72700F":{"t":"قالوا تَبدَّى شَعرهُ فأجبتُهم","p":147,"s":"قالوا تبدى شعره فأجبتهم","r":"477631","v":[["22899256-9B22-508D-9B8E-9A6AD71F2C60","قالوا تَبدَّى شَعرهُ فأجبتُهم","لا بُدَّ مِن علَمٍ على الدِّيباجِ"],["2F573E0B-543A-546B-80CF-164F2C5EA839","والبَدرُ أبهرُ ما يكونُ ضِياؤه","إذ كان مُلتَحِفاً بليلٍ داجِ"]]},"DFA8829A-815D-5331-8E57-F9F2532A44F4":{"t":"قالوا مَدحتَ أُناساً لا خَلاقَ لهمْ","p":147,"s":"قالوا مدحت أناسا لا خلاق لهم","r":"477644","v":[["903C8974-FC45-5C9F-AFDB-BF78BBF81937","قالوا مَدحتَ أُناساً لا خَلاقَ لهمْ","مَدحاً يُناسبُ أنواعَ الأزاهير"],["C49BA428-A773-5F3B-83B8-12675F8436A9","فقلتُ لا تَعذلوني إنَّني رَجُلٌ","أُقلَّدُ الدُّرَّ أعناقَ الخَنازيرِ"]]},"DCBF0235-1619-5395-B645-B9E1F029B396":{"t":"قلتُ للمُلقي على الخدَّين","p":147,"s":"قلت للملقي على الخدين","r":"477638","v":[["13D08F06-11BB-5D3C-AC44-9152540AA5B6","قلتُ للمُلقي على الخدَّين","من وَرْدٍ خُمارا"],["A318DE0D-8A25-5CF0-9C4D-77F7F0E7B066","والذي سَل على العُشاقِ","باللّحظِ شِفَارا"],["1B1F90FE-32BA-5C86-9C9D-45042BFC87F5","أسبَل الصُّدعُ على خدِّكَ","من مِسْكٍ عِذارا"],["0FCA9FA1-0A32-55F6-8F82-6F868253463B","أم أعانَ اللّيلَ حتى","قَهَرٌ اللَّيلُ النَّهارا؟"],["42AFD71D-F0C6-5A7D-97B3-C62AE73AAE78","قال مَيدانٌ جرى الحُس","نُ عليهِ فاستَدارا"],["C0AAEA87-2705-521D-A521-86793553B257","رَكضَتْ فيهِ عُيونٌ","فأثارَتهُ غُبارا"]]},"0C933C9D-13BA-52FA-A8DB-FF94DC963E26":{"t":"قُلتُ إذ قِيلَ لي حَبيبكَ يَشكو","p":147,"s":"قلت إذ قيل لي حبيبك يشكو","r":"477684","v":[["1B5CF963-41AB-5F69-AD2C-1B0820724580","قُلتُ إذ قِيلَ لي حَبيبكَ يَشكو","رمداً سَلطَ السُّهادَ عَليه"],["62F72419-88E2-5B67-AF31-3DA43B64F28F","لا يَظنُّ الحَسودُ ذاكَ وإنْ دبَّ","دَبيب التَّوريدِ في وَجنتَيهِ"],["743BF7B0-7D30-5B14-9A0D-14E058FEABEB","إنَّما خدُّه غلالةُ وَرْدٍ","نَفَضت صِبغَتَها على مُقْلتيهِ"]]},"51F40CCF-1BDA-5FA8-8149-544A969222CE":{"t":"كأنَّما البدرُ وقد شانَهُ","p":147,"s":"كأنما البدر وقد شانه","r":"477645","v":[["3C48AD3C-CA5B-5FCF-9D2C-82800DA5F33F","كأنَّما البدرُ وقد شانَهُ","كُسوفُه في لَيلةِ البَدرِ"],["43DC064E-7463-50F7-85D8-310AD58996BC","وَجه غُلامٍ حسنٌ وجهُهُ","جارتْ عليه ظلمةُ الشَّعرِ"]]},"7CAF206F-A069-5866-88F2-2ED3FE67B2E3":{"t":"كأنّما الفحمُ والنيرانُ تُلهبُهُ","p":147,"s":"كأنما الفحم والنيران تلهبه","r":"477659","v":[["B7B4C5D7-E95C-59EA-A487-126BFB62A4EE","كأنّما الفحمُ والنيرانُ تُلهبُهُ","هامٌ مِن الزَّنجِ في ثَوبِ مِن الشَّرَقِ"],["5FB4874A-C936-5F7B-BBAE-0E9063C4796C","أو الزُّنودُ براها السَّيفُ في رَهَجٍ","مِن الهُنودِ عليها شطبَة العَلقِ"],["9C9C1562-2283-52AC-B1A6-19A9D5426DE6","مدَّ الرَّمادُ عليه بعدَ رَقدتِه","عَيناً له حَسَكٌ مِن حُمرةِ الشفقِ"],["77E3DE91-0FD6-5FDD-8CC3-A229801B8C7B","أقولُ للنّار والأحْزانُ نائرةٌ","والقلبُ في غَمراتِ الحُبِّ لم يُفقِ"],["C2711DF6-47D9-5CDE-BE51-9356F5E7117D","إيّاك أن تقربي ناراً مُؤججَةً","بلاعجِ الشوقِ في قَلبي فتَحترِقِي"],["776752BC-4D8A-567F-9EED-4DE96CC61FC0","أظنُّ أنكِ ما لاقيتِ ما لقَيتْ","قُلوبُ أهلِ الهوى مِنْ جاحِمِ القَلَقِ"],["6C3F6133-A8C8-5FC3-A08C-967B7D4F9948","ولا مُنِيتِ بتوَديعٍ وقد جَعلُوا","بيضَ السَّواعدِ أطواقاً على العُنقِ"],["09C3DC8E-1ED4-5560-9B5F-F4438DCB271B","ولا فُجعتِ بغزلانِ ألفتهمُ","سَاروا بقلبك إذ ساروا مع الرُّفَقِ"],["74493E8C-B5BB-51BC-8B15-1C8200F41579","سَطا الفراقُ عليهم غَفلةً فغَدَوا","مِنْ جَورهِ فرَقاً مِنْ شدةِ الفَرَقِ"],["CDF8A9F7-B90A-5A60-B2C1-B660ABCDBA47","فسرتُ شرقاً وأشواقي مُغرِّبةٌ","يا بُعدَ ما نَزَحتْ مِنْ طُرقِِهم طُرُقي"],["DA174381-534D-5F8C-A82A-73CC89E34281","لولا تَداركُ دَمعي يومَ كاظِمةٍ","لأحرقَ الرَّكبَ ما أبديتُ مِنْ حُرَقِ"],["1CA4B773-8957-5989-AD35-87948B758300","يا سارق القلب جَهراً غَيرَ مُكتَرثً","أمنْتَ في الحُبِّ مِن بَعْدي على السّرقِ"],["30DF1DEC-353D-5285-BE56-9045EDB47B0A","ارمُقْ بِعَين الرِّضا تنعش بعاطفةٍ","قَبلَ المَنيَّةِ ما أوهيتَ مِن رَمَقِ"],["63D2E67F-88D0-5045-B449-FF47895E80E7","لمْ يَبقَ مِنَي سوى لفظ يُبوحُ بما","ألقي فيا عَجَباً للفظٍ كيفَ بَقي!"],["9FD394C8-6374-5831-B040-6CEBAED2A615","صِلْني إذا شِئتَ أو فاهجُر عَلاِنَيةً","فكل ذلك مَحمولٌ على الحَدَقِ"],["E3311B3C-5A8C-5443-805F-0F281C3D4B96","كأنَّ قَطراتِه مِنْ بَعدِ ما جَمدَتْ","لآلئٌ فَوقَ أصدافٍ مِنَ الوَرَقِ"],["3F07AEDB-E633-57D4-9FB5-0E4E31CB690D","فالنورُ قَدْ رَمِدَتْ بالثلجِ أعينُهُ","فليسَ يَرنو بجفْنً غَير مُنطبقِ"],["8E0CB226-0D9E-597C-985A-41D70331050D","والغُظنُ قَدْ ضَرَبتْ أيدي الضريبِ على","أوراقِهِ فَتَراهُ مائَل العُنُقِ"]]},"631D3C9D-ECB9-5B38-AECC-36C354A99BD6":{"t":"كَمْ حِمارٍ هو اوْلَى","p":147,"s":"كم حمار هو اولى","r":"477665","v":[["086E5B87-D4A5-5F03-8EFF-FC8F94FE072D","كَمْ حِمارٍ هو اوْلَى","بنهيقٍ وَشهيقِ"],["A604B6D1-F82C-5ED8-842D-C9C83C7BFF26","يَكتَسي في الشِّتوةِ الخَزَّ","وفي الصيَّفِ الدبِيقي"]]},"7CA0409A-604A-58BB-A4E8-F8724046E25D":{"t":"لا يَشربُ الماَء ما لم يُحف حافَتَه","p":147,"s":"لا يشرب الماء ما لم يحف حافته","r":"477623","v":[["6E3575F3-DE5A-58AA-A406-DBE34E5AB46A","لا يَشربُ الماَء ما لم يُحف حافَتَه","حتّى إذا قَطرت أرماحُهُ شَربا"],["DE1399F9-5E0C-522E-AF96-52D589B6E2AC","ولا يَرد المُحيّا الطلق بِغرتَهُ","كالقِرت عَنَّ ببرق خُلّب خُلِبا"],["1C992706-8B58-5121-9C5C-9E59D8C8F584","ما بال بالي إذا سكَّنتهُ نَفَرت","عِشارُهُ وإذا كَفِْكفتُه انسَربا"],["18DB6A69-4D95-52C8-86FF-BBE4AA46D0B8","أللتبّرمِ بالدُّنيا وزينَتَها","أم البعيدُ من الآمالِ قد قَرُبا"],["A6D2C83D-1722-5866-8934-AFA2B9ABFEA5","بهمَّةِ المَلكِ المأمون حينَ غدا","إفضالُها لتَناهي هِمتي سَبَبا"],["B97B9D78-30FD-5AA9-ABD0-E85F97FE91C6","الواهب الألفَ لا عَيناً ولا وَرقاً","ولا عِشاراً ولكن أنعُماً قُشُبا"],["851A0245-4BBD-5685-9884-59ED66255BA6","في جَحَفل كسوادِ الليلِ مُرتَكَمٍ","لكن أسنّتُه صارت لهُ شُهُبا"],["2BB81BC7-1242-50F3-9C7C-69095F24A2F8","كأنَّما نَهجُ أُنبوب الرَّماحِ بِه","ما قَد وَرثتَ مِن العليا أباً فأبا"],["6C2215B7-9236-5C31-9178-52E21FF2A56A","قومٌ إذا رَكُبوا سَدّوَا الفضاَء وإن","حَلّوا توهَّمَتَهم في البيدِ رجلَ دَبا"],["C3572CDD-6AE0-5A65-924C-979CB1CC8E5E","قد صيَّروا الحربَ كأساً والدّماَء بها","خَمراً وما جَوَّفَت مِنَ بَيضَهِا حَبَبا"]]},"B85DC31D-3D9E-53B2-9E15-41175DA66369":{"t":"ما إنْ أرى قُربَكُمُ صائباً","p":147,"s":"ما إن أرى قربكم صائبا","r":"477648","v":[["71CF0DFB-8844-5053-AE6B-55BDFE13200E","ما إنْ أرى قُربَكُمُ صائباً","وأنتُم لي غَيرُ أجناسِ"],["2F40D024-3725-5A38-A0B5-4C7D5E02E63A","وما جُلُوسي عِندَكُمْ أنَّني","أعدّكُمْ مِنَ بَعضِ جُلاَّسي"],["B68C0551-8095-51D7-A487-316374DD53EA","لكنَّنِي أجِلسُ ما بَينَكُم","تَعَللاً مِن عدَمِ النَّاسِ"]]},"FFC3A3EA-CD0E-5770-A530-44D1810FBC28":{"t":"ناعى أبي جعفر القاضي دَعوتَ إلى","p":147,"s":"ناعى أبي جعفر القاضي دعوت إلى","r":"477652","v":[["9D4DF393-CA8A-5C74-98A4-B472132A0B86","ناعى أبي جعفر القاضي دَعوتَ إلى ل","رَّدى فَلم يدْر ناع أنتَ أم داعِ"],["D308869D-8D16-5612-9F03-2914CB533038","تَنعى العَظيمَين مِنْ مَجدٍ ومِن شَرَفٍ","بعدَ الرَّحيبيَن مِنْ خُلقٍ ومِن باعِ"],["E3ADF77E-E22D-5FEE-87D8-84C917B684EC","مَهلاً فَلَم تبقِ عيَناً غَيرَ باكيةٍ","ولا تَركتَ فُؤاداً غير مُرتاحِ"],["6E935CD6-109E-5BE8-A430-BD385DB5F5EE","قَد كان مالئ عينٍ بَعدَهُ امتلأت","حُزناً ونزهةَ أبصارٍ وأسماعِ"]]},"48F49839-E352-54F6-B16F-644A35B88D69":{"t":"هاتِ اسْقِني فالعيَشُ شاكٍ جُرأةً","p":147,"s":"هات اسقني فالعيش شاك جرأة","r":"477670","v":[["8ED3CB3A-6921-5430-A080-7D6F11130456","هاتِ اسْقِني فالعيَشُ شاكٍ جُرأةً","والدَّهرُ نَكَّبَ عن لقاءٍ أعزَلا"],["25BEC488-9F76-50F4-BCBD-DF199855B465","مِنْ قَهوةٍ تَدَعُ الفتى مُستحْسناً","مِنْ غَفلةٍ في شُربِهِ أنْ يَجهلا"],["9B1A3735-C29E-5E33-AD6A-50D21CB94BCA","معَ ناعس الألحاظِ تُخبرُ أنَّهُ","ما قالَ فيما ريمَ مِنه قَط لا"],["569F31E7-AE6F-5327-A7AF-0056A3D5C294","والثلجُ يَحْكَي في اكْتنانِ سُقُوطِه","وَضَئيلُ جُثَّته دقيقاً غُربِلا"]]},"C254B335-177C-5D8D-B8DF-B8B315FD0931":{"t":"هامَ قلبي بُحسنِ ذاك العِذار","p":147,"s":"هام قلبي بحسن ذاك العذار","r":"477646","v":[["C84C6B98-929D-5E39-A802-CBB06C10D517","هامَ قلبي بُحسنِ ذاك العِذار","حين لاحِ اخضرارُهُ في احمرار"],["4FE52E01-F48E-5868-A2B3-79C29DB0E761","عزَّ ربَّ إذا أرادَ تعالى","أنبتَ المَرزَجُوش في الجُلَّنار"]]},"4842DDDE-E0C2-5CD2-B920-E512A9876DC6":{"t":"وأعذَبُ مِن يَومِنا بالعُذَيبِ","p":147,"s":"وأعذب من يومنا بالعذيب","r":"477673","v":[["250FA1A5-DD46-5DED-B811-8703ADDD7BB7","وأعذَبُ مِن يَومِنا بالعُذَيبِ","سلامتُنا اليومَ مِن ذي سَلَمْ"],["8586F674-B1CD-5020-9D04-370FAF276FE0","وَلستُ بمَنْ يَطبيهِ الغِنىَ","ويَرصُدُ طَيفاً له أنْ يُلمْ"],["ABDB2C5C-EFDC-5952-A7BB-2BB2260A8FC5","وَمَنْ عَبثَتْ نَفسُهُ بالغِنى","تَساوى الغِنى عِندَهُ والعَدَمْ"],["1802A5B6-4E7F-59D4-9E71-C9B162EA9D9D","وَكم طَسَمَ الدَّهرُ مِن جَبْلَتي","فَردَّ نضارةَ ما قَدْ طَسَمْ"],["9A14BF87-77CC-5895-86B4-634BDCC475BE","وكُنتُ إذا ما رَماني الزَّمانُ","أو كادَ أو همَّ بي أو عَزَم"],["A09C2AA8-6443-5C48-A416-085886CEA780","عَلقْتُ أباالحَسن المُرْتَجى","فأَمسيْتُ مِن صَرْفِهِ في حَرَمْ"],["946C786F-FBE5-5BD8-9D49-FCAF5C90C991","فَتىً لو رأى البُخل في نَومِهِ","أو الجُبنَ خُلقاً له لمْ يَنمْ"],["C6B1ABE5-442E-5F7B-871F-F0EA0E1DEDA6","ولو كان طيفاً وكان الكرى","طَروقاً لغَيرْ العُلا ما ألَمْ"],["7EAE52D9-8377-5FF3-8A1C-4EDF2A8144C4","فمالي أرى عِقدَ إحسانِهِ","تَبدَّدَ مِن سِلْكه ما نَظَمْ؟"],["A5903C5C-1ED5-54F0-B362-6745D432A9AF","وَلِمْ ذَمَّني عِندهُ حاسِدٌ","كأنَّ به جِنةً أو لَمَمْ"],["E185514A-7CEA-5FE2-942D-20E1E8627EE8","بدا وجْهُه فاشتهيْتُ العَمَى","وكلَّمني فاستزرتُ الصَّمَمْ"],["99DCF26E-C71B-513C-AA9C-CA92EA1679AA","وقد كُنت تُرضعُ حتى إذا","تَرعْرَعَ غُيَّبَ عنه الحَلَمْ"],["76AECFDF-4CE3-51EA-BCFC-6CCA321C1731","يُسائِلُني الناسُ عمّا تقولُ","وما قلتْ لي قطُّ إلاَّ نَعَمْ"]]},"187EA4B7-6228-5FD8-83E8-BC9C06C3A0AB":{"t":"وأعظمُ مِن مُصيباتِ اللّيالي","p":147,"s":"وأعظم من مصيبات الليالي","r":"477675","v":[["F413EE54-77C5-5684-BED7-D935A4264E23","وأعظمُ مِن مُصيباتِ اللّيالي","عَليَّ وَصَرفهِا خِلٌّ خَؤونُ"],["A53FB690-5CB3-55A1-891A-12D7221CE624","يُقابلُني بودّ مُستميل","وبينَ ضُلوعَه داءٌ دَفينُ"],["3C654DE7-7F6E-5D55-ADC4-30662F88BEB6","إذا عَاتبتُه أبدَي مُجوناً","وَعلَّةُ ذلكَ العَتب المُجونُ"],["31778DE8-A57B-53AD-9915-E5E3AD0F301D","وَمَنْ جعلَ السُّمُومَ لهُ دواءً","فيُوشِكُ أن يُفاجئهُ المنونُ"],["0573D90E-A1F4-5849-AA38-2857F880E545","أهُمُّ بأنْ أُجازيِهِ فيأبى","عَليَّ الأصلُ والعِرْضُ المَصونُ"],["CDAADEDF-B6D5-5B16-85AB-CB809F262CC4","أرى هَذَرَ الكلامِ المَحضِ غَثاً","فَيردَعُني عَن الغَث السَّمينُ"],["5D693BFD-A6E7-521F-8085-4250FE048C02","ولم يُزعِج زئيرُ الأسد حلمي","أيُزعجُهُ مِن البَقَّ الطَّنينُ؟"],["7C2C9E5E-2D72-5145-9D8E-46DA4ABAC2C5","أيطمَعُ أنْ يَشقَّ غُبارَ مُهْري","ذَليلٌ تحتَهُ عَيرٌ حَرونُ؟"],["70E5CCF6-EFE7-59BC-9672-3F0A775FB2AD","سَلِ السّمرَ الذَّوابلَ ما غَنائَي","إذا اشتَجَرتْ بها الحَربُ الزَّبونُ"],["E8F44A0F-01A7-5017-AAE7-72C42C49CA15","ألم أجعل مُثارَ النَّقْعِ بَحراً","على أنَّ الجِيادَ له سَفينُ؟"]]},"78B46411-20D2-5F67-A6EF-DF28710EEDBC":{"t":"وزائرةٍ للشيبِ لاحتْ بعارضي","p":147,"s":"وزائرة للشيب لاحت بعارضي","r":"477658","v":[["F73B35A4-67F2-5E9F-A7ED-133A8C9BA838","وزائرةٍ للشيبِ لاحتْ بعارضي","فبادرتُها بالقَطفِ خَوفاً منَ الحتْف"],["102C4FE5-F437-5C33-8FB2-FD9E02E5E6DF","فقالتْ على ضَعفيِ استطلتَ وَوَحدتي","رُويدكَ حتّى يلحقَ الجيش مِن خَلفي"],["AA222E77-B2F7-5BED-89FF-E4D9EF37DD3D","فلم يكُ إلا عن قَريبٍٍ فأقبلت","وعمَّت جميعَ الرّأس رُغما على أنفي"],["E772BE49-CE39-5405-A1A5-827558E472C0","فوا أسفي لو كان يُغني تأسُّفي","على زمنٍ ولّى ونحنُ على حَرفِ"]]},"C470C872-BF5B-5707-B026-916915CF2B93":{"t":"وشادنٍ أسرفَ في صدِّه","p":147,"s":"وشادن أسرف في صده","r":"477634","v":[["AE6F650D-F367-52B5-A760-AD24C88D4B81","وشادنٍ أسرفَ في صدِّه","وزادَ في التِّيهِ على عَبدِهِ"],["2419F7F3-2756-5156-ACE2-CDD2468AE954","الحُسنُ قد بثَّ على خدهِ","بَنفسَجاً يرنو إلى وَرْدِهِ"],["4BB726C3-F540-5E11-A298-0953E8A8E7D5","رأيتُه يكتبُ في طِرسهِ","خطَّاً يُضاهي الدُّرَّ في عَقدِهِ"],["D6C0FD76-A784-5931-9345-4EED14EABEE9","فخِلتُ ما قد خطَّهُ كفُّهُ","للحُسنِ قد خُطَّ على خَدِّهِ"]]},"DD27986C-5804-5886-BE2F-B2F5FB26083B":{"t":"وظبْي أراني غُرَّةً مِن جَبيِنهِ","p":147,"s":"وظبي أراني غرة من جبينه","r":"477674","v":[["EC8067A4-907A-5C98-91FF-121131FE4220","وظبْي أراني غُرَّةً مِن جَبيِنهِ","تَزيدُ ضِياءً بينَ أصْداغِه الدُّهمِ"],["C14AA785-1837-50C4-9966-4B097E4EE755","تَجرَّعتُ بالإسعاف جُرعةَ ظُلمِهِ","لأني رٍأيت الظلمَ يُدرأ بالظلمِ"],["1A04A2D1-B5E7-55F4-9C64-456FB73D1CEF","وَكم أمكنتني فَرسَةٌ فتركتُها","حياءً مِنَ الشَّيب المرقَّر بالحلمِ"],["2413E1B6-8758-5F09-9F33-C5E3EA1B146B","ولو كُنتُ في ثوبِ الشَّبيَبة رافلاً","لَصحَّ على إتيان زلّتهَا عَزْمي"]]},"145032F7-FC54-5534-9F2D-B3E95B88C20C":{"t":"ولمَّا أن كسانِي الشِّيبُ ثَوباً","p":147,"s":"ولما أن كساني الشيب ثوبا","r":"477624","v":[["145D866B-DCF1-518E-B528-B0030871D173","ولمَّا أن كسانِي الشِّيبُ ثَوباً","ولمْ يكُ وقتَ تَغيير الثَّيابِ"],["440A0389-5D32-5F6E-ACC9-CB3B85EA3EF1","أتاني غَفلةً والنَّفسُ فيها","بَقايا مِن عَقابِيل التّصابي"],["8171CE98-B1B2-50B3-8EDE-ACAF1A753E69","وَغُصنُ شَبيبَتي غَضنٌّ نَضيرٌ","به ظَمأٌ إلى ماءِ الشَّبابِ"],["73E837B4-4F35-5741-A6C5-4095D27E274A","ورامَ النَّاسُ مِني ما يُضاهِي","مَشيبي في فعالي أو خِطابي"],["12F6BDF9-9B79-504A-931F-75089FC94215","ولمِ أُقدِم على وصلِ التَّصابي","مَخَافَة أن أُدَنّسهُ بعابِ"],["226FEF44-8126-52D8-9593-6B65C8FDC0CC","فداومت المُدامَ فَما أُبالي","ببالي إن تَخَطّى عن صَوابَ"],["4BDCCC02-CFFE-5D3D-8D19-1F72286239F3","فإن ظهرَ التَّصابي في يوماً","أحلتُ به على فِعلِ الشِّرابِ"]]},"8ADB5B9C-44E3-5A2F-ABFA-5945B5157390":{"t":"ولِمْ يفهَموا ما تكتبُ البيضُ في الوَغى","p":147,"s":"ولم يفهموا ما تكتب البيض في الوغى","r":"477642","v":[["49FF9AF2-7747-5702-8630-550D4059F3C8","ولِمْ يفهَموا ما تكتبُ البيضُ في الوَغى","ولا السُّمرُ حتّى أعجَما بالحوافِرِ"],["CF9DC35A-3C48-5430-A1A0-ABB490215745","تَسَرَّعَ حتَى خِلْتُ كلّ مُقَصِّر","مِن الخَيلِ مَحمُولاً على ظَهر طائِرِ"],["4718D918-F6AD-5D3E-A625-38A7F50FEBA4","وَحتَّى تَوهَّمنا النُّجُومَ أسِنَّةً","وَخِلنا الهَلاِلَ بينها إثْرَ حَافرِ"]]},"5DE1302E-6EA9-502F-B26D-D91D99A91EA9":{"t":"ومبُلبلٍ مِن صُدغِهِ العَطر الذَّي","p":147,"s":"ومبلبل من صدغه العطر الذي","r":"477626","v":[["14B26260-44D5-54DF-B7FC-03ECD83EE326","ومبُلبلٍ مِن صُدغِهِ العَطر الذَّي","أهدى ليَ البَلبْالَ دونَ حِجابِ"],["644F373C-DB0D-5686-BC8A-387DEDFD1924","وَحياةِ ما غَرسَ الحياءُ بخَدِّهِ","مِن وَردِه بعِتابه وَعِتابي"],["01FF943D-5046-5FAD-9F9D-5033D15F46B5","لأغرِّرَنّ بمُهجِتي في حُبِّه","غررِاً يُطيلُ مع الَخُطوب خِطابي"],["0E47F03B-845A-587C-8CFD-2E282A132FBA","ولَئن تعزَّز إنَّ عندي ذِلَّةً","تَستَعطِفُ الأحبابَ للأحبابِ"]]},"86D9A55B-3E5D-5F97-94F6-1E21849D2D00":{"t":"ومَحطُوطةِ المتنَين مَهضُومةِ","p":147,"s":"ومحطوطة المتنين مهضومة","r":"477649","v":[["6383D7F2-9855-5409-B0EA-47FE6AE40BD9","ومَحطُوطةِ المتنَين مَهضُومةِ","مُنعَّمةِ الأرداف تدمَيٍ مِن اللمْسِ"],["4CD26EA8-F228-5180-8D23-D83F2303D6EC","إذا ما دُخانُ الندِّ مِن جَيبها عَلا","على وَجهِها أبصرتَ غَيماً على الشَّمسِ"]]},"84DF6760-2932-5E1D-8C36-5B428B2C2F59":{"t":"ومَعذَّرِ نقشَ الجَمالُ بمسكِهِ","p":147,"s":"ومعذر نقش الجمال بمسكه","r":"477632","v":[["54F35255-3FFE-5799-A276-70101424136F","ومَعذَّرِ نقشَ الجَمالُ بمسكِهِ","خدَّاً له بِدَمِ القُلوب مُضَرَّجا"],["ECF95503-4265-5293-A3C9-8C844C3AF7F6","لمّا تيقنَ أنَّ سَيفَ جَفُونِهِ","مِن نَرْجسٍ جَعلَ النِّجادَ بَنَفسَجا"]]},"09D71F47-5497-5AB2-9BC7-1042C779D184":{"t":"وهَبنِيَ قد أنكرتُ حُبكَ جُملَةً","p":147,"s":"وهبني قد أنكرت حبك جملة","r":"477651","v":[["D3A0D887-FD77-51B7-9EA2-65F620AC15D8","وهَبنِيَ قد أنكرتُ حُبكَ جُملَةً","وآليتُ أنِّي لا أرومُ محَطَّها"],["8E237BC5-8070-5108-9133-BDD41CAAFE33","فمِنْ أين لي في الحُبِّ جَرحُ شهادَةٍ","سَقاميَ أملاها ودمعيَ خطَّها"]]},"2D2E129C-26F4-5FF1-AE04-8485C524A6D5":{"t":"وَحالِكِ اللونِ كاللّيل البَهيم لهُ","p":147,"s":"وحالك اللون كالليل البهيم له","r":"477661","v":[["B952A94A-9690-5DA0-BAAE-A3A770A4EC41","وَحالِكِ اللونِ كاللّيل البَهيم لهُ","فَضائلٌ مُشرقاتُ الحُسن كالفَلقِ"],["A59CEAF8-768A-5672-863E-8F184FAABF0E","تَنُوبُ عن نُطقِهِ ريحٌ مؤثّرَةٌ","في قَلب مُصطبح أو لبِّ مُغتَبقِ"],["C8CC34F8-3E0D-5999-8859-0CA58F7B5756","تَخالُ مَجلسَنا وَجهَاً بهِ حسناً","إذْ صَارَ فيهِ كخالٍ مُعجبِ لَبَقِ"],["EACFC384-C54B-51E4-B052-D2C02DDE6D2F","كأنَّما كفّهُ مِنْ زَمْرِهِ سُلبَتْ","أو زَمرُهُ مِنْ يَديهِ جِدُّ مُستَرَقِ"],["DBA595CD-166D-5183-9EB1-A1695F9497B4","يَحدو بأنفاسِهِ الأوتارَ مُجتهداً","فتَستَقيمَ به الألحانُ في الطُّرقِ"],["FEEEB49C-D576-5BFA-BC37-9B474B382753","أهدى الشِّيابُ إليه حُسنَ بَهَجتِهِ","فَناسبَ المِسكَ في لَونٍ وفي عَبَقِ"]]},"1E3C1137-0F48-515F-A85B-36FF167636CC":{"t":"وَحَبيب قَدْ ضَنَّ بالوَصلِ تيْهاً","p":147,"s":"وحبيب قد ضن بالوصل تيها","r":"477664","v":[["BBFF6589-A10F-57C8-8027-05BFCADED1D3","وَحَبيب قَدْ ضَنَّ بالوَصلِ تيْهاً","هل تَضِنُ البُدورُ بالإشراقِ"],["E3A90D00-D3C4-5E45-B12C-F490EFD469BD","أنا أخشى إنْ دامَ ذا الهَجرُ يُن","شط مِن حُبِّهِ عِقالَ وَثاقي"],["BA94B92F-D575-56C8-9173-AED9F8787E30","فأُريحَ الفؤادَ مِمّا اعتَراهُ","وَأرادَّ الهَوى عَلى العُشاقِ"]]},"25BA1CCF-0E9F-5A5B-89C7-EDE2A2BFD1D8":{"t":"وَقفتُ على رَسمِ الدِّيار مُسائِلاً","p":147,"s":"وقفت على رسم الديار مسائلا","r":"477666","v":[["E5EFFF7B-46A4-5B8D-9213-DE07F11B850B","وَقفتُ على رَسمِ الدِّيار مُسائِلاً","وَهلْ يَشتَفي مِن لَوعةِ الحُبِّ سُؤالُ؟"],["E44F2A92-4FF9-55EA-A293-0798B6BF7791","فألوَى رُسومَ الصَّبرِ رَسمٌ مِنَ اللّوى","وَطلَّ دُمُوعي بالسَّبيَّةِ أطلالُ"],["13497304-877A-5AC9-8BB9-07DBB1CCD417","يُحيّي بها صَوبُ الحَياءِ مَعالماً","خَلَعنَ عليهنَّ المحاسنَ أنوالُ"],["B4012F74-DF1B-5324-9A18-EA502ACFE496","فَما رُوضتْ أرضُ المِهادِ مَلاحفٌ","وَزَهرُ رُباها الحَليُ والنَّورُ خَلخالُ"],["4B50963E-280E-5200-B204-54CAACC0948A","وَوقاَء تَستَملي حَنينيِ بنَوحِها","كِلانا على عَهْدِ الأحِبَّةِ هِدَّالُ"],["524ABA0E-4B87-5AC8-8E22-0EFB5FCC02E8","وإني إذا ما ازوَرَّ عَني مَنْزلٌ","رَمى الحلَّ في قُطريِهِ شدٌّ وتَرحالُ"],["6F7BBEF1-1A48-5C73-A356-17A2CD41351E","أُقيمُ إذا ما العِزُّ وَطَّدَ مَفرشي","وَأنبُو إذا ما أعقَبَ العِزَّ إذلالُ"],["AE474AAF-C1E3-58CF-B3EA-B0BD87D2E402","أنا ابن السرى إنْ ملّني مَتنُ سابق","تَسلَّمني شَخْتُ الجُزارةِ مِرقالُ"],["0E4BC2BD-CFD8-51BD-8317-56C5E86FC0EF","كأنَّ الفَلا ظئرٌ لها اللّيلُ حَجَلةٌ","تَحِنَّ إليها مِن رِكابيَ أطفالُ"],["E21284A9-428A-5765-AD13-6B7F395E5D1F","تُفَوزُ في قَطعِ المفْاوز جُرأتي","إذا كاعَ عَنْ قَطعِ المَجاهِل جُهّالُ"],["9C19C271-9C8D-56AA-A120-7B795BE06184","إذا البَدرُ جَلَّىَ وجْهَهَ البَرّ نورُهُ","فَمدَّهُ ظِلِّي فَوقَ وَجْنتِهِ خالُ"],["A1ED4884-B64C-528A-ACBC-E026BF1AAFB2","سَقَى حَلباً والحَيَّ مِنْ آلِ عامرٍ","هَزيمٌ تَوالى مِن نَشاصِكَ مِهطالُ"],["50A1405E-6228-5009-9620-AD892AB74218","فَكَم أثْمرَتْ فيه القَنا مِنْ مُنَاقِفٍ","وَكَم أتعَبت فيه الصَّوارمَ أبْطالُ"],["63D98798-1355-5F87-9051-200388DED346","إذا خَطبُوا العلياَء يَومَ كَريهةٍ","فأسيافُهم فيها مُهُورٌ وَأجعالُ"],["3205994A-755F-5FC7-B476-ED54FED39E61","بِيُمن مِعزِّ الدَّولةِ انكشَفَتْ لنا","مِنْ الدَّهر أحوالٌ مَرَتهُنَّ أحوالُ"],["EF12F5FE-4A29-571E-8718-F9F7C757FD79","تَجافَى مُحيّا المالِ حتّى كأنَّما","يُقابلُه مِنه وَشاةُ وعُذَّالُ"],["FF9A44A2-742D-56A9-897C-2D69161010B6","كأنَّ الوغى طَرفٌ لهُ الجَبلُ مَحجرُ","له النَّقعُ أكحالُ لهُ الزَّانُ أميالُ"],["51BDF516-2A3B-5A10-8C27-0EB4D5AF7FBB","وأسْمرَ عَسَّالٍ إذا احتَدمَ الوَغى","تَصدَّقَ مِنه الزَّادَ أطلسُ عَسَّالُ"]]},"0934426E-0F3A-5BA9-B640-C0E0A7B66D64":{"t":"وَكاتبٍ أهديتْ نَفسي لهُ","p":147,"s":"وكاتب أهديت نفسي له","r":"477647","v":[["0245BE2D-99C9-51CF-B521-9FB914ADB428","وَكاتبٍ أهديتْ نَفسي لهُ","فَهيَ مِنَ السُّوءِ فِدا نَفسِه"],["26978D96-CC48-5909-8739-85A679DF7E49","سلَّطَ خدَّيهٍ على مُهجَتي","فَاستأصلاها وهي مِن غَرسِهِ"],["77443D0B-D3E7-52DD-8748-6BED7B273E9F","كِأنَّما خَطّ على خَدِّهِ","مِثلَ الذي قَد خَطَّ في طِرْسِهِ"],["804FE4C4-0DC4-5002-BB27-C56622136F79","فلَست أدري بَعدَ ما حَلَّ بي","بِمسكِهِ أتلفُ أمِ نِقسِهِ"]]},"C264EC12-2503-5C9B-9CF5-6C33FAD55EC8":{"t":"وَكيف نَرجو السحابَ الجَودَ مِن رَجُلٍ","p":147,"s":"وكيف نرجو السحاب الجود من رجل","r":"477628","v":[["CEF56197-50C1-5191-8709-456A72097D8E","وَكيف نَرجو السحابَ الجَودَ مِن رَجُلٍ","لا يطمعُ الطيرُ فيه وهو مَصلوبُ"],["B0BB59E5-5857-5943-9D74-2D835B46E8D0","أصبحتُ أحلبُ تَيساً لا مَدرَّ لَهُ","والتيسُ مَن ظنَّ أنَّ التَّيس مَحلوبُ"]]},"8CB49DDF-D7D8-5D26-93A6-F5E90893CD05":{"t":"وَليْلٍ تَجلَّى الصُّبح في جَنباتِهِ","p":147,"s":"وليل تجلى الصبح في جنباته","r":"477622","v":[["A8DCE942-3EF8-5B35-B443-BC23D5841863","وَليْلٍ تَجلَّى الصُّبح في جَنباتِهِ","سَنا بارق في لُجَ بحر تَعبَّبا"],["B4B46C87-1514-59EE-8DBF-27D56BA99ECE","أحاطت بآفاقِالسماءِ خِيامُهُ","وَطبقَ شَرقاً في البلادِ ومغربا"],["54440EFC-86D6-5EA5-AD29-B3012FFADC69","نَفى طولُهُ عني الرُّقادَ كأنَّما","يَغارُ على الجَفنين أنْ يتركَّبا"],["A5BB3BDB-46F2-5D98-A8E8-5DDA210E99BF","تَعانقَ كِيوانٌ وبهرامُ وَسطَهُ","على الحِقد في صَدريَهما وَتَرحَّبا"],["C91EC36D-0DE0-5351-90A0-77207AD20F8C","غَريبان خافا الضغنَ في دار غُربة","ورُبت ناسٍ ضِغنَهُ إذ تَغرَّبا"],["84AE315F-C205-5FBA-B961-200EF6AF1D8E","فَبت أُحيل الطَّرفَ أرتادُ فَجرهُ","كما ارتادَ ذو الشِّوقِ الحَبيبَ المُحجَّبا"],["E7F9EB59-1F01-5891-A005-4DD15F6BB2E2","كأنَّ النَّجومَ الزُّهرَ فيه خَرائِدٌ","تُطالِعُ مِن زُهر الكواكِب رَبْرَبا"],["16E71011-87F2-5EB8-99E6-B4B2F3B1E5F2","تُودِّعُ مَنْ تَهوي بكَسر جُفونِها","وتُكثرُ مِن خوفِ الوُشاةَ التَّرقبا"],["239B92EA-B9D8-5955-8DC9-2F315D5855E4","وإلاّ كغِزلان النَّصارىَ تَدرَّعوا","بسُود مُسُوحٍ للصَّلاةِ ترهُّبا"],["07FC1026-EC4B-5E87-9B10-9D06E0DD3082","كأنَّ ثريَّاهُ أناملُ فِضةٍ","تُقلَّب تُرساً مِن سَنا اللّيل مُذهَبا"]]},"7F9F008B-4D00-51E6-8296-EC78382B940C":{"t":"وَمَخمور الجُفُونِ بلا خُمارٍ","p":147,"s":"ومخمور الجفون بلا خمار","r":"477633","v":[["D49F71E0-8383-5473-876F-14E6842DB32E","وَمَخمور الجُفُونِ بلا خُمارٍ","حَكى بَدرَ الدُّجى حُسناً وبَعدا"],["4ECA2C35-F9FE-5E04-9B07-E8A6128D52FF","فما زالَتْ به حِيَلي إلى أن","دَنا وَرأى لَديَّ الغَيَّ رُشدا"],["997ED37E-919D-53B3-A223-63B9611C6355","وجادَ بقبلةٍ فشمِمْتً مِسكاً","وذُقُت مُدامةً وقَطَفتُ وَردا"],["E897F4E2-B343-54FC-B7E9-BC9009CE3DC2","فكان السُّكرُ لي سَبباً سَقانِي","على ظَمأ الهوى العُذْريّ بَردا"],["A8806995-3DC2-569E-BE2F-FE4BEC14CC05","فيا شِرباً وردتُ فكان عذَباً","ويا نَجماً لحَظتُ فكان سَعْدا"]]},"E4DBA687-AA34-53D1-BDCE-0A3B79A34E53":{"t":"وَمُعنّفٍ لي في المقُام ضَرورة","p":147,"s":"ومعنف لي في المقام ضرورة","r":"477676","v":[["C94A6B03-228D-5CAE-AE9E-1A5E43DC9E11","وَمُعنّفٍ لي في المقُام ضَرورة","بالقَيروانِ وما بها سُلطانُ"],["A0942335-6B22-5FA5-8D61-5F1EA53CDBE2","ألقَى الهَوانَ بها وَكَمَ مِن عِزَّةٍ","قد ساقها نَحْوَ الرِّجال هَوانُ"],["1DEEA045-C786-5843-9169-20DE39702347","جَهلُوا على الإحسانِ فيها مَوضعي","لو كان يَنفْعُ عِندهُم إحسانُ"],["1FC298AE-B2AD-5281-9BBF-528338E0B1F0","فكأنّني القرآنُ عندَ مُعَطلٍٍ","أو في بلادِ هَرابذ رَمضانُ"],["59BF21BE-68E5-57A0-A71A-F004EDA20CFD","ما الدُّر ينقُص فَضلهُ في بحْره","أنْ ليسَ تعرفُ قدْرهُ الحِيتانُ"],["31023F01-64AB-5D01-A844-781AB16115A5","كلا وَليسَ المِسكُ يَبطلُ عَرفَهُ","أنْ ضَيَّعتْهُ بجَهْلها الغِزلانُ"],["AA65DFF8-D712-5856-8089-EB220DD408D2","ما عَيبُ ضوء الشَّمس عندَ بُزوغِها","أنْ ليس يُدركُ نورها العميانُ"],["7EF15A87-BB0E-523B-977E-E289F585D711","واللَيثُ لا يَنسَى استَطَالَةَ بأسِهِ","إنْ ضَمَّهُ في خِيْسِهِ خَفَّانُ"],["902021F0-1F6C-5FE7-B133-8C90EF880BB1","أو ما تَرى الدَّنيا بِفَقْدِ مَليكِها","طَرْفاً ولكِن ما له إنُسانُ"]]},"2FEFC285-46B9-5C4E-AE8D-AF5E0384D82F":{"t":"يا حاديا وجِمالُ الحيِّ سائمةٌ","p":147,"s":"يا حاديا وجمال الحي سائمة","r":"477635","v":[["09443924-D4A8-5B6B-871B-CFCBF16E649A","يا حاديا وجِمالُ الحيِّ سائمةٌ","ماذا تُريدُ بقَلبي أيُّها الحادي؟"],["8600B298-9B7D-5920-AA36-41585136C72B","كلفتهُ السَّيرَ مِنِ جسمي ففارقَهُ","وهل يَسيرُ أسيرٌ مالهُ فادِ؟"],["8FE4AE4A-BFDB-5743-9CAA-672BAD919022","رِفقاً فقد هِجتَ شَوقَاً ما استعدَّ لهُ","فكيف يَرحلُ مُشتاقُ بلا زادِ؟!"]]},"4B6ABD30-4CDC-5FDE-B19D-5479E6B57759":{"t":"يا ذَا الَّذي خَطَّ الجَمالُ بَوجههِ","p":147,"s":"يا ذا الذي خط الجمال بوجهه","r":"477672","v":[["6FB8BDBF-79DD-547B-B3BF-3FF359C75F72","يا ذَا الَّذي خَطَّ الجَمالُ بَوجههِ","سطرَيْنِ هاجا لَوعةً وَبَلابلا"],["8304453D-15D7-566E-B1F6-4089D860CC99","ما صَحَّ عِندي أنَّ لَحظَكَ صارِمٌ","حتَّى لَبستَ بِعارِضَيكَ حَمائلا"]]},"C28E25D3-6847-558C-870C-2CA98DF421EC":{"t":"يا لائماً عِمرانَ لا تُنشدن","p":147,"s":"يا لائما عمران لا تنشدن","r":"477627","v":[["8C8D0873-6F49-5272-B4AC-5D60A2F8CB2D","يا لائماً عِمرانَ لا تُنشدن","عَمرو بنَ كلثومٍ ألا هُبِّي"],["6A3062D3-FC3C-5D46-9E5C-18ACBE65D5F3","طمعتَ في كلبٍ فدارَيتَهُ","والكلبُ مَن يَطمعُ في كلبِ"]]},"62B02F04-47D8-5A83-B505-3F491091634D":{"t":"يا لَيلُ هَلاَّ انجَلَيتَ عَنِ فَلَق","p":147,"s":"يا ليل هلا انجليت عن فلق","r":"477663","v":[["D7E7064F-0A1B-5962-83D0-7876D63D17A8","يا لَيلُ هَلاَّ انجَلَيتَ عَنِ فَلَق","طُلتَ وَلا صَبرَ لي على القَلَقِ"],["8491E80C-178C-5088-91FA-4C7479C2117B","جَفَتْ جُفُونِي الآماق فيكَ فَمَا","تُسبَلُ أشفارُهاَ على الحَدَقِ"],["45A53F20-B3ED-5EBF-AB7B-619992B52EE5","كأنني صُوَرةٌ مُمَثلةٌ","ناظرُها الدَّهرَ غَيرُ مُنطبقِ"]]},"C0C69BF4-59B5-5249-B587-B890F38FC50B":{"t":"يا مُزْمعاً عَن مُلْكه وسريره","p":147,"s":"يا مزمعا عن ملكه وسريره","r":"477667","v":[["6CD28911-49E0-5E58-A1B3-10C70D7D039C","يا مُزْمعاً عَن مُلْكه وسريره","ماذا أضرَّكَ لو لبثْتَ قليلا؟"],["E1DBC66C-55DC-57F6-9954-9B63586EC34D","طَلَّتْ رزَيَّتُهُ دَمي إن لمْ أدَعَ","دَمَ مُقلتي في لَحْدهِ مَطلُولا"],["D5F3897E-DE4F-5E49-9BF3-8520A5641881","يا تاركاً رُسُل المُلوكِ ببابهِ","مَنْ ذا يَردُّ عليهمُ التَّجْميلا؟"],["63837155-DF98-5ACB-979F-586F13695F34","أرَحَلتَ ثُم تَركْتَنا ولَقَبلَ ذَا","كُنَّا نَحُفُّ إذا أرَدتَ رَحيلا"],["D398199E-C20F-59D8-8C2F-35C226F7DBBE","أتُرى دَليلَكَ في السَّرايا غَرَّةُ","خَطأٌ فَسارَ إلى الحِمامِ دليلا؟"],["9582F626-1343-5AF2-9899-97AC243B5193","صِرْنا نُقبلُ قَبَرهُ وَلَطالما","كُنّا نُبيح بِساطَهُ التَّقبيلا"],["ECA6F563-8241-502C-B32E-AA7BF694AEEB","جَدَثٌ غَدا جَفْناً لأبصر ناظِر","أمسىَ وَأصبَحَ بالرَّدى المَصقُولا"],["802F15F1-8418-5803-871B-6D542E6FD35D","يا قبرُ لِمْ نَعرق تَشتَتَ شَمِلناً","حتّى غَمَدْتَ الصَّارمَ المَصقُولا"],["10FA5AEF-13F7-5871-A5EC-5492C6A59992","ظَلنا نَشقُّ جُيوبَنا مِن بَعد أنْ","كُنا نُجررُ مِن ذَراهُ ذُيولا"],["714D9548-8D26-511B-AD6F-93118A13818F","ونَعُبُّ كاساتِ الدّموعِ كأنَّنا","في أُنس مَجلسهِ نَعبُّ شَمولا"],["FE206395-C872-5E8D-A9A5-4D0EB69FFBEA","عُذِلَ البكاءُ فظلَّ يُنشدُ نَفسَهُ","بيتاً يُمَهِّدُ عَذرَهُ المَقبولا"],["3A6BE825-983F-551E-A038-CEAC5056727F","رَدُّ الجَمُوح الصَّعبِ أيسَرُ مَطلَباً","مِنْ رَدِّ دَمعٍ قَد أصابَ سَبيلا"],["F60DF872-A086-526D-873E-0CEB46551522","ما للرِّماحِ قصُرْنَ عَنَ دَركِ المدى","وَرأينَ حَمل نُصُولهنَّ فضُولا؟"],["4935579D-7C81-558E-AEAD-1A0FC28EC899","ولَقبلُ كَنَّ إذا رأينكَ عازماً","عاينَّ طُولكَ فاستفدنَ الطَّولا"],["EE797800-3F62-5171-A035-69F60247F8C7","لَبِسَ الحِدادَ حَديُدهنَّ فما نَرى","إلاّ سِناناً مِن صَداهُ كَليلا"],["5F7D0394-CEE7-59D5-89B0-ED058A3E34D3","تَبَكِيكَ أقلامٌ زَهَتْ مِن عُظمِ ما","كتَبتْ فُتوحَكَ بُكرةً وأصيلا"],["42E80C3A-05B3-50C3-9512-609714643273","وبُحورُ شَعرٍ غاص مدحُكَ فانتقى","مِنْهنَّ دُرّاً في النّظام جَزيلا"]]},"9E1395F1-1909-5194-BF4E-D777333B1F18":{"t":"يَغرسُ وَرداً ناضِراً ناظري","p":147,"s":"يغرس وردا ناضرا ناظري","r":"477653","v":[["C1D8BF07-BDD1-52B9-ABDE-13FD965040E6","يَغرسُ وَرداً ناضِراً ناظري","في وَجنةٍ كالقمر الطَّالعِ"],["82B08FBA-FBA7-5FB3-AE63-15A704F797DE","أُمنع أن أقطِفَ أزهارَهُ","في سُنةً المتُبوعِ والتابعِ"],["49C59B30-642A-5B1A-8ED3-2D54A3B8F11C","فَلِم منعتم شفَتي قَطفَها","والحُكمُ أنَّ الزَّرعَ للزَّارعِ؟!"]]}}}