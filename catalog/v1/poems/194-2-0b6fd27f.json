{"v":1,"poems":{"7A1A11C7-23FD-5178-B8EF-E64732ECBE0D":{"t":"ومسرى ركاب للصبا قد ونت به","p":194,"s":"ومسرى ركاب للصبا قد ونت به","r":"441719","v":[["BF2CFCA6-2AB1-5030-976E-6A7328BFE3C0","ومسرى ركاب للصبا قد ونت به","نجائب سحب للتراب نزوعها"],["CE086BB3-DE5A-5B44-88D3-190B6C324599","تسل سيوف البرق أيدي حداتها","فتنهل خوفا من سطاها دموعها"],["730AFFE9-2B03-567E-B8FE-4C11A9113369","تعرضن غربا يبتغين معرسا","فقلت لها مراكش وربوعها"],["19418F40-DDE8-583D-9A3C-90776813B0EE","لتسقي أجداثا بها وضرائحا","عياض إلى يوم المعاد ضجيعها"],["BF09C363-3103-53D4-99C8-A640906E4CF3","وأجدر من تبكي عليه يراعة","بصفحة طرس والمداد نجيعها"],["402912DB-B2ED-571B-AE07-93949AD29EE5","فكم من يد في الدين قد سلفت له","يرضى رسول الله عنه صنيعها"],["D121A537-F05C-5C35-8DB8-F35597FDF944","ولا مثل تعريف الشفاء حقوقه","فقد بان فيه للعقول جميعها"],["B4D21AFD-B3A5-5029-81FE-96D9F15C6304","بمرآة حسن قد جلتها يد النهى","فأوصافه يلتاح فيه بديعها"],["C1389677-DF66-527A-BA7A-C26CC089DED6","نجوم اهتداء والمداد يجنها","واسرار غيب واليراع تذيعها"],["DC982354-0958-52C9-AD91-2F0AD65F43DC","لقد حزت فضلا يا أبا الفضل شاملا","فيجزيك عن نصح البرايا شفيعها"],["E9B286FA-7119-55B9-B137-D1FBA429903B","ولله ممن قد تصدى لشرحه","فلباه من غر المعاني مطيعها"],["D3CF2C34-207E-5C0F-AB04-B044F536DBEC","فكم مجمل فصلت منه وحكمة","إذا كتم الإدماج منه تشيعها"],["A7BDE4D3-8731-571B-8104-C203B67E9657","محاسن والإحسان يبدو خلالها","كما افتر عن زهر البطاح ربيعها"],["68DDF2EF-9252-5961-B1D6-670DDF8C10EE","إذا ما أجلت العين فيها تخالها","نجوما بآفاق الطروس طلوعها"],["9FABCDB6-55C2-5D7F-A7A1-E6A5BAC9A2AB","معانيه كالماء الزلال لذي صدى","والفاظه در يروي نصيعها"],["36435EA9-0464-5353-91C9-0C509918C9FE","رياض سقاها الفكر صوب ذكائه","فأخصب للوراد منها مريعها"],["61EC1F0E-E3E6-5B25-BFAB-983259726F40","تفجر عن عين اليقين زلالها","فلذ لأرباب الخلوص شروعها"],["8421C6E2-F703-5BE7-B4E6-63432A5CCA20","الا يا ابن جار الله يا ابن وليه","لأنت إذا عد الكرام رفيعها"],["7B3D629E-20D7-5A91-AF02-1F2D709E9491","إذا ما أصول المرء طابت أرومة","فلا عجب أن اشبهتها فروعها"],["C13213A3-5BD8-5AD0-BA97-E30F05EFB3EA","بقيت لأعلام الزمان تنيلها","هدى ولأحداث الخطوب تروعها"]]},"B0125E9D-00D9-511B-BAF2-F0C578ECC8E1":{"t":"ومشتمل بالحسن أحوى مهفهف","p":194,"s":"ومشتمل بالحسن أحوى مهفهف","r":"441679","v":[["AB72DBEB-D489-528C-B9DE-AB4A3FBBC2BB","ومشتمل بالحسن أحوى مهفهف","قضى رجع طرفي من محاسنه الوطر"],["DC0357B1-2B93-52B2-B6E1-2781C886E074","فأبصرت اشباه الرياض محاسنا","وفي خده جرح بدا منه لي أثر"],["91A5F62A-2403-50E9-9203-AF20B4C4B2BC","فقلت لجلاسي خذوا الحذر إنما به وصب من أسهم الغنج والحور","..."],["39753DAD-8B1D-5BA1-9DB1-64E3EA8FE4A1","ويا وجنة قد جاورت سيف لحظه","ومن شأنها تدمى من اللمح بالبصر"],["8C54500F-43C6-5C42-9332-A4289D0ECB23","تخيل للعينين جرحا وإنما","بدا كلف منه على صفحة القمر"]]},"2E20C172-60E3-54F8-B2A0-8DBA092B2279":{"t":"يا أيها المولى الذي أيامه","p":194,"s":"يا أيها المولى الذي أيامه","r":"441648","v":[["7899BD21-B1C8-54CC-8869-A68D63B624BF","يا أيها المولى الذي أيامه","تهمي بسحب الجود من آلائه"],["C639D578-7D2C-5D9F-9511-2E5F176398D5","أبشر لجيشك بالسعادة كلها","يغزو ونصر الله تحت لوائه"]]},"16E97F0D-83B0-5317-94DF-B9947F5B3FD7":{"t":"يا أيها المولى الذي بركاته","p":194,"s":"يا أيها المولى الذي بركاته","r":"441684","v":[["9BB565E7-FEF6-51D4-A631-B4C7B4769840","يا أيها المولى الذي بركاته","رفعت لواء للندى منشورا"],["8F80CA76-511E-506E-8BEE-DD77B42D09D4","لك راحة تزجي الغمام بأنمل","فجرت منها بالنوال بحورا"],["20E8F8CD-7529-52FC-8838-76B26D54B1BF","واليوم موسم قربة وعبادة","وغدا ظفرت بأجره عاشورا"],["3ED64B72-23A5-53F5-93CF-5F94D2C00CCC","راعيت فيها سنة نبوية","تروي الثقات حديثه المشهورا"],["FF2373D6-3C81-5F9B-A93E-AC31D93A0C2F","لا زلت عامك كله في غبطة","لقيت منها نضرة وسرورا"]]},"DA5FEBDD-6667-502F-869D-96AF0F780663":{"t":"يا إماما قد تخذناه","p":194,"s":"يا إماما قد تخذناه","r":"441677","v":[["8C43CB7C-4C3C-5468-99DB-EDB1BCB1D381","يا إماما قد تخذناه","من الدهر ملاذا"],["54F06066-8C28-50E1-A988-FDC3251BD337","خط يمناك ينادي","صح هذا صح هذا"]]},"EC17232D-96DB-5A22-BDA7-015913039A30":{"t":"يا ابن نصر لك ملك","p":194,"s":"يا ابن نصر لك ملك","r":"441660","v":[["EC11A500-C4B2-5CFF-95EC-FC5A90385F47","يا ابن نصر لك ملك","ليس تعدوه الفتوح"],["7193B2CC-801B-5482-ACC8-C0B78AE43DE5","دمت روحا للمعاني","ما سرى في الجسم روح"]]},"D8C8DD1E-0B7D-56C6-A729-091D348E085B":{"t":"يا بدر تم في سماء خلافة","p":194,"s":"يا بدر تم في سماء خلافة","r":"441713","v":[["D12893AA-358F-5286-B269-53BD227B9FF7","يا بدر تم في سماء خلافة","حفت نجوم السعد هالة قصره"],["A9D5900C-6180-51BE-842A-1D0B45776489","ألبست عبدك من ثيابك ملبسا","قد قصرت عنه مدارك شكره"],["675DC675-1EFF-5FB5-B0B0-A46ADA53AA76","ورضاك عنه خير ما ألبسته","فلقد أشاد بجاهه وببره"],["B1A53562-9DEB-5E6E-BA1D-FB307A8BB9BC","ألبستني أركبتني شرفتني","أهديتني ما لا أقوم بحصره"],["5E4C3E9B-4450-5CB1-ADEA-25F9CB5C6478","نظري بوجهك وهو أجمل نير","يزري على شمس الزمان وبدره"],["4D093960-D880-5FF3-BF0F-B22A5DA92F4E","أعلى وأعظم منة لا سيما","وأنا المنعم في الحضور ببشره"],["8D64EC3A-32DF-531F-BB69-09C28A84E3AA","لا زلت مولى للملوك مؤملا","وحلاك للإسلام مفخر دهره"]]},"93BF6691-FD70-5E0C-B736-B0EC09827B96":{"t":"يا خير من ملك الملوك","p":194,"s":"يا خير من ملك الملوك","r":"441727","v":[["AD27B077-902F-5A0E-B8B7-DAB7D6442E5D","يا خير من ملك الملوك","أهديتني حب الملوك"],["BCA8CFE7-6DBF-5815-8B73-A80FE38C0F80","فكأنما يا قوتها","نظمت لنا نظم السلوك"],["ACE89344-7914-5ADF-8AB0-C5369407FE26","إن الملوك إذا لحوا","فغياثهم أن أملوك"],["5C24CF55-C13A-5B8F-9C56-16C74F997565","وكذا العفاة إذا شكوا","فغناهم أن يسألوك"],["9257D278-4D7C-5065-A18B-D20E1590F47F","فالله يقبل من دعا","لعلاك من أهل السلوك"],["A0A09BDB-AAA5-5038-935D-A4C046837456","لا زلت تطلع غرة","كالشمس في وقت الدلوك"]]},"E2D686CA-C12E-52EF-AE42-4B0590349AAC":{"t":"يا خير من ملك الملوك بجوده","p":194,"s":"يا خير من ملك الملوك بجوده","r":"441728","v":[["A33E8C84-EA9C-5663-BDCA-32958075211E","يا خير من ملك الملوك بجوده","ولفضله قد أشبه الأملاكا"],["22C89DA1-FC2B-5B38-A446-4774DE0DC458","والله ما عرف الزمان وأهله","أمنا ويمنا دائما لولاكا"],["AE5C58B2-6532-5B29-862E-221B47AF147E","وافيت أهلي بالرياض عشية","في روض جاهك تحت ظل ذراكا"],["F3E3DEBC-1708-522B-A4F9-22B706EE3F11","فوجدته قد طله صوب الندى","بسحائب تنهل من يمناكا"],["07F6F363-2944-58E7-84DD-D8EC963B2F86","وسفائن مشحونة القى بها","بحر السماح يجيش من نعماكا"],["1F4293BA-11BC-5D9A-984A-E35D5D85DFC1","رطب من الطلع النضيد كأنها","قد نظمت من حسنها أسلاكا"],["993EEA2B-2373-50E5-B5D3-997F76DB0BC7","من كل ما كان النبي يحبها","وأحبها الأنصار من أولاكا"],["DA3664E0-A83D-5921-A5A4-009E3CCBA7C4","وبدائع التحف التي قد أطلعت","مثل البدور أنارت الأحلاكا"],["1F93DE09-AFA4-535F-B2F2-304C68C56BF1","نطف من النور المبين تجسمت","حتى حسبنا أنهن هداكا"],["845B6593-F07C-5195-B7E6-466868E3E406","يحلو على الأفواه طيب مذاقها","لولا التجسد خلتهن ثناكا"],["976AD9CC-AFC3-5078-8E2C-F2A52545B244","طافت بها النشأ الصغار كأنها","سرب القطا لما وردن نداكا"],["43180ADD-0A5B-5F3F-BB37-00B5EB15116B","نجواهم مهما سمعت كلامهم","ونداؤهم مولاي أو مولاكا"],["22628DFA-BC92-5A71-A1F0-F4717B371C42","بلغت في الأبناء عبدك سؤله","لا زلت تبلغ في بنيك مناكا"],["99D4DF7F-105F-54BB-95A9-D04481894F36","يتدارسون من الدعاء صحائفا","كيما يطيل الله في بقياكا"],["ACB077BF-0EA2-58CD-BC9E-C153245292E8","فبقيت شمسا في سماء خلافة","وهم البدور أمدهن سناكا"]]},"F70AF666-0BB4-5464-88B3-9EDD60AA6EF7":{"t":"يا خير من ورث السماح عن الألى","p":194,"s":"يا خير من ورث السماح عن الألى","r":"441756","v":[["9785C497-454B-519F-8B17-4AF21B9B5095","يا خير من ورث السماح عن الألى","نصروا الألى وتبوأوا الإيمانا"],["870DFFAB-CFB4-5C6C-8530-34D46CDBCADA","في كل يوم منك تحفة منعم","وإلى الجميل وأجزل الإحسانا"],["4813C069-C237-5762-93A8-C5E16A821341","قد أذكرت دار النعيم عبيدة","وتضمنت من فضله رضوانا"],["358332D6-4ADF-5FAD-94F3-CD0123254B21","تهدي موالي الذين تفرعوا","عن روح فخرك في العلا أغصانا"],["CDAB899F-0539-54FA-B8B4-7F8A69D02710","لجلالك الأعلى قنيصا أتعبوا","في صيده الأرواح والأبدانا"],["BBF10E29-6B0B-5817-BD62-9C8A13C52B75","فتخصني منه بأوفر قسمة","فسحت لعبدك في الرضى ميدانا"],["6702E91B-8282-5568-BC49-9FECC4B98AA0","لله من مولى كريم بالذي","تهدي الموالي يتحف العبدانا"],["673DA278-EF9C-5C91-8EC9-CB336A2D5620","تدعو بني إلى الغني بربه","يا ربنا أغن الذي أغنانا"],["4EEB1183-D5DD-595E-A277-A02F84047C8D","وعليك من قوس الإله تحية","تهديك منه الروح والريحانا"]]},"EC4ED516-C8FF-565C-AB90-BB6E154AE250":{"t":"يا فرجا عللت نفسي به","p":194,"s":"يا فرجا عللت نفسي به","r":"441743","v":[["51429EB2-A4BE-598B-AA5C-74F06AF4B8F7","يا فرجا عللت نفسي به","والفال محبوب لتعليله"],["B57D0343-4DEA-581F-A73F-04703A77C955","حرمت إحليلك هذا على","نفسي وأفتيت بتحليله"]]},"70F8E938-209E-5B5E-8115-F8EF7331EB8A":{"t":"يا من به رتب الإمارة تعتلي","p":194,"s":"يا من به رتب الإمارة تعتلي","r":"441759","v":[["C1D4C1DA-54EA-5FE7-B1D9-D2158CCE419B","يا من به رتب الإمارة تعتلي","ومعالم الفخر المشيدة تبتني"],["12C90DA0-319D-593E-80C3-025647B35EE4","أرجز بهذا الثلج فألا إنه","ثلج اليقين بنصر مولانا الغني"],["AF006A67-67C0-5CD4-A1AD-C210D560E951","بسط البياض كرامة لقدومه","وافتر ثغرا عن كرامة معتني"],["858457FC-BFD5-5560-8BC8-FA54EAD16514","فالأرض جوهرة تلوح لمجتل","والدوح مزهرة تفوح لمجتني"],["DCCBC8BD-CB5A-5B8C-971B-C7FE2C16F3DD","سبحان من أعطى الوجود وجوده","ليدل منه على الجواد المحسن"],["33B110DD-8318-5D0D-B805-AF69C00C2902","وبدائع الأكوان في إتقانها","اثر يشير إلى البديع المتقن"]]},"5C04FBA0-2DA4-588A-B1C3-385CCAAC6EA9":{"t":"يا من تمد له الملوك أكفها","p":194,"s":"يا من تمد له الملوك أكفها","r":"441647","v":[["54212122-84AC-5315-8079-0F7A41B5F360","يا من تمد له الملوك أكفها","تدعو الإله له بطول بقاء"],["349A97F4-5858-59AD-8833-E9EA685C9FD7","اضحى ولي العهد نجلك صائدا","شأن الملوك العلية العظماء"],["12C05FCE-493E-539A-B91C-5DD5D2FE84E9","ورمى البزاة على القناة يصيده","صيد الخليفة شارد الأعداء"],["CA04D18A-1A7C-58D2-9649-14F394A81A90","من كل خافقة الجناح إذا مشت","تبدي اختيال الغادة العذراء"],["7F7DFFF0-995C-5609-9358-EAD4E6590F94","أهدت لنا سبج العيون وطوقت","أرجاءها بعقيقة حمراء"],["A381123E-ED57-5A7F-B39A-92A2B033A656","واستاقت الياقوت في منقارها","ومشت على المرجان في استحياء"],["54F690DA-6B88-575D-BEB5-8176B7452D95","ووشت يد الأقدار في أعطافها","وشيا زرى بالحلة السيراء"],["C1C839D0-9CDB-5E68-9DE2-6606ECAEB6FC","ملك الطيور أتى إلى ملك الورى","فاستاقها لمؤمل الخلفاء"],["A22BD7A0-2A86-58E3-8FC2-7387A422FC68","وقضى سماحك أن تجود ببعضها","للعبد تعليه على الجوزاء"],["34A9D8DB-C1EC-5EB8-A248-71FEDCCEFC5F","لله هل شرف يضاهي ذا الذي","أوليته من منة غراء"],["1EB24AE4-81A3-5D7B-AD45-4D195204BA1F","هيهات أين جزاؤها من شكره","يجزيك عنا الله خير جزاء"],["6B586E57-54C1-58B3-B75A-0F027ED0B6FA","أولست قد أوليت كل خليفة","شرقا وغربا أصوب الآراء"],["F1E52378-6A17-50FF-B6E0-E3041D947D54","فلصاحب الصفراء فخر خالد","يحظى به من صاحب الحمراء"],["244C05D2-8347-5A40-B2DA-6A89837E0A95","بيضا وسمرا قد شرعت لنصره","وأعنت بالبيضاء والصفراء"],["91656888-72C9-5028-942D-02A405790CD3","لا زلت شمس خلافة أبناؤه","مثل البدور بمرقب العلياء"]]},"59EE39D4-D965-5146-89C4-C01B4F31508C":{"t":"يا من له الوجه الجميل إذا بدا","p":194,"s":"يا من له الوجه الجميل إذا بدا","r":"441731","v":[["35FD476D-30EC-5764-82B8-B964B2E93CAC","يا من له الوجه الجميل إذا بدا","فاقت محاسنه البدور كمالا"],["1F3C9FF7-01CC-526B-B9B0-52787B2A0730","والمنتقى من جوهر الفخر الذي","فاق الخلائف عزة وجمالا"],["425E3C11-8DCB-564F-9B44-ACA58BA32F92","ما ابصرت عيناي مثل هدية","أبدت لنا صنع الإله تعالى"],["7EEC8FA4-3CAA-5F04-83CA-E064010063C0","فيها من التفاح كل عجيبة","تذكي برياها صبا وشمالا"],["A3BCEA4B-28C3-59CC-AD2E-1C62F591C85A","تهدي لنا نهد الحبيب وخده","وتري من الورد الجني مثالا"],["EB3DB8EE-329F-5A57-8C31-C105F3FB6F2F","وبها من الأترج شمس أطلعت","من كل شطر للعيون هلالا"],["0E882E96-1465-5EC9-9FB1-FD4F5579BA6F","ويحفها ورق يروق كأنه","ورق النضار وقد اجاد نبالا"],["A06F527C-19AC-5B1D-BD92-D86705076747","لون العشية ذهبت صفحاتها","رقت وراقت بهجة وجمالا"],["B8BF0110-350E-576E-A814-5A12F5AA99FE","وبها من النقل الشهي مذكر","عهدا تولى ليته يتوالى"],["BFACB703-6610-5AA6-8F22-88370CE8FC5F","لله منها خضرة من حضرة","تغني العفاة وتحسب الآمالا"],["3400F486-7768-5795-9A97-D43DD650A6B1","اذكرتني العهد القديم ومعهدا","كانت شموس الراح فيه تلالا"],["E979224D-62DB-5704-966F-0D0C7D12A719","فأردت تجديد العهود وإنما","كتب المشيب على عذاري لالا"],["EF5E3CCC-C912-5EC3-9B17-C27F007333BD","فأدرت من ذكراك كأس مدامة","وشربت من حبي لها جريالا"],["2C35E436-B409-5D4B-89B1-0C176EF2ED91","فبقيت شمسا في سماء خلافة","لا يستطيع لها الزمان زوالا"]]},"F30C374C-E12F-59B5-8496-69CDAF6AD909":{"t":"يا من يحن إلى نجد وناديها","p":194,"s":"يا من يحن إلى نجد وناديها","r":"441760","v":[["B7D8AE2B-071A-565B-8453-AB57DDCBA55D","يا من يحن إلى نجد وناديها","غرناطة قد ثوت نجد بواديها"],["8B4DEA78-42E6-5D76-BE57-18EC1309C96E","قف بالسبيكة وانظر ما بساحتها","عقيلة والكثيب الفرد جاليها"],["3BC4E0B1-D809-5078-BED3-F452F7014342","تقلدت بوشاح النهر وابتسمت","أزهارها هي حلي في تراقيها"],["65DE80A1-59CB-5448-951C-BC0174474E3B","وأعين النرجس المطلول يانعة","ترقرق الطل دمعا في مآقيها"],["0262A318-B41C-5B1A-BA40-D0336A8C156F","وافتر ثغر أقاح من أزاهرها","مقبلا خد ورد من نواحيها"],["442BB288-9079-5A2C-B204-349543355FFF","كأنما الزهر في حافاتها سحرا","دراهم والنسيم اللدن يجبيها"],["8929B11E-0A17-535C-877F-9130E0F1F5CA","وانظر إلى الدوح والأنهار تكنفها","مثل الندامى سواقيها سواقيها"],["4D0C1FA5-728B-5DBB-A45F-2A5197BAAA55","كم حولها من بدور تجتني زهرا","فتحسب الزهر قد قبلن أيديها"],["45C5C562-5F89-55DE-BBDE-3EA4E1084A98","حصباؤها لؤلؤ قد شف جوهرها","والنهر قد سال ذوبا من لآليها"],["7A54E900-7D30-5937-A1BA-182E631B89B5","نهر المجرة والزهر المطيف به","زهر النجوم إذا ما شئت تشبيها"],["27C26EF3-3D80-553E-8B9B-1979E425347D","يزيد حسنا على نهر المجرة قد","أغناه در حباب عن دراريها..."],["00A9E2B8-2C4B-531A-890D-1D0790BF2813","يدعى المنجم رائيه وناظره","مسميات أبانتها أساميها"],["B6AFD208-474D-59AA-AD95-BC45A2200D8B","إن الحجاز مغانيه بأندلس","ألفاظها طابقت منها معانيها"],["2CB97205-2ADF-5C66-9C66-6930BCD4AB9F","فتلك نجد سقاها كل منسجم","من الغمام يحييها فيحييها"],["51500AE5-AC91-5601-A2E9-70F493130EDB","وبارق وعذيب كل مبتسم","من الثغور يجليها مجليها"],["2885D741-3AE9-5EE7-8E1C-D99ED7B99A9F","وإن أردت ترى وادي العقيق فرد","دموع عاشقها حمرا مجاريها"],["5F435D8D-B721-5DC2-899A-039858EA0895","وللسبيكة تاج فوق مفرقها","تود در الدراري لو تحليها"],["7DC1739F-37DC-5E7A-BAE7-83C005B1F68D","فإن حمراءها والله يكلؤها","ياقوتة فوق ذاك التاج يعليها"],["682A7B71-2E8E-56D8-8E8D-8ACC9312DC0C","إن البدور لتيجان مكللة","جواهر الشهب في أبهى مجاليها"],["7357B3B6-8028-58CA-B12A-9115B8808C2D","لكنها حسدت تاج السبيكة","إذ رأت أزاهره زهرا يجليها..."],["11D00704-703D-5920-A93F-2599EE828387","بروجها لبروج الأفق مخجلة","فشهبها في جمال لا تضاهيها"],["DC1BF920-F485-52CD-A544-A3BA26DBE1EB","تلك القصور التي راقت مظاهرها","تهوى النجوم قصورا عن معاليها"],["BA4AF88F-6558-5AB4-BBFA-912CD66A62EE","لله لله عينا من رأى سحرا","تلك المنارة قد رقت حواشيها"],["929F3246-D429-53BF-97CC-45D043C79C9A","والصبح في الشرق قد لاحت بشائره","والشهب تستن سبقا في مجاريها"],["CC7D0C77-F56D-5ECA-8270-9D531F9F50EA","تهوي إلى الغرب لما غالها سحر","وغمض الفجر من أجفان واشيها"],["0345DA52-3741-5524-9658-AA8D364FE90D","وساجع العود في كف النديم إذا","ما استوقفت ساجعات الطير يغريها"],["4663AE28-A4CF-5C59-9F30-46413BE402A8","يبدي أفانين سحر في ترنمه","يصبي العقول بها حسنا ويسبيها"],["7EF54C97-7C1F-5862-BEDB-17B366482388","يجسه ناعم الاطراف تحسبها","لآلئا هي نور في تلاليها"],["864613E7-652C-5511-8B33-34E42F4CEACF","مقاتل بلحاظ قوس حاجبها","ترمي القلوب بها عمدا فتصميها"],["F3EE9ED5-5C7A-5525-9960-4A934FE76AD9","فباكر الروض والأغصان مائلة","يثني النفوس لها شوقا تثنيها"],["305AD619-E396-5DFE-96DE-E8AF35E418D8","لم يرقص الدوح بالأكمام من طرب","حتى شدا من قيان الطير شاديها"],["E4EC38DA-7F7A-57DB-9A6A-E859BF46644A","واسمعتها فنون السحر مبدعة","ورق الحمام وغناها مغنيها"],["33B811F5-9B9D-5CC0-BB84-20A9D0EB5A41","غرناطة آنس الرحمن ساكنها","باحت بسر معانيها أغانيها"],["9E578836-9C28-57B2-A1ED-A7C586A51868","أعدى نسيمهم لطفا نفوسهم","فرقة الطبع طبع منه يعديها"],["D81DF33B-F1B6-5F26-8A7E-0F7DE0363230","فخلد الله ايام السرور بها","صفرا عشياتها بيضا لياليها"],["95E63C8A-B97E-5AE6-9EE2-147641317B5F","وروض المحل منها كل منبجس","إذا اشتكت بقليل الجدب يرويها"],["4FA54167-2DA7-5D8A-9CB1-C60F86BA3218","يحكي الخليفة كفا كلما وكفت","بالجود فوق موات الأرض يحييها"],["8E17F7F6-A7FF-5706-92E6-E728ED06B1D0","تغني العفاة وقد أمت مكارمه","عن السؤال وبالإحسان يغنيها"],["8DD6F7AC-77FF-59BF-8F54-6D421219F137","لها بنان فلا غيث يساجلها","جودا ولا سحبه يوما تدانيها"],["201D3771-FB98-5472-8D34-5CBAF11F9743","فإن تصب سحبه بالماء حين همت","بعسجد ولجين صاب هاميها"],["FF1951CA-D0A2-5AB5-B604-DC4A957B9ADB","يا ايها الغوث أنت الغوث في زمن","ملوكه تلفت لولا تلافيها"],["3F9E9E03-59B8-5725-B06B-0106ACF70131","إن الرعايا جزاك الله صالحة","ملكت شرقا وغربا من يراعيها"],["43AEA103-535A-5F34-B08E-403D03EDF253","إن الخلائق في الاقطار أجمعها","سوائم أنت في التحقيق راعيها"],["715BA076-0516-55F4-8869-B9515D7A656E","فكل مصلحة للخلق تحكمها","وكل صالحة في الدين تنويها"],["55957603-074D-51AA-96A4-DCEB097995CB","إذا تيممت أرضا وهي مجدبة","فرحمة الله بالسقيا تحييها"],["2AF6389C-BC5B-5FE8-AD98-F64F3CECC00F","يا رحمة بثت الرحمى بأندلس","لولاك زلزلت الدنيا بمن فيها"],["DDC6C0AA-5CF6-5721-AA67-A50B4B0FB4D0","في فضل جودك قد عاشت مشيختها","في ظل أمنك قد نامت ذراريها"],["B69BF096-1751-55A7-8E13-0FFD8786BE28","في طول عمرك يرجو الله آملها","بنصر ملكك يدعو الله داعيها"],["4C462F79-88D2-5F40-867D-F7D64B9C8C62","عوائد الله قد عودت أفضلها","لتبلغ الخلق ما شاءت أمانيها"],["C4E770B6-6913-586A-926E-F25D41423878","سل السعود وخل البيض مغمدة","واضرب بها فرية التثليث تفريها"],["C6350362-6301-5CCC-AF4D-16D9B7EC3D29","لله أيامك الغر التي اطردت","فيها السعود بما ترضى ويرضيها"],["67003CD7-3C84-542B-9A03-F80E8FBCB649","لله دولتك الغراء إن لها","لكافلا من إله العرش يكفيها"],["34814FDB-5DFA-5143-ABFC-525A008DBACC","هيهات أن تبلغ الأعداء مأربة","في جريها وجنود الله تحميها"],["49DEB5EA-E4DB-5F80-9494-35C034329A19","هذي سيوفك في الأجفان نائمة","والمشركون سيوف الله تفنيها"],["FD246131-E725-57FD-8C98-6A93DB548E48","سريرة لك في الإخلاص قد عرفت","حسنى عواقبها حتى أعاديها"],["A8C006C2-502B-541C-8131-6E5281AD2E7B","لم يحجب الصبح شهب الأفق عن بصر","إلا وهديك للأبصار يبديها"],["C3F047CF-68C2-5D34-9568-3C82F4EA5934","يا ابن الملوك وأبناء الملوك إذا","تدعو الملوك إلى طوع تلبيها"],["C936BE63-68B6-540A-8EC6-F156E6CADC9F","ابناء نصر ملوك عز نصرهم","وأوسعوا الخلق تنويها وترفيها"],["5DD9C38F-6C43-5C9E-BF11-2C8CAE8757FF","هم المصابيح نور الله موقدها","تضيء للدين والدنيا مشاكيها"],["A4B69BC9-0FC0-581C-AA50-9152BE6E3951","هم النجوم وأفق الهدي مطلعها","فوزا لمهديها عزا لهاديها"],["EC3A1F62-0E45-5F45-97BE-5E25D136D125","هم البدور كمال ما يفارقها","هم الشموس ظلام لا يواريها"],["F7D1FEDC-773C-50F0-A30F-C0E73BCF1715","قضت قواضبها أن لا انقضاء لها","وأمضت الحكم في الأعدا مواضيها"],["C81BB620-18B2-5462-AF52-16206F2F62D0","وخلدت في صفاح الهند سيرتها","وأسندت عن عواليها معاليها"],["D3995F73-B803-5EB0-B94B-2894766D939D","وأورثتك جهادا أنت ناصره","والأجر منك يرضيها ويحظيها"],["C1DD8D73-10FA-5984-A78A-FD1AF3116212","كم موقف ترهب الأعداء موقفه","والخيل تردي ووقع السمر يرديها"],["A26AE8A8-7F70-52D8-BD62-84551784FAA7","ثارت عجاجته واليوم محتجب","والنقع يؤثر غيما من دياجيها"],["73C252C5-32F9-5615-AE56-3AF65E05D06B","وللأسنة شهب كلما غربت","في الدار عين تجلت من عواليها"],["74231FF0-4920-5593-A4E3-92B16C3E8147","وللسيوف بروق كلما لمعت","تزجي الدماء وريح النصر يزجيها"],["EA2AC499-E989-5E73-9135-100B641FAABE","أطلعت وجها تريك الشمس غرته","تبارك الله ما شمس تساميها"],["F3FA7B76-6394-576B-A2B0-B9C2F530B586","من أين للشمس نطق كله حكم","يفيدها كل حين منك مبديها"],["8206E4AE-197A-5B90-81DD-12E1CDB52FB8","لك الجياد إذا تجري سوابقها","فللرياح جياد ما تجاريها"],["4006DE58-D59F-58B9-8747-EABA3957498D","إذا انبرت يوم سبق في أعنتها","ترى البروق طلاحا لا تباريها"],["52AF003D-F137-50C9-A008-331169F6918B","من أشهب قد بدا صبحا تراع له","شهب السماء فإن الصبح يخفيها"],["55BFB00E-965F-5316-A02E-D0EB84889B75","إلا التي في لجام منه قيدها","فإنه سامها عزا وتنويها"],["40970D5B-4880-501D-BFD5-F8887B232D05","أو اشقر مر عن شقر البروق وقد","ابقى لها شفقا في الجو تنبيها"],["3E9CC2A1-F1EC-5ED0-BB07-ED979B981463","أو أحمر جمره في الحرب متقد","يعلوا لها شرر من بأس مذكيها"],["6DE1F569-40C7-5221-BF94-9553C274AC73","لون العقيق وقد سال العقيق دما","بعطفه من كماة كر يدميها"],["9BC1286C-ACE4-5F52-BA37-3B1E68C0E69D","أو أدهم ملء صدر الليل تنعله","أهلة فوق وجه الأرض يبديها"],["AC93030E-0673-5C12-B43B-C4179F7948A0","إن حارت الشهب ليلا في مقلده","فصبح غرته بالنور يهديها"],["6389E5B8-B7E7-5A79-A5A3-C7F49E936A39","أو اصفر بالعشيات ارتدى مرحا","وعرفه بتمادي الليل ينبيها"],["7A7396ED-2FE2-534F-B4AA-49E91B206EA0","مموه بنفار تاه من عجب","فليس يعدم تنويها ولا تيها"],["6D78D23A-0FB9-552D-B62A-8986702E57B7","ورب نهر حسام رق رائقه","متى ترده نفوس الكفر يرديها"],["19F61CAB-C0F2-5E58-BE13-EFD66F1A0B8F","تجري الرؤوس حبابا فوق صفحته","وما جرى غير أن البأس يجريها"],["FA966481-BD2A-5230-AF9E-FA369700C78E","وذابل من دم الكفار مشربه","يجني الفتوح وكف النصر تجنيها"],["CDD089F0-6CA2-5434-89C9-E6587E2CD1A4","وكم هلال لقوس كلما نبضت","ترى النجوم رجوما في مراميها"],["D540EA27-4898-508B-8D02-2129267E7DCC","أئمة الكفر ما يممت ساحتها","إلا وقد زلزلت قسرا صياصيها"],["6FEE75A4-CEB4-55AA-9B29-7D3B27836D72","يا دولة النصر هل من مبلغ دولا","مضين أنك تحييها وتنسيها"],["E5FA3F40-22CE-5FB6-98CF-2371C0478298","أو مبلغ سالف الأنصار مألكة","والله بالخلد في الفردوس يجزيها"],["B2C30039-EA24-5BCD-9B60-AA58F3C7F274","أن الخلافة أعلى الله مظهرها","أبقت لنا شرفا والله يبقيها"],["E9EF193C-1157-564B-8B31-05DD8B42D58D","يا ابن الذين لهم في كل مكرمة","مفاخر ولسان الدهر يمليها"],["0854C00D-5C0B-5689-BF0B-D0F4B00FCF3D","أنصار خير الورى مختار هجرته","جيران روضته أكرم بأهليها"],["51757EC0-E411-58C6-ADC4-7F10A1493608","أسمتهم الملة السمحاء تكرمة","أنصارها وبهم عزت أواليها"],["E1EAD149-2958-5C5A-A7C6-DFB3785A252E","ففي حنين وفي بدر وفي أحد","تلفى مفاخرهم مشهورة فيها"],["6C61C303-2FF7-5E09-A30D-CB8C0DD8BDE5","ولتسأل السير المرفوع مسندها","فعن مواقفهم تروى مغازيها"],["B6BED0CB-36E2-552F-BB4B-015785C9B695","مآثر خلد الرحمن أثرتها","ينصها من كتاب الله قاريها"],["EA1982DA-AB6D-5EE9-A40A-F4A303EBA1A3","ماذا يجيد بليغ أو ينمقه","من الكلام ووحي الله تاليها"],["AAAF5E10-F01C-50C7-B359-1FA8FEF428EE","له الجهاد به تسري الرياح إلى","ممالك الأرض من شتى أقاصيها"],["1CD2C7D8-7638-5C30-B30A-C13AEC26CB41","تحدى الركاب إلى البيت العتيق به","فمكة عمرت منه نواديها"],["2B642152-BB8B-5C6D-90E6-59D6DC27A81C","بشائر تسمع الدنيا وساكنها","إذا دعا باسمك الأعلى مناديها"],["5130D940-10F5-56D7-A183-62342E9EFDC3","كفى خلافتك الغراء منقبة","أن الإله يوالي من يواليها"],["9B8F1E3C-6686-51C0-A9F7-678AF1E2950A","وقد أفاد بنيه الدهر تجربة","أن السعود تعادي من يعاديها"],["327B2B6E-6EE1-543A-8243-591AE6BAF359","إذا رميت سهام العزم صائبة","فما رميت بل التوفيق راميها"],["7CCBA144-69D6-59B5-AE25-2A8097218B13","شكرا لمن عظمت منا مواهبه","وإن تعد فليس العد يحصيها"],["5328F852-274B-5FAF-BF45-EABAAB770E46","عما قريب ترى الأعياد مقبلة","من الفتوح ووفد النصر حاديها"],["C65B6AE6-DBA5-5FE8-BF93-EB4AA87F588C","وتبلغ الغاية القصوى بشائرها","فقد أظلت بما ترضى مباديها"],["C07FB8CC-06C9-5DD2-BC8F-F580567F2EB2","فأهنأ بما شئت من صنع تسر به","وانو الأماني فالأقدار تدنيها"],["0346F2A8-63FD-51AA-8C0C-5DDE5039B739","مولاي خذها كما شاءت بلاغتها","ولو تباع لكان الحسن يشريها"],["8F6B98DC-EF5A-5850-8C5A-4DDD939AE1AB","أرسلتها حيثما الارواح مرسلة","نوادرا تنشر البشرى أمانيها"],["6AB6AB26-B1F0-5765-9689-B92E0129F155","جاءت تهنيك عيد الفطر معجبة","بحسنها ولسان الصدق يطريها"],["736A7BBD-9EE2-59A6-BC6D-74587199CE8C","البشر في وجهها واليمن في يدها","والسحر في لفظها والدر في فيها"],["FD4E6377-4494-5023-90AD-8D7B2CA14BAD","لو رصع البدر منها تاج مفرقة","لم يرض در الدراري أن تحليها"],["22F9C16B-4E97-5706-B04E-95B106236C30","فإن تكن بنت فكري وهو أوحدها","نعماك في حجرة كانت تربيها"],["48ED4838-E1E2-5358-BFAD-981D7BD7D456","في روض جودك قد طوقتني مننا","طوق الحمام فما سجعي موفيها"],["CB4B4D19-7EDE-5A44-AECE-FB0CD2A4F885","ولو أعرت لسان الدهر يشكرها","لكان يقصر عن شكر شوفيها"],["7EE00B43-CA87-5662-9074-BCCDDBFA6AC9","بقيت للدين والدنيا إمام هدى","مبلغ النفس ما ترجو أمانيها"],["10ED940B-437E-5DC9-BCF8-C94485F6DC6F","والسعد يجري لغايات تؤملها","ما دامت الشهب تجري في مجاريها"]]},"42135C2B-7776-56D9-8091-83FF17F15AA7":{"t":"يا وارث الأنصار وهي مزية","p":194,"s":"يا وارث الأنصار وهي مزية","r":"441741","v":[["9F2BD1EA-CB63-5967-BE2A-B14AD6F44569","يا وارث الأنصار وهي مزية","بفخارها أثنى الكتاب المنزل"],["4940A3E6-B340-58A5-9B41-5C87FF2D201D","أهديتني الباكور وهي بشارة","ببواكر الفتح الذي يستقبل"],["FF1AB87B-B2DA-5424-91C5-767A0E80EC5A","وولادة لهلال تم طالع","وجه الزمان بوجهه يتهلل"],["937B69FA-7C3E-548D-944A-1E9F3DB533EB","هو أول الأنوار في أفق الهدى","وترى الأهلة بعدها تسترسل"],["863DDFCF-2875-594E-993E-A4A89E85B2F8","مولاي صدق الفال قد جربته","من لفظ عبدك والعواقب أجمل"]]},"E1F544A4-4129-56F7-997D-66495FF5565C":{"t":"يقر بعيني أن أرى الزهر يانعا","p":194,"s":"يقر بعيني أن أرى الزهر يانعا","r":"441723","v":[["EC270956-1CE0-5F81-8CB8-9906D78A93AE","يقر بعيني أن أرى الزهر يانعا","وقد نازع المحبوب في الحسن وصفه"],["AE043851-ECAC-500F-BC22-85A4CA4E18C8","وما أبصرت عيني كزهر قرنفل","حكى خد من يسبي الفؤاد وعرفه"],["7014458D-C26D-51C9-B42C-C7D44B217B70","تمنع في أعلى الهضاب لمجتني","تمنعه مني إذا رمت إلفه"],["41F0DC7D-5EB3-5332-87D6-3E3004B95281","وفي جبل الفتح اجتنوه تفاؤلا","بفتح لباب الوصل يمنح عطفه"],["CE21DD50-5C05-5EAB-84BC-A763F208A620","وما ضر ذاك الغصن وهو مرنح","إذا ما ثنى نحو المتيم عطفه"]]},"4167062F-369C-59D7-9BEF-D45B63D6AEBA":{"t":"يكلفني مولاي رجع جوابه","p":194,"s":"يكلفني مولاي رجع جوابه","r":"441767","v":[["C79071EE-5CBF-5DBD-9BB5-E410BBAA38CA","يكلفني مولاي رجع جوابه","وما لتعاطي المعجزات وماليا"],["45B5E584-9945-5386-B97F-CD694436B12B","أجيبك للفضل الذي أنت أهله","وأكتب مما قد أفدت الأماليا"],["C18DAF01-9D98-5ED1-BD6B-AD64557591A0","فأنت الذي طوقتني كل منة","وأحسبت آمالي وأكسبت ماليا"],["3399726E-ACFE-59ED-BD50-AFB51684C043","وأنت الذي أعدى الزمان كماله","وصيرت أحرار الزمان مواليا"],["B87C95CF-45C1-5867-A073-4F765AEB7416","فلا زلت للفعل الجميل مواصلا","ولا زلت للشكر الجزيل مواليا"]]},"7384D038-755F-50CC-9566-B5079B0AA238":{"t":"يهني زمانك أعياد مجددة","p":194,"s":"يهني زمانك أعياد مجددة","r":"441762","v":[["E08BC1C6-490D-5AAB-BF47-FBA1BFBEBC5F","يهني زمانك أعياد مجددة","من الفتوح مع الأيام تغشاه"],["97E3BF43-ECE2-554F-8167-4584C9A5CFEF","غضبت للدين والدنيا بحقهما","يا حبذا غضب في الله أرضاه"],["A839A038-B4B7-50DC-8F88-7A533E50764C","فوقت للغرب سهما راشه قدر","وسدد الله للأعداء مرماه"],["8EBDAFB8-2B2B-56D0-B1E9-37202D414E84","سهم أصاب وراميه بذي سلم لقد رمى الغرض الأقصى فأصماه","..."],["6EB7FEB0-D98C-5CEC-BA49-F213335F5677","من كان بندك يا مولاي يقدمه","فليس يخلفه فتح ترجاه"],["B806703F-36F2-5D6D-866E-BFC3CF8E4A54","من كان جندك جند الله ينصره","أناله الله ما يرجو وسناه"],["0C6EB7B2-A05F-52FA-8F97-913E6AD0CB0C","ملكته غربه خلدت من ملك للغرب والشرق منه ما تمناه","..."],["253DFDAC-89CD-5C44-ACFE-A7FE433F0840","وسام اعداءك الاشقين ما كسبوا","ومن تردى رداء الغدر ارداه"],["AD2A71D7-A13C-5A5F-850C-55EEC6F0D326","قل للذين رمدت جهلا بصيرته","فلم تر الشمس شمس الهدي عيناه"],["3CDC1268-1E1C-556C-820E-C2F14C991B58","غطى الهوى عقله حتى إذا ظهرت","له المراشد أعشاه واعماه"],["569BFC10-827F-59C4-8C45-D40CB855E052","هل عنده وذنوب العذر توبقه","أن الذي قد كساه العز أعراه"],["0ED7A93F-D3B0-53A7-8219-617630E41891","لو كان يشكر ما أوليت من نعم","ما زلت ملجأه الأحمى ومنجاه"],["0AF4EB07-0214-5544-A728-23CFFFBD9981","سل السعود وخل البيض مغمدة","فالسيف مهما مضى فالسعد أقصاه"],["84ECA7D2-C1E3-5CE4-9BD4-CDDFFE48432D","واشرع من البرق نصلا راع مصلته","وارفع من الصبح بندا راق مجلاه"],["452B9514-E1D8-571E-BA9C-23E84B67D17A","فالعدوتان وما قد ضم ملكهما","أنصار ملكك صان الله علياه"],["EA61F2B5-99F4-53C1-AFE8-FAB3958AB297","لا أوحش الله قطرا أنت مالكه","وآنس الله بالألطاف مغناه"],["BDCDC7BA-03DC-5A15-93AA-96931E5E2E3F","لا أظلم الله أفقا أنت نيره","لا أهمل الله سرحا أنت ترعاه"],["78E28617-3ABD-58E1-8459-FD1848EB7CE6","واهنأ بشهر صيام جاء زائره","مستنزلا من إله العشر رحماه"],["FA97AF44-24C1-5BE5-B53E-86BA4D36CB64","أهل بالسعد فانهلت به منن","وأوسع الصنع إجمالا ووفاه"],["384C5ED7-57D1-5F1C-B85E-3AFB68F16F33","أما ترى بركات الارض شاملة","وأنعم الله قد عمت براياه"],["84347B70-3CBB-531B-951F-E9C2F86CDD62","وعادك العيد تستحلي موارده","ويجزل الأجر والرحمى مصلاه"],["8CCB5DD7-427A-50B3-B998-0DE75C578378","جهزت جيش دعاء فيه ترفعه","لذي المعارج والإخلاص رقاه"],["DF4F06C7-0826-5FCD-BC2E-B13B1A353955","افضت فيه من النعماء اجزلها","وأشرف البر بالإحسان زكاه"],["E8D1979A-6247-5591-A70E-72F063C2BC74","واليت للخلق ما أوليت من نعم","وإلى لك الله ما أولى ووالاه وأول هذه القصيدة هذي العوالم لفظ أنت معناه كل يقول إذا استنطقته الله"],["5A191D2F-E396-51E0-B739-8956D2AF1764","بحر الوجود وفلك الكون جارية","وباسمك الله مجراه ومرساه"],["94B1FD52-482C-57C8-AFF7-5DFC92B61DF2","من نور وجهك ضاء الكون أجمعه","حتى تشيد بالأفلاك مبناه"],["495E804C-5EF3-5475-A570-B399E3EDF20B","عرش وفرش وأملاك مسخرة","وكلها ساجد لله مولاه"],["ADD0ED11-696C-5EBE-B52F-76BBDD0D36B0","سبحان من أوجد الأشياء من عدم","وأوسع الكون قبل الكون نعماه"],["D6CCABF4-1023-55E3-BDCB-B583F10876B6","من ينسب النور للأفلاك قلت له","من أين أطلعت الأنوار لولاه"],["43CCD280-E283-5BAA-938C-D8A7394DC07C","مولاي مولاي بحر الجود أغرقني","والخلق أجمع في ذا البحر قد تاهوا"],["223D57FF-7D96-5696-83BA-AA04DB46FFCA","فالفلك تجري كما الأفلاك جارية","بحر السماء وبحر الارض اشباه"],["A5B097C2-C042-5409-AF0B-431CEC27F3F6","وكلهم نعم للخلق شاملة","تبارك الله لا تحصى عطاياه"],["4CC1F1BF-08BF-5A4D-8BAF-92B3EB854F49","يا فاتق الرتق من هذا الوجود كما","في سابق العلم قد خطت قضاياه"],["9D763AB6-961B-5164-BE5E-76ABD608D117","كن لي كما كنت لي إذ كنت لا عمل","ارجو ولا ذنب قد اذنبت أخشاه"],["3D304B7D-DF76-5191-BF95-546B8E3F5E88","وأنت في حضرات القدس تنقلني","حتى استقر بهذا الكون مثواه"],["DDECA88F-31EB-5C34-8CE9-9471A42A53CB","ما أقبح العبد أن ينسى وتذكره","وأنت باللطف والإحسان ترعاه"],["505827EB-835E-5FDF-86AF-A5146283E8A4","غفرانك الله من جهل بليت به","فمن أفاد وجودي كيف أنساه"],["9E6E6A7F-3A85-5D8C-8C52-297094C79C14","مني علي حجاب لست أرفعه","إلا بتوفيق هدي منك ترضاه"],["FC54C9E6-1967-569A-A398-35500316EB37","فعد علي بما عودت من كرم","فأنت أكرم من أملت رحماه"],["A68BABBC-FAC4-5E0F-A068-036CE8F7D4EB","ثم الصلاة صلاة الله دائمة","على الذي باسمه في الذكر سماه"],["A592BD0C-909A-5D01-8AEB-0B6859B38D27","المجتبي وزناد النور بما قدحت","ولا ذكا من نسيم الروض مسراه"],["5EE94691-66BF-5409-8CDF-A54EA4340AEE","والمصطفى وكمام الكون ما فتقت","عن زهر زهر يروق العين مرآه"],["52C72249-28FE-5787-8CE9-D4DF2907641C","ولا تفجر نهر للنهار علي","در الدراري فغطاه وأخفاه"],["2E4603AA-ABDB-5FB0-8D5F-8E2355B7FD70","يا فاتح الرسل أو يا ختمها شرفا","والله قدس في الحالين معناه"],["1B58192C-DDD3-5FCE-989F-9948F3EA591A","لم أدخر غير حب فيك أرفعه","وسيلة لكريم يوم ألقاه"],["FAF65B05-CD5D-5939-9CEF-8B30DE0CD28D","صلى عليك إله أنت صفوته","ما طيبت بلذيذ الذكر أفواه"],["EC2BA4E5-EE45-54E6-A7FB-A658A7A778D7","وعم بالروح والريحان صحبته","وجادهم من نمير العفو أصفاه"],["1CBD1A5A-9323-5A5E-A3A3-43825128FBC7","وخص أنصاره الأعلين صفوته","وأسكنوا من جوار الله أعلاه"],["30F4FDA4-1DB3-500F-A339-A09FFCD5236A","أنصار ملته أعلام بيعته","مناقب شرفت أثنى بها الله"],["3BA47D5B-77D1-5BEA-84B1-07C8F51B7D79","وأيد الله من أحيا جهادهم","وواصل الفخر اخراه وأولاه"],["1B8EDF62-9B8E-5371-BFD3-7620BD46CC62","المنتقى من صميم الفخر جوهره","ما بين نصر وأنصار تهاداه"],["5B017AEB-0399-5B2C-9099-B927ABD7D30F","العلم والحلم والإفضال شيمته","والبأس والجود بعض من سجاياه"]]}}}