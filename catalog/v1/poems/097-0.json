,"يعلمْ بما قاسيتهُ فيهِ"]]},"6F8775EC-5CCD-555C-AB05-667448F2AEBF":{"t":"يا ربُّ إنّي حرضتُ بهجرها","p":97,"s":"يا رب إني حرضت بهجرها","r":"467000","v":[["D3A01170-8DBF-5AE1-831D-C392FCF0B0F4","يا ربُّ إنّي حرضتُ بهجرها","فإليكَ أشكو ذاكَ يا ربّاهُ"],["BDC27256-C9F2-552A-9CBC-D078493E9BD0","مولاةُ سوءٍ تستهينُ بعبدها","نِعْمَ الغلامُ وبِئْسَتِ المولاهُ"],["BDE1757F-D228-5BBD-B9AC-5F4026F4A365","ظِلٌّ ولكنّي حُرِمْتُ نعيمَهُ","وهَواهُ إنْ لمْ يُغِثْني اللّهُ"],["E8C2E99C-30BA-56E3-97CD-0FD93E445097","يا ربّ إنْ كانتْ حياتي هكذا","ضرّاً عليّ فما أريدُ حياهُ"]]},"60F2434D-C0A5-5755-86B7-DA4B6CA6FB9C":{"t":"يا عاذلتي قد كنتُ قبلك عاذلاً","p":97,"s":"يا عاذلتي قد كنت قبلك عاذلا","r":"466944","v":[["06946AF3-4D6A-5A90-A467-58307B180771","يا عاذلتي قد كنتُ قبلك عاذلاً","حتّى ابتُليتُ فَصِرْتُ صَبّاً جاهلا"],["26339BAC-86CC-559B-845E-B71A8035370F","الحبُّ أوّلُ مايكون جَهالةً","فإذا تمكّنَ صارَ شغلاً شاغلا"],["1C758CEC-2071-5BC2-95B9-5398CD8217F1","أرضى فَيَغْضَبُ قاتلي، فتعجّبوا","يرضى القتيلُ ولا يُرضّي القاتِلا"]]},"8891E2C2-1C42-56D8-AD5E-620EEFC98C51":{"t":"يا موقد النارِ بالصحراءِ من عمقٍ","p":97,"s":"يا موقد النار بالصحراء من عمق","r":"466930","v":[["C935E661-6976-5BC2-9203-D294961A9F34","يا موقد النارِ بالصحراءِ من عمقٍ","قمْ فاصطلِ النَّارَ من قلبٍ بكم قلقِ"],["7CABD6B3-A66B-5E00-A785-593E25840EA5","النار توقدُها حيناً وتطفئُها","ونارُ قلبي لا يُطفى من الحرقِ"]]},"81D8565C-59A1-5717-9E6F-C311D01EDF5D":{"t":"ياابْنَ الخلائِفِ والجَحَاجحةِ العُلَى","p":97,"s":"ياابن الخلائف والجحاجحة العلى","r":"466946","v":[["9A079AE9-6ADC-52E7-B6C9-BA626957D4AF","ياابْنَ الخلائِفِ والجَحَاجحةِ العُلَى","والأكرمينَ مَناسِباً وأُصولا"],["566C9981-BAFF-5A01-9908-6828B55B0DDA","والأعظمينَ إذا العظامُ تنافسوا","بالمَكْرُماتِ وحَصَّلوا تَحْصيلا"],["C8D821B5-E475-5B04-AE2F-FC758268111F","والقائدينَ إلى العزيز بأرضهِ","حتّى يذلَّ عساكراً وخيولا"]]},"8E2BEAF0-155D-57E1-9E7E-102B74CC10BA":{"t":"ياحِبُّ باللّهِ لِمْ هَجَرْتِيني","p":97,"s":"ياحب بالله لم هجرتيني","r":"466996","v":[["881BCE29