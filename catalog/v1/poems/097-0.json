{"v":1,"poems":{"B0AC3340-9645-592A-8284-BE65363566BF":{"t":"أرى جَسَدي يَبْلَى وسُقْمِيَ باطنٌ","p":97,"s":"أرى جسدي يبلى وسقمي باطن","r":"466970","v":[["B86002B1-0F71-516D-89E7-D8760A2BF69C","أرى جَسَدي يَبْلَى وسُقْمِيَ باطنٌ","وفي كبدي داءٌ وقلبي سالمُ"],["553BA0B5-FE0F-5619-92F9-4D955C79AFBC","فما السُّقْمُ إلاَّ دُونَ سُقْمٍ أصابني","ولا الجهدُ إلاّ والَّذي بي أعظمُ"]]},"4883C2D8-1F27-5329-ABD2-72EAC03BA23F":{"t":"أسعى فما أجزى وأظما فما","p":97,"s":"أسعى فما أجزى وأظما فما","r":"466852","v":[["A9275188-86F9-5993-A796-35E83BAC1E33","أسعى فما أجزى وأظما فما","أُرْوَى من الباردِ والعَذْبِ"],["05ABF7D0-0EFA-560E-B972-418E66ED4614","يحملني الحُبُّ على مركبٍ","من هجركمْ يا أملي صعبِ"]]},"53E8ECD2-F694-59C9-BBDA-9BFBEC651A83":{"t":"أشكو انفرادي بالهمومِ ووحشتي","p":97,"s":"أشكو انفرادي بالهموم ووحشتي","r":"466992","v":[["F46A71DD-DEBD-5189-A7C9-DEFBD67F74AB","أشكو انفرادي بالهمومِ ووحشتي","لفراقِكُمْ وصبابتي وحَنيني"],["4C4CB478-E9F9-5B95-A1E6-B184793052C7","وتَلَفُّتي كيما أراكِ وماأرى","إلاّ خيالاً مُذْكِراً يُؤْذيني"]]},"CFD37B94-C205-56C2-976D-48CBC6C4F8FE":{"t":"أطلتِ عاذلتي لومي وتفنيدي","p":97,"s":"أطلت عاذلتي لومي وتفنيدي","r":"466890","v":[["FB78DDBA-D38D-5172-BE16-A62935215416","أطلتِ عاذلتي لومي وتفنيدي","وأَنْتِ جاهِلَةٌ شَوقي وتَسْهيدي"],["EBD66E5D-39BC-5997-9561-D7469031D34A","قام الأمين فأغنى الناسَ كلَّهم","فما فَقيرٌ على حالٍ بموجودِ"],["0349C800-28B6-5EE1-B4F4-7D8761A62F6C","لا تشربِ الرّاحَ بين المسمعات وزرْ","ظبياً غريراً نقيّ الخدّ والجيدِ"],["D1E4C1B0-3009-51E8-94E1-A7CA64A14DCC","قد رنَّحتهُ شمولٌ فهو منجدلٌ","يَحْكي بِوَجْنَتِهِ ماءَ العناقيدِ"]]},"6878DBDE-7F29-5EB8-84F4-D94B238C8B53":{"t":"أقولُ والرَّكبُ قد مالتْ عمائمهمْ","p":97,"s":"أقول والركب قد مالت عمائمهم","r":"467018","v":[["07460C33-F2F9-511E-A9DE-EBC0B6CB9A4C","أقولُ والرَّكبُ قد مالتْ عمائمهمْ","بَعْدَ الهُدُوءِ بِقَفْرٍ غَيْرِ مَأْنوسِ"],["3E3D8857-F9E4-5D25-A6EB-75021A536AF5","والعِيسُ قد وَخَدَتْ عَرْضَ الفلاة بِهِمْ","وماتَرى لَهُمْ همّاً بِتَعْريسِ"],["6DB1C01C-1396-5591-B4CB-07DB0485A4BB","إذا أقولُ أتاني اليَوْمَ نَعْرُهُ","زجرَ الحداةِ وحثّ الرّكبِ للعيسِ"],["6EF34646-A3CC-5F51-A72F-8D7844166186","سقياً لأرضٍ إذا ما نمتُ نبّهني","قَبْلَ الصّباحِ بها نَقْرُ النواقيسِ"],["B32A0CB6-17B4-5311-A851-9032A9BF98A2","صوت التّداريج لا المُكّاءُ تَسْمَعُهُ","بينَ البساتينِ فيها والفراديسِ"],["5918C327-A560-5AAB-BFED-84E6C1FF0753","إذا أضاءت من البستانِ حاويةً","بألف صَوْتٍ بديعٍ غَيْرِ مَلبوسِ"],["44E7E596-C553-566A-9FD2-59F3C0BDE599","كأنَّما أرضها والياسمينُ بها","زبرجنُ والنَّسرينُ يغشى بالقراطيسِ"],["70C2F015-2522-5904-B6EE-70F750C831F5","الوردُ والسوسنُ في كلّ شارقةٍ","على الميادين أذنابُ الطواويسِ"],["AC81ABA6-B52E-5071-8522-C4FF9BEE098C","خِلالَهُ الآسُ والخَيْريُّ عن كَثَبٍ","والنَّخْلُ من بَيْنِ خُذْروفٍ ومَغْروسِ"],["8EFCBC81-B308-5ABC-A9FB-7BAE7359BEE7","لتلك أشهى إليّ أن أموتَ بها","من السُّقامِ بأرضِ القفرِ والبوسِ"]]},"51D0115C-484D-50A5-8DB6-FF1B6A575980":{"t":"ألا أيُّهذا الراكبُ العيسَ بلِّغنْ","p":97,"s":"ألا أيهذا الراكب العيس بلغن","r":"467014","v":[["C20FBC82-2B81-5024-AF3A-ED59F9AF2DC5","ألا أيُّهذا الراكبُ العيسَ بلِّغنْ","سباعاً وقُلْ إن ضَمَّ داركُمُ السَّفْرُ"],["6BAD71D3-07A4-5972-B280-DBAB62A3AF9D","أَتَسْلُبني مالي ولو جاء سائلٌ","رققتَ له إن حَطَّهُ نحوك الفقْرُ"],["52849AA8-8FCB-592A-9644-3FF23BAEC806","كشافيةِ المرضَى بفائدةِ الزِّنا","تُؤمِّلُ أجراً حيثُ ليس لها أجْرُ"]]},"E9C0B0AD-2304-5517-8B0B-1A70139F1743":{"t":"ألا يانَفْسُ وَيْحُكَ لاتتوقي","p":97,"s":"ألا يانفس ويحك لاتتوقي","r":"466934","v":[["DF6768C4-9512-5AF7-95AF-A0426EFF21C2","ألا يانَفْسُ وَيْحُكَ لاتتوقي","إلى منْ ليسَ بالبرِّ الشَّفيقِ"],["64C41F18-D908-547F-86F6-22F47E83B152","ألا يا نَفْسُ أَنْتِ جَنَيْتِ هذا","فذوقي ثمَّ ذوقي ثمَّ ذوقي"]]},"E3AF7330-7985-5D46-8927-2C59FDE3CF28":{"t":"ألبسِ الماءَ المداما","p":97,"s":"ألبس الماء المداما","r":"466962","v":[["1934F674-19EB-5515-9788-EE5A6F3F4C7A","ألبسِ الماءَ المداما","واسقني حتّى أناما"],["4EEE9249-022A-5853-86B8-DDBD8822325D","وأفضْ جودك في النّا","سِ تكنْ فيهمْ إماما"],["270E8D44-488C-56F2-BA99-75479E63970E","لعنَ اللهُ أخا الـ","ـبخلِ وإنْ صلَّى وصامَا"]]},"E88EEB21-C6D7-5474-A31E-21B368EE5E1B":{"t":"ألله يحفظهُ ويجمعُ بيننا","p":97,"s":"ألله يحفظه ويجمع بيننا","r":"466836","v":[["137FA156-767F-5692-8BF8-C33F7AD8C36E","ألله يحفظهُ ويجمعُ بيننا","ربّ قريبٌ للدّعاءِ مجيبُ"],["96ABEB07-CA37-525D-AABD-4DF51411E9FB","ياطيبَ عَيْشٍ كنتُ فيه وسيّدي","نُسْقَى بكأسٍ والجنابُ خصيبُ"]]},"9D1E7B21-774E-507B-854F-E0F8087D69E2":{"t":"أليستْ سُليمى تَحْتَ سَقْفٍ يُكنُّها","p":97,"s":"أليست سليمى تحت سقف يكنها","r":"466918","v":[["0CA629D1-309A-534A-9DD2-28296525C31B","أليستْ سُليمى تَحْتَ سَقْفٍ يُكنُّها","وإياي هذا في الهوى ليَ نافعُ"],["C5DD5F48-1134-5EC7-A8AE-B7917F963CEB","ويَلْبَسُها الليلُ البهيمُ إذا دَجَى","وتُبصرُ ضوءَ الفجرِ والفجرُ ساطعُ"],["69B2F154-4D9D-537A-BF93-F8135D4E8F23","تدوس بساطاً قد أراه وأَنْثَني","أطأهُ برجلي كلُّ ذا ليَ شافعُ"]]},"6180F292-86C6-5175-BDB3-F2BB9DC18A02":{"t":"أما واللّهِ جوزيـ","p":97,"s":"أما والله جوزيـ","r":"466986","v":[["73E69867-E46B-579B-B368-BA97D006C394","أما واللّهِ جوزيـ","ـتُ بالإِحْسانِ إحْسانا"],["BFF9E024-3E8B-5E75-A24A-56DD7BAB1CE1","لما صدَّ الذي أهوى","ولا ملَّ ولاَ خانا"],["02AC5582-1109-59D8-BDF8-9D193DC7EF10","رَأَيْتُ النّاسَ من أَلْقى","عَلَيْهمْ نَفْسَهُ هَانا"],["19E8F77A-FD3F-5AA5-96D5-EFE11F88F3B8","فزرْ غبّاً تزدْ حبّاً","وإِنْ جُرِّعْتَ أَحْزانَا"]]},"DC59DF18-902A-578A-B52B-46FDC963F443":{"t":"أمسيتُ في عنقي من حبِّ جاريةٍ","p":97,"s":"أمسيت في عنقي من حب جارية","r":"466886","v":[["D9CEBB54-CF57-505F-BA20-2F5C60BC07B3","أمسيتُ في عنقي من حبِّ جاريةٍ","غلٌّ فلا فكَّ عنّي آخرَ الأبدِ"]]},"6709C277-7D70-5C80-9D07-A8D52A8BDBE9":{"t":"أهلي سلُوا رَبَّكم العافيَهْ","p":97,"s":"أهلي سلوا ربكم العافيه","r":"467026","v":[["1263D1E5-D4D4-5FA3-B449-C23270120B21","أهلي سلُوا رَبَّكم العافيَهْ","فقد دهتني بعدكمْ داهيهْ"],["2DD60B53-A1B8-5B9F-8E03-0D1530603D48","فَارَقَني بَعْدَكم سَيّدي","فعبرتي منهلَّةٌ جاريهْ"],["C1529B12-C99E-5B97-B891-CCF48BB3AD24","مالي أرى الأبصار بي جافيةْ","ما تَنْثَني منّي إِلى ناحِيَهْ"],["5482D911-E7F5-57EA-AAF5-2CEF9B4C8EB4","ما ينظر النَّاسُ إلى المبتلى","وإنَّما الناسُ مَعَ العافِيَهْ"]]},"621EF786-B922-5FF1-8EB0-D570F799EC97":{"t":"أوقعتِ في قلبي الهوى","p":97,"s":"أوقعت في قلبي الهوى","r":"466964","v":[["ED81A802-1D33-574F-9DA1-BE7E401B6A1B","أوقعتِ في قلبي الهوى","ونجوتِ منه سالمهْ"],["BCB0AC32-01CC-54BA-B646-6AF1E5B73AA5","وبدأتني بالوصلِ ثمْ","مَ قطعتِ وصلي ظالمهْ"],["22EA6ACD-6FD5-5DE5-AFC5-0C80DA98B9A7","تُوبي فإنَّكِ عالمَهْ","أو لاَ فإنّي آثمهْ"]]},"66D550CA-78FF-5DFF-942A-453CF7DBAF8D":{"t":"أيا رَبِّ حتى متى أُصْرَعُ","p":97,"s":"أيا رب حتى متى أصرع","r":"466916","v":[["915C6355-B8C4-59EB-860F-ABAFA05F76E9","أيا رَبِّ حتى متى أُصْرَعُ","وحَتَّام أبكي وأسترجِعُ"],["37B11410-4EF0-5539-B738-C4F91ABA9BF0","لقد قطعَ اليأسُ حَبْلَ الرَّجاءِ","فما في وصالكِ لي مطمعُ"],["1E96C24A-8CEF-5D0A-82B3-8B938E6B37D8","بُليتَ بِقَلْبٍ ضعيفِ القُوَى","وعينٍ تضرُّ ولا تنفعُ"],["A6ACAACD-ED62-5142-989C-EDA93F83DD6D","إذا ما ذكرتُ الهوى والمنى","تحدَّر من جَفْنِها أربعُ"]]},"50DEA6A9-08BC-5249-AFEC-2C084B38AA5E":{"t":"أيا سرْوةَ البُستانِ طال تشوُّقي","p":97,"s":"أيا سروة البستان طال تشوقي","r":"466948","v":[["733D7608-DD45-5D0A-A96D-180CF2E95F63","أيا سرْوةَ البُستانِ طال تشوُّقي","فهَلْ لي إلى ظلِّ لديكِ سبيلُ"],["BE2E88D0-0433-52C3-BA7B-483A4AFEDFD5","متى يَلْتقي مَنْ ليس يُقْضى خروجَهُ","وليسَ لما يُقْضَى إليه دُخولُ"],["CAA312E6-7B62-5663-A2C1-773CE20CBA65","عسى اللهُ أو نرتاحَ من كربةٍ لنا","فيلقى اغتباطاً خلّةٌ وخليلُ"],["657E90C2-1853-5A6C-A17B-D4C284A66C1E","عسى اللهُ أن يُرتاح منهُ برحمةٍ","فَيُشفى جوىً من مُدْنَفٍ وعَويلُ"]]},"431496D2-53A9-5D3D-8AC2-8C84759ECA31":{"t":"أيُّ ذنبٍ أذنبتُه أيُّ ذنبٍ","p":97,"s":"أي ذنب أذنبته أي ذنب","r":"466848","v":[["CB710911-C40E-5358-8AEB-FF98270A3791","أيُّ ذنبٍ أذنبتُه أيُّ ذنبٍ","أيُّ ذنبٍ لولا مخافةُ ربّي"],["6066A0BC-D4BF-5516-B2DC-12E2B5696126","بمقامي بطيزناباذَ يوماً","بعدَهُ ليلةٌ على غيرِ شربِ"]]},"A00C7A00-A4C6-5DF9-989A-60C33EC88507":{"t":"أَصابني بَعْدَك ضُرُّ الهوى","p":97,"s":"أصابني بعدك ضر الهوى","r":"466928","v":[["A7307200-9199-59A5-9A1C-1D1B70870B2F","أَصابني بَعْدَك ضُرُّ الهوى","واعْتادني للبُعْدِ إِقْلاقُ"],["4AAE8C52-654A-50F3-B4C9-CC85999C0C8D","قد يعلمُ المولى وحسبي بهِ","أنّي إلى وجهكِ مشتاقُ"]]},"359ACAED-46D3-57DE-8720-4CACA5DC49FB":{"t":"أَلا يا أَقْبَحَ الثَّقلينِ فِعْلاً","p":97,"s":"ألا يا أقبح الثقلين فعلا","r":"466990","v":[["4565CAE5-438F-5FA2-9F59-1FBD8D99410B","أَلا يا أَقْبَحَ الثَّقلينِ فِعْلاً","وأحسنَ ما تأمَّلتِ العيونُ"],["AFA9DE72-A85F-5545-9BC1-6FCCB2EDE126","يَرى حَسَناً فلا يُجْزِي عَلَيْه","ويَنْزِلُ بي عُقُوبَتَهُ الظُّنُونُ"],["07BD6B78-ED1B-5BB4-BA85-6F2A66B420DC","ولكنّي أكذِّبُ فيه ظنِّي","وعندي منْ شواهدهِ يقينُ"]]},"EBD86BD7-C8DC-5A0F-95E5-E412DB396432":{"t":"أَلاَ مَنْ لي بإنسانِ","p":97,"s":"ألا من لي بإنسان","r":"466994","v":[["1899D3DE-B9AB-5376-A548-5D6961465674","أَلاَ مَنْ لي بإنسانِ","كوى قلبي بهجرانِ"],["BA84872B-90C8-5096-A7DE-6A7665CC9AC2","وقاضٍ حاكمٍ فيَّ","بظلمٍ وبعدوانِ"],["0ED701E7-8240-516A-AB45-81BCEB756115","لقد سلّطَ ذا الحُبَّ","علينا شَرُّ سلطانِ"],["8E207ADD-2B4B-5E9C-8C3A-1F7DCAE50FB0","فيا عَوْناهُ من يَطْلُـ","بُ لي مرضاةَ غضبانِ"]]},"D0D7506D-1F85-5AE3-84AC-57EC2F09090B":{"t":"أَلِفْتُ الهوى حتّى تَشَبَّثَ بِي الهوَى","p":97,"s":"ألفت الهوى حتى تشبث بي الهوى","r":"466866","v":[["099ED334-3C71-51E9-8E58-27515F399245","أَلِفْتُ الهوى حتّى تَشَبَّثَ بِي الهوَى","وأردَفَني مِنْهُ عَلى مَرْكبٍ صَعْبِ"],["10F73F52-30ED-53F5-907F-F5344450AB97","كتابيَ لا يُقْرى ومابِيَ لا يُرى","ونارُ الهوى شوقاً توقَّدُ في قلبي"]]},"0614E820-380B-5798-A268-4E14EAFF287B":{"t":"أُمسي فلا أرجو صَباحاً وإنْ","p":97,"s":"أمسي فلا أرجو صباحا وإن","r":"466910","v":[["D641D5C1-4ABA-5097-93E3-E55FE65BB31A","أُمسي فلا أرجو صَباحاً وإنْ","أصبحْتُ حيّاً قلْتُ لا أُمْسي"],["E5B3CB08-2D54-5388-83F3-E648C8829A3E","لا يَسْتوي واللّه هذا كما","لايستوي في قَدِّها خُمْسي"]]},"D3575787-7E78-5431-9558-B4435FF3A159":{"t":"إذا كنتَ لا يسليكَ عمَّنْ تحبُّه","p":97,"s":"إذا كنت لا يسليك عمن تحبه","r":"467020","v":[["56878D55-392