منى","واليَأْسُ يَجْذِبُني إِلَيْهِ فَأقْعُدُ"]]},"489144D7-DE32-58A5-AB65-022EDC63CC37":{"t":"الشَّأْنُ في التَّصابي","p":97,"s":"الشأن في التصابي","r":"466868","v":[["7E1F12B1-3818-5B9B-9376-D5C1EF2F4FF3","الشَّأْنُ في التَّصابي","واللّهو والشَّرابِ"],["18A25F49-6260-502C-9328-EB9B82C85C7E","من قَهْوَةٍ شَمولٍ","في الكَأْسِ كالشِّهابِ"]]},"A09C7B37-95A4-5D60-893E-F303B9D4C427":{"t":"القلبُ مشتاقٌ إلى ريبِ","p":97,"s":"القلب مشتاق إلى ريب","r":"466846","v":[["8491FD06-09F4-5044-8315-3FB6D826250C","القلبُ مشتاقٌ إلى ريبِ","يا ربِّ ما هذا منَ العيبِ"],["15906C45-2A44-5648-8764-D3E88840B811","قد تيّمتْ قلبي فلم أستطعْ","إلاّ البُكا ياعالمَ الغيبِ"]]},"9831FD68-315D-5C23-92F1-C34AC2DA9912":{"t":"باح بالوجدِ قلبك المستهامُ","p":97,"s":"باح بالوجد قلبك المستهام","r":"466968","v":[["2772AD9B-0EE8-502C-B2E4-34F0612C6297","باح بالوجدِ قلبك المستهامُ","وَجَرَتْ في عظامِكَ الأسقامُ"],["9301A516-4D04-59BE-BEF1-940C927FBD42","يوم لا يملكُ البكاءَ أخو الْـ","ـشَّوقِ فيُشْفَى ولا يُرَدُّ السَّلامُ"]]},"E57F6CB1-AE75-5B0D-A05B-F26D9BC8FDB9":{"t":"بليتُ منكِ بطولِ الهجرِ والغضبِ","p":97,"s":"بليت منك بطول الهجر والغضب","r":"466860","v":[["302EB839-280A-5E8C-924A-7AB69325E6D6","بليتُ منكِ بطولِ الهجرِ والغضبِ","واليومَ أَوّلُ يَوْمٍ كانَ في رَجَبِ"]]},"ED00E004-F4E4-567A-8C9C-DD6A1BF2166D":{"t":"بني الحبُّ على الجورِ فلو","p":97,"s":"بني الحب على الجور فلو","r":"467008","v":[["AFFDC394-4D4F-55A8-B070-0D70330828C6","بني الحبُّ على الجورِ فلو","أنصَفَ المعشوقُ فيهِ لَسَمَجْ"],["F9A12575-4ACA-5486-B8EA-9594A9F386F4","ليسَ يستحسنُ في وصفِ الهوى","عاشقٌ يَعْرِفُ تَأليفَ الحُجَجْ"],["5DAC89D8-D9C9-56B3-BFE9-A6C0EA9BCFB0","لا تعيبنّ من محبِّ ذلَّةً","ذِلَّةُ العاشق مِفتاحُ الفَرَجْ"],["BF26A9B3-A398-5CA0-AB0B-B0D70931C4C6","وقليل الحبّ صرفاً خالصاً","لك خَيْرٌ من كثيرٍ قَدْ مُزِجْ"]]},"20D15846-0508-5E8C-940A-536D0E29B66F":{"t":"بينَ الإزارينِ من المحرمِ","p":97,"s":"بين الإزارين من المحرم","r":"466974","v":[["4984C6BF-C997-5147-82DC-D23D28783D53","بينَ الإزارينِ من المحرمِ","تدليه عقل الرَّجلِ المسلمِ"],["68CAA4C5-5994-53DE-BEFB-A9F6F38EBC6A","في قَدِّ غُصْنِ البانِ لكنَّه","من طيّباتِ الشجرِ المُطْعَمِ"],["132868F8-E8DC-5E03-BAED-E912099E30A1","مرَّ إلى الرّكنِ فزاحمتهُ","فالْتَمَسَ الرُّكنَ ولم يَلْثَمِ"],["11617AE7-AB30-54C0-A024-4F08FE745FA9","وفاتَ بالسَّبْقِ إلى زمزمٍ","وكانت اللَّذّاتُ في زمزمِ"],["BEC2DE1B-AEA8-54D2-A368-0B2AE82F3210","شربتُ فضل الماءِ من بعدهِ","فلستُ أنسى طعمه في الفمِ"]]},"CEE1DD44-1D6C-5873-918D-D54241CB8171":{"t":"بِأَبي من هُو دائي","p":97,"s":"بأبي من هو دائي","r":"466834","v":[["10E36A3F-03A4-5F9A-A53E-7E87030EDE19","بِأَبي من هُو دائي","ومن السّقمِ شفائي"],["8524EE38-855D-5E77-8B8E-1DBEE5D29608","وهو هَمّي ومُنى نفـ","سي وسؤلي ورجائي"]]},"344EA566-4189-5B2B-A4CE-BD7FB44BA607":{"t":"بِتُّ قَبْلَ الصَّباحِ إِنْ بِتُّ إلاَّ","p":97,"s":"بت قبل الصباح إن بت إلا","r":"466906","v":[["E6E38BA2-C05A-5E94-AB13-0A8D83AF86E1","بِتُّ قَبْلَ الصَّباحِ إِنْ بِتُّ إلاَّ","في إزارٍ على فِراشٍ حَريرِ"],["53CABBD8-43C6-5F7E-A2D5-CA9794E47E1C","أو يحلْ دون ذاكَ غلقُ قصورٍ","كم قتيلٍ مِنَ الهوى في القصورِ"]]},"83B99ACD-1798-5202-9726-3B1F42EDE89A":{"t":"تعالوا ثم نصطبحُ","p":97,"s":"تعالوا ثم نصطبح","r":"466872","v":[["5F791A3C-36C9-54DA-B1B1-2BF7B19C33DA","تعالوا ثم نصطبحُ","ونَلْهُو ثُمَّ نَقْتَرِحُ"],["7F4069E0-0927-5AD2-8E91-59DBCFE5DD87","ونجمعُ في لذاذتنا","فإِنَّ القَوْمَ قَدْ جَمَحوا"]]},"AE302E61-446C-5BFD-A1BA-BF2189030BF9":{"t":"تغيبُ فأخلو بالهمومِ","p":97,"s":"تغيب فأخلو بالهموم","r":"466988","v":[["C3CF7EDA-3B2B-59DD-9430-E622E04BC69B","تغيبُ فأخلو بالهمومِ ونلتقي","كأنّي إذا ألزمْتَني ليسَ لي"]]},"D9F3EA17-48E0-5833-953D-1E627AF10D24":{"t":"تكاتبنا برمزٍ في الحضورِ","p":97,"s":"تكاتبنا برمز في الحضور","r":"466900","v":[["2CC5A384-710D-5F73-90A8-36E5A7033A4D","تكاتبنا برمزٍ في الحضورِ","وإيحاءٍ يلوحُ بلا سطورِ"],["811E2547-61AB-5034-BFFC-AB302CE3B710","سوى مُقَلٍ تُخَبِّرُ ماعناهَا","بكفِّ الوهمِ في ورقِ الصدورِ"]]},"D82DA82B-C573-5C25-BAF1-8B28141B78B2":{"t":"تمارضتِ كي أشجى وما بكِ علَّةٌ","p":97,"s":"تمارضتِ كي أشجى وما بكِ علَّة ٌ","r":"467024","v":[["900D54C0-4A47-5D4B-A216-8A24BE09108F","تمارضتِ كي أشجى وما بكِ علَّةٌ","تُريدين قَتْلي قد ظفرْتِ بذلكِ"],["65B52DA7-ECBE-5CA3-BBFE-7A972B137D49","وقولكِ للعوّادِ: كيفَ ترونهُ؟","فقالُوا: قتيلاً. قلتِ: أهْوَنُ هالكِ"],["D47579E4-713E-5BF0-9671-53F73AA629D0","لئِنْ ساءني أنْ نِلْتني بمَساءَةٍ","فَقَدْ سَرَّني أنّي خَطرْتُ ببالكِ"]]},"7ED8BBE3-A9F0-5D7F-A268-9DAA41E419A3":{"t":"تَحَبَّبْ فإنَّ الحبَّ داعيةُ الحبّ","p":97,"s":"تحبب فإن الحب داعية الحب","r":"467006","v":[["7FAE6D80-4BF3-56E8-A4FB-0F663FA7A4FA","تَحَبَّبْ فإنَّ الحبَّ داعيةُ الحبّ","وكمْ من بعيدِ الدار مستوجبَ القربِ"],["AE4399D2-844F-5885-9524-9F022225841E","تبصَّرْ فإن حدِّثتَ أنّ أخا هوىً","نجا سالماً فارْجُ النَّجاةَ من الحُبُ"],["A9B14316-78DE-54B3-9A30-03C38C7D5BF7","وأطيبُ أيّامِ الهوى يومك الّذي","تروَّعُ بالتَّحريشِ فيه وبالعتبِ"],["2DB107F3-45CC-5FEF-8FBA-283CF2C1AF8C","وإذا لم يكن في الحبِّ سخطٌ ولا رضا","فَأَيْنَ حَلاواتُ الرّسائلِ والكُتْبِ"]]},"0C950778-8FBE-585A-9F20-B856196DC17D":{"t":"تَفْدِيك أختُكَ قد حَييتَ بنعْمَةٍ","p":97,"s":"تفديك أختك قد حييت بنعمة","r":"466942","v":[["6201885B-1098-5535-BEAE-72277DF03472","تَفْدِيك أختُكَ قد حَييتَ بنعْمَةٍ","لسْنا نعُدُّ لها الزَّمانَ عَديلا"],["DA7AE749-9D96-5240-B9F8-D33818F1460F","إلاّ الخلودَ وذاكَ قربُكَ سيّدي","لازال قربُكَ والبقاءُ طويلا"],["519CC65C-9A52-5F8C-BAE8-B07A7D4588FD","وحمدْت ربّي في إجابةِ دَعْوَتي","ورأيتُ حمدي عند ذاك قليلا"]]},"A19ECC55-56EB-5A6B-81AC-D9081D337D11":{"t":"جاءني عاذلي بوجهٍ مشيح","p":97,"s":"جاءني عاذلي بوجه مشيح","r":"466874","v":[["E3060301-9558-5241-AB90-DC590C2F9601","جاءني عاذلي بوجهٍ مشيح","لامَ في حُبِّ ذَاتِ وَجْهٍ مَليحِ"],["4272E5BD-1566-534C-9369-EE5A89E268A4","قُلْتُ واللَّهِ لا أَطَعْتُكَ فيها","هيّ روحي فكيفَ أتركُ روحي"],["35F73700-9131-55B6-94D0-A25CD94B8E0B","ظبيةٌ تسكنُ القبابَ وترعى","مَرتَعاً غَيْرَ ذي أَراكٍ وشيحِ"]]},"7C1A2F10-8351-5A40-922D-596709A759EF":{"t":"حَقُّ الذي يعشقُ نفسينِ أن","p":97,"s":"حق الذي يعشق نفسين أن","r":"466904","v":[["43D41927-0663-5006-BE4C-CF98EB9783A7","حَقُّ الذي يعشقُ نفسينِ أن","يُصلبَ أو يُنشرْ بمنشارِ"],["0224E015-D407-5E8A-AE57-CB3DC7C18308","وعاشقُ الواحدِ مثلُ الذي","أَخْلَصَ دينَ الواحدِ الباري"],["8D107F31-0F6F-5FB5-997B-472F8540B2C0","صبرتُ حتّى ظفرَ السُّقمُ بي","كم تصبُر الحَلْفاءُ للنّارِ"],["2A1D09D1-FE6B-58C3-A7E6-B38C5859F9A0","لولا رجائي العطفَ من سَيِّدي","بقيتُ بين البابِ والدَّارِ"]]},"6B5FA6E1-9482-5DF2-931C-7F8C0F390888":{"t":"زوّدني يومَ سارَ أحزانا","p":97,"s":"زودني يوم سار أحزانا","r":"466980","v":[["5AE7AA27-E577-5D60-B8A8-861E3576EBB4","زوّدني يومَ سارَ أحزانا","كان لهُ اللّهُ حيثُما كانا"],["BA0C7F36-DF99-5965-8C14-1AD4444CB580","إنْ لم يكُنْ حُبُّهُ قد أَقْلَقَني","فلا صَفَا العيشُ لي ولا لانا"]]},"14982E2B-B3B9-592A-B54D-224A8F9D1735":{"t":"سأمنعُ طرفي أن يلفَّ بنظرةٍ","p":97,"s":"سأمنع طرفي أن يلف بنظرة","r":"466908","v":[["A09D1BF3-AE11-5E2F-9C39-7E48B84F0F89","سأمنعُ طرفي أن يلفَّ بنظرةٍ","وأحجبهُ بالدمعِ عن كلّ منظرِ"],["BAD6E2B7-34EC-58C4-BDCD-A609A9AE1BF9","وأشكرُ قلبي فيكَ حسنَ بلائهِ","أَلَيْسَ به ألقاكَ عند التفكّرِ"]]},"2439CEA3-F3A6-5C86-8027-FCA558100CA6":{"t":"سلامٌ على مَنْ لا يَرُدّ سَلامي","p":97,"s":"سلام على من لا يرد سلامي","r":"466972","v":[["CB1B016D-6339-57DF-A415-496FB416C804","سلامٌ على مَنْ لا يَرُدّ سَلامي","ومَنْ لا يراني مَوْضِعاً لِكَلامِ"],["397874C4-2353-56B1-A5A1-EE6A0DB81B3F","وماذا عليهِ أن يردَّ مسلِّماً","إذا كان يَقْضي بالسَّلام ذمامي"]]},"B1220A65-BF74-533E-A356-B02554AB5317":{"t":"سلطانُ ماذا الغضبُ","p":97,"s":"سلطان ماذا الغضب","r":"466838","v":[["BE319459-AE8D-5D13-AEF3-0D1861BB51B1","سلطانُ ماذا الغضبُ","يعتبُ إن لم تعتبوا"],["4E039144-D3FB-521D-B941-0982903747C3","ما ليَ ذنبٌ فإذا","شئتَ فإنّي مُذْنِبُ"]]},"E53F32C6-5FD8-5084-8807-3316F9525BC1":{"t":"سَلِمْ على ذكْرِ الغزَا","p":97,"s":"سلم على ذكر الغزا","r":"466952","v":[["88CE994E-1F2C-549E-A006-7B2D3F4C389A","سَلِمْ على ذكْرِ الغزَا","لِ الأغْيَد المُسْبي الدَّلالِ"],["647827B9-C13B-5751-9D0A-E54FC2E0A3B5","سَلّمْ عليه وقُلْ لَهُ","يا غلَّ ألبابِ الرِّجالِ"],["40A42DF0-D97C-57D4-88B5-C61E92EC6CE8","خلّيتَ جسمي صاحياً","وسَكنتَ في ظِلِّ الحِجالِ"],["6CEEC75E-3C61-5BEA-8879-73D935C89A86","وبَلَغْتَ منّي غايةً","لم أَدْرِ فيها ما احْتيالي"]]},"A36FEF7A-D750-5305-A10D-2C54F391D236":{"t":"شَرَيْتُ نوماً بِسَهَرْ","p":97,"s":"شريت نوما بسهر","r":"466892","v":[["5FA4179A-5129-50E4-9702-8EC4AA95C34B","شَرَيْتُ نوماً بِسَهَرْ","وغصْتُ في بحرِ الفكرْ"],["CAD38E67-9A53-5625-BDD1-889C904EEF51","ما للتّصابي والغِيَرْ","منْ عرفَ الحبَّ عذرْ"]]},"2A183990-889D-5C34-8C86-ED768E909E45":{"t":"شَغَلْتُ اشتغالي ونفسي بكُمْ","p":97,"s":"شغلت اشتغالي ونفسي بكم","r":"466958","v":[["88EE534E-6F86-560A-AEAE-15B2AA896D32","شَغَلْتُ اشتغالي ونفسي بكُمْ","وأمسيتُ صبّا إلى قربكمْ"],["D010BB68-84C1-5C12-9D56-A263AE8B1336","فإنْ بالهوى مرّةً عدتمُ","فإنّي إذن عدتُ عبداً لكمْ"]]},"28CE5EB3-EAAD-5F9F-9855-9FB3F41CA93C":{"t":"شُغِفَ الفؤَادُ بجارةِ الجنْبِ","p":97,"s":"شُغِفَ الفؤَادُ بجارة ِ الجنْبِ","r":"466854","v":[["AE94FD77-C13A-5DDF-ABEB-D30B366E412A","شُغِفَ الفؤَادُ بجارةِ الجنْبِ","فَظَللْتُ ذا حُزْنٍ وذا كَرَبِ"],["6ED55449-D9DD-5A10-9493-0252A3DDB74E","يا جارتي أمسيتُ مالكةً","رِقّي وغالبتي على لُبّي"],["464A37C1-D989-5766-AFFD-78A46DD561E6","وأنا الذليلُ لمن بليتُ بهِ","حسبي به عاذلتي حسبي"],["7E44CFB3-6537-54D5-8946-5422837B4321","أمّا النهارُ ففيه شغلُ تحمُّلٍ","والليلُ يَجْلبُ لي هوى الحُبِّ"]]},"4FD9A7DA-6A8A-5878-8220-6450CF5C31C7":{"t":"صحائِفُنا إشارتُنا","p":97,"s":"صحائفنا إشارتنا","r":"466926","v":[["B0DB2860-0FDA-534E-A18C-DC4AA9826271","صحائِفُنا إشارتُنا","وأكْثَرُ رُسْلِنا الحَدَقُ"],["8E3A7377-54BC-511A-A58D-32330CCAF160","لأنّ الكُتْبَ قد تُقْرا","ولَيْسَ برُسْلِنا نَثِقُ"]]},"918C5ECC-E339-5C71-8DF6-5AE2F6B4CA6E":{"t":"صرمتْ أسماءُ حبلي فانصرمْ","p":97,"s":"صرمت أسماء حبلي فانصرم","r":"466956","v":[["FCAF0384-5794-59AD-8947-524C6E60ED96","صرمتْ أسماءُ حبلي فانصرمْ","ظلمتنا كلُّ منْ شاءَ ظلمْ"],["2CD4EF4E-EFB6-5B72-98A3-44BCDE1D65EE","وکسْتَحلَّتْ قَتْلَنا عامِدَةً","وتجنَّتْ عللاً لم تُجترمْ"]]},"1A1B6430-3B04-5060-953D-0922196C7963":{"t":"طالت عليّ ليالي الصّومِ واتّصلتْ","p":97,"s":"طالت علي ليالي الصوم واتصلت","r":"466888","v":[["6B0233D0-53C3-55B7-8355-E596B3D0E00A","طالت عليّ ليالي الصّومِ واتّصلتْ","حتّى لقد خلتُها زادتْ على العَدَدِ"]]},"D0C74F54-C2BE-5568-8281-D7923BF56CB7":{"t":"طالَ تكذيبي وتصديقي","p":97,"s":"طال تكذيبي وتصديقي","r":"467022","v":[["DD2FAE85-0F1A-59F4-91F9-2455D00E1738","طالَ تكذيبي وتصديقي","لم أجدْ عهْداً لمخلوقِ"],["35DE345D-B2C0-5557-B3C6-57F603BD04F0","إنَّ ناساً في الهوى حدَّثوا","أحْدثوا نقضَ المواثيقِ"],["D0C9884D-F3DE-5FE8-A415-DCF08F68C4C1","لا تراني بعدهمْ أبداً","أشتكي عشقاً لمعشوقِ"]]},"08F04942-31CC-5A45-AA4A-DF3E25491181":{"t":"غوثاهُ غوثي بربّي","p":97,"s":"غوثاه غوثي بربي","r":"466864","v":[["A39CE613-C57C-588C-B4F9-7EDA0F36246B","غوثاهُ غوثي بربّي","من طولِ جهدي وكربي"],["53012C71-8B3D-5D1C-ADBB-AB9DC2BBD897","مِنْ حُبِّ مَنْ لا يُجازي الْـ","معشارَ من عشرِ حبِّي"]]},"C0884745-C0C9-5C88-A9D5-A889B3C24C30":{"t":"فرِّجوا كربي قليلا","p":97,"s":"فرجوا كربي قليلا","r":"466940","v":[["313C2B03-FE29-55E4-8748-AA59915B09A0","فرِّجوا كربي قليلا","فلقد صِرْتُ نحيلا"],["001B5FD4-AA72-5F16-8098-2CFBA0FD5C80","افعلوا في أمرِ مشغو","فٍ بكُمْ فِعْلاً جميلا"]]},"CCF25714-2B28-5C93-9CE2-3A58C7E4CE3A":{"t":"قد رابني أن صددتمْ في مجاملةٍ","p":97,"s":"قد رابني أن صددتم في مجاملة","r":"466960","v":[["B57116EC-9312-57C1-87CD-D66B4992CE7B","قد رابني أن صددتمْ في مجاملةٍ","وأنكرَ القلبُ أن جئنا بحجّكمُ"],["D779D988-46C0-50DC-BB17-23D0EE73B01F","فما الصدودُ وقلبي عِنْدَكم عَلقٌ","وما الذُّنوبُ التي هاجَتْ بِحَرْبِكُمُ"]]},"1DBB2FD0-EBF3-5189-88E1-E9F98987305C":{"t":"قل للإمامِ ابنِ الإما","p":97,"s":"قل للإمام ابن الإما","r":"466856","v":[["3FC8584D-E1C0-52B8-98ED-F563806DFC13","قل للإمامِ ابنِ الإما","مِ مقال ذا النصحِ المصيبِ"],["CE24BFB1-65A7-5A08-9679-362F4F5CEA36","لولا قدومكَ ما انجلى","عنّا الجيلُ منَ الخطوبِ"]]},"B7F86328-AF4E-5713-940A-FAA4EB307C18":{"t":"قلْ لذي الطرّةِ والأصـ","p":97,"s":"قل لذي الطرة والأصـ","r":"466876","v":[["BCDA4075-0CB2-50B8-AC0B-ED022F9E1CDD","قلْ لذي الطرّةِ والأصـ","داغِ والوجهِ المليحِ"],["3AB85112-C3D9-5F50-B0DC-F964AF98CC14","ولِمَنْ أشعلَ نار الـ","حبِّ في قلبٍ قريحِ"],["2683DEF6-E838-5A9E-9421-9EFBD8D4FE9D","ما صحيحٌ عملتْ عيـ","ناكَ فيه بصحيحِ"]]},"EF8A42BE-4712-5102-A5BA-318EDAEB57D1":{"t":"قَدْ كانَ ما كُلِّفْتُه زَمَناً","p":97,"s":"قد كان ما كلفته زمنا","r":"466920","v":[["8E5ACFD8-F9A1-57E1-960A-3700F93EDAD7","قَدْ كانَ ما كُلِّفْتُه زَمَناً","ياطَلُّ مِنْ وَجُدٍ بكم يَكفي"],["CB84E76F-BCF0-5E9B-A960-12A87164716E","حتّى أتيتكَ زائراً عجلاً","أَمْشي على حَتفٍ إلي حَتْفي"]]},"F3B66AFD-A2C3-532A-8864-252237CCDD43":{"t":"كأنَّها منْ طيبها في يدي","p":97,"s":"كأنها من طيبها في يدي","r":"466862","v":[["3C03984B-8B4C-5874-9B03-34E1522D2A47","كأنَّها منْ طيبها في يدي","تشمُّ في المحضرِ أو في المغيبْ"],["7AD700DE-C85D-51CE-9DC0-05B7BA95DA2B","ريحانةٌ طينتها عنبرٌ","تسقى مع الرّاح بماءٍ مشوبْ"],["06D1A1E8-DA10-5C87-9F06-866626848F57","عروقها من ذا وتسقى بذا","ممزوجةً يا صاحِ طيباً بطيبْ"],["FCE57A56-3988-509B-88DA-A10C499BF6F5","تِلْكَ التي هَامَ فُؤادي بها","مَا إِنْ لِدائي غَيْرُها مِنْ طبيبْ"]]},"CD97287B-C8CA-5DB3-86BC-3AB9329A1A18":{"t":"كتمتُ اسم الحبيبِ منَ العبادِ","p":97,"s":"كتمت اسم الحبيب من العباد","r":"466882","v":[["896C3572-3FAD-55EF-9AEC-3AEE032D9458","كتمتُ اسم الحبيبِ منَ العبادِ","وردَّدْتُ الصَّبابةَ في فؤادي"],["9D944D1A-3C0B-55B8-B14B-997232CB1E45","فوا شوقي إلى بلدٍ خَليٍّ","لَعَلّي باسم من أهوى أُنادي"]]},"E7D69FCA-D5A5-5C5C-AE0E-AE5B5E371BBF":{"t":"كم تجنَّى ذنباً عليَّ بلا ذنـ","p":97,"s":"كم تجنى ذنبا علي بلا ذنـ","r":"466870","v":[["F21A3289-3267-58ED-995E-FF6FABD1BE80","كم تجنَّى ذنباً عليَّ بلا ذنـ","بٍ وما إن أمرتني فعصيتُ"],["A07DA5D4-6654-5A44-A67F-9786C4BFDE79","إنْ تَكُنْ قد صدَدْتَ عنّيَ لمَّا","أن تملَّكتني فصدُّك موتُ"]]},"9CA026E3-9D0E-5E00-A9BF-504AC742FF1C":{"t":"لأشربنَّ بكأسٍ بعدما كأسِ","p":97,"s":"لأشربن بكأس بعدما كأس","r":"466912","v":[["7C5527BD-B645-5399-8AA6-C4C8DB05241D","لأشربنَّ بكأسٍ بعدما كأسِ","راحاً تدورُ بأخماسٍ وأسداسِ"],["8B5ED4A8-7A86-57EF-8084-4934524280D6","وأرضعُ الدَّرَّ منها باكراً أبداً","حَتَّى أُغَيَّبَ في لحْدٍ وأرْماسِ"]]},"DD8A5E52-865F-5BF6-8E98-E89FCAF4799C":{"t":"لا حزنَ إلاّ دون حزنٍ نالني","p":97,"s":"لا حزن إلا دون حزن نالني","r":"466914","v":[["6D47C684-AFE4-54C7-92BB-AE66213981B5","لا حزنَ إلاّ دون حزنٍ نالني","يومَ الفراقِ وقد غدوتُ مودّعا"],["AA853590-2F9E-5B56-BB92-9D52324C80DD","فإذا الأحبَّة قد تولَّت عيرهم","وبقيتُ فرداً والهاً متوجِّعا"],["659EE1A2-8AD3-50D6-AF14-67A016F6770D","ودّعتُ من أهوى ورحتُ بحَسْرةٍ","عجباً لقلبي كيف لَنْ يَتَصَدَّعا"]]},"0D77DC3F-2330-53FE-844B-E04BF473047E":{"t":"لطغيانَ خفٌّ مُذْ ثلاثين حجَّةً","p":97,"s":"لطغيان خف مذ ثلاثين حجة","r":"466924","v":[["5C942593-B3F0-5818-BB42-1B2DA3E2773A","لطغيانَ خفٌّ مُذْ ثلاثين حجَّةً","جديدٌ فلا يَبلَى ولا يتخرَّقُ"],["44F098ED-8FC3-50FE-A14F-92C63B46C31A","وكيف بلى خفَّ هو الدهرَ كلَّهُ","على قدميها في السَّماءِ معلَّقُ"],["3B42EE62-AEE2-5DFD-87AE-D56A72D8A031","فما خرقَتْ خُفّاً ولم تُبلِ جَوْرباً","وأمَّا سراويلاتُها فَتُمَزَّقُ"]]},"3874985B-9C15-5C81-B239-8EFAE02F730D":{"t":"لو كان يمنعُ حسنَ الوجهِ صاحبهُ","p":97,"s":"لو كان يمنع حسن الوجه صاحبه","r":"467010","v":[["FDA7D4CC-8DFC-5536-95B5-0388D2F5797A","لو كان يمنعُ حسنَ الوجهِ صاحبهُ","من أن يكون له ذَنْبٌ إِلى أَحَدِ"],["770BDAF8-38B8-5161-8C55-4B8039C8A09A","كانت عليَّهُ أبرى الناس كلهمُ","من أن تكافا بسوءٍ آخر الأبدِ"],["68B2B7CC-A424-5D00-9C44-826EA41D6BB3","مالي إذا غبتُ لم أذكر بواحدةٍ","وإن سقَمْتُ فَطَالَ السُّقْمُ لم أُعدِ"],["0FD32A21-D1CF-5F8C-8C94-4742932A24DE","ما أعجبَ الشيءَ ترجوهُ فتحرمهُ","قد كُنْتُ أَحْسَبُ أنّي قد مَلاَتُ يَدي"]]},"C04DCE2F-37DC-53D5-AF0F-88D222AC6CF2":{"t":"ليتَ سلمى تراني","p":97,"s":"ليت سلمى تراني","r":"466998","v":[["C4779BB0-DE80-534D-9108-A8BA8B35C9DA","ليتَ سلمى تراني","أو تنبَّى بشاني"],["329BF4E2-C10B-50D5-9320-3058A628BA74","كي تَفُكّ أسيراً","متعبَ القلب عاني"],["68C057BB-7186-5750-A6FE-DA7CBC77B692","يا ديارَ الغواني","المِلاحِ الحسانِ"],["28A13FDB-4857-5A29-B236-A5B0BD4917F7","جادك الغيثُ منهُ","بالغوادي الرّواني"]]},"003EC240-E33F-522C-A2DC-A0A1CAEF3201":{"t":"ليسَ خطبُ الهوى بخطبٍ يسيرِ","p":97,"s":"ليس خطب الهوى بخطب يسير","r":"467016","v":[["B7E7A5F7-6997-5EB3-AB3F-4D482D7CAE14","ليسَ خطبُ الهوى بخطبٍ يسيرِ","لايُنَبِّئْكَ عنْهُ مثلُ خبيرِ"],["C1D036AE-E05C-5EC7-82EC-027395EAF6D2","ليس خطب الهوى يدبَّرُ بالرَّأ","يِ ولا بالقياسِ والتقديرِ"],["367232AC-47D2-5ECC-8E83-739CA71A7B5D","إنّما الأمْرُ في الهوى خَطَراتٌ","محدثاتُ الأمور بعد الأمور"],["48B7496C-772F-531D-84A3-1AD53A3B9732","إن تَكُنْ صادق المودّةِ فاقْنَعْ","وارْضَ مِمّن تُحِبُّه باليسير"]]},"06BBCC02-9682-5665-B188-DC55871C76A7":{"t":"لَيْتَ شِعري متى يكونُ التَّلاقي","p":97,"s":"ليت شعري متى يكون التلاقي","r":"466932","v":[["D10EDBA8-3D57-53F4-A164-440107AEE6A9","لَيْتَ شِعري متى يكونُ التَّلاقي","قَدْ بَراني وسَلَّ جِسْمي اشْتِياقي"],["6D237A6F-72F8-5081-8042-89BD03F76567","غَابَ عَنّيَ مَنْ لا أُسَمّيهِ خَوْفاً","ففؤادي معلَّقٌ بالتّراقي"]]},"4C0A43FB-39D0-5090-8B23-D2F3910152D4":{"t":"ما أقصرَ اسم الحبِّ يا ويحَ ذا الحبِّ","p":97,"s":"ما أقصر اسم الحب يا ويح ذا الحب","r":"466844","v":[["51124EA3-51E4-5BC3-923E-60CF4142353F","ما أقصرَ اسم الحبِّ يا ويحَ ذا الحبِّ","وأطولَ بلواهُ على العاشقِ الصَّبِّ"],["25DC609F-EA2D-5CAD-A96A-882A92D44CA2","يَمُرُّ به لفظُ اللّسانِ مُسَهّلاً","ويَرمي بِمَنْ قاساهُ في هائرٍ صعبِ"]]},"9EC4A9BB-2C37-5297-B55F-9C49B7983962":{"t":"ما زلتُ مذ دخلتُ القصرَ في كربٍ","p":97,"s":"ما زلت مذ دخلت القصر في كرب","r":"466936","v":[["0F72B625-95A4-5395-8255-A7DBC8DDB231","ما زلتُ مذ دخلتُ القصرَ في كربٍ","أهذي بذكركِ صبّاً لستُ أنساكِ"],["B8C2772E-99E3-518A-B653-E2DB732AAFE1","لا تحسبيني وإن حجَّابُ قصركمْ","سدُّوا الحجابَ وحالوا دونَ رؤياكِ"],["A39F6E4F-0052-5A64-AAF4-37C3E71BB458","أنّي تغيّرتُ عمّا كنتُ يا سكني","أيَّامَ كنتُ إذا ما شئتُ ألقاكِ"],["7BF5FE3E-EE26-50D6-8CA1-FD584EB68584","لكنَّ حبَّكِ أبلاني وعذّبني","وأنتِ في راحةٍ طوباكِ طوباكِ"]]},"682D9929-3489-510F-88B9-47E7DD2AB92D":{"t":"ما صنعَ الهجرانُ لا كانا","p":97,"s":"ما صنع الهجران لا كانا","r":"466978","v":[["C3ECC330-703B-5774-9566-0158B02E2AD8","ما صنعَ الهجرانُ لا كانا","هاجَ عليَّ الهجْرُ أَحْزانا"],["9FBE74AD-CF2D-5F91-BA76-EBE6C492F827","ونمَّ طرفي بدخيلِ الهوى","فَصارَ ما أسرَرْتُ إعلانا"]]},"9C3A15C8-2F3F-5BB1-BD55-B278D782A11D":{"t":"ما لي نسيتُ وقدْ نودي بأصحابي","p":97,"s":"ما لي نسيت وقد نودي بأصحابي","r":"466884","v":[["0B4CB8F0-A15F-573D-BE12-DB2B86D28835","ما لي نسيتُ وقدْ نودي بأصحابي","وكنتُ والذّكرُ عندي رائحٌ غادي"],["BC592425-9521-5C34-88C4-2C273B1D4FB8","أنا التي لا أطيقُ الدّهرَ فرقتكمْ","فرقَّ لي يا أخي من طول إبعادِ"]]},"53762129-0F68-5183-B760-4619B7B859EE":{"t":"مالِكَ رِقّي أنت مَسْرورُ","p":97,"s":"مالك رقي أنت مسرور","r":"466896","v":[["223615B9-B465-5061-B5F8-21088D7AAC1A","مالِكَ رِقّي أنت مَسْرورُ","وبالَّذي تهواهُ محبورُ"],["F6E976D5-1DEC-5E3D-AD52-FCA7AD4060C3","أوحشتني يا نورَ عيني فمنْ","يؤنسني غيركَ يا نورُ"],["B9AF0ED9-5AAE-5D50-A46A-BB16EC968B35","أنتَ على الأعداء ياسيّدي","مُظفَّرُ الآراءِ منصورُ"]]},"F2A06B2E-032F-5B81-9A14-DE0FEC0F72E8":{"t":"مُنْفَصِلٌ عنّي وما","p":97,"s":"منفصل عني وما","r":"466938","v":[["69C6EB28-3343-54E2-80B2-849D84957480","مُنْفَصِلٌ عنّي وما","قلبيَ عنهُ منفصلْ"],["CA090C38-B34B-5A39-85FA-2C5885328BDD","يا قاطعي اليوم لمنْ","نويتَ بعدي أن تصلْ"]]},"A5B50F66-14BC-57BF-BCBD-EECD4EA77F6D":{"t":"نامَ عذَّالي ولم أنم","p":97,"s":"نام عذالي ولم أنم","r":"466976","v":[["D29E4EDD-3E83-5D70-92C5-F56C04758915","نامَ عذَّالي ولم أنم","واشتفى الواشون من سقمي"],["91360BFE-8DCD-584C-B7EB-5D2C84DC7BC0","وإذا ماقُلْتُ: بي أَلَمٌ","شَكَّ مَن أهواه في أَلَمي"]]},"E2E9DCB7-BA2E-5F2F-9665-439B65E29679":{"t":"نفسي فدا ظالمٍ يظلمني","p":97,"s":"نفسي فدا ظالم يظلمني","r":"466842","v":[["7335287F-B0C8-5370-8D21-8D0E878ABF7E","نفسي فدا ظالمٍ يظلمني","في كفّه مهجتي يقلّبها"],["8BA5D58C-3CB3-5E39-8BFE-DEA379BF7FC1","ثمّ تولّى غضبان يحلفُ لي","كفرتُ باللَّهِ إن ذهبْتَ بِها"]]},"8482C79F-2396-558D-8E13-B9B1A63C74EE":{"t":"هارونُ يا سؤلي وقيتَ الرّدى","p":97,"s":"هارون يا سؤلي وقيت الردى","r":"466950","v":[["5262C1BC-A19F-5251-BE1E-CEF1538FF9DC","هارونُ يا سؤلي وقيتَ الرّدى","قلبي بعتبٍ منكَ مشغولُ"],["061AA427-7BFB-5D3F-9928-749D09F8D16C","ما زلتُ مذْ خلَّفتني في عمىً","كأنّني في الناس مخبولُ"]]},"3E424CEF-C342-52B6-85DA-52F260BE0EB0":{"t":"هنيئاً رضيتُ بما تصنعينَ","p":97,"s":"هنيئا رضيت بما تصنعين","r":"466966","v":[["5E2E2999-2092-5197-9064-D200BFA141C2","هنيئاً رضيتُ بما تصنعينَ","وإنْ كان في الحبِّ غير استقامهْ"],["57A0B352-83DF-59AB-9270-5573E1E8FA46","أموتُ بِدائي وكَرْبِ الهَوَى","وأنتِ مناتي رزقتِ السَّلامه"],["D7E84AF8-0988-59E2-8696-0A72754AFF4C","أهانُ بهجركمُ كلَّما","أريتكمُ بالوصالِ الكرامهْ"]]},"D6C72BAA-0C24-5951-877E-1502EC0D35EC":{"t":"هَلْ لكمْ أنْ نَكُرَّ حُلْوَ التَّصابي","p":97,"s":"هل لكم أن نكر حلو التصابي","r":"466922","v":[["958F2C65-461B-5C4D-94BD-90558B83CAE9","هَلْ لكمْ أنْ نَكُرَّ حُلْوَ التَّصابي","ونميتَ الجفاءَ بالألطافِ"],["D4F67C93-2E61-5DC7-A44A-DDC19787B2C0","لم يكن حادثٌ يُشتِّتُ شعباً","لا ولا نَبْوَةٌ تَجُرُّ التَجافي"]]},"34F36E83-1C8D-59EE-89EB-4B3AD05CD29A":{"t":"واكَبدِي مِنْ زَفَراتِ الضَّنَى","p":97,"s":"واكبدي من زفرات الضنى","r":"466982","v":[["39678114-FA64-5AB1-8232-4DBB3967BAD2","واكَبدِي مِنْ زَفَراتِ الضَّنَى","حقَّ لها ممَّا تذوبُ الفنا"],["80C7E437-02C9-5640-BFE2-1BBC945449CB","لم يضعِ اللومُ على عاشقٍ","شفرتَهُ إِلاّ انتحاني أنا"]]},"B04AD7D3-FDC4-5E3C-BAFB-5F56B22EE14F":{"t":"وجدَ الفؤادُ بزينبا","p":97,"s":"وجد الفؤاد بزينبا","r":"467004","v":[["97F9E2C3-9261-5DCC-BCD1-C8392CEAAFE5","وجدَ الفؤادُ بزينبا","وجداً شديداً متعبا"],["0D936A1C-86EA-551D-A878-1043D46FC420","أصبحتُ من وجدٍ بها","أدعى شقيّاً منصبا"],["6FFEA316-910C-5143-AA05-B391A1A58DC8","ولقد كَنَيْتُ عن اسمِها","عَمْداً لكيلا تَغْضَبا"],["78B8BC96-9372-5091-9A11-E781BB2E46D8","وجعلتُ زينبَ سترةً","وأتيتُ أمراً معجبا"],["30A8342C-3E8A-5F9A-BE47-9B199A419F42","قالت وقد عزَّ الوِصَا","لُ ولم أجِدْ لي مَذْهَبا"],["03B4F525-0CBE-5AD7-992B-791CFE920503","واللّهِ لانلتَ المَوَ","دَّة أو تنالَ الكوكبا"]]},"A1D432A4-9912-5837-BB4E-8C7C3175E8D5":{"t":"وحَدَّثني عن مجلسٍ كنتِ 