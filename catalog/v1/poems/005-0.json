{"v":1,"poems":{"414342F3-1AEC-5871-AA72-A2601BE7E22A":{"t":"أرسمَ ديارٍ بالسِتارَينِ تَعرِفُ","p":5,"s":"أرسم ديار بالستارين تعرف","r":"437459","v":[["3AB25AFB-86A5-5047-80BA-78F29750EE76","أرسمَ ديارٍ بالسِتارَينِ تَعرِفُ","عَفَتها شَمالٌ ذاتُ نيرَينِ حَرجَفُ"],["63AE2950-7C01-5576-B2B9-8A9982523BB9","مبكرةٌ للدارِ أَيما ثُمامُها","فَيَبقى وأيما عَن حَصاها فَتقرِفُ"],["0CA340D3-C203-5451-93E4-5585D0ECDBF5","حَرونٌ عَلى الأَطلالِ مِن كُلِّ صَيفَةٍ","وَفَقّا عليها ذو عَثانينَ أَكلفُ"],["8C3E472A-1C0A-510C-8876-243A5BB12E42","إِذا حَنَّ سُلّافُ الرَبيعِ أَمامَها","وَراحَت رَواياهُ عَلى الأَرضِ تَرجُفُ"],["23476EE7-524A-5B72-A957-95578A12A715","فَلَم تدَعِ الأَرواحُ وَالماءُ وَالبِلى","من الدارِ إِلا ما يَشوقُ وَيشعَفُ"],["0D22E9AA-70F0-5A68-B96D-5E0A05246660","رسوماً كآياتِ الكِتابِ مُبينَةً","بها للحَزينِ الصَبِّ مبكى وَموقِفُ"],["F847ADFD-FF7E-53B6-A301-EA1650D63CF5","وَقفتُ بها وَالدَمعُ يَجري حَبا بهُ","عَلى النَحرِ حَتّى كادتِ الشَمسُ تُكسَفُ"],["21C05FC1-7559-5BAB-8700-B5E8750754AA","تَذكَّرتُ أَياماً تَسلَّفتُ لينَها","عَلى لذةٍ لَو يُرجَعُ المتَسلَّفُ"],["0AB4B178-1394-5265-A521-08A57B59D7C1","كأَنَّكَ لَم تعهد بها الحَيَّ جيرةً","جَميعَ الهَوى في عَيشِهِ ما تُصَرَّفُ"],["8ED9C4D6-BA3E-53E7-BF4C-6E8F97F27AC0","إِذ الناسُ ناسٌ وَالبِلادُ بغِرَّةٍ","وَأَنتَ بها صَبُّ القَرينَةِ مولِفُ"],["C35CEB1E-7CC3-54E8-B5A8-961674E53FE3","وَقَد كانَ في الهِجرانِ لَو كُنتَ ناسياً","رَميمَ وَهَل يُنسى رَبيعٌ وَصَيِّفُ"],["06440736-5366-578D-85AF-66C41950512F","وَلَم تُنسِني الأَيامُ وَالبَغي بَينَنا","رَميمُ وَلا قَذفُ النَوى حينَ تَقذِفُ"],["991D66F2-C3B0-5D53-A3D7-19F57FB94EF5","وَلَم يَحلُ في عَيني بَديلٌ مَكانَها","وَلَم يَلتَبِس بي حَبلُ مَن يَتَعَطَّفُ"],["08126DB5-0176-5E20-932C-417F43E46281","وَقَد حلَفت وَالسِترُ بَيني وَبينَها","بربِّ حَجيجٍ قَد أَهَلّوا وَعرَّفوا"],["7006EA5E-4B01-5199-BBC3-28F2582D5743","عَلى ضُمَّرٍ في الميس ينفُخنَ في البُرى","إِذا شابكت أَنيابُها اللَجنَ تَصرِفُ"],["2B21E23A-3FD1-5653-A8E4-BD6C7672C793","لَقَد مَسَّني مِنكِ الجَوى غَيرَ أَنَّني","أَخافُ كَما يَخشى عَلى ذاك أَحلِفُ"],["8E6C3E99-3225-5FC0-9D77-EF1B82C98C62","وَكانَ صُدودٌ بَعدَ ما أَبطنَ الهَوى","قُلوباً فَكادَت لِلَّذي كانَ تُجنَفُ"],["F6AC572A-313F-5048-B6D3-56234D6B463D","كتَركِ الأَميمِ الهائِم الماءَ بعدَما","تَنحّى بكَّفيهِ يَسوفُ وَيَغرِفُ"],["E8C92760-CED6-53D6-8B2C-6C3EB6766B1B","وَداويَّةٍ لا يأمنُ الركبُ جَوزَها","بِها صارخِاتُ الهامِ والبومِ يهتِفُ"],["D7E7C36A-AEA2-5ADE-B1CC-9E2A3F6E6F59","دَعاني بها داعي رَميمٍ وَبينَنا","بَهيمُ الحَواشي ذو أَهاويلَ أَغضَفُ"],["9C11B6AB-612E-5A7B-ACEC-9DD18836D530","تَقحَّمتُ ليلَ العيسِ وَهيَ رذيَّةٌ","وَكلَّفتُ أَصحابي الوَجيفَ فأوجَفوا"],["CF3E5D26-7297-53A4-9258-4EC65BA4C07E","لنخبرَ عَنها أَو نَرى سَروَ أَرضِها","وَقَد يُتعِبُ الرَكبَ المحِبُ المكلَّفُ"],["CB719769-5922-56DF-8A9E-D79FE47A0545","وَلَو لضم تَمِل بالعيسِ معويَّةُ العُرى","لمالَ بها أُيكٌ أَثيثٌ وَغِرَيفُ"],["03AE2EC5-4ABB-5364-9985-E8E62EF72A7B","وَمَكنونَةٌ سودُ المَجاثم لَم يَزَل","يُهيِّئها لِلعيكَتينِ التلهُفُ"],["4B9635C7-544A-5140-B0B5-58F5A7231514","وَما العَيشُ إِلّا في ثَلاثٍ هي المُنى","فَمَن نالَها مِن بَعدُ لا يَتخوَّفُ"],["03F5E7B9-667E-5C89-A7E7-EB0DD338C82E","صِحابَةُ فِتيانٍ عَلى ناعجيَّةٍ","مناسِمُها بالأَمعزِ المَحلِ ترعُفُ"],["F3251021-F4F9-5350-9BA5-7E33387EAB99","وَكأسٌ بأَيدي الساقَيينِ رَويَّةٌ","يُمِدانِ راووقَيهما حين تُنزَفُ"],["2712EA13-ECD3-5975-A785-B943296E306B","وَربَّةُ خِدرٍ يَنفُح المِسكَ جَيبُها","تَضَوَّع رَيّاها به حينَ تَصدِفُ"],["2A66FA44-94E7-59BB-AD1F-BC5D5C09C7D4","إِذا سُلِبَت فَوقَ الحَشيّاتِ أَشرَقَت","كَما أَشرقَ الدِعصَ الهِجانُ المُصَيَّفُ"]]},"6826DB9B-122B-5E9F-BD87-6E3442064556":{"t":"أَتَعرِفُ رَسماً كَالرِداءِ المُحَبَّرِ","p":5,"s":"أتعرف رسما كالرداء المحبر","r":"435794","v":[["DA6500A1-0CD9-5549-B6A5-4D942EAC877D","أَتَعرِفُ رَسماً كَالرِداءِ المُحَبَّرِ","بِرامَةَ بَينَ الهَضبِ وَالمُتَغَمَّرِ"],["EC021FB4-1121-5F79-802B-FEADE8F92796","جَرَت فيهِ بَعدَ الحَيِّ نَكباءُ زَعزَعٌ","بِهَبوَةِ جَيلانٍ مِنَ التُربِ أَكدَرِ"],["9E24B341-C141-584F-83EC-1DE86D661B1B","وَمُرتَجِزٌ جَونٌ كَأَنَّ رَبابَهُ","إِذا الريحُ زَجَّتهُ هِضابُ المُشَقَّرِ"],["A0D2546B-F14A-57A7-A7F4-558ACB742DB5","يَحُطُّ الوُعولَ العُصمَ مِن كُلِّ شاهِقٍ","وَيَقذِفُ بِالثيرانِ في المُتَحَيَّرِ"],["9EAA74A7-BA7A-57D0-8066-EBBCE6E7C726","فَلَم يَترُكا إِلّا رُسوماً كَأَنَّها","أَساطيرُ وَحيٍ في قَراطيسِ مُقتَري"],["02137233-7A4A-50E6-840E-38A65289A782","مَنازِلُ قَومٍ دَمَّنوا تَلَعاتِهِ","وَسَنّوا السَوامَ في الأَنيقِ المُنَوَّرِ"],["77A64DE2-9A67-5DF6-A3BC-B4F5833F8E85","رَبيعُهُمُ وَ الصَيفَ ثُمَّ تَحَمَّلوا","عَلى جِلَّةٍ مِثلِ الحَنِيّاتِ ضُمَّرِ"],["205EA2D4-91C9-5159-AEFB-A63E1ADCC277","شَواكِلُ عَجعاجٍ كَأَنَّ زِمامَهُ","بِذُكّارَةٍ عَيطاءَ مِن نَخلِ خَيبَرِ"],["BD0CF162-5088-5A0E-A117-0CEBAE48E56E","بِهِ مِن نِضاخِ الشَولِ رَدعٌ كَأَنَّهُ","نُقاعَةُ حِنّاءٍ بِماءِ الصَنَوبَرِ"],["06475615-113E-5DCA-A295-915686AE69CE","كَسوها سَخامَ الرَيطِ حَتّى كَأَنَّها","حَدايِقُ نَخلٍ بِالبَرودَينِ موقَرِ"],["1098FA75-6538-59EA-9064-998766EFA7F8","وَقامَ إِلى الأَحداجِ بيضٌ خَرايِدٌ","نَواعِمُ لَم يَلقينَ بُؤسى لِمَقفَرِ"],["7ADFD04E-BA29-5EBC-99E3-7AA621F05A91","رَبايِبُ أَموالٍ تِلادٍ وَمَنصِبٌ","مِنَ الحَسَبِ المَرفوعِ غَيرِ المُقَصِّرِ"],["FE0BEE11-2694-5337-95B0-3F64675CA9C9","هَدَينَ غَضيضَ الطَرفِ خَمصانَةِ الحَشا","قَطيعَ التَهادي كاعِباً غَيرُ مُعصيرِ"],["4CBF0FD8-1677-5A55-8063-DACE4CFCB168","مُبَتَّلَةً غُرّاً كَأَنَّ ثِيابَها","عَلى الشَمسِ غِبَّ الأَبرَدِ المُتَحَسِّرِ"],["62F46BC4-FD9C-59B5-B0C9-C922CA75A921","قَضوا ما قَضوا مِن رَحلَةٍ ثُمَّ","وَجَّهوا يَمامَةَ طَودٍ ذي حِماطٍ وَعَرعَرِ"],["DA62E5B9-3A57-54FA-BBF4-D1E980D11610","وَعاذِلَةٍ فادَيتُها أَن تَلومَني","وَقَد عَلِمَت أَنّي لَها غَيرُ موثِرِ"],["BBBE270C-7C5A-5DDE-A7BB-5CC8AD39D822","عَلى الجارِ وَالأَضيافِ وَالسايِلِ الَّذي","شَكا مَعرَماً أَو مَسَّهُ ضُرُ مُعسِرِ"],["E5CEAF3F-6A4E-58CA-A80B-F4A5C87D8E78","أَعاذِلَ إِنَّ الجودَ لايَنقَصُ الغِنى","وَلا يَدفَعُ الإِمساكُ عَن مالِ مُكثِرِ"],["9B9E8D49-7787-5A4E-AC7D-7CE121682C0A","أَلَم تَسأَلي وَالعِلمُ يَشفي مِنَ العَمى","ذَوي العِلمِ عَن أَنباءِ قَومي فَتُخبَري"],["3FE3A30B-907A-517B-B700-66D8AC06D844","سَلامانَ إِنَّ المَجدَ فينا عَمارَةٌ","عَلى الخُلُقِ الزاكي الَّذي لَم يُكَدِّرِ"],["F7223524-5D1A-50AA-9C64-C205E65EAA96","بَقِيَّةُ مَجدِ الأَوَّلِ الأَوَّلِ الَّذي","بَنى مَيدَعانُ ثُمَّ لَم يَتَغَيَّرِ"],["6C3E50C2-AB61-50DC-A30F-5875717C79B6","أولَئِكَ قَومٌ يَأمَنُ الجارُ بَينَهُم","وَيُشفِقُ مِن صَولاتِهِم كُلُّ مُخفِرِ"],["0C7B8D2D-001D-5E25-8493-9625BB7B852B","مَرافيدُ لِلمَولى مَحاشيدُ لِلقِرى","عَلى الجارِ وَالمُستَأنِسِ المُتَنَوِّرِ"],["88F2F1F2-2C70-5EF4-9343-179ADA905395","إِذا ظِلُّ قَومٍ كانَ ظَلَّ غَيايَةٍ","تُذَعذِعُهُ الأَرواحُ مِن كُلِّ مَفجَرِ"],["3034E245-7638-526D-96E7-60BD92B2D800","فَإِنَّ لَنا ظِلّاً تَكاثَفَ وَاِنطَوَت","عَلَيهِ أَراعيلُ العَديدِ المُجَمهَرِ"],["9EB4E8EF-901E-5CF2-8AA0-C125EE77363D","لَنا سادَةٌ لايَنقُصُ الناسُ قَولَهُم","وَرَجراجَةٌ ذَيّالَةٌ في السَنَوَّرِ"],["789F6901-780E-549E-A1BE-CCE1E9E4F30C","تَجِنُّهُمُ مِن نَسجِ داوُدَ في الوَغى","سَرابيلُ حيصَت بِالقَتيرِ المُسَمَّرِ"],["FFC5883F-ED0A-5CF3-A1A3-566E387CFAC3","وَطِئنا هِلالاً يَومَ زاجٍ بِقُوَّةٍ","وَصَفناهُمُ كَرهاً بِأَيدٍ مُؤَزَّرِ"],["A744A95E-CB39-5334-A6B4-4D59A8FE566C","وَيَوماً بِتَبلالٍ طَمَمنا عَلَيهِم","بِظَلماءَ بَأسٍ لَيلُها غَيرُ مُسفِرِ"],["78AFFC60-DF10-524E-8D5D-360CA140BC77","وَأَفناءُ قَيسٍ قَد أَبَدنا سَراتَهُم","وَعَبساً سَقَينا بِالأُجاجِ المُعَوَّرِ"],["B2001429-1080-5C70-B10C-98F11F0EE8A6","وَأَصرامُ فَهمٍ قَد قَتَلنا فَلَم نَدَع","سِوى نِسوَةٍ مِثلِ البَلِيّاتِ حُسَّرِ"],["C754BF47-B5AF-52A2-A5B1-F5E09C7C0FA3","وَنَحنُ قَتَلنا في ثَقيفٍ وَجَوَّسَت","فَوارِسُنا نَصراً عَلى كُلِّ مَحضَرِ"],["42804214-0D94-5D13-A885-F89458EC4BB5","وَنَحنُ صَبِرنا غارَةً مُفرَجِيَّةً","فُقَيماً فَما أَبقَت لَهُم مِن مُخَبَّرِ"],["79B53384-121B-54EA-B492-D64CFD8F5161","وَدُسناهُمُ بِالخَيلِ وَالبيضِ وَالقَنا","وَضَربٍ يَفُضُّ الهامَ في كُلِّ مِغفَرِ"],["F42DBC09-1B9B-5C23-8572-B3F1EE79E717","وَرُحنا بِبيضٍ كَالظِباءِ وَجامِلٍ","طِوالِ الهَوادي كَالسَفينِ المَقَيَّرِ"],["4BD09B02-B527-526C-A45E-C51B68164CE8","وَنَحنُ صَبَحنا غَيرَ عُذرٍ بِذِمَّةٍ","سَليمَ اِبنِ مَنصورٍ بِصَلعاءَ مُذكِرِ"],["DE3B2824-772C-5465-B566-4B8CA8D9F251","قَتَلناهُمُ ثُمَّ اِصطَحَبنا دِيارَهُم","بِخُمرَةَ في جَمعٍ كَثيفٍ مُخَمَّرِ"],["0A70871A-4D6E-5F26-B14F-295AE41C49AD","تَرَكنا عَوافي الرُخمِ تَنشُرُ مِنهُمُ","عَفارِيَ صَرعى في الوَشيجِ المُكَسَّرِ"],["790D7BCF-4CD3-5837-A5AE-E5A7D91F77D9","وَبِالغَورِ نُطنا مِن عَلِيٍّ عُصابَةً","وَرُحنا بِذاكَ القَيرَوانِ المُقَطَّرِ"],["1181B41E-9193-5496-BE98-4FD3CBB29116","وَخَثعَمَ في أَيّامِ ناسٍ كَثيرَةٍ","هَمَطناهُمُ هَمطَ العَزيزِ المُؤَسَّرِ"],["4884DD84-D5C4-52CE-9A80-1D84880681C8","سَبَينا نِساءً مِن جَليحَةَ أَسلَمَت","وَمِن راهِبٍ فَوضى لَدى كُلِّ عَسكَرِ"],["D051EFE2-C2E6-5FD0-ACAE-1303A15C783F","وَنَحنُ قَتَلنا بِالنَواصِفِ شَنفَرى","حَديدَ السِلاحِ مُقبِلاً غَيرَ مُدبِرِ"],["AD76E057-D189-505D-B0D1-E7A733D98E47","وَمِن سائِرِ الحَيَّينِ سَعدٍ وَعامِرٍ","أَبَحنا حِمى جَبّارِها المُتَكَبِّرِ"],["08A9F8DA-92F6-54DB-82FF-EF6B4B6EB176","مَنَعنا سَراةَ الأَرضِ بِالخَيلِ وَالقَنا","وَأَيأَسَ مِنّا بَأسُنا كُلَّ مَعشَرِ"],["7FB9A2C8-D14F-50F1-92D8-76C2D114160D","إِذا ما نَزَلنا بَلدَةً دُوِّخَت لَنا","فَكُنّا عَلى أَربابِها بِالمُخَيَّرِ"],["21F51285-BA50-508F-87BA-5DDB54EA6D74","بَنو مُفرِجٍ أَهلُ المَكارِمِ وَالعُلى","وَأَهلُ القِبابِ وَالسَوامِ المُعَكَّرِ"],["96136FD1-AEB7-5AAE-BB9F-D1563258A35A","فَمَن لِلمَعالي بَعدَ عُثمانَ وَالنَدى","وَفَصلِ الخِطابِ وَالجَوابِ المُيَسَّرِ"],["CC7FDA43-30B2-52D0-97B1-11E4DD0BEE79","وَحَملِ المُلَمّاتِ العِظامِ وَنَقضِها","وَإِمرارِها وَالأَأيُ فيها المُصَدِّرُ"],["AFCC69ED-E66A-5D0D-9B30-53D1CF2D018C","كَأَنَّ الوُفودَ المُبتَغينَ حِبائَهُم","عَلى فَيضِ مَدّادٍ مِنَ البَحرِ أَخضَرِ"],["5960393C-58EB-52DA-AC95-DDFA475C363B","فَكَم فيهِمُ مِن مُستَبيحٍ حِمى العِدى","سَبوقٍ إِلى الغاياتِ غَيرِ عَذَوَّرِ"],["466CA294-710A-5EAB-80E7-923B082CAB7C","وَهَوبٍ لِطَوعاتِ الأَزِمَّةِ في البُرى","وَلِلأُفُقِ النَهدِ الأَسيلِ المُعَذَّرِ"],["CE1585A3-9D9E-50B9-984E-EBDBECEE0DF2","نَمَتهُ بَنو الأَربابِ في الفَرعِ وَالذُرى","وَمِن مَيدَعانِ في ذُبابٍ وَجَوهَرِ"],["EDF833C7-F6E4-50D2-AE62-F3911A407D8A","لُبابُ لُبابٍ في أُرومٍ تَمَكَّنَت","كَريمَ غَداةِ المَيسِرِ المُتَحَضِّرِ"],["249286C8-77AB-537C-A941-18D9FFD6FD56","فَأَكرِم بِمَولودٍ وَأَكرِم بِوالِدٍ","وَبِالعَمِّ وَالأَخوالِ وَالمُتَهَصَّرِ"],["33C8B478-8546-5C97-8900-C2031EC7BE07","مُلوكٌ وَأَربابٌ وَفُرسانُ غارَةٍ","يَحوزونَها بِالطَعنِ في كُلِّ مَحجَرِ"],["E15F6C70-23DA-5EEF-ABFC-9D58A999463E","إِذا نالَهُم حَمشٌ فَإِنَّ دَوائَهُ","دَمٌ زَلَّ عَن فَودَي كَمِيِّ مُعَفَّرِ"],["2D68B594-EFE8-5851-BEE0-81CC538205F1","مُدانِحِمِ يُعطي الدَنِيَّةَ راغِماً","وَإِن دايَنوا باؤوا بَريمٍ مُوَفَّرِ"]]},"B64BAFAA-886D-5891-967C-FA69C21C08BC":{"t":"أَلا هَل فُؤادي إِذ صَبا اليَومَ نازِعُ","p":5,"s":"أَلا هَل فُؤادي إِذ صَبا اليَومَ نازِعُ","r":"437460","v":[["D08DAFC8-9731-5E62-8D76-561305B409F0","أَلا هَل فُؤادي إِذ صَبا اليَومَ نازِعُ","وَهَل عَيشُنا الماضي الَّذي زالَ رايعُ"],["17557733-666D-5349-8E45-92BF99A3538A","وَهَل مثلُ أَيامٍ تَسَلَّفنَ بالحِمى","عوايدُ أَو عَيشُ الستارَينِ راجِعُ"],["BE0A83B5-C2B6-5B8E-8CE4-C11569F24507","كَأَن لَم تجاوِرنا رَميمٌ وَلَم نَقُم","بِفَيضِ الحِمى إِذ أَنتَ بالعَيشِ قانعُ"],["A6090DF0-54AB-58D6-A860-9BCE79FE33E8","وَبُدِّلَت بعدَ القُربِ سُخطاً وَأَصبَحَت","مضابِعةً وأستشرفتكَ الأَضابِعُ"],["98D53C0E-3034-5447-B854-D3ABAC9EDD96","وَكل قَرينٍ ذي قَرينٍ يَوَدَّهُ","سيفجعَهُ يَوماً من البَينِ فاجعُ"],["C3AFE83C-8CCB-5D38-85C7-D0C847341736","لَعَمري لَقَد هاجَت لَكَ الشَوقَ عَرصةٌ","بمَرّانَ تَعفوها الرياحُ الزعازِعُ"],["0C1AAED9-D497-50E4-A52C-E0701D6EF0CF","بِها رَسمُ أَطلالٍ وَخَيمٌ خَواشعٌ","عَلى آلِهنَّ الهاتِفاتُ السواجِعُ"],["EB4E1089-3E64-5330-ABEB-D7E021AD48EF","فظَلتُ وَلَم تعلم رَميمُ كَأَنَّني","مُهَمٌّ أَلثَّتهُ الديونُ الخَوالِعُ"],["917072E8-87F9-5D0F-A387-6AF3D500945D","تذكَّرَ أَيامَ الشَبابِ الَّذي مَضى","وَلَمّا ترُعنا بالفِراقِ الروايعُ"],["DDC020CE-0DCD-5355-855E-362343525F08","بأهلي خَليلٌ إِن تحملتُ نحوَهُ","عَصاني وان هاجَرتُهُ فهو جازِعُ"],["59B62F5B-6562-5C92-AC47-2F3F7181EE85","وَكَيفَ التعزّي عَن رَميمَ وحبُّها","عَلى النأيِ والهِجرانِ في القَلبِ نافِعُ"],["73827922-CE12-573C-8AE2-2B5273E8D72A","طَوَيتُ عليهِ فهو في القَلبِ شامَةٌ","شَريكُ المَنايا ضُمِّنتهُ الأَضالِعُ"],["E3B79408-4835-5691-9630-60F32334BC54","وَبيضٍ تَهادى في الرِياطِ كَأَنَّها","نهى لَسلَسٍ طابَت لهن المراتِعُ"],["5CC9A113-FC8D-59F3-88D1-3A8BE80FC21B","تَخيرنَ مِنّا مَوعِداً بعد رِقبَةٍ","بأعفَرَ تَعلوهُ الشروجُ الدوافِعُ"],["6ABD9729-2D8B-580E-8ED0-5B4C02980969","فجن هُدُوّاً وَالثيابُ كَأَنَّها","مِن الطَلِّ بَلَّتها الرِهامُ النَواشِعُ"],["580DC1CC-2685-569D-AB94-192DA50CDBA0","جَرى بَينَنا منهم رَسيسٌ يزيدُنا","سَقاماً إِذا ما آستَيقَنتُه المَسامِعُ"],["9B281473-3A14-5E27-9257-002CF4F6D6AD","قَليلاً وَكانَ اللَيلُ في ذاكَ ساعَةً","فَقُمنَ وَمَعروفٌ من الصُبحِ صادِعُ"],["7507F3AA-87A4-5ADB-AA1B-C09C28BA6871","وَأَدبَرنَ من وَجهٍ بِمِثلِ الَّذي بِنا","فَسالَت عَلى آثارهنَّ المَدامِعُ"],["30BD5A1A-B00D-5ED3-B182-1DC3566C58A9","تبادِرُ عَينيها بكُحلٍ كأَنَّهُ","جُمانٌ هَوى من سِلكِهِ متتايعُ"],["48383162-53D5-51E7-A6A7-9AE9B073BBD7","وَقُمنا إِلى خوصٍ كأَنَّ عيونَها","قِلاتٌ تَراخى ماؤُها فهو واضعُ"],["9FC6393F-8E7B-5360-AD3B-BFDD0D425EF5","فَوَلَّت بِنا تَغشى الخَبارَ مُلِحَّةً","مَعاً حولُها وَاللاقِحاتُ المَلامِعُ"],["5B8B12ED-13D8-5B11-83A9-E20CCD68DEFB","وَإِنّي لَصرّامٌ وَلَم يُخلَقِ الهَوى","جَميلٌ فراقي حينَ تَبدو الشَرايعُ"],["3E3A67FA-937B-556A-B1FB-D134F759A6B0","وَإِنّي لأَستَبقي إِذا العسرُ مَسَّني","بشاشةَ نَفسي حينَ تُبلى المَنافِعُ"],["2578A785-0D7A-51FE-AC67-8F0E4BD88B79","وَأَعفي عَن قَومي وَلضو شئتَ نَوَّلوا","إِذا ما تَشكّى المُلحِفُ المُتَضارِعُ"],["D041172B-C3EB-5A74-A249-EA284378B024","مَخافَةَ أَن أَقلى إِذا شِئتُ سائِلاً","وَترجِعَني نَحوَ الرِجالِ المَطامِعُ"],["1F4E81B9-9E0B-5A89-B8E6-CFD7E41CF768","فأسمعَ مِنّا أَو أُشَرِفَ مُنعِماً","وَكُلُّ مُصادي نِعمَةٍ مُتواضِعُ"],["CFBA1E0D-62BE-5A3A-BC13-51ABA132E3D7","وأُعرِضُ عَن أَشياءَ لَو شِئتُ نِلتُها","حَياءً إِذا ما كانَ فيها مَقاذِعُ"],["E34A107D-3920-545B-B32F-FBBC0BBB74BB","وَلا أَدفَعُ ابنَ العَمِّ يَمشي عَلى شَفا","وَلَو بلغتني من أَذاهُ الجَنادِعُ"],["85394100-5419-55F9-8AAB-9D56E0A431FF","وَلكن أَواسيهِ وأنسى ذُنوبَهُ","لترجِعَهُ يَوماً إِليَّ الرَواجِعُ"],["B4D362DC-0A2D-5279-8AD5-26E37921C0F8","وأُفرِشُهُ مالي وَأَحفَظُ عَيبَهُ","لَيَسمعَ إِنّي لا أُجازيهِ سامعُ"],["4CD140D0-4779-56E3-87E6-F0E127192ADC","وَحَسبُكَ من جَهلِ وَسوءِ صَنيعَةٍ","مُعاداةُ ذي القُربى وإِن قيلَ قاطِعُ"],["F76A48EF-5A9C-50AF-AD52-724CD0B2C601","فأسلِمُ عَناكَ الأَهلَ تَسلم صُدورُهم","وَلا بُدَّ يَوماً أَن يروعَكَ رايعُ"],["550893C4-186E-529A-8B12-722F40A8C491","فَتَبلوهُ ما سلَّفتَ حَتّى يَرُدَّهُ","إِلَيكَ الجَوازي وافِراً وَالصَنايعُ"],["4C0B2B8D-710B-529C-829C-688E9E7A2F13","فَإِن تُبلِ عَفواً يُعفَ عَنك وَإِن تَكُن","تُقارِعُ بالأُخرى تُصِبكَ القَوارِعُ"],["F42F356E-4B90-5140-905D-C015847202E6","وَلا تبتَدِع حَرباً تُطيقُ اِجتنابَها","فَيلحَمكَ الناسَ الحروبُ البَدايعُ"],["62B598F1-6A77-5B11-A624-20F106B28D70","لَعمري لِنعمَ الحَيُّ إِن كُنتَ مادِحاً","هُمُ الأَزدُ إِنَّ القَولَ بالصدقِ شايعُ"],["2D2DA786-96AA-50D7-812E-32639244920D","كِرامٌ مَساعيهم جِسامٌ سَماعُهم","إِذا أَلغَت الناسَ الأُمورَ الشَرايعُ"],["F9211F70-103F-568A-911A-F7976879997F","لَنا الغُرَفُ العُليا من المَجدِ وَالعُلى","ظَفِرنا بِها وَالناسُ بعدُ تَوابعُ"],["1D8AD880-91B6-5192-A977-04D4CDFE87E8","لَنا جَبَلا عِزٍّ قَديمٌ بناهُما","تَليعانِ لا يألوهُما من يُتالِعُ"],["64478154-8788-5DD4-9D97-4F16EBF74B52","فَكَم وافدٍ منا شَريفٌ مَقامُه","وَكَم حافِظٍ للقِرنِ والقِرنُ وادع"],["FDACACDD-AFC1-5695-8DE4-A39F94CE8F79","وَمن مُطعِمٍ يَومَ الصَبا غَيرَ جامِدٍ","إِذا شَصَّ عَن أَبنائِهِنَّ المَراضِعُ"],["FB6539CB-B486-524E-B483-E76611E74854","يُشَرِّفُ أَقواماً سِوانا ثيابُنا","وَتَبقى لَهم أَن يَلبسوها سَمايعُ"],["9A58EA57-71B6-5406-A385-0D992B320AC5","إِذا نَحنُ ذارَعنا إِلى المَجدِ وَالعُلى","قَبيلاً فَما يسطيعُنا من يُذارعُ"],["5E214680-A662-5D94-8D3F-FE0754EB2D4A","وَمنّا بنو ماءِ السَماءِ وَمُنذِرٌ","وَجفنَةُ منّا وَالقرومُ النزايعُ"],["062BF038-EE3C-54C5-B0A2-84714477A557","قَبائِلُ من غَسّانَ تَسمو بعامِرٍ","إِذا أنتسبَت والأزدُ بعدُ الجَوامعُ"],["3AF23FF8-B194-51C4-AA92-9763556CF688","أدانَ لَنا النُعمانُ قَيساً وَخِندِفاً","أَدانَ وَلَم يمنع ربيعةَ مانِعُ"]]}}}