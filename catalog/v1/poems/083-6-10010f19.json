{"v":1,"poems":{"68B86292-874D-5043-A118-7EC5F1107A29":{"t":"يَا رَامَ قُومِي کصْبَحِينَا غَيْرَ تَصْرِيدِ","p":83,"s":"يا رام قومي کصبحينا غير تصريد","r":"462946","v":[["DDF383AE-AB15-5527-9B2B-F2BA00B7E01A","يَا رَامَ قُومِي کصْبَحِينَا غَيْرَ تَصْرِيدِ","لاَ تَبْخَلِي لَيْسَ ذَاكَ الْبُخْلُ كَالْجُودِ"],["EA5E53DF-3D36-5F46-ADC2-C02B01601021","يَا رَامَ إِنْ أَخاً لِي كُنْتُ آمُلُهُ","ساق الوشاة إليها غير تسديد"],["D2CE335C-34E7-59F8-8BC5-2427FD4A5982","فبت أنشد نوم العين مرتفقاً","حَتَّى الصَّبَاحِ وَمَا نَوْمِي بمَوْجُود"],["6DACA72D-6184-5FDF-8075-25924E92FF4F","يا رام ما الخفضُ من شأني ولا خلقي","وَقَدْ تَحَرَّقَتِ الآفَاقِ بالصِّيدِ"],["2E21EEE4-61A2-54BF-BB08-89020B41EA9E","أَصْبَحّتُ عَنْ شُغلِ النَّدْمَانِ في شُغُل","لاَ أَرْعَوِي لنَعِيمِ الْقَيْنَةِ الْغِيدِ"],["982CD649-2DB8-5A14-8C12-5CAA50D75131","وَكَيْفَ أسْقَى عَلَى الرَّيْحَانِ مُتَّكِئاً","وَالْحَرْبُ حَاسِرَةُ الْخَدَّيْنِ وَالْجِيدِ"],["578A230B-DB6D-506C-A06A-214BC0965036","إِنِّي وَجَدِّكِ مَا رَأيِي بمُنْتَشِرٍ","عند الحفاظ ولا عزمي بمردود"],["E3B0DE5C-2BB4-53D8-B301-D4D249972C1D","قَدْ أَسْلُبُ الْمَلِكَ الْجَبَّارَ حِلْيَتَهُ","في مأقطٍ مثل خط السيف مشهود"],["5ABA3F3F-9948-5D55-87E7-A7FD607964EF","ولا أذبب عن حوضي لأمنعه","لاَ خَيْرَ في وِرْدِ قَوْمٍ غَيْرِ مَوْرُودِ"],["C48A0D49-CF65-57C2-AAD4-E14987173800","يَا رَامَ إِنِّي امْرُؤٌ في الْحَيِّ لي شَرَفٌ","أَرْعَى الْخَلِيلَ وَأدْعَى في الصَّنَاديد"],["13DE6D9B-690C-5C1F-8D6C-EF89B6A6CB26","يُرْجَى مَعَ الْمُزْن مَعْرُوفِي لِطَالبِهِ","وَيُتَّقَى الْمَوْتُ مِنْ حَيَّاتِيَ السُّودِ"],["84D08C85-DBF4-5559-99F5-73D2E72C0893","لا تنكري غل حسادٍ غممتهم","لا يبتني المجد إلا كل محسود"],["4E73D11F-BBB6-5F6C-BE7C-3EC29CB85708","وقائلٍ سره دهر وساء بنا","سَريعُهُ في أخٍ بَرٍّ وَمَوْلُودِ"],["BF04516E-25C0-503C-938F-21508B3FEFFB","وحين فات البكا يبكي على سلفٍ","يهدى إلى الترب من كهلٍ ومن رود"],["DC9AE24D-543D-5398-9BD5-56B27287FCCF","من صاحب الدهر لم يترك له شجناً","فاترك بكاك على ندمانك المودي"],["E5AD569E-B359-54AF-ACA2-8166037B007C","فَقُلْتُ هَمٌّ عَرَانِي منْ أَخ سَبَقَتْ","به المنايا كريم العهد مودود"],["8E91A69B-F08B-5C06-938F-CDFFE3C5F87B","كَانَ الدَّنيَّ فَغَالَ الدَّهْرُ ألْفَتَهُ","وَالدَّهْرُ يُحْدِثُ وَهْناً في الْجَلاَمِيدِ"],["44A5DDD4-D84F-59A5-AB6A-3D4DF0430963","وجار دجلةً حلت بي مصيبته","وفاتني سيدٌ من معشرٍ سود"],["3EF3144E-1910-5CF4-9654-9FEBF4A44467","كِلاَهُمَا لَمْ يَكُنْ وُدِّي لهم صَلفَا","لَكنْ صَفَاءً كَمَاء الْمُزْنِ للعُود"],["0F301192-0DAE-5AA4-BBE5-BF9FEB4D6F59","قَدْ كُنْتُ أَرْجُو مَعَ الرَّاجي إِيَابَهُمَا","حَتَّى أَقَامَا عَلَى رَغْمِي بمَخْلُودِ"],["81C6DBAC-8100-543D-86A8-6B1F5BBA988A","فاشرب على موت إخوانٍ رزئتهم","بَابُ الْمَنيَّة بَابٌ غَيْرُ مَسْدُودِ"],["AF4410C0-D97B-51A3-9B62-146534EDD2F6","يكفيك أن التقى أيدٌ يفوز به","وَالْفِسْقُ ذُلٌّ فَلاَ يُعْدَلْ بتَأييدِ"],["548AA3FB-2167-58DE-BB79-BA502221D722","والمال عز فأكثر من طرائفه","وإن عدمت فطب نفساً بتفنيد"],["3E7B16A0-FD76-5E15-9ABB-0C5A2BABB8CB","قد شبه المال أوغاد بربهم","وأوضع الفقرُ قوماً بعد تسويد"],["4576EB1D-17B6-54BB-B6F9-D8555CC96B6A","يَرُوحُ في الْجَاهِ أَقْوامٌ بمَالِهِمُ","وَذُو الْخَصَاصَةِ مَدْفُوعٌ بتَبْعيدِ"],["9C429947-CF23-5246-81BD-FE8317914E50","فاكسب من المال ما تبني به شرفاً","أَوْ عِشْ بِرغْم قَصِيّاً غَيْرَ مَعْدُودِ"],["F9199777-6C64-52E9-8BD7-50F621628882","ومعشرٍ منقعٍ لي في صدورهم","سُمُّ الاسَاوِدِ يَغْلِي في الْمَوَاعيد"],["A650CB36-390F-5F94-B672-4C45D3B927E7","وَسَمْتُهُمْ بالْقَوَافي فَوْقَ أَعْيُنهمْ","وسم المعيدي أعناق المقاحيد"],["7769A435-6AF6-5225-ABB5-2CEF398419F4","إذا رأوني أصاخوا في مجائمهم","كما أصاخ ابن نهيا بعد تغريد"],["688FB1C3-AC91-59BE-8B6D-368703E72C9F","كأنما عاينوا بي ليث ملحمةٍ","غضبان أو ملكاً بالتاج معقود"],["45A86FB2-B3FE-57EC-A8C2-3B71BBE1F492","يأيها الجاهل المبتاحُ لي سفهاً","لاَقَيْتَ جَهْداً وَلَمْ تَظْفَر بمَحْمُودِ"],["AEE75851-6E4A-5893-BEFC-9F78A5951501","لاَ تَحْسبَنِّي كَمَنْ تَجْري مَدَامِعُهُ","مِنَ الْوَعِيدِ مَعَ الْحُورِ الرَّعَادِيد"],["A31D599A-6AC9-5D7C-82BA-8D730012DC03","إِني إِذَا الْحَرْبُ رَاحَتْ غَيْرَ قَاعِدَةٍ","آتي الهوينى وأغدو غير مهدود"],["F4108687-AE96-55EF-B17D-5B6609E73DD1","قَدْ جَرَّبَ الْجِنُّ أَحْرَامِي وَجَرَّبَني","أسد الأنيس مدلاتٍ بتأسيد"],["71DF8A61-62EA-5CE0-B6C2-CB89BB0EB46A","تفح دوني القوافي كل شارقةٍ","فَحَّ الأَفَاعِي لكَلْبِ الْحَيِّ وَالسِّيد"]]},"88EBC43A-7CCE-5C1A-9124-808E663B70B4":{"t":"يَا صَاحِبَيَّ دَعَا لَوْمِي وَتَفْنِيدِي","p":83,"s":"يا صاحبي دعا لومي وتفنيدي","r":"462799","v":[["18ADE550-653E-5470-848D-5AED3AEE9DFD","يَا صَاحِبَيَّ دَعَا لَوْمِي وَتَفْنِيدِي","فَلَيْسَ مَا فَاتَ مِنْ أمْرٍ بِمَرْدُودِ"],["44FD13D7-AB07-5F8C-9E4F-2AD698E281FE","ما للفتى غيرُ ما أعطى الإله وما","يمنعْ فذلكَ شيء غيرُ موجودِ"],["5DC04512-EA53-55F7-AB57-88733C7D53E3","والأَمْرُ صَعْبٌ إِذَا أخْطَأتَ وجْهَتَهُ","حتى توفق منه للمراشيدِ"],["895FE6D5-BD03-54F5-9563-B17E0E184FD7","فَلَيْتَ شِعْري عَلَى قِيلِ الْوُشَاةِ لَنَا","إذ أزمع الحي وانصاعوا لتصعيدِ"],["88CA1CD2-D699-5492-92F4-A7B98BEC4F66","حيث استقلَّت وصدت لا تكلمنا","والدَّمْعُ يَجْرِي عَلَى الْخَدَّيْنِ وَالجِيدِ"],["64DD562A-CF24-567B-AA8F-89C82B29103B","قَدْ كُنْتُ آمُلُ مِنْ نُعْم مَوَاعِدَهَا","فَمَا وأتْ لِي وَمَا جَاءتْ بِمَوْعُودِ"]]},"99B0CE6D-A6B3-5F89-9007-10B13AEAABCB":{"t":"يَا طَلَلَ الْحَيِّ بِذَاتِ الصَّمْدِ","p":83,"s":"يا طلل الحي بذات الصمد","r":"462809","v":[["4C51F4AF-9D6C-513F-BAF1-74B5518EF1FA","يَا طَلَلَ الْحَيِّ بِذَاتِ الصَّمْدِ","بِالله حَدِّثْ: كَيْفَ كُنْتَ بَعْدِي"],["5A526247-451A-5F78-81F1-843629BB90A9","أوْحَشْتَ مِن دَعْد وَنُؤْيَ دَعْدِ","بَعْدَ زَمَانٍ نَاعِمٍ وَمَرْدِ"],["73AA9CB3-BED6-58AA-9499-0352D95109A3","عهداً لنا سقياً لهُ منْ عهدِ","إِذْ نَحْنُ أخْيَافٌ بِمَا نُؤَدِّي"],["C572D565-2932-56FE-8F3E-53E5167FAD00","يُخْلِفْنَ وَعْداً وَنَفِي بِوعْدِ","فَنَحْنُ مِنْ جَهْدِ الْهَوَى فِي جَهْدِ"],["6CBCA9F5-9518-5F73-B0E4-7CEADE8FC5F1","نلهو إلى نور الخزامى الثَّعدِ","فِي زَاهرٍ مِنْ سَبِطٍ وَجَعْدِ"],["07D44665-360B-5C60-B9EA-12D21A8345E9","ما زال من حرج الصِّبا في رند","يَخْتَالُ فِي مَاء النَّدَى الُمْنَدِّي"],["D4F1A0CF-82B8-559B-B59C-7D028F6C3486","حَتَّى اكْتَسَى مِثْلَ عُيُونِ الْبُرْدِ","رَوْضاً بِمَغْنَى وَاهِبِ بْن فِنْدِ"],["173BE985-BFBE-5810-89EB-C2E7EBE4654F","أهْدَى لَهُ الدَّهْرُ وَلَمْ يَسْتَهْدِ","أفوافَ أنوار الحداء المجدي"],["FB23E11D-3524-567F-8DF1-D4CF7D94F4A6","يَلْقَى الضُّحَى رَيْحانُهُ بِسَجدِ","بدِّلتُ من ذاكَ بكىً لا يُجدي"],["3064D1F4-46CC-59D8-A5FA-66E9EF135EB7","آذَنَ طِلْبَاتُ الصِّبَى بِصَدِّ","طالبني أمرٌ وليسَ يُجدي"],["D92270C5-28A7-5571-A6CC-E4EBECDD87A0","فَهَنَّ لا يَشْفِينَنِي بِبَرْدِ","وَقَدْ أرَانِي فِي الصِّبَى الأَجَدِّ"],["3FC47343-E6B2-5143-B5FD-B6EDEE47E9E5","كالبدِّ فيهنَّ لأهلِ البدِّ","هذا وَبَلاَّنِي مَسِيرُ الأَزْدِ"],["3FA76375-7EF9-5DE3-BBBC-ACFEBBA05F02","سِرْبٌ تَراءَى كَنِظَام الْعَقْدِ","حلوُ الحديثِ حسنُ التَّصدي"],["8748B8AA-181E-551D-8146-44A5BCC7D9E0","واهاً لأسماءَ ابنةِ الأشدِّ","قامت تراءى إذ رأتني وحدي"],["2209B189-80FE-5AB0-9CD1-63106EEB124F","كالشَّمسِ بين الزَّبرجِ المنقدِّ","سلطان مبيضٍّ على مسودِّ"],["B7425BDB-6ED2-54DB-9204-96740F0220E4","ضَنَّتْ بِخَدٍّ وجَلَتْ عنْ خَدِّ","ثم انثنت كالنَّفس المرتدِّ"],["E4191A1F-9460-5AD3-841B-E8E2447413CA","ورحتُ من عرق الهوى أصدِّي","يَا عجَبَا لِلْعَاجِزِ الْمُسدِّي"],["EC6F89A6-1031-5EF3-B7C7-B4BB885470F6","حُدِدْتُ عَنْ حَظِّي وَلَمْ أجَدِّ","ما ضرَّ أهل النُّوكِ ضعفُ الكدِّ"],["FDF73910-173A-56EA-809D-9D1FEDE08FBA","وافق حظّاً من سعى بجدِّ","قُلْ لِلزُّبَيْرِ السَّائِلِي عَنْ وُلْدِي"],["979940BA-5B5D-5AA7-A373-D9E252E574CC","الْحُرُّ يُوصَى وَالْعَصَا لِلْعَبْدِ","وليسَ للملحف مثل الردِّ"],["8052B660-038B-55CF-BE11-F23FD31AA912","فارض بنصفٍ وأزح في القصد","النّصفُ يكفيك من التَّعدِّي"],["7BA4730A-0D12-5BA2-AE39-F8CBEABC45C5","وصاحبٍ كالدُّمَّل الممدِّ","أراقب منه مثل يوم الوردِ"],["00F3D735-0B8F-5D56-BC77-4006E333DFEF","حتَّى انطوى غير فقيدِ الفقد","وما درى ما رغبتي من زهدي"],["F8893D9B-D3CD-5ADE-9E96-048963A334C3","وطامسِ السَّمتِ جموحِ الورد","خالٍ لأصوات الصَّدى المصدِّي"],["C657F2B8-8220-5B3A-9770-881A907F6AE2","أرْضاً تَرَى حِرْبَاءَهَا كَالْقِرْدِ","يَمِيدُ فِي رَأدِ الضحَى الْمُمْتَدِّ"],["C17C8FAA-7716-5CB6-8AF1-DA80C0C226D7","للقورِ في رقراقها تردِّي","زوراءَ تُخفي عجباً وتبدي"],["CA14BD94-7135-50A7-8BB6-536043185D83","من لامعاتٍ كالسَّعالي البدِّ","تَلْمَعُ قُدَّامِي وطوْراً بعْدِي"],["36607D41-8E22-5C16-B531-899C50900178","كأنَّ قُصْوى أُكْمِهَا تُسدِّي","لا، بَلْ تُصَلِّي تَارَةً وَتَرْدِي"],["5C862ED0-8CF3-519E-A430-541E9FF0E922","ترقدُّ في يعانها المرقدّ","وَعَاصِفٍ مِنْ آلِهَا الْمُشْتَدِّ"],["D52F05D4-A29A-5DD8-9DAF-35C1A8E30843","صدعتها بالعيهم العلندِ","يَلْقَى الضُّحَى بِمَنْسِمٍ مُكِدِّ"],["9BF9477F-4AC3-5283-A9D9-0AFF09AA48B6","وَنَظَرٍ رَاعٍ وَهَادٍ نَهْدِ","وهامةٍ ملمومةٍ كالصَّلدِ"],["1944134E-DBE4-552A-9496-16542AFFB2BA","جَشَمْتُهُ أفْضَى وَشِيحَ الْجلْدِ","طَيَّ السَّخَاوِيِّ بِغَيْرِ نِدّ"],["1CEA540B-C88F-5EEC-A4A7-C3F2F3D2B9F6","مَا زَالَ يَشْدُو تَارَةً وَيَخْدِي","في بطن عيثٍ وظهرٍ صلد"],["2AAC12A1-0BC9-55A7-9A9B-5887C9A23551","أمْلَسُ لا يُهْدَى بِهِ مُهَدِّ","حتى انتهى مثلَ صليف القدّ"],["D4C0069F-8572-5575-9198-8866AC6AE539","فانصدعت عن راكبٍ مجدِّ","وَرَّادِ أمْوَاهٍ كَمَاء السِّخْدِ"],["B7360764-FC24-5CF4-9B0D-89964F4FCC06","وَغَارِبٍ أخْفَى لِخَافِي الْبَلْدِ","رَيَّانَ يَلْقَى مَعَ طُولِ الشَّدِّ"],["B0DDC062-EFBF-5B7A-8035-5A29B4B47388","مكعبراً نداءه المثدِّي","فِيهِ لِصيرَانِ الْفَلاَ تَغَدِّي"],["BC165512-8EDE-543A-9106-06A9109E8525","لَمْ يُغْذَ بِالْفَيْضِ وَلاَ بِالْعِدِّ","إلاَّ بماءِ المعصراتِ الهُدِّ"],["06C7ECC2-7402-5CDE-9F89-70E879EF316A","مُخْتَلِفَ التِّيجَانِ فِي التّنَدِّي","كُلَّلَ بِالأَصْفَرِ بَيْنَ الْوَرْدِ"],["08708D0B-3969-583D-934A-F9EA310B1652","وبالبنفس المشرق الرَّخودَّ","وَالْجَوْنِ مَشْبُوباً بِلَوْنِ الْفَهْدِ"],["B102CD7C-89CB-5739-8879-64430FD8C986","مُوفٍ عَلَى حَوْذَانِهِ كَالنَّقْدِ","مِنْ زَاهِرٍ أحْمَرَ لَمْ يَسْوَدّ"],["08C344B6-616E-5C7E-AFE2-CF1851E1B7DF","يغدو كغادي الشَّرق في التَّغدِّي","مُنْبَلِقاً مِثْل عُيُونِ الْجُرْدِ"],["4E199387-BA2C-579F-883A-B242E10F44E5","تَحَارُ فِيهِ الشّمْسُ ذَاتُ الْوَقْدِ","إذا حدا ذبابهُ المحدِّي"],["45589252-9994-5683-A67F-A81F59EEA15D","عارضهُ المكَّاءُ كالمستعدي","صَبَّحْتهُ فِي ظِلِّ مُزْنٍ سَمْدِ"],["0025D330-5728-59CE-BB0E-1D88EE71DDAF","غُدَيَّةً قَبْلَ غُدُوِّ السُّبْدِ","بعاقرٍ جدَّاء أو أجدِّ"],["4681B1A8-293B-587D-97D7-EBBA37953A11","يطلبُ شأو اليعملات الجد","بَلْ هلْ ترى لمْعَ الْحبيِّ الْفَرْدِ"],["88C13176-09DC-5FC4-801B-5BA67310AEE9","وافى من العين بنجم السَّعد","تَحْدُو بِهِ رِيحٌ وريحٌ تَهْدِي"],["4A1077B2-6924-5039-95AD-6BD097BF5AA4","كَأنَّ أنْوَاح النِّسَاءِ الْجُدِّ","فِي عَرْصَةٍ يَلْمَعْنَ بِالْفِرَنْدِ"],["70467AC7-86E1-55FC-8AC8-ED4BA15A1EF5","قدْ طبَّقَ الْغَوْرَ وأعْلَى نجْدِ","يستنَّ فيه كالنَّعام الرُّبد"],["9B27987B-80A6-5E55-A1D2-F8201E57D37F","إذا سناه انشقَّ غير المكدي","أضَاءَ لِلشَّامَةِ بَعْد الرَّقْدِ"],["1399DBE2-7FB3-5F7F-A1E8-35A63AD2909D","جُونَ الرُّبَى مِثْلَ جِبَالِ الْكُرْدِ","مُنْبعقِ الْقصْفِ هَزيم الرَّعْدِ"],["A47AD16B-B07E-5CBE-BE11-B6AE6142EC4E","قلتُ لهُ حينَ حفا في العهدِ","وَغرَّق الْوَهْد وَغَيْرَ الْوَهْدِ"],["0148CDB5-0B26-509F-A460-F22201C4E39C","بِسَبَلٍ مِثْلِ زُلاَلِ الشَّهْدِ:","اسْلَمْ وَحُيِّيتَ أبَا الْمِلَدِّ"],["6793B7E2-AF85-52EB-87FC-70F1D5775A23","أنت جنى العود وموتُ الرِّئد","متوَّج الآباء ضخمُ الرَّفد"],["7CBABD86-3F65-52B3-9AB0-EFB7CF8B0B61","مفتاح باب الحدث المنسدِّ","نِعْمَ مَزَارُ الْمُعْتَفِي وَالْوَفْدِ"],["10F084B3-4EAA-5A3F-85F1-AB1DA54E53C6","وأنت للجندِ وغير الجندِ","مُشْتركُ النَّيْل وَرِيُّ الزَّنْدِ"],["39AD506B-17C9-54A8-BBB6-FCA0D730D5A5","تسبقُ من جاراكَ قبل الشدِّ","بالحلم والجودِ وضربِ الكردِ"],["4DD20F43-CAD0-5FB1-81DD-C60516266D9A","ما زلتَ معروفاً مع الأردِّ","أغَرَّ لبَّاساً ثِيابَ الْمَجْدِ"],["F05D222B-8344-55E6-9231-C7490D0189B0","ما كان منِّي لك غيرُ الودِّ","ثمَّ ثناءٌ مثل ريح الوردِ"],["F69FA1F8-860C-5030-9C67-3B82FA0082A9","نسَجْتُهُ في الْمُحْكَمَاتِ النَّدِّ","فَالْبسْ طِرَازِي غَيْرَ مُسْتَبَدِّ"],["F111B1A8-11BD-577E-BA22-DBE9CA16A813","لله أيامك في معدِّ","ثُمَّ بَني قَحْطَانَ ثُمَّ عَبْدِ"],["7AB95289-28A7-50DF-9094-E4CB63D1D8A5","يوْماً بِذِي صبْية عِنْد الْحدِّ","وعِنْدَهُ اسْتَوْدَعْتَ أرْضَ الْهِنْدِ"],["89DD1F5D-A13D-5B83-9332-13DBAA92DD36","بِالْمُقْرِباتِ الْمُبْعِدَاتِ الْجُرْدِ","إِذا الفَتَى أكْدَى بِها لَمْ تُكْدِ"],["6180D55C-7AF7-5A88-B152-2EDE5559E576","تلحمُ أمراً وأموراً تسدي","وابْن حَكِيمٍ إِذْ أتَاكَ يَرْدِي"],["9D70EA06-40F1-5E70-A27E-3732826B1561","في العدد المعلنكسِ الأعدِّ","راح بحدٍّ وغدا بحدِّ"],["15279EE7-1E95-5C7B-88C7-EA317E62FCBD","يحفز دفاعاً كطردِ الصَّرد","حفْز الأَّوَاذِيِّ عُبَابُ الْمَدِّ"],["CE7975CC-F30E-54D4-8AD4-E3C423F7AC49","كَأنَّهُ مِنْ غُلَوَاءِ الْجُرْدِ","فِي الْعَسْكَرِ الْمُسْلنْطِحِ الْمُقوَدِّ"],["35082E37-267C-5525-9C9C-5D8AF362DF29","أصَمٌّ لاَ يَسْمَعُ صَوْتَ الرَّعْدِ","حَيَيْتهُ بِحَتْفِهِ الْمُعَدِّ"],["7CF2CCFF-9329-54AE-B4D0-343B70553B6A","بَعْدَ طِعَانٍ صَادِقٍ وَجَلْد","فانهدَّ مثلَ الجبلِ المنهدِّ"],["A7E0D410-5029-5942-8AF4-D7A6658DBB70","وانْفَرَجَتْ عَنْ أسَدٍ ألَدِّ","وَعَنْ نُمُورٍ حَوْلَهُ وأسْدِ"],["00572FCB-0704-5E3D-89B7-EEB0719B4F61","صرعى كصرعى الخندريسِ المردِ","بعداً ولا ترث لهم من بعدِ!"],["5719178D-E2B1-510F-888C-D533401E71F9","كلّ امرئٍ رهن بما يؤدِّي","وربَّ ذي تاجٍ كريم المجدِ"],["2EAFCAE9-7492-5A80-87D1-0BB59C8CE017","كآلِ كسْرى وكآل بُرْدِ","أنْكَبَ جَافٍ عَن طَرِيق الرُّشْدِ"],["F1FE3362-1795-545E-B127-FA1DFE3D6F0C","فصلتهُ عن ماله والولد","يا بنت أفصى من بني العرندِ"],["076F53C1-5619-5361-8753-29C92D75E429","قولي لعبدِ القيسِ إن لم تجدِ:","لا تَفْرَحِي بِالْجَلَبِ الأَشَدِّ"],["E985F564-8F64-5A21-B9E3-3EE60C4670CF","قد يخرجُ الَّليث سهام الوغدِ","قُومِي.... ـد ما أوْ صِدِّى"],["11F5DAFC-3976-5D32-8961-8217B8FACB53","فَانْتَظِري عُقْبَةَ بَعْدَ الْوَخْدِ","سِيَّان مَنْ يغْزُو وَمَنْ فِي اللَّحْد"],["614EEA36-A7A7-51C2-BF43-36C182A623BF","قد جاءك الدَّهرُ بأمرٍ إدِّ","بعقبة المشغبِ ثمَّ المجدي"],["F9718829-D182-5350-A9D8-D1C83CE916D7","يهُزُّ أعْلَى سَيْفِهِ الأَحَدِّ","في جحفلٍ كالعارضِ المسودِّ"],["ED959BAB-AF23-5BC5-9AF5-7AB898F2A0E4","يشقُّ متن الصَّحصحانِ الجرد","بِالْعَلَمَينِ فِي الحَدِيدِ السَّرْدِ"],["C1A0E365-E8FF-5259-A03A-686DAFB3D0B4","وكلَّ جيَّاشِ العشايا نهدِ","في لبدهِ والموتُ فوقَ الَّلبدِ"]]},"7EA176AB-4253-5AF4-9D81-9170A654FC80":{"t":"يَا طُولَ هَذَا اللَّيْلِ لَمْ أرْقَدِ","p":83,"s":"يا طول هذا الليل لم أرقد","r":"462786","v":[["C963148D-0E25-5818-9A2A-A2415D7D3410","يَا طُولَ هَذَا اللَّيْلِ لَمْ أرْقَدِ","إِلاَّ رُقَادَ الْوَصِبِ الأَرْمَدِ"],["FEF36F7F-B31A-5863-909A-01889467DF44","مِثْلَ اكْتِحَالِ الْعَيْنِ نَوْمِي بِهِ","بَلْ دُونَ كُحْلِ الْعَيْنِ بِالْمِرْوَدِ"],["C9089150-F261-5BFE-A281-56FFED40496A","أراقب الصبح كأني امرؤٌ","مِنْ رَاحَةٍ فِيهِ عَلَى مَوْعِدِ"],["1EDBA1B9-CC3C-5291-9B8D-4F83E9D89098","بِتُّ إِلَى أنْ رَاعَنِي ضَوْؤُهُ","وخلف سني إصبعي من يدي"],["9F93D161-43F1-5E32-9D26-0B0B1D0969A6","تَعَجُّباً مِمَّا دَهَانِي بِهِ","أقْرَبُ جِيرَانِي لِذِي الأَبْعَدِ"],["60007FBD-AE11-588E-82B8-7719C30BF29D","رقى إليها كذباً لم يكن","مني على ممشى ولا مقعد"],["59B72A43-EED8-51DA-A3EF-7B29D311D35D","حتى أدلت بل ثنى لبها","عنى مقالُ الكاشح المفسد"],["1EA921B7-03E2-587A-8305-895412668639","فِي الصَّدْرِ مِمَّا بُلّغَتْ حِبَّتِي","مِثْلُ شِهَابِ الْقَابِسِ الْمُوقِدِ"],["A2DB45F2-373C-533F-812E-F3D065BAF56B","إن بردت عن كبدي لوعةٌ","طالت على القلب فلم تبرد"],["D7A9AEFA-0C48-58B2-8A63-5F2D860850E4","بل أيها الواشي بها عندنا","لاَ زِلْتَ لاَ تُعْجِبُنِي فَازْدَدِ"],["900E4314-04FD-52D4-BC1B-E878B55B1982","أنْتَ لَعَمْرُ اللّه أوْجَدْتهَا","علي حتى كدرت موردي"],["E1298B52-EF87-5AC8-B6AE-BB722FB1ACE5","وكُنْتُ أسْبَانِي بِهَا صَاحِباً","يَعْتَلُّ فِي الأَمْرِ وَلَمْ يُوجَدِ"],["3CD9667E-E21C-524A-ACC4-06AC8E075BC3","لَمْ تَرَ مِثْلِي مُغْرماً بِالْهَوَى","وَمِثْلَ عَبَّادَةَ لَمْ تَقْصِدِ"],["D893D596-A5F2-5C92-8FD3-B6AC596C3825","تَبْرُو لدى هَجْرِي وَأَدْوَى بِهِ","فلست بالحي ولا بالردي"],["27A555F2-69CC-5956-B73A-977A8A8AEA8E","لَكِنَّنِي مِثْلِ سَبِيلِهما","مِثْل سَلِيم الْحَيَّةِ الأَسْوَدِ"],["76F96042-C8BF-5A5E-A897-BB60D3EA0B43","شتان ذا منها وإرسالها:","أدَالِجٌ أنْتَ وَلَمْ تَعْهَدِ"],["B99830E0-8257-5F9C-BEEE-4C8B11B6CF6C","غداة زمت إبلي غدوةً","والْقَوْمُ مِنْ بَاكٍ وَمِنْ مُسْعِدِ"],["B715C870-9968-578C-A7E7-1B449E7EC394","فَقُلْتُ: إِنْ آبُوا فَأنْتِ الْهَوَى","وإن أرح منك فلا تبعد"],["3B5C97B4-9B5F-5CD0-97A9-E2693BE11F19","يَا عَبْدَ لاَ تَنْسَي فَلَمْ أَنْسَهُ","ممشاي بين المسجد المبتدي"],["9757E403-8F12-5DB8-860E-A2A0EA27810B","يَوْمَ عُبَيْدُ اللّه كَالْمُعْتَدِي","عَلَيَّ فِي حُبِّكِ أوْ مُعْتَدِي"],["E7BABBF0-2D24-57A7-89A7-2107E8404EA5","يقول إذ أبصرني مقبلا","فِي الْقَوْمِ مُعتَمّاً وَلَمْ أرْتَدِ"],["2ABDC225-ABA6-566D-AA47-40BB1657D238","لَمَّا رَآهُ شَهِدَتْ عَيْنُهُ","مُشَوَّهَ اللّبْسَةِ فِي الْمَشْهَدِ"],["57949D77-47FF-5718-BCB0-F03EEA779114","هَذِي کلَّتِي دَلَّهَهُ حُبُّهَا","وكان حيناً من حصى المسجد"],["65C8F3A2-AEEB-50A1-85B0-484393AF57E3","فقلت: يا صاح بها حيني","كلني لما بي لستُ بالمرشد"],["85AC76A9-FCFA-5244-B950-6D2FD4015CB9","كنت كما قلت من أبنائهِ","وَفِتْنَتِي عَبْدَةُ بِالْمَرْصَدِ"],["D778CDC7-AC20-5634-ABCC-ABDA251B9FCF","بينا كذا إذ برقت برقةً","بَيْنَ رِدَاءِ الْخَزِّ وَالْمِجْسَدِ"],["19FEB9C7-889E-5388-BC3A-4350E9E3CBCA","بَيْضَاءُ حسْناً أشْربَتْ صُفْرَةً","تهتز في غصن الصبى الأغيد"],["0B21538E-D416-5A0F-88C1-3C2C49406D40","تحسدها الجارات من حسنها","وَمِثْلُ عَبَّادَةَ فَلْيُحْسَدِ"],["F96CE0B0-F2CB-588F-ABE8-9E6B4C554D28","يَحْسُدْنَ مِنْهَا قَصَباً مَالِئاً","للقلب والخلخال والمعضد"],["7A033814-AE1D-5326-89E9-7F6DBDD79B0A","والدر والياقوت يحسدنها","مناطةً في الأوضح الأجيد"],["4B1DF518-A048-51FC-99A8-D02F873AAEF8","وَمَضْحَكاً مِنْها كَمَا أوْمَضَتْ","صيفية المزن ولم ترعد"],["EC11BC3C-ED96-5791-B265-5D6F4F1625FF","وأنها حوراء مكحولةٌ","غانية تغنى عن الإثمد"],["F0AD7802-59EC-5645-98C9-C72A052D3096","يَحْسُدْنَهَا ذَاكَ إِلَى صُورَةٍ","قامت بها عندي ولم تقعد"],["94F5F2C7-1CA3-5C3B-8DF2-36B23F93498B","لا عيب فيها غير تأخيرها","كل صباح وعدنا في غدِ"]]},"BA7031D4-867B-52BC-B2E7-16A6300AB1B9":{"t":"يَا عَبْد زُورِيني تكُن مِنَّةٌ","p":83,"s":"يا عبد زوريني تكن منة","r":"463327","v":[["2150823B-8E19-502C-BA1F-2C1CED9709B0","يَا عَبْد زُورِيني تكُن مِنَّةٌ","للَّهِ عندِي يوم أَلْقَاكِ"],["00B9B836-8777-58E3-B6AD-A21CCBE40FC4","والله ثم الله فاستيقني","إِنِّي لأَرْجُوك وأَخْشَاكِ"],["4E02813F-12BD-521C-89E2-25FD6A1E493C","يَاعَبْدَ إِنِّي هالك مدنف","إِن لَمْ أذق برد ثنايَاك"],["83FA8C9C-A691-52B9-8BEB-80A855794B3D","فلا تَرُدِّي عاشقاً مدنفاً","يرضى بهذا القدر من ذاك"]]},"6AB61083-36DC-55CB-BA0B-A0B604DDC063":{"t":"يَا عَبْدَ باللَّهِ ارْحَمِي عَبْدَكِ","p":83,"s":"يا عبد بالله ارحمي عبدك","r":"463342","v":[["67CE3140-B4B0-5F06-AAB7-4F2F99549D95","يَا عَبْدَ باللَّهِ ارْحَمِي عَبْدَكِ","وَعَلِّليهِ بمُنَى وَعْدِكِ"],["8AA8CE5B-E6FF-554C-8B2B-2F47E4C2DC33","يصبحُ مكروباً ويمسي بهِ","وليس يدري ما لهُ عندكِ"]]},"CC1ACD79-A726-5B82-8509-DEA400E8B146":{"t":"يَا عَبْدَ بَاهِلةَ الذي يَتوعَّدُ","p":83,"s":"يا عبد باهلة الذي يتوعد","r":"462829","v":[["D8035A41-70B1-5369-9012-47C24B7B3ED5","يَا عَبْدَ بَاهِلةَ الذي يَتوعَّدُ","أعلي تبرق إذ شبعت وترعد؟"],["CEEEB36C-F66A-5E71-84B0-21AFC5FE8212","يا عبْد باهِلَةَ ابْتُلِيتَ بِحيَّةٍ","فتركت طاعتنا ورحت تهدد"],["5CCC098E-E79E-5A7B-8B38-9B6E5978E5E5","وَشَتمْتَ رَبَّكَ في العشيرةِ قائماً","لتكون موجوداً وليتك توجد"],["CB597A4E-AE63-51DC-9F40-63D4A4EFD7D4","وة كذاك عبد السوء يشتم ربه","سَفَهاً، ولكِنْ هلْ تُجابُ الأَعْبُدُ؟"],["137A423F-C783-5839-AF0B-F9C5DEFA74E2","اقْعُدْ فَإِنَّكَ بَاهِليٌّ وَاغلٌ","يَجْزِيكَ سَوْءَتَكَ الضِّيَاعُ الرُّوَّدُ"],["304F67BF-ADC8-5FED-B1A0-A832FA4BA601","وَإذَا سَكِرْتَ فَخُذْ بِأَيْرِ مُسَاعِفٍ","وَاسْكُتْ فَإِنَّكَ نَاطِقٌ لاتُرْشَدُ"],["F6E2DDE7-674D-5FFF-AF94-7813CA62088D","تَجرِي مِنَ الذَّهَب المُصَنّم رَاحَتِي","كَرَماً وَنَارِي بِالْيَفَاع تَوَقَّدُ"],["2FC9397D-67B5-5B2B-BF94-05F57B923793","وَلَئِنْ عَمِرْتَ لَتَعْرِفَنَّ قَصِيدَةً","تجب الصلاة لها عليك فتسجد"],["C3F7AC11-F70E-5977-992D-5F5A872ED7BE","وتَظَلُّ تُرْعَدُ مِنْ هَدِيلِ حَمَامةٍ","وَإِذَا دُعِيتَ لِسَوْأَةٍ لاتُرْعَدُ"],["5397C6B6-0D3E-51AD-A09F-B68B0336B869","وَمَلأَتَ ثَوْبَكَ إِنْ رَأَيْتَ كَتِيبَةً","في النوم أللها الحديد الموجدُ"],["3CB9A5A5-91F8-57EA-9BF8-63E9D03CF93B","ومجنت حتى ما تصلي ركعةً","ونسيت ما قال النبي محمد"],["23913332-8881-5D68-A649-E012131AC2C9","وَحَسَبْتَنِي كَأبيكَ لاَيَنْكِي الْعِدَى","فَاصْبِرْ لِحِسْبَتِكَ الَّتِي لاتُحْمَدُ"],["E77AA83C-A1F4-5101-8107-F10CF4CFBEF9","مولاك أرقب من ربيعةِ عامر","أَهْدَى لِكَفِّكَ قَائِماً لا يَرْقُدُ"],["73811784-661A-5662-BEC9-C590AFE3F6CE","فتركت عقر قناتكم عند امرئْ","جمح الشباب به الأنيق الأغيد"],["B95B26F6-8B29-54DC-AA20-16F678C82755","وَكذاك كان أَبُوك يُؤْثَرُ بِالْهُنى","وَيَظَلُّ فِي لقْطِ النَّوى يَتَردَّدُ"],["B63499DC-2014-5DAB-AEF4-0F6BDD9A7BB9","فلئِنْ قعدْتَ على الْخَنَا وَحَسَدْتنِي","إن الكريم إذا جرى لمحسدُ"],["0BB86FE2-F0F4-582A-B1E0-AD3A2169A651","يَا عَبْدَ بَاهِلَةَ الَّذِي لَزَمَ الْخَنَا","وَأَضَاعَ عُقْرَ قَنَاتِهِ لاتَسْعَدُ"],["C67F8257-0761-544C-B7AE-759B43175FBB","لَوْلاَ دَلَفْتَ لِمَنْ دَهَاكَ بِأيْرِهِ","فحسرت عنك حزازةً لا تبرد"],["35D94562-1086-5B04-A94F-04180871E7E1","لو كنت من أسد العشيرة لم تنم","حتى يخالطه الحسام الأربد"],["855329E7-01F5-5196-BC00-7086C3033A16","عودت نفسك أن تضام فخلها","كل امرئ رهنٌ بما يتعود"],["6C55396F-22C5-5DAF-BA97-863321C75521","وأبى لك الحسبُ اللئيم فنالهُ","وَكسَاك ذِلتهُ أَبُوك الْقُعْدُدُ"],["A92FEF87-0C79-5FBA-AFCE-410EEF4D911D","لا تسْتطِيعُ مُرَفَّلاً مِنْ عامِرٍ","عجل العقاب وأنت عبد أقفد"],["F86720E5-E816-5562-8A09-56494BFEC013","وخشيت سطوة عامري فاتكٍ","تَقِفُ الوفُودُ بِبَابِهِ وَالْوُفَّدُ"],["590EE6A4-13DF-5B9A-86B5-11E342F3EEA7","وبَنَيْتَ بِالْبَعْرِ الْمَحَلَّ وَبِالنَّوَى","بيتاً عليه خزايةٌ لا تنفد"],["8C130C47-8CCF-5726-A83B-C8DC828C52F1","وَطلبْت بالْخَلَقِ المُرَقَّعُ شأوَنا","فلترجعن وبظُر أمك يرعد"],["DD0BF3D4-B64B-549A-AC9E-ED062AA7CCE6","مهلاً موالينا أقيموا خرجنا","وَإِذا غضِبْنَا غضْبَةً فتَبدَّدُوا"],["512641A7-A4D0-5C30-8266-E8C06A892654","خدَمُ المُلُوكِ إِذا قعَدْنَا فِي الْحُبَى","قاموا وإن نفزع لروعٍ يقعدوا"],["42203884-C236-5F38-90DE-47C0E0F38562","كُونُوا لِموْلاكُمْ يَداً وَصَلَتْ يَداً","ودعوا الفساد يعيث فيه المفسد"],["8C161E01-C1B0-5CB5-8F85-080663FDBB72","وتشبهوا بأبٍ وعم صالحٍ","متعبدين لنا ونعم العبدُ"]]},"A741A87D-38CF-5561-98D1-DD173B9EF5F7":{"t":"يَا عَبْدَ ضَاقَ بِحُبِّكُم جَلَدِي","p":83,"s":"يا عبد ضاق بحبكم جلدي","r":"462851","v":[["C82C906C-92E4-5FEB-BB6A-574ED5341C36","يَا عَبْدَ ضَاقَ بِحُبِّكُم جَلَدِي","وَهَوَاكُمُ صَدْعٌ على كَبِدِي"],["2C6C3B16-50FD-58C7-A945-9CDCCAAFB8CF","إِنِّي حَلَفْتُ ألِيَّةً صَدَقَتْ","بِفَنَاءِ بيتِ الْواحدِ الصَّمَدِ"],["136032E4-AD5B-5DE4-AFB2-52B02B944B26","لتركتني صباً بحبكم","وقتلتِنِي ظُلْماً بِلاَ قَوَدِ"],["B7247BF1-553D-5314-A447-674FC3CD5F2A","أبقيت من قلبي حشاشته","وَحَلَلْتِ بين الرُّوحِ والْجَسَدِ"],["DC89174B-8FC9-51E5-AC27-C27529DC6C52","أَفَما أَنَى لكِ يا عبَيدَةُ أنْ","تَشْفِي أخَا الأَحْزانِ والْكَمَدِ"],["94865C7D-60CB-5423-A10F-6B1F9FADE4A4","يُمْسِي وَيُصْبِحُ هائِماً بكُمُ","ويهال بالترويع والسهد"],["C3F425E9-6E56-586E-B008-C9B6D78E3A93","نرجُو عُبَيْدَةَ أنْ تَجُودَ لَنَا","مَا إِن يُرَجّى بَعْدُ مِنْ أحدِ"],["03F68E39-04DB-5C4A-9178-6AE6D9D6A531","علقتها بيضاء ناعمةً","لم تَجْفُ عن طُولٍ ولم تزِدِ"],["EDC7B2FB-1E04-578F-883B-660DAAC06AD6","وتريك عيني جؤذرٍ خرق","بالرَّوْضِ لم تُكْحَلْ مِن الرَّمَدِ"],["D46A8BC1-F640-5279-AF57-F334D2B24AE7","أحوى المدامع زان قامته","حلل الدمقس تظل في أود"],["75DB541F-083B-5630-A2B5-A05B35CA701C","كالزَّمْهَرِيرِ يكونُ صائِفَةً","وَهَوَى الْمُعَانِقِ ليْلة الصّرَدِ"],["DB69DD42-2EE2-5550-93E4-ED1EA893D451","تمّتْ تَرَائِبُهَا إِلى قَدم","والساق مكملةٌ إلى العضد"],["E406D37C-5B69-5FE5-AED0-FC223657BBF0","وإذا نظرت وجدت مطمعها","ماء السؤال سواه لم تجد"],["28F63ABD-DE2B-5AA6-8794-E21CD27577B5","قولا لها ما دمت مطلعاً","إلا ودونك أعين الرصد"],["398DBB2A-EEFA-5A42-B687-884FC33C8200","نفسي وأسرتي الفداء لكم","والأَهْلُ بَعْدَ المَال والوَلدِ"]]},"0F2E7453-3B9C-54FB-812C-29F7FB98209D":{"t":"يَا فَرْخَ نِهْيَا بِإفْكٍ قُلْتَ أوْ زُورِ","p":83,"s":"يا فرخ نهيا بإفك قلت أو زور","r":"463066","v":[["DF92B03B-41AD-5F7C-B905-2F89D3A1B9A0","يَا فَرْخَ نِهْيَا بِإفْكٍ قُلْتَ أوْ زُورِ","إذ لا تزالُ تعبا لي بتعبير"],["5370A824-0AE6-5D6C-B90E-55313F20D892","قَدْ كُنْتُ قَصَّرْتُ بُقْيَا أوْ مُحَافَظَةً","فالآن حين انجلى همي بتقصيري"],["EC573B02-45E0-55D2-A0C7-BBA2E166018A","نبئت أنك يا حماد تنبحني","والكلبُ ينبحُ مربوطاً بساجورِ"],["7691A92C-7E4D-5F66-A379-2F590ACFC3A9","أحِينَ هَرَّتْ كِلاَبُ الْحَيِّ مِنْ حَرَسِي","واحمر من مهج الأجواف تصديري"],["03DFFCB5-6EF6-5E05-827F-99FFB371A489","وذب عني غواة الناس معتدياً","بابٌ حَدِيدٌ وَصَوْتٌ غَيْرُ مَنْزُورِ"],["B02DE314-BC75-53FA-9D51-2EE4B20C1106","تفشو إلي بأشعارٍ ملصقةٍ","مَهْلاً أَبا عُمَرٍ مَا أنْتَ في العِير"],["FE0520CF-236D-54F5-BFDE-5D561100139A","حلفتُ بالقبلة البيضاء مجتهداً","وَالمْقَام وَرُكْنِ البَيْتِ وَالسُّورِ"],["B0911A64-EF08-5EF4-8E8A-B979CEFC1B44","لقد عققت عجوزاً جئت من هنها","مَا الشَّيْخُ وَالدُكَ الأَدْنَى بِمَبْرُور"],["357D7FE0-8A13-55EA-8DFC-445D6B41DBC4","غَنَّيتَ في الشَّرْبِ مْنْدُوباً ومُبْتَدِئاً","فهل كفاك التغني في المواخيرِ"],["095B805A-4A46-5A2D-ACDA-39333DE2F034","غر القصائد أسديها وألحمها","كأن رأسك منها في أعاصير"],["0DAD0EE7-4082-5FFC-8808-811FA5E7B805","اذكر سواءة ثم افخر بظئرهمُ","وَمَا افْتِخَارُ بُنَيِّ الظِّئْرِ بالظِّيرِ"],["374B8172-9593-5ABD-803F-A1DBEDE36788","صَهْ لاَ تَكَلَّمْ جِهَاراً فِي مَجَالِسِنَا","وَسَلْ عَجَوزَكَ عَنْ بَكْرِ بنِ مَذْعُورِ"],["6F933901-11C7-55FA-913D-EBA406FFEF34","قد كنت أعرفُ حماداً فأستره","وما امرؤ من بني نهيا بمستور"],["C864B046-3907-5492-81C1-BD8F8AC21A57","وَأنتَ أَعْقَدُ مِثْلُ اللَّوْزِ مُعْتَرِضٌ","بِالدُّرِّ تَغْدُو بِوَجْهٍ غَيْرِ مَنْصُورِ"],["043D0BD4-6BE4-5E4B-B8B5-8994022BDBE2","تعطي وتأخذ من قبلٍ ومن دبر","وذَاكَ شُغْلٌ عَن الْمَعْرُوفِ والْخِيرِ"],["46954D08-0ED1-5C16-BD4E-2AC18DC10E51","وعَجْرَدٌ كَانَ وِشَّاء وكَانَ لَهُ","علم المباهي بوضع الوشي والنير"],["1D36D106-3566-5770-AD93-65E9596AB8A8","قد عالج الغرل حيناً قبل لحيته","حتى علا رأسهُ شيبٌ بتقتير"],["C3E130D3-42EE-5A55-8B4E-18D919710449","وأنتم أهلُ بيتٍ عمكم ستهٌ","فَكُلُّكُمْ بِاسْتِهِ دَاءُ السَّنَانِير"],["ED93BF87-6141-58D1-BA65-DB253B5775C1","في منصبٍ من بني نهيا تطيفُ به","شُمْطُ النَّبِيطِ بِأكْبَارِ وَتَوْقِيرِ"]]},"7A652325-485E-5050-9928-3BC6AE729873":{"t":"يَا لَقَوْمِ لِلْحَبِيبِ الْمُذَّكَرْ","p":83,"s":"يا لقوم للحبيب المذكر","r":"463076","v":[["C139BF66-2F4F-565A-A7EE-FE91C2A2A3E0","يَا لَقَوْمِ لِلْحَبِيبِ الْمُذَّكَرْ","وَخَيَالٍ زَارَنِي قَبْلَ السَّحَرْ"],["EA3C5420-DC09-5863-A219-C4DF83781197","قَمَرُ اللَّيْلِ سَرَى في قَرْقَل","يتصدى لي فأهلاً بالقمر"],["BCCAF3C1-8BEE-50B0-BA22-213FA68774AD","يا ابن موسى لا تلمني في الهوى","واسقني الراح بسلسالٍ خصر"],["B359BCC9-7D57-502F-84B1-5DDEA3B5229D","علقت نفسي بسلمى نظرةٌ","رُبَّمَا أَهْدَى لَكَ الْحَيْنَ النَّظَر"],["02105209-BC8A-51A4-8BA3-1083CCE715C9","وابلُ لي من ذاك أو لا تلحني","صعد الشوق بقلبي وانحدر"],["B266DA0F-DD46-543D-B99D-573EEADF85F7","وصحيح القلب من داء الهوى","لو به ما بي من الحب عذر"],["85240AE8-BD81-58E6-8714-4A8D898BAAC1","قُلْ لِمَنْ غَارَ عَلَيْنَا في الْهَوَى","طالعِ الْمَكْتُومَ منَّا ثُمَّ غَرْ"],["AAA6B606-C8EC-561B-A672-5C0DF32A4F9A","وأخٍ يلحى ولا أعبا به","حلب اليوم لها ودي فدر"],["367B6F11-161C-5806-BDB1-E6CB4C9D6143","مَرْحَباً واللَّه لاَ أَكْتُمُهُ","إِنَّ حُبِّي عَلَنٌ لَيْسَ يُسَر"],["26614E3F-A3CA-599D-9F22-6C9B3C5BC58D","لم أزر سلمى ولم تلمم بنا","غَيْرَ رُؤْيَاهَا أَنِمْ عَيْناً تُزَر"],["93BA0A6C-9E6B-5819-BF88-AA37AB5666F9","ثم قالت أنا في عليةٍ","يَسْهَرُ الْعَيْنُ وَأنْتَ الْمُشْتَهِر"],["B34229F3-D679-5039-AC59-4DF4E34FCF70","لا يبالي غير من يعرفهُ","وأرى الناس لهم فيك أثر"],["AEB6870C-1419-5BF4-8933-08AD4F87ADE0","فاحمل النفس على مكروهها","إن حلو العيش محفوفٌ بمر"],["480C848A-1A42-5D22-AAA1-51462A9A05AF","وإِذَا الأَمْرُ الْتَوَى منْ بَابِهِ","فارض ما أعطيت منه واستقر"],["17A5C651-A983-55A6-A9AF-5E6C6EB801A6","ولقد قاسيتُ من جور التي","عَجَبَ الدَّهْرِ وَمِنْ كَأْسِ السُّكُرْ"],["6561ADB8-1E8E-5CEE-93D8-F4B9F3AEA918","فَانْقَضَى ذَاكَ حَمِيداً عَهْدُهُ","وحسرت اللهو عني فانحسر"],["7B31AD3D-E00F-5841-BD88-901B243E480C","ولقد قلتُ لزورٍ زارني","بعدما أعرض حيناً وهجر"],["954A770D-A31B-55A3-8F3D-C8B6FE9BF559","مَنَحَ الدَّهْرُ شَبَابِي كَبْرَةً","وَكَذَاكَ الدَّهْرُ منْ حُلْوٍ وَشَر"],["4C6E7680-1382-5A3D-AA6C-9F88C038C2ED","أَيُّهَا الزاري عَلَى أَيَّامِهِ","رب يوم لك مشهور أغر"],["B25C62C5-3F4A-5388-9AF8-E969EBB7338D","رَقَّعَ الْعَيْشَ فأَبْشِر بالْغِنَى","عُقْبَةُ الْجَارِ مِنَ الْعَيْشِ النُّكر"],["ADD9CDE3-303C-51D8-8471-E346B0EFF281","وأميرُ سادةُ الناس لهُ","خولٌ ينفذُ فيهم ما أمر"],["21809E12-F836-57A7-BBA3-88390D1826E6","زرتهُ يوماً فأدنى مجلسي","وَحَبَانِي ببُدُور وَغُرَر"],["8ABE34CA-DD7D-5440-ACB3-45E668BFB28B","وَفَتًى ذِي نيقَةٍ قُلْتُ لَهُ","قلد الشعر كريماً ثم قر"],["950158D2-FD18-5CCA-BE30-F8F19D03F009","ما يسُرُّ الْحَبْشَ أَنْ تَمْدَحَهُ","خشية المعروف ما الحبش بحُرّ"],["5C637029-11EF-582B-8E05-6CC3EBBD6DC8","يشتهي الحمد ولا يفعلهُ","فَلَهُ مِنْ ذَا وَمِنْ ذَاكَ عبَرْ"],["C6FAD4C7-0E63-59D6-B5FD-819D7E7B4D66","وانْبَرَى لي عَجْرَدٌ يُوعِدُنِي","كمثير الليث ليلاً ما شعر"],["159DF083-F323-5C96-8E29-7065E2FF91A7","يتمناني وإن لاقيتهُ","خَافَ إِقْدَامِي عَلَيْهِ فَانْكَسَر"],["45C04719-3C95-50AC-997F-6F59B4F2CB30","شِيمَةَ الْبِكْرِ تَشَهَّى بَاهَةً","وتخشاهُ فلا تأتي الغرر"],["D33C4705-71A0-5BD6-BA28-4FE73ACB5988","مِنْ بَنِي نِهْيَا نَهَاهُ وَالِدٌ","أعقف السيف على الجرح مقر"],["223C5230-D151-590B-AEF5-12082A1FDF7D","يَحْسُرُ الذَّمَّ عَلَى أعْطَافِهِ","وترى الحمدَ عليه كالعور"],["E2E12AB2-EA26-504F-A98D-DB6BBB92DFFD","صدني عنه وقد واجهتهُ","عُقْبَةُ الأَزْهَرُ قَضْقَاضُ الْحَجَر"],["AA8CD151-C454-5737-A43A-311FEEC3DFCD","فتأبيت على مستأذنٍ","مُشْرِقِ الْمِنْبَرِ فَضْفَاضُ الأُزُرْ"],["5C1A5337-9A6D-5D54-A23B-93986DB97018","رهبةً أو رغبةً في ودهِ","إِنَّهُ إِنْ شَاءَ أَحلَى وَأَمَر"],["E8E79963-DDD7-5F94-9B61-83E8FCEB1907","ملكٌ يسهلُ إذ ساهلتهُ","وإذا عاسرتهُ كان العسرُ"],["0605A823-DCD3-5D5C-A750-6151C80DFF8C","سَائِسُ الْحَرْبِ وَمِفْتَاحُ النَّدَى","عندهُ نفعٌ لأقوامٍ وضر"],["63B17BEC-4B7E-5A67-8DD6-B9E3ECC7C707","داءُ عاصٍ ومداوي فتنةٍ","سفرت حرباً ولاحت تستعر"],["4605AF5D-F9CA-506C-B4E7-EBA9F204804E","يَتَّقِي المَوْتَ بهِ أشْيَاعُهُ","حِينَ جَفَّ الرِّيحُ وانْشَقَّ البَصَر"],["E03AA33F-252B-5F73-8AFF-E60C8A65DC80","أسَدٌ يُرْقِدُ نِيرانَ الوَغَى","وإذا زلزلهُ الروع وقر"],["0BD80855-A9CB-5EA3-B390-CFE48DAE3697","وَفَتى قَحْطَانَ فِي حَوْمَتِهَا","رَاجِحُ الحِلْم كَرِيمُ الْمُعْتَصعر"],["0FD6932D-1EBD-574A-A7FF-06D8A6C25B5B","يورد الهم ولا يمرضهُ","حَازِمٌ فِي الوِرْدِ مَحْمُودُ الصَّدَرْ"],["7433F893-3FD8-559F-BE0B-C454D409B6D6","وَجَوَادٌ مُسْهِبٌ حِين غَدَا","تفترُ الريحُ ويمسي ما فتر"],["1D05241D-5D57-5841-8A24-2094EC735C19","لَوْ جَرَى نَائِلُهُ في حَجَر","قاحل الصفحة لا بتل الحجر"],["6EAF06DE-F5CA-5F30-89FB-5F22A98BBE81","كم له من نعمةٍ في وائل","وَبَنِي أفْصَى وَفِي حَيِّ مُضَر"],["617C0A31-DEFE-5CE7-95CA-5D6646A0605D","فاكتسب ناقلةً من وده","عز من ود ابن سلمٍ ونصر"],["DF200B94-EDAD-5524-B89C-56DECAABE465","عُقْبَ أنْتَ الْمَرْءُ لا يُشْقَى بِهِ","غَائِبٌ منَّا ولا دَانٍ حَضَر"],["A19E91CA-55F1-5004-BDDB-AD0E62ECB950","جئنا هلكى فأحيت الندى","فَلَكَ الْحَمْدُ عَلَى مَيْت نُشِرْ"],["C41CD4C1-3FCE-5FC8-BC62-32E138B12364","لاَ تَخَفْ غَدْرِي وَإِنْ غَيَّبْتَنِي","قدر يعرض من بعض القدر"],["CFDD11E5-D6F0-568B-BD12-29F77AB39FC0","أنا من يعطيك قصوى نفسه","وإذا أوليته خيراً شكر"],["8553BA57-FF05-5A2A-AD96-C86D108459EC","مَا يَرَى مثْلَكَ إِلاَّ مُزْنَةٌ","بَكَرَتْ في يَوْم سَعْدٍ بمَطَر"],["32EE1512-D9D8-5447-9D47-87006439E82C","كل يومٍ لك عندي فضلةٌ","ويدٌ بيضاءُ فيها مدخر"],["8A34F09E-DC45-569E-8FA5-17FF023DB4A2","قد أنى للغيث أن نسقى به","أو نَرَى مِنْهُ بَوَادِينَا أَثَرْ"],["3A4C87F8-3D3A-5558-BFB1-166BD22573AC","وَلَقَدْ كُنَّا عَرَتْنَا جَفْوَةٌ","أكلت منا السلامى والقصر"],["60F9CD61-98E8-5A93-A35D-4F8D57AD2BEE","إِنَّمَا كُنَّا كَأَرْضٍ مَيْتَةٍ","ليس للرائد فيها منتظر"],["44C03447-4845-54FC-BB27-7B24AA30A454","فحيينا بك إذ وليتنا","وَكَذَاكَ الأَرْضُ تَحْيَا بالْمَطَرْ"]]},"E80F0616-03FB-5F8E-B020-6146818F4043":{"t":"يَا مَنْظَراً حَسَناً رَأيْتُهْ","p":83,"s":"يا منظرا حسنا رأيته","r":"462670","v":[["956404CC-85F9-5E34-B81E-BC70671A9F0A","يَا مَنْظَراً حَسَناً رَأيْتُهْ","من وجه جارية فديته"],["05635AEA-C3D3-5184-980C-561DD11F7AA8","لَمَعَتْ إِلَيَّ تَسُومُنِي","لعب الشباب وقد طويته"],["4968788D-3D4B-50EE-BBF3-CD13FAD5218A","وتقول: إنك قد جفو","تَ وَكُنْتَ لِي شَجَناً حَوَيْتُهْ"],["E4F1D00A-98FE-5443-8666-D860886DCCD0","فأريد صرمك تارةً","وَإِذَا ارْعَوَى قَلْبِي نَهَيْتُهْ"],["73A8924D-A021-58B0-8C2B-908D62F41FDD","وَأرَى عَلَيْكَ مَهَابَةً","وَيَحِلُّ ذَنْبُكَ لَوْ بَغَيْتُهْ"],["43E53361-39C1-5624-8933-6594784C4163","ثم اعتذرت من الصدود","فمَا سخطْت وما ارتَضَيْتُهْ"],["67D5EBA6-1BB7-5819-96CB-64315B35CF44","يا سلم طاب لك الفؤا","د وعزَّ سخْطكِ فَاحْتَمَيْتُهْ"],["272267A9-2996-54C8-95A4-30523D2F4EC9","والله رب محمدٍ","ما إن غدرتُ ولا نويته"],["CF429B45-B64F-5362-933E-F437DE3CE895","أمسكت عنك وربما","عرَض البلاء ومَا بغيْتُهْ"],["5B1A2C71-12DA-5AC7-A11F-38EA7E0B1FCA","إِنَّ الْخَلِيفة قَدْ بغى","وَإِذَا أبى شيْئاً أبَيْتُهُ"],["606C2037-F09A-5F34-8D73-192346EE60A1","ومخضبٍ رخص البنا","ن بكى علي وما بكيته"],["452B2FDC-D9CD-5AD7-B695-8B5C19692E6F","ودَعانِيَ الرَّشأُ الْغرِ","يرُ إِلى اللِّعابِ فما أتيتُهْ"],["029D9F3F-FF00-541C-BB55-DEEAF51E5AAE","ولقد أخذتُ من الصفا","مَا فِي الضَّمِيرِ وقدْ لويْتُهْ"],["4706A8D4-4FAC-534E-9D36-92A1BCAFE3DE","ويشوقني بيْت الْحَبِيب","إِذا غدوْت، وأيْن بيتهْ"],["74B118C8-223D-509D-B8D7-CC0D2EE23AA8","قام الخليفة دونه","فصبرت عنه وما لقيته"],["744BE917-2486-5A7A-B494-65BF8E238F6D","ونَهَانِيَ الْملك الْهما","م عنِ النِّسَاءِ وما عصيْتُهْ"],["664D6F8C-45DA-52E6-8FA6-3FBE9F6A56DC","لا بلْ وفيْتُ وَلمْ أضِعْ","عهداً ولا وأياً وأيته"],["871234D4-8B1D-5FB0-99AA-1DC62680E64A","وأنا المطل على العدى","وإِذا غَلا عِلْقٌ شريْتهْ"],["3D70F860-402F-5D8B-8E12-D623A1FE050D","أصفي الخليل إذا دنا","وإذا نأى عني رأيته"],["2674074B-4673-5044-8916-F104CCAB15B8","وأميل في أنس النديم","مِنَ الْحَيَاء وما اشْتَهَيْتهْ"],["EEA93EBD-881F-5C3B-A588-9014A5A763FA","حال الصَّفاء عَلى الصَّفا","ءِ وَلَمْ يَكنْ عوداً بَرَيْتُهْ"],["5F7BC8E6-AA5D-503A-9401-1649113C832D","فالأمر غير مقصرٍ","لو خفت صاحبي اتقيته"]]},"9953EFAB-A21D-5913-A9BB-E227DAA5E461":{"t":"يَاعَبْدَ حبكِ شَفَّني شفَّا","p":83,"s":"ياعبد حبك شفني شفا","r":"463278","v":[["9AF1E416-F73A-5571-B4EB-A27C5DB6367D","يَاعَبْدَ حبكِ شَفَّني شفَّا","والحب داء يورث الحتفا"],["1EEE6AA6-1444-5338-914B-D9DAAE465BC3","والحب يخفيه المحب لكي","لا يستراب به وما يخفى"]]},"60207985-F996-5EA0-B0F8-3E38691B3617":{"t":"يَاعَبْدَ حُبِّي لَكِ مَسْتُور","p":83,"s":"ياعبد حبي لك مستور","r":"463190","v":[["02A3359F-2AAF-5D8C-A47F-5E9D7954CE50","يَاعَبْدَ حُبِّي لَكِ مَسْتُور","وكل حب غيره زور"],["1123BE61-7CE2-55CE-88BD-83A9C5DFF1A2","إن كان هجري سَرَّكُمْ فاهْجُرُوا","إِنِّي بما سَرَّكِ مَسْرُورُ"]]},"CD59E509-0C2B-56D0-805E-548F3B9128AE":{"t":"يَفْخَرُ الباهليُّ أن جعل اللَّـ","p":83,"s":"يفخر الباهلي أن جعل اللـ","r":"462499","v":[["D80268FB-2E65-53CC-9EA1-761753F36BDC","يَفْخَرُ الباهليُّ أن جعل اللَّـ","ـه له وَحْدَهُ حِراً من وَرَاء"],["31586CB5-30B6-586E-BAF1-AAE75F0AD5B4","ولقد قلتُ يومَ زافَ لمسعو","دٍ وألقى عنهُ قناعَ الحياء"],["C5B2153D-CA8A-5952-B000-C344540FCC52","خبّرتني القنفاء عنك بشيءٍ","فاتَّقي الله في استكَ البخراء"],["2AD7A2B7-D960-5535-8C38-C4D5B0CE9834","لا تدع زنيةً ودع زُبَّ يحيى","واسْألْ أخْتيْك عنْ لذِيذِ الزِّناء"]]},"90DF3A83-183D-51FD-8AEC-EF2212102A57":{"t":"يُكلِّمُهَا طرفي فَتُومي بطَرْفِها","p":83,"s":"يكلمها طرفي فتومي بطرفها","r":"462986","v":[["A214F604-C82F-5834-8673-DBBC0AFBA86C","يُكلِّمُهَا طرفي فَتُومي بطَرْفِها","فيُخْبِرُ عما في الضَّمير من الْوَجْد"],["36ECA7FA-2F8E-5174-89C0-4BCCE1CED240","فإن نظر الواشون صدت وأعرضت","وإن غفلوا قالت ألست على العهد"]]}}}