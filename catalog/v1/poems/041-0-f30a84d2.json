{"v":1,"poems":{"88983B1D-C1EC-5DB5-9090-6BBBF666281B":{"t":"أَرِقْتُ لِصَوْتِ نَائِحَةٍ بِلَيْلٍ","p":41,"s":"أرقت لصوت نائحة بليل","r":"469733","v":[["73A7E442-9799-5E2C-BE90-FE6284124B59","أَرِقْتُ لِصَوْتِ نَائِحَةٍ بِلَيْلٍ","عَلَى رَجُلٍ بِقَارِعَةِ الصَّعِيدِ"],["A80942E5-F7C9-5463-B78A-F9C6E0BC761B","فَفَاضَتْ عِنْدَ ذَلِكُمْ دُمُوعِي","عَلَى خَدِّي كَمُنْحَدِرِ الْفَرِيدِ"],["2E422051-399F-50E3-A6AC-323CFC1365C8","عَلَى رَجُلٍ كَرِيمٍ غَيْرِ وَغْلٍ","لَهُ الْفَضْلُ الْمُبِينُ عَلَى الْعَبِيدِ"],["29DEED0A-3F3C-5F4F-B744-97273F7F75E6","عَلَى الْفَيَّاضِ شَيْبَةَ ذِي الْمَعَالِي","أَبِيكِ الْخَيْرِ وَارِثِ كُلِّ جُودِ"],["4BFD2C43-01CD-5AE9-BA9B-7A3CA5BC4261","صَدُوقٍ فِي الْمَوَاطِنِ غَيْرِ نِكْسٍ","وَلَا شَخْتِ الْمَقَامِ وَلَا سَنِيدٍ"],["3D17CA4F-CB22-57A4-BEFF-CB38A85629EC","طَوِيلِ الْبَاعِ أَرْوَعَ شَيْظَمِيٌّ","مُطَاعٍ فِي عَشِيرَتِهِ حَمِيدٍ"],["D7C256C9-F95A-5BEC-80F1-655F4FC4B8F3","رَفِيعِ الْبَيْتِ أَبْلَجَ ذِي فُضُولٍ","وَغَيْثِ النَّاسِ فِي الزَّمَنِ الْحَرُودِ"],["DD08E9D4-5FB9-5278-9A43-A3FF09F59693","كَرِيمِ الْجَدِّ لَيْسَ بِذِي وُصُومِ","يَرُوقُ عَلَى الْمُسَوَّدِ وَالْمَسُودِ"],["C63F7F67-BCCD-5D64-AD15-691847FD53C5","عَظِيمِ الْحِلْمِ مِنْ نَفَرٍ كِرَامٍ","خَضَارِمَةٍ مَلَاوِثَةٍ أُسُودٍ"],["16A13456-83B9-58FE-A95F-66C8E7E4446B","فَلَوْ خَلَدَ امْرُؤٌ لِقَدِيمِ مَجْدٍ","وَلَكِنْ لَا سَبِيلَ إلَى الْخُلُودِ"],["F96AF3A7-4D83-5C71-90E5-5E7251E01A32","لَكَانَ مُخَلِّدًا أُخْرَى اللَّيَالِي","لِفَضْلِ الْمَجْدِ وَالْحَسَبِ التَّلِيدِ"]]},"7A19E67F-A6B4-524F-8400-1A3811A69673":{"t":"أَلَا يَا رَسُولَ اللهِ كُنْتَ رَجَاءَنا","p":41,"s":"ألا يا رسول الله كنت رجاءنا","r":"478704","v":[["9D2C5B53-C602-53F3-A5D2-91ED3B107975","أَلَا يَا رَسُولَ اللهِ كُنْتَ رَجَاءَنا","وَكُنْتَ بِنَا بَرًّا وَلَمْ تَكُ جَافِيَا"],["2C1C2EB2-5976-5869-9934-B4863A4BEDEE","وَكَانَ بِنَا بَرًّا رَحِيمًا نَبِيَّنَا","لِيَبْكِ عَلَيْكَ الْيَوْمَ مَنْ كَانَ بَاكِيَا"],["8CB7234D-8CBE-52DD-975C-0E60AF642D97","لَعَمْرِيَ مَا أَبْكِي النَّبِيَّ لِمَوْتِهِ","وَلَكِنْ لِهَرْجٍ كَانَ بَعْدَكَ آتِيَا"],["6D398178-22AC-5267-B8B1-ABC9EC94DF01","كَأَنَّ عَلَى قَلْبِي لِفَقْدِ مُحَمَّدٍ","وَمِنْ حُبِّهِ مِنْ بَعْدِ ذَاكَ الْمَكَاوِيَا"],["2FD5D37E-876F-5CD6-B7B2-EF43AC2F8EE1","أَفاطِمُ صَلَّى اللهُ رَبُّ مُحَمَّدٍ","عَلَى جَدَثٍ أَمْسَى بِيَثْرِبَ ثَاوِيَا"],["4D235011-1A0C-555A-BF6B-8BD1A470E99F","أَرَى حَسَنًا أَيْتَمْتَهُ وَتَرَكْتَهُ","يَبْكِي وَيَدْعُو جَدَّهُ الْيَوْمَ نَائِيَا"],["D8D7F097-B9DA-5743-95E3-190FA1207E44","فِدًى لِرَسُولِ اللهِ أُمِّي وَخَالَتِي","وَعَمِّي وَنَفْسِي قَصْرَهُ وَعِيالِيَا"],["AB87766E-623E-5CCE-AC18-EBFB2833F8DE","صَبَرْتَ وَبَلَّغْتَ الرِّسَالَةَ صَادِقًا","وَمِتَّ صَلِيبَ الدِّينِ أَبْلَجَ صَافِيَا"],["2E2CC220-BD13-5AC6-AA51-158E04B08AFE","فَلَوْ أَنَّ رَبَّ الْعَرْشِ أَبْقاكَ بَيْنَنَا","سَعِدْنا وَلَكِنْ أَمْرُهُ كَانَ مَاضِيَا"],["CA746AF1-0178-591E-922C-257E8723BAF1","عَلَيْكَ مِنَ اللهِ السَّلَامُ تَحِيَّةً","وَأُدْخِلْتَ جَنَّاتٍ مِنَ الْعَدْنِ رَاضِيَا"]]},"EB5E552E-F809-55F5-9A20-DCC95736ECC3":{"t":"بكي زبير الخير إذ مات إن","p":41,"s":"بكي زبير الخير إذ مات إن","r":"478709","v":[["7806B0DC-32F0-5E65-A19E-23401554B536","بكَي زبيرَ الخيرِ إذ ماتَ إن","كنتِ على ذي كرمٍ باكيه"],["1AC5C20F-8268-52B8-A4D4-86F82977BC16","لو لفظته الأرضَ ما لُمتُها","أو أصبحت خاشعة عارية"],["C5701D34-0B79-50BE-8D12-10223B83A1F6","قد كان في نفسي أن اترك","الموتى ولا أتبعهم قافيَه"],["7AD591CA-3AA7-5AF8-899B-B227E1D32E28","فلم أطلق صبرًا على رُزئه","وجدتُه أقرب إخوانيه"],["2919CDA1-498D-5BAE-9770-0B4E4276529B","لو لم أقل من فيّ قولاً لهُ","لقضت العبرة اضلاعيه"],["BBF1FA13-C6F2-5E40-A188-A040B6135B08","فهو الشامي واليماني إذا","ما خضروا ذو الشفرةِ الداميه"]]},"5A22203D-DFDA-5164-A77C-3D37F0225BA8":{"t":"كَيفَ رَأيْتَ زَبْرَا","p":41,"s":"كيف رأيت زبرا","r":"469738","v":[["42B0B398-D394-53C7-8550-3AB0A2E06CFB","كَيفَ رَأيْتَ زَبْرَا",""],["0057B1F8-D4A5-53D6-8BF9-C725A72E2089","أَأَقِطًا حَسِبْتَهُ أَوْ تمرا",""],["E898C08A-22D6-546E-9019-D7F30B621A96","أمْ مُشْمَعِلًا صَقْرَا؟ الطبقات الكبرى، لابن سعد. تحقيقُ: محمد عبد القادر عطا (1410 هـ - 1990 م)، بيروت: دار الكتب العلمية. ج3، ص74-75.",""]]}}}