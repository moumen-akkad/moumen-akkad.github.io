{"v":1,"poems":{"4ED5B7C5-CFB7-5B2A-8231-7863B3E8AE70":{"t":"أبى القلبُ أن يأتيْ السَّديرَ وأهلهُ","p":27,"s":"أبى القلب أن يأتي السدير وأهله","r":"436471","v":[["7E02BC1F-CAC5-5754-8860-E416BF5FACD6","أبى القلبُ أن يأتيْ السَّديرَ وأهلهُ","وإِنْ قِيلَ: عَيشٌ بالسَّدِيرِ غَريرُ"],["2E1150F8-40FF-5FC3-B2DF-45776768B7E1","بِهِ البَقُّ، والحُمَّى، وأُسْدُ خَفِيَّةٍ","وعمرو بنُ هندٍ يعتدي، ويجورُ"],["68A9BF99-4D3C-58D9-A50D-062D8C5232B0","فلا أُنذِرُ الحَيَّ الأُولَى نَزلُوا بهِ","وإِنّي لِمَنْ لم يأتِهِ لَنَذيرُ"]]},"86188106-FB5F-593B-8C4E-08601481FAE1":{"t":"ألا إنَّ خيرَ الناسِ كلّهمُ فهدُ","p":27,"s":"ألا إن خير الناس كلهم فهد","r":"436470","v":[["932C2B39-AF3C-5788-BFA2-09CF95E9045F","ألا، إنَّ خيرَ الناسِ كلّهمُ فهدُ","وعَبدُ كُلالٍ خَيرُ سائرِهم بَعدُ"]]},"4DB069B9-F2BE-5814-AAF7-2453BB3B71F4":{"t":"أمَّا الخلى والمسحُ إنْ كانَ منَّةً","p":27,"s":"أما الخلى والمسح إن كان منة","r":"436458","v":[["27EB2C60-477D-5A3A-B2DD-65B226FCA4CE","أمَّا الخلى والمسحُ، إنْ كانَ منَّةً","عليَّ، فإِنّي غَيرُ خالٍ وماسِحِ"],["A506B991-6CE0-56F5-82AA-F8D42C963336","وأَمَّا مَعاذِيرُ الصَّدِيقِ فإِنَّني","سأَبلُغُها، إِنْ كنتَ لَستَ بفاصِحِ"],["AA5FA25F-2B06-5625-9B7D-FAE1A0080F9C","وذِي مِئرةٍ مِنَ الصَّديقِ اجتنَبتُهُ","وآخرَ، قد جاملتهُ وهوَ كاشحُ"],["D6850C1B-C87E-54D1-9741-9CBE517EA064","تحمَّلتهْ عمداً، لأفضلَ، بعدما","بَدَتْ اُبَنٌ في ساقِهِ وقَوادِحُ"],["343D166E-0D49-555D-A2C7-C3481010EDBF","ومُهتَزعٍ حالاً ولُؤمَ خَلِيقةٍ","صَقَعتُ، بِشَرِّ، والأَكفُّ لواقِحُ"]]},"2C2A5580-DF88-5C43-B59C-D63689820364":{"t":"أَودَى الشَّبابُ حَميدا ذو التَّعاجِيبِ","p":27,"s":"أودى الشباب حميدا ذو التعاجيب","r":"436454","v":[["A84FCB1E-CCC4-5C4D-8864-FE2F8A301656","أَودَى الشَّبابُ، حَميدا، ذو التَّعاجِيبِ","أودى، وذلك شأوٌ غيرُ مطلوبِ"],["01B016BA-9AD1-5535-BE1A-2AEB4E13AED7","وَلَّى حَثيثا، وهذا الشَّيبُ يَطلبُهُ","لو كَانَ يُدرِكُه رَكَضُ اليَعاقِيبِ"],["6896454E-33E9-5135-8D2F-B5A679FAFB0B","أودَى الشّبابُ الّذِي مَجْدٌ عَواقبُهُ","فيه نلذ، ولا لذات للشيب"],["18A6B0D7-82A9-5593-884E-D625A6D50373","يومان: يوم مقامات وأتدية","ويوم سير إلى الأعداء، تأويب"],["CD1DED0B-3A88-5142-977E-9E1585D555C4","وكرنا خيلتا أدراجها رجعا","كس السنابك، من بدء وتعقيب"],["E5D6E919-4F50-5131-827C-4AF7F54B424B","والعاداتُ، أسابيُّ الدماءِ بها","كأنَّ أعناقَها أَنصابُ تَرجِيبِ"],["88D6C7DA-F411-52A6-8366-78D55DA8C149","من كلّ حتٍّ إذا ما ابتلَّ ملبدهُ","ضافي السَّبِيبِ، أسِيلِ الخَدِّ يَعبوبِ"],["B009892E-CDEE-5D09-9544-39E0E88446C5","ليس بأقنى، ولا أسفى، ولا سغلٍ","يسقى دواءَ قفيِّ السَّكنِ مربوبِ"],["301B22CA-6825-5823-A1CC-31F37531D5B1","في كلِّ قائمةٍ منه، إذا اندفعتْ","مِنهُ، أساوٍ كفَرغِ الدَّلوِ، أُثعوبِ"],["56C1EF37-D18C-5E66-8A17-DFBC86DD6491","كأنَّهُ يرفئيٌّ نام عن غنمٍ","مُستنفَرٌ فِي سَوادِ اللَّيلِ مَذؤوبِ"],["9311D192-AE80-5182-B213-2C25CB9F90C2","تمَّ الدسيعُ إلى هادٍ له بتعٍ","في جُؤجُؤٍ، كَمَداكِ الطِّيبِ مَخضُوبِ"],["7047F565-B63D-5C0C-953B-3B17A6BB8695","تَظَاهَرَ النَّيُّ فيهِ، فهُوَ مُحتَفِلٌ","يعطي أساهيَّ من جريٍ وتقريبِ"],["3342B103-F5E1-5D84-9022-923408D57904","يحاضرُ الجونَ مخضرّاً جحافلها","ويسبقُ الألفَ عفواً، غيرَ مضروبِ"],["13B5FC4D-6A36-5D52-B99B-C95AA4BC6319","كمِ من فقيرٍ، باذن الله، قد جيرتْ","وذِي غِنًى بَوَّأَتْهُ دَارَ مَحروبِ"],["F8520A59-0D75-5958-9814-F7BD40237B63","مِمّا يُقدِّمُ في الهَيجا، إِذا كُرِهَتْ","عند الطعان، وينجي كلَّ مكروبِ"],["46ADBBF8-0EB1-5F51-AE7C-694994D016BC","همَّتْ معدٌّ بناهمّاً، فنهنهها","عنّا طعانٌ، وضربٌ غيرُ تذبيبِ"],["F568661F-310D-5475-929E-EA41F49527A8","بالمَشرَفيِّ، ومَصقولٍ أسِنَّتُها","صمّ العواملِ، صدقاتِ الأنابيبِ"],["D109EF53-7314-576A-A6CA-AB8F542BE36F","يجلو أسنَّتها فتيانُ عاديةٍ","لا مُقرِفينَ، ولا سُودٍ، جَعابِيبِ"],["E42519D9-585F-5633-9A4E-1366ABAA9A07","سوَّى النّقافُ قناها،فهيَ محكمةٌ","قَليلةٌ الزَّيغِ، مِنْ سَنٍّ وتَركيبِ"],["4EE70109-3111-5C54-B1F7-1B1DF9B752E5","كأنَّها، بأكُفّ القومِ إِذ لَحِقُوا،","مَواتحُ البِئرِ، أو أشطانُ مَطلوبِ"],["3C6D3AB2-9605-59A8-BFAF-BC005C0C6840","كِلا الفَرِيقَينِ: أعلاهُم وأسفَلُهْم","شَجٍ بأرماحِنا غَيرَ التَّكاذِيبِ"],["11BC1780-D394-52EC-9C0D-50DB0B4D8D9F","إِنِّي وَجَدتُ بني سعدٍ، يُفضِّلُهُمْ","كُلُّ شِهابٍ على الأعداءِ مَصبوبِ"],["A18B8406-37B4-5281-A1AF-0FC10B4018C3","إِلى تَميمٍ، حُماةِ الثَّغرِ، نِسبتُهُمْ","وكلٍّ ذِي حَسَبٍ في النّاسِ، مَنسوبِ"],["90F960B0-1490-5594-965C-1D1A689365CB","قومٌ، إذا صرَّحتْ كحلٌ، بيوتهمُ","عزُّ الذليل، ومأوى كلِّ قرضوبِ"],["AEF9D5AD-1231-5084-99E2-61B8CA80C5DA","ينجيهمِ من دواهي الشرّ. إنْ أزمتْ","صَبرٌ عَلَيها، وقِبْضٌ غَيرُ مَحسوبِ"],["068D70D7-0C73-5A41-9E4C-F37069A5817B","كنّا نَحُلُّ، إذا هَبَّتْ شآمِيَةً","بكلّ وادٍ، حطيبِ البطنِ، مجدوبِ"],["9274AF62-48C2-5FFC-9E10-670447AA2E7E","شِيبِ المَباركِ، مَدْروسٍ مَدافعُهُ","هابي المراغِ. قليلِ الودقِ. موظوبِ"],["1496DA9F-DDE8-568F-B629-4AAE7F03C64A","كنّا، إذا ما أتانا صارخٌ فزعٌ","كان الصُّراخُ له قرعَ الظنابيبِ"],["FFFDA648-9FF0-55C0-AC9C-3B0243499F27","وَشَدَّ كُورٍ، على وَجناءَ ناجِيةٍ","وشَدَّ لِبْدٍ، على جَرداءَ سُرحُوبِ"],["82C7793D-503D-586B-9554-FDD73AB7B057","يقالُ: محبسها أدنى لموتعها","ولو تَعادَى بِبَكْءٍ كُلُّ مَحلوبِ"],["B0A7569A-5568-54C9-9CCE-CD8CA30E9322","حتّى تُرِكْنا، وما تُثْنَى ظَعائِنُنا","يأخُذْنَ بَيْنَ سَوادِ الخَطِّ فاللُّوبِ"]]},"3D6DB637-7E2D-5386-A9A9-4A357DFBF6F0":{"t":"بِكُلِّ مُجنَّبٍ كالسِّيدِ نَهدٍ","p":27,"s":"بكل مجنب كالسيد نهد","r":"436474","v":[["1D3BFC25-9C15-5BF9-A588-95D68D0DB895","بِكُلِّ مُجنَّبٍ كالسِّيدِ نَهدٍ","وكلِّ طوالةٍ، عتدٍ، نزاقِ"]]},"02A539A5-40D4-58EC-9CDF-1A5D59FBA295":{"t":"تقولُ ابنتي: إنَّ انطلاقكَ واحداً","p":27,"s":"تقول ابنتي: إن انطلاقك واحدا","r":"436459","v":[["0F78D4C8-42F6-5F0E-8AD3-CA41ABA70F3E","تقولُ ابنتي: إنَّ انطلاقكَ واحداً","إلى الرَّوعِ، يوماً تاركي لا أباليا"],["10F9F309-C349-5D8F-BA79-305716F8D7A1","دَعِينا مِنَ الإِشفاقِ، أو قَدِّمي لَنا","منَ الحدثانِ والمنيَّةِ راقيا"],["60E653AB-01EB-572D-9BCA-CB85ED3B1974","ستتلفُ نفسي، أو سأجمعُ هجمةً","ترى ساقييها بالمانِ التَّراقيا"]]},"B0E15D4B-50F1-5E4D-8A5E-5BF4574EA08D":{"t":"حتى استغثنَ بأهلِ الملحِ ضاحيةً","p":27,"s":"حتى استغثن بأهل الملح ضاحية","r":"436466","v":[["6505E3E2-F672-5C98-8857-B874F377EB74","حتى استغثنَ بأهلِ الملحِ ضاحيةً","يَركُضْنَ، قَد قَلِقَتْ عَقدُ الأطانيبِ"]]},"2CE3201A-935E-5B73-AB27-A3387F98E14B":{"t":"رأيتُك ذا شَرٍّ وفي الشَّرِّ مُنقَعا","p":27,"s":"رأيتك ذا شر وفي الشر منقعا","r":"436476","v":[["DCF62655-9B35-52F6-BCD1-A9D226EDDA1B","رأيتُك ذا شَرٍّ، وفي الشَّرِّ مُنقَعا","إذا كنتَ في أرضٍ، بها الشرُّ شاملُ"]]},"A25E02F1-89C7-587E-A617-9DBCEA2ACB71":{"t":"سأَجزِيكَ بالقِدِّ الذي قَد فَككتَهُ","p":27,"s":"سأجزيك بالقد الذي قد فككته","r":"436460","v":[["293EF969-F212-5D7E-8CB8-CFA8A34E7CF2","سأَجزِيكَ بالقِدِّ الذي قَد فَككتَهُ","سأَجزِيكَ ما أبلَيتَنا العامَ، صَعصَعا"],["1D4652AD-93F3-5575-AB27-5DF0D864517D","فإِنْ يكُ مَحمودٌ أَباكَ فإِنَّنَا","وَجَدْناكَ مَنسوبا إلى الخَيرِ، أَروَعا"],["830C409D-37A3-5580-AC7B-59C8AD2FC497","سأهدي، وإنْ كنُّا بتثليثَ، مدخةً","إِليكَ، وإِنْ حَلَّتْ بُيوتُكَ لَعلَعا"],["A9C072CA-F7DC-55B1-8837-B425E833F346","فإِن شِئتَ أَهدَينا ثَناءً ومِدحةً","وإِن شِئتَ عَدَّينا لكم مئةً مَعا"]]},"23A22C43-D1B8-576D-8E56-E1CB404103F2":{"t":"سائلْ بنا يومَ وردِ الكلا","p":27,"s":"سائل بنا يوم ورد الكلا","r":"436479","v":[["F63DD53D-8651-521B-8E6A-EA9FBA4FE047","سائلْ بنا يومَ وردِ الكلا","بِ تخبركَ دوسٌ وهمدانها"]]},"F1F5EA38-6FD0-5907-860F-D4AB0F7DAE25":{"t":"فاقنيْ لعلَّكِ أنْ تحظي وتحتلبي","p":27,"s":"فاقني لعلك أن تحظي وتحتلبي","r":"436468","v":[["3F1AD50B-5002-5F17-941F-339939762E31","فاقنيْ، لعلَّكِ أنْ تحظي وتحتلبي","في سَحْبَلٍ من مُسُوكِ الضّأنِ مَنجُوبِ"]]},"184BF987-AA57-58B7-883C-612CB1ABD1A3":{"t":"فسائلْ بسَعدَيَّ في خِندفٍ","p":27,"s":"فسائل بسعدي في خندف","r":"436478","v":[["F2B26A20-D9A8-5CF1-B339-B04AAEE659CA","فسائلْ بسَعدَيَّ في خِندفٍ","وقيسٍ، وعندكَ تبيانها"],["4FAAEB70-8DCD-5705-8658-2EA1BE562A4C","وإنْ تسألِ الحيَّ من وائلٍ","تنبئكَ عجلٌ، وشيبانها"],["8BB87CEA-635F-52E8-BAF0-C91D29C7F656","بوادِي جَدُودَ، وقَد غُودِرَتْ","بصيقِ السَّنابكِ أعطانها"],["D7CADA7C-F2EC-5173-B63C-18DA8246C235","بأرعنَ، كالطودِ، من وائئلٍ","يَؤُمُّ الثُّغورَ، يَعْتانُها"],["6C871645-8C17-5744-9C43-A8DC3D9E4A09","تكادُ له الأرضُ، منْ رزهِ","إذا سار، ترجفُ أركانها"],["D4CB7854-076C-5AC4-AADB-876565588416","قداميسُ، يقدمها الحوافزانُ","وأَبجَرُ، تَخفِقُ عِقبانُها"],["3A5D524D-87C8-58DA-802A-83BF8D72B32E","وجَثّام، إِذ سارَ في قَومهِ","سَفاها إِلَينا، وحُمرانُها"],["7EC76B71-1BFC-58D9-AE10-43BA7015122C","وتغلبُ، إذ حربها لاقحٌ","تُشَبُّ، وتُسعَرُ نِيرانُها"],["CBF12CBE-3964-52AC-9D70-4ACD316BA275","غداةَ أتانا صريخُ الرّبابِ","ولم يكُ يصلحُ خذلانها"],["012E5250-FC39-59F1-94FF-56F0BE58F1E5","صَرِيخٌ لضَبَّةَ، يَومَ الهُذَيلِ","وضَبَّةُ تُردَفُ نِسوانُها"],["C39BF5AA-9774-512C-B0FD-FCB5171F5802","تداركهمْ، والضُّحى غدوةٌ،","خناذيذُ تشعلُ أعطانها"],["A8B9E9E6-7165-5DC3-900E-1DAA9CEBDBF3","بأُسدٍ منَ الفِرزِ، غُلْبِ الرِّقابِ","مصاليتَ، لم يخشَ إدهانها"],["768DDA10-E768-5146-B2E0-577FB31C9713","فحَطَّ الرَّبِيعَ فَتًى شَرمَحٌ","أَخوذُ الرَّغائبِ، مَصنانُها"],["D14B0E58-659C-5342-87EB-7710CF4761C3","فقاظُ، وفي الجيدِ مشهورةٌ","يُغَنِّيهِ في الغُلِّ إِرنانُها"]]},"6560307C-0321-512F-A67E-652919743E3A":{"t":"قد أوعدتنا معدٌّ وهي كاذبةٌ","p":27,"s":"قد أوعدتنا معد وهي كاذبة","r":"436464","v":[["DB7D2108-30CB-55CD-B438-76F379B62A96","قد أوعدتنا معدٌّ، وهي كاذبةٌ","نَصرا، فكانَ لَها مِيعادُ عُرقُوبِ"],["E348E57C-1697-598E-94DF-D58624D0B5F3","وقَد نُقَدِّمُ في الهَيجاءِ إِذ لَقِحَتْ","يَومَ الحِفاظ، ونَحمي كلَّ مَكرُوبِ"],["EAEDC643-D50B-57DE-982A-39910EFDDD40","يهوي، إذا الخيلُ جازته وثارَ لها","هَوِيَّ سَجلٍ، مِنَ العَلياءِ مَصبوبِ"],["A69187A0-D3AC-55B2-8E19-9B28213719BA","زرقاً أسنَّتها، حمراً، مثقَّفةً","أطرافهنَّ مقيلٌ لليعاسيبِ"],["87EF1C07-4EF2-564D-9902-E3DD169EB102","حامِي الحَقِيقةِ، لا تُخشَى كَهامتُهُ","يَسقي الأَعادِيَ مَوتا غَيرَ تَقشيبِ"]]},"96F3CEFD-BCFC-54B7-A1F4-032ED9E5DD99":{"t":"كأَنَّ النّعامَ باضَ فَوقَ رُؤوسِهِم","p":27,"s":"كأن النعام باض فوق رؤوسهم","r":"436473","v":[["C2033A26-C2E9-5758-8962-255E08367B57","كأَنَّ النّعامَ باضَ فَوقَ رُؤوسِهِم","إلى الموتِ بَرقٌ، مِن تِهامةَ، لامعُ"]]},"DCA17C3F-2A7C-5B1D-9C2A-BEA716D95144":{"t":"لنا خباءٌ وراووقٌ ومسمعةٌ","p":27,"s":"لنا خباء وراووق ومسمعة","r":"436465","v":[["CD37264C-CAB6-5B9C-BD67-B9CEC422EEA5","لنا خباءٌ، وراووقٌ، ومسمعةٌ","لدَى حِضاجٍ بِجَونِ القارِ مَربُوبِ"]]},"A85632E9-25B8-51F7-A0F0-D4CD14EEA9F3":{"t":"لو كُنتُ أَبكي لِلحُمول لشاقَني","p":27,"s":"لو كنت أبكي للحمول لشاقني","r":"436457","v":[["193599CA-AAF2-52AB-856F-E66192B524CE","لو كُنتُ أَبكي لِلحُمول لشاقَني","لليلى، بأعلى الوادِ الواديينِ، حمولُ"],["6A05E0E5-F2A5-5C56-B1AE-B012D7D122D6","يطالعنا منْ كلِّ حدجٍ مخدَّرٍ","أوانسُ بِيضٌ، مِثلُهنَّ قَليلُ"],["117C4E8D-9166-52D5-A634-8087DB972396","يشبّهها الرائي مهاً بصريمةٍ","عَلَيهِنَّ فَينانُ الغُصونِ ظَلِيلُ"],["6F391B37-6732-5141-BE55-05C223E9D061","عقيلهنَّ الهيجمانةُ، عندها","لنا- لو نحيَّا- نعمةٌ ومقبلُ"],["3E03093C-1CE8-5347-AE13-0F8386E08DFA","وفِتيانِ صِدقٍ، قَد بَنَيتُ عَلَيهمُ","خِباءً بِمَوماةِ الفَلاةِ، يَجُولُ"],["D534C97B-2742-53A3-A987-9B506062F015","كما جَالَ مُهرٌ في الرِّباطِ، يَشُوقُهُ","على الشَّرفِ الأقصَى المَحَلِّ، خُيولُ"],["562A9D41-A375-535A-9D10-0E53301C872A","تلاقتْ بنو كعبٍ وأفناءُ مالكٍ","بأمرٍ، كصَدرِ السَّيفِ، وهْوَ جَلِيلُ"],["30C00DFE-C52A-5ED5-AC45-96B6B02D8852","تَرَى كلَّ مَشبوحِ الذِّراعَينِ ضَيغَمٍ","يَخُبُّ به عارٍ شَواهُ، عَسُولُ"],["1D713C12-4907-5F26-B61A-19DD50647A49","أَغَرَّ، مِنَ الفِتيانِ، يَهتَزُّ للنَّدَى","كما اهتَزَّ عَضبٌ باليَمينِ، صَقِيلُ"],["98CBD73C-52F4-5605-A680-1E094E837166","كأنَّ المذاكيْ، حينَ جدَّ جميعنا،","رَعيلُ وُعُولٍ، خَلفَهُنَّ وُعولُ"],["800AECAA-CCB2-5767-A708-8ECDCF5A5B7C","عَلَيهِنَّ أولادُ المُقاعِسِ قُرَّحاً","عناجيجُ، في حوٍّ لهنَّ صهيلُ"],["CB24D880-82B1-54C1-B019-2CA2CAD84031","كأنَّ على فرسانها تضخَ عندمٍ","نجيعٌ، ومسكٌ بالنحورِ يسيلُ"],["DA8B7AA4-7C0C-5628-B53D-9C21BCF31640","إذا خرجتْ من غمرةِ الموتِ ردَّها","إلى المَوتِ، صَعبُ الحافَتينِ، ظَلِيلُ"],["A20F383D-5C23-55D0-9C8A-AF2F55FE9AD1","فما تَركُوا في عامرٍ مِن مُنَوِّهٍ","ولا نسوةٍ، إلاَّ لهنْ عويلُ"],["10CDE1E8-112A-5FEE-A2E6-FF0B871B7E81","تَركْنَ بَحِيرا والذُّهابَ، عَلَيهما","من الطير غاباتٌ، لهنَّ حجولُ"]]},"484C38A3-C5A3-5B77-80D4-DB9C298F505C":{"t":"لِمَن طَلَلٌ مِثلُ الكِتابِ المُنمَّقِ","p":27,"s":"لمن طلل مثل الكتاب المنمق","r":"436456","v":[["67BE648C-1244-5571-927F-07750FDCC223","لِمَن طَلَلٌ، مِثلُ الكِتابِ المُنمَّقِ","خلا عهدهُ بين الصُّليبِ فمطرقِ"],["DE8746DB-6251-5050-B6DE-6E48034A3A25","أَكَبَّ علَيهِ كاتِبٌ بدَواتِهِ","وحادِثُهُ في العَينِ، جِدَّةُ مُهرَقِ"],["1B4DDC3F-E036-5FF8-B4DB-373D1E24CE1C","لأسماءَ، إذ تهوى وصالكَ، إنَّها","كَذِي جُدَّةٍ، مِن وَحشِ صاحةَ، مُرشِقِ"],["CD0CE1E6-C400-5801-B445-E56F494905CC","له بقرانِ الصُّلبِ يقلٌ يلسُّهُ","وإِنْ يَتَقَدَّمْ بالدَّكادِكِ يأنَقِ"],["A39A3811-D1BE-567F-877D-3C29507475B5","وقفتُ بها، ما إنْ تبينُ لسائلٍ","وهلْ تفقهُ الصُّمُّ الخوالدُ منطقي"],["4AFE1837-D92C-59D7-B8AA-513FA7D694C0","فبتُّ، كأنَّ الكأسَ كالَ اعتيادها","عليَّ، بصافٍ منْ رحيقٍ، مروَّقِ"],["7029DDAE-FC53-51F5-BB87-EB763328CD43","كرِيحِ ذكيِّ المِسكِ باللّيلِ رِيحُهُ","يصفَّقُ في إبريقِ جعدٍ منطَّقِ"],["34708EC8-4039-57CF-A587-82CE50D5651C","وماذا تبكّيِ منْ رسومٍ محيلةٍ","خلاءٍ كسحقِ اليمينةِ المتمزّقِ"],["112E9FF5-B2BA-5E2B-A560-6819EEBC62E5","ألاَ، هل أتتْ أنباؤها أهلَ مأربٍ","كما قَد أَتَتْ أَهلَ الدَّنا والخَوَرنَقِ"],["D8BE36F2-6E32-58D9-83A7-42F15C9178F0","بأنَّا منعنا بالفروقِ نساءنا","ونحن قتلنا منْ أتانا بملزقِ"],["75B5D124-2D7E-53AA-87AF-5F15584B2EB8","تُبَلِّغُهُمْ عِيسُ الرِّكابِ، وشُومُها","فَريقَي مَعَدٍّ: مِن تَهامِ ومُعرِقِ"],["31B6A2D3-0189-597D-B980-FBD2F06FF0DF","وموقفنا في غيرِ دارِ تئيَّةٍ","وملحقنا بالعارض المتألّقِ"],["F7757485-5CF6-5755-A99F-FC23FF3665AF","إِذا ما عَلَونا ظَهرَ نشْزٍ، كأَنَّما","عَلَى الهامِ مِنَّا قَيضُ بَيضٍ مُفَلَّقِ"],["9C020FA8-09F0-511F-896D-FB37DF87A42A","من الحُمْسِ، إِذ جاؤوا إِلينا بِجَمعهِمْ","غَداةَ لَقِيناهمْ، بجأواءَ فَيلَقِ"],["E15A9B2A-80B9-5469-AF42-53BBED278607","كأَنَّ النَّعامَ باضَ فَوقَ رُؤوسِهِمْ","بنهيِ القذافِ أو بنهي مخفّقِ"],["531EFE24-06FE-5A48-80BF-3FD4A8DCC904","ضممنا عليهمْ حافتيهمْ بصادقٍ","مِنَ الطَّعنِ، حتّى أزمَعُوا بتَفَرُّقِ"],["F3138ECA-AF92-5ED7-A02C-42EAE645398C","كَأَنَّ مُناخا مِن قُيونٍ، ومَنزِلاً","بحيثُ التقينا منْ أكفٍّ، وأسؤقِ"],["9B98B898-0753-5337-B942-8BD0CDEA79AB","كأنَّهمُ، كانوا ظباءً بصفصفٍ","أَفاءَتْ عَليهِم غَبيةٌ، ذاتُ مَصدَقِ"],["6E6E1F5E-732C-5FD2-BDA9-8BB818CD0D52","كأنَّ اختلاءَ المشرفيِّ رؤوسهمْ","هَوِيُّ جَنُوبٍ، في يَبِيسٍ مُحَرَّقِ"],["C09109E2-10C0-5B34-B2B9-E00A48582890","لدنْ غدوةً، حتَّى أنى الليلُ دونهمْ","ولم ينجُ إلاَّ كلُّ جرداءَ خيفقِ"],["B31C5C80-E7D4-5A2A-8261-9A007F9B7E87","ومُستَوعِبٍ في الجَريِ فَضلَ عِنانِهِ","كَمَرِّ الغَزالِ الشّادِنِ المُتَطلِّقِ"],["F58E2A85-ACC2-5DEA-94D2-7F18DD48845A","فأَلقَوا لَنا أَرسانَ كُلِّ نَجِيبةٍ","وسابِغةٍ، كأَنَّها مَتنُ خِرنِقِ"],["50B321AD-199E-543E-82FC-434D4544714E","مُداخَلةٍ، من نَسجِ داودَ، سَكُّها","كحبِّ الجنى، منْ أبلمٍ متفلقِ"],["769CE985-7883-5A57-BADA-2B89CA63C9F0","فمنْ يكُ ذا ثوبٍ تنلهُ رماحنا","ومنْ يكُ عرياناً يوائلْ، فيسبقِ"],["82470469-7AA1-5114-B77D-9E255546980B","ومنْ يدعوا فينا يعاشُ ببيئسةٍ","ومَن لا يُغالُوا بالرَّغائبِ نُعْتِقِ"],["415986D6-4D34-5A4B-AA43-17E9F1AC182F","وأمُّ بحيرٍ في تمارسِ بيننا","متى تأتها الأنباءُ تخمشْ، وتحلقِ"],["177E28A2-7704-51D3-9B86-4B696DA10590","تركنا بحيراً، حيثُ أزحفَ جدُّهُ","وفينا فراسٌ عانياً، غيرَ مطلقِ"],["E8581362-962D-575F-83D8-1E7EA6E55F74","ولولا سوادُ الليلِ، ما آبَ عامرٌ","إِلى جَعفَرٍ سِربالُهُ لم يُخَرِّقِ"],["0936C71E-3241-56E9-9B96-9ABFC3F691B8","بضربٍ، تظلُّ الطير فيهِ جوانحاً","وطعنٍ كأفواهِ المزادِ المفتَّقِ"],["E6DABD1E-AB3C-5CB1-A249-302B72E71821","فعِزَّتُنا لَيْسَتْ بشِعبٍ بحَرَّةٍ","ولكنَّها بحرٌ بصحراءَ فيهقِ"],["0C26BB34-4F37-5B86-90F5-71129F2F7F61","يُقَمِّصُ بالبُوصِيِّ فيهِ غَوارِبٌ","متى ما يخضها ماهرُ اللُّجِّ يغرقِ"],["B2602E26-8556-551E-B110-13D0664BB614","ومَجدُ مَعَدٍّ كانَ فَوقَ عَلايةٍ","سبقنا به إذ يرتقونَ، ونرتقي"],["6B947456-E10D-52E4-A2EA-7CF1A2372678","إِذا الهُندُوانيَّات كُنَّ عُصِيَّنا","بها نتآيا كلَّ شأنٍ ومفرقِ"],["D3989CFB-C6F9-5977-8E88-EFFDCE10CFD7","نجلّي مصاعاً بالسيوفِ وجوهنا","إذا اعتفرتْ أقدامنا عند مأزقِ"],["7DE7354F-C5B7-5FC6-938E-23902CAC37DA","فَخَرتُم علَينا أَنْ قَتلتُم فَوارسا","وقولُ فراسٍ هاجَ فعلي ومنطقي"],["47663412-8CB4-5102-98F4-F28F1EC0C30B","عجلتمْ علينا حجَّتينِ عليكم","وما يشاءِ الرحمنُ يعقدْ ويطلقِ"],["742F96A6-BA9E-5678-A9CA-6411D55CE93D","هو الكاسرُ العظمَ الأمينَ، وما يشأ","منَ الأَمرِ، يَجمَعْ بَينَهُ، ويُفَرّقِ"],["04F68D8F-DB71-5196-8DDE-0A428C2F4B55","هو المدخلُ النُّعمانَ بيتاً، سماؤهُ","نحورُ الفيولِ، بعدَ بيتٍ مسدقِ"],["BAB5C9C8-3021-5184-8E38-124D23E5636C","وبعدَ مصابِ المزنِ، كانَ يسوسهُ","ومالَ مَعَدٍّ، بَعدَ مالِ مُحَرِّقِ"],["49948E7F-3C88-56E6-B407-EB961ABDDC57","لَهُ فَخمةٌ ذَفْراءُ، تَنفي عَدُوَّهُ","كمنكبِ ضاحٍ، منْ عمايةَ مشرقِ"]]},"15712EB1-1144-5A2D-AFC0-7D56C4B96C38":{"t":"مستحقباتٍ رواياها جحافلها","p":27,"s":"مستحقبات رواياها جحافلها","r":"436467","v":[["DB6E347D-6BB0-51AC-90BD-DBB254B56947","مستحقباتٍ رواياها جحافلها","يأخُذْنَ بَينَ سَوادِ الخَطِّ فاللُّوبِ"]]},"48E1027C-D3C6-5A2F-9C20-4FEA87D2EC39":{"t":"منْ مبلغٌ عنَّا كلاباً وكعبها","p":27,"s":"من مبلغ عنا كلابا وكعبها","r":"436461","v":[["32F3FA03-4383-5743-85B4-CC13C95134D9","منْ مبلغٌ عنَّا كلاباً وكعبها","وحيَّ نميرٍ، باليقينِ رسولُ"],["69FB01E4-AF40-5D07-B94E-8A2F87A77E16","فإِنّي، بيومٍ مِثلِ يَومٍ بِمُلزَقٍ","لكمْ، ولقاءٍ- إنْ حييتُ- كفيلُ"],["D47E846E-F2C9-5735-B0DA-071F841774F9","غداةَ تركنا منْ ربيعةِ عامرٍ","دماءً بأعلى الواديينِ تسيلُ"]]},"80596E2C-CE89-5807-AFE3-9B6E43B97944":{"t":"نَحنُ رَدَدْنا لِيَربُوعٍ مَواليَها","p":27,"s":"نحن رددنا ليربوع مواليها","r":"436469","v":[["B1641D6B-8EA7-5D1C-807A-E62527B91466","نَحنُ رَدَدْنا لِيَربُوعٍ مَواليَها","بِرِجلةِ التَّيسِ ذاتِ الحَمضِ والشِّيحِ"]]},"DC7827ED-E384-5ECB-8B01-65332B9CB33A":{"t":"هاجَ المَنازِلُ رِحلةَ المُشتاقِ","p":27,"s":"هاج المنازل رحلة المشتاق","r":"436455","v":[["522946E7-66DC-57C5-AE27-4FBEE0B55E1E","هاجَ المَنازِلُ رِحلةَ المُشتاقِ","دِمَنٌ وآياتٌ لَبِثْنَ بَواقي"],["360D2CF9-9DA4-5763-B0CB-E2AEEB1AC654","لَبِسَ الروامسُ والجديدُ بِلاهما","فتركنَ مثلَ المهرقِ الأخلاقِ"],["9D6EDF29-2FBE-5ADA-A5BA-9FF8E5E00C5E","للحارثيَّةِ، قَبلَ أن تَنأى النَّوى","بِهِمِ، وإِذ هيَ لا تُريدُ فِراقي"],["C2EBC3B3-C1B9-5CDD-AEAE-BFC21A6736ED","ومَجَرُّ سارِيةٍ تَجُرُّ ذُيولَها","نوسَ النعامِ، تناطُ بالأعناقِ"],["DBE419B6-74D7-5D65-B826-972B6AC039CF","مِصرِيَّةٍ، نَكباءَ أعرَضَ شَيمُها","بأشابةٍ، فزرودَ، فالأفلاقِ"],["AF6F1D9D-73FA-5BD3-8973-20EB085207F6","هَتكَتْ على عُوذِ النِّعَاجِ بُيوتَها","فيقمعنَ للركباتِ، والأوراقِ"],["37849F05-E6BB-52CC-B8EC-AF4FF1FA1D03","فتَرَى مَذانِبَ كُلِّ مَدفَعِ تَلْعةٍ","عجلتْ سواقها من الإتآقِ"],["8F49B08B-DAB5-5951-A4B7-43B013B7B490","فكأَنَّ مَدفَعَ سَيل كُلِّ دَميثةٍ","يعطى بذي هدبٍ، من الأعلاقِ"],["2352C20B-D5A2-506A-BC7E-8CBBD85B8380","منْ نسجِ بصرى والمدائن. نشرتْ","للبيع يوم تحضُّرِ الأسواقِ"],["8CFE914F-F716-53D4-BFDA-A547F59C34D9","فوقفتُ فيها ناقتي، فتحنَّنتْ","لِهَوَى الرَّواحِ، تَتُوقُ كُلَّ مَتاقِ"],["4BD1ABB5-B4F1-5BCA-8EB0-C5F5996B6472","أَرسَلتُ هَوجاءَ النَّجاءِ، كأنَّها","إذْ همَّ أسفلُ حشوها بنفاقِ"],["46CDF97A-BA47-541C-A111-DB0E6E5F0A10","متخرّفٌ، سلبَ الربيعُ رداءهُ","صخبُ الظلامِ، يجيبُ كلَّ نهاقِ"],["9E4B537A-4F43-5B4C-B113-9F1F6EB4C485","منْ أخدِ ريَّاتِ الدَّنا، التفعتْ لهُ","بُهْمَى النِّقاعِ، وَلَجَّ في إِحناقِ"],["E5D77942-6E3A-57BE-A0DD-EA34F9A8555E","صخبُ الشواربِ والوتينِ، كأنَّه","مما يُغَرِّدُ مَوهِنا بِخِناقِ"],["B39FAAEE-779B-5627-8C94-704FC3DFB456","في عانةٍ شُسُبٍ، أَشَدَّ جِحاشَها،","شُزُبٍ، كأَقواسِ السَّراءِ، دِقاقِ"],["B97E92F4-BE3D-54C7-859B-1241597EE173","وكأنَّ ريقتها، إذا نبَّتها،","كأسٌ، يُصَفِّقُها لِشُربٍ ساقي"],["D2117200-C9B2-5C09-9F8F-139917C5365F","صِرْفٌ، تَرَى قَعرَ الإِناءِ وَرَاءَهَا","تودي بعقلِ المرءِ قبلَ فواقِ"],["FD3CC533-41B8-56F0-B9C4-640836D025B7","ينسى للذَّتها أصالةَ حلمهِ","فيَظَلُّ بَينَ النَّومِ والإِطراقِ"],["2FAE6223-2879-5B48-ADCD-D57D6F3E083A","فتَرَى النِّعاجَ بِها، تَمشَّى خِلْفةً","مشي العباديّينَ في الأمواقِ"],["EBF18CAA-07BE-53AF-B8F8-65744BE3787F","يسمرنَ وحفاً، فوقه ماءُ النَّدى،","والنَّبتَ، كلَّ علاقةٍ ونطاقِ"],["E67E7519-4B42-5AA3-BE7B-58BE74652B8C","ولقد هبطتُ الغيثَ، حلَّ به النَّدى","يرففنَ فاضلهُ على الأشداقِ"],["11C177B6-CFC5-5E91-B766-53C54C038B00","أَهدِي بهِ سَلَفا، يَكونُ حَدِيثُهُمْ","خَطَرا، وذِكرَ تَقَامِرٍ وسِباقِ"],["863102B2-ECA9-5BF7-B85B-7D05826BF6FD","حتى إذا جاءَ المثوبُ، قدْ رأى","أسداً، وطالَ نواجذُ المفراقِ"],["65AA2ED7-B1A6-5C3F-8CE0-132F14BA5C56","لَبِسوا، مِنَ الماذِيِّ، كُلَّ مُفاضةٍ","كالنّهِي، يَومَ رياحِهِ، الرَّقراقِ"],["186226A4-E537-58B7-8268-6833B97E2C59","منْ نسجِ دوادٍ، وآلِ محرقٍ","غالٍ غَرائبُهُنَّ في الاڑفاقِ"],["EB136303-4946-5B2E-87AF-EFD9C78DDB1E","ومنَحتُهُم نَفسي، وآمِنةَ الشَّظَى","جَرداءَ، ذاتَ كَرِيهةٍ ونِزاقِ"],["116242BF-D05F-5D95-84A6-BEFDA55EE180","كالصَّعدةِ الجرداءِ، آمنَ خوفها","لطفُ الدَّواءِ، وأكرمُ الأعراقِ"],["B40D0270-A328-525C-86AC-27A6EF2CD835","تشأى الجيادَ، فيعترينَ لشأوها","وإِذا شأَوا لحِقَتْ بحُسنِ لَحاقِ"],["006F99CE-A767-5B64-BFB4-64BFEA165A9D","وأَصَمَّ صَدقا، مِن رِماحِ رُدَينةٍ","بيدي غلامِ كريهةٍ، مخراقِ"],["C604A32F-15C3-54D9-A155-06BCBE513750","شاكٍ، يشدُّ على المضافِ، ويدَّعي","إذْ لاتوافقُ شعبتا الإيفاقِ"],["CC0065F1-6DF9-55B7-9634-C200E8DEE648","إني امرؤ، من عصبةٍ سعديَّةٍ","ذر بى الأسنَّةِ كلَّ يومِ تلاقي"],["7CF941D3-F4B1-5290-AC3E-995455E37DC5","لا يَنظُرونَ إِذا الكَتِيبةُ أَحجَمَتْ","نظرَ الجمالِ، كربنَ بالأوساقِ"],["E0C3E090-7A91-5FB3-9CD9-BC599C895586","يكفونَ غاسبهمْ، ويقضى أمرهمْ","في غيرِ نقصٍ منهمُ، وشقاقِ"],["8D8792E9-4240-5C6A-855C-2369E9A8CFE4","والخَيلُ تَعلمُ مَن يَبُلُّ نُحورَها","بدَمٍ، كماءِ العَنْدَمِ المُهرَاقِ"]]},"2BBBC98A-C6CA-5169-855F-0034F5595269":{"t":"هو المدخلُ النعمانَ في أرضِ فارسٍ","p":27,"s":"هو المدخل النعمان في أرض فارس","r":"436480","v":[["D6FF9647-9161-59DB-AC10-A793EF85C3FA","هو المدخلُ النعمانَ في أرضِ فارسٍ","وجاعِلهُ، في قَولِهم، في المَدائنِ"],["CA5631D7-7C64-5DD1-A594-CF44BB127F45","وأَلقاهُ أيضا،بَعدَ ذا،تَحتَ أَفُيلٍ","وفي العَرَبِ العَربا بَقايا ضَغائنِ"]]},"268AA717-F6AA-56BC-86D2-7B111C448D3F":{"t":"وإِنَّا كالحَصَى عَدَدا وإِنَّا","p":27,"s":"وإنا كالحصى عددا وإنا","r":"436477","v":[["8E222FFA-9BE6-514A-9F11-346AD4369BAE","وإِنَّا كالحَصَى عَدَدا، وإِنَّا","بنو الحربِ، التي فيها عرامُ"]]},"F4FA384E-A6FD-52B9-AD93-1FDE425708FE":{"t":"وزَيدُ الخَيلِ قد لاقَى صِفادا","p":27,"s":"وزيد الخيل قد لاقى صفادا","r":"436475","v":[["79FCC175-64DE-55C2-90C2-3FD4595176D0","وزَيدُ الخَيلِ قد لاقَى صِفادا","يَعَضُّ بساعدٍ، وبعَظمِ ساقِ"]]},"E3FEFEF8-2C72-5331-8FA9-E3902B8959F1":{"t":"ومَن كانَ لا تُعتَدُّ أيّامُهُ لهُ","p":27,"s":"ومن كان لا تعتد أيامه له","r":"436462","v":[["EF619352-7E04-50C1-867A-AE4B0AD7BC80","ومَن كانَ لا تُعتَدُّ أيّامُهُ لهُ","فأيّامُنَا عَنَّا تُجَلِّي، وتُعرِبُ"],["B80B0EE3-F236-5FAA-B152-C154CE83E3DC","جَعلَنا لَهمْ ما بَينَ كُتلةَ رَوحةً","إلى حيثُ أوفى صوَّتيهِ مثقَّبُ"],["34FF3BB4-558E-524D-9294-A8091C33AF87","غداةَ تركنا في الغبار ابن جحدرٍ","صَرِيعا، وأطرافُ العَوالي تَصَبَّبُ"],["749D3AE0-7CE8-57CA-BFDF-66F8BD3F1CFA","وأفلتَ منا الحوفزانُ، كأنَّهُ","برهوةَ قرنٌ، أفلتَ الخيلَ، أعضبُ"],["C63B77E1-5324-5DAA-B62E-045F1F90BAD7","غداةَ رغامِ، حين ينجو بطعنةٍ","سؤوقِ المنايا، قد تزلُّ وتعطبُ"],["6F4CF5F9-BD84-5344-8FFD-C20C1F40A0D0","لَقُوا مِثلَ ما لاقَى اللُّجَيمِيُّ قَبلَهُ","قتادةُ، لمَّا جاءنا وهو يطلبُ"],["0F17DB70-6E4C-5237-805E-D164669E226B","فآبَ إل حجرٍ، وقد فضَّ جمعهُ،","بأخبثِ ما يأتي به متأوّبُ"],["38F63340-84C5-5E0B-8492-8FFD214BE155","وقد نالَ حدُّ السيفِ منْ حرّ وجههِ","إلى حيثُ ساوى أنفهُ المتنقَّبُ"],["BE1F4C98-D788-5909-805C-5E4BCAB50301","وجشَّامةُ الذُّهليُّ، قد وسجتْ به","إِلى أهلِنا مَخزومةٌ، وهْوَ مُحقَبُ"],["B65F6F52-642F-5A40-93DC-6FC0697E675E","تَعَرَّفُهُ وسْطَ البُيوتِ مُكَبَّلاً","ربائبُ، من أحسابِ شيبانَ تثقبُ"],["2D20C104-6764-5240-ADCF-167290ACEC98","وهوذةَ نجَّى، بعدَ ما مالَ رأسهُ،","يَمانٍ، إذا ما خالَطَ العَظمَ، مِخدَبُ"],["C6A408BC-18B7-536D-B028-07EFE5CA6F98","فأَمسَكَهُ، مِن بَعدِ ما مال رأسُهُ","حِزامٌ على ظَهرِ الأغَرِّ، وقَيقَبُ"],["9C0D1DCC-C280-522B-995B-0CD4475DDC6D","غداةَ كأنَّ ابني لجيمِ ويشكراً","نعامٌ، بصحراءِ الكديدينِ، هرَّبُ"]]},"67511AAC-F0F6-5293-80B6-E7FB6CBC01E7":{"t":"يا حُرَّ أَمسَى سَوادُ الرّأسِ خَالَطَهُ","p":27,"s":"يا حر أمسى سواد الرأس خالطه","r":"436472","v":[["FB5826D6-CDE5-5610-995A-12A7D799ED18","يا حُرَّ، أَمسَى سَوادُ الرّأسِ خَالَطَهُ","شَيبُ القَذالِ اختلاطَ الصَّفوِ بالكَدَرِ"],["8BF1D10A-5BE5-564C-8453-0C39854D4E49","يا حُرَّ، أمسَتْ لُباناتُ الصِّبا ذَهبَتْ","فلَستُ مِنها على عَينٍ، ولا أَثَرِ"],["4CD8A545-2ECC-50B9-A79E-948203C4067D","كان الشبابُ لحاجاتٍ، وكنَّ له","فقَد فَرَغتُ إلى حاجاتيَ الأُخَرِ"]]},"F0EA0B13-A435-5446-83D5-1E73A3DAEECD":{"t":"يا دارَ أسماءَ بالعلياءِ من إضمٍ","p":27,"s":"يا دار أسماء بالعلياء من إضم","r":"436463","v":[["9768C3DD-8F83-5D7D-87FE-C7A09B72FE21","يا دارَ أسماءَ، بالعلياءِ من إضمٍ","بينَ الدَّكادِكِ مِن قَوٍّ، فمَعصُوبِ"],["2DC89DA1-87D2-5A95-BD4D-39D8AB6297D3","كانتْ لنا مرَّةً داراً، فغيَّرها","مرُّ الرياحِ بساقي التُّربَ، مجلوبِ"],["B701A9DD-E3A9-574B-9F69-87EA29280EE6","هل في سؤالكَ عن أسماءَ منْ حوبِ","وفي سلامِ، وإهداءِ المناسيبِ؟"],["CFF6D49E-60C9-501F-9DBF-1F97209D4737","ليستْ من الزُّلِّ أردافاً لاإذا انصرفتْ","ولا القصارِ، ولا السُّودِ العناكيبِ"],["32BE9864-2DB7-56A0-9703-418A2E7CE22B","إني رأيتُ ابنةَ السعديِّ حينَ رأتْ","شَيبي، وما خَلَّ من جِسمِي وتَحنيبي"],["3CBA7307-8E8B-5D71-925F-FEC5FDBB86B6","تقولُ حينَ رأتْ رأسي ولمَّتهُ","شَمطاءُ، بَعدَ بَهيمِ اللَّونِ، غِربيبِ"],["AB4B8C7F-6286-51DF-8FE4-191A48FD6A22","وللشبابِ، إذا دامتْ بشاشتهُ","ودُّ القلوبِ، منَ البيضِ الرَّعابيب"],["790BFCEB-5658-5518-92FB-1ABA4A2D5B8E","إِنّا، إِذا غَرَبَتْ شَمسٌ أوِ ارتَفَعَتْ","وفي مَبارِكِها بُزْلُ المَصاعِيبِ"],["4490C5E2-E7FB-544F-B5ED-E795A79CAB0A","قد يسعدُ الجارُ، والضيفُ الغريبُ بنا","والسائلونَ، ونغلي ميسرَ النّيبِ"],["DC1DD471-5892-537A-9708-75FA849875CA","وعندنا قينةٌ بيضاءُ ناعمةٌ","مِثلُ المهاةِ، منَ الحُورِ الخراعيبِ"],["BE849CEE-67E2-5E9A-B00A-D785F10D17C4","تجري السّواكَ على غرٍّ مفلَّجةٍ","لم يَغذُها دَنسُ تحتَ الجلابيبِ"],["3FE27978-92C0-5AA8-B8B9-12E2CCFAB925","ودعْ ذا، وقل لبني سعدٍ، بفضلهمِ","مَدحاً يَسيرُ بهِ غادِي الأراكيبِ"],["A5C39D1C-1EA4-5415-905C-41A31EC2BC17","سقينا ربيعةَ نحوَ الشامِ كارهةٍ","سَوق البكارِ على رَغمٍ وتأنيبِ"],["CDD6DE53-1A7B-59CF-A2B5-A760A576D2A6","إذا أرادوا نزولاً حَثَّ سَيرهُمُ","دُونَ النُّزولِ، جِلادٌ غَيرُ تَذبيبِ"],["2FBFD5F7-800B-5C35-BF82-3CE3BBE96288","والحيُّ قحطانُ، قدماً ما يزال لها","منا وقائعُ، من قتلٍ، وتعذيبِ"],["7098B771-1EDF-5103-92B4-BCC982C3BD6B","لمَّا التَقى مَشهدُ مِنَّا ومَشهَدهُمُ","يومَ العذيبِ، وفي أيام تحريبِ"],["FDE41D49-BCC5-5718-91FD-60DE975440AF","لمّا رأَوا أَنّها نارٌ، يُضَرِّمُها","من آلِ سعدٍ،بنو البيضِ المناجيبِ"],["D597E38C-8B4A-5C43-9155-30DB24487D67","ولَّى أبو كربٍ منا بمهجتهِ","وصاحِباهُ، على قُودٍ سَراحيبِ"]]}}}