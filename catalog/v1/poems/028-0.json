{"v":1,"poems":{"F8432B66-C0F3-57DE-ABF6-E5923A122206":{"t":"أأي الناس آمن بعد بلج","p":28,"s":"أأي الناس آمن بعد بلج","r":"436675","v":[["6F5A7BDC-0D7C-5E16-A1C7-F303912911D5","أأي الناس آمن بعد بلج","وقرّةَ، صاحبيّ، بذي طلال"],["02FF233E-A520-5144-B353-A5074595285B","ألما أغزرت في العس برك","ودَرعَةُ بنتُها، نسيا فَعالي؟"],["555AA468-209A-5E87-9A26-91993D51DFCF","سمن على الربيع فهن ضبط","لهنّ لَبالِبٌ تحتَ السِّخال"]]},"26113EBB-8E11-5FE0-B181-1C9CE6E5DACE":{"t":"أبلِغْ لديكَ عامِراً إن لقِيتَها","p":28,"s":"أبلغ لديك عامرا إن لقيتها","r":"436659","v":[["3D3B9F6C-71DF-515E-8B27-26F9C8F6A4E6","أبلِغْ لديكَ عامِراً إن لقِيتَها","فقد بلَغت دارُ الحِفاظِ قَرارَها"],["DE5DD131-042D-5339-9763-9D86647C6C1A","رَحلنا من الأجبالِ، أجبالِ طيّء","نسوق النساء عوذها وعشارها"],["55833483-AAD6-54C7-BB24-14C0F4BC851C","ترى كلَّ بيضاءِ العوارضِ طَفْلَةٍ","تفري إذا شال السماك صدارها"],["12CFCDB8-E88D-5F1B-8262-90D83DC19533","وقد علمت أن لا انقلاب لرحلها","إذا تركت من آخر الليل دارها"]]},"33EE25AA-F96E-5996-8A46-6278ED47A0E5":{"t":"أتجعل إقدامي إذا الخيل أحجمت","p":28,"s":"أتجعل إقدامي إذا الخيل أحجمت","r":"436661","v":[["C12937C7-DB0B-55BC-94EA-BB6FA093F137","أتجعل إقدامي إذا الخيل أحجمت","وكرّي، إذا لم يمنع الدَّبرَ مانعُ"],["FE776B51-4118-5A85-BF03-2B902157329F","سواء ومن لا يقدم المهر في الوغى","ومن دبرُهُ، عند الهزاهز، ضائع"],["1DB7A505-00DA-576E-8EA2-12CAC7D56756","إذا قيل يا ابن الورد أقدم إلى الوغى","أجبت فلاقاني كمي مقارع"],["158EF0DF-8886-5311-A2BF-B51909EA1BE2","بكفي من المأثور كالملح لونه","حديث بإخلاص الذكورة قاطع"],["0F671C37-BE9D-5AAC-8D9E-4AEEC48E9E5F","فأترُكُه بالقاعِ، رَهناً ببلدةٍ","تعاوره فيها الضباع الخوامع"],["F0933756-E239-56A5-9B77-A8EFA303F5FA","محالف قاع كان عنه بمعزل","ولكن حين المرء لا بد واقع"],["74459114-7BD8-565D-9D1D-7FF73F1F04EE","فلا أنا ممّا جَرّتِ الحربُ مشتكٍ","ولا أنا مما أحدثَ الدهرُ جازع"],["1ED94209-CFC0-5D01-97E3-03DA462AC0AF","ولا بصري عند الهياج بطامح","كأني بعير فارق الشول نازع"]]},"0EC7EC6D-D19C-54BD-A374-C322B703A80B":{"t":"أخذت معاقلها اللقاح لمجلس","p":28,"s":"أخذت معاقلها اللقاح لمجلس","r":"436651","v":[["104E6756-EC03-57DE-8A7D-B72F7274ADFD","أخذت معاقلها اللقاح لمجلس","حول ابن أكثم من بني أنمار"],["9E3EA536-232F-58CE-A8DA-8EE2C951DB01","ولقد أتيتكم بليل دامس","ولقد أتيت سراتكم بنهار"],["CF4DF798-3887-5B64-B732-609F22E286BC","فوجدتُكم لِقَحاً حُبسَن بخُلّةٍ","وحبسن إذ صرين غير غزار"],["9CC68B7D-CAD2-57EE-A82F-9CC2133F933D","منعوا البِكارةَ والافالَ كليهِما","ولهم أضن بأم كل حوار"]]},"22EC8EF8-021D-56C9-802D-4F6B9F4066B8":{"t":"أرقت وصحبتي بمضيق عمق","p":28,"s":"أرقت وصحبتي بمضيق عمق","r":"436653","v":[["0C08CBA2-5950-5F32-A4B8-9BD7A6CBE5AF","أرقت وصحبتي بمضيق عمق","لبرق من تهامة مستطير"],["A428A45B-8870-527F-9CED-44C141EEB27D","إذا قلتُ استَهَلّ على قديدٍ","يحور ربابه حور الكسير"],["E0F57F2F-0D78-52A6-B660-4A75CB8B754C","تكشف عائذ بلقاء تنفي","ذكور الخيل عن ولد شفور"],["462AD8BB-D129-59A7-B0A6-64814F84632F","سقى سلمى وأين ديار سلمى","إذا حلّتْ مُجاورةَ السرير"],["D0940D34-8921-50A3-BC40-E1CAA052F08E","إذا حلّتْ بأرضِ بني عليّ","وأهلي بين زامرة وكير"],["A2EA209E-79A0-5BED-9D44-7314676E355D","ذكرت منازلاً من أم وهب","محل الحي أسفل ذي النقير"],["C18C043A-195D-58F2-A12C-ADE378DBA168","أطَعتُ الآمِرينَ بصَرْمِ سَلمى","فطاروا في عراه اليستعور"],["5EF1707D-BDBA-5A6B-BCB1-3572BC3EF1FF","سَقَوْني النَّسءَ، ثم تكنّفوني","عُداةُ اللَّهِ من كذِبٍ وزُورِ"],["649945FF-0473-5221-8613-9F5043CC32A4","وقالوا ليس بعد فداء سلمى","بمُغْنٍ، ما لديكَ، ولا فقير"],["E8943A34-2908-5D88-B224-A9F15BE6E796","ولا وأبيك لو كاليوم أمري","ومن لكَ بالتَدَبُّرِ في الأمورِ"],["D9290E00-F558-500F-8C3D-EDFB8F7E3D17","إذاً لمَلَكْتُ عِصْمةَ أُمّ وَهْبٍ","على ما كان من حسك الصدور"],["74AD0280-1CE2-59D9-8A05-4C69EA56A288","فيا للناس كيف غلبت نفسي","على شيءٍ، ويكرهُهُ ضميري"],["2C6FE3B0-EFEE-5686-B711-E49DD39AD053","ألا يا ليتَني عاصَيتُ طَلْقاً","وجباراً ومن لي من أمير"]]},"DBD08EE5-6FF1-5FB1-9DD3-C48823768050":{"t":"أرى أم حسان الغداة تلومني","p":28,"s":"أرى أم حسان الغداة تلومني","r":"436667","v":[["2DF29508-ABB9-5C6C-9EAE-D311C3349D52","أرى أم حسان الغداة تلومني","تخوفني الأعداء والنفس أخوف"],["6960753A-5E2A-5E6F-9E8F-B4995BD5394C","تقول سليمى لو أقمت لسرنا","ولم تدرِ أني للمُقامِ أُطوّفُ"],["ECD947C4-54EF-5B44-8B90-B69EAD50EA13","لعلّ الذي خوّفتِنا من أمامِنا","يصادفُه، في أهلِهِ، المتخلِّفُ"],["192C2300-A469-5695-8337-F5E696A6B5EE","إذا قلتُ: قد جاء الغنى، حال دونَه","أبو صبية يشكو المفاقر أعجف"],["C0C3A794-540B-55CE-98A2-5907043BAA88","له خلة لا يدخل الحق دونها","كريمٌ أصابَته خطوبٌ تُجَرِّف"],["4002AFBD-F11B-5AAB-BF4C-5D9587370A30","فإني لمستاف البلاد بسربة","فمبلغ نفسي عذرها أو مطوف"],["B0C65D39-A452-59CD-8B01-F5F6FAD29343","رأيت بني لُبنى عليهم غضاضةٌ","بيوتُهمُ، وسطَ الحُلولِ، التكنّف"],["2D410462-1BCF-5762-B760-A2A9176AF781","أرى أم سرياح غدت في ظعائن","تأمَّلُ، من شامِ العراقِ، تُطوِّف"]]},"63E35DCE-0201-509E-B348-007D8B0B77BA":{"t":"أعيرتموني أن أمي تريعة","p":28,"s":"أعيرتموني أن أمي تريعة","r":"436665","v":[["779C2F0D-9A87-5380-A7C1-242D42CA3284","أعيرتموني أن أمي تريعة","وهل ينجبن في القوم غير الترائع"],["DA1002F5-E264-5006-A6C9-BCA7B454EFD2","وما طالب الأوتار إلا ابن حرة","طويلُ نجاد السيّفِ، عاري الأشاجعِ"]]},"F7D60829-5F09-5993-8D11-4A02265EA962":{"t":"أفي ناب منحناها فقيراً","p":28,"s":"أفي ناب منحناها فقيرا","r":"436642","v":[["AD377D86-DACB-5B48-B41F-E5804773D23D","أفي ناب منحناها فقيراً","له بطنابنا طنب مصيت"],["1FE8A9E1-A879-5319-AA58-53C14C9AF69D","وفضلة سمنة ذهبت إليه","وأكثرُ حَقّهِ ما لا يَفوتُ"],["363C8D22-5798-5B6B-A59A-5D03C2BD1B07","تَبيتُ، على المرافقِ، أمُّ وهبٍ","وقد نام العيون لها كتيت"],["DDDEF264-A590-58D3-9840-57DE57C53C9A","فإنّ حَمِيتَنا، أبداً، حرامٌ","وليس لجار منزلنا حميت"],["AEEB3716-9167-5731-A497-8C2833FD86DC","ورُبَّتَ شُبْعَةٍ آثَرتُ فيها","يداً جاءت تغير لها هتيت"],["5DD9C60B-C92C-55B6-8D26-0D6E551960AF","يقولُ: الحقُّ مطلبُهُ جميلٌ","وقد طلبوا إليك، فلم يُقِيتوا"],["4EBD867F-DFFC-56DC-A263-EBA5E3315FBB","فقلتُ له: ألا احيَ، وأنتَ حُرٌّ","ستشبعُ في حياتِكَ، أو تموت"],["A346B415-695D-5A1D-9EEA-F5447DE156BF","إذا ما فاتني لم أستقله","حياتي والملائم لا تفوت"],["06730E35-AA25-5374-AD1E-D354DA2A9AAF","وقد علمت سليمى أن رأيي","ورأي البخل مختلف شتيت"],["792142BF-C3ED-52FF-A782-3092F0E1E3AE","وأني لا يريني البخل رأي","سواءٌ إن عطِشتُ، وإن رويت"],["99C873A0-68F5-556B-AA56-05738A8A04AF","وأني، حينَ تشتجرُ العَوالي","حوالي اللب ذو رأي زميت"],["CC32F62C-9FC5-5D2E-BA3A-A367F69C59D9","وأُكفى، ما علمتُ، بفضل علمٍ","وأسأل ذا البيان إذا عميت"]]},"EF988C17-9BB6-5372-B284-FE09BFFA00ED":{"t":"أقِلِّي عَلَيَّ اللِّوْمَ يا ابْنَةَ مُنْذِرِ","p":28,"s":"أقلي علي اللوم يا ابنة منذر","r":"436652","v":[["8179F4B3-2E06-53F9-86B7-4CC12EDAB567","أقِلِّي عَلَيَّ اللِّوْمَ يا ابْنَةَ مُنْذِرِ","ونامِي، فإنْ لم تَشْتَهي النَّومَ فاسْهَرِي"],["BF6DDA59-8038-5B7D-B347-62EA6131D2B7","ذَرِيني ونَفسي أُمَّ حَسَّانَ، إنني","بها قبل أن لا أملك البيع مشتري"],["C324D863-E406-5AB0-885D-6095CA47DBFB","أحاديثُ تَبْقَى والفَتى غيرُ خالدٍ","إذا هو أمسى هامة فوق صير"],["0CA71628-48B7-5456-A595-64F3F75DCE82","تُجَاوِبُ أحْجَارَ الكِنَاسِ وتَشْتَكِي","إلى كلِّ معروفٍ تراهُ ومُنْكَرِ"],["B2127C1F-335C-58B7-8A1C-78E9CFEF3A70","ذَرِيني أُطَوِّفْ فِي البلادِ لعلَّنِي","أخَلِّيكِ أو أغْنِيكِ عن سُوءِ مَحْضَرِ"],["BCF6A0B0-365B-530F-93E5-F1FEFBB4B53F","فإن فاز سهم للمنية لم أكن","جَزُوعاً، وهَلْ عن ذاكِ من مُتَأخَّرِ"],["E971B9BB-89F4-54E0-8316-6593CB83F4D9","وإن فاز سهمي كفكم عن مقاعد","لكم خلف أدبار البيوت ومنظر"],["927419C8-7B6E-5D0A-B527-A24138024EAE","تقول لك الويلات هل أنت تارك","ضَبُوءَاً بِرَجْلٍ تارةً وبِمنسرِ"],["12513617-A7FA-5072-9DE8-85EFA1141663","ومستثبت في مالك العام إنني","أرَاكَ عَلَى أقْتَادِ صَرْماءَ مُذْكِرِ"],["F8D7CF80-239D-574E-A115-62F7AEEE2922","فَجُوعٍ بها لِلصَّالِحِينَ مَزِلَّةٍ","مخوف رداها أن تصيبك فاحذر"],["01E6E4B2-454E-5E80-A441-9771288A13F4","أبى الخفض من يغشاك من ذي قرابة","ومن كل سوداء المعاصم تعتري"],["F6642FDC-9205-53A6-A01F-EE8180EF6824","ومستهنيء زيد أبوه فلا أرى","له مدفعاً فاقني حياءك واصبري"],["13967566-DE13-503D-91DA-4CA8ABFC193F","لَحَى الله صَعْلُوكاً إذَا جَنَّ ليلُهُ","مصافي المشاش آلفاً كل مجزر"],["105C6F9D-FAE3-5A47-ACEA-FF7D6805D8BD","يَعُدُّ الغِنى مِن نَفسِهِ كُلَّ لَيلَةٍ","أَصابَ قِراها مِن صَديقٍ مُيَسَّرِ"],["98A9AEB1-5746-50F0-892E-00CF4A760E54","يَنامُ عِشاءً ثُمَّ يُصبِحُ ناعِساً","يَحُتُّ الحَصى عَن جَنبِهِ المُتَعَفِّرِ"],["D668773A-09A3-57E7-8D59-D7E390DD609F","قَليلُ اِلتِماسِ الزادِ إِلّا لِنَفسِهِ","إِذا هُوَ أَمسى كَالعَريشِ المُجَوَّرِ"],["E77CBD13-4CBD-501B-862F-F9206817F599","يُعَينُ نساءَ الحَيِّ ما يَسْتَعِنَّهُ","ويمسي طليحاً كالبعير المسحر"],["72B92402-D5C5-5DB3-A3B3-8AACCE3C732D","ولكن صعلوكاً صفيحة وجهه","كَضَوْءِ شِهَابِ القابِسِ المُتَنَوِّرِ"],["78026104-ED46-5805-BA6B-E062CE9CAA75","مطلاً على أعدائه يزجرونه","بساحتهم زجر المنيح المشهر"],["63F3392D-7136-5842-810B-C622E47C2918","وإنْ بَعِدُوا لا يَأْمَنُونَ اقْتِرَابَهُ","تَشَوُّفَ أهلِ الغائبِ المُتَنَظَّرِ"],["07B64A01-D595-5BC9-A2DD-FCE8A538535B","فذلكَ إنْ يَلْقَ المنيّةَ يلْقَها","حَمِيداً، وإنْ يَسْتَغْنِ يوماً فأجْدِرِ"],["A45657AC-9BC2-5E1A-994A-2DB15BAFE9EE","أيهلك معتم وزيد ولم أقم","على ندب يوماً ولي نفس مخطر"],["D9D5304F-4B80-5939-A9B8-575351FB30BB","ستفزع بعد اليأس من لا يخافنا","كواسع في أخرى السوام المنفر"],["A233CF43-F0EC-518F-9CC1-110D20724E96","يطاعن عنها أول القوم بالقنا","وبيض خفاف ذات لون مشهر"],["8664ACAE-D7C8-5B79-AC66-6253F9FF5C14","فَيَوماً عَلى نَجدٍ وَغاراتِ أَهلِها","وَيَوماً بِأَرضٍ ذاتِ شَتٍّ وَعَرعَرِ"],["BD42C7DD-2708-5188-83C4-52696D824377","يناقلن بالشمط الكرام أولي القوى","نِقَابَ الحِجَازِ في السَّرِيح المُسَيَّرِ"],["C97553D3-3BC2-5226-B889-56D0A9A203BB","يُرِيحُ عليَّ اللَّيلُ أضَيافَ ماجدٍ","كريم، ومالِي سَارحاً مالُ مُقْتِر"]]},"0A415657-9412-5CA6-8992-372845162D05":{"t":"ألا إنّ أصحابَ الكنيفِ وجدتُهم","p":28,"s":"ألا إن أصحاب الكنيف وجدتهم","r":"436670","v":[["C565D3E0-4C94-5EE4-A851-3256B3866925","ألا إنّ أصحابَ الكنيفِ وجدتُهم","كما الناس لما أخصبوا وتمولوا"],["31136C4C-5241-508E-86CD-2551D1FD7BF4","وإنّي لمَدفوعٌ إليّ ولاؤهم","بماوان إذ نمشي وإذ نتململ"],["1716C152-B738-5E2E-AA23-0199516FC00A","وإذ ما يريح الحي صرماء جونة","ينوسُ عليها رحلُها ما يحلّل"],["D522B57D-2D79-586A-8E78-D15AE7BEE9A6","موقَّعةُ الصَّفقينِ، حدباء، شارفٌ","تقيد أحياناً لديهم وترحل"],["102477CC-EFA9-5199-BBF3-9F572D287155","عليها من الوِلدانِ ما قد رأيتُمُ","وتمشي، بجَنبيها، أراملُ عُيَّل"],["5CCD7EA7-6B30-5F0D-A62E-EC964D550B94","وقلت لها يا أم بيضاء فتية","طعامُهُمُ، من القُدورِ، المعجَّل"],["E7AB6E58-7ECE-53BC-A96D-C15007EFF57D","مضيغ من النيب المسان ومسخن","من الماء نعلوه بآخر من عل"],["D523D33F-5915-5D53-A509-B5443E834C22","فإني وأياهم كذي الأم أرهنت","له ماء عينيها، تفَدّي وتَحمِل"],["83838FF8-68CF-58AB-802F-F4429227F3C6","فلما ترجت نفعه وشبابه","أتت دونها أخرى جديداً تكحل"],["32739593-635A-5C05-91A3-1E24D54DD56B","تخير من أمرين ليسا بغبطة","هو الثّكلُ، إلاّ أنها قد تجمَّل"],["F04F2774-04F2-5ED5-8ACC-3F1189BD28F7","كليلةِ شيباء التي لستَ ناسياً","وليلتِنا، إذ منّ، ما منّ، قِرمِل"],["4967A76C-2710-56EA-8E62-D88FEA916E7B","أقول له يا مال أمك هابل","متى حسبت على الأفيح تعقل"],["F4BAB912-2F98-5C4E-878B-05C2FFCFA248","بدَيمومةٍ، ما إن تكادُ ترى بها","من الظمأ الكوم الجلاود تنول"],["DEA4F15E-B80C-5AFF-8E93-32274BD20778","تنكر آيات البلاد لمالك","وأيقن أن لا شيء فيها يقول"]]},"00DAE8A4-09C3-52C0-BD72-E1699D71A91D":{"t":"أليس ورائي أن ادب على العصا","p":28,"s":"أليس ورائي أن ادب على العصا","r":"436668","v":[["3CF88D30-F96F-5716-93EA-5CE7563C478E","أليس ورائي أن ادب على العصا","فيَشمتَ أعدائي، ويسأمني أهلي"],["E44975AC-36A7-50E3-B124-A675B3007F3B","رهينةُ قَعْرِ البيتِ، كلَّ عشيّةٍ","يُطيف بي الولدانُ أهدجُ كالرأل"],["9C469E0D-28B2-5ED7-BB0B-0FF3BE0C6087","أقيموا بني لبنى صدور ركابكم","فكل منايا النفس خير من الهزل"],["AC17A572-1023-52D9-8C83-705B6DE79777","فإنكم لن تبلغوا كل همتي","ولا أربي حتى تروا منبت الأثل"],["0B1CB282-0C17-5A98-9D7A-4E918C2C2C82","فلو كنْتُ مثلوجَ الفؤاد، إذا بدَت","بلا الأعادي لا أمر ولا أحلي"],["A7F751DC-B9FE-5DB3-8DA4-95C3FC951C0D","رجعت على حرسين إذ قال مالك","هلَكتَ، وهل يُلحَى، على بُغيةٍ، مثلي"],["6DA026EF-021A-5887-BD8F-BF75A9D30CF3","لعل انطلاقي في البلاد ورحلتي","وشَدّي حَيازيمَ المطيّةِ بالرّحلِ"],["2F24EBED-4BB0-5F16-BA22-46B25552B75E","سيدفعُني، يوماً، إلى ربّ هَجمةٍ","يدافع عنها بالعقوق وبالبخل"],["F5AAC139-0533-587B-B850-57D0126687DB","قليلٌ تَواليها، وطالبُ وِترِها","إذا صحتُ فيها بالفوارسِ والرَّجل"],["357184B0-5314-5631-A635-CE807F5DBB7B","إذا ما هبطنا منهلاً في مخوفة","بعثنا ربيئاً في المرابئ كالجذل"],["D233FA2D-0164-5557-B2CE-6669BBA5707C","يقلب في الأرض الفضاء بطرفه","وهن مناخات ومرجلنا يغلي"]]},"9F94ACAC-D37B-581F-A95A-DA6D04490DCF":{"t":"أيا راكِباً! إمّا عرَضتَ فبلّغَنْ","p":28,"s":"أيا راكبا! إما عرضت فبلغن","r":"436638","v":[["635CCAAE-2256-5C01-BD23-6C2D8DFD887E","أيا راكِباً! إمّا عرَضتَ، فبلّغَنْ","بني ناشب عني ومن يتنشب"],["613CB80C-CADF-5ECC-B188-B1C328D6C58F","آكلكم مختار دار يحلها","وتاركُ هُدْمٍ ليس عنها مُذنَّبُ"],["CE15F79D-CA9D-5D5A-99CC-294DF8E2DAE8","وابلغ بني عوذ بن زيد رسالةً","بآيةِ ما إن يَقصِبونيَ يكذِبوا"],["711A000A-C4EF-5623-945E-C40E6816C67F","فإن شِئتمُ عني نَهيتُم سَفيهَكم","وقال له ذو حلمكم أين تذهب"],["D627955D-DFA1-59B7-AAE9-B1A37BFC5060","وإن شئتمُ حاربتُموني إلى مَدًى","فيَجهَدُكم شأوُ الكِظاظِ المغرّبُ"],["457CAA0D-2F9E-586C-9120-0DB70A8EAA85","فيلحق بالخيرات من كان أهلها","وتعلم عبس رأس من يتصوب"]]},"1E2B30E5-8B22-5665-95FD-D991E3FF4270":{"t":"إذا آذاكَ مالُكَ فامتهِنه","p":28,"s":"إذا آذاك مالك فامتهنه","r":"436646","v":[["074EEFFB-9B87-56A1-8FAD-591B74522787","إذا آذاكَ مالُكَ، فامتهِنه","لجاديه وإن قرع المراح"],["010C4782-F2F9-5D42-8022-1D34910C6EAF","وإن أخنى عليك فلم تجده","فنبتُ الأرض والماءُ القَراحُ"],["30F64F22-8C2C-524A-BA57-094FFF8F9F82","فرغمُ العيشِ إلفُ فِناءِ قومٍ","وإن آسوكَ، والموتُ الرَّواح"]]},"CE8D77BD-FA5A-55E3-90F7-C5D3682A29B4":{"t":"إذا المرء لم يبعث سواماً ولم يرح","p":28,"s":"إذا المرء لم يبعث سواما ولم يرح","r":"436641","v":[["0CB6A43E-F5BB-558C-B0F8-B145E656AFDB","إذا المرء لم يبعث سواماً ولم يرح","عليه ولم تعطف عليه أقاربه"],["6888E23C-BC8D-5C02-875F-B5B59B94F0E4","فلَلمَوتُ خيرٌ للفَتى منْ حَياتِهِ","فقيراً، ومن موْلًى تدِبُّ عقارِبُهْ"],["A251CFC6-2434-5FF6-94B1-8E9A0E9B6DB1","وسائلةٍ: أينَ الرّحيلُ؟ وسائِلٍ","ومت يسأل الصعلوك أين مذاهبه"],["F62C43E6-387C-5B60-BAFD-67298FF32225","مَذاهِبُهُ أنّ الفِجاجَ عريضةٌ","إذا ضَنّ عنه، بالفَعالِ، أقاربُه"],["AFFE74C2-CAF2-575A-92FF-4279A7D30739","فلا أترك الإخوان ما عشت للردى","كما أنه لا يتركُ الماءَ شاربُه"],["765A8DEC-D397-5344-8A0F-D8DF2C1CC6DE","ولا يُستضامُ، الدهرَ، جاري، ولا أُرى","كمن باتَ تسري للصّديق عقاربُه"],["C9065B91-1FF9-5191-9039-CEF28C7DB744","وإنْ جارتي ألوَتْ رياحٌ ببيتها","تغافلت حتى يستر البيت جانبه"]]},"9C7EACC6-DCA2-5E93-991E-FE2A7A85973F":{"t":"إذا المرء لم يطلب معاشاً لنفسه","p":28,"s":"إذا المرء لم يطلب معاشا لنفسه","r":"436658","v":[["B1A26937-2318-5F1F-9F94-498D2CEB5B11","إذا المرء لم يطلب معاشاً لنفسه","شكا الفقرَ، أو لامَ الصّديقَ، فأكثرا"],["7C1C1777-D204-54C6-84ED-052F1A3D5B48","وصارَ على الأدنَينَ كَلاًّ، وأوشكتْ","صلات ذوي القربى له أن تنكرا"],["0D2C643A-8424-5741-A7C0-4BFE32E70BDE","وماطالب الحاجات من كل وجهة","من الناس إلا من أجد وشمرا"],["1CCB10D7-A023-5C1D-9989-59A0CB9343C6","فسر في بلاد الله والتمس الغنى","تَعِشْ ذا يَسارٍ، أو تموتَ فتُعذَرا"]]},"6DFC3E62-0B60-5399-836D-CDCB184532CF":{"t":"إلى حكم تناجل منسماها","p":28,"s":"إلى حكم تناجل منسماها","r":"436674","v":[["F7E7EFFB-A411-5220-8A3D-91329AD4B6CF","إلى حكم تناجل منسماها","حصى المعزاء من كنفي حقيل"],["05BB8AA1-8AC1-5B8F-9577-BCA3CD49F35A","ولم أسالك شيئاً قبل هاتي","ولكني على أثر الدليل"],["3E99E2DD-7711-5A36-8DA6-919810AE277D","وكانتْ لا تلومُ، فأرّقَتني","ملامتها على دل الجميل"],["0A9DFDA5-9AFA-5DC1-A49B-446B5BB1D2AE","وآسَتْ نفسَها، وطوَت حشاها","على الماء القَراح مع المليل"]]},"1478AF92-7310-5DD7-8835-4B4B170AF887":{"t":"إن تأخُذوا أسماء موقفَ ساعةٍ","p":28,"s":"إن تأخذوا أسماء موقف ساعة","r":"436639","v":[["3DADEFCC-6E00-5F7E-9350-E957212B10FB","إن تأخُذوا أسماء، موقفَ ساعةٍ","فمأخذُ ليلى، وهي عذراءُ، أعجبُ"],["2C39614B-1EFD-5996-8771-B85346F4961A","لبسنا زماناً حسنها وشبابها","ورُدّتْ إلى شعواء، والرأسُ أشيبُ"],["5603850B-B73C-5915-9782-2BF3C983E807","كمأخذنا حسناء كرهاً ودمعها","غداةَ اللّوى، مغصوبةً، يتصَبّبُ"]]},"FC1827EF-851B-5777-B59D-B066DFD6D22F":{"t":"إني امرؤ عافي إنائي شركة","p":28,"s":"إني امرؤ عافي إنائي شركة","r":"436649","v":[["91AFFA29-AEEE-5ED5-8681-3962A663B966","إني امرؤ عافي إنائي شركة","وأنتَ امرؤ عافي إنائِكَ واحدُ"],["A997F2A9-F06D-598A-817E-7EAAB6F6C210","اتهزأ مني أن سمنت وأن ترى","بوجهي شحوبَ الحقِّ، والحقُّ جاهد"],["0392A32C-F521-5F0D-BD28-B5E0D73F7934","أُقسّمُ جسمي في جسوم كثيرة","وأحسو قراح الماء والماء بارد"]]},"B05F8CD1-2C09-5444-9DD6-347F3BA092C6":{"t":"بنيت على خلق الرجال بأعظم","p":28,"s":"بنيت على خلق الرجال بأعظم","r":"436673","v":[["D6C29733-881E-51BC-94E8-41D209689A5C","بنيت على خلق الرجال بأعظم","خِفافٍ، تثنّى تحتَهُنّ المفاصلُ"],["435161A6-3B6B-5DCC-A14D-181CE907DB8F","وقلب جلا عنه الشكوك فإن تشا","يُخبّركَ، ظهرَ الغيبِ، ما أنتَ فاعلُ"]]},"1F860C43-B17E-58A0-9377-531FBA886025":{"t":"تبَغَّ عِداءً حيثُ حلّتْ ديارُهَا","p":28,"s":"تبغ عداء حيث حلت ديارها","r":"436669","v":[["B9E08DCA-2C6D-530D-A0BA-C9A8378EF9DB","تبَغَّ عِداءً حيثُ حلّتْ ديارُهَا","وأبناء عوْفٍ في القرونِ الأوائل"],["8362246C-8A13-5C94-A4D8-396817103BE4","فإلاّ أنَلْ أوساً، فإنّيَ حسبُها","بمنبطح الأوعال من ذي الشلائل"]]},"F4B4D4C6-5A69-5376-B789-17365EE59FCA":{"t":"تحن إلى سلمى بحر بلادها","p":28,"s":"تحن إلى سلمى بحر بلادها","r":"436656","v":[["162B1F94-84F9-5133-920A-833BAD20B9AE","تحن إلى سلمى بحر بلادها","وأنت عليها بالملا كنت أقدر"],["BA80E50B-CC9F-5FC7-8AFE-0F6ACEA28C34","تحِلّ بوادٍ، من كَراءٍ، مَضَلّةٍ","تحاولُ سلمى أن أهابَ وأحصَرا"],["91078DA7-9E26-5550-8365-6D729930ECF5","وكيف تُرَجّيها، وقد حِيلَ دونها","وقد جاورت حيّاً بتَيمن مُنكرا"],["014DA57D-A538-555C-A706-E5F1703DF74B","تبغّانيَ الأعْداءُ إمّا إلى دَمٍ","وإما عراض الساعدين مصدرا"],["BE597022-2BB6-5C71-B7E6-6BE11B3CF21A","يظلّ الأباءُ ساقطاً فوقَ مَتنِهِ","له العَدْوَةُ الأولى، إذا القِرْنُ أصحرا"],["3D8EE710-0B2C-53A9-BECB-1429E06F1947","كأنّ خَواتَ الرعدِ رزءُ زئيره","من اللاء يسكن العرين بعثرا"],["36955FA4-956B-5F45-9692-D3CF50D35CB2","إذا نحن أبردنا وردت ركابنا","وعنّ لنا، من أمرنا، ما تَيَسّرا"],["2051D85B-57B0-53C2-A662-E5BBB700D3D0","بدا لك مني عند ذاك صريمتي","وصبري إذا ما الشيء ولى فأدبرا"],["09C87EFF-B3A9-554C-B927-494CEE5A0DC8","وما أنس مالأشياء لا أنس قولها","لجارتها ما إن يعيش بأحورا"],["3FAD0165-9F86-5784-A9A5-EB7E4AD2D2E3","لعلّكِ، يوماً، أن تُسِرّي نَدامَةً","علي بما حشمتني يوم غضورا"],["BDE44933-A2C5-5820-90B3-D0EA32275D09","فغربت إن لم تخبريهم فلا أرى","لي اليوم أدنى منك علماً وأخبرا"],["1C2E62D3-A692-59BE-A680-0D25B552B6CF","قعيدَكِ، عمرَ الله، هل تَعلمينني","كريماً، إذا اسوَدّ الأناملُ، أزهرا"],["CE8E6025-C7D7-5B7A-A934-88C4676EABE1","صبوراً على رزء الموالي وحافظاً","لعرضي حتى يؤكل النبت أخضرا"],["2FD49BCA-0F58-53F7-AE6B-FED0FF46D23F","أقب ومخماص الشتاء مرزأ","إذا اغبر أولاد الأذلة أسفرا"]]},"AC963EB2-568E-5FC8-9CE3-8BE69325448D":{"t":"تقولُ: ألا أقصرْ من الغزو واشتكى","p":28,"s":"تقول: ألا أقصر من الغزو واشتكى","r":"436662","v":[["96749643-1E24-5CF2-8FF3-F0A5FA168F2A","تقولُ: ألا أقصرْ من الغزو، واشتكى","لها القولَ، طرفٌ أحورُ العينِ دامعُ"],["904714B4-7189-5D9E-A2E3-9314BC9A240A","سأُغنيكِ عن رَجعِ المَلام بمُزْمِعٍ","من الأمر، لا يعشو عليهِ المطاوع"],["AE2F1AB0-E73D-5747-9AB0-5DE0562BBE2B","لبوس ثياب الموت حتى إلى الذي","يُوائمُ إمّا سائمٌ، أو مُصارع"],["14F277BE-6C50-5648-8DFA-3459FD954D2F","ويدعُونَني كهلاً، وقد عشتُ حِقبةً","وهنّ، عن الأزواجِ نحوي، نوازع"],["E2400D78-A91E-55F6-8219-9E822D7AF81A","كأني حصان مال عنه جلاله","أغرُّ، كريمٌ، حوله العُوذُ، راتع"],["0FB4C31E-340A-5972-8612-4C471E1A3129","فما شاب رأسي من سنن تتابعت","طوالٍ، ولكنْ شيّبَته الوقائع"]]},"B90C7673-34F4-5C69-863D-8876F9FA8273":{"t":"تمنّى غُربتي قيسٌ وإنّي","p":28,"s":"تمنى غربتي قيس وإني","r":"436671","v":[["F2C50F3D-A636-5396-8185-9432DF093664","تمنّى غُربتي قيسٌ، وإنّي","لأخشى إن طحى بك ما تقول"],["3ECBFEC4-94F9-5082-84D5-ED7A2F719040","وصارَتْ دارُنا شَحطاً عليكم","وجُفُّ السيفِ كنتَ به تصول"],["97B58F55-AAC8-587E-BA31-DAF34E08AF45","عليك السلم فاسلمها إذا ما","آواك له مبيت أو مقيل"],["E7947186-186E-5209-B980-81A3FF2E2CD4","بأن يَعيا القليلُ عليك، حتى","تصيرَ له، ويأكُلك الذليلُ"],["A5D7CB70-9936-5FDA-A080-EF1EFD489A32","فإن الحرب لو دارت رحاها","وفاض العزُّ، واتُّبِعَ القليل"],["A4E31FA7-16C3-50CE-A53E-3AB83B49B7E0","أخذتَ، وراءنا، بذُنابِ عَيشٍ","إذا ما الشّمسُ قامت لا تزُول"]]},"54DE15AB-47F5-5B10-9ED4-4893351E6748":{"t":"جزى اللَّهُ خيراً كلما ذُكِرَ اسمهُ","p":28,"s":"جزى الله خيرا كلما ذكر اسمه","r":"436647","v":[["A726F313-D980-5299-A650-76F4D372B1BE","جزى اللَّهُ خيراً، كلما ذُكِرَ اسمهُ","أبا مالك، إنْ ذلك الحيُّ أصْعَدُوا"],["FFE40698-697A-5D65-97DC-01B04AB68623","وَزَوّدَ خيراً مالكاً، إنّ مالِكاً","لهُ رِدّةٌ فينا، إذا القوم زُهَّدُ"],["4B9AE2EC-5A00-5AE3-967E-D7F0D3112432","فهل يطربن في إثركم من تركتكم","إذا قام يعلوهُ حِلالٌ، فيقعُد"],["80682AB4-EEF1-5256-872E-5EA0FCBB7216","تولى بنو زبان عنا بفضلهم","وود شريك لو نسير فنبعد"],["5115CB1D-96E9-577F-8815-E8D6612C9C25","ليَهنىء شريكاً وطبُه ولِقاحُه","وذوو العس بعد نومة المتبرد"],["ECBA00FE-0CCA-5A6F-A68B-54D634CEDB69","وما كان منّا مَسكناً، قد علمتمُ","مدافعُ ذي رَضْوَى، فعَظمٌ، فصَنددُ"],["07C3AF24-3518-5EC9-9F67-56CD25F3E77E","ولكنّها، والدّهرُ يومٌ وليلةٌ","بلادٌ بها الأجناءُ، والمتصَيَّد"],["E74825B2-D1AC-52C9-8161-968DE3B48B9A","وقلتُ لأصْحابِ الكنيفِ: تَرَحّلوا","فليس لكم في ساحة الدار مقعد"]]},"A402B5DA-9009-5DC2-840A-679614B1DC99":{"t":"دعِيني أُطوّفْ في البلادِ لعلّني","p":28,"s":"دعيني أطوف في البلاد لعلني","r":"436672","v":[["56380020-52AA-51FC-8F77-58238E6A80BE","دعِيني أُطوّفْ في البلادِ، لعلّني","أُفِيدُ غِنًى، فيه لذي الحقّ محمِلُ"],["A42BBFBD-044B-56A3-8298-494734824A68","أليس عظيماً أن تلم ملمة","وليس علينا في الحقوق معول"]]},"3D263C01-B0DF-58F6-98E4-948A0573DA74":{"t":"دعِيني للغنى أسعى فإنّي","p":28,"s":"دعيني للغنى أسعى فإني","r":"436655","v":[["758DDB92-5BA5-58CB-8C52-2A60D0CB7FB0","دعِيني للغنى أسعى، فإنّي","رأيتُ الناسَ شرُّهمُ الفقيرُ"],["06D25CA8-A5CF-507F-8E54-40BB2195EFDC","وأبعدُهم وأهونُهم عليهم","وإن أمسى له حسب وخير"],["87AF831D-3DD5-5AC9-942C-3C3DDA249006","ويُقصِيهِ النَّدِيُّ، وتَزْدرِيهِ","حليلته وينهره الصغير"],["FDEDFEAC-2BA5-5953-8AAC-083485678A72","ويلقى ذا الغنى وله جلال","يكاد فؤاد صاحبه يطير"],["A5A3BD47-A118-5561-BFEC-033E1A8B878F","قليلٌ ذنبُهُ، والذنبُ جمٌّ","ولكن للغِنى ربٌّ غفورُ"]]},"8C820C8C-0753-50B7-B118-959F854342E2":{"t":"عفت بعدنا من أم حسان غضور","p":28,"s":"عفت بعدنا من أم حسان غضور","r":"436654","v":[["C340315A-9EF1-50E8-86F8-A67E4C4F7711","عفت بعدنا من أم حسان غضور","وفي الرحل منها آية لا تغير"],["91299951-65F1-5EBB-8466-FD3511168624","وبالغر والغراء منها منازل","وحول الصفا من أهلها متدور"],["503E2B2C-8F92-500E-9E75-2BAEBA32B2D4","ليالينا إذ جيبها لك ناصح","وإذ رِيحُها مِسكٌ زكيٌّ، وعنبر"],["17C04D61-189F-54B3-B019-5A15EA9C7A8F","ألم تعلمي، يا أُمّ حسّانَ، أنّنَا","خلِيطا زيالٍ، ليس عن ذاك مَقصَر"],["DEEADD1E-47A8-55DD-A955-680F69875BF9","وأن المنايا ثغر كل ثنية","فهل ذاك عما يبتغي القوم محصر"],["EDCE3113-2AC2-51C0-85AD-43BBAAA00BE2","وغبراء مخشي رداها مخوفة","أخوها بأسباب المنايا مغرر"],["2C2AADAE-571E-52EC-875C-422E9BC5E9EC","قطعت بها شك الخلاج ولم أقل","لخيّابَةٍ، هَيّايةٍ: كيف تأمُر؟"],["F7390C8E-D8B1-5E24-A793-EDD602849AEB","تداركَ، عَوذاً، بعدَ ما ساء ظَنُّها","بماوان عرق من أسامة أزهر"],["07AB774F-E81F-502A-AE8F-DCFBCF1ABD71","هُم عيّروني أنّ أُمّي غريبةٌ","وهل في كريمٍ ماجدٍ ما يُعيَّر؟"],["507AE322-B1EF-5278-A360-EDEA62DD26F5","وقد عيروني المال حين جمعته","وقد عيروني الفقر إذ أنا مقتر"],["ABEA5465-D8C7-521F-A445-A46437A36602","وعيّرني قومي شَبابي ولِمّتي","متى ما يشا رهط امرىء يتعير"],["CE77DF9F-2F14-5C40-8183-8856E914E97E","حوى حَيٌّ أحياءٍ شتِيرَ بنَ خالدٍ","وقد طمعت في غُنمِ آخرَ جعفر"],["19F0EA88-E72E-5CDB-8F17-CA72EA0FFB43","ولا أنتمي إلاّ لجارٍ مجاورٍ","فما آخِرُ العيشِ الذي أتنظّر؟"]]},"357F0F0D-7172-5CBC-959D-92ACCD3F5994":{"t":"فِراشي فراشُ الضيفِ والبيتُ بيتُه","p":28,"s":"فراشي فراش الضيف والبيت بيته","r":"436663","v":[["CD14E36B-0B87-5F15-BD5D-016380D9D426","فِراشي فراشُ الضيفِ والبيتُ بيتُه","ولم يلهني عنه غزال مقنع"],["F0AD0B02-43ED-5D82-8CC4-0F7B741ACC9C","أُحدّثُه، إنّ الحديثَ مِن القِرى","وتعلم نفسي أنه سوف يهجع"]]},"5CC16257-1D61-58AE-8975-647378A65231":{"t":"قالت تماضر إذ رأت ما لي خوى","p":28,"s":"قالت تماضر إذ رأت ما لي خوى","r":"436645","v":[["F10CAC9E-087B-5DC9-8262-A5CEE316EA14","قالت تماضر إذ رأت ما لي خوى","وجفا الأقاربُ، فالفؤادُ قريحُ"],["A6DCBCA7-4CB1-537D-A247-C344353ED869","ما لي رأيتُكَ في النّديّ منكَّساً","وَصِباً، كأنّكَ في النّديّ نَطيح؟"],["007AE21C-E3C8-597E-949E-3D3C9297035B","خاطر بنفسك كي تصيب غنيمة","إنّ القُعودَ، معَ العِيالِ، قبيح"],["1B273A79-56C4-5028-A3A7-FAFFF8E02A9A","المال فيه مهابة وتجلة","والفَقْرُ فِيهِ مذلّةٌ وفُضُوح"]]},"E60DEC5E-BD39-5A18-B812-6772BAE0388F":{"t":"قلتُ لقوْمٍ في الكنيفِ ترَوّحوا","p":28,"s":"قلت لقوم في الكنيف تروحوا","r":"436643","v":[["D78FD1E3-5A43-5426-8720-5CD437D2D57D","قلتُ لقوْمٍ، في الكنيفِ، ترَوّحوا","عشِيّةَ بتنا عند ماوان، رُزَّحِ"],["02E4B6B5-9FDA-58B5-B10A-F0D136EF2644","تنالوا الغنى أو تبلغوا بنفوسكم","إلى مُستراحٍ من حِمامٍ مبرَّحِ"],["A7FAF633-1A82-532B-A1C0-A17CA32A8C44","ومن يك مثلي ذا عيال ومقتراً","من المال يطرح نفسه كل مطرح"],["24D323C3-2EF2-585E-802A-A144E3B33310","ليَبْلُغَ عُذراً، أو يُصِيبَ رَغِيبةً","ومبلغ نفس عذرها مثل منجح"],["1E4182FB-5C4C-50F3-816A-CE762B6FF024","لعلَّكمُ أن تصلُحوا بعدَما أرى","نبات العضاه الثائب المتروح"],["1A56CD6D-499C-570E-A243-73FA65486414","ينوؤون بالأيدي وأفضل زادهم","بقيّةُ لحْمٍ من جَزُورٍ مملَّح"]]},"E2F92C63-1103-54C2-B68F-6174A8A18CBD":{"t":"لا تلم شيخي فما أدري به","p":28,"s":"لا تلم شيخي فما أدري به","r":"436640","v":[["EABD9DCC-B386-5E55-BE6D-45AF0C02CC12","لا تلم شيخي فما أدري به","غير أن شارك نهداً في النسب"],["E28D3A54-8BE2-5F03-A5E5-4756CF353A87","كان في قيس حسيباً ماجداً","فأتت نَهدٌ على ذاك الحسَب"]]},"5054691A-FD40-54A7-AA1F-556A2026A4CB":{"t":"لحى اللَّهُ صُعلوكاً إذا جَنّ ليلُهُ","p":28,"s":"لحى الله صعلوكا إذا جن ليله","r":"499235","v":[["3B926B38-5E0D-54BB-935F-33CD6D5E78DD","لحى اللَّهُ صُعلوكاً، إذا جَنّ ليلُهُ","مصافي المشاشِ، آلفاً كلَّ مجزرِ"],["BA1FA05E-9819-5846-8019-319F828E2C53","يَعُدّ الغِنى من نفسه، كلّ ليلة","أصابَ قِراها من صَديقٍ ميسَّر"],["55C8C3B9-1123-574A-BE8C-919C6A6E48C9","ينامُ عِشاءً ثم يصبحُ ناعساً","تَحُثّ الحَصى عن جنبِهِ المتعفِّر"],["9940C568-FC7D-5AA5-8DFA-B4FE5713CDF1","يُعينُ نِساء الحيّ، ما يَستعِنّه","ويمسي طليحاً كالبعيرِ المحسرِ"]]},"70C1A1EA-5EFA-542B-A9D6-36186C2F477C":{"t":"لكلّ أُناس سيّدٌ يَعرِفونه","p":28,"s":"لكل أناس سيد يعرفونه","r":"436664","v":[["5371D42C-A39D-5894-B375-7B7A684D38A1","لكلّ أُناس سيّدٌ يَعرِفونه","وسيدنا حتى الممات ربيع"],["CD258055-3FA4-5B50-A138-B869A27E8769","إذا أمرَتني بالعُقوقِ حلِيلتي","فلم أعصِها، إني إذاً لمَضِيعُ"]]},"07779E43-1D82-5086-8A24-AFDDCD55D33B":{"t":"ما بالثّراءِ يسُودُ كلُّ مُسوَّدٍ","p":28,"s":"ما بالثراء يسود كل مسود","r":"436650","v":[["6833B2B6-3687-5D37-A81F-AB1A7186359E","ما بالثّراءِ يسُودُ كلُّ مُسوَّدٍ","مثر ولكن بالفعال يسود"],["7F91470C-E073-51CE-A291-75AA724C7CDD","بل لا أُكاثِرُ صاحبي في يُسرهِ","وأصُدُّ إذ في عيشِهِ تَصْريد"],["1CA349AC-E097-5A56-9F0D-A348F33A0618","فإذا غنيت فأن جاري نيله","من نائلي وميسري معهود"],["5032081D-31F6-58CA-8778-B3EF3435173F","وإذا افتقرْتُ، فلن أُرَى متخشَّعاً","لأخي غنى معروفه مكدود"]]},"C23B89D5-D33F-58C7-86FA-F6003B62CEF6":{"t":"مابي من عار إخال علمته","p":28,"s":"مابي من عار إخال علمته","r":"436648","v":[["5252DDB5-A322-5410-8A2F-3C6C768009DF","مابي من عار إخال علمته","سوىأن أخوالي نسبوا نهد"],["C0D8E50D-ED44-5BEE-86B9-D237D57AC197","إذا ما أردت المجد قصر مجدهم","فاعيا علي أن يقاربني المجد"],["117C52CC-3C80-5DDB-ABED-2931BF0D2113","فيا ليتهم لم يضربوا في ضربة","وأنيَ عبْدٌ فيهمُ، وأبي عبدُ"],["047FC96E-F939-5154-8B93-9200ED5F803E","ثعالب في الحرب العوان فإن تنج","وتَنفرِجِ الجُلّى، فإنّهمُ الأُسْدُ"]]},"89F186DB-26AE-50E2-927D-CBC56D7648B0":{"t":"هلاّ سألتَ بني عَيلانَ كلّهمُ","p":28,"s":"هلا سألت بني عيلان كلهم","r":"436644","v":[["AEFD4DBD-4B37-52AC-9867-62F0A3F96840","هلاّ سألتَ بني عَيلانَ كلّهمُ","عند السنين إذا ما هبت الريح"],["EB9112B1-382F-5D9A-80EC-EA46C58319E0","قد حان قدح عيال الحي إذ شبعوا","وآخر لذوي الجيران ممنوح"]]},"F16CD03D-33CC-5D8D-952E-A3F4ED525DE3":{"t":"وخِلٍّ كنتُ عينَ الرُّشدِ منه","p":28,"s":"وخل كنت عين الرشد منه","r":"436666","v":[["6077A289-5E7F-54DE-9D54-B6E1B07B44FD","وخِلٍّ، كنتُ عينَ الرُّشدِ منه","إذا نظرت، ومُستمعاً سَميعا"],["A2957239-65A1-53D3-B908-38CB7278D475","أطافَ بغَيّهِ، فعَدلتُ عنْه","وقلت له أرى أمراً فظيعاً"]]},"A94E7535-85F9-58DC-9ED9-47A10F779D26":{"t":"وقالوا احبُ وانهقْ لا تَضِيرُكَ خَيبرٌ","p":28,"s":"وقالوا احب وانهق لا تضيرك خيبر","r":"436660","v":[["4F42E19C-D1BF-54D2-9255-0B3469E5D583","وقالوا احبُ وانهقْ لا تَضِيرُكَ خَيبرٌ","وذلك من دين اليهود ولوع"],["CCFBBFBD-9A7C-5976-925D-EFB79EB91BBE","لعمري لئن عشرت من خشية الردى","نهاق الحمير إنني لجزوع"],["AC871FE5-2D10-5DC7-A0C7-A41ADA525CFD","فلا والت تلك النفوس ولا أتت","على روضةِ الأجدادِ، وهي جميع"],["32EB059D-E5F1-59F1-AD57-DDDEDFB45C57","فكيف وقد ذكيت واشتد جانبي","سليمى وعندي سامع ومطيع"],["536ABACD-102B-5578-83EC-F36317A52924","لسان وسيف صارم وحفيظة","ورَأيٌ لآراءِ الرّجال صَرُوع"],["80F9A73B-F434-54D8-BA8A-D550E4E39B40","تخوفني ريب المنون وقد مضى","لنا سلَفٌ: قيسٌ، معاً، وربيعُ"]]},"272EF189-F5D2-529C-A6C5-71E177AAC6F2":{"t":"ونحن صَبَحنا عامراً إذ تمرّسَتْ","p":28,"s":"ونحن صبحنا عامرا إذ تمرست","r":"436657","v":[["602D99ED-661D-5AB6-B4DD-0160BC7BA1BA","ونحن صَبَحنا عامراً، إذ تمرّسَتْ","عُلالةَ أرمَاحٍ وضَرباً مذكَّرا"],["6E268929-F4DC-5BD3-B7B9-DE1A704C7480","بكل رقاق الشفرتين مهند","ولَدْنٍ من الخطّيّ، قد طُرّ، أسمرا"],["9E9D719B-E3DE-576A-A58C-2378F1738162","عجبت لهم إذ يخنقون نفوسهم","ومقتلُهم، تحتَ الوغى، كان أعذرا"],["E8C47D0B-FE34-53BF-B791-F2A3E2B29886","يشدُّ الحليمُ منهمُ عَقدَ حبلِه","ألا إنما يأتي الذي كان حُذّرا"]]}}}