{"v":1,"poems":{"7B761FBE-FE3D-5430-A06B-356BFC8F27D5":{"t":"يا منْ لعبتْ بهِ شمولٌ","p":182,"s":"يا من لعبت به شمول","r":"464233","v":[["2D9DA89B-4C0F-5A1C-8F13-BB5C14473BFE","يا منْ لعبتْ بهِ شمولٌ","ما ألطفَ هذهِ الشمائلْ"],["720E7D4A-6417-5C09-A479-2A5547F59A6A","نَشوانُ يَهُزّهُ دَلالٌ","كالغُصْنِ معَ النّسيمِ مائِلْ"],["0FCCD973-80CB-5741-B486-BB8B1A23C756","لا يمكنهُ الكلامُ لكنْ","قد حَمّلَ طَرْفَهُ رَسائِلْ"],["15CD62AB-4B50-5841-81C9-12BC055AF8B7","ما أطْيَبَ وَقتَنا وأهْنَى","والعاذلُ غائبٌ وغافلْ"],["B5318B8D-7000-555A-97A9-AA965D904296","عِشْقٌ وَمَسَرّةٌ وَسُكْرٌ","والعقلُ ببعضِ ذاك ذاهِلْ"],["63F7E775-3603-5C7A-8352-1044238D8955","والبدرُ يلوحُ في قناعٍ","والغصنُ يَميلُ في غَلائِلْ"],["C0A3F72E-4398-5BBB-8B15-4FEA8D07E1C9","والوردُ على الخدودِ غضٌّ","وَالنّرْجسُ في العيونِ ذابِلْ"],["3D153E1B-D47A-5EEC-B6F1-967FC5D4C0AC","وَالعيشُ كمَا نُحبّ صافٍ","والأُنسُ بمَا نُحبّ كامِلْ"],["F2BEEF26-5ECB-551B-AC83-A2956637599A","مَوْلايَ يُحَقّ لي بأنّي","عن مِثلِكَ في الهوَى أُقاتِلْ"],["D520CC75-B379-56A5-A959-538B5C920CDA","لي فيكَ وَقد عَلِمتَ عِشقٌ","لا يَفهَمُ سِرَّهُ العَواذلْ"],["0B8A7617-BCE2-5365-83FC-636107EF0F0E","في حبكَ قد بذلتُ روحي","إنْ كنتَ لِما بَذَلْتُ قابِلْ"],["0224115D-4E49-5079-A600-4A2AA26BD8AB","لي عندكَ حاجةٌ فقل لي","هل أنتَ إذا سألتُ باذلْ"],["670E528F-F5E3-5389-98B1-C8792CE5EC4C","في وجهكَ للرضى دليلٌ","ما تَكذِبُ هذه المَخَائِلْ"],["3C1CA581-497A-533F-946A-1D5CDF2A9A6C","لا أطلُبُ في الهَوَى شَفيعاً","لي فيكَ غِنًى عن الوَسائِلْ"],["431C6BF9-E2D6-505E-8C4C-CAE0E23047A1","ذا العامُ مضى وليتَ شعري","هل يرجعُ لي رضاكَ قابلْ"],["DE7086F0-9041-5DB4-9485-47088DD82D58","ها عبدكَ واقفٌ ذليلٌ","بالبابِ يَمُدّ كَفّ سائِلْ"],["9EB5786D-D479-539D-AB79-15306D84E79B","من وَصْلِكَ بالقَليلِ يرْضَى","الطلُّ منَ الحبيبِ وابلْ"]]},"0DB0D6C1-2499-5736-9467-E6A2B416F3DC":{"t":"يا مَنْ تَجَنّنَ عامِداً","p":182,"s":"يا من تجنن عامدا","r":"464425","v":[["662D9F82-5A23-549E-B2F4-1B66678F6A94","يا مَنْ تَجَنّنَ عامِداً","وَأُريدُ أُذْهِبُ جَنّهُ"],["C4A009F0-07E6-515C-93F3-3ADF4E275D08","وعلمتُ ما قد قالهُ","عني وما قد ظنهُ"],["0C05538C-1D4D-57DA-AD36-825C1E254167","وسمعتُ عنهُ بأنهُ","يغتابني وبأنهُ"],["7C82277A-20C1-519B-B04C-6ED5419643CF","وكأنهُ كلبٌ عوى","لا بَلْ أقولُ بأنّهُ"],["C498712E-9A56-5DC7-B505-DD311F8BCAB5","فلأكوينّ جبينهُ","وَسْماً وَأقْطَع أُذْنَهُ"],["D7FF167C-7199-5AEB-A256-45EB6456D1A0","وأكونُ كلباً مثلهُ","إنْ لم أُصَدّقْ ظَنّهُ"],["069D7D94-B1D4-5974-897A-EEDD6042A081","لَوْ كانَ أهْلاً للجَميـ","ـلِ تركتهُ لكنهُ"]]},"80F03764-0011-5B26-811F-0FFAAFF4E6EC":{"t":"يا مَنْ يُكَلّمُنَا حَتى نُكَلّمَهُ","p":182,"s":"يا من يكلمنا حتى نكلمه","r":"464040","v":[["3BCB6F59-5698-5076-903E-EB8900D0CEF0","يا مَنْ يُكَلّمُنَا حَتى نُكَلّمَهُ","كم يُعرِضُ النّاسُ عنه وَهوَ يعترِضُ"],["A6D5E02D-02E3-5BC5-8915-FF1C3DCA8B6B","لقد بسطتكَ حتى رحتُ منبسطاً","إنّ الكريمَ عنِ الفحشاءِ ينقبضُ"],["D6076273-6133-5B2D-ADE6-AB5B6037E88E","لمن أُخاطِبُ لا خَلْقٌ وَلا خُلُقٌ","ومنْ أعاتبُ لا عرضٌ ولا عرضُ"]]},"7B5DE24D-28C5-5107-8022-4B1FEB207603":{"t":"يا مُحييَ مُهجَتي وَيا مُتْلِفَها","p":182,"s":"يا محيي مهجتي ويا متلفها","r":"464108","v":[["2492A242-761A-58AA-992B-27C38B20E3A8","يا مُحييَ مُهجَتي وَيا مُتْلِفَها","شكوَى كلَفي عَساكَ أن تكشِفَهَا"],["1E9E7EC7-5946-5D25-9B31-98455C17CFB1","عينٌ نَظَرَتْ إليكَ ما أشرَفَهَا","روحٌ عرفتْ هوالك ما ألطفها"]]},"53250EFA-8C35-536B-AB62-49AB5698BE83":{"t":"يا مُعْرِضاً مُتَجَنّباً","p":182,"s":"يا معرضا متجنبا","r":"464325","v":[["3EF9B612-FF05-5095-BA02-6C3D1E7D102A","يا مُعْرِضاً مُتَجَنّباً","حاشاكَ من نقضِ الذمامِ"],["48FF619A-1203-5397-9B03-F451C828A664","مَوْلايَ ما لكَ قد بخُلْـ","ـتَ عليّ حتى بالكَلامِ"],["F2CFE180-F082-5B79-B2D5-D74BA1EC90C8","هذا الذي ما كنتُ أحـ","ـسَبُ أنْ أراهُ في المَنَامِ"],["37576A75-B4CD-5C16-9F2E-BBF413053AA8","سَلّمْ عَليّ إذا مَرَرْ","تَ فَلا أقَلّ مِنَ السّلامِ"],["EC9DE4E0-95CB-5F06-98D3-64A103EAAF8F","ما لي أظنّ بكَ الوفا","ءَ وأنتَ من بعضِ الأنامِ"],["DA23C5BE-FF78-524A-BE63-7A76684B7B50","الغَدْرُ في كلّ الطّبا","عِ فَلا أخُصّكَ بالمَلامِ"],["D4B0B087-432F-537C-93DF-AEE1954674A9","ما أكثرَ العذالَ في","وَلهي عَلَيكَ وَفي غَرامي"],["F2B67672-04AF-5AA2-BB1C-FB7542DBB6BB","هَبْني كَتَمْتُهُمُ هَوَا","كَ فكيفَ أكتمهم سقامي"]]},"26F8D6D2-9880-5960-821D-DBA02F2791E1":{"t":"يا مُعْرِضاً مُتَغَضِّباً","p":182,"s":"يا معرضا متغضبا","r":"463774","v":[["B2BD2373-D040-5A42-B0C3-F4EDAF7F7573","يا مُعْرِضاً مُتَغَضِّباً","حاشاكَ يا عيني وروحي"],["42E62CB7-F36F-57DD-B276-0B5873172343","لم تدرِ ما فعلَ البكا","ءُ عليكَ بالجفنِ القريحِ"],["84CF37BA-8C62-57C9-B9BE-8293CCB71C93","وجَرَحْتَ قَلبي بالجَفَا","ءِ فآهِ للقَلبِ الجَريحِ"],["A29687F8-E104-575D-9412-3016309168DA","قَبَّحتَ فيّ بمَا فَعَلْـ","ـتَ ولستَ من أهل القبيحِ"],["5242FF51-D834-525E-AB56-B50C28DE6D6C","إنْ كنتَ مني مستريـ","ـحاً لستُ منكَ بمستريحِ"],["B442592F-9161-547C-ADBA-8ADE311AFBA6","فمتى أفوزُ بنظرةٍ","من وجهكَ الحسنِ المليحِ"],["3DC7AF05-3682-5D28-A76B-9224E466059E","لكَ في ضَميرِي ما علمْـ","ـتَ بهِ من الودّ الصريحِ"],["444002E6-C5DA-5CE9-930E-6389EB9CAFEC","وكذاكَ أنتَ فَسَلْ ضَميـ","ـرَكَ فهوَ يشهدُ بالصّحيحِ"]]},"C0AA3804-81FF-5546-870A-4976CE8CB533":{"t":"يا مُغرَماً بالسُّمْرِ مَا","p":182,"s":"يا مغرما بالسمر ما","r":"464078","v":[["77E5049D-EE0C-5AE0-86B7-38726948420F","يا مُغرَماً بالسُّمْرِ مَا","أنا فيهِمُ لكَ مُتّبِعْ"],["058C2326-E31D-5F2C-9922-67AE6F844EC0","لكِنْ على حُبّ الحِسا","نِ البيضِ قلبي قد طُبعْ"],["E742C4B0-64DC-5F22-9526-D60FA45ED50C","الحقُّ أبيضُ أبلجٌ","وَالحَقّ أوْلى ما اتُّبعْ"]]},"F521D977-B907-5778-A256-C80B615A9AFD":{"t":"يا مُوليَ النّعمَاءِ إنّيَ شاكِرٌ","p":182,"s":"يا مولي النعماء إني شاكر","r":"464327","v":[["36620EA8-9739-5DD6-A826-B7E608EE3179","يا مُوليَ النّعمَاءِ إنّيَ شاكِرٌ","والشّكْرُ حَقٌّ وَاجبٌ للمُنعِمِ"],["9FB65CBB-26C4-5FE9-9720-6DC8C274967C","فلَئِنْ تكُنْ ملأتْ عَوَارِفُهُ يَدي","فلأملأنّ بشكرها أبداً فمي"],["17C3EE59-03BC-559C-AD48-F03B4BF6D1AD","ولقد شكرتُ وإنما إحسانهُ","مُتَقَدّمٌ وَالفَضْلُ للمُتَقَدّمِ"]]},"8D2651B3-A7E6-5F65-8ABD-9915BACB91AA":{"t":"يا هاجري يحقّ لكْ","p":182,"s":"يا هاجري يحق لك","r":"464173","v":[["44EEFC7B-05F4-5B0F-B239-7BC44BD082AE","يا هاجري يحقّ لكْ","وجدتُ غيري شغلكْ"],["9307DFD2-10F9-5BC4-B9B6-4A462D6675AD","مَوْلايَ لا طالَبَكَ اللّـ","ـهُ بمَا لي قِبَلَكْ"],["60C0169C-1025-5E10-96F6-75CAE95380A0","كيفَ أطعتَ حاسداً","على تَلافي حَمَلَكْ"],["6C05B3DA-AB1B-5D2A-9083-91EC2934573F","وَمَنْ بحَقّ الله عَنْ","مَذهَبِ وُدّي نَقَلَكْ"],["7977E912-26A6-5E52-B254-E7D93EE5B97E","وَيْلاهُ يا قَلبُ إلى","داعي الهوى ما أعجلكْ"],["9CFAF0E7-4A69-56F4-B7D9-45884690390B","فليتني لوْ كانَ لي","يا قلبُ قلبٌ بدلكْ"],["A7BCF4CE-6BAD-5BBC-99AB-8D02ADA639E4","ويا لسانَ الدمعِ في","شرحِ الهوى ما أطولكْ"],["E3FEF809-74FC-5625-99DD-C3ECE203EE73","ما تشتكي يا ناظري","أليسَ هذا عملكْ"],["397C6064-0D05-5383-8484-E9DAB52AB237","يا أيّهَا السّائِلُ عَنّـ","ـي لا تَسَلْ عَمّنْ هَلَكْ"],["6E40E274-01C4-5E68-B9DA-BF9D0B332846","بِتُّ بِلَيْلٍ باتَهُ","كلُّ عدوًّ لي ولكْ"]]},"BBF9FE3B-D96F-5702-B9C7-7FFA88CB1810":{"t":"يا هذهِ لا تغلطي","p":182,"s":"يا هذه لا تغلطي","r":"463978","v":[["234A2B6C-58B2-59AD-B92F-AB1713CF8991","يا هذهِ لا تغلطي","وَالله ما لي فيكِ خاطِرْ"],["BC0C839A-055A-56D0-B498-3146268653A7","خَدَعوكِ بالقَوْلِ المُحا","لِ فصَحّ أنّكِ أُمُّ عامرْ"],["8756DD13-0C1F-543D-9981-6148DB459DDA","أظننتِ لي قلباً على","هذي الحَماقةِ منكِ صابرْ"],["D3E00186-284D-5551-A0D2-2E3432E572C3","وسمعتُ عنكِ قَضِيّةً","قد سودتْ فيها الدفاترْ"],["09C5C5BD-FC0C-5521-99C5-CF4E39FFA7FD","نُقِلَتْ إليّ جَميعُها","حتى كأني كنتُ حاضرْ"],["35E4F1EB-5EE2-5602-9A80-CB391AC13ABB","فمتى أردتِ شرحتها","لكِ بالدلائلِ والأمائرْ"],["46814006-C81E-5C50-A299-7F427271771B","إنْ كنتِ أنتِ نسيتها","فلكم لها في الناسِ ذاكرْ"],["EFCC0879-0886-5362-A9BD-110F191674DE","وسألتُ عنكِ فلمْ أجدْ","لك في جميعِ الناسِ شاكرْ"],["9CD8A24E-3E74-59C4-9A69-5F9BD6BD9E2B","وزعمتِ أنكِ حرةٌ","ما هذه شيمُ الحرائرْ"],["BCA26CB8-9189-5752-A58A-D0DA7D0D1879","فإذا كَذَبْتِ فَلا يكُنْ","كَذِباً لكُلّ النّاسِ ظاهرْ"]]},"EC210FF5-2531-5B25-A339-F469D019FCFC":{"t":"يا واحداً ما كانَ لي غَيرُهُ","p":182,"s":"يا واحدا ما كان لي غيره","r":"463958","v":[["5BBB6ED7-F95A-5931-B7CB-98F3A5F0BD2C","يا واحداً ما كانَ لي غَيرُهُ","بَعدَكَ وا قلّةَ أنصارِي"],["0CCE0DE2-FE46-5FBC-93CF-3C828495FFE5","يا منتهى سؤلي ويا مشتكى","حزني ويا حافظَ أسراري"],["CF9D05F4-611F-55D3-BD57-C6E570EEF272","الدارُ من بعدكَ قد أصبحتْ","في وحشةٍ يا مؤنسَ الدارِ"],["2FDBD466-2230-54CA-9FD9-F66B57FA9640","إنْ كنتَ قد أصْبَحتَ في جَنّةٍ","إني من فقدكَ في نارِ"],["960E4435-4EB9-5C9C-A47B-28D298E2C5F6","جارُكَ قَلبي كيفَ أحرَقتَهُ","وَالله أوْصَى الجارَ بالجارِ"]]},"37E6435B-1DAC-5348-B676-0B689B28E4F0":{"t":"يبشرني منكَ الرسولُ بزورةٍ","p":182,"s":"يبشرني منك الرسول بزورة","r":"463805","v":[["B652752A-EA78-5918-90F0-4F42A3AAD18E","يبشرني منكَ الرسولُ بزورةٍ","فإنْ صحّ هذا إنني لسعيدُ"],["64990562-E485-5BD1-9858-D68C76A9DDE6","ولَستُ إخالُ الدّهرَ يَسخو بهذه","ألا إنها من فعلهِ لبعيدُ"],["81E29677-6D53-5047-8B03-1E5F4B343324","فيَا أيّها المَولى الذي أنا عبدُه","لقد زاد بي شوقٌ إليكَ شديدُ"],["B65C6775-C386-553C-AF5B-7E83C7CEE0D2","متى تَتَمَلّى منكَ عَيني بنَظرَةٍ","وحقكَ ذاكَ اليومُ عندي عيدُ"]]},"EDA18A6E-C01F-5961-BEC8-98F10EE118A0":{"t":"يحدثني زيدٌ عن البانِ والحمى","p":182,"s":"يحدثني زيد عن البان والحمى","r":"463695","v":[["AD859F04-5961-5DF7-951D-AABA62CA753C","يحدثني زيدٌ عن البانِ والحمى","أحاديثَ يَحلو ذِكرُها وَيَطيبُ"],["31940DD7-379B-5CF6-AE7F-8F2027544389","فقلتُ لزيدٍ إنها لبشارةٌ","وإني لنشوانٌ بها وطروبُ"],["A5CD06A6-DF1A-5903-807E-7F216F08417A","ويا زيدُ زدني من حديثكَ إنهُ","حَديثٌ عَجيبٌ كلّهُ وَغرِيبُ"],["8546B698-A31D-55A7-86E2-4A77BB0435AF","ودعني أفزْ من مقلتيكَ بنظرةٍ","فعهدُهما ممّنْ أُحبّ قريبُ"]]},"2C97DB54-87BA-539D-96AC-1E3652475294":{"t":"يطيبُ لقلبي أن يطولَ غرامهُ","p":182,"s":"يطيب لقلبي أن يطول غرامه","r":"464283","v":[["5497B593-B008-5FE8-A512-CF0F7E3C4AD1","يطيبُ لقلبي أن يطولَ غرامهُ","وَأيْسَرُ ما ألْقاهُ منهُ حِمامُهُ"],["65360BA9-0D55-5E19-B043-796E45E98701","وأعجبُ منهُ كيفَ يقنعُ بالمنى","ويرضيهِ من طيفِ الحبيبِ لمامهُ"],["AF559281-F647-58D1-8877-5ED65E8ADAB4","تَعَشّقْتُهُ حُلْوَ الشّمائِلِ أهْيَفاً","يحركُ شجوَ العاشقينَ قوامهُ"],["7BFE40D6-5C07-5A7B-9C5C-BDD6FF5DC3F2","وهمتُ بطرفٍ فاتنٍ منهُ فاترٍ","لِبَابِلَ مِنْهُ سِحرُهُ وَمُدامُهُ"],["80352EB9-1F64-515A-AE90-EB7684FB21E8","فَما الغُصْنُ إلاّ ما حوَتْهُ بُرُودُهُ","وَما البَدْرُ إلاّ ما حَواهُ لِثَامُهُ"],["02AC15D5-1D86-5270-91DA-D3A375DFE30F","أغارُ إذا ما راحَ ريانَ عاطراً","أرَاكُ الحِمى من ريقِهِ وبشَامُهُ"],["281C77D1-E17E-52A3-A595-80AB23A92A98","وأرتاعُ للبرقِ الذي منْ ديارهِ","فيَحسِبُ طَرْفي أنّ ذاك ابتسامُهُ"],["0AFF15F1-C17B-5DBF-B776-0B6E50AD11A4","وَأستَنشِقُ الأرْواحَ من كلّ وُجهةٍ","فأعْلَمُ في أيّ الجِهاتِ خِيامُهُ"],["C73CED17-8BF6-5C34-AAC9-219C35B3B01C","خذوا لي منَ البدرِ الذمامَ فإنهُ","أخوهُ لعليّ نافعٌ لي ذمامهُ"],["A837DBFF-C16D-59A1-B258-A1D7AD6C9433","إلى العادِلِ المأمونِ للدّهرِ إن سطَا","بهِ يتجلى ظلمهُ وظلامهُ"],["798DFBCA-19BE-55DD-8A52-41C47FC6CB8F","إلى مَلِكٍ في العَينِ يَملأ سَرْحَةً","وَيَمْلأ آفاقَ البِلادِ اهتمامُهُ"],["81D6C9C1-9F24-5CE0-B565-94336CDF0E5C","أخو يقظاتٍ ليسَ يعرفُ طرفه","غراراً سوى ما يحتويهِ حسامهُ"],["36D852CD-FC5E-5175-941E-FB90F3FEF268","يُقَصّرُ عَنهُ المَدحُ من كلّ مادحٍ","ولوْ كانَ من زهرِ النجوم نظامهُ"],["46F9A5AB-AA55-500C-99D0-7053727241A0","فيا مَلِكَ العَصرِ الذي ليسَ غيرُهُ","يُرَجّى ويُخشَى عَفْوُهُ وانتِقامُهُ"],["62D54DC8-5550-5A21-A063-F0A3FAF73997","تقدمَ ذكرُ الجودِ قبلك في الورى","وأصبحَ من ذكراكَ مسكاً ختامهُ"],["437B9EF4-5F0E-50C9-8133-3077412E125B","أمنتُ بلقياكَ الزمانَ صروفهُ","فغَيري مَن يُخشَى عليه اهتِضامُهُ"],["9761B705-B24B-5A25-A10E-DA5AFC7F5B8B","وَأصبَحتُ من كلّ الخطوبِ مسلَّماً","علَيكَ من الله الكَريمِ سَلامُهُ"]]},"4B4E8577-17ED-5FCB-A11C-C596FF811B2B":{"t":"يعاهدني لا خانني ثمّ ينكثُ","p":182,"s":"يعاهدني لا خانني ثم ينكث","r":"463754","v":[["11CC92EC-7B45-5BE5-AF4F-80D90CFCBFCB","يعاهدني لا خانني ثمّ ينكثُ","وَأحْلِفُ لا كلّمتُهُ ثمّ أحنَثُ"],["631A2E8E-0D39-5321-B562-E88AC2A484CF","وَذلكَ دَأبي لا يزالُ ودَأبُهُ","فيا مَعشرَ النّاسِ اسمعوا وتحدّثوا"],["AF84E5B6-0E9A-5534-B2AE-7747EEE599F8","أقولُ لهُ صلني يقولُ نعم غداً","ويكسرُ جفناً هازئاً بي ويعبثُ"],["B26B16EE-1550-59A2-9CF0-7A7BD35F872E","وما ضرّ بعضَ النّاس لو كان زارَنا","وكنا خلونا ساعةً نتحدثُ"],["BE22ADAA-EA67-53B8-8266-29E177CCDC94","أمولايَ إني في هواكَ معذبٌ","وَحَتّامَ أبقى في العذابِ وأمكُثُ"],["F69186A4-852F-53DF-969F-F97F26A37ED7","فخذْ مرةً روحي ترحني ولم أكن","أموتُ مراراً في النهارِ وأبعثُ"],["E6C17C96-1B67-50CA-A536-20DA20713D49","وإني لهذا الضيمِ منكَ لحاملٌ","ومُنتَظِرٌ لُطفاً من الله يَحدُثُ"],["33FA0619-7F0E-5E97-8D02-A69225646A46","أُعيذُكَ من هذا الجَفاء الذي بدا","خَلائِقُكَ الحُسنى أرَقُّ وَأدمثُ"],["782446F0-A057-5BDF-8BF5-7217FCD8DCA1","ترَدّد ظنُّ النّاسِ فينا وَأكثروا","أقاويلَ منها ما يطيبُ ويَخبُثُ"],["2011A715-9451-53C3-8027-5D866E72379B","وقد كرُمتْ في الحبّ مني شمائلي","ويسألُ عني من أرادَ ويبحثُ"]]},"71F477E8-2B25-56A5-94B0-FE5F9BE12509":{"t":"يعزّ عليّ فقدكَ يا عليُّ","p":182,"s":"يعز علي فقدك يا علي","r":"464488","v":[["083B88CE-79DE-5F88-9125-1B1CE0E59223","يعزّ عليّ فقدكَ يا عليُّ","ألا للهِ ذا الأجلُ الوحيُّ"],["E5F576A2-94B0-54FC-88D7-29D0FAE7330E","تكَدّرَ فيكَ صَافي العيشِ لمّا","عَدِمتُكَ أيّها الخِلُّ الصَّفيّ"],["258C0192-0CD9-54C9-A268-CD377E4E2709","لَئِنْ أخلَيْتُ منكَ مَحلّ أُنسِي","فما أنا فيكَ منْ أسفٍ خليّ"],["24A87B53-B77B-5A55-B137-EC854C1FC1F9","فبَعدَكَ لَيسَ يُفرِحُني بَشيرٌ","وبعدكَ ليسَ يحزنني نعيّ"],["1BCAFDE5-ADC3-58F5-9D2A-CAD18AFC814A","ولو كانَ الرّدى بَشَراً سَوِيّاً","لهابكَ أيها البشرُ السويّ"],["5363972D-1ABC-5E29-8F28-20B8EAEDF3CD","عصَاني الصّبرُ بعدك وَهْوَ طوْعي","وطاوعَ بعدكَ الدمعُ العصيّ"],["6309C7DE-615B-5B1C-9C2D-593B54428265","وهلْ أبقتْ لي الأيامُ دمعاً","فيُسْعِدَني بهِ الجَفْنُ الشقيّ"],["C85042F5-7882-524C-8C16-8D0536F5A555","فيا جَزَعي تَعَزَّ فليسَ صَبرٌ","ويا ظمإي تَسَلّ فلَيسَ رِيّ"],["358FD01C-62BA-5934-A716-DCF577BCDB72","أتمضي أنتَ منفرداً وأبقى","لقد غَدَرَتكَ نَفسُكَ يا وَفيّ"],["E86C98CF-C877-5D82-9D05-EC07D9BFD29B","فهل حقٌّ حياتكَ يا زهيرٌ","وهَلْ حَقٌّ وَفاتُكَ يا عَليّ"],["6C8B46D8-276D-57CB-B3F7-5ED19A1F4105","وَحَقّاً صارَ ذاكَ البَحرُ يُبْساً","وصوحَ ذلكَ الروضُ البهيّ"],["B4B3AAFC-E1D9-567E-8EE8-6585028DFF95","وَأقْلَعَ ذلكَ الغَيثُ المُرَجّى","فلا الوسميُّ منهُ ولا الوليُّ"],["2A2CDB49-B678-5CD6-AA78-88F1296A8501","لقد طَوَتِ الحَوادِثُ منهُ جسماً","وليسَ لذكرهِ في الناسِ طيّ"],["42313B7A-AA3B-5078-8CAD-5A8E1AF6F353","مَضَوْا بسَريرِهِ وَعَلَيْهِ نُورٌ","جليٌّ تحتهُ سرٌّ خفيّ"],["9FE562DF-FBFF-5D0B-860A-082ACC81A1BD","وفي أكْفانِهِ نَدْبٌ سَرِيٌّ","تَخَلّفَ بَعدَهُ ذِكْرٌ سَنيّ"],["F0D1CBD9-EAA5-550A-B215-6BB83942E4ED","على حينَ استَفاضَ الذّكرُ عنهُ","وحينَ أتى كما اندفعَ الأتيّ"],["C833FF4D-1786-59A0-A0BB-47954D8570A2","وكمْ درتْ مكارمهُ لعافٍ","كما درتْ لأطفالٍ ثديّ"],["1B7399A1-65BF-568B-9C91-85301BE53BB7","وكمْ أروى على ظمإٍ نداهُ","سَقاه هاطِلُ الغَيثِ الرّوِيُّ"]]},"E79D2A65-CA52-5E9E-87F9-AEEAB3062F77":{"t":"يقبلُ الأرضَ وينهي إلى","p":182,"s":"يقبل الأرض وينهي إلى","r":"464154","v":[["4BA9A2C0-A5EA-5B47-834E-B767BE4C0FC3","يقبلُ الأرضَ وينهي إلى","مالِكِهِ شِدّةَ أشْوَاقِهِ"],["C7983827-430F-532F-AA55-1FB984A49D45","ما غيرَ البعدُ سوى جسمهِ","ولم يغيرْ صفوَ أخلاقهِ"],["C8C73B06-892A-506E-9377-BACCAC2AA24F","فابكِ على الصّبّ الغريبِ الذي","قد أمسكَ البينُ بأطواقهِ"]]},"9E25C119-19EB-52A3-8C2D-067F401F830E":{"t":"يَغيبُ إذا غِبتَ عني السّرُورُ","p":182,"s":"يغيب إذا غبت عني السرور","r":"464020","v":[["382715D6-691B-5B06-878A-4BC67421BC0E","يَغيبُ إذا غِبتَ عني السّرُورُ","فلا غابَ أنسكَ عن مجلسي"],["93026CE0-F771-5D07-A4C6-F2862C02AC62","فكَمْ نُزْهَةٍ فيكَ للنّاظرينَ","وكم راحةٍ فيكَ للأنفسِ"],["F9972F1B-8F8A-5044-930B-5FA770EE6D1D","فيَا غائِباً لَوْ وَجَدْنَا إلَيْـ","ـهِ سبيلاً مشينا على الأرؤسِ"],["B2B933DD-D2CD-517D-A23A-7A4C4DB57E03","على ذلِكَ الوَجهِ منّي السّلامُ","ولا أوحشَ اللهُ من مؤنسي"]]},"465CD936-A987-5F9E-AF32-71578F79D113":{"t":"يُهَنّئُكَ المَمْلُوكُ بالعَشْرِ وَالشّهرِ","p":182,"s":"يهنئك المملوك بالعشر والشهر","r":"463984","v":[["8728666A-5F8B-5D4A-B687-C4952153001B","يُهَنّئُكَ المَمْلُوكُ بالعَشْرِ وَالشّهرِ","وبالعيدِ عيدِ النحرِ يا ملكَ العصرِ"],["C3DF3B22-199E-54A4-AFD9-D3E22671EAF2","وَيُنْهي إلى العِلْمِ الشّرِيفِ بأنّهُ","على قدمِ الإخلاصِ في السرّ والجهرِ"],["86CDF1CD-2D54-54AF-A546-87AF83B9EC5B","وها أنا ذا أدعو لكَ اللهَ دائماً","معَ الصّلَوَاتِ الخَمسِ وَالشّفعِ وَالوِترِ"],["01AB0966-9895-538E-A05C-37F0889D68CC","وآمُلُ أنّي إنْ أعِشْ لكَ مُدّةً","ستبقى لكَ الأيامُ في طيبِ الذكرِ"],["60847AD3-C494-5337-A860-BE21E2B482F9","وَإنّي لأرْجو أنّ جودَكَ شامِلي","قريباً على قدَرِ اهتمامِكَ لا قَدرِي"],["FD1CCF87-D58F-59A4-9A59-607351C0DD46","وإنكَ إنْ أوليتني منكَ أنعماً","فإني مليٌّ بالدعاءِ وبالشكرِ"],["9800A4BE-E398-50DE-90EA-BDAB65C6A57A","تشدّ بها أزري وتقوى بها يدي","تعزّ بها قدري تزيدُ بها وقري"],["924B4FA4-1CEA-5FAA-A6A2-F0EC29099640","لَعَلَ الذي في أوّلِ العُمرِ فاتَني","تعوضنيهِ أنتَ في آخرِ العمرِ"],["62490805-108C-5CF1-BB75-4B399D1C36CC","وَيا لَيتَ أعمارَ الأنامِ لَكَ الفِدَا","وَأوّلُهُمْ عُمري وَأسبَقُهمْ ذِكرِي"]]}}}