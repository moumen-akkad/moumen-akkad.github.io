{"v":1,"poems":{"544E0AE1-6D87-5ECB-8476-C8AFDD71CE5C":{"t":"أتيتُ الفَيْضَ مُشْتَكِياً زماني","p":0,"s":"أتيت الفيض مشتكيا زماني","r":"477776","v":[["1852CCA2-A2AA-5C31-B1FD-1BD109E58429","أتيتُ الفَيْضَ مُشْتَكِياً زماني","فأَعْدَاني عليه جُودُ فَيْضِ"],["04B49F96-24CF-5625-8D3B-F3EEC19DB127","وفاضتْ كَفُّه بالبذلِ منه","كما كَفُّ ابن عيسى ذات غَيْضِ"]]},"105AD925-8017-5101-8920-34F1D4DA291D":{"t":"أعْدُو على مالِ بسْطامٍ فأنهْبَهُ","p":0,"s":"أعدو على مال بسطام فأنهبه","r":"477770","v":[["ACD4FC37-192A-5A66-97F0-5226FA88383A","أعْدُو على مالِ بسْطامٍ فأنهْبَهُ","كما أشاءُ فلا تُثنَى إلىّ يديِ"],["3A9F3076-79C5-5DC4-B159-5BC723109784","حتى كأنّي بِسْطامٌ بما احتكمتْ","فيه يَداي وبسطامٌ أبو الأَسَدِ"]]},"F1E228DC-4B74-5AD3-8BDA-6B08265AF3A6":{"t":"أنتَ أمرؤٌ غَثُّ الصَّنيَعةِ رثّها","p":0,"s":"أنت أمرؤ غث الصنيعة رثها","r":"477777","v":[["1FFFA2E6-89CD-59EC-9C4F-0DD3274EF69C","أنتَ أمرؤٌ غَثُّ الصَّنيَعةِ رثّها","لا تُحْسِن النُّعْمَى إلى أمثالي"],["C9F5859A-A0E3-5CC8-BDAB-A2D388E6B7DD","نُعْمَاك لا تَعْدُوك إلاّ في امرئ","في مَسْكِ مِثْلْكِ من ذوي الأشكالِ"],["B13E80D7-2A2C-5C9C-A4D2-68FCD4A5C4DF","وإذا نظرتَ إلى صَنيعك لم تَجدْ","أحَداً سَمَوْتَ به إلى الإفضالِ"],["50CB3B78-A6FD-56C7-914F-53258C6A2AE6","فاسْلَمْ بغير سَلاَمةٍ تُرجى لها","إلاّ لِسَدّكَ خَلَّة الأنذالِ"]]},"178A9C21-4F07-544A-A890-FDB97D251B9C":{"t":"أنِّي مررتُ بشاهينٍ وقد نَفَحتْ","p":0,"s":"أني مررت بشاهين وقد نفحت","r":"477779","v":[["6C3E39CB-CB3A-5458-BB6B-60E87973B7C2","أنِّي مررتُ بشاهينٍ وقد نَفَحتْ","ريحُ العَشِىِّ وبَرْدُ الثَّلج يُؤذيني"],["56A82C3E-8D46-575E-B062-ADAF012B9198","فما وَقى عِرْضَهُ مِنى بكسَوَتِه","لاَ بل ولاَ حَسَبٍ دانٍ ولا دينِ"],["9B476580-DFFF-5130-9F34-A2927E56ED00","إن لم يكن لَبَنُ الدَّاياتِ غَيَّرَهُ","عن طبع آبائه الشُّمِّ العَرانينِ"],["A69ECDAA-FED5-588A-8A83-9012285BF564","فَرُبَّما غابَ بعلٌ عن حَلِيلته","فناكها بعض سَوَّاسِ البَرَاذينِ"],["0A0E570D-6075-5E16-87A1-7C31949165F1","وما تَحرَّكَ أيرٌ فامتلا شَبقاً","إلاّ تَحَرُّك عِرْقٌ في است شاهينِ"]]},"14CAD96E-2404-5CDA-84CB-A00A19F21061":{"t":"تَولَّى المَوْصِلِيّ فقد تَوَلَّتْ","p":0,"s":"تولى الموصلي فقد تولت","r":"477780","v":[["5C54E9E4-D526-5045-81C5-E3991CE560C9","تَولَّى المَوْصِلِيّ فقد تَوَلَّتْ","بَشَاشاتُ المَزَاهِر والقيَانِ"],["5F96D987-DBA3-5810-AF7E-C2F1DFFC72FB","وأيُّ مَلاَحَةٍ بقيَتْ فَتَبْقى","حياةُ المَوْصِلي على الزَّمانِ"],["3AB355AB-1BCB-5272-AA35-3A909DD37C54","سَتْبكيهِ المَزَاهِرُ والمَلاَهي","وُيُسْعدُهُنَّ عاتقةُ الدَّنان"],["6D248F80-7193-53A0-8CA1-CCACD2CB5EB6","وَتبكِيهِ الغَوّيةُ إذ تَوَلَّى","ولا تبكيهِ تاليةُ القُران"]]},"DD9BDC5F-F3D4-5B7D-822E-4FD393A7B06F":{"t":"صُنْعٌ من اللهِ أَنّي كنتُ أَعْرِفكم","p":0,"s":"صنع من الله أني كنت أعرفكم","r":"477778","v":[["496B616F-BA44-577F-88FC-65DCB730D841","صُنْعٌ من اللهِ أَنّي كنتُ أَعْرِفكم","قبلَ اليَسَارِ وأنتمْ في التَّبابين"],["9AFA4BD4-02EF-5CDB-8F80-C3F105FD0791","فما مَضَتْ سَنةٌ حتى رأيتكُمُ","تَمْشُونَ في القَزَّ والقوُهِى واللَّينِ"],["7DBD4D03-3C19-5543-BA28-17E945093742","وفي المَشَاريق مازالتْ نساؤكمُ","يَصِحْن تحت الدَّوالي بالوَراشينِ"],["907699B9-715A-5878-83FC-5680910BC607","فصْرنَ يَرْفُلَنَ في وَشْي العِرَاقِ وفي","طرائِف الخزِّ من دُكْنٍ وطارُوني"],["22F6877C-8899-5A17-BA70-8F63B8DD6CCC","أُنْسينَ قطعَ الحُلاَوى من مَعَادِنها","وحَمْلَهُنَّ كَشُوثاً في الشَّقابينِ"],["0FBD26B0-BFAA-5A2E-940D-0E2E307A3CC4","حتىَ إذا أيسروا قالوا وقد كذبوا","نحن الشَّهاريجُ أولادُ الدِّهاقينِ"],["2847AE47-2719-5DB9-8955-29A7AF600714","في است أمِّ ساسانَ أيري إن أقربكم","وأير بَغْلٍ مُشِظٍّ في است شيرين"],["C0C7A5E9-818E-5FD6-BB53-DC6B9A51C9A5","لو سِيلَ أوْضَعُهُم قَدْراً وأنْذَلهم","لقال منَ فَخْرِه إنيِّ ابنُ شُوبينِِ"],["FD9A7741-3B77-58B3-8BD4-29A761C5F336","وقال أقطعني كِسْرَى ووَرّثني","فَمْن يُفَاخِرُني أم مَنْ يُنَاوِينَي"],["1E33B9ED-EFB3-51E7-BAC5-4CE4BDC84140","مَنْ ذا يُخَبِّر كِسْرَى وهو في سَقر","دعوى النَّبيطِ وهم بَيْضُ الشياطينِ"],["7475190C-2157-546D-81E8-051832D80120","وأنهم زعموا أنْ قد ولدتهُمُ","كما ادّعى الضَبّ أني نُطْفةُ النُّونِ"],["46D30611-71FB-5C70-A8DE-E7029AB6DB3E","فكان يَنْحَزُ جَوْفَ النار واحدةً","تَفْرِي وتَصْدَعُ خوفاً قلبَ قارونِ"],["58E94908-8916-5D86-99A2-94618AEDB31A","أَما تراهم وقد حَطّوا بَرادِعَهُمْ","عن أُتنهمُ واستبدُّوا بالبَرَاذينِ"],["3CA92853-9060-59D2-B0C3-B7A48EB82119","وأفرجوا عن مَشارات البُقول إلى","دُورِ المُلوك وأبواب السَّلاطِينِ"],["4DE198D4-0107-5F92-8DCB-DC55B18DD02B","تَغْلِي على العُرْب من غَيْظ مَراجلُهمُ","عداوةً لرسول اللهِ في الدينِ"],["DBDF8EA9-1370-5A8F-8BE1-E26C83601A46","فقَل لهم وهمُ أهلٌ لَتِزْنيَةٍ","شَرَّ الخَليقةِ يا بُخَرَ العَّثانينِ"],["76BDD73A-520F-5E56-B039-33B57DD0C0DB","ما النَّاسُ إلا نِزَارٌ في أَروَمتها","وهاشمٌ سُرجُهَا الشُّمُّ العَرَانينِ"],["AFA0A150-CE8A-5EDD-84C5-60A09104C2C5","والحَيُّ من سَلَفى قَحْطَان إنهم","يُزْرُونَ بالنَّبطِ اللّكنِ المَلاَعينِ"],["8C17456A-4FB9-5DC3-83A3-CBA37BC843CF","فما على ظهرها خَلْقٌ له حَسَبٌ","مما يُناسبِ كِسْرى غيرُ حَمُدونِ"],["8F414B68-613F-5D9A-AEFE-2B1E491A4ED5","قَرْمُّ عليه شهنشاهِيّةٌ ونَباً","يُنْبيكَ عن كَسرويّ الجَدِّ مَيْمُونِ"],["4081753E-7A6E-54AF-A23B-9C5D1D9B505B","وإن شككتَ ففي الإيوانِ صُورتُه","فانظُر إلى حَسَبٍ بادٍ ومخزونِ"]]},"7362217C-7187-58B9-9023-8D0974D8BE14":{"t":"فَلأَ نْظُرَنَّ إلى الجبال وأَهْلها","p":0,"s":"فلأ نظرن إلى الجبال وأهلها","r":"477774","v":[["1555BEEF-6976-5AAE-92F7-15506C8041AB","فَلأَ نْظُرَنَّ إلى الجبال وأَهْلها","وإلى مَنابرها بِطَرْفٍ أَخْزَرِ"],["B2A8B8B9-67B8-5801-A83C-1D3D6F01FFA6","مازِلْتَ تَرْكَبُ كلَّ شيءٍ قائِمٍ","حتى اجترأت على ركوب المنْبرِ"],["0D7C2000-5CEA-5662-A771-A1234835037B","مازال مِنْبَركَ الذي خَلَّفْتهُ","بالأمس منك كحائِضِ لم تَطْهُرِ"]]},"93FCDE90-3E13-5CE6-906D-C5CDBE519D19":{"t":"ليتَ شعري أضاقت الأرضُ عَنِّي","p":0,"s":"ليت شعري أضاقت الأرض عني","r":"477767","v":[["620E7914-AF79-5F1E-82DF-39041DB72EC4","ليتَ شعري أضاقت الأرضُ عَنِّي","أم نَفيٌّ من البلادِ طَريدُ"],["21A4553E-D062-557E-9DB0-F4875FB252E4","أم قُدَارٌ أم الَحبَابة أم أح","مرُ لاقت به البلاَء ثَمودُ"],["51488490-8BEC-5509-BCFB-193B592229E1","أم أنا قانعٌ بأدنى معاشٍ","هِمَّتي القُوتُ والقليلُ الزهيدُ"],["D1CA52BD-8257-5F6C-AE2E-EA40D8643B44","مِقْوَلي قاطعٌ وسيفي حُسَامٌ","ويدي حُرَّةٌ وقلبي شَديدُ"],["4DDCC29E-6DF9-5A77-AAFC-56C947FC55FA","رُبَّ بابٍ أعزَّ من بابك اليَوْ","مَ عليه عسَاكرٌ وجنودُ"],["B6598E3F-959C-51E9-9133-A092AC4D98C5","قد وَلجناهُ داخلينَ غُدّواً","وَرواحاً وأنت عنه مَذوذٌ"],["9A2745BE-30B5-531E-8501-6E2C491E735C","فاكْفُف اليومَ من حِجَابكَ إذ لَسْ","تُ أميراً ولا خميساً تقودُ"],["DB8DD3A3-B29C-575E-B078-5E2D7607998D","لَنْ يُقيمَ العَزيزُ في البلد الهُو","ن ولا يكسَدُ الأديبُ الجَليدُ"],["EB9C8865-28F7-5910-BFE6-165BF1AD06DA","واغْتربْ في فدافد الضدِّ إذ لس","تُ أسيراً ولا عليّ قُيُودُ"],["7DCFEDF9-DE7C-5418-95EB-950389AEB164","كل مَنْ فرّ هَوانٍ فإن ال","رُّحتِ ملقاه والفضاء العتيدُ"]]},"F4CCA419-ABE4-548C-BE6A-BC4FB09521BD":{"t":"لَيتكَ إذْ نُبتْني بواحدةٍ","p":0,"s":"ليتك إذ نبتني بواحدة","r":"477768","v":[["013B16BC-0622-50B0-A867-0AA2603DC6C3","لَيتكَ إذْ نُبتْني بواحدةٍ","تُقْنِعُني منكَ آخرَ الأبدِ"],["F1703CAB-3A0A-53D9-8408-FF9B5F374556","تَحْلِفُ ألاّ تَبرَنِّي أبداً","فإنَّ فيها بَرْداً على كَبِدي"],["28BE09C5-69CC-5FF0-8FC5-9D1C7153E22E","اِشفِ فُؤادِي مِنّي فإنَّ به","مِنيَ جُرْحَاً نكأتهُ بِيَدي"],["2AB7596F-9DD6-5C47-B70B-28E984610959","إنْ كانَ رِزقي إليكَ فارْم به","في ناظِرَيْ حَيَّةٍ على رَصَدِ"],["BE27004B-16D6-51DD-ACEB-FBB3A025A2E9","قد عِشْتُ دَهراً وما أقدِّرَ أنْ","أرضى بما قد رَضيتُ من أحدِ"],["D5A1D8D2-8C47-540F-9413-D38D3532A609","فكيف أخطأتُ لا أصبتُ ولا","نَهَضْتُ من عَثرةٍ إلى سَدَدِ"],["F5F2DFC4-F01F-5409-B607-0072751D2B1B","لو كنتُ حُرَّاً كما زعمتُ وقد","كَدَدْتني بالمِطالِ لم أَعُدِ"],["F5DDF4F8-0B04-50EC-B621-4F48713227BE","صَبَرْتُ لمَّا أسأتَ بي فإذا","عُدْتُ إلى مثلها فَعُدْ وُعدِ"],["501FC382-8C13-53B7-9D7F-E2DFBDF322F4","فإنّني أهلُ ذاكَ في طَمَعي","وفي خَطَائي سَبيلَ مُعْتَمدِ"],["012D9683-430F-5285-8036-9C64E58955A0","أبْعَدني اللهُ حينَ يَحْمِلُني","حرصي على مثل ذا من الأودِ"],["C6140D93-C9A3-5FAB-B59E-98C288B9A40A","الآن أيقنتُ بعد فِعْلِكَ","أنْي عَبدُ لأَعْبُدٍ قُفُدِ"],["BA7EAE57-A4D3-53F9-9EB5-C0DA63B4C2DA","فصِرْتُ من سُوَء ما رُمِيتُ به","أكنى أبا الكَلْبِ لا أبا الأسدِ"]]},"D1F140D8-FBD8-5B9C-B8FD-6FFCD99DA5E6":{"t":"لِموسى أَعْبُدٌ وأَنَا أخُوهُ","p":0,"s":"لموسى أعبد وأنا أخوه","r":"477771","v":[["A1B15194-E98F-5BDA-8030-9EBF9DB83A33","لِموسى أَعْبُدٌ وأَنَا أخُوهُ","وصاحِبُه ومالي غيرُ عَبْدِ"],["F0FA41C1-12C5-58C7-BCCE-E7CBD2B0DBE7","فلو شاء الإلهُ وشاء موسى","لآنَسَ جانبي فَرَجٌ بِسَعْدِ"]]},"D4C24820-1809-5E8F-BA21-162F518CA48D":{"t":"لِيَهْنِ أبا العباسِ رَأىُ إِمامِهِ","p":0,"s":"ليهن أبا العباس رأى إمامه","r":"477769","v":[["2AAF9EA8-D735-5B1E-AA0F-D5C30DF7A173","لِيَهْنِ أبا العباسِ رَأىُ إِمامِهِ","وما عِنَدهُ منهُ القَضا بمَزيدِ"],["7871A0D3-7349-5C32-A6EC-D475288FB0EE","دَعاهُ أميرُ المؤمنين إلى التي","يُقصِّر عنها ظَلُّ كلِّ عَميدِ"],["4C4C098F-8181-5C5C-B803-88A217D62011","فبادَرَها بالرّأي والحَزمِ والحجى","وَرَأيُ أبي العباس رأي سَديدِ"],["8BEDCBFF-58F2-5EC2-B20B-85C5C09334DB","نَهضْتَ بما أعيا الرِّجالُ بحملِهِ","وَأنتَ بِسَعدٍ حاضِرٍ وسعيدِ"],["CA4C3BA6-27AD-510A-8185-16915D98D189","رَدَدتَ بها لَّلرائدين أعَزّهُم","ومثلِكَ والى طارفاً بتليدِ"],["4A5F0BDF-1E79-5AD4-AB77-9B2DB4E91556","كفى أسَداً ضيقَ الكبول وكَرْبها","وكانَ عليهِ عاطفاً كيزيدِ"],["66D239CE-AE9F-5B96-82D5-C9D92CAE81E3","وحَصَّلَهُ فيها كَليثٍ غضَنْفَرٍ","أبي أشْبُلٍ عْبلِ الذِّراع مَديدِ"]]},"8EE00D26-2DE5-5B73-AD12-A01D7302CEF2":{"t":"مُحبٌّ صَدَّ آلِفُهُ","p":0,"s":"محب صد آلفه","r":"477766","v":[["5D993CE7-1E73-5389-985D-2D0CD68F73E2","مُحبٌّ صَدَّ آلِفُهُ","فليس لَلِيْلهِ صُبْحُ"],["6CF57641-8AA0-5675-B764-29CAC866AC64","يُقلِّبُه على مَضَضٍ","مَوَاعدُ مالَها نُجْحُ"],["C6DCBFD2-488E-5402-A141-78BEFEC9F4B4","له في عَيْنِه غَرْبُ","وفي أحشائه جُرْحُ"],["FD91CBA6-6BB1-5FC8-9D75-75BBA097CD43","صَحا عنه الذِّي يرجو","زِيارتَه وما يَصْحُو"]]},"98A3CF43-F7D9-5433-A61A-7CF121E5105A":{"t":"وإنّي على عُدْمي لَصَاحِبُ هِمّةٍ","p":0,"s":"وإني على عدمي لصاحب همة","r":"477775","v":[["849B87B5-A75D-5A25-A987-F6930DD8F28D","وإنّي على عُدْمي لَصَاحِبُ هِمّةٍ","لها مَذهبٌ بين المجَّرةِ والنَّسْرِ"]]},"A9864930-1855-50BF-AC0C-D7824A7C7788":{"t":"وسائلٍ عن حِماريّ كيف جَالُهمَا","p":0,"s":"وسائل عن حماري كيف جالهما","r":"477773","v":[["2C85F48C-F484-57CB-81AD-CA10B98102C4","وسائلٍ عن حِماريّ كيف جَالُهمَا","سَلْني فَعِندي حقيقهُ الخبرِ"],["8ACEC08C-80E2-5F25-B16E-AFE8F5172481","لاَ خيرَ في صاعدٍ فتطلبه","والخيرُ يأتيك من يَدَي مطرِ"],["268A7825-69CE-5C54-AEF7-AF3E9C549EE8","وأيّ خير يأتيك من رجلٍ","ليس لأنثى يُدْعى ولا ذكرِ"],["AAA280E2-CDA6-5BAB-A5AF-11130B243DDD","ليسَ له غيرَ نفسه نَسَبٌ","كأنه آدمٌ أبو البشرِ"]]},"60D162A9-27F1-5607-9D1E-62B71CA3C952":{"t":"ولاَئمةٍ لاقَتْكَ يا فَيْضُ في الندَّى","p":0,"s":"ولائمة لاقتك يا فيض في الندى","r":"477772","v":[["FDA6F52B-277B-5F56-8D3E-D87DA1AC6A6D","ولاَئمةٍ لاقَتْكَ يا فَيْضُ في الندَّى","فَقُلْت لها لَن يَقْدحَ الّلوْمُ في البحرِ"],["C4D297B1-5519-55E0-8E63-7889A6471E7A","أرادَتْ لِتثنْيِ الفَيّضَ عن عادة النّدى","ومَنْ ذَا الذّي يَثني السَّحَابَ عنِ القَّطْرِ"],["1E9BDB92-29A8-56D0-B4CD-61E3D22E3AE2","مَوَاقعُ جٌوُد الفَيْضِ في كلِّ بلدةٍ","مَواقعُ ماءِ المُزنِ في البلدِ القَفْرِ"],["AF3C6DC5-5260-5F92-96D9-BA713ECC7154","كأنَّ وفُودَ الفَيْضَ حِينَ تَحمّلوُا","إلى الفيضِ وافَوا عِنْدِهُ لَيْلَةَ القَدَرِ"],["DEFF70B4-A81B-54FC-8FC0-A4ABB94EE654","إذا ما أتاهُ السائلونَ تَوَّقدتْ","عليه مَصَابيحُ الطلاقَةِ والبشرِ"]]}}}