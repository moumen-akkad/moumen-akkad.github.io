{"v":1,"poems":{"EF46B203-2DCA-5DD5-87EA-A7E323521EF1":{"t":"ديوان أبي شراعة","p":111,"s":"ديوان أبي شراعة","r":"478532","v":[["0811AD7B-2AF4-56CD-838C-F4AAE026B725","طافَ الخَيالُ وَلاتَ حيـنَ تَطَـرُّبِ","أَن زارَ طَيفٌ موهِنـاً مِـن زَينَـبِ"],["5ED36AA9-9FE2-510A-8B26-AC8B6035A7B3","طَرَقَت فَنَفَّرَتِ الكَـرى عَـن نائِـمٍ","كانَـت وِسادَتُـهُ ذِراعَ الأَرحَبــي"],["70B14B34-5D53-5121-8D40-A6AF1663D76D","فَبَكـى الشبـابَ وَعَهـدَهُ وَزَمانَـهُ","بَعدَ المَشيبِ وَمـا بُكـاءُ الأَشيَـبِ"],["F88EACF8-16D5-5DF8-A29E-4C0465661C1F","أَئِن كُنتُ في الفِتيانِ آلـوتُ سَيِّـداً","كَثيرَ شُحوبِ اللَونِ مُختَلِفَ العَصبِ"],["4A5D2DCD-333C-5F9D-9458-1FCD2D48B233","فَما لَـكَ مِـن مَولـاكَ إِلاّ حِفاظُـهُ","وَما المَـرءُ إِلاّ بِاللِسـانِ وِبِالقَلـبِ"],["5E7DAF37-DDEF-5195-A78A-F2B105D11FD4","هُما الأَصغَرانِ الذائِدانِ عَنِ الفَتـى","مَكارِهَهُ وَالصاحِبانِ عَلى الخَطـبِ"],["8F430B0A-7CEA-5F0B-A424-270B60920BC2","فَإِلاّ أُطِـق سَعـيَ الكِـرامِ فَإِنَّنـي","أَفُكُّ عَنِ العاني وَأَصبِرُ في الحَـربِ"],["39DB6A93-88F7-53FE-B89E-6CC5DBA69656","ما بـالُ سُعـدى أَخلَفَـت ميعـادي","وَتَيَسـرَت لِقَطيعَتــي وَبِعــادي"],["B07DA3E0-BA2B-5447-8A7D-59906B6A5489","أَسُعادُ هَل ذَنبٌ سَوى أَنّـي اِمـرُؤٌ","شَغَلَـت مَحَبَّتُكُـم عَلَـيَّ فُــؤادي"],["42F15010-833D-5013-BB44-B66D983113F1","وَلَقَد دَنَوتِ وَكُنـتِ غَيـرَ بَخيلَـةٍ","حَتّـى إِذا أَطمَعـتُ فـي الميعـادِ"],["1F8FE115-2D1A-5606-8ED4-E13CD393A20B","بَرَقَت بَوارِقُ مِـن نَوالِـكَ خُلَّـبٌ","كَـذِبُ العُـداةِ صَواعِـقُ الإيعـادِ"],["D0C7FE47-AB25-5C13-B11A-2DA298E712F5","لا خَيرَ في العَيشِ قَولَ ذي نُصُـحٍ","إِن أَنتَ لَم تَغدُ سَكراناً وَلَـم تُـرَحِ"],["74471C9D-C723-54AF-A971-31DDD89BD437","مِن قَهوَةٍ كَشُعاعِ الشَمـسِ صافِيَـةٍ","تَنفي الهُمومَ بِأَنـواعٍ مِـنَ الفَـرَحِ"],["AB3F13DE-EF40-5F7A-9C02-5C420F24CD2F","ما زِلتُ أَشرَبُهـا وَاللَيـلُ مُعتَكِـرٌ","حَتّى أَكَبَّ الكَرى رَأسي عَلى قَدَحي"],["FAC1934E-AD1B-5729-86BD-18FA9A766F8F","حُبّـى لإِِغنـاءِ سَـوّارٍ يُجَشِّمُنـي","خَوضَ الدُجى وَاِعتِسافَ المَهمَةِ البيدِ"],["90D30C25-3D64-5B09-BDB9-99ADE6A0CED0","كَي لا تَهونَ عَلى الأَعمـامِ حاجَتـهُ","وَلا يُعَلَّــلَ عَنهــا بِالمَواعيــدِ"],["DC58492A-F49B-5BC8-8D09-F9F72D8B26CA","وَلا يُوَلّيهِـمُ إِن جــاَء يَسأَلُهــا","أَكتافَ مَعرَضَةٍ في العيسِ مَـردودِ"],["E3173822-AB4C-5DEA-B192-8B0CC412CD47","إِذا بَكى قالَ مِنهُـم ذو الحِفـاظِ لَـهُ","لَقَد بُليـتَ بِخُلـقٍ غَيـرَ مَحمـودِ"],["4CDCC62A-4107-53E5-9BF9-9ADBD6125B8A","عَدَوتُ إِلى المُـرِّيِّ عَـدوَةَ فاتِـكٍ","مِعَـنٍّ خَليـعٍ لِلعَـواذِلِ وَالعُــذرِ"],["A21F0EA0-6E1C-5D25-9E03-4D5FA64BD2FE","فَقالَ لِشَيءٍ مـا أَرى قُلـتُ حاجَـةٌ","مُغَلغَلَـةٌ بَيـنَ المُخَنَّـقِ وَالنَحــرِ"],["BBCA89CB-B8C6-56F7-AD4B-1AEFF0DB4FBB","فَلَمّـا لَوانـي يَستَثيـبُ زَجَرتُــهُ","وَقُلتُ اِغتَرِف إِنّا كِلانا عَلى بَحـرِ"],["312E388A-655B-5C6F-BAE2-69D49D3B563B","أَلَيسَ أَبو إِسحاقَ فيـهِ غِنـىً لَنـا","فَيُجدي عَلى قَيسٍ وَأَجدي عَلى بَكرِ"],["5AB930BB-0DE9-53D2-8E8E-F4D054C2710D","فَغَنّى بِذاتِ الخالِ حَتّـى اِستَخَفَّنـي","وَكادَ أَديمُ الأَرضِ مِن تَحتِنا يَجـري"],["425B5D12-0842-5EE9-8D6F-F8792E27B4C5","فَمَن كانَ لَم يَسمَـع عَجيبـاً فَإِنَّنـي","عَجيبُ الحَديثِ يا أُمَيـمَ وَصادِقُـه"],["2598478C-C788-540B-8621-41CC0F133727","وَقَد كانَ لي أُنسـانِ يـا أُمَّ مالِـكٍ","وَكُـلٌّ إِذا فَتَّشَتنـي أَنـا عاشِقُــه"],["331D7B02-8A97-5315-B31C-7B7DFE3D3E7D","عَزيزَةُ وَالكَأَسُ الَّتـي مَـن يُحِلُّهـا","تُخادِعُـهُ عَـن عَقلِـهِ فَتُصادِقُــه"],["B0116CE1-ECF0-525A-87E8-101B04675058","تَحارَبَتـا عِنـدي فَعَطَّلـتُ دَنَّهــا","وَأَكوابَهـا وَالدَهـرُ جَـمٌّ بَوائِقُــه"],["E7339626-ACED-5A12-BA61-621115C09BDF","وَحَرَّمتُهـا حَولَيـنِ ثُـمَّ أَزَلَّنــي","حَديثُ النَدامـى وَالنَشيـدُ أُوافِقُـه"],["EA20FFEA-C0E2-5ABF-9498-35508B464CA9","فَلَمّا شَرِبتُ الكَـأسَ بانَـت بَأُختِهـا","فَبانَ الغَـزالُ المُستَحَـبُّ خَلائِقُـه"],["C2FFE7AC-8C60-5DE6-AA85-71A299B4CE47","فَما أَطيَبَ الكَأسَ الَّتي اِعتَضتُ مِنكُم","وَلَكِنَّهـا لَيسَـت بِريـمٍ أُعانِقُــه"],["6C8978B1-0B8F-5958-8419-D2E6C162E6C5","عَيَّرَتنـي نائِـلَ السُلطـانِ اَطلُبُـهُ","يا ضَلَّ رَأيُكَ بَينَ الخُرقِ وَالنَـزَقِ"],["8DD5D8B1-269A-5E58-8FEF-891F1822D587","لَولا اِمتِنانٌ مِـنَ السُلطـانِ تَجهَلُـهُ","أَصبَحتُ بِالسَودِ في مَقعَوعِسِ خَلَـقِ"],["875D569A-C634-530D-A010-E076D7C8D5E2","رَثَّ الـرِدا بَيـنَ أَهـدامٍ مُرَقَّعَـةٍ","يَبيتُ فيهـا بِلَيـلِ الجائِـعِ الفَـرِقِ"],["61092557-AA8F-56D5-B7B3-CEE0E9EC9BB6","لا شَيَء أَثبَـتُ بِالإِنسـانِ مَعرِفَـةً","مِنَ الَّتي حَزَمَـت جَنبَيـهِ بِالخِـرقِ"],["2ADD1DC5-EA0A-50FA-9E4E-D2FFDAF8991C","فَأَيـنَ دارُكَ مِنهـا وَهـيَ مُؤمِنَـةً","بِاللَـهِ مَعروفَـةُ الإِسلـامِ وَالشَفَـقِ"],["4262B4BC-CCBE-58F8-A501-460E5CE1D7C4","وَأَينَ رِزقُـكَ إِلاّ مِـن يَـدَي مَـرَّةٍ","ما بَتَّ مِن مالِهـا إِلاّ عَلـى سَـرَقِ"],["E0A61FF7-CC2B-503F-8163-D3FB947F7F5C","تَبيـتُ وَالهِـرَّ مَمـدوداً عُيونُكُمـا","إلاّ تَطَعُّمِهـا مُخضَــرَّةَ الحَــدَقِ"],["5FD925FF-D908-531A-B544-A5A06A7740A9","ما بَينَ رِزقَيكُما إِن قـاسَ ذو فِطَـنٍ","فَرقٌ سَوى أَنَّهُ يَأتيـكَ فـي طَبَـقِ"],["95923BD2-9861-54F4-A849-CD9A797F680C","شارَكَهُ فـي صَيـدِهِ لِلفَـأرِ تَأكُلُـهُ","كَما تُشارِكُهُ فـي الوَجـهِ وَالخُلُـقِ"],["8087FE67-B7C2-5461-982A-8BD233C4339D","أَأُنبَـزُ مَجنونـاً إِذا جُـدتُ بِالَّـذي","مَلَكـتُ وَإِن دافَعـتُ عَنـهُ فَعاقِـلُ"],["464D47B4-DFD7-5241-9638-74B580E66EBD","فَداموا عَلى الزَورِ الَّذي قُرِفـوا بِـهِ","وَدُمتُ عَلى الإِعطاءِ ما جاَء سائِـلُ"],["2789B1C8-C188-5AD7-95EA-3602FFBAC887","أَبَيتُ وَتَأبـى لـي رَجـالٌ أَشِحَّـةٌ","عَلى المَجدِ تَنميهِـم تَميـمٌ وَوائِـلُ"],["D42697D7-B5E9-5DC4-8BF6-A0666FEC2B37","إِلَيكَ اِبنَ موسى الجودِ أَعمَلتُ ناقَتي","مُجَلَّلَـةً يَضفـو عَلَيهـا جِلالُهــا"],["BACD8D76-DDC1-5267-8D77-4F2492C3005A","كَتومُ الوَجى لا تَشتَكي أَلَمَ السُـرى","سَـواءٌ عَلَيهـا مَوتُهـا وَاِعتِلالُهـا"],["495CB45D-A452-54D4-989B-AE7598E888F1","إِذا شَرِبَت أَبصَرَت ما جَوفُ بَطنِها","وَإِن ظَمِئَت لَم يَبـدُ مِنهـا هُزالُهـا"],["081498F7-01B9-577E-9A33-8B9902A8F2C7","وَإِن حَمَلَت حِمـلاً تَكَلَّفـتُ حِملَهـا","وَإِن حُطَّ عَنها لَم أَقُل كَيـفَ حالُهـا"],["8B954AC1-E3E6-592D-BDCE-FAAE9A2B01E5","بَعَثنا بِها تَسمـو العُيـونُ وَراَءهـا","إِلَيكَ وَمـا يُخشـى عَلَيهـا كَلالُهـا"],["5C299E30-20B5-5E83-A662-17D537CC602A","وَغَنّـى مُغَنِّيـاً بَصِـوتٍ فَشاقَنـي","مَتى راجِعٌ مِـن أُمِّ عَمـرٍو خَيالُهـا"],["0E284525-9C91-597D-AC67-50DBA7CC510B","أُحِبُّ لَكُم قَيسَ بـنَ عَيلـانَ كُلُّهـا","وَيُعجِبُنـي فُرسانُهــا وَرِجالُهــا"],["656CDC04-75F6-55AC-85D2-B7DE270BD547","وَمـا لِـيَ لا أَهـوى بَقـاَء قَبيلَـةٍ","أَبـوكَ لَهـا بَـدرٌ وَأَنـتَ هِلالُهـا"],["A087BE2C-1169-55D2-B536-8A7156C6D0EF","تَلـومُ جـودي لِبُرمَـةِ الطَفشيـلِ","وَاِستَهِلّـي فَالصَبـرُ غَيـرُ جَميـلُ"],["580DD1B9-66E5-5125-84B3-469A75F94BEF","فَجَعَتني بِهـا يَـدٌ لَـم تَـدَع لِلـذَرِّ","فـي صَحـنِ قِدرِهـا مِـن مَقيـلِ"],["719C8829-BF05-513A-8731-8307DAFB358C","كانَ وَاللَـهِ لَحمُهـا مِـن فَصيـلٍ","رائِـعٍ يَرتَعـي كَريـمَ البُقــولِ"],["8EE5FE7E-32C5-5CB0-BBE0-D1526BA37199","فَخَلَطنـا بِلَحمِـهِ عَـدَسَ الشــامِ","إِلـى حِمِّــصٍ لَنــا مَبلــولِ"],["749F49E9-465F-58A1-90E0-59ABB2EBD1C4","فَأَتَتنـا كَأَنَّهـا رَوضَـةٌ بِالحَــزنِ","تَدعــو الجيــرانَ لِلتَطفيـــلِ"],["E3B98F4D-436F-55B1-BE6D-AD956E810C66","ثُـمَّ أَكفَـأتُ فَوقَهـا جَفنَـةَ الحَـيِّ","وَعَلَّقـتُ صَحفَتـي فـي زَبيــلِ"],["37189411-41A8-56BE-A125-5660D57F5E7F","فَمَنـى اللَـهُ لـي بِفَـظٍّ غَليــظٍ","مــا أَراهُ يُقِـــرُّ بِالتَنزيـــلِ"],["2CC6C6B2-B702-5296-9422-CC1135829FAB","فَاِنتَحـى دائِبــاً يُدَبِّــلُ مِنهــا","قُلــتُ إِنَّ الثَريــدَ لِلتَدبيـــلِ"],["A0B3507A-9619-5627-9D0A-168818D29A1E","فَتَغَنّـى صَوتـاً لِيوضِـحَ عِنـدي","حَـيِّ أُمَّ العَـلاءِ قَبـلَ الرَحيــلِ"],["DFECA1D8-8F52-5EA7-8AF5-F3A7E369BF70","وَرَدتُ دارَ سَعيـدٍ وَهـيَ خالِيَــةٌ","وَكانَ أَبيَضَ مِطعامـاً ذُرى الإِبِـلِ"],["149EBE1B-16E5-56BB-BCD1-29F4D8C2DE2F","فَاِرتَحتُ فيها أَصيلاً عِنـدَ ذُكرَتِـهِ","وَصُحبَتي بِمِنىً لاهونَ فـي شُغُـلِ"],["783519DB-A805-530A-BA07-15592E1A0790","فَاِبتَعتُ مِن إِبِـلِ الجَمـالِ دَهشَـرَةً","مَوسومَةً لَم تَكُـن بِالحِقَّـةِ العُطُـلِ"],["2AD252F3-9E19-5A38-B09A-5F34B6BB198B","نَحَرتُها عَن سَعيدٍ ثُـمَّ قُلـتُ لَهُـم","زوروا الحَطيمَ فَإِنّي غَيـرُ مُرتَحِـلِ"],["C738050C-AF91-589F-8B32-BD815DAFCF65","أَلا لا أُبالي في العُلى مـا أَصابَنـي","وَإِن نَقِبَت نَعلايَ أَو حَفِيَت رِجلـي"],["D66A0720-7E53-544A-9AD1-51651F0EC87A","فَلَم تَرَ عَيني قَـطُّ أَحسَـنَ مَنظَـراً","مِنَ النَكبِ يَدمى في المُواساةِ وَالبَذلِ"],["4DE7CA9F-92C3-56E0-BAE5-75FBD677CCAD","وَلَستُ أُبالي مَـن تَـأَوَّبَ مَنزِلـي","إِذا بَقِيَت عِندي السَراويلُ أَو نَعلـي"],["09762311-383E-587E-B9E1-1EB7EF2E43FA","بَنـي سَـوّارَ إِن رَثَـت ثِيابــي","وَكَلَّ عَنِ العَشيـرَةِ فَضـلُ مالـي"],["FB6B7A92-1682-5165-BA76-94D00D6E83F3","فَمُطَّــرَحٌ وَمَتــروكٌ كَلامــي","وَتَجفونـي الأَقـارِبُ وَالمَوالــي"],["FB01FD58-5A69-5A0F-8432-F0D6C182844E","أَلَـم أًكٌ مِـن سَـراةِ بَنـي نُعَيـمٍ","أَحُـلُّ البَيـتَ ذا العَمَـدِ الطِـوالِ"],["7C3C6388-3EAE-55BB-BE7C-3BE5C0AA04E5","وَحَولـي كُـلُّ أَصيَــدَ تَغلَبِــيٍّ","أَبِـيُّ الضَيـمِ مُشتَـرَكُ النَــوالِ"],["7CD098AC-4733-54DB-BEF4-7450E06DF983","إِذا حَضَـرَ الغَـداءُ فَغَيـرُ مُغــنٍ","وَيُغنـي حيـنَ تَشتَجِـرُ العَوالـي"],["39F2AD3B-53DF-5F0A-B7A6-4E0462BD2887","وَأَبقَونــي فَلَســتُ بِمُستَكيــنٍ","لِصاحِـبِ ثَـروَةٍ أُخـرى اللَيالـي"],["07E0FCE4-E604-5B4F-B7D8-748145F7A7E5","وَلا بِمُمَسِّــحِ المُثريــنَ كَيمــا","أُمَسِّـحَ مِـن طَعامِهِــم سِبالــي"],["B49AD8FA-2D2A-5788-AAB1-5CECD8EC4F1B","أَنـا اِبـنُ العَنبَرِيَّــةِ أَزَّرَتنــي","إِزارَ المَكرُمــاتِ إِزارَ خالـــي"],["C76F64F2-9747-56C3-B0FF-182B28819006","فَـإِن يَكُـن الغِنـى مَجـداً فَإِنّـي","سَأَدعـو اللَـهَ بِالـرِزقِ الحَلــالِ"],["E6701112-D4D9-55C4-9315-9FDDAF9CA662","تَلومُ اِبنَةُ البِكـرِيِّ حيـنَ أَؤوبُهـا","هَزيـلاً وَبَعـضُ الآئِبيـنَ سَميـنُ"],["F06E1338-7284-5814-9353-8D29F0CE4D04","وَقالَت لَحاكَ اللَهُ تَستَحسِـنُ العَـرا","عَـن الـدارِ إِنَّ النائِبـاتِ فُنـونُ"],["FC874F54-D82A-55FD-A735-158C0613F11B","وَحَولَكَ إِخوانٌ كِـرامٌ لَهُـم غِنـىً","فَقُلـتُ لإِِخوانـي الكِـرامُ عُيـونُ"],["2BCAA28F-B6DE-5144-A427-A6C99DB1699C","ذَريني أَمُت قَبـلَ اِحتِلـالِ مَحَلَّـةٍ","لَها في وُجـوهِ السائِليـنَ غُضـونُ"],["13A78F0D-E652-5D00-B8D1-548558614F9E","سَأَفدي بِمالي مـاَء وَجهِـيَ إِنَّنـي","بِما فيهِ مِن مـاءِ الحَيـاءِ ضَنيـنُ"]]}}}