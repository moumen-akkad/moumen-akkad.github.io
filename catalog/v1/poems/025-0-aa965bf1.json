{"v":1,"poems":{"D53D06FE-91F2-58D0-8F41-4D3FE6501FC7":{"t":"أبني نُجيح إن أمكم","p":25,"s":"أبني نجيح إن أمكم","r":"437062","v":[["97DD4BB4-D7B0-553F-8E8A-1E817477B344","أبني نُجيح إن أمكم","أمة وإن أباكمُ وَقبُ"],["1CB3258B-0611-5DF0-8529-D05ED2F101FF","أكَلت خبيث الزاد فاتّخمت","عنه وشمَّ خِمارها الكَلبُ"],["65A2F921-D490-56DA-8906-8BBA6BF75B33","ورأيتُمُ لمجاشِع نَسباً","وبني أبيه حَامِلٌ زَعبُ"],["4C7B0F95-DFAF-5642-8DC1-F0DAA87B882B","وقلبتُم ظهرَ المِجَنِّ لنا","إنَّ اللئيمَ العاجزُ الخَبُّ"],["0AD64D5E-F76B-5504-A88E-96FC1D138FFB","يَرعى الجريبَ إِلى لواقِح","فالسُّوبان لا يُثنَى له سَربُ"],["A7FA123B-E2C5-5992-B5AF-6C613D8DCBFD","حتى إِذا قَمِلت بطونُكم","ورأيتُمُ أبناءَكم شَبُّوا"],["7DCBA477-297F-5AD5-B76B-017452A2FBF2","أستاهَ أحمرة صَدرن معاً","نَبتَ الثغامُ لهنَّ والعِربُ"],["478AA856-BDB6-556D-B1FC-34EAFF9BE417","يَملأن جَوف مُتالعٍ ضرطاً","فضّاً يرُدُّ فضيضهُ الهضبُ"],["69FEED9B-6488-581D-8FD3-B0D1A11771EC","فامضُوا على غُلواء أمرِكمُ","ورِدوا الذنابَة ملؤها عَذبُ"]]},"55276888-CD26-5EF2-8DE5-A852329BD693":{"t":"أبينت رسم الدار أم لم تُبينِ","p":25,"s":"أبينت رسم الدار أم لم تبين","r":"437127","v":[["A2073A1E-88D5-5D5A-99F9-EB16B6FF6E37","أبينت رسم الدار أم لم تُبينِ","لسلمى عفَت بين الكلاب وتيمنِ"],["F7FC2A4B-9E6A-5267-B02E-1E36A828166D","كأن بقايا رسمها بعد ما حلت","لكالريح منها عن محلّ مُدَمنِ"],["C858218C-DF30-562A-9B6E-4E1AD161F143","مجالس إيسارٍ وملعبُ سامرٍ","وموقد نار عهدها غير مزمنِ"],["D27C2E9E-5D22-59E8-8C8E-02DE9F6393E1","سطورُ يهوديين في مُهرقيهما","مجيدين من تيماء أو أهل مدينِ"],["535CC4DF-8BF8-5D71-8A45-894130CC4080","فدمعك إِلا ما كففت غُروبَه","كوالفِ بال من مزاد وميّنِ"],["F02E606C-63A2-58FF-9B91-0DAF7E7F9C17","بكاء عليها كل صيف ومربع","كأديانه من عمرة ابنة محجنِ"],["4D954188-7775-5C38-ABE5-BDD4AA601211","تبصر خليلي هل ترى من ظعائن","غدونَ لبينٍ من نوى الحي أبيّنِ"],["2CDD6AC9-3B6B-5FC2-8EF2-E9EECD1FA0F5","تردّين أنطاكية ذات حُجةٍ","على شرعبي من يمان مُدهنِ"],["21863D05-AEAA-5AF4-9C19-FA6DFB6915C4","جَعلن بليل وارِدات وهصتما","شمالاً ويمَّمن البديّ بأيمنِ"],["F8730673-E2C9-5C64-A670-1D6EAAA65305","فأضحت تراءها العيون كأنها","على الشرف الأعلى نخيل ابن يامن"],["02424DCC-695A-5B4D-B965-096EE4342B01","أو الأثأب العم الدري أو كأنها","خلايا عَدولي السَّفين المُعمن"],["D98A098D-E708-5125-9A19-4AEC55629553","فجئن وقرن الشمس لم يعد أن بدا","فغبن إِلى حورٍ نواعم بُدّن"],["FF58ECCE-8B8C-59FE-9C5B-9E4BD4154807","وكور على أنماط بيضٍ مزخرف","مدينيّةٍ أوفى بها حجّ مسكن"],["B0BBD9FE-DFB7-50DB-85B4-A7916C26FFA8","فقلن أقيلونا فقلن بنعمةٍ","لدى كل حذرٍ ذي ثقوب مزين"],["49965425-84EE-5B6B-8312-8628EFCE92B0","يطالعننا من كل خمل وكلّةٍ","بمخضوبة حُمس لطاف وأعيُن"],["B44DEDC0-1353-5F02-B1C7-98A57D5FA26C","ألم يأتها أن قد صحوت عن الصبا","وآلت إِلى أكرومةٍ وتدين"],["5EEF0A4D-35B2-5537-B715-DC7BFA612045","وفارقت لذات الشباب وأهله","كمفرقة غاد مشيم ميمن"],["9E9D3270-6743-592D-9B51-F70CFC518721","وذي نسب دانٍ تجلدت بعده","على رُزئه ورزؤه غيرُ هيّن"],["7A5614D9-7CC5-5ED7-BCAB-7655834F30BA","كريم ثناه تمطر الخير كفه","كثير رماد القدر غير ملعَّن"],["9EBD695B-B54D-5F27-919E-458E9ACECF2C","غدا غير مملولٍ لديّ جماعةٌ","ولا هو عن طول التفاخر ملّني"],["D3862316-4D65-5AC3-A16B-D68C8664F2DC","وحَسرة حزنٍ في الفؤاد مريرة","تخيَّبتُها والمرءُ ما يغش يحزن"],["68400CC8-79F4-5BC8-A94F-3F37D413E0B3","ونخوةُ أقوام عليّ درأتها","بسطوة أيدٍ من رجال وألسن"],["986DCA02-FE6A-5A8A-93D7-AFF544CFF7C9","وندمان صدقٍ لا يرى الفحش رائجاً","لديه لمخزون المدامة مدمن"],["640EB6B4-6994-5DB4-82A7-774FC290C00B","بكرت عليه والدجاج مُعرسٌ","جثومٌ وضوءُ الصبح لم يتبين"],["03AD473E-9296-5660-A522-44B43937A02E","فظلت تدور الكأس بيني وبينه","إذا هي أكرت قال صاح ألا أنثني"],["2DBA06EF-EA62-5D73-9889-35AE2E2FA544","فرحنا أصيلاناً ترانا كأننا","ذو قيصر أو آل كسرى بن سوسن"],["47757AF2-489C-5D95-B48C-03BCC488266A","وغانيةٍ قطعت أسباب وصلها","بحرف كقوس الهاجري المضيّن"],["6F19DA42-4C93-599F-9766-F65833C33345","تكاد تطير الرحلَ لولا نُسوعهُ","إذا ثفنت إِلى القطيع المُقرَّن"],["46AE5EC3-8071-5C48-9D41-22538C1504B7","كأن قُتودي حين لانت وراجعت","طريقة مرفوع من السير لين"],["C68D737F-5462-5E7A-AD19-EFE4E854BB48","على وَحدٍ طاوٍ أقرّت فؤاده","كلابُ ذريح أو كلابُ ابن مِيزن"],["142ED2F8-F7F6-5513-B4C5-B1ABDE35F13E","وكأن مُهري ظلَّ ثم مخيلاً","يكسو الأسِنّةَ مغزةَ اللّجان"]]},"46D88833-4F91-54AA-BDB8-DFF6F708C59E":{"t":"أتاني عن أبي أنَسٍ وَعيدٌ","p":25,"s":"أتاني عن أبي أنس وعيد","r":"437056","v":[["FC7EC5B2-1D9C-5E42-8740-78884874C2F7","أتاني عن أبي أنَسٍ وَعيدٌ","ومَعصوبٌ تخبُّ به الركابُ"],["E3778D79-1561-5D68-B63A-FEBED7EF0168","وعِيدٌ تُخدجُ الآرامُ منهُ","وتكرهُ بَنَّةَ الغنمِ الذئابُ"]]},"31BEC9FC-AF40-57FA-A7C9-71BBF6418E0C":{"t":"أتاني من الأنباءِ أن مُجاشعاً","p":25,"s":"أتاني من الأنباء أن مجاشعا","r":"437102","v":[["BFAEC1BE-3A27-58FE-8725-FB7F85CE1774","أتاني من الأنباءِ أن مُجاشعاً","وآلَ فُقَيم والكَراديسَ اصفقوا"],["A20BF003-40DA-5693-8C1D-3B42E0FC058D","وقالوا شَريسٌ قلتُ يكفي شريسكُم","سنان كنبراس النهامي مُفَتّق"],["30253A47-CDF4-55DD-8BB9-04CE2C91905F","نَمتهُ العَصَل ثم استمرَّ كأنه","شِهابٌ بكفّي قابسٍ يتحرّق"]]},"62F6DE91-FFD0-5FCB-8800-F30521BF3C4F":{"t":"أتاني ولم أخشَ الذي تبعثانه","p":25,"s":"أتاني ولم أخش الذي تبعثانه","r":"437097","v":[["D1509C7E-8CE2-5FE5-A02F-7B6E642A176B","أتاني ولم أخشَ الذي تبعثانه","خفيرا بني سَلمى حُريرٌ ورافِعُ"],["623E4FB5-D5B4-599F-8DBE-8BA35A5B44C8","هُما خيباني كل يومٍ غنيمةً","وأهلكتُهم لو أنّ ذلك نافِعُ"],["94716CE8-9EB7-5FB8-A5D8-5F6408ED0E70","واتبعت أخراهم طريق الأهُم","كما قيل نجمٌ قد خوى متتائِعُ"],["E261CD0A-C9D3-5A34-B08B-D9212A7BFAB0","وخير الذي أعطيكم هي شِرّةٌ","مُهَوَّلةٌ منها سيوفٌ لوامِعُ"],["1E12FC69-0789-57B8-8FFC-995EA8329835","فلا أنا مُعطيكُم عليّ ظُلامةً","ولا الحقّ معروفاً لكم أنا مانِعُ"],["C4524541-6F9B-5190-BCC4-358721338103","وإني لأقري الضيف وصَّى به أبي","وجارُ أبي التيجان ظمآن جائِعُ"],["C7080208-FE06-5614-A995-0EADBC7904FB","فقولا لتيحان بن عامرة استها","أمُجرٍ فلاقى الغيّ أم أنت نازِعُ"],["C0E9FA01-320E-5016-8DAD-BE6348177639","ولو أن تيحان بن بلج أطاعني","لأرشدته إن الأمور مطالِعُ"],["B7B8BAC1-5FFC-53DE-8BD9-0E9DA22953A8","وإِن يك مدلولاً عليّ فإنني","أخو الحرب لا قَحمٌ ولا متجاذِعُ"],["69EC0F4B-7E56-5ABC-8F2F-FB790B138794","ولكنّ تيحان بن عاقرة استها","له ذَنَبٌ من أمره وتوابِعُ"]]},"6F2DA0BB-1F92-51F1-B1B4-9C22ED158B32":{"t":"أتوني فلم أرضَ ما بيّتوا","p":25,"s":"أتوني فلم أرض ما بيتوا","r":"437087","v":[["C379ADE3-3F21-588A-9418-E22F6DE36428","أتوني فلم أرضَ ما بيّتوا","وكانوا أتَوني بشيء نُكر"],["A62994B0-D609-55A2-84C5-1F59CCD76236","لأنكحَ أيمهُمُ مُنذراً","وهل يُنكِحُ العبدَ حُرّ لُحر"]]},"7558C8F4-E9B9-5556-8815-44E357D435F9":{"t":"أجارتنا غُضِّي من السّير أو قِفِي","p":25,"s":"أجارتنا غضي من السير أو قفي","r":"437100","v":[["08887A29-1C16-55A5-9F65-1D7E21A368F3","أجارتنا غُضِّي من السّير أو قِفِي","وإن كُنتِ لما تُزمعي البَين فأصرِفي"],["139D3DEE-E2BF-541A-86E9-38E4D50DD600","أسائلكِ أو أُخبركِ عن ذي لُبانَةٍ","سقيم فؤادٍ بالحِسانِ مُكَلَّفِ"],["F1673554-B43C-5358-8D15-773B7671ABAE","فَصَدَّت وقالَت والكَبيرُ بسُهمَة","متى يَبكِ يوماً للتصابي يُعَنَّفِ"],["FE83A051-B17A-524C-BE9D-6E17B5915D40","ولو عَرضَت يوم الرَّحيل بنشرها","لذي كَربةٍ مُوفٍ على الموت مُدنَفِ"],["56FE50D8-06A7-5B24-8295-F8424A609328","إذَن لشفته بعد ما خيل أنه","أخو سَقم قد خالط النفس مُتلِفِ"],["55B650BA-F338-5914-9088-3BD48132F3AC","سبيّةُ سَفَّانين قد خُدعا بها","تصيبُ الفؤادَ من لذيذٍ وتشتفي"],["42F297E4-598F-50C9-B34D-2FEEC4AC9BD6","ولو لُقي النُّعمانُ حَيّاً لَنالها","ولو بعث الجنيّ في الناس يصطفي"],["50410D83-9F8C-5C3F-B4BA-D180DC42B5D2","لغاضَ عليها ذاتَ دلٍّ ومِيسمٍ","ووجهٍ كدينار العزيز المشوّفِ"],["5F773105-AE23-517E-B460-C99C2CF9D6A0","أسِيلَةُ مُستَنِّ الدُّموعِ نَبيلةٌ","كأَدماء من أظبي نَبالةَ مُخرفِ"],["5CF97321-028F-590F-90BB-09DCDFA8A2DD","تَظَلُّ النهارَ في الظِلال وترتعي","فروعَ الهدَالِ والأراك المصَيّفِ"],["4EC47DAB-5199-56F2-A097-81C78676EC91","ويَذعَرُ سرب الحيّ وسواسُ حليها","إذا حركته من دعاثٍ ورفرفِ"],["1ECB210D-DFE8-5C8F-9B8F-06DAD49A938C","ولم أرَ في سُفلي ربيعةَ مثلها","ولا مضرَ الأعلين قيس وخندفِ"],["C66BFC40-99C3-5713-8895-8E1AB4F5B676","إذا هي قامت في الثياب تأوذن","سقية غَيلٍ أو غَمامَة صيفِ"],["AA2864A6-0CA4-5401-B45C-94D509B0F5A0","تداركني أسيابَ آل مُجَلّم","وقد كدت أهوى بين نيقين نفنفِ"],["15EB5F3C-B645-50E8-BCC0-E7517BBAB682","همُ القومُ يُمسي جارُهم في غضارة","سليماً سَويّ اللحم لم يُتجرّفِ"],["C948096F-8BF0-5E3C-8696-85F9F579AC9E","وَهم يضربون الكبش يبرقُ بيضُه","بأسنانِهم والماسِخيِّ المزخرفِ"]]},"A877E315-8299-5BBE-9FD1-C152568B80AC":{"t":"أجَدَّ الشبابُ قد مَضى فَتَسرَّعا","p":25,"s":"أجد الشباب قد مضى فتسرعا","r":"437095","v":[["A17957A1-872C-5D76-9D8E-434B52FF192E","أجَدَّ الشبابُ قد مَضى فَتَسرَّعا","وبانَ كَما بانَ الخليطُ فوَدَّعا"],["709E5AA9-95C0-58E9-A4CF-F5DD16F16719","وما كان مذموماً لدينا ثناؤه","وصُحبَتُهُ ما لفَّنا خُلُطٌ معا"],["EE81A433-63ED-5624-91D0-561173632325","فبانَ وجَلّ الشيبُ في رسم دارهِ","كما خفَّ فَرخٌ ناهِض فَتَرفعا"],["2B733103-B6E9-504B-9629-078F21DFBEC2","فأصبح أخداني كأنّ عليهم","ملاءَ العراق والثغام المنزَّعا"],["19B70A3E-0878-5A93-AF9B-EEFEEF0A12EE","يُبينُهمُ ذو اللبّ حينَ يراهُمُ","بسيماهُمُ بِيضاً لحاهُم وأصلعا"]]},"9C606DC5-31D3-531C-87E0-A823649F1C68":{"t":"أقول لما أتاني هُلكُ سيدنا","p":25,"s":"أقول لما أتاني هلك سيدنا","r":"437106","v":[["A33419FF-3D52-5943-A36B-9503334C47B7","أقول لما أتاني هُلكُ سيدنا","لا يبعد الله رب الناس مسروقا"],["23182E00-090C-54F5-BF42-1106134B2BFD","من لا يشيعه عجز ولا بخل","ولا يبيت لديه اللحم موشوقا"],["676924E3-664A-5FAE-B500-2A2CC728C528","مِردى حروب إذا ما الخيل ضرجها","نضحُ الدماء وقد كانت أفاريقا"],["CE1F7BF2-0E06-504B-B015-DFE04EF31ADE","والطاعن الطعنة النجلاء تحسبها","شنا هزيما تمج الماء محزوقا"],["65CE87DD-7C6E-5C5F-BF96-FAB5F7DC8AA9","وجفنة كنضيح البئر متأقسة","ترى جوانبها باللحم مفتوقا"],["08A00F50-E570-56B6-9A82-EA285755F040","يَسّرتها ليتامى أو لأرملة","وكلت بالبائس المتروك محقوقا"],["FF012478-EE58-58EE-AE30-EE376D811CF8","يا لهف أمي إذا أودى وفارقني","أودى ابن سلمى نقي العرض مرموقا"]]},"6915A7E2-95CE-5B3F-84CA-FA8060ABD218":{"t":"ألا حيّ سلمى في الخليط المُفارق","p":25,"s":"ألا حي سلمى في الخليط المفارق","r":"437103","v":[["80E30862-779E-544B-A3E8-DFE42C2E5086","ألا حيّ سلمى في الخليط المُفارق","وألمم بها أن جدَّ بين الحزائِق"],["15364D25-F393-521A-95BF-B7022182F22F","وما خفت منها البين حتى رأيتها","علا غيرها في الصبح أصوات سائِق"],["7CC8D0A1-C05C-5C48-BD39-7BF836CF69BA","تجنبن خروبا وهن جوازع","على طيه يعدلن رمل الصعافِق"],["C77EE46B-C615-53CA-9BD9-29F042560F2F","سنلقاك يوماً والركاب ذواقن","بنعمان أو يلقاك يوم التحالِق"],["3F051C0A-5ED9-52E7-ACA4-D5B8C2FB216F","وتشفي فؤادي نظرة من لقائها","وقلّت متاعاً من لُبانة عاشِق"],["743D1637-4A27-5B98-A316-479BFAD91FD9","ألا إن سلمى قد رمتك بسهمها","وكيف استباء القلب من لم يناطِق"],["A20A8F30-22BC-5817-97C2-980EE2D26FC7","تراءت لنا في جيد آدم شادنٍ","ومنسرح وحفٍ أثيث المفارِق"],["FC036658-5E62-5041-BB07-05651A8D1F23","وتبسم عن غُرِّ الثنايا مفلج","كنور الأقاحي في دماث الشقائِق"],["B9FC1A05-B86B-5958-BFAE-437059F0170A","وما روضة وسمية رجَبيّة","ولتها غيوث المدجنات البوارِق"],["827E86C6-40E1-5492-9EBB-EBC91E9F01C7","حمتها رماح الحرب حتى تهولت","بزاهر نور مثل وشي النمارِق"],["A2258C0F-2E8B-53FC-8165-3A3F9B32A00A","بأحسن من سلمى غداة لقيتها","بمندفع الميناء من روض مأذِق"],["2A2E9285-8157-5B4E-8A69-5A860569E25E","كأن ثناياها اصطبحن مدامة","من الخمر شنا فوقها ماء بارِق"],["34237018-779A-5B76-93F9-30C8B39D554D","ولو سألت عنا سليمى لخبرت","إذا الحجرات زينت بالمغالِق"],["67919E29-86F6-533C-8FB5-A62D42F20239","بأنا نعين المستعين على الندى","ونحفظ ثغر المقدم المتضايِق"],["2098F167-D7C7-56FA-B6A7-752286A85F10","وجار غريب حل فينا فلم نكن","له غير غيث ينبت البقل وادِق"],["796AA39B-5933-5ADE-8FC1-062CB6609F28","نكون له من حوله وورائه","ونؤمنه من طارقات البوايِق"],["16E32FC6-7FBF-5C42-AFF5-D9FDACC87C6C","ومستلحم قد أنفذته رماحنا","وكان يظن أنه غير لاحِق"],["49B16232-B3C9-59E9-8AA5-ED34F68B90A5","هنأنا فلم نمنن عليه طعامنا","إذا ما نبا عنه قريب الأصادِق"],["0611AF31-4449-51EB-8173-FB518311E52B","فظل يباري ظل رأس مرجل","وقد آزر الجرجار زهر الحدايِق"],["D9559871-5A51-57F4-8A8C-EE9E71A34F23","وعانٍ كبيل قد فككنا قيوده","وغلا نبيلا بين خدٍّ وعاتِق"],["87FDB9F7-DBEA-5F51-BD81-B233C875E8BB","ويا سَلمُ ما أدراك أن رب فتية","ذوي نيقةٍ في صالحات الخلائِق"],["6D2BB18E-0664-54FA-BFF3-B4560774A3E1","إذا نزلت حمر التجار تباشروا","وراحوا بفتيان العشي المخارِق"],["5C7C8485-9DE0-5100-9DF8-7A12E3F7B726","فأَمسوا يجرون الزقاق وبزها","بشفع القِلاص والمخاض النوافِق"],["FF9BCD09-A5D3-5289-ACA1-7AD8B4F068E3","وقد علمت أبناء خندف أننا","رعاة قواصيها وحامو الحقائِق"],["7D4979FE-D7D9-5F6D-AF28-826CEA5DD57E","وأنا أولو أحكامها وذوو النهى","وفرسان غارات الصباح الذوالِق"],["D33F3BCA-DB28-54B4-ABB9-2320262CCFAF","وإنا لنقري حين نحمد بالقرى","بقايا شحوم الآبيات المفارِق"],["A28A6A47-051C-5399-A067-613D4DA9CBEF","ونضرب رأس الكبش في حومة الوغى","وتحمدنا أشياعنا في المشارِق"],["1720BFAE-BD09-579F-9B80-3F944CC8F948","ومستهنئ ذي قروتين مدفّع","برته بوارٍ من سنين عوارِق"]]},"8E59D586-A837-50A3-9E57-EF87559A8E7E":{"t":"ألا هَل لِهذا الدهر من مُتعلّلٍ","p":25,"s":"ألا هل لهذا الدهر من متعلل","r":"437113","v":[["E2D74FA2-6871-5B12-B5E4-8EB53406FF63","ألا هَل لِهذا الدهر من مُتعلّلٍ","سوى الناس مهما شاء بالناس يفعل"],["2C73B710-C363-51D2-9CED-C96A91A85078","فمازال مدلولاً عليَّ مُسلَّطاً","ببؤسي ويغشاني بناب وكلكل"],["A112EB4E-567B-5851-9E93-25B8F82A5C4C","وألفى سلاحي كاملا فاستعاره","ليسلبني نفسي آمال بن حنطل"],["C161FA40-52F1-5E9B-B724-70A20B0545F6","فإن يكُ يومي قد دنا وأخالهُ","كواردة يوماً على غير منهل"],["D3B4A459-7736-5783-809C-B10346F1737C","طباها الخلاء والضحاء وأقبلت","إِلى مستتب كالمجرَّة مُعمل"],["B118FC9D-BE31-58E1-86B9-612785FA3D0A","فقبلي مات الخالدان كلاهما","عميد بني حجوان وابن المضلل"],["068D8385-5673-53B6-8CDF-6FB5054CAB91","وعمرو بن مسعود وقيس بن خالد","وفارس رأس العين سلمى بن جندل"],["EB7A0D6A-5845-53CA-AD5E-BA0FD060E2EF","وأسبابه أهلكن عاداً وأنزلت","عزيزاً يُغنّي فوق غرفة موكل"],["C66F30D7-3CF5-5ECB-AE06-DB70DF280A45","تُغنيه بحّاءُ الغناء مجيدةٌ","بصوت رخيم أو سماع مُرتل"],["CD0DD74D-FD65-5ABD-97A0-8CBF006E592B","بها ليل لا تصفو الإماءُ قدورهم","إذا النجم وافاهم عشاءً بشمأَل"],["C6376B3C-D6E9-5E0E-A2DB-F488D20FAF29","وكائن كسرنا من هتوف مرنةٍ","على القوم كانت فيلكون المعابل"]]},"202E174F-2F11-52FC-BA8B-9BBFB26CBF68":{"t":"ألا يا أسلَمِي قبل الفراق ظعينا","p":25,"s":"ألا يا أسلمي قبل الفراق ظعينا","r":"437125","v":[["9F2FD0DA-4496-5F2C-8DF3-DF11318066C3","ألا يا أسلَمِي قبل الفراق ظعينا","تحية من أمسى إليكِ حزينا"],["56B42EB3-AE8D-5784-8512-820C2BB81F21","تحية من أظننته متوجها","لِصرم حبيبٍ قد أتى أن يبينا"],["910C2BFB-5BEB-5C58-967F-149B92B5D9BB","تحية من لا قاطعٍ حبل واصل","ولا صارمٍ قبل الفراق قرينا"],["DF648A06-99D3-57AB-AB66-2440052450B0","فغظناهُمُ حتى أتى الغيظُ منهم","قلوبا وأكباداً لهم ورئينا"],["757D9F2F-7C9E-5B79-9965-46873E546C6F","هُمُ الأسرةُ الدنيا وهم عدد الحصى","وإخواننا من أمنا وأبينا"]]},"D8D0D831-A516-5F24-A06B-117309FD75F2":{"t":"أودَى ابن جُلهمَ عبادٌ بصرمَتهِ","p":25,"s":"أودى ابن جلهم عباد بصرمته","r":"437069","v":[["8F11E1C3-F29C-5B3E-A8BA-D3E30B20F27C","أودَى ابن جُلهمَ عبادٌ بصرمَتهِ","إن ابن جُلهمَ أمسى حَيةَ الوادِي"]]},"F5C0FFF3-92BB-548F-B2A9-F05131278F49":{"t":"أَحَقاً بني أبناء سَلمَى بن جَندلٍ","p":25,"s":"أحقا بني أبناء سلمى بن جندل","r":"437090","v":[["480EF680-7189-5D4D-A85A-23EC483FE8F7","أَحَقاً بني أبناء سَلمَى بن جَندلٍ","وعيدُكُمُ إيايَ وَسطَ المجالسِ"],["422430CD-3AFF-5908-A13A-4109E7F2355B","فهلا جَعلتم نحوهُ من وَعيدكم","على رهط قعقاعٍ ورهط ابن حابسِ"],["8EB3704D-F756-5858-B097-B52E12B611FE","هُمُ منعوا منكم تراثَ أبيكم","فصار التراثُ للكرام الأكايسِ"],["A89DA515-2F57-5CC4-9D1C-A66F2E94A77B","هُمُ أوردوكم ضَفّةِ البحرِ طامياً","وهُم تركوكم بين خازٍ وناكسِ"]]},"6D37745F-72AA-54EF-A7A3-43328428E88D":{"t":"أَسِدِّي يا مَنِيُّ لِحِميَرِيٍّ","p":25,"s":"أسدي يا مني لحميري","r":"437083","v":[["ACD977B7-3AF6-5444-9A68-D9A16A0C2704","أَسِدِّي يا مَنِيُّ لِحِميَرِيٍّ","يُطَوِّفُ حَولَنا ولَهُ زَئيرُ"]]},"C25D7985-52B2-59E4-805D-6A3F54F9033D":{"t":"أَلا مَن لامَني إِلا صديقٌ","p":25,"s":"ألا من لامني إلا صديق","r":"437072","v":[["5CD97A2B-B198-5EB1-A3C5-7EEDF838516A","أَلا مَن لامَني إِلا صديقٌ","فَلاقى صاحِباً كأَبي زِيادِ"]]},"BD4D27A2-5CE5-5E03-8294-6DBC20C6BFD8":{"t":"إن الأكارم من قريش كلها","p":25,"s":"إن الأكارم من قريش كلها","r":"437121","v":[["A373E1B8-16B4-5C54-B4FC-6243DB524CC1","إن الأكارم من قريش كلها","قاموا فراموا الأمر كلَّ مرامِ"],["FFF2991B-2B52-5625-93D0-B2422D2C5C43","حتى إذا كثر التحاولُ بينهم","فَصَلَ الأمور الحارث بن هشامِ"],["412815CF-44AF-5F61-B0F1-B14FC1D8A5D1","وسما ليثرب لا يُريد طعامها","إِلا ليصبح أهلها بسوامِ"],["370CE712-4638-51ED-AC24-D287516ABEF1","فرَّت يهود وأسلمت جيرانها","صَمِّي لما لقيت يهود صَمامِ"],["9BA812DA-8299-5DC0-B2AD-66632FCEA6C5","ودعا بمُحكمةٍ أمين سكها","من نسج داودٍ أبي سلامِ"],["CC82EE3D-F939-5D85-AF00-105C85080A4A","فكأن مزحفهم مناقف حنظلٍ","لعبَ الرئال به وخيطُ نعامِ"]]},"9C5CFB9F-53F4-5B62-A62F-55B4C75BE0E4":{"t":"إنا ذممنا على ما خَيَّلت","p":25,"s":"إنا ذممنا على ما خيلت","r":"437119","v":[["3BE24278-2F20-5439-A3E0-FF26E8FFBFC1","إنا ذممنا على ما خَيَّلت","سعد بن زيد وعمرو من تميم"],["DBD02234-7541-58B0-A871-BA8BF5E3F0BF","وضَبةُ المُشتري العار بنا","وذاك عَمُّ بنا غير رحيم"],["50FC44BA-540B-5475-B68A-B14CE5B6B8B8","لا ينتهون الدهر عن مولى لنا","قورك بالسهم حافاتِ الأديم"],["6DDC071A-6C39-5B7E-A282-9522028EACA7","ونحن قوم لنا رماحُ","وثروة من مُوالٍ وصميم"],["E4F462A7-B25F-5FED-A063-B988524BC438","لا نشتكي الوصم في الحرب ولا","نئن منها كنأنان السليم"]]},"F87DBA51-BA28-52B6-BFBE-90290DCB2BAD":{"t":"إنَّ امرأً مَولاهُ أدنى داره","p":25,"s":"إن امرأ مولاه أدنى داره","r":"437070","v":[["47E52905-3139-5026-B716-EA0C7CB03B11","إنَّ امرأً مَولاهُ أدنى داره","فيما ألمّ وشَرهُّ لكَ بادِي"],["D34111E4-3E1B-578A-819F-7C2A604F6C0A","إن قُلتَ خيراً قال شراً غيرَهُ","أو قُلتَ شراً مَدهُ بمدادِ"],["643653B1-1E6A-5C59-BDF5-4604F99F7A3B","فلئِن أَقَمت لأظعنَنَّ لِبَلدةٍ","ولئِن طعنتَ لأرسِين أَوتادي"],["A10D3220-8822-55AF-8137-9CD8D862B775","كانَ التفرقُ بَينَنا مِن مِئرَةٍ","فاذهَب إِليك فقَد شفيتَ فُؤادي"]]},"C7F218BE-7017-5931-8711-52E8B955F706":{"t":"اللاتِ كالبيضِ لما تَعدُ أن دَرَست","p":25,"s":"اللات كالبيض لما تعد أن درست","r":"437079","v":[["978D558E-2123-5F80-9A8E-DA47F50333FA","اللاتِ كالبيضِ لما تَعدُ أن دَرَست","صُفرُ الأَنامِل مِن نَقفِ القواريرِ"]]},"E85A1170-F5BE-5FD0-9BA2-702433417F81":{"t":"تَلَقّاهُ المُلوكُ فأَوجَهُوهُ","p":25,"s":"تلقاه الملوك فأوجهوه","r":"437084","v":[["2BE28C75-7460-5CB4-A8CE-A54F04CF7649","تَلَقّاهُ المُلوكُ فأَوجَهُوهُ","وَحَطَّت عِندَهُ بِالأَمسِ عِيرُ"]]},"944B9009-39C4-5A57-940A-79C67BA197F7":{"t":"تُقَسِّمُ ما فيها فإن هي قَسمت","p":25,"s":"تقسم ما فيها فإن هي قسمت","r":"437081","v":[["24F1958E-1B6C-56C7-A1AA-11E1E828A292","تُقَسِّمُ ما فيها فإن هي قَسمت","فذاكَ وإِن أكرَت فعن أهلها تُكري"]]},"A13073D1-39E8-5893-B107-22B244533062":{"t":"جُنّيتَ خاويةَ السلاح وكلمهُ","p":25,"s":"جنيت خاوية السلاح وكلمه","r":"437114","v":[["6A9D420B-68EE-571C-8154-4654F7CF981E","جُنّيتَ خاويةَ السلاح وكلمهُ","أبداً وجانب نفسك الأسقامُ"]]},"2DC57AF0-5C48-5D78-A693-CE497FB0462A":{"t":"خالي ابنُ فارِس ذي الوُقوف مُطلقٌ","p":25,"s":"خالي ابن فارس ذي الوقوف مطلق","r":"437067","v":[["1AC940F1-8257-5336-98B3-D225484C7077","خالي ابنُ فارِس ذي الوُقوف مُطلقٌ","وأبي أبو أَسماءَ عبدُ الأسودِ"],["9D9E3CEA-435A-5B19-979D-983E4BF95507","نَقَمت بنو صَخرٍ عليَّ وجَندل","نسبٌ لَعمرُ أبيكَ ليس بقُعددِ"]]},"F71D5536-1C11-53C2-92E4-4331FCC65342":{"t":"سَمَا بَصَري لما عَرفتُ مكانَهُ","p":25,"s":"سما بصري لما عرفت مكانه","r":"437092","v":[["78D7F013-23ED-5863-9D3E-E055C9F5D439","سَمَا بَصَري لما عَرفتُ مكانَهُ","وأطّت إليَّ الواشجاتُ أطيطا"],["2EB0E150-18D4-5FF7-ACE0-4536D2C38224","علوتُ بذي الحياتِ مَفرقَ رأسِه","فخرَّ كما خرَّ النساءُ عَبيطا"],["7727F970-8252-58C7-BE99-B2B471C7C702","فأبلغ بني سَعدِ بن عجلٍ بأننا","حذوناهُمُ نَعلَ المثال سَميطا"],["FCDFDD2A-2D8D-547C-B304-BC099757786D","وجهمان وكلنا بذكرة وائلٍ","يبيتُ إذا نام الخليُّ وقيطا"],["70EE7564-2A06-5E94-B5CF-5F3D891CDE43","فدى لك أمي يوم تضربُ وائلا","وقد بلّ ثوبَيه النجيعُ عَبيطا"]]},"A01EEE33-683C-5B84-B96C-DC2468AF0635":{"t":"سَيجرحُ جُراحُ وأعقلُ ضَيمهُ","p":25,"s":"سيجرح جراح وأعقل ضيمه","r":"437059","v":[["5D1F9410-D3CE-5E6D-B94D-26E50EF89328","سَيجرحُ جُراحُ وأعقلُ ضَيمهُ","إذا كان مَخشياً من الضلع المُبدي"],["E51A11CA-1EF3-5051-9BD3-AB0A162F597A","فآباءُ جَرّاحٍ ذؤابةُ دَارِمٍ","وأخوالُ جَراحٍ سراةُ بني نَهدِ"]]},"8B80D4A2-1AAA-5F49-8A03-E0EB57608662":{"t":"صَحا سكرٌ منه طويل بزينَبا","p":25,"s":"صحا سكر منه طويل بزينبا","r":"437061","v":[["BC02DA6C-4CFB-5CDD-AFB5-F1A667E9DA5A","صَحا سكرٌ منه طويل بزينَبا","تَعاقَبهُ لما استبانَ وَجرّبا"],["8B789663-6F5E-5288-84E9-4B4F79377F68","وأحكمهُ شيبُ القَذالِ عن الصبا","فكيف تصابيه وقد صارَ أَشيبا"],["7BE642CA-2AB0-5E1F-86C6-29B9E2AF6914","وَكان لهُ فيما أفادَ حلائِلٌ","عَجَلنَ إذا لاقينهُ قُلنَ مرحبا"],["CE62B6D4-6E03-5DA6-853D-8E3E5A7EEE7E","فأصبحنَ لا يسألنه عن بما به","أصعَّدَ في عُلو الهوى أم تصوَّبا"],["A1B08ED3-1EF1-5AC7-AA98-504A3E4B990E","طوامحُ بالأبصار عنه كأنما","يَرينَ عليه جُلَّ أدهمَ أجرَبا"],["8B150FE8-D5D9-5D51-857D-85BFACEA29F2","فألآنَ إذ هازَلتُهنَّ فإنَّما","يَقُلنَ ألا لم يذهب المرءُ مَذهَبا"]]},"457E91BE-9925-53C1-B39F-69586D9CC368":{"t":"غَدا فتيا دَهرٍ ومَرَّ عليهمُ","p":25,"s":"غدا فتيا دهر ومر عليهم","r":"437058","v":[["9072A8E1-CA7E-5DA9-B294-B9E915536934","غَدا فتيا دَهرٍ ومَرَّ عليهمُ","نهارٌ وليلٌ يَلحقانِ القرائِبا"],["02367B18-5AB9-5510-A9D9-7DA2E8F7ACAD","إذا لَقيا حَيّا جميعا بغبطةٍ","أناخَ بهم حتى يُلاقُوا العَجائِبا"]]},"49F1A264-9468-5C32-AB71-D9F74D70F9E0":{"t":"فأدرك إبقاء العرادة ظَلعُها","p":25,"s":"فأدرك إبقاء العرادة ظلعها","r":"437093","v":[["69596133-E40A-563E-97C9-7FA7ECC50CFA","فأدرك إبقاء العرادة ظَلعُها","وقد جعلتني من حُزيمةَ أصبعا"],["AD29823F-4B8D-508A-A6CF-18132F398E97","فإن تنج منها يا حَزيم بن طارقٍ","فقد تركت ما خلف ظهري بلقعا"],["C0C278EB-805C-5FD1-99F1-B3D3D4D6358C","إذا المرء لم يغش الكريهة أوشكت","حيال الهوينى بالفتى أن تقطعا"]]},"565A4F50-78C8-5F6B-B67A-2E8DB3D92246":{"t":"فأدِّ حُقوقَ قَومِكَ واجتَنِبهُم","p":25,"s":"فأد حقوق قومك واجتنبهم","r":"437077","v":[["346844B3-F500-5272-82A6-B31FADE85426","فأدِّ حُقوقَ قَومِكَ واجتَنِبهُم","وَلا يطمع بكَ العِزُّ الفطيرُ"]]},"2348C2D8-3488-5872-8D31-892A90A458DE":{"t":"فإما أن تمرَّ على شُريبٍ","p":25,"s":"فإما أن تمر على شريب","r":"437109","v":[["1FE3A8CA-4089-5283-8324-0698282B9153","فإما أن تمرَّ على شُريبٍ","وخَمّانٍ وتنتحي الشمالا"],["829DD3EF-BB12-56B1-8564-65D03560420F","وإما أن تزاور نحو رَهبَى","وتنتعل الشقائق والرمالا"],["7C30D64B-BD03-57F1-9E7D-C43EC9D728DC","بأظفارٍ له حُجنٍ طِوالٍ","وأنيابٍ له كانت كِلالا"]]},"E11AFF81-F709-5959-8412-6B843A466FD7":{"t":"فلنهشَل قَومي ولي في نَهشَل","p":25,"s":"فلنهشل قومي ولي في نهشل","r":"437060","v":[["C3A18561-497F-59F2-A8D4-10AFC44E7A87","فلنهشَل قَومي ولي في نَهشَل","تَغني الولدان والملعَبِ"]]},"311E86C5-6CA9-5B88-9F82-ED67AB78C021":{"t":"فنادِ أباكَ يُورد ما عليه","p":25,"s":"فناد أباك يورد ما عليه","r":"437082","v":[["2F9BA0E1-77B7-53E1-96FD-93914AC190F5","فنادِ أباكَ يُورد ما عليه","فإن الماءَ أيمَنُ أو جُبارُ"],["4150B92C-59AE-59A2-9BD0-7100C5342B91","وصَعّد إن أصلك من مُعالِ","بِبَيذخَ حيث تعرفُكَ الديارُ"]]},"74C9D366-5656-5E28-B0F3-45D959740569":{"t":"فَتىً يَشتَري حُسنَ الثَّناء بِمالِه","p":25,"s":"فتى يشتري حسن الثناء بماله","r":"437078","v":[["B0A6B2B3-EFD8-5CB0-9380-336CADCE8419","فَتىً يَشتَري حُسنَ الثَّناء بِمالِه","إِذا السنةُ الشهباءُ أعوَزها القطرُ"]]},"5E208356-9622-5480-B8D2-34421AD5294D":{"t":"فَما لكَ عَيني خارِئٍ في هَشيمهِ","p":25,"s":"فما لك عيني خارئ في هشيمه","r":"437088","v":[["2F949CBE-AFBF-5432-9365-0924DCFA4CC6","فَما لكَ عَيني خارِئٍ في هَشيمهِ","رأي حَيَّةً في جُحرها فَهو يَزجُرُ"]]},"E3E02678-2C33-5D38-A415-DEB7AB9BD038":{"t":"قالت له أم صمعا إذ تؤامره","p":25,"s":"قالت له أم صمعا إذ تؤامره","r":"437107","v":[["AE5CA404-78C9-5BC9-96DB-9231BF54C6FD","قالت له أم صمعا إذ تؤامره","ألا ترى لذوي الأموال والهلك"]]},"E510F3E9-86EC-57C0-8E6E-A9F8211A664E":{"t":"قد أصبح الحبل من أسماء مصروما","p":25,"s":"قد أصبح الحبل من أسماء مصروما","r":"437123","v":[["3CF8AE3B-A844-5E08-B620-D8FE33DB0414","قد أصبح الحبل من أسماء مصروما","بعد ائتلافٍ وحب كان مكتوما"],["1AA0D0EF-CEFD-5A21-9624-C4BDD29BF671","واستبدلت خلة مني وقد علمت","أن لن أبيت بوادي الخسف مذموما"],["F1B8AE2A-7A2F-56B7-817A-53BEF85A3801","عفّ صليب إذا ما جُلبَةٌ أرمت","من خير قومك موجوداً ومعدوما"],["5672D6EC-97D5-5A24-A393-3DC771441FAA","لما رأت أن شيب المرء شاملهُ","بعد الشباب وكان الشيب مسؤوما"],["D68453AC-CF4D-5612-94B5-E909E045EE68","صدت وقالت أرى شيباً تفرعه","إن الشباب الذي يعلو الجراثيما"],["6AD891E2-726C-568F-9478-8AB1E1778EFE","كأن ريقتها بعد الكرى اغتبقت","صرفاً تخيرها الحانون خرطوما"],["762CBF57-CF28-5794-8041-E040A5397D31","سلافة الدَّن مرفوعاً نصائبه","مقلَّد الغفو والريحان ملثوما"],["D7851C05-B702-5EFB-948E-9A750CB61BE1","وقد ثوى نصف حولٍ أشهرا جددا","بباب أفأن يبتار السلاليما"],["95E48307-2840-51CE-9579-B6F15FB9B169","حتى تناولها صهباء صافية","يرشو التجار عليها والتراجيما"],["F4C2B959-A02A-512D-A8C9-A9C35CEFE432","وسمحةٍ المشي شملال قطعت بها","أرضاً يحار بها الهادون ديموما"],["0DC0505A-393D-51B0-8F56-B7A7958DB0E7","مهامهاً وخروقاً لا أنيس بها","إِلا الضوابح والأصداء والبُوما"]]},"CB509762-516D-5BC6-A156-537931611BF4":{"t":"قَد كُنتُ أهدي ولا أُهدى فَعَلَّمني","p":25,"s":"قد كنت أهدي ولا أهدى فعلمني","r":"437076","v":[["02C5513C-B32E-58A6-BE32-C1C7C2460069","قَد كُنتُ أهدي ولا أُهدى فَعَلَّمني","حُسن المَقادة أني أفقدُ البَصَرا"],["174E8B08-CE6C-59AD-A3BC-1EE793D9DDA4","أَمشِي وأقبعُ جُنّاباً ليَهدِيني","إن الجنيبةَ مما يَجشمُ الغَدرا"]]},"003FD583-7F36-50A6-B99D-015A284AE18E":{"t":"كأنك صَقبٌ من خلاف يُرى له","p":25,"s":"كأنك صقب من خلاف يرى له","r":"437110","v":[["A9E155FB-7FFB-5B51-9113-142A9BF6E742","كأنك صَقبٌ من خلاف يُرى له","رواء وتأتيه الخؤورة من عَل"]]},"9C5B2DF5-9B56-557C-AB12-8DFB3CBD2EEC":{"t":"كم فاتني من كريمٍ كان ذا ثقةٍ","p":25,"s":"كم فاتني من كريم كان ذا ثقة","r":"437108","v":[["0B93F35B-3D08-54AA-9116-DF702F5610ED","كم فاتني من كريمٍ كان ذا ثقةٍ","يذكي الوقود بجمدٍ ليلة الحلل"]]},"6F498910-415B-5CBE-ACC9-F9156E33FFFD":{"t":"كَذَبتُ عليكَ لا تَزالُ تَقُوفني","p":25,"s":"كذبت عليك لا تزال تقوفني","r":"437101","v":[["F2BED365-D5F1-59CA-B20C-C1D8EEF83B7B","كَذَبتُ عليكَ لا تَزالُ تَقُوفني","كما قافَ أثارَ الوسيقةِ قائِفُ"]]},"A40128C5-3D52-5D7F-AC7F-ABEB6B2C0BE6":{"t":"لا أبتغي عنهم ولا أُشريهم","p":25,"s":"لا أبتغي عنهم ولا أشريهم","r":"437064","v":[["2AA57634-B615-5109-9A9C-0BDB0AE23219","لا أبتغي عنهم ولا أُشريهم","حتى يُلاقيني حمامُ مماتي"],["9E78DF5A-DEAA-5767-89A7-5382B959B13C","ليسوا بأنذالٍ ولا بأشابةٍ","فيما ينوبُ القومَ لا باللاتِ"]]},"17F363B6-8C7B-5CA8-BC5C-03562FD47037":{"t":"لا يعتري شُربَنا اللحاءُ وقد","p":25,"s":"لا يعتري شربنا اللحاء وقد","r":"437112","v":[["5FEAEA74-B76C-5B94-90B6-EBC2BE596D95","لا يعتري شُربَنا اللحاءُ وقد","توهب فينا القيانُ والحُلَل"],["0914EB52-1B11-5271-9C9F-A5C76D62C993","وفتية كالسيوف نادمُهُم","لا عاجز فيهم ولا وكلُ"],["9DD4D859-030A-54DC-9F12-C7F6D54CD21A","بيض مساميح في الشتاة وأن","أخلفَ نجمٌ عن نوئه وكلوا"],["1FCED5F3-C387-555F-A1F1-74A6D90EC461","لا يثأرون في المضيق وإن","نادى مُنادٍ كي ينزلوا نزلوا"]]},"6FDC228F-BE67-5094-A38D-484F9AE5F6CC":{"t":"لعَمرُكَ ما أدري وإِن كنتُ دارِيا","p":25,"s":"لعمرك ما أدري وإن كنت داريا","r":"437085","v":[["E7927212-E0C2-5C69-90BB-01372E34BE2D","لعَمرُكَ ما أدري وإِن كنتُ دارِيا","شُعيثُ بن سَهمٍ أم شُعَيثُ بن مِنقرِ"]]},"8360BBB1-E396-5149-9D13-C7815CC78287":{"t":"لها وَركا عنزٍ وساقا نعامةٍ","p":25,"s":"لها وركا عنز وساقا نعامة","r":"437054","v":[["CBACC361-4864-57AB-A3F5-F8D0CAF0700E","لها وَركا عنزٍ وساقا نعامةٍ","وأسنانُ خِنزير ومكشرُ أرنبِ"]]},"C1009804-057F-5BBE-8CD4-0D35E28B339E":{"t":"لهوتُ بسربال الشباب مُلاوة","p":25,"s":"لهوت بسربال الشباب ملاوة","r":"437105","v":[["3B5E6702-070E-5D83-8381-A292773FE56D","لهوتُ بسربال الشباب مُلاوة","فأصبح سربال الشباب شبارِقا"],["488C96F7-CDD1-51ED-B780-E79EFDD2AAF6","فأصبح بيضات الخدور قد اجتوت","لداتي وشمن الناشئين الغرانِقا"],["349F723F-3C08-5EF6-8E54-CD0CA22721F4","فأقسمت لا أشريه حتى أملَّه","بشيء ولا أملاه حتى يفارِقا"]]},"87CD43D2-8D1E-531A-90F4-4A729A0D36C9":{"t":"ليَبكِ عقالاً كلّ كِسر مؤربٍ","p":25,"s":"ليبك عقالا كل كسر مؤرب","r":"437099","v":[["E511AEAA-E493-55AE-A3F8-C7C9A2EA3986","ليَبكِ عقالاً كلّ كِسر مؤربٍ","مذاخره للأكل المتحيِّف"],["E6FF25A8-C2AD-550B-8273-A67BD304C275","فتجعل أيدٍ في حناجرَ أُقنعت","لعادتها من الخزير المُغرَّف"],["1A86E1CC-78B9-5F34-B481-1BC52233A514","وكُنتُ إذا ما قربَ الزادُ مُولعاً","بكل كُميت جِلدة لم يُوسِّف"],["C07318FA-2CAB-568A-BDB7-17A408C07B3D","مُداخلةَ الأقرابِ غير ضئيلةٍ","كُميت كأنها مزادة مخلف"]]},"5739D9BD-994C-5E2A-903A-EED6A2F204E2":{"t":"ماذا وقوفي على رسمٍ عفا","p":25,"s":"ماذا وقوفي على رسم عفا","r":"437122","v":[["B565A8FB-F6ED-5AE3-95B6-2F78D969A431","ماذا وقوفي على رسمٍ عفا","مُخلَولق دارسٍ مُستَعجم"]]},"5C174A03-3F2F-502F-B527-E067179633DC":{"t":"نامَ الخليُّ وما أُحسّ رُقادي","p":25,"s":"نام الخلي وما أحس رقادي","r":"437073","v":[["CB4ABBF8-7979-571D-9CB9-F2CC44AE4149","نامَ الخليُّ وما أُحسّ رُقادي","والهمُّ مُحتَضرٌ لَدَي وِبادي"],["49296752-A828-5475-AC70-9963FB16BF6D","من غير ما سَقمٍ ولكن شفّني","همٌّ أراهُ قد أصابَ فؤادي"],["85F3F6F6-61D7-593D-A895-53B17582BBB1","وَمن الحوادث لا أبالك أنني","ضُربت عليَّ الأرضُ بالأسدادِ"],["2F765F7B-C1D8-593B-BB41-2DBAFD226833","لا أهتدي فيها لِموضع تَلعَةٍ","بينَ العراق وبين أرض مُرادِ"],["66666AC3-4D26-5045-A3A7-25C4837043AC","ولقد علمتُ سِوى الذي نبأتِنى","أنَّ السبيلَ سبيلُ ذي الأعوادِ"],["867D61AE-B9B8-54F4-926D-BBCEBA73414E","إن المنيّةَ والحتُوفَ كلاهما","يُوفي المخارمَ يرقيان سوادي"],["0CBE5C43-C892-5D61-8F2A-E26013DB3B3D","لن يَرضيا مني وفاءَ رَهينةٍ","من دُونِ نَفسي طارفي وتِلادى"],["902C1117-2811-5466-A7F6-EE3FBE9105F7","ماذا أُؤملُ بَعدَ آلِ مُحرِّقٍ","تَركوا مَنازِلَهُم وبعدَ أيادِ"],["0D49968B-7D0B-596C-814F-7D613AF20010","أهل الخَوَرنق والسدير وبَارقٍ","والقصر ذي الشُرُفاتِ من سندادِ"],["9197E069-29EE-5F90-8850-B69BB50D82C7","أرضاً تخيّرها لدار أبيهم","كعبُ بنُ مامَة وابنُ أمِّ دُؤادِ"],["387E4709-DE03-54B0-A24F-6DBD6F0EFC3E","جَرت الرياحُ على مكان ديارهم","فكأنما كانوا على ميعادِ"],["6F605A16-8C7A-5622-B411-51DC414E5C05","ولَقد غَنوا فيها بأنعَم عيشةٍ","في ظلِّ مُلكٍ ثابت الأوتادِ"],["520366C9-01F5-52DE-8220-E2066136F3E5","نَزلوا بأنقرة يسيلُ عليهمُ","ماءُ الفراتِ يجيءُ من أطوادِ"],["8C32EED2-0685-55AA-BF15-BF0A49197036","أين الذَين بنوا فطال بناؤهم","وتَمتّعوا بالأهل والأولادِ"],["6123F64F-C35C-5E7C-9608-BD58715BC7EF","فإذا النعيمُ وكلُّ ما يُلهى به","يوماً يَصيرُ إِلى بِلى ونفَادِ"],["760404CE-9919-52DA-98B8-99353CC77752","في آل غَرف لو بَغيتَ لي الأسى","لوجدتَ فيهم أسوةَ العُدّادِ"],["C28A706B-DE64-5F15-A8A6-98CBF3CD6E9C","ما بَعد زَيد في فتاةٍ فُرّقوا","قتلاً ونفياً بعدَ حُسنِ تآدي"],["90E554A6-8ED1-53CF-AA6F-58A75B54F564","فتخيَّروا الأرض الفضاءَ لِعزّهم","ويَزيدُ رافدُهم على الرُفادِ"],["F0CC2FCE-E824-5795-93E5-D54CEFED222A","أما تَريني قد بَليتُ وغاضَني","ما نيل من بَصَري ومن أجلادي"],["F4D3F641-82B3-58FA-BA62-F00FA3FC4BAC","وعَصيتُ أَصحابَ الصَّبابةِ والصّبا","وأطعتُ عاذلتي ولانَ قِيادي"],["807E6BDE-647C-5934-A7F5-E02B6CAA8F58","وَلقد أروُح عَلى التّجار مُرَجِّلاً","مَذِلاً بِمالي لَيِّناً أَجيادي"],["2426F326-ADA6-533B-B1BE-DCCE100C7FE8","ولقد لَهوتُ وللشباب لذاذةٌ","بسُلافَةٍ مُزجَت بماءِ غَوادي"],["37B7EE78-9002-5AF9-AB7D-3F86FE5A6FCE","من خَمر ذي نَطف أغَنَّ مُنطق","وافى بها لدراهِم الأسجادِ"],["0FAE8FC4-5E48-5CF8-8C3A-DB0C5F637457","يَسعى بها ذو تُومتين مُشَمِّرٌ","قنَأَت أناملُهُ منَ الفُرصادِ"],["B56190AF-2B43-5CE7-B32E-941C2ACE219E","والبيضُ تَمشي كالبدُورِ وكالدُّمى","ونواعمٌ يَمشينَ بِالأَرفادِ"],["DF306A13-C29D-501B-82D1-4C64D4F5AB73","والبيضُ يَرمينَ القلوبَ كأنَّها","أُدحِيُّ بينَ صَريمةٍ وجَمَادِ"],["D8A73CC0-F31F-5F23-BF78-1E77155929D6","يَنطقنَ مَعرُوفاً وهُنَّ نَواعِمٌ","بيضُ الوُجوهِ رقيقةُ الأكبادِ"],["C86B541C-7359-5A54-A431-489A334032F8","يَنطقنَ مخفوضَ الحديثِ تَهامُساً","فَبلَغنَ ما حاوَلنَ غَير تَنادي"],["EC3EB00B-78A2-5210-82F0-2C230571B1BC","ولَقَد غَدوتُ لِعازبٍ مُتَناذِرٍ","أَحوَى المَذانبِ مُؤنَق الرّوادِ"],["CA8DFD8C-DA26-502D-AB58-6E5FC56B106E","جادَت سَواريهِ وآزرَ نبتُهُ","نُفأً مِن الصَّفراءِ والزُّبادِ"],["9D19A37A-BB33-5B5E-AB1D-AA245990B1F7","بالجو فالأموات حَول مغامرٍ","فبِضارج فقصيمَة الطُّرادِ"],["18C4CB88-B7FA-5ACC-AEB0-6A235F2D582F","بمُشَمرٍ عِند جَهيز شدُّهُ","قيد الأوابدِ والرهانِ جوادِ"],["D22704DA-4395-55EE-A340-0330760F3873","يشوي لنا الوحَدَ المُدلَّ بحُضرهِ","بشريج بين الشدِّ والإيرادِ"],["E0835B9C-713A-510A-9201-062839CE6384","ولَقد تلوتُ الظاعِنينَ بجسرةٍ","أجد مهاجرةِ السقَاب جَمادِ"],["732ABA30-CE5A-54A3-A253-D7DB2889095F","عَيرانةٍ سَدّ الربيعُ خصاصَها","ما يَستبين بها مَقيلُ قُرادِ"],["E57FBA7B-AD5A-55BB-A7B8-B0E75C067A7A","فإذا وذلك لا مهاهَ لذِكرهِ","والدهرُ يُعقبُ صالِحاً بفسادِ"]]},"39886626-8CC4-5FA3-9FF9-52B6FC9FE5C5":{"t":"نجوت بقُوف نفسكَ غير أني","p":25,"s":"نجوت بقوف نفسك غير أني","r":"437118","v":[["0D245E24-187D-58EC-A568-E7AC86CE0E83","نجوت بقُوف نفسكَ غير أني","أخالُ بأن سَتيتم أو تئيمُ"]]},"EB6FB061-A9F0-5785-A459-A33DD9C1D06F":{"t":"نفع قليلٌ إذا نادى الصدى أُصلا","p":25,"s":"نفع قليل إذا نادى الصدى أصلا","r":"437071","v":[["E03B4FF5-728F-5BED-AA90-1C589084858E","نفع قليلٌ إذا نادى الصدى أُصلا","وحانَ منه لبرد الماء تَغريد"],["0B37A6AE-3D37-5616-A0E5-42F4A7F68A3F","وودعوني فقالوا ساعة انطلقوا","أودى فأودى النَدى والحزم والجود"],["90AEF289-8F00-5C20-B06D-70309BD73513","فَما أُبالي إذا ما مت ما صَنعُوا","كلُّ امرئ بسبيل الموت مرصود"]]},"4C02AB58-EDA8-58A2-9038-99BDDC70DE9D":{"t":"هَل بالمنازِل إن كلّمتها خَرسُ","p":25,"s":"هل بالمنازل إن كلمتها خرس","r":"437091","v":[["B84EE671-67ED-5E00-80F2-A6C0133D3300","هَل بالمنازِل إن كلّمتها خَرسُ","أم ما بيانُ أثاف بينَها قَبَسُ"],["DF884020-D679-5322-91EC-97BC78ADC1C6","كالكُحل أسودَ لأياً ما تكلمنا","مما عفاه سحابُ الصَيّف الرجسُ"],["B5A4262E-D39A-59DF-83AF-B05E9734EFBE","جَرَّت بِها الهَيف أذيالاً مظاهرة","كما تجرُّ ثيابَ الفُوَّة العُّرُسُ"],["50A69F44-875F-5DC9-AFE7-A52D1243851E","والمالِكيّة قد قالت حكمت وقد","تشقى بك الناقة الوجناء والفرسُ"],["B45A3DED-9BDC-5AEB-A6C3-F05FBDFFA0DE","فقلتُ إن أستفد حلماً وتجربةً","فقد تَردد فيكَ البخلُ والألسُ"],["B494A649-BF47-5C20-AB95-BA2E187A59D2","وقد يُقصّر عني السير آونةً","بزيزل سَهوة التَبغيل أو سدسُ"],["E41218D5-7EC2-5CBE-8273-82F5EAB3A3CD","لأياً إِذا مَثل الحرباء منتصبا","من الظهيرة يثني جيدها المرسُ"],["F626FBD4-7A38-58C1-8765-2E4CEDC18627","تلقى على الفرج والحاذين ذا خَضَلٍ","كالقِنو أعلق في أطرافه العبسُ"],["50139789-A2BD-5626-A7EC-64A248AF1159","كأنه ناشطٌ هاج الكلابُ به","من وحش خَطمة في عرنينه خنسُ"],["4581766D-FAA5-546D-9849-6551C4C3264D","بانت عليه من الجوزاء أسميَةٌ","وقيل بالسبَط العاميّ يَمترسُ"],["3D79FA26-9F1A-5DB6-93A4-8183F9636D64","ثم أتى دف أرطاةٍ بحَنينَةٍ","من الصريمة أواه لها الدّلسُ"],["34E22064-1E49-5F95-9076-3DD87C8A9237","منبوذة بمكان لا شعارَ به","وقد يصادف في المجهولة اللمسُ"],["91FCB037-0B88-5AB5-BB4F-8DE6D612DF43","عَبرته بين أنقاء حنون لها","من الصَريمةِ أعلى تُربها رهسُ"],["1DB45F11-7C05-5194-AA9C-A3781A9F3283","فاجتابها وهو يخشى أن يلطّ به","خوف على أنفِه والسمعُ مُحتَرسُ"],["A2CB65CD-DE21-5B24-B9D9-CC2BCDECCD66","يَبري عروقاً ويُبدي عن أسافِلها","كما تليّن للخَرانة الشرسُ"],["3BAFBA62-5308-5E78-9BB9-E3CD5A7136FA","حتى إذا ما انجلت ظلماء ليلته","عند الصباح ولم يستوعب الغلسُ"],["BBBA324C-7182-5884-9D39-0F821AF919AD","ومارَ يَنفُضُ رَوقيه ومَتنتَهُ","كما تهزهزَ وقفُ العاجة السَّلسُ"],["4BA02067-A31C-5208-BBD1-D252A6ED5AE1","هاجَت به فئةٌ غُضفٌ مُخرَّجَةٌ","مثلُ القداح على أرزاقِها عُبُسُ"],["28C3B552-305E-5C23-99AE-778EFA074A6F","وفاجأتهُ سَرايا لا زعيمَ لها","يَقدُمنَ أشعثَ في مارية طَلسُ"],["7822586F-DBF2-5363-8B0E-4119BBB9C9D3","مُعصَّباً من صباحٍ لا طعامَ له","ولا رَعيّةَ إِلا الطوفُ والعَسسُ"],["028A5739-038C-52FA-BCA2-154E4EE3D117","فكرَّ يَحمي برَوقيه حقيقتَهُ","به عليهنّ إذ أدركنهُ شمسُ"],["B0318B0B-EADC-5DEF-91FB-65506BF0AE78","ما إن قليلاً تجلّى النقعُ عن سنَد","وزارع غير ما إن صادَ منبجسُ"],["31CCA6C0-277E-5080-A7D8-95DD60F12A8C","ومن دفاف تُحيت الجنب نافذَةً","حمراءُ يخرجُ من حافاتِها النفسُ"],["044C9D28-B3C1-5F01-A79E-EBFFD75389D0","ثم تولّي خفيفات قوائمهُ","بالسَّهل يطفو وبالصحراء يمّلسُ"],["6A2B5825-A379-5977-9B78-792F7192072A","وقد سَبأتُ لفتيان ذوي كرمٍ","قبل الصباح ولَما تُقرع النُقُسُ"],["00C7A9EB-CB1B-5859-8F41-71A5DDAECAF2","صرفاً وممزوجةً كأن شاريها","وإن تشدّد أن يهتابَه هَوَسُ"],["89EE7B51-795A-5E7F-88C5-0BBB417437BF","ثمَّ ظلِلنا تغنّي القومَ داجِنةٌ","لعساءُ لا ثَعَلٌ فيها ولا كَسَسُ"],["DED4BE08-B3F3-5197-9669-0899B991D4B9","ومُسمعاتٌ وجُرد غيرُ مُقرفةٍ","ثم السنابك في أكتافها قَعَسُ"],["60372AC7-AFBE-53A8-AB03-B51B05B9E1CD","وجاملٍ كزُهاءِ الّلاب كلّفَه","ذو عَرمَضٍ من مياه القهر أو قُدسُ"],["B6A0A22E-8125-5BC7-8EC2-FA509D757967","ماء قصير رِشَاءِ الدَّلو مُؤتَزِراً","بالخَيزُرَانة لا مِلحٌ ولا نَمسُ"],["E0726521-3911-54F7-BC37-68E5291F4266","تُوفي الحمامُ عليه كلَّ ضاحيةٍ","وللضفادِع في حافاته جَرَسُ"],["E9BE1C73-F2AA-593A-90E9-D1E697C5A985","أَتى الصَريخ وسِربالي مظاهرةٌ","من نسج داود يجلو سكّها اللبسُ"],["ADC6CA52-3C52-5C6D-B5B2-E6398743E89F","تغشَى البنان لها صوت إذا انبَجست","كما استخفَّ حصيدَ الأبطح اليبسُ"]]},"4445E5B9-FB68-5FF6-865F-699538CEE485":{"t":"هَل لِشبابٍ فات من مَطلب","p":25,"s":"هل لشباب فات من مطلب","r":"437055","v":[["C6943D3C-6A32-55FC-A59A-7D3378A27203","هَل لِشبابٍ فات من مَطلب","أم ما بُكاءُ البائسِ الأَشيبِ"],["AD2A264E-6D72-587B-822C-2D9B2424B050","إلا الأضاليل ومن لا يَزَل","يُوفي على مهلكه يَعصَب"],["38D2CC15-2FA4-59B0-82AE-0055403F26CD","بُدّلتُ شيبا قد عَلا لمتي","بعد شَبابٍ حَسنٍ مُعجبِ"],["D073FE6A-4552-5CB1-B417-C5442D2BB2E1","صَاحبتُه ثُمَّت فارَقتُهُ","ليتَ شبابي ذاك لم يَذهبِ"],["0EC24871-D44E-59F6-9447-AB40AB71C0D8","وقد أُراني والبلى كأسمه","إذ أنا لم أصلع ولم أحدَبِ"],["5B8E9CDD-B8E7-587C-AA5C-3CCFA3F7880C","ولم يُعرني الشيب أثوابه","أصبى عُيون البيضِ كالرَبربِ"],["C490161A-D90D-523A-BBFE-721FEDC7C3E9","كأنما يومَي حَولٌ إذا","لم أشهَدِ اللَّهو ولم ألعبِ"],["A225381C-9FE4-58D0-AD54-8B401A5F2140","وقَهوةٍ صهباءَ باكرتُها","بجُهمةٍ والديكُ لم ينعَبِ"],["44AFEAFF-7BC5-5B55-8454-8C02730929DB","وطامح الرأسِ طويلِ العمى","يذهبُ جَهلا كلما مَذهبِ"],["B0CFAE8E-198F-58D1-80B6-FA2B08048759","كويته حين عدا طورَه","في الرأس منهُ كيَّة المكلبِ"],["85F9C0E9-7716-595A-8AC6-2BC132EFD172","وغارةٍ شعواءَ ناصبتُها","بسابحٍ ذي حُضُرٍ مُلهبِ"],["15D6BEF4-0B70-51E6-B15A-970F3548ECF2","تراهُ بالفارسِ من بعد ما","نكّسَ ذو اللأمةِ كالأنكبِ"],["8AF92D10-9A03-557C-A4AC-4D1AC943F955","وصَاحِبٍ نَبّهتُهُ مَوهنا","ليسَ بأناحٍ ولا جأنبِ"],["4C4DD187-1120-50D3-885C-BE3B608FC675","أروعَ بُهلولٍ خميص الحشا","كالنَّصل ما تركب به يركبِ"],["5EF650EB-17C8-51AA-953D-AD7CA68E426E","فقامَ وسنانَ إِلى رحلهِ","وجَسرةٍ دَوسرةٍ ذعلِبِ"],["3E1B8973-296E-51C1-8081-958CC14851C6","ومَربأ كالزُّجِ أشرفتهُ","والشمس قد كادت ولم تَغرُبِ"],["7616964D-2E10-5CB2-8004-39ED9FFF9E5D","تلّفني الريحُ على رأسهِ","كأنني صَقرٌ على مَرقَبِ"],["23D57325-A86A-5107-A461-9C66F91D0ADF","ذاك ومَولي يمُجُّ الندى","قُريانهُ أخضرُ مُغلَولبِ"],["534533DB-6331-5040-8DBE-EA58F635DC54","قفر حَمته الخيلُ حتى كأن","نَ زاهرُهُ أُغشيَ بالزرنبِ"],["728F3894-4CBA-5AFE-941C-86BEEDD6AFA3","جاد السما كان بِقُريانهِ","بالنجم والنَثرة والعقربِ"],["16E2474C-D830-5796-8E96-4D20180E4348","كأنَّ أصواتَ عَصافيرِه","أصوابُ راعي ثَلَّةٍ مُحصبِ"],["97BEE77E-227E-549C-ABD2-763A8B714951","قُدتُ به أجردَ ذاميعَةٍ","عَبلِ الشوى كالصدع الأشعبِ"],["5B7220A3-7878-599D-944D-BCF7B6F4C5F8","فَرداً تُغنيني مكاكيّهُ","تَغنيَ الولدان والملعَبِ"]]},"439D4679-2CC2-5FCA-9690-C34E1F3299A8":{"t":"وأُمُّهُمُ ضُبعٌ باتت تجُرُّ سِلىً","p":25,"s":"وأمهم ضبع باتت تجر سلى","r":"437075","v":[["B954E98D-E43B-595B-A806-C66C1A28E31B","وأُمُّهُمُ ضُبعٌ باتت تجُرُّ سِلىً","بالجَزعِ بين مُجبراتٍ وهَبُّودِ"]]},"57650420-DB1D-5CA4-965D-D9BE7C184DB5":{"t":"وإذا أخلائي تنكّت ودهم","p":25,"s":"وإذا أخلائي تنكت ودهم","r":"437096","v":[["773BEB65-3B7F-5A50-A05E-BF6CCF6EF6AB","وإذا أخلائي تنكّت ودهم","فأبو الكدادة ما له لي مضرعُ"]]},"788ADF34-507A-5E14-A1FF-910E3B6CF51D":{"t":"وإني لَشهمٌ حينَ تُبغَى شهيمتي","p":25,"s":"وإني لشهم حين تبغى شهيمتي","r":"437094","v":[["CB5CB6BF-F73A-5461-8627-6292DF1FCA4A","وإني لَشهمٌ حينَ تُبغَى شهيمتي","وصَعبٌ قيادي لم تَرُصني المقاذِعُ"]]},"EACE052A-0374-5042-B315-8944A879DC4D":{"t":"والبيضُ قد عَنَست وطال جِراؤها","p":25,"s":"والبيض قد عنست وطال جراؤها","r":"437065","v":[["1381A6EA-A4B5-55EE-8A49-E0A254C58534","والبيضُ قد عَنَست وطال جِراؤها","ونشأن في فننِ وفي أذوادِ"]]},"4ECE4FF9-2982-5DE3-AF26-C401C0535825":{"t":"وشطت نوى تَنهاةَ من أن توافقا","p":25,"s":"وشطت نوى تنهاة من أن توافقا","r":"437104","v":[["D1827E18-FB27-5820-982A-D262E90A5090","وشطت نوى تَنهاةَ من أن توافقا","فبانت فشَاقَ البَينُ من كان شائِقا"],["20E6DBC6-3D85-56CB-8F94-2D9884206414","فلن تَعدَمي منّا السّراة ذوي النهى","إذا قحطت والمُسمحين المغالقا"]]},"ED8179D4-79C6-5EB5-BAA3-2BE249EC7673":{"t":"وغُوِدِرَ عِلوَدٌّ لَها مُتَطاوِلٌ","p":25,"s":"وغودر علود لها متطاول","r":"437086","v":[["1251EAD6-593F-5427-BBC6-4BCFC6D69842","وغُوِدِرَ عِلوَدٌّ لَها مُتَطاوِلٌ","نَبيلٌ كَجُثمانِ الجَرادَةِ ناشِرُ"]]},"8FD74371-EF0E-5586-A700-C1227BC1698B":{"t":"وفاقِد مَولاهُ أعارت رِمَاحُنا","p":25,"s":"وفاقد مولاه أعارت رماحنا","r":"437111","v":[["1C27C7D8-B4F3-575E-A96C-14C0CBDDBF36","وفاقِد مَولاهُ أعارت رِمَاحُنا","سناناً كنبراسِ النهامى مِنجلا"]]},"B205BBFD-3F8E-59FA-9FDB-22DE3A048E4D":{"t":"وقالت لا أراك تُليق شيئاً","p":25,"s":"وقالت لا أراك تليق شيئا","r":"437074","v":[["8A9DF013-0705-5950-9EFB-A5085A332423","وقالت لا أراك تُليق شيئاً","أتُهلك ما جَمعتَ وتستفيدُ"],["177B76B3-6FDA-55D0-B07A-172F204C5ED1","فقلتُ بحَسبها يَسرُ وعار","ومُرتحلٌ إِذا رَحَلَ الوفودُ"],["E7004E50-9392-527B-8697-34F2AE880BC9","فلُومي إن بدا لكِ أو أفيقي","فَقبلك فاتني وهو الحميدُ"],["68085914-76F2-5943-A261-FF331A68315B","أبو العوراءِ لم أكمد عليه","وقيس فاتني وأخي يَزيدُ"],["C8B9C300-418C-5F62-A159-EFDBCD72FE02","مَضوا لسبيلهم وبَقيتُ وحدي","وقَد يُغني رَباعته الوَحيدُ"],["A684DD4B-BA31-593F-BA78-759490EE8691","فلولا الشامِتون أخذتُ حقي","وإن كانت بمطلبه كؤودُ"]]},"E18B1C98-F7F5-5096-AEB8-0AD7F7F3A1C9":{"t":"وكأن عليه من جِنّ قبولاً","p":25,"s":"وكأن عليه من جن قبولا","r":"437126","v":[["7812F30D-37A5-5C23-8AA3-C61B9B7EFD5F","وكأن عليه من جِنّ قبولاً","إِذا حي الدواجِنُ قتانُ"]]},"E0189097-CA54-5A26-8F72-4EE30DD6AEE7":{"t":"وكائن بالقَليب قَليب بدر","p":25,"s":"وكائن بالقليب قليب بدر","r":"437117","v":[["E27606A9-1485-559D-B935-8D36D93636BF","وكائن بالقَليب قَليب بدر","من الفتيان والعَرَبِ الكرامِ"],["E9A6EAF6-9C35-5500-BCB3-8EBE2BB77457","أيوعدُني ابن كبشة أن سنحيا","وكيف حياةُ أصداءٍ وهامِ"],["2EE51AED-6655-5429-B062-9CE29698336F","أيعجزُ أن يردَّ الموت عني","وينشرني إذا بليت عِظامي"],["97B20C55-95F3-545C-B54D-1677C909AB13","ألا مَن مُبلغ الرحمن عنّى","بأني تارك شهرَ الصيامِ"],["A67A10D4-27EA-5BAD-B21B-42A066B55BF5","فقُل للّه يمنعني شرابي","وقل لله يمنعني طعامي"],["72EC56E2-171D-5C14-8827-930AC5FB0192","تحاماك الحتوفُ وأفلتوني","أخو الملهوفِ والبطلُ المحامي"]]},"D343743A-9637-5031-ADB1-A3D4E0AE9510":{"t":"ولدت بِحادي النجم يحرق ما رأى","p":25,"s":"ولدت بحادي النجم يحرق ما رأى","r":"437066","v":[["F681FD0B-9FD2-51CA-94D1-1D0656A5741C","ولدت بِحادي النجم يحرق ما رأى","وبِالقَلبِ قلبِ العَقربِ المُتوقّدِ"]]},"E4E1C93F-46D1-548B-8F0F-B572C3750621":{"t":"ولَقد أرجِّلُ لمّتي بعشيةٍ","p":25,"s":"ولقد أرجل لمتي بعشية","r":"437068","v":[["FA5A7E93-EEF0-5B5B-88C9-9B92897C31A6","ولَقد أرجِّلُ لمّتي بعشيةٍ","للشَربِ قبل سَنابكِ المُرتاد"]]},"66C09512-84E5-5224-BA25-C83879413A76":{"t":"ونالت عشاءً من هبيد وبَروَقٍ","p":25,"s":"ونالت عشاء من هبيد وبروق","r":"437115","v":[["A8861E35-1E58-5530-85B3-A44C8CBD3C26","ونالت عشاءً من هبيد وبَروَقٍ","ونالت طعاماً من ثلاثة ألحُمِ"]]},"EBB353C1-26C0-5275-8E54-0411AFEBDF02":{"t":"وَإِذا بَللتَ بهم بللتَ بِمعشرٍ","p":25,"s":"وإذا بللت بهم بللت بمعشر","r":"437063","v":[["36B7ADF6-EC11-533F-AAE2-812F91C5CDEC","وَإِذا بَللتَ بهم بللتَ بِمعشرٍ","نَوكي القلوب ونسوةٍ عهِرات"]]},"5EAA4169-D593-5BB7-90F4-C6F3129C61DA":{"t":"يآل عُبادٍ دَعوَةٌ بَعدَ هَجمَةٍ","p":25,"s":"يآل عباد دعوة بعد هجمة","r":"437098","v":[["18239FB5-B8AC-59A7-A45F-3738C673DFD7","يآل عُبادٍ دَعوَةٌ بَعدَ هَجمَةٍ","فهل منكُمُ من قوة وزمَاعِ"],["1D1FA769-100D-577B-B414-D5C6A8D19CB1","فتسعوا لجارٍ حَلّ وَسط بيوتكم","غريب وجارات تُركنَ جياعِ"],["4E6A3FE5-B048-518C-826F-4D9AB11DAAC9","وما كانت الأجواف منّي مُحَيَّةً","وساكنها من غُدَّة وأَفاعي"],["103414F7-F184-5CDC-BE00-8363539B8518","طَحُون كمُلقى مِبرَدِ القين فَعمَةٌ","بجرعَاء مِلحٍ أو بجَوِّ نطاعِ"]]},"B7AC9BD3-4DCE-501E-80A4-08E81CFFA47C":{"t":"يا جار طلحة هل ترد لبونهُ","p":25,"s":"يا جار طلحة هل ترد لبونه","r":"437124","v":[["A2C55DCC-AA10-56B5-B7B8-43DE43E370E0","يا جار طلحة هل ترد لبونهُ","فتكون أدنى للوفاء وأكرما"],["F8ADACF9-2B53-5D7E-B374-E13F8D079BE8","تالله لو جاورتموه بذمة","حتى يفارقكم إذا ما أحرما"],["90C2F0FE-0D65-5A9E-8EDD-848F6FE2B051","جَذلان يسر جُلّةً مكنوزة","وسماء بحونةً ووطباً مجزما"],["1F6E9114-F6FB-5629-84BC-C520AF08BE7C","وتذكرت حمض الجريب وماءهُ","والجزع جزع مرامر والعيلما"],["144BBF95-3B8D-57F0-AF32-594A993D163B","وجَبا نُفيع يوم أورد أهله","فكأنها ظلت نصارى صُيِّما"],["44CDC01D-A05B-5783-A115-BF5A0399F67A","لبنُ المريرة لا يزال يشحهُ","بالماء يمنعُ طعمه أن يشخما"]]},"5CBD6A70-557A-54A9-9B22-C0354E3AABDA":{"t":"يبيت الضيفُ عند بني نُجيح","p":25,"s":"يبيت الضيف عند بني نجيح","r":"437120","v":[["AD3B26BE-C75F-5A68-B65E-14C4CEC53007","يبيت الضيفُ عند بني نُجيح","خميص البطن ليس له طعام"],["50B2C429-30F3-5952-AA7C-BD5F1211D7B3","يَهونُ عليهم أن يحرموهُ","إذا حَلَبوا لقاحهم وناموا"]]},"4CC031A4-FD41-5C43-B0CF-4C524AEC5B7F":{"t":"يقلن تركن الشاء بين جلاجل","p":25,"s":"يقلن تركن الشاء بين جلاجل","r":"437116","v":[["942D213D-3210-5F81-A0BD-03F7ECE91075","يقلن تركن الشاء بين جلاجل","وجزرة قد هاجت عليه السمائم"],["EBC85951-4169-55B9-8C7D-576816A7FE0E","هنأناهُمُ حتى أعان عليهمُ","سوافي السماك ذي السلاح السواجم"]]},"71F293A6-FAF8-5418-8EBC-EBC5AF70E5F1":{"t":"يوم لا ينفع الروّاغ ولا","p":25,"s":"يوم لا ينفع الرواغ ولا","r":"437080","v":[["FE255334-D28A-5906-B87A-C44C9DF893B5","يوم لا ينفع الروّاغ ولا","يقدم إِلا المشيع النحرير"]]}}}