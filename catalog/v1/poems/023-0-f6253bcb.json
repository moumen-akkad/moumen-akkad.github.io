{"v":1,"poems":{"48CD639F-538E-5924-B3B8-CE918E1447AC":{"t":"أتعرِف رسم الدار من أم معبد","p":23,"s":"أتعرف رسم الدار من أم معبد","r":"437332","v":[["63A1E7FE-5B3B-5FB4-AF36-3DA207948E7F","أَتَعرِفُ رَسمَ الدارِ مِن أُمِّ مَعبَدِ","نَعَم وَرَماكَ الشَوقُ قَبلَ التَجَلُّدِ"],["3141D3AF-DA2E-57A1-94A1-288F5843D165","أَعاذِلَ ما أَدنى الرَشادَ مِنَ الفَتى","وأَبعَدَهُ مِنهُ إِذا لَم يُسَدَّدِ"],["A8111016-E999-5F93-B097-B22CB80E1E84","أَعاذِلَ قَد لاقَيتَ ما يَزَعُ الفَتى","وَطابَقتَ في الحِجلَينِ مَشيَ المُقَيَّدِ"],["FC7A0673-52B5-5FBF-95E5-136261E4090D","أَعاذِلَ ما يُدريكِ أَنَّ مَنِيَّتي","إِلى ساعَةٍ في اليَومِ أَوفي ضُحى غَدِ"],["7C2E1990-183B-52EF-9201-648412010FF7","أَعاذِلَ مَن يُكتَب لِهُ المَوتُ يَلقَهُ","كِفاحاً وَمَن يُكتَب لَهُ الفوزُ يَسعَدِ"],["269E2EA7-1540-5771-87F6-5F05A0D41E6D","أَعاذِلَ إِنَّ الجَهلَ مِن لَذَّةِ الفَتى","وَإِنَّ المَنايا لِلرِجالِ بِمَرصَدِ"],["E9528E6A-28C0-5422-BFCB-3ADE790A3799","فَذَرني فَمالي غَيرَ ما أُمضِ إِن مَضى","أَمامِيَ مِن مالي إِذا خَفَّ عُوَّدي"],["6B23F3EC-0155-5632-8A7E-6D8406195D91","وَحُمَّت لِميقاتٍ إِلَيَّ مَنِيَّتي","وَغودِرتُ قَد وُسِّدتُ أَو لَم أُوَسِّدِ"],["DABEE925-675B-56FD-A2C7-8A3A58BA16A2","وَلِلوارِثِ الباقي مِنَ المالِ فَاِترُكي","عِتابي فَإِنّي مُصلِحٌ غَيرُ مُفسِدِ"],["5313ABA6-1244-5035-A39A-C8B4D902F36F","أَعاذِلَ مَن لا يُصلِحِ النَفسَ خالِياً","عَنِ اللُبِّ لا يُرشَد لِقَولِ المُفَنِّدِ"],["C616D70F-8914-5C22-A513-05E6A0239C60","كَفى زاجِراً لِلمَرءِ أَيّامُ دَهرِهِ","تَروحُ لَهُ بِالواعِظاتِ وَتَغتَدي"],["BC190ACF-1447-55A6-82A1-646002FD8776","بَلَيتُ وَأَبلَيتُ الرِجالَ وَأَصبَحَت","سِنونَ طِوالٌ قَد أَتَت دونَ مَولِدي"],["C98DA6FC-1716-5EFB-A046-D49A413AE4CF","فَلَستُ بِمَن يَخشى حَوادِثَ تَعتَري","رِجالاً فَبادوا بَعدَ بُؤسٍ وَأَسعُدِ"],["FAEA5663-86A6-5D71-843B-5592FBF9B94E","فَنَفسَكَ فَاِحفَظها عَنِ الغَيِّ وَالرَدى","مَتى تُغوِها يَغوَ الَّذي بِكَ يَهتَدي"],["78666580-8218-5E9A-B2A6-8164E6E6C7D3","وَإِن كانَتِ النَعماءُ عِندَكَ لِاِمرِئٍ","فَمَثِّل بِها وَاِجزِ المُطالِبَ وَاِردُدِ"],["C69DF7C5-D83F-54ED-9B48-EDA7FF033222","إِذا ما اِمرُؤٌ لم يرج منك مودّة","فَلا تَرجُها مِنهُ وَلا دَفعَ مَشهَدِ"],["4E6814DD-B0F6-5874-B212-ED58A7B50A5D","وَعَدِّ سَواءَ القَولِ وَاِعلَم بِأَنَّهُ","إِذا لَم يَبِن في اليَومِ يَصرِمكَ في الغَدِ"],["A54198D0-1CA8-5AF2-83CC-5E2C59D22081","وَإِن أَنتَ فاكَهتَ الرِجالَ فَلاتَجِم","وَقُل مِثلَ ما قالوا وَلا تَتَزَنَّدِ"],["A069CC18-8424-5C2C-BE69-0B4BDAB3DDC8","إِذا أَنتَ نازَعتَ الرِجالَ نَوالَهُم","فَعِفَّ وَلا تَطلُب بِجَهدٍ فَتَنكَدِ"],["69F04C15-ABAB-5448-8E0F-65C7A1730A70","عَسى سائِلٌ ذو حاجَةٍ إِن مَنَعتَهُ","مِنَ اليَومِ سُؤلاً أَن يَسُرَّكَ في غَدِ"],["AA3B70C5-77D1-5313-B700-60FCC87ACE6F","سَتُدرِكُ مِن ذي الفُحشِ حَقَّكَ كُلَّهُ","بِحِلمِكَ في رِفقٍ وَلَم تَتَشَدَّدِ"],["6188D753-BE97-56AC-AE28-20BC90393045","وَساِسِ أَمرٍ لَم يَسُسهُ آبٌ لَهُ","وَرائِمِ أَسبابِ الَّتي لَم تُعَوَّدِ"],["FEA57EBF-B321-59E8-8BF4-B15E79CE156D","وَراجي أُمورٍ جَمَّةٍ لا يَنالُها","سَتَشعَبُهُ عَنها شَعوبٌ لِمُلحِدِ"],["B66847EC-62C5-5E6B-8E2F-72640FB24A7D","وَوارِثِ مَجدٍ لَم يَنَلهُ وَماجِدٍ","أَصابَ بِمَجدٍ طارِفٍ غَيرِ مُتلِدِ"],["D78FCB80-D2B0-5819-B487-3A97A769D9FA","فَلا تَقعُدَن عَن سَعيِ ما قَد وَرِثتَهُ","وَما اِسطَعتَ مِن خَيرٍ لِنَفسِكَ فَاِزدَدِ"],["AB0BC4CC-E092-55B9-8316-EBB2F4DFF1C3","إِذا ما رَأَيتَ الشَرَّ يَبعَثُ أَهلَهُ","وَقامَ جُناةُ الشَرِّ بِالشَرِّ فَاِقعُدِ"],["BEBD7769-1BBB-5267-A204-ABA4BC7C6EA7","وَبِالعَدلِ فَاِنطِق إِن نَطَقتَ وَلا تَجُر","وَذا الذَمِّ فَاِذمُمهُ وَذا الحَمدِ فَاِحمَدِ"],["EC4E9830-2C77-564F-9393-04AAE9A1950E","وَلا تَلحُ إِلّا مَن أَلامَ وَلا تَلُم","وَبِالبَذلِ مِن شَكوى صَديقَكَ فَاقتَدِ"],["2E0D3F38-051C-5B57-8AF1-A2ED16AB4C2E","عَنِ المَرءِ لا تَسأَل وَسَل عَن قَرينِهِ","فَكُلُّ قَرينٍ بِالمُقارِنِ مُقتَدِ"],["1DB6F6FC-E478-57CA-BD6B-86506A272AD1","وَفي الخَلقِ إِذلالٌ لِمَن كانَ باخِلاً","ضَنيناً وَمَن يَبخَل يَذِلَّ وَيُزهَدِ"],["7E52E364-F2C7-5AC6-AB90-9EB7A2FC21B6","أَفادَتني الأَيّامُ وَالدَهرُ إِنَّهُ","وَدادي لِمَن لا يَحفَظُ الوِدِّ مُفسِدي"],["5B67F9C0-C0BD-5E80-BFE2-1FE8EABB377F","وَلاقَيتُ لَذّاتِ الغِنى وَأَصابَني","قَوارِعُ مَن يَصبِر عَلَيها يُخَلَّدِ"],["E7AEBDA7-8150-5B04-B516-73D63622CD02","إِذا ما كَرِهتَ الخَلَّةَ السوءَ لِاِمرِئٍ","فَلا تَغشَها وَاِخلِد سِواها بِمِخلَدِ"],["365CBB5F-4D78-5E8F-9B0F-50598A3E9974","إِذا أَنتَ لَم تَنفَع بِوُدِّكَ أَهلَهُ","وَلَم تَنكِ بِالهَيجا عَدُوَّكَ فَاِبعُدِ"],["341916FE-110B-5CE4-8B6C-4BA01EC44694","وَمَن لا يَكُن ذا ناصِرٍ عِندَ حَقِّهِ","يُغَلَّب عَلَيهِ ذو النَصيرِ وَيَعتَدِ"],["7B164F46-7E9B-5B33-8F65-88EC5E13FCF2","وَفي كَثرَةِ الأَيدي عَنِ الظُلمِ زاجِرٌ","إِذا خَطَرَت أَيدي الرِجالِ بِمَشهَدِ"],["3AA82BF2-4354-51C9-983A-36354F928662","وَلِلمَرءِ ذي المَيسورِ خَيرُ مَغَبَّةٍ","مِنَ المَرءِ ذي المَعسورَةِ المُتَرَدِّدِ"],["7D1FA664-61A2-5FC1-B887-3D964F3E2F95","سَأَكسِبُ مَجداً أَو تَقومَ نَوائِحٌ","عَلَيَّ بِلَيلٍ مُبدِياتِ التَبَلُّدِ"],["58F786A9-AD94-5371-99B3-5FD246A68F8D","يَنُحنَ عَلى مَيتٍ وَأَعلَنَّ رَنَّةً","تُؤَرِّقُ عَيني كُلِّ باكٍ وَمُسعَدِ"]]},"0915E6CD-8C87-5C4D-97F5-61D440DD3316":{"t":"أحسبت مجلسنا وحسن جدي","p":23,"s":"أحسبت مجلسنا وحسن جدي","r":"437353","v":[["08415997-1432-551A-BE8B-861A4AD7113E","أَحَسِبتَ مَجلِسَنا وَحُسنَ جدي","ثِنا يودي بِمالِك"],["9413FEA4-F551-5EDA-A01E-C64A47D6A40B","فَالمالُ وَالأَهلونَ مَصٌ","رعة لِأَمرِكَ أَو نَكالِك"],["9F51C071-A561-5A89-83D7-E0D593A10DB5","ما تَأمُرَن فينا فَأَم","رك في يَمينِكَ أَو شِمالِك"]]},"27F03283-7A5A-56B8-B711-243651E413D4":{"t":"أرواح مودع أم بكور","p":23,"s":"أرواح مودع أم بكور","r":"437339","v":[["F76E5CC2-F2BD-51C2-87E1-262B0C26BE0C","أَرواحٌ مُوَدِّعٌ أَم بُكورُ","لَكَ فَاِعمَد لِأَيِّ حالٍ تَصيرُ"],["16368890-C963-5608-A941-77A38AD6C4CF","وَسطَهُ كَاليَراعِ أَو سُرُجِ المجد","دل حيناً يَخبو وَحيناً يُنيرُ"],["72085F58-CFBA-5007-8A0F-AC793F20B093","مِثلُ نارِ الحَرّاضِ يَجلو ذثرى المُز","نِ لِمَن شامَهُ إِذا يَستَطيرُ"],["456AA6FD-825B-5C02-BFB3-82D33F5AEB98","مَرِحٌ وَبلُهُ يَسُحُّ سُبوبَ الس","سَما مَجّاً كَأَنَّهُ مَنحورُ"],["C1B33E4B-7B94-5C71-B9EA-9AE3A5CAE037","زَجَلٌ عَجزُهُ يُجاوِبُهُ دُف","ف لِخُوانٍ مَأدوبَةٍ وَزَميرُ"],["2AE6A315-F23B-5424-9604-565D1C7E6BC9","كَدُمى العاجِ في المَحاريبِ أَو كَال","بَيضِ في الرَوضِ زَهرُهُ مُستَنيرُ"],["776686CD-6F6D-5DD9-A7E2-85A7F55AB1AB","زَانَهُنَّ الشفُوفُ يَنضَحنَ بالمس","كِ وَعَيشٌ مُفانِقٌ وَحريرُ"],["2E91B4F3-278B-5F25-AA61-95F75711B8C9","وَيَقولُ العُداةَ أَودى عَدِيٌّ","وَعَدِيٌّ بِسُخطِ رَبٍّ أَسيرُ"],["69424771-0477-51CA-A189-A03CE5E51ECB","أَيُّها الشامِتُ المُعَيِّرُ بِالدَه","ر أَ أَنتَ المُبَرَّأُ المَوفورُ"],["EF52265B-CECA-5C99-8F43-967370150FCF","أَم لَدَيكَ العَهدُ الوَثيقُ مِنَ الأيْ","يامِ بَل أَنتَ جاهِلٌ مَغرورُ"],["2ED0CA24-9ACA-5C7E-88DD-0F3E018A9612","إِن يُصِبني بَعضُ الهَناتِ فَلا وا","نٍ ضَعيفٌ وَلا أَكَبُّ عَثورُ"],["3DF219AF-CAE0-5C3E-BCCC-4DD2976F7718","كَقَصيرٍ إِذ لَم يَجِد غَيرَ أَن جَد","دَعَ أَشرافَهُ لِمَكرٍ قَصيرُ"],["2EED0EF1-15B3-5828-B0DF-7C78B4318979","مَن رَأَيتَ المَنونَ خَلَّدنَ أَم مَن","ذا عَلَيهِ مِن أَن يُضامَ خَفيرُ"],["97488BDE-A216-5CE8-8F0E-89C24C3BF026","لا تُؤاتيكَ وَإِن صَحَوتَ وَإِن أج","هَدَ في العارِضَينِ مِنكَ القَتيرُ"],["9B22E4A1-44AD-59DF-8D3B-ABAFC5F5112B","يَومَ لا يَنفَعُ الرَواغُ وَلا يُق","دم إِلّا المُشَيَّعُ النِحريرُ"],["638DEECB-EE70-54AE-BD0F-E9B1030803E9","أَينَ كِسرى كِسرى المُلوكِ أَنوشِر","وانُ أَم قَبلَهُ سابورُ"],["2CA48B31-661B-51E7-B56F-06F991365E39","وَبَنو الأَصفَرِ الكِرامُ مُلوكُ الرو","م لَم يَبقَ مِنهُمُ مَذكورُ"],["558B4C5D-D0D5-5563-B969-1CC01AD2F9C3","وَأَخو الحَضرِ إِذ بَناهُ وَإِذ دِجْ","لة تُجنى إِلَيهِ وَالخابورُ"],["59598440-6CE7-5B24-BE87-88D2E3E11412","شادَهُ مَرمَراً وَجَلَّلَهُ كِلْ","سا فَلِلطَيرِ في ذُراهُ وُكورُ"],["90D66000-DBBC-5B52-A955-711DE6094915","لَم يَهَبهُ رَيبُ المَنونِ فَبادَ الْ","ملك عَنهُ فَبابُهُ مَهجورُ"],["942131CF-EFB1-5313-A38F-3980E42083C2","وَتَذَكَّر رَبُّ الخَوَرنَقِ إِذ أَشْ","رفَ يَوماً لِلهُدى تَفكيرُ"]]},"F10F68D9-8C8B-5D7A-A05C-D0C09BACD0E7":{"t":"أرِقت لمكفهِر بات فيه","p":23,"s":"أرقت لمكفهر بات فيه","r":"437327","v":[["7A0A0E29-6B57-5BFC-8504-6BC0CC98FFB5","أَرِقتُ لِمُكفَهِرٍّ باتَ فيهِ","بَوارِقُ يَرتَقينَ رؤوسَ شيبِ"],["6D50B86A-A7BB-521F-872B-022AC073A41E","تَلوحُ المَشرَفِيَّةُ في ذُراهُ","وَيَجلو صَفحَ دَخدارٍ قَشيبِ"],["DE12772D-6062-5AE6-8482-7FE6267C83E5","كَأَنَّ مَآتِماً باتَت عَلَيهِ","خَضَبنَ مَآلِياً بِدَمٍ خَصيبِ"],["AB003106-0684-55E2-921C-B50DC7DE741E","سَقى بَطنَ العَقيقِ إَلى أُفاقٍ","فَقاثورٍ إِلى لَبَبِ الكَثيبِ"],["265C4DDC-E31E-5B31-8B45-709D93A56CBD","فَرَوّى قُلَّةَ الأَدخالِ وَبلاً","فَفَلجاً فَالنَبِيَّ فَذا كَريبِ"],["98CCC7B9-E0B5-569E-819B-23C623BB9481","سَعى الأَعداءُ لا يَألونَ شَرّاً","عَلَيكَ وَرَبِّ مَكَّةَ وَالصَليبِ"],["E2BDDE04-6CF0-5867-9C0C-DC393BA1B2D6","أَرادوا كَي تُمَهِّلَ عَن عَدِيٍّ","لِيُسجَنَ أَو يُدَهدَهَ في القَليبِ"],["836B3724-2FD9-5CFA-BB42-4158D590C983","وَكُنتُ لِزازَ خَصمِكَ لَم أُعَدِّد","وَقَد سَلَكوكَ في يَومٍ عَصيبِ"],["5C04C9C4-F5AC-5979-9C17-4AB8E4AE7B1E","أُعالِنُهُم وَأُبطِنُ كُلَّ سِرٍّ","كَما بَينَ المِحاءِ إِلى العَسيبِ"],["ADDFA18E-F715-5761-A978-284D737A1F6B","قَفَزتُ عَلَيهِم لَمّا التَقَينا","بِتاجِكَ فَوزَةَ القِدحِ الأَريبِ"],["DB5ADCDE-048E-5D7D-98FD-A72694F22494","وَما دَهري بِأَن كَدَّرتُ فَضلاً","وَلَكِن ما لَقيتُ مِنَ العَجيبِ"],["82BF8DF3-532E-5638-809F-79B98BAEF9C1","أَلا مَن مُبلِغُ النُعمان عَنّي","وَقَد تُهوى النَصيحَةُ بِالمَغيبِ"],["D6268954-D82C-54B0-8776-73AFEE45B229","أَحَظّي كانَ سِلسِلَةً وَقَيداً","وَغُلّاً وَالبَيانُ لَدى الطَبيبِ"],["4675C431-1CB4-54D6-8020-80D250E447D7","أَتاكَ بِأَنَّني قَد طالَ حَبسي","وَلَم تَسأَم بِمَسجونٍ حَريبِ"],["BFF03006-3D8A-5493-BC0E-73F36C81DF64","وَبَيتي مُقفِرُ الأَرجاءِ فيهِ","أَرامِلُ قَد هَلَكنَ مِنَ النَحيبِ"],["70F56E27-BAD5-5BF8-8EE7-00F577084E16","يُبادِرنَ الدُموعَ عَلى عَدِيٍّ","كشنٍّ خانَهُ خَرزُ الرَبيبِ"],["A583C9EC-27D2-532F-9BB1-45DD48520841","يُحاذِرنَ الوُشاةَ عَلى عَدِيٍّ","وَما اِقتَرفوا عَلَيهِ مِنَ الذُنوبِ"],["8A8D6760-654D-5E61-B3E9-BBAF97287E2F","فَإِن أَخطَأتُ أَو أَوهَمتُ أَمراً","فَقَد يَهِمُ المُصافي بِالحَبيبِ"],["2B9C03D8-7A95-5183-A0E5-8AD12E3EB462","وَإِن أَظلِم فَقَد عاقَبتُموني","وَإِن أُظلَم فَذَلِكَ مِن نَصيبي"],["17A87E85-124D-55C9-9C83-F7F38948923F","وَإِن أَهلِكَ تَجِد فَقدي وَنَجدي","إِذا أَلتَقَتِ العَوالي في الحُروبِ"],["F037E1D3-B584-584E-BA55-CFA258DE6AB1","وَما هَذا بِأَوِّلِ ما أُلاقي","مِنَ الحِدثانِ وَالعَرَضِ القَريبِ"],["364B1252-574B-5DF0-9F78-943123FFFFA6","فَهَل لَكَ أَن تَدارَكَ ما لَدَينا","وَلا تُغلَب عَلى الرَأيِ المُصيبِ"],["1A87B373-8EDF-5024-B19E-B36363CDBFCE","فَإِنّي قَد وَكَّلتُ اليَومَ أَمري","إِلى رَبٍّ قَريبٍ مُستَجيبِ"]]},"8FB3CC8E-FC7E-5895-81EF-857DD4088314":{"t":"ألا أيها المثري المرجى","p":23,"s":"ألا أيها المثري المرجى","r":"437346","v":[["0AF79C98-D36A-5B7F-8BBA-C487D95C7F1F","أَلا أَيُّها المُثري المُرَجّى","أَلَم تَسمَع بِخَطبِ الأَوَّلينا"],["18E74F53-5F41-5B13-BFB2-57CAB079B434","دَعا بِالبَقَّةِ الأُمراءَ يَوماً","جَذيمَةُ عامَ يَنجوهُم ثُبينا"],["255F56BD-49F8-5DFF-A9ED-EB8935CA2F65","فَلَم يَرَ غَيرَ ما اِئتَمَروا سِواهُ","فَشَدَّ لِرَحلِهِ السَفرُ الوَضينا"],["87845FDC-FB88-5D97-92BA-3835CAF80405","فَطاوَعَ أَمرَهُم وَعَصى قَصيراً","وَكانَ يَقولُ لَو نَفَعَ اليَقينا"]]},"ADB94136-3DD9-5239-956A-4DDB4F12FFA3":{"t":"ألا من مبلغ النعمان عني","p":23,"s":"ألا من مبلغ النعمان عني","r":"437331","v":[["ECCAFB0C-9374-57AD-81BB-81F5C48A1C8D","أَلا مَن مُبلِغُ النُعمانِ عَنّي","فَبَينا المَرءُ أَغرَبَ إِذ أَراحا"],["F3B7E11A-6897-5F84-B94E-E31C21630F09","أَطَعتُ بَني نَفيلَةَ في وِثاقي","وَكُنّا مِن حُلوقِهِمِ ذُباحا"],["2A08D13B-AB92-51EF-9BE7-0E69B945C0B4","مَنَحتُهُمُ الفُراتَ وَجانِبَيهِ","وَتَسقينا الأَواجِنَ وَالمِلاحا"]]},"C815B188-EFAD-5350-B246-284C14C8A5C2":{"t":"أنعم صباحاً علقم بن عدي","p":23,"s":"أنعم صباحا علقم بن عدي","r":"437352","v":[["600F0A01-D44E-53A7-B856-17E66EF4E16E","أَنعِم صَباحاً عَلقَمَ بنِ عَدِيٍّ","إِذا نَوَيتَ اليَومَ لَم تَرحَلِ"],["AE553440-BBD8-5CF5-AAFA-3E6740CE3558","قَد رَحَّلَ الشُبّانُ غَيرَهُمُ","وَاللَحمُ بِالغيطانِ لَم يُنشَلِ"]]},"FCDD6F38-E1B5-504F-9210-DD459CCFD8BA":{"t":"أيها الركب المخبو","p":23,"s":"أيها الركب المخبو","r":"437345","v":[["20DEED6B-136E-5E80-9AB1-64E0F5F10A8D","أَيُّها الرَكبُ المَخِبّو","نَ عَلى الأَرضِ المُجِدّونا"],["F0FAE4D5-9863-5833-8895-2D09903AE672","كَما أَنتُم كَذا كُنّا","كَما نَحنُ تَكونونا"]]},"B9C16D6B-CD6A-5676-8D9F-047D67C1134F":{"t":"أَبلغ أبياً على نأيه","p":23,"s":"أبلغ أبيا على نأيه","r":"437366","v":[["D7B3BAA8-B929-529D-A029-C6F008858777","أَبلِغ أُبَيّاً عَلى نَأيِهِ","وَهَل يَنفَعُ المَرءَ ما قَد عَلِم"],["78C2B554-55BF-5055-B949-D52B9895858D","بِأَنَّ أَخاكَ شَقيقَ الفُوا","دِ كُنتَ بِهِ وَاثِقاً ما سَلِم"],["835923CA-7E15-5CB6-BC19-A752674C0F84","لَدى مَلِكٍ موثَقٌ في الحَدي","د إِمّا بِحَقٍّ وَإِمّا ظُلِم"],["FB10F3B1-1596-5E6A-ADCB-976DB011E846","فَلا أَعرِفَنكَ كَدَأبِ الغُلا","م ما لَم يَجِد عارِماً يَعتَرِم"],["C973C0E6-B731-54E9-AAD1-9B25012F1B36","فَأَرضُكَ أَرضُكَ إِن تَأتِنا","نَنَم لَيلَةً لَيسَ فيها حُلُم"]]},"AD23379C-673F-5917-BC6F-B197D6BB2210":{"t":"أَبلغ النعمان عني مالكاً","p":23,"s":"أبلغ النعمان عني مالكا","r":"437364","v":[["BFBFE5AA-88BB-53E2-906E-157EDA95CC7F","أَبلِغِ النُعمانَ عَنّي مَألَكاً","إِنَّني قَد طالَ حَبسي وَاِنتِظاري"],["09287551-1532-533F-958D-FD1138FE894C","لَو بِغَيرِ الماءِ حَلقي شَرِقٌ","كَنتُ كَالغَصّانِ بِالماءِ اِعتِصاري"],["241BB3CF-1891-5ED2-97C8-BC6B425A547E","وَعُداتي شَمِتَت أَعجَبَهُم","أَنَّني غُيِّبتُ عَنهُم في إِساري"],["C5DC4022-5E3A-594D-BF17-272519807C50","فَلَئِن دَهرٌ تَوَلّى خَيرُهُ","وَجَرَت بِالنَحسِ لي مِنهُ الجَواري"],["5784B7CC-6C1F-5053-AF22-0ECDD0E5DC16","لي بِما مِنهُ قَضَينا حاجَةٌ","وَحَياةُ المَرءِ كَالشَيءِ المُعارِ"],["2F23ABCC-4532-5052-8100-43FC639F35F5","لَثِقَ الريشُ تَدَلّى غُدوَةً","مِن أَعالي صَعبَةِ المَرقى طَمارِ"],["3C214E8A-C259-5003-AECA-C2C27DDF6644","لَيتَ شِعري عَن دَخيلٍ يَفتَري","حَيثُما أَدرَكَ لَيلي وَنَهاري"],["72623C3A-8BC8-5AD2-8BF5-06C004F2B174","لِاِمرِئٍ لَم يَبلُ مِنّي سَقطَةً","إِن أَصابَتهُ مُلِمّاتُ العِثارِ"],["6C3B45BB-CBB3-5673-AE20-46F48A53C9AB","قاعِداً يَكرُبُ نَفسي بَثُّها","وَحَراماً كانَ سِجني وَاِحتِصاري"],["6A5A63EA-1992-5445-A9D8-6ECE774F8311","نَحنُ كُنّا قَد عَلِمتُم قَبلَكُم","عُمُدَ البَيتِ وَأَوتادَ الإِصارِ"],["0D45F859-9948-59C4-90BE-7B691401099E","وَأَبوكَ المَرءُ لَم يُشنَأ بِهِ","يَومَ سيمَ الخَسفَ مِنّا ذو الخَسارِ"],["79545AA4-37FB-57DA-9468-FAFA5CFAF086","أَجَل نُعمى رَبُّها أَوَّلَكُم","وَدُنُوّي كانَ مِنكُم وَاِصطِهاري"],["2D0FC810-039E-5347-AB95-3B6FE5EDF039","أَجلَ إِنَّ اللَهَ قَد فَضَّلَكُم","فَوقَ مَن أَحكَأَ صُلباً بِإِزارِ"]]},"EB3DD9E9-82F0-546E-A401-06967A54DD9D":{"t":"أَبلِغ خليلي عند هند فلا","p":23,"s":"أبلغ خليلي عند هند فلا","r":"437362","v":[["0F581871-341C-597D-BAB1-BD381F7116A6","أَبلِغ خَليلي عِندَ هِندٍ فَلا","زِلتَ قَرباً مِن سَوادِ الخُصوص"],["4531EF1D-BCD5-5D5D-86EA-D6C46A8F1705","مُوازِيَ القُرَّةِ أَو دونَها","غَيرَ بَعيدٍ مِن عُمَيرِ اللُصوص"],["D3A8DA35-3583-5A63-84F9-90201652C09B","إِنَّكَ ذو عَهدٍ وَذو مَصدَقٍ","مُخالِفٌ عَهدَ الكَذوبِ اللَموص"],["29CBA48B-B29B-534A-92EA-86EC0DA4A91C","تَأكُلُ ما شِئتَ وَتَعتَلُّها","خَمراً مِنَ المُصِّ كَلَونِ الفُصوص"],["09BF74D9-DAAB-5D75-A51F-3E93095A65B1","يَنفُحُ مِن أَردانِكَ المِسكُ وال","هِندِيُّ وَالغارُ وَلُبنى قُفوص"],["D4C8AB48-BE96-5F6E-A6CF-05FB70C8D71B","تَقنِصُكَ الخَيلُ وَتَصطادُكَ الط","طَيرُ وَلا تُنكَعُ لَهوَ القَنيص"],["58B22502-3B1A-5EAA-B94D-A79FC30CD14D","يا نَفسُ أِبقي وَاِتَّقي شَتمَ ذي","الأَعراضِ في غَيرِ نوص"],["59A786DF-E51D-5090-970C-C199EB710078","قَد يُدرُكُ المُبطِئُ مِن حَظِّهِ","وَالجُبنُ قَد يَسبِقُ جَهدَ الحَريص"]]},"4ABD4BDA-DF87-5657-8844-B2CD93C3A37B":{"t":"أَيا منذراً كافيت بالود سخطَةً","p":23,"s":"أيا منذرا كافيت بالود سخطة","r":"437361","v":[["ECDD5BA6-236B-559C-A807-A74D4727FA01","أَيا مُنذِراً كافَيتَ بِالوُدِّ سَخطَةً","فَماذا جَزاءُ المُجرِمِ المُتَبَغِّضِ"],["0661E725-972C-5E44-B306-5920350A1F73","فَإِنَّ جَزاءً يَرجى مِنكَ كَرامَةٌ","وَلَستُ لِنُصحٍ فيكَ بِالمُتَعَرِّضِ"]]},"F76E2472-CE64-5BC3-9E78-212436F76B6A":{"t":"أَين أهل الديارِ من قوم نوح","p":23,"s":"أين أهل الديار من قوم نوح","r":"437335","v":[["FE9375A7-A878-5FE1-9BD9-64C7B4BE094A","أَينَ أَهلُ الدِيارِ مَن قَومِ نوحٍ","ثُمَّ عادٍ مِن بَعدِهِم وَثَمودُ"],["FAF5AEBC-02B6-547A-9BF1-F5C56642C05C","بَينَما هُم عَلى الأَسِرَّةِ وَالأَنما","ط أَفضَت إِلى التُرابِ الجُلودُ"],["CBCED754-665D-5C4A-833F-C17929B2F0A9","وَالأَطِبّاءُ بَعدَهُم لَحِقوهُم","ضَلَّ عَنهُم سَعوطُهُم وَاللَدودُ"],["17B2010D-C36C-5C6C-84EB-19B149AA6718","وَصَحيحٌ أَضحى يَعودُ مَريضاً","وَهوَ أَدنى لِلمَوتِ مِمَّن يَعودُ"],["12B43F5C-D110-549F-B13F-A9E92646B4CD","ثُمَّ لَم يَنقَضِ الحَديثُ وَلَكِن","بَعدَ ذا كُلِّهِ وَذاكَ الوَعيدُ"]]},"9B5C6226-6D9B-5792-B157-9BB916E7902A":{"t":"إِجتنب أَخلاق من لم ترضه","p":23,"s":"إجتنب أخلاق من لم ترضه","r":"437336","v":[["40D102EA-2719-5AB3-9EBD-A78E8157196F","إِجتَنِب أَخلاقَ مَن لَم تَرضَهُ","لا تَعِبهُ ثُمَّ تَقفو في الأَثَر"]]},"C7CE0287-7A11-506A-919A-265ADF443426":{"t":"إِن للدهرِ صولة فاحذرنها","p":23,"s":"إن للدهر صولة فاحذرنها","r":"437337","v":[["DF1A4BD3-BD81-573E-B4BE-C82014E482DE","إِنَّ لِلدَهرِ صَولَةً فَاِحذَرنَها","لا تَنامَنَّ قَد أَمِنتَ الدُهورا"],["52100D2D-9ED2-5F53-BF63-D158FF90DF3D","قَد يَبيتُ الفَتى صَحيحاً فَيَردى","بَعدَ ما كانَ آمِناً مَسرورا"],["0150D9D6-DA81-5439-BA8C-FC910891DD8C","إِنَّما الدَهرُ لَيِّنٌ وَنَطوحٌ","يَترُكُ العَظمَ واهِياً مَكسورا"],["94A5684C-6ED7-5652-AB4A-674DB2BCC813","فَسَلِ الناسَ أَينَ آلُ قُبَيسٍ","طَحطَحَ الدَهرُ قَبلَهُم سابورا"],["A2FA1E67-1E07-582B-B5B6-63BF6290853F","خَطَفَتهُ مَنِيَّةٌ فَتَرَدّى","وَهوَ في المُلكِ يَأمُلُ التَعميرا"],["8E318A6D-CA4F-5BF6-8F9F-1D366FEBF4C2","وَبَنو الأَصفَرِ المُلوكُ كَذا لَم","يَترُكِ الدَهرُ مِنهُمُ مَذكورا"],["A423D5F9-54FB-537C-9BD8-40159813AFB5","لا أَرى المَوتَ يَسبِقُ المَوتَ شَيءٌ","نَغَّصَ المَوتُ ذا الغِنى وَالفَقيرا"]]},"51D75823-0FA7-5C5A-90E7-C3F7BC2B69A5":{"t":"بكر العاذلون في وضح الصب","p":23,"s":"بكر العاذلون في وضح الصب","r":"437354","v":[["D0834FC6-42A7-588F-B592-2AA1B97AA446","بَكَرَ العاذِلونَ في وَضَحِ الصُب","ح يَقولونَ لي أَما تَستَفيقُ"],["139A45B6-479A-509A-93E5-E364C1A56A58","وَيَلومونَ فيكِ يا اِبنَةَ عَبدِ الْ","له وَالقَلبُ عِندَكُم مَوثوقُ"],["09AEA7F9-43F0-5C16-A1BA-BC0A6C2F534B","لَستُ أَدري إِذ أَكثَروا العَذلَ فيها","أَعَدُوٌّ يَلومُني أَم صَديقُ"],["8729B578-8291-5831-82D9-D5CFA3B3FB53","وَدَعَوا بِالصَبوحِ يَوماً فَجاءَت","قَينَةٌ في يَمينِها إِبريقُ"],["84B0B7F4-9281-5BBD-BE4F-84C7254E9740","قَدَّمَتهُ عَلى عُقارٍ كَعَينِ الد","ديك صَفّى سُلافَها الراووقُ"],["90704DF1-0306-5429-ABED-869FA7971ECD","مُرَّةٌ قَبلَ مَزجِها فَإِذا ما","مُزِجَت لَذَّ طَعمُها مَن يَذوقُ"],["EA058D17-70E4-5414-906C-6BBF8A6CDCD9","وَطَفا فَوقَها فَقاقيعُ كَاليا","قوتِ حُمرٌ يَزينُها التَصفيقُ"],["B1E33492-A811-563C-8504-ABDB60233273","ثُمَّ كانَ المِزاجُ ماءَ سَحابٍ","لا صَدىً آجِنٌ وَلا مَطروق"]]},"C3365C88-A66D-5C61-90A6-24BC637C71D7":{"t":"تزود من الشبعانِ خلفك نظرةً","p":23,"s":"تزود من الشبعان خلفك نظرة","r":"437348","v":[["AE6DDE5A-E6C2-501E-A694-F217EAD0C600","تَزَوَّد مِنَ الشَبعانِ خَلفَكَ نَظرَةً","فَإِنَّ بِلادَ الجوعِ حَيثُ تَميمُ"]]},"FD4194C1-71EF-5227-B5D4-9AFA9B199B49":{"t":"تضيف الحزن فانجابت عقيقته","p":23,"s":"تضيف الحزن فانجابت عقيقته","r":"437370","v":[["A55C942C-7754-597B-BE46-39EF1B3FC17E","ضَيِفَ الحُزنَ فَاِنجابَت عَقيقَتُهُ","فيها خِناذٌ وَتَقريبٌ بِلا تِيَمِ"],["8DC9D311-D483-5272-ADE2-0551467992B2","يَنتابُ بِالعِراقِ مِن بُقعانَ مَعهَدَهُ","ماءَ الشَريعَةِ أَو فَيضاً مِنَ الأَجَمِ"],["C971ABF2-CF0E-546F-9648-442C54522C0A","أَهبَطَتَّهُ الرَكبَ يَعديني وَاُلجِمُهُ","لِلنائِباتِ بِسَيرٍ مَجذَمِ الأَكَمِ"]]},"B5DC13A1-C5DD-553C-A0AC-AD40011E0CE1":{"t":"ثم أَضحوا عصف الدهر بهم","p":23,"s":"ثم أضحوا عصف الدهر بهم","r":"437351","v":[["5DD005C6-7104-51DC-AC3C-1C0EFFC79C01","ثُمَّ أَضحوا عَصَفَ الدَهرُ بِهِم","وَكَذاكَ الدَهرُ حالٌ بَعدَ حال"]]},"3A83F6E9-CAA4-50DB-AB6A-4F8F17C6A216":{"t":"رب دار بأسفل الجزع من دو","p":23,"s":"رب دار بأسفل الجزع من دو","r":"437344","v":[["4B93B0CB-5E4C-5305-9637-7135CF159867","رُبَّ دارٍ بِأَسفَلِ الجِزعِ مِن دَو","مة أَشهى إِلَيَّ مِن جَيرونِ"],["DE9450C2-54ED-5ECC-A222-E48C8DC30DB2","وَنَدامى لا يَفرَحونَ بِما نا","لوا وَلا يَرهَبونَ صَرفَ المَنونِ"],["21B56E66-D75C-573E-93DE-0B4C5AAD1033","قَد سُقيتُ الشَمولَ في دارِ بِشرٍ","قَهوَةً مُرَّةً بِماءٍ سَخينِ"]]},"842F86F0-D94F-586D-A11C-6926604E0046":{"t":"زنيم تداعاه الرِجال زِيادةً","p":23,"s":"زنيم تداعاه الرجال زيادة","r":"437360","v":[["A0DDB509-2A7C-5E02-AE44-5EC892AA019A","زَنيمٌ تَداعاهُ الرِجالُ زِيادَةً","كَما زيدَ في عَرضِ الأَديمِ الأَكارِعُ"]]},"97A91801-675B-5790-90EB-887C76AC9827":{"t":"سما صقر فأشعل جانبيها","p":23,"s":"سما صقر فأشعل جانبيها","r":"437330","v":[["F89097D8-2745-552E-A025-5760CC73A548","سَما صَقرٌ فأشعل جانِبَيها","وَالهاكَ المُرَوَّحُ وَالغَريبُ"],["4DC22002-DB48-558E-B614-791A48E85A7F","وَثَبن لَدى المَثوبَةِ مُلجَماتٍ","وَصَبَّحنَ العِبادَ وَهُنَّ شيبُ"],["147E7637-7054-5DF3-AF3B-CE2E1CA1C038","أَلا تِلكَ الغَنيمَةُ لا إِفالٌ","تُرَجّيها مَسَوَّمَةٌ وَنيبُ"],["5C88C4DE-EFCE-5B98-AC0C-D083441B9B70","تُرجّيها وَقَد صابَت بِقَرٍّ","كَما تَرجو أَصاغِرَها عَتيبُ"]]},"D6D1F0DD-7436-52D0-AA0D-6AEBF25E97E0":{"t":"طال الليل علينا واِعتكر","p":23,"s":"طال الليل علينا واعتكر","r":"437342","v":[["A25ECB0C-5F8C-5FCE-8924-B926987F83F1","طالَ اللَيلُ عَلَينا وَاِعتَكَر","وَكَأَنّي ناذِرُ الصُبحِ سَمَر"],["3234A61D-496D-5177-8B66-6BBF0E429BF4","إِذ أَتاني نَبَأٌ مِن مُنعِمٍ","لَم أَخُنهُ وَالَّذي أَعطى الشَبَر"],["E7364DB2-CF96-5959-8AA5-A030D81113DB","مِن نَجِيِّ الهَمِّ عَندي ثاوِياً","فَوقَ ما أُعلِنُ مِنهُ وَأُسِر"],["8450E624-9E91-5A1B-BC2D-6B7853B81AC5","وَكأنَّ اللَيلَ فيهِ مِثلُهُ","وَلَقِدماً طُنَّ بِاللَيلِ القِصَر"],["61E63E70-00C8-591F-99D7-AF09F72D047D","لَم أُغَمِّض طولَهُ حَتّى اِنقَضى","أَتَمَنّى لَو أَرى الصُبحَ حَسَر"],["B125E8AA-B6C2-5AD5-A67C-0840171D9EA6","شَئِزٌ جَنبي كَأَنّي مُهدَأٌ","جَعَلَ القَينُ عَلى الدَفِّ الأَبَر"],["C670AA91-E468-5D9E-BDC8-C8990D7FA0C8","غَيرُ ما عِشقٍ وَلَكِن طارِقٌ","خَلَسَ النَومَ وَأَجداني السَهَر"],["2F0F5CC9-DFA2-5ACE-8C60-4F0AF1C89C1D","أَبلِغِ النُعمانَ عَنّي مَألَكاً","فَولَ مَن قَد خافَ ظَنّاً فَاِعتَذَر"],["8FFB2221-D2A7-5FDB-9E8C-3989CE590C68","إِنَّني وَاللَهِ فَأَقبَل حِلفي","لَأَبيلٌ كُلَّما صَلّى جَأَر"],["11A6F886-7164-5349-8680-63FC3C0507D8","مُرعَدٌ أَحشاؤُهُ في هَيكَلٍ","حَسَنٌ لِمَّتُهُ وافي الشَعَر"],["60AC7467-D17B-563B-8296-78C3A11C335D","ما حَمَلتُ الغُلَّ مِن أَعدائِكُم","وَلَدى اللَهِ مِنَ العِلمِ المُسَر"],["141CBAA4-F475-5C81-998B-EA5802595546","لا تَكونَنَّ كَآسي عَظمِهِ","بِأَسىً حَتّى إِذا العَظمُ جُبِر"],["374ABE94-B126-5E1E-8687-5ED925A4CCF1","عادَ بَعدَ الجَبرِ يَنعى وَهنَهُ","يَنحُوَنَّ المَشيَ مِنهُ فَاِنكَسَر"],["665A21E4-B057-5374-8904-B029FC5685D9","وَاِذكُرِ النُعمى الَّتي لَم أَنسَها","لَكِ في السَعيِ إِذا العَبدُ كَفَر"]]},"C89F6598-24BA-5BD7-A359-75FE2442E11F":{"t":"فإِن لم تندموا فثكلت عمراً","p":23,"s":"فإن لم تندموا فثكلت عمرا","r":"437356","v":[["BDB81D50-24F2-5526-9425-DC1857C3C4DB","فَإِن لَم تَندَموا فَثَكَلتُ عَمراً","وَهاجَرتُ المُرَوَّقَ وَالسَماعا"],["F76285F1-B273-5692-978C-D5E9298888E2","وَلا وَضَعَت يَدايَ عَنانَ طِرفٍ","وَلا أَبصَرتُ مِن شَمسٍ شُعاعا"]]},"DB8ECAAC-724F-5648-BE41-089BABA2DC3B":{"t":"لبس جديدك إِني لابِس خلَقي","p":23,"s":"لبس جديدك إني لابس خلقي","r":"437355","v":[["AE944E48-80BD-51F6-88B1-196986F2F0AC","لبَس جَديدَكَ إِنّي لابِسٌ خَلَقي","وَلا جَديدَ لِمَن لَم يَلبَسِ الخَلَقا"]]},"F3170445-FD87-5F08-A2B5-F8E8A796C0D6":{"t":"للشرف العود فأَكنافه","p":23,"s":"للشرف العود فأكنافه","r":"437329","v":[["89751E32-C076-56C2-B665-A89383F45EB6","للشَرَفُ العَودُ فَأَكنافُهُ","ما بَينَ حُمرانَ فَيَنصوبِ"],["9159E4C5-53E3-59AB-AEF0-37F631A150C2","خَيرٌ لَها إِن خَشِيَت حَجرَةً","مِن رَبِّها زَيدُ بنُ أَيّوبِ"],["BDFE8832-368B-5FC7-BCEC-2B028D0847EE","مُتَّكِئاً تَخفِقُ أَبوابُهُ","يَسعى عَلَيهِ الغَيدُ بِالكوبِ"]]},"2AE92228-DC2D-5168-B799-A6159710B9D2":{"t":"لم أر مثل الفتيان في غبن ال","p":23,"s":"لم أر مثل الفتيان في غبن ال","r":"437328","v":[["038B89A6-3F39-5A7B-91CD-D0EBCF78E803","لَم أَرَ مِثلَ الفِتيانِ في غَبَنِ ال","أيّامِ يَنسونَ ما عَواقِبُها"],["DDAF9710-A947-5C49-BE5A-CA93039B2868","يَنسونَ إِخوانَهُم وَمَصرَعَهُم","وَكَيفَ تَعتاقُهُم مَخالِبُها"],["F1AA7920-B90E-50E0-BBB7-704386BB91A5","ماذا تَرَجّي النُفوسُ مِن طَلَبِ الخَيْ","ر وَحُبُّ الحَياةِ كارِبُها"],["DEADD551-84A0-5753-B085-BF6C019353A6","تَظُنُّ أَن لَن يُصيبَها عَنَتُ الدَه","ر وَرَيبُ المَنونِ صائِبُها"],["783A45DD-4502-50DC-8D1F-0380EC613996","ما بَعدَ صَنعاءَ كانَ يَعمُرُها","وُلاةُ مُلكٍ جَزلٌ مَواهِبُها"],["A1764F0A-D2C6-5D09-86B7-D7CA3CDBF219","رَفَّعَها مَن بَني لَدى قَزَعِ ال","مُزنِ وَتَندى مِسكاً مَحارِبُها"],["2D00EB8A-369B-506F-A712-5E92A73D4B8D","مَحفوفَةٌ بِالجِبالِ دونَ عُرى","الكائِدِ ما تُرتَقى غَوارِبُها"],["67D734F2-75B3-5CCD-B3F3-61898EB382DD","يَأنَسُ فيها صَوتُ النُهامِ إِذا","جاوَبَها بِالعَشِيِّ قاصِبُها"],["B6D871CA-F7C0-5E42-80D1-5BEE94998E91","ساقَت إِلَيها الأَسبابُ جُندَ بَني الْ","أحرارِ فُرسانُها مَواكِبُها"],["6E082A38-31FF-547D-8767-71F73F9F942A","وَفُوِّزَت بِالبِغالِ توسَقُ بِالْ","حتفِ وَتَسعى بِها تَوالِبُها"],["EC95305E-28E3-52AC-961D-8D5E406C237E","حَتّى رَآها الأقوال مِن طَرَفِ ال","مُنقَلِ مُخضَرَّةً كَتائِبُها"],["A4306791-49B9-5FB6-9D5D-80A57A079DCE","يَومَ يُنادونَ آلَ بَربَرَ وال","يَكسومُ لا يُفلِتَنَّ هارِبُها"],["CA0FFC31-F10D-5ED7-A59D-B15489135C6A","فَكانَ يَومٌ باقي الحَديثِ وَزا","لَت أُمَّةٌ ثابِتٌ مَراتِبُها"],["E31FC80B-D86E-5F1A-AB36-B28CEF798D5E","وَبُدِّلَ الفَتحُ بِالزَرافَةِ وَالْ","أيَام جونٌ جَمٌّ عَجائِبُها"],["BA9065D1-8276-55EC-AB83-9595E257CEB9","بَعدَ بَني تُبَّعٍ نَخاوِرَةً","قَدِ اِطمَأَنَّت بِها مَرازِبُها"],["B522E350-6C50-594C-BD5B-887CAA6EBA41","وَالحَضرُ صابَت عَلَيهِ داهِيَةٌ","من فَوقِهِ أَيِّدٌ مَناكِبُها"],["73992BDE-744D-5596-9554-CA079E06F2EC","رَبِيَّةٌ لَم تُوَقِّ وَالِدَها","يُحِبُّها إِذ أَضاعَ راقِبُها"],["6BF45675-7602-55FE-88BB-AA769CFCBDF2","إِذ غَبَقَتهُ صَهباءَ صافِيَةً","وَالخَمرُ وَهلٌ يَهيمُ شارِبُها"],["5A9989F5-FBE0-5013-B325-4C6B7CD4943A","وَأَسلَمَت أَهلَها بِلَيأَتِها","تَظُنُّ أَنَّ الرَئيسَ خاطِبُها"],["D7840D4A-3040-5A9D-BCB7-4B75EC69DBD1","في لَيلِةٍ لا يُرى بِها أَحَدٌ","يَحكي عَلَيها إِلّا كَواكِبُها"],["17EAD7F1-A0F3-5DB2-8FF6-7517426C1AB6","فَكانَ حَظُّ العَروسِ إِذ جَشَر الْ","صُبحُ دِماءً تَجري سَبائِبُها"],["72BB207C-A548-5A12-92BC-596D6ED2B976","وَخُرِّبَ الحَضرُ وَاِستُبيحَ وَقَد","أُحرِقَ في خِدرِها مَشاجِبُها"]]},"D583BE6C-85DB-57AD-B26E-A0BB34BB03DD":{"t":"لمن الدار تعفت بخيم","p":23,"s":"لمن الدار تعفت بخيم","r":"437349","v":[["B890652E-6915-53E5-8510-DFD95D329F6C","لَمِنَ الدارُ تَعَفَّت بِخِيم","أَصبَحَت غَيَّرَها طولُ القِدَم"],["2D584E15-D866-5054-9003-EEE79CA34DFE","ما تَبينُ العَينُ مِن آياتِها","غَيرَ نُؤيٍ مِثلِ خَطٍّ بِالقَلَم"],["D831610A-D15C-5BE6-97EA-4EAF64DA9910","وَثَلاثٍ كَالحَماماتِ بِها","بَينَ مَجثاهُنَّ تَوشيمُ الحِمَم"],["69199B65-F3CA-5DD6-8C93-44B34A53E475","أَسأَلُ الدارَ وَقَد أَنكَرتُها","عَن حَبيبٍ فَإِذا فيها صَمَم"],["3BA060B9-964B-58AC-874C-C2749DFF2D7E","صالِحاً قَد لَفَّها فَاِستَوثَقَت","لَفَّ بَأزِيٍّ حَماماً في سَلَم"],["91AB6234-9BA4-529A-9AC4-DA56961F6118","فَهوَ كَالدَلوِ بِكَفِّ المُستَقي","خَذَلَت عَنهُ العَراقي فَاِنجَذَم"]]},"A6E7FE84-3BFC-5344-8133-F30D43B5D06A":{"t":"ليت شعري عنِ الهمام ويأتي","p":23,"s":"ليت شعري عن الهمام ويأتي","r":"437363","v":[["07C8654D-EAB6-5659-975A-D971475DC3B3","لَيتَ شِعري عَنِ الهُمامِ وَيَأتي","ك بِخَيرِ الأَنباءِ عَطفُ السُؤالِ"],["669AB507-E329-5230-BB30-99B262F4FE6C","أَينَ عَنّا إِخطارُنا المالَ وَالأَن","فس إِذ ناهَدوا لِيَومِ المَجالِ"],["1835074C-F6EA-5A40-914D-4AC29C8B7E85","وَنِضالي في جَنبِكَ الناسَ يَرمو","نَ وَأَرمي وَكُلُّنا غَيرُ آلِ"],["BD14CC57-6CEB-57F8-9CD7-94A415D5A710","فَأُصيبُ الَّذي تُريدُ بِلا غِش","شٍ وَأُربي عَلَيهِمِ وَأُوالي"],["BF64AB8C-71F5-5A2A-AC46-CC1C341E177C","وَبِعَينيكَ كُلُّ ذاكَ تَخَطْرا","كَ وَيُمضيكَ نَبلُهُم في النِضالِ"],["4364B137-1AB8-5923-8B82-A310734069A3","جاعِلاً سِرَّكَ التُخومَ فَما أَح","فل قَولَ الوُشاةِ وَالأَنذالِ"],["F8385C83-5B24-525B-AD68-FF3BA5C30F63","لَيتَ أَنّي أَخَذتُ حَتفي بِكَفّي","وَلَم أُلقَ مَنِيَّتي في القِتالِ"],["0146C51B-6322-5739-A3AF-E14AF3511D45","مَحَلوا مَحلَهُم لِصَرعَتِنا العا","مَ فَقَد أَوقَعوا الرَحا بِالثِقالِ"]]},"C2460263-8076-5DEB-B36B-205109FE6F1E":{"t":"ليس شيء على المنون بباق","p":23,"s":"ليس شيء على المنون بباق","r":"437367","v":[["94FA003E-728F-5451-8B45-8A719DB5E647","لَيسَ شَيءٌ عَلى المَنونِ بِباقِ","غَيرُ وَجهِ المُسَبَّحِ الخَلّاقِ"],["72BE0922-4FF2-5690-A1B8-540FA3F81794","إِن نَكُن آمِنينَ فَأَجَأَنا شَر","ر مُصيبٌ ذا الوُدِّ وَالإِشفاقِ"],["A92E7067-45E2-559B-BEEE-55C12F847BCC","فَبَرِيءٌ صَدري مِنَ الظُلمِ لِلرَب","ب وَحِنثٍ بِمُمقَدِ الميثاقِ"],["473A26F5-DF87-5620-985C-7F6F130D2AA1","وَلَقَد ساءَني زِيارَةُ ذي قُر","بى حَبيبٍ لِوُدِّنا مُشتاقِ"],["728F2A21-485E-51F0-B130-ACED9F4EE0D1","ساءَهُ ما بِنا تَبَيَّنَ في الأَيدي","وَاِشناقُها إِلى الأَعناقِ"],["51599B08-7D7C-54C9-8BCA-5CCC9BC0E923","فَاِذهَبي يا أُمَيمَ غَيرَ بَعيدٍ","لا يُؤاتي العِناقُ مَن في الوِثاقِ"],["84214F8B-308E-5D44-AB7F-6A2FD19DF5E3","وَاِذهَبي يا أُمَيمَ إِن يَشَإِ اللَهُ","يُنَفِّس مِن أَزمِ هَذا الخِناقِ"],["3E89F19D-58D7-5869-8D98-DEF92B8FAA63","أَو تَكُن وُجهَةٌ فَتِلكَ سَبيلُ النا","س لا تَمنَعُ الحُتوفَ الرَواقي"],["DDA0A084-BB8A-576D-A658-976C33854E88","وَتَقولُ العُداة أَو دى عَدِيٌّ","وَبَنوهُ قَد أَيقَنوا بِعَلاقِ"],["A6F1395D-A574-5763-9313-A08646F9CC2C","يا أَبا مُسهِرٍ فَأَبلِغ رَسولاً","إِخوَتي أَن أَتَيتَ صَحنَ العِراقِ"],["B8157A17-7789-55C7-9EC2-910B121B626A","فَاِركَبوا في الحَرامِ فُكّوا أَخاكُم","إِنَّ عَيراً قَد جُهِّزَت لِاِنطِلاقِ"],["9624C5FD-6246-56E3-89D7-4544F838B521","في حَديدِ القِسطاس يَرقُبُني الحا","رِسُ وَالمَرءُ كُلَّ شَيءٍ يُلاقي"],["7A918911-9D95-5DCF-8A6D-B834196430F9","في حَديدٍ مُضاعِفٍ وَغُلولٍ","وَثِيابٍ مُنَضَّحاتٍ خَلاقِ"],["F0C665A7-4B80-56E9-812E-B26F7D7B6AD7","فَاِركَبوا في الحَرامِ فُكّوا أَخاكُم","إِنَّ عَيراً قَد جُهِّزَت لِاِنطِلاقِ"]]},"761A0D23-0B6B-5980-98BB-A7A6717D2934":{"t":"ماذا ترجون إِن أَودى ربيعكم","p":23,"s":"ماذا ترجون إن أودى ربيعكم","r":"437343","v":[["00876305-8D21-5E63-A9BC-2CA7184CF9F1","ماذا تُرَجّونَ إِن أَودى رَبيعُكُم","بَعدَ الإِلَهِ وَمَن أَذكى لَكُم نارا"],["54B94F10-0761-5A98-97F2-96B1AAE8111F","كَلّا يَميناً بِذاتِ الوَرعِ لَو حَدَثَت","فيكُم وَقابَلَ قَبرُ الماجِدِ الزارا"],["F5909EF0-BEF7-5289-A0F7-D43625F50437","بِتَلِّ حَجوَشَ ما يَدعو امُؤذِّنُهُم","لِأَمرِ دَهرٍ وَلا يَحتَثُّ أَنفارا"],["3D0654B8-FF30-5FD5-B432-29F2C259BD3E","وَأَحوَرُ العَينِ مَربوبٍ لَهُ غُسَنٌ","مُقَلَّدٍ مِن نَظامِ الدُرِّ تَقصارا"],["C53640F0-DDA7-5DBB-AFFB-983DD0BC6424","عَفِّ المَكاسِبِ ما تُكدى حُسافَتُهُ","كَالبَحرِ يَقذِفُ بِالتَيّارِ تَيّارا"],["9BE115DE-61CB-528A-8FAB-419B28D8E613","وَذي تَناويرَ مَمعونٌ لَهُ صَبَحٌ","يَغذو أَوابِدَ قَد أَفلَينَ أَمهارا"],["9C806CF6-556D-5051-8CD9-FC97F0CE07AE","كَأَنَّ رَيِّقَهُ شُؤبوبُ غادِيَةٍ","لَمّا تَقَفّى رَقيبُ النَفعِ مُسطارا"],["E98AEE77-B862-5A28-94F9-7AE05299F2D4","وَلا تَحُلُّ نَبِيَّ البِشرِ قُبَّتُهُ","تَسومُهُ الرومُ إِن تُعطوهُ قِنطارا"],["77E2D480-0E62-50BA-AF21-FCEACF49DEF3","فَأَيُّكُم لَم يَنَلهُ عُرفُ نائِلِهِ","دَثراً سَواماً وَفي الأَريافِ أَوصارا"]]},"8A3C80D5-5B47-5475-8396-50FA7100EDB7":{"t":"مضمم أَطراف العظام محنباً","p":23,"s":"مضمم أطراف العظام محنبا","r":"437358","v":[["F82FAF6D-3134-5B1B-9E44-6EEC02A2C0F8","مُضَمِّمُ أَطرافَ العِظامِ مُحَنَّباً","يُهَزهِزُ غُصناً ذا ذَوائِبَ مائِعا"],["16A5F2E7-53D3-57D6-ACBA-067523B508C5","أَجالَ عَلَيهِ بِالقَناةِ غُلامُنا","فَأَذرَعنَهُ لِخِلَّةِ الشاةِ راقِعا"],["A3454D04-C402-5F9E-9352-7946A1D0E82E","فَضافَ يُعَرّي جُلَّهُ عَن سَراتِهِ","يَبُدُّ الجِيادَ فارِهاً مُتَتابِعا"],["63CBFD33-16C1-5049-A290-4BFEC12BA918","فَآضَ كَصَدرِ الرُمحِ نَهداً مُصَدِّراً","يُكَفكِفُ مِنهُ خُنزُواناً مُنازِعا"],["71D6E8F4-1CF1-5E24-88F9-4C9C36B62B2A","وَما خُنتُ ذا عَهدٍ وَأُبتُ بِعهدِهِ","وَلَم أَحرِمِ المُضطَرَّ إِذ جاءَ قانِعا"],["2AFFA6DD-D655-5705-B828-EA29C235EF8F","أَراهُم بِحَمدِ اللَهِ بَعدَ خَجيفِهِم","غُرابُهُم إِذ مَسَّهُ الفَترُ واقِعا"]]},"6C4E6E89-D4B1-5A12-8B4A-AD695D101498":{"t":"من رآنا فليحدث نفسه","p":23,"s":"من رآنا فليحدث نفسه","r":"437368","v":[["7D824DB4-69BD-5C26-8C0E-BEE662009896","مَن رَآنا فَلَيُحَدِّث نَفسَهُ","أَنَّهُ موفٍ عَلى قَرنِ زَوال"],["2363C340-F052-59A1-BB4B-A127D547B88E","فَصَروفُ الدَهرِ لا تَبقى لَها","وَلِما تَأتي بِهِ صُمُّ الجِبال"],["DEAB1751-594E-586A-8C00-0EF1CFC8150B","رُبَّ رَكبٍ قَد أَناخوا حَولَنا","يَشرَبونَ الخَمرَ بِالماءِ الزُلال"],["8957C652-BB3C-507B-85E5-3B99323288B2","وَالأَباريقُ عَلَيها قُدُمٌ","وَجِيادُ الخَيلِ تَجري في الجِلال"],["C984683F-EBB3-503C-B690-CBCAD4DAF7C5","عَمِروا الدَهرَ بِعَيشٍ حَسَنٍ","قَطَعوا دَهرَهُمُ غَيرَ عِجال"],["6AE1A248-CB64-51F5-A0AB-AC6963E65903","عَصَفَ الدَهرُ بِهِم فَاِنقَرَضوا","وَكَذاكَ الدَهرُ حالاً بَعدَ حال"]]},"A05B4131-F08A-5BBE-8A00-FC05E48FBD5E":{"t":"من يكن ذا لقح راخيات","p":23,"s":"من يكن ذا لقح راخيات","r":"437338","v":[["9E3929D7-9682-5DC4-995D-5B7DBF48A32D","مَن يَكُن ذا لُقَحٍ راخِياتٍ","فَلِقاحي ما تَذوقُ الشَعيرا"],["86915287-6162-5D76-97CD-1C9E7A9290AD","بَل حَوابٍ في ظِلالِ فَسيلٍ","مُلِئَت أَجوافُهُنَّ عَصيرا"],["B53F65F0-F01E-5336-840D-5D511EBE5C07","فَتَهادَرنَ كَذاكَ زَماناً","ثمَّ مُوِّتنَ فَكُنَّ قُبورا"]]},"CE765A8A-67FC-505E-94B3-A2D314B599B9":{"t":"نادمت في الديرِ بني علقما","p":23,"s":"نادمت في الدير بني علقما","r":"437369","v":[["E8001D3D-6FCD-5214-A0E9-1A9E2BFCF0A1","نادَمتُ في الدَيرِ بَني عَلقَما","مَشمولَةً تَحسَبُها عَندَما"],["F687B5BA-8E82-59DA-AD2B-81285BF99DCB","كَأَنَّ ريحَ المِسكِ في كَأسِها","إِذا مَزَجناها بِماءِ السَما"],["0E3B8BFB-93CF-570C-9AB4-79B013FFBA70","مَن سَرَّهُ العَيشُ وَلَذّاتُهُ","فَليَجعَلِ الراحَ لَهُ سُلَّما"],["35096AF4-B64E-52AC-8FAB-EBC72EB5018B","عَلقَمَ ما بالُكَ لَم تَأتِنا","أَما اِشتَهَيتَ اليَومَ أَن تَنعَما"]]},"E0BF35F9-0A9D-5476-8675-8F37175437FA":{"t":"ناشدتنا بكتاب الله حرمتنا","p":23,"s":"ناشدتنا بكتاب الله حرمتنا","r":"437359","v":[["FA987F5D-1D09-50E3-A087-CD88389CF7C3","ناشَدتَنا بِكتابِ اللَهِ حُرمَتَنا","وَلَم تَكُن بِكِتابِ اللَهِ تَرتَفِعُ"]]},"81BAD591-AE82-58BE-A279-D8AD03501E79":{"t":"نرقع دنيانا بتمزيق دينِنا","p":23,"s":"نرقع دنيانا بتمزيق ديننا","r":"437357","v":[["ACFCD784-8DBB-59CD-B112-0C4DCE074706","نُرَقِّعُ دُنيانا بِتَمزيقِ دينِنا","فَلا دينُنا يَبقى وَلا ما نُرَقِّعُ"]]},"C943065B-D42A-53A4-9CE1-84F427B8D560":{"t":"وتفكر رب الخورنقِ إِذ أش","p":23,"s":"وتفكر رب الخورنق إذ أش","r":"437340","v":[["247B796A-A160-520C-9B77-814CC059FC1B","وَتَفَكَّر رَبَّ الخَوَرنَقِ إِذ أش","رَفَ يَوماً وَلِلهُدى تَفكيرُ"],["6C2CB79C-147E-5A5B-8E9F-6C6EE9931386","سَرَّهُ حالُهُ وَكَثرَةُ ما يَم","لك وَالبَحرُ مُعرَضاً وَالسَديرُ"],["F87E7015-80DD-5D97-B651-BFFB016BDB96","فَاِرعَوى قَلبُهُ وَقالَ فَما غَبْ","طة حَيٍّ إِلى المَماتِ يَصيرُ"],["0CB19AC5-5D0E-589A-B0A9-2F788D12B845","ثُمَّ بَعدَ القَلاحِ وَالمُلكِ وَالنِع","مة وَأَرَتهُم هُناكَ القُبورُ"],["0010EC0E-694F-5A1B-83A2-B72CB0DC2F7B","ثُمَّ صاروا كَأَنَّهُم وَرَقٌ جَف","ف فَأَلوَت بِهِ الصَبا وَالدَبورُ"]]},"B2227D61-992F-5C36-BFDF-545EC209D69D":{"t":"وجاعل الشمسِ مصراً لاخفاء به","p":23,"s":"وجاعل الشمس مصرا لاخفاء به","r":"437350","v":[["E9F56BC7-D6EF-5A6F-93C6-184E06776C22","وَجاعِلُ الشَمسِ مِصراً لا خَفاءَ بِهِ","بَينَ النَهارِ وَبَينَ اللَيلِ قَد فَصَل"]]},"C5820BEA-34EC-5A38-B2DC-2F663E2268E3":{"t":"وغصن على الحيقارِ وسط جنوده","p":23,"s":"وغصن على الحيقار وسط جنوده","r":"437334","v":[["B8A12B0F-7D18-57FF-AA4E-8A3DC1A96393","وَغُصنَ عَلى الحَيقارِ وَسطَ جُنودِهِ","وَبَيَّنَ في فَيداشِهِ رَبُّ مارِدِ"],["05018B62-FC8E-5334-9545-A1BBB1870B4D","سَلَبنَ قُباذاً رَبَّ فارِسَ مُلكَهُ","وَحَشَّت بِكَفَّيهِ بَوارِقُ آمِدِ"]]},"D7E25214-5439-5EC8-AA45-3277876A6E37":{"t":"ولا تأمنن من مبغِضٍ قرب دارِه","p":23,"s":"ولا تأمنن من مبغض قرب داره","r":"437333","v":[["3DCA3BA7-96A6-5794-935B-FDF872C977F3","وَلا تَأمَنَن مِن مُبغِضٍ قُربَ دارِهِ","وَلا مِن مُحِبٍّ إِن يَمَلَّ فَيَبعُدا"]]},"D95A9AD8-7B9B-549D-B592-64F1BE2997DF":{"t":"ويح أم دارٍ حللنا بها","p":23,"s":"ويح أم دار حللنا بها","r":"437347","v":[["2270EF21-2D8A-52C8-8CC7-9818D7A0A7D2","وَيحَ أُمِّ دارٍ حَلَلنا بِها","بَينَ الثُوَيَّةِ وَالمَردَمَه"],["46651A9A-B0A9-5603-8660-13618937289F","بَرِيَّةٍ غُرِسَت في السَوادِ","كَغَرسِ المَضيفَةِ في اللِهزِمَه"],["F26E6C28-EB43-51F1-9DC4-32EF6BBB5784","لِسانٌ لِعُربَةَ ذو وَلغَةٍ","تُوَلَّعُ في الريفِ بِالهَندَمَه"]]},"8958600D-E3D6-5E4C-B432-4EDA33148596":{"t":"ويح عمرِو بن عدي من رجل","p":23,"s":"ويح عمرو بن عدي من رجل","r":"437365","v":[["D11319EE-7F17-592C-9021-25914ACC0547","وَيحَ عَمرِو بنِ عَدِيٍّ مِن رَجُل","خانَ يَوماً بَعدَ ما قيلَ كَمَل"],["8CE7CDFF-8C4D-5A3B-9771-DAC32E94CD0A","كانَ لا يَعقِلُ حَتّى ما إِذا","جاءَ يَومٌ يَأكُلُ الناسَ عَقَل"],["E4BF1F81-4783-597C-8FF2-314F6CE8FED3","أَبِهِم دَلاكَ عَمرٌو لِلرَدى","وَقَديماً حينَ لِلمَرءِ الأَجَل"],["1A2AB6DA-4512-5B93-B604-D44F34B2524D","لَيتَ نُعمانَ عَلَينا مَلِكٌ","وَبُنَيٌّ لِيَ حَيٌّ لَم يَزَل"],["F452F808-ACDA-57BC-B0D4-DFE9F6D4542C","قَد تَنَظَّرنا لِغادٍ أَوبَةً","كانَ لَو يُغني عَنِ المَرءِ الأَمَل"],["0BF24787-EC06-576A-9230-38C5E5E4BF2C","بانَ مَعهُ عَضُدٌ مَع ساعِدٍ","بُؤسا لِلدَهرِ وَبُؤسا لِلرَجُل"]]},"95973357-A751-5F02-B4B0-DC41A9C917FB":{"t":"يا لرهطي أو قدوا نارا","p":23,"s":"يا لرهطي أو قدوا نارا","r":"437341","v":[["8F55125D-4726-5270-AE2E-342EA3C94738","يا لِرَهطي أَو قِدوا نارا","إِنَّ الَّذي تَهوَونَ قَد حارا"],["3B55FDA3-7ED1-542E-91A5-AB9B62DFCCA6","رُبَّ نارٍ بِتُّ أَرمِقُها","تَقضَمُ الهِندِيَّ وَالغارا"],["10A0C3C4-A5A8-5913-9A63-8AB4DC146845","عِندَها خِلٌّ يُثَوِّرُها","عاقِدٌ في الجيدِ تِقصارا"]]}}}