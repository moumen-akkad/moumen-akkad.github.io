{"v":1,"poems":{"A05364E0-2D0E-592B-B3C8-D2D5707F8944":{"t":"أأجمع صحبتي","p":21,"s":"أأجمع صحبتي","r":"435604","v":[["126E0D39-6D70-5019-BD93-817FD765D6B3","أأجـمع صحبتي سحر ارتحالا","ولم أشعـر ببين منـك هـالا"],["DC9FC4FF-EFEE-5ED6-A28C-23C8E1A762EC","ولم أر مثـل هالـة في معـد","تشبـه حسنهـا ألاّ الهـلالا"],["35FDEB1C-1FF2-5897-877D-55217B6143F0","ألا أبلغ بنـي جشم بن بكـر","وتغلـب كلها نبـأ جـلالا"],["A8F09C4D-DD31-5F80-B3F2-B1E8641B4085","بأن الـماجد البطل ابن عمرو","غداة نطاع قد صدق القتـالا"],["F1773838-9C71-5CC5-BFC9-DE6F89514C3C","كـتيبتـه مـلملمـة رداح","إذا يرمونـها تنبـي النبـالا"],["591396DC-950E-5B7E-9E66-84FC9441A27E","جزى الله الأغـر يزيد خيـرا","ولقـاه الـمسـرة والجمـالا"],["DEC4C9EE-DBD6-5E40-9CDD-9DE86BBDB76F","بمأخذه ابن كلثـوم بن سعـد","يزيـد الخيـر نازلـه نـزالا"],["3AFC2559-C6FF-5762-AE1F-F4804AC45FDC","بـجمع من بني قـران صيـد","يـجيلون الطعـان إذا أجـالا"],["9885B453-D1BA-51A9-B321-28B274331ABE","يزيـد يقـدم الشقـراء حتـى","يروي صدرها الأسـل النهـالا"]]},"2F2F6F0E-B88B-51D7-9696-5658835953D2":{"t":"ألا من مبلغ","p":21,"s":"ألا من مبلغ عمرو بن هند","r":"435330","v":[["6A4014FF-8E75-50D0-8592-CB22EF5D4BB9","أَلا مَن مُبلِغٌ عَمرَو بنَ هِندٍ","فَما رُعِيَت ذَمامَةُ مَن رَعَيتا"],["DAA19248-151A-52CE-9B79-5CF36CA718F6","أَتَغصِبُ مالِكاً بِذُنوبِ تَيمٍ","لَقَد جِئتَ المَحارِمَ وَاِعتَدَيتا"],["CB33A325-D1FD-573F-B4B6-3B9ECDD46E65","فَلَولا نِعمَةٌ لِأَبيكَ فين","لَقَد فُضَّت قَناتُكَ أَو ثَوَيتا"],["442B01CE-4177-5EE8-8A19-C9237EBB5001","أَتَنسى رِفدَنا بِعُوَيرِضاتٍ","غَداةَ الخَيلُ تَخفِرُ ما حَوَيتا"],["131F0356-BD6B-5DAC-BD01-BB23E56DF55F","وَكُنّا طَوعَ كَفِّكَ يا اِبنَ هِندٍ","بِنا تَرمي مَحارِمَ مَن رَمَيتا"],["3FF6B887-32A8-5619-8F8D-252B157A5292","سَتَعلَمُ حينَ تَختَلِفُ العَوالي","مَنَ الحامونَ ثَغرَكَ إِن هَوَيتا"],["CCE0C59B-3EF9-53E8-93FB-540F337F5BFA","وَمَن يَغشى الحُروبَ بِمُلهِباتٍ","تُهَدِّمُ كُلَّ بُنيانٍ بَنَيتا"],["141179E3-0571-5722-A30A-3566E885FF3B","إِذا جاءَت لَهُم تِسعونَ أَلف","عَوابِسُهُنَّ وَرداً أَو كُمَيتا"]]},"6EC2F019-8009-572F-B328-D14CDEE212CB":{"t":"ألا من مبلغ","p":21,"s":"ما بامرئ من ضؤلة في وائل","r":"469705","v":[["6E953E8E-913D-5658-B5D6-30FBB7B6A669","ما بِامرِئٍ مِن ضُؤلَةٍ في وائِلٍ","وَرِثَ الثُوَيرَ وَمالِكاً وَمُهَلهِلا"],["2BCD9873-CC56-52E1-A1F4-5C7246C6C4C1","خالي بِذي بَقَرٍ حَمى أَصحابَهُ","وَشَرى بِحُسنِ حَديثِهِ أَن يُقتَلا"],["7FC36B4E-F16D-5D64-B96B-DC4C06871617","ذاكَ الثُوَيرُ فَما أُحِبُّ بِفَضلِهِ","عِندَ التَفاضُلِ فَضلَ قَومٍ أَفضَلا"],["AF2958AC-4F8B-547A-8608-B2B5B68F0451","عَمي الَّذي طَلَبَ العُداةَ فَنالَه","بَكراً فَجَلَّلَها الجِيادَ بِكِنهَلا"],["37462A5A-C3CC-58EC-9309-664A0F1E5A33","وَأَبي الَّذي حَمَلَ المِئينَ وَناطِقُ ال","مَعروفِ إِذ عَيِّ الخَطيبُ المِفصلا"]]},"6F53EA12-64F6-5751-89AF-426DA144D02F":{"t":"أَلاَ هُبِّي بِصَحْنِكِ فَاصْبَحِيْنَا ( معلقة )","p":21,"s":"ألا هبي بصحنك فاصبحينا ( معلقة )","r":"435971","v":[["2EDEAF54-076B-5C09-AC1A-A3A374CA1E47","أَلاَ هُبِّي بِصَحْنِكِ فَاصْبَحِيْنَـا","وَلاَ تُبْقِي خُمُـوْرَ الأَنْدَرِيْنَـا"],["10494C16-C017-5B53-B559-AFC774E95D6A","مُشَعْشَعَةً كَأَنَّ الحُصَّ فِيْهَـا","إِذَا مَا المَاءَ خَالَطَهَا سَخِيْنَـا"],["A9940643-1025-5323-9094-C3A478F8B8D1","تَجُوْرُ بِذِي اللَّبَانَةِ عَنْ هَـوَاهُ","إِذَا مَا ذَاقَهَـا حَتَّـى يَلِيْنَـا"],["87267D2E-9C48-58B4-8466-944CFAA74748","تَرَى اللَّحِزَ الشَّحِيْحَ إِذَا أُمِرَّتْ","عَلَيْـهِ لِمَـالِهِ فِيْهَـا مُهِيْنَـا"],["7AC4B817-5DA6-5C24-A796-1548337CA0F6","صَبَنْتِ الكَأْسَ عَنَّا أُمَّ عَمْـرٍو","وَكَانَ الكَأْسُ مَجْرَاهَا اليَمِيْنَـا"],["D0B85D30-4E85-53DE-9F7A-72A8C4D318EB","وَمَا شَـرُّ الثَّـلاَثَةِ أُمَّ عَمْـرٍو","بِصَاحِبِكِ الذِي لاَ تَصْبَحِيْنَـا"],["BA0154EB-0817-53DD-8E45-57D54A15995C","وَكَأْسٍ قَدْ شَـرِبْتُ بِبَعْلَبَـكٍّ","وَأُخْرَى فِي دِمَشْقَ وَقَاصرِيْنَـا"],["6C25E052-A007-5D3D-970C-D87505DDFEFA","وَإِنَّا سَـوْفَ تُدْرِكُنَا المَنَـايَا","مُقَـدَّرَةً لَنَـا وَمُقَـدِّرِيْنَـا"],["85FC408A-E9DA-5FBF-87E0-B5477E8C43C9","قِفِـي قَبْلَ التَّفَرُّقِ يَا ظَعِيْنـَا","نُخَبِّـرْكِ اليَقِيْـنَ وَتُخْبِرِيْنَـا"],["E0A5ADE7-040B-5C83-B45F-32BE6D1C05C3","قِفِي نَسْأَلْكِ هَلْ أَحْدَثْتِ صَرْماً","لِوَشْكِ البَيْنِ أَمْ خُنْتِ الأَمِيْنَـا"],["1B06CD27-356E-55D8-8F14-FC1055DED9AB","بِيَـوْمِ كَرِيْهَةٍ ضَرْباً وَطَعْنـاً","أَقَـرَّ بِـهِ مَوَالِيْـكِ العُيُوْنَـا"],["4046772E-BF4F-5261-B031-68479A1ED88E","وَأنَّ غَـداً وَأنَّ اليَـوْمَ رَهْـنٌ","وَبَعْـدَ غَـدٍ بِمَا لاَ تَعْلَمِيْنَـا"],["55D9F456-4A3C-5DAD-8C97-26A62A3FBF2E","تُرِيْكَ إِذَا دَخَلَتْ عَلَى خَـلاَءٍ","وَقَدْ أَمِنْتَ عُيُوْنَ الكَاشِحِيْنَـا"],["2756048A-2AD9-5B4E-BEBC-89F01F93C195","ذِرَاعِـي عَيْطَلٍ أَدَمَـاءَ بِكْـرٍ","هِجَـانِ اللَّوْنِ لَمْ تَقْرَأ جَنِيْنَـا"],["7BEB667D-864B-5CEE-BDE9-D1E6F0E7C51C","وثَدْياً مِثْلَ حُقِّ العَاجِ رَخِصـاً","حَصَـاناً مِنْ أُكُفِّ اللاَمِسِيْنَـا"],["D5B23918-15DA-550C-93D6-134598A4579D","ومَتْنَى لَدِنَةٍ سَمَقَتْ وطَالَـتْ","رَوَادِفُهَـا تَنـوءُ بِمَا وَلِيْنَـا"],["851CB840-5BC2-5D08-AA99-FCDCFA748F72","وَمأْكَمَةً يَضِيـقُ البَابُ عَنْهَـا","وكَشْحاً قَد جُنِنْتُ بِهِ جُنُونَـا"],["A66A595B-6ACC-5893-85DE-2B8FDD4CAA06","وسَارِيَتِـي بَلَنْـطٍ أَو رُخَـامٍ","يَرِنُّ خَشَـاشُ حَلِيهِمَا رَنِيْنَـا"],["71C9069F-8FC9-50BA-B344-B3F5295CC8B2","فَمَا وَجَدَتْ كَوَجْدِي أُمُّ سَقبٍ","أَضَلَّتْـهُ فَرَجَّعـتِ الحَنِيْنَـا"],["E9D68758-5419-58D0-9B77-3FC8A58616C8","ولاَ شَمْطَاءُ لَم يَتْرُك شَقَاهَـا","لَهـا مِن تِسْعَـةٍ إلاَّ جَنِيْنَـا"],["5D4EF5CF-6349-5EE7-9CD5-541F8562CB0F","تَذَكَّرْتُ الصِّبَا وَاشْتَقْتُ لَمَّـا","رَأَيْتُ حُمُـوْلَهَا أصُلاً حُدِيْنَـا"],["8C3A506D-B64E-53D1-93A5-9E637EF99211","فَأَعْرَضَتِ اليَمَامَةُ وَاشْمَخَـرَّتْ","كَأَسْيَـافٍ بِأَيْـدِي مُصْلِتِيْنَـا"],["09C9906E-33E4-538C-BCBB-C9C9174C9C55","أَبَا هِنْـدٍ فَلاَ تَعْجَـلْ عَلَيْنَـا","وَأَنْظِـرْنَا نُخَبِّـرْكَ اليَقِيْنَــا"],["D6E3C98A-9F46-5B47-AF84-85C25225A31B","بِأَنَّا نُـوْرِدُ الـرَّايَاتِ بِيْضـاً","وَنُصْـدِرُهُنَّ حُمْراً قَدْ رُوِيْنَـا"],["76D285D3-38A2-56AD-A2F3-A6963BA8CC99","وَأَيَّـامٍ لَنَـا غُـرٍّ طِــوَالٍ","عَصَيْنَـا المَلِكَ فِيهَا أَنْ نَدِيْنَـا"],["08E0AE35-50A5-5668-BC9D-52297E8D7433","وَسَيِّـدِ مَعْشَـرٍ قَدْ تَوَّجُـوْهُ","بِتَاجِ المُلْكِ يَحْمِي المُحْجَرِيْنَـا"],["9582FFEB-9FA6-5CA2-86ED-BC3F2A813233","تَرَكْـنَ الخَيْلَ عَاكِفَةً عَلَيْـهِ","مُقَلَّـدَةً أَعِنَّتَهَـا صُفُـوْنَـا"],["545590EA-B769-57DF-9A3F-7FEFD04F597B","وَأَنْزَلْنَا البُيُوْتَ بِذِي طُلُـوْحٍ","إِلَى الشَامَاتِ نَنْفِي المُوْعِدِيْنَـا"],["0062BE78-729C-5DC4-88FA-E9B7D8DD3E56","وَقَدْ هَرَّتْ كِلاَبُ الحَيِّ مِنَّـا","وَشَـذَّبْنَا قَتَـادَةَ مَنْ يَلِيْنَـا"],["57FEEB98-AB3C-5FBA-8481-D29AD0F118B6","مَتَى نَنْقُـلْ إِلَى قَوْمٍ رَحَانَـا","يَكُوْنُوا فِي اللِّقَاءِ لَهَا طَحِيْنَـا"],["E7995CE0-BA7F-5AF0-9DAD-94BCB4644866","يَكُـوْنُ ثِقَالُهَا شَرْقِيَّ نَجْـدٍ","وَلُهْـوَتُهَا قُضَـاعَةَ أَجْمَعِيْنَـا"],["DD59BF67-6EAF-5B2A-B5FC-ABE0FF032951","نَزَلْتُـمْ مَنْزِلَ الأَضْيَافِ مِنَّـا","فَأَعْجَلْنَا القِرَى أَنْ تَشْتِمُوْنَـا"],["90CB6996-B749-5A3F-9418-CFFBB6F43507","قَرَيْنَاكُـمْ فَعَجَّلْنَـا قِرَاكُـمْ","قُبَيْـلَ الصُّبْحِ مِرْدَاةً طَحُوْنَـا"],["DF8518A1-5B2C-5CD7-9EAA-B79B735ABF1F","نَعُـمُّ أُنَاسَنَـا وَنَعِفُّ عَنْهُـمْ","وَنَحْمِـلُ عَنْهُـمُ مَا حَمَّلُوْنَـا"],["40700974-9DC0-5E69-9910-F230CDC3B481","نُطَـاعِنُ مَا تَرَاخَى النَّاسُ عَنَّـا","وَنَضْرِبُ بِالسِّيُوْفِ إِذَا غُشِيْنَـا"],["0CCFFC35-65DE-5662-BF4D-C52F0FA35636","بِسُمْـرٍ مِنْ قَنَا الخَطِّـيِّ لُـدْنٍ","ذَوَابِـلَ أَوْ بِبِيْـضٍ يَخْتَلِيْنَـا"],["E419D2B0-2CDD-5185-8BED-6D067A7C106A","كَأَنَّ جَمَـاجِمَ الأَبْطَالِ فِيْهَـا","وُسُـوْقٌ بِالأَمَاعِـزِ يَرْتَمِيْنَـا"],["CF6EBAC7-8C08-59B4-BC80-3AB853C1DC41","نَشُـقُّ بِهَا رُؤُوْسَ القَوْمِ شَقًّـا","وَنَخْتَلِـبُ الرِّقَـابَ فَتَخْتَلِيْنَـا"],["CAB21657-A08A-5FD0-8353-6667BEA5B0AC","وَإِنَّ الضِّغْـنَ بَعْدَ الضِّغْنِ يَبْـدُو","عَلَيْـكَ وَيُخْرِجُ الدَّاءَ الدَّفِيْنَـا"],["919A5588-5EDC-53FD-8170-FBB222C5910E","وَرِثْنَـا المَجْدَ قَدْ عَلِمَتْ مَعَـدٌّ","نُطَـاعِنُ دُوْنَهُ حَـتَّى يَبِيْنَـا"],["02D19137-7EB7-5053-809C-02FA845E4B54","وَنَحْنُ إِذَا عِمَادُ الحَيِّ خَـرَّتْ","عَنِ الأَحْفَاضِ نَمْنَعُ مَنْ يَلِيْنَـا"],["920B927E-5319-5546-A153-5AD98A8D14C8","نَجُـذُّ رُؤُوْسَهُمْ فِي غَيْرِ بِـرٍّ","فَمَـا يَـدْرُوْنَ مَاذَا يَتَّقُوْنَـا"],["47384198-9983-54F9-83DF-3D3F7A6128D0","كَأَنَّ سُيُـوْفَنَا منَّـا ومنْهُــم","مَخَـارِيْقٌ بِأَيْـدِي لاَعِبِيْنَـا"],["B4467E3A-A72D-5BA0-960F-97FCEFB6EEC5","كَـأَنَّ ثِيَابَنَـا مِنَّـا وَمِنْهُـمْ","خُضِبْـنَ بِأُرْجُوَانِ أَوْ طُلِيْنَـا"],["368B3FBE-254A-5C8B-B65C-80E2058DDE1A","إِذَا مَا عَيَّ بِالإِسْنَـافِ حَـيٌّ","مِنَ الهَـوْلِ المُشَبَّهِ أَنْ يَكُوْنَـا"],["FFC9FDFE-D2CF-51A4-8149-076056C03F44","نَصَبْنَـا مِثْلَ رَهْوَةِ ذَاتَ حَـدٍّ","مُحَافَظَـةً وَكُـنَّا السَّابِقِيْنَـا"],["590C51BA-5F91-52D9-AC85-77416A2C59AF","بِشُبَّـانٍ يَرَوْنَ القَـتْلَ مَجْـداً","وَشِيْـبٍ فِي الحُرُوْبِ مُجَرَّبِيْنَـا"],["7E77F694-9AC2-58CE-962C-7CF931123CA9","حُـدَيَّا النَّـاسِ كُلِّهِمُ جَمِيْعـاً","مُقَـارَعَةً بَنِيْـهِمْ عَـنْ بَنِيْنَـا"],["8CAF8B79-9284-56D3-AA44-A56F0F978264","فَأَمَّا يَـوْمَ خَشْيَتِنَـا عَلَيْهِـمْ","فَتُصْبِـحُ خَيْلُنَـا عُصَباً ثُبِيْنَـا"],["D8531457-C80A-585C-9D96-994C1FCE0954","وَأَمَّا يَـوْمَ لاَ نَخْشَـى عَلَيْهِـمْ","فَنُمْعِــنُ غَـارَةً مُتَلَبِّبِيْنَــا"],["7125B07F-C64A-5404-9A6C-94A4EE9C4B08","بِـرَأْسٍ مِنْ بَنِي جُشْمٍ بِنْ بَكْـرٍ","نَـدُقُّ بِهِ السُّـهُوْلَةَ وَالحُزُوْنَـا"],["26AE69F1-E276-5179-B8BA-F70E3236114C","أَلاَ لاَ يَعْلَـمُ الأَقْـوَامُ أَنَّــا","تَضَعْضَعْنَـا وَأَنَّـا قَـدْ وَنِيْنَـا"],["A8B17D11-C8B5-54CA-B29E-899A5DDC9661","أَلاَ لاَ يَجْهَلَـنَّ أَحَـدٌ عَلَيْنَـا","فَنَجْهَـلَ فَوْقَ جَهْلِ الجَاهِلِيْنَـا"],["45184C0B-9A9F-5029-9083-A74CE84222A3","بِاَيِّ مَشِيْئَـةٍ عَمْـرُو بْنَ هِنْـدٍ","نَكُـوْنُ لِقَيْلِكُـمْ فِيْهَا قَطِيْنَـا"],["D67FDE31-C337-515F-89BF-3715580CE6D8","بِأَيِّ مَشِيْئَـةٍ عَمْـرَو بْنَ هِنْـدٍ","تُطِيْـعُ بِنَا الوُشَـاةَ وَتَزْدَرِيْنَـا"],["859CF4E8-49F7-59FD-8AEF-690242830571","تَهَـدَّدُنَـا وَتُوْعِـدُنَا رُوَيْـداً","مَتَـى كُـنَّا لأُمِّـكَ مَقْتَوِيْنَـا"],["836CB812-98BF-58D8-87D8-97484D7A0A5B","فَإِنَّ قَنَاتَنَـا يَا عَمْـرُو أَعْيَـتْ","عَلى الأَعْـدَاءِ قَبَلَكَ أَنْ تَلِيْنَـا"],["9077D154-B9FA-52FF-8C18-21AEAB851267","إِذَا عَضَّ الثَّقَافُ بِهَا اشْمَـأَزَّتْ","وَوَلَّتْـهُ عَشَـوْزَنَةً زَبُـوْنَـا"],["4035FC29-862A-5AF4-B8CB-738993C73A92","عَشَـوْزَنَةً إِذَا انْقَلَبَتْ أَرَنَّـت","تَشُـجُّ قَفَا المُثَقِّـفِ وَالجَبِيْنَـا"],["7421E6B8-DEBA-5E8A-B1F1-E267D152A360","فَهَلْ حُدِّثْتَ فِي جُشَمٍ بِنْ بَكْـرٍ","بِنَقْـصٍ فِي خُطُـوْبِ الأَوَّلِيْنَـا"],["B6E93739-CDD9-5ECB-985E-05A32EBE2F10","وَرِثْنَـا مَجْدَ عَلْقَمَةَ بِنْ سَيْـفٍ","أَبَـاحَ لَنَا حُصُوْنَ المَجْدِ دِيْنَـا"],["01508D8E-993A-56EF-83D3-F56369B9AC5B","وَرَثْـتُ مُهَلْهِـلاً وَالخَيْرَ مِنْـهُ","زُهَيْـراً نِعْمَ ذُخْـرُ الذَّاخِرِيْنَـا"],["8C467528-54EF-5FE7-81C4-CB88C183B887","وَعَتَّـاباً وَكُلْثُـوْماً جَمِيْعــاً","بِهِـمْ نِلْنَـا تُرَاثَ الأَكْرَمِيْنَـا"],["E3CB19A7-5EBE-5481-981F-DD60592B4A50","وَذَا البُـرَةِ الذِي حُدِّثْتَ عَنْـهُ","بِهِ نُحْمَى وَنَحْمِي المُلتَجِينَــا"],["0010C692-B3A3-512E-BCBE-7B4BE5EDCE46","وَمِنَّـا قَبْلَـهُ السَّاعِي كُلَيْـبٌ","فَـأَيُّ المَجْـدِ إِلاَّ قَـدْ وَلِيْنَـا"],["08389132-A2F4-53AD-8029-1B0379A91BA0","مَتَـى نَعْقِـد قَرِيْنَتَنَـا بِحَبْـلٍ","تَجُـذَّ الحَبْلَ أَوْ تَقْصِ القَرِيْنَـا"],["CFC1ED81-420F-53D8-9BD7-850795FBF5A3","وَنُوْجَـدُ نَحْنُ أَمْنَعَهُمْ ذِمَـاراً","وَأَوْفَاهُـمْ إِذَا عَقَـدُوا يَمِيْنَـا"],["22C17C11-1048-5B38-B80B-B36C8B6E45C1","وَنَحْنُ غَدَاةَ أَوْقِدَ فِي خَـزَازَى","رَفَـدْنَا فَـوْقَ رِفْدِ الرَّافِدِيْنَـا"],["8479B8DB-4180-55D3-BC7E-1E27395B0D62","وَنَحْنُ الحَابِسُوْنَ بِذِي أَرَاطَـى","تَسَـفُّ الجِلَّـةُ الخُوْرُ الدَّرِيْنَـا"],["FB9B30C0-4037-5A91-B96B-2695D2BBFAFD","وَنَحْنُ الحَاكِمُـوْنَ إِذَا أُطِعْنَـا","وَنَحْنُ العَازِمُـوْنَ إِذَا عُصِيْنَـا"],["9CFEE63A-6E0E-5D58-A00B-F48BB549AC94","وَنَحْنُ التَّارِكُوْنَ لِمَا سَخِطْنَـا","وَنَحْنُ الآخِـذُوْنَ لِمَا رَضِيْنَـا"],["FC092C78-108F-51E1-9EB0-7AA8B49EF168","وَكُنَّـا الأَيْمَنِيْـنَ إِذَا التَقَيْنَـا","وَكَـانَ الأَيْسَـرِيْنَ بَنُو أَبَيْنَـا"],["14158DF2-E940-5581-98F2-502F26E9F73C","فَصَالُـوا صَـوْلَةً فِيْمَنْ يَلِيْهِـمْ","وَصُلْنَـا صَـوْلَةً فِيْمَنْ يَلِيْنَـا"],["9AC76E22-0B98-592C-9D4A-CB9A5CB60D12","فَـآبُوا بِالنِّـهَابِ وَبِالسَّبَايَـا","وَأُبْـنَا بِالمُلُـوْكِ مُصَفَّدِيْنَــا"],["23AACC71-7550-53B9-879E-7D78730EBCFE","إِلَيْكُـمْ يَا بَنِي بَكْـرٍ إِلَيْكُـمْ","أَلَمَّـا تَعْـرِفُوا مِنَّـا اليَقِيْنَـا"],["8F456FC1-0E8A-5B04-870F-BFB90B082DF9","أَلَمَّـا تَعْلَمُـوا مِنَّا وَمِنْكُـمْ","كَتَـائِبَ يَطَّعِـنَّ وَيَرْتَمِيْنَـا"],["973289D9-3509-56D0-A663-1B3A4B972A8B","عَلَيْنَا البَيْضُ وَاليَلَبُ اليَمَانِـي","وَأسْيَـافٌ يَقُمْـنَ وَيَنْحَنِيْنَـا"],["53325FA9-353E-521A-940E-94157AFA4585","عَلَيْنَـا كُـلُّ سَابِغَـةٍ دِلاَصٍ","تَرَى فَوْقَ النِّطَاقِ لَهَا غُضُوْنَـا"],["875C551F-D097-5034-BE1F-EB1DA24716B2","إِذَا وَضِعَتْ عَنِ الأَبْطَالِ يَوْمـاً","رَأَيْـتَ لَهَا جُلُوْدَ القَوْمِ جُوْنَـا"],["8426A606-23FD-52CE-907B-9157FBBB41C7","كَأَنَّ غُضُـوْنَهُنَّ مُتُوْنُ غُـدْرٍ","تُصَفِّقُهَـا الرِّيَاحُ إِذَا جَرَيْنَـا"],["A3410F29-A403-5409-B240-915220081623","وَتَحْمِلُنَـا غَدَاةَ الرَّوْعِ جُـرْدٌ","عُـرِفْنَ لَنَا نَقَـائِذَ وَافْتُلِيْنَـا"],["35924D17-135E-5BDF-B691-2EB39BC927D5","وَرَدْنَ دَوَارِعاً وَخَرَجْنَ شُعْثـاً","كَأَمْثَـالِ الرِّصَائِـعِ قَدْ بَلَيْنَـا"],["6234CF12-961A-5950-8626-39FA812EE0A4","وَرِثْنَـاهُنَّ عَنْ آبَـاءِ صِـدْقٍ","وَنُـوْرِثُهَـا إِذَا مُتْنَـا بَنِيْنَـا"],["B115F02D-A248-580A-9F2C-77AA0791AAC0","عَلَـى آثَارِنَا بِيْـضٌ حِسَـانٌ","نُحَـاذِرُ أَنْ تُقَسَّمَ أَوْ تَهُوْنَـا"],["4A0EEF2E-7B15-5554-BBB3-047B720C68C4","أَخَـذْنَ عَلَى بُعُوْلَتِهِنَّ عَهْـداً","إِذَا لاَقَـوْا كَتَـائِبَ مُعْلِمِيْنَـا"],["2BFA098B-7B5F-536E-83D7-3D545C52EA18","لَيَسْتَلِبُـنَّ أَفْـرَاسـاً وَبِيْضـاً","وَأَسْـرَى فِي الحَدِيْدِ مُقَرَّنِيْنَـا"],["0F7A1610-A4B0-54D7-A876-C88A2C53891E","تَـرَانَا بَارِزِيْـنَ وَكُلُّ حَـيٍّ","قَـدْ اتَّخَـذُوا مَخَافَتَنَا قَرِيْنـاً"],["0AFD078C-FE3E-502B-A65B-6DA6D203D55F","إِذَا مَا رُحْـنَ يَمْشِيْنَ الهُوَيْنَـا","كَمَا اضْطَرَبَتْ مُتُوْنُ الشَّارِبِيْنَـا"],["62B2608C-A377-58A1-B4A6-DBBCFB12E318","يَقُتْـنَ جِيَـادَنَا وَيَقُلْنَ لَسْتُـمْ","بُعُوْلَتَنَـا إِذَا لَـمْ تَمْنَعُـوْنَـا"],["AA19F684-473B-5B36-A4CF-C0FF0A3F7609","ظَعَائِنَ مِنْ بَنِي جُشَمِ بِنْ بِكْـرٍ","خَلَطْـنَ بِمِيْسَمٍ حَسَباً وَدِيْنَـا"],["AD8A4C5E-1F00-5C20-992D-D4158F7CA3B0","وَمَا مَنَعَ الظَّعَائِنَ مِثْلُ ضَـرْبٍ","تَـرَى مِنْهُ السَّوَاعِدَ كَالقُلِيْنَـا"],["1FEFAC2B-5345-5D20-AE9D-618154F14156","كَـأَنَّا وَالسُّـيُوْفُ مُسَلَّـلاَتٌ","وَلَـدْنَا النَّـاسَ طُرّاً أَجْمَعِيْنَـا"],["0AF1ACDB-6230-5DA3-BB1D-91FAA7DB3DBC","يُدَهْدِهنَ الرُّؤُوسِ كَمَا تُدَهْـدَي","حَـزَاوِرَةٌ بِأَبطَحِـهَا الكُرِيْنَـا"],["ED82007B-60A4-5B08-999E-E12A6C046E72","وَقَـدْ عَلِمَ القَبَـائِلُ مِنْ مَعَـدٍّ","إِذَا قُبَـبٌ بِأَبطَحِـهَا بُنِيْنَــا"],["AC70687B-A48B-59F6-8F5A-580F5F1FF682","بِأَنَّـا المُطْعِمُـوْنَ إِذَا قَدَرْنَــا","وَأَنَّـا المُهْلِكُـوْنَ إِذَا ابْتُلِيْنَــا"],["22D4BE48-7FB8-5921-8BD9-FE08816939E1","وَأَنَّـا المَانِعُـوْنَ لِمَـا أَرَدْنَـا","وَأَنَّـا النَّـازِلُوْنَ بِحَيْثُ شِيْنَـا"],["DD8E73EB-2BCC-5264-8210-B01FC2BC2C5F","وَأَنَّـا التَـارِكُوْنَ إِذَا سَخِطْنَـا","وَأَنَّـا الآخِـذُوْنَ إِذَا رَضِيْنَـا"],["C19C55A8-A44D-5F10-AD8E-0FB413AC95AF","وَأَنَّـا العَاصِمُـوْنَ إِذَا أُطِعْنَـا","وَأَنَّـا العَازِمُـوْنَ إِذَا عُصِيْنَـا"],["6B953739-A579-587A-8939-07B117C28711","وَنَشْرَبُ إِنْ وَرَدْنَا المَاءَ صَفْـواً","وَيَشْـرَبُ غَيْرُنَا كَدِراً وَطِيْنَـا"],["329EF070-2160-5865-B267-403E5885DAB3","أَلاَ أَبْلِـغْ بَنِي الطَّمَّـاحِ عَنَّـا","وَدُعْمِيَّـا فَكَيْفَ وَجَدْتُمُوْنَـا"],["BFA8123A-4349-5A80-9DA8-47CECF4AC587","إِذَا مَا المَلْكُ سَامَ النَّاسَ خَسْفـاً","أَبَيْنَـا أَنْ نُقِـرَّ الـذُّلَّ فِيْنَـا"],["B1CC0D2C-6116-531E-AC78-776894FC3D46","مَـلأْنَا البَـرَّ حَتَّى ضَاقَ عَنَّـا","وَظَهرَ البَحْـرِ نَمْلَـؤُهُ سَفِيْنَـا"],["92E7F7F0-B2F2-53E4-BA58-8AF8922E6105","إِذَا بَلَـغَ الفِطَـامَ لَنَا صَبِـيٌّ","تَخِـرُّ لَهُ الجَبَـابِرُ سَاجِديْنَـا"]]},"FA6C9AE0-60C8-54BB-AB43-D39ADAAAEF1B":{"t":"إن نسركم غدا","p":21,"s":"إن نسركم غدا","r":"435605","v":[["949EE9F0-22B9-527E-8B01-9C44CD246CD0","أعمـرو بن قيـس إنَّ نسركم غـدا","وآب إلى أهل الأصـارم من جشـم"],["21B9F028-62C0-5B7B-B2AE-9C86E54C41B3","أقيس بن عمـرو غـارة بعد غـارة","وصبـة خيل تحـرب المـال والنعـم"],["C516E78D-A6FD-5B71-A7C0-CC54ED6E6177","إذا أسهلت خبت وإن أحزنت وجـت","وتحسبهـا جنـا إذا سالـت الجـذم"],["0109F233-4163-56FF-9037-6645CDE35F03","إذا ما وهى غيـث وأمـرع جانـب","صببـت عليه جحفـلا غانظا لـهم"],["56B177F0-92EF-5F57-9FEF-878F538A7BD7","فـإن أنا لم أصبـح سوامـك غـارة","كريع الـجراد شله الريـح والرهـم"],["29771BA4-FDA1-5384-8630-179B59659983","فـلا وضعـت أنثـى إليَّ قناعهــا","ولا فاز سهمي حيـن تجتمع السهـم"]]}}}