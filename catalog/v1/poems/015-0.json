{"v":1,"poems":{"5270FCB8-F7F6-5A4F-B4CA-D4F55729178E":{"t":"ألا أصبحت أسماء في الخمرِ تعذل","p":15,"s":"ألا أصبحت أسماء في الخمر تعذل","r":"437458","v":[["C857C88F-827B-57E7-B600-8ED38A8619BA","أَلا أَصبَحَت أَسماءُ في الخَمرِ تَعذِلُ","وَتَزعَمُ أَنّي بِالسَفاهِ مُوَكَّلُ"],["EF7B33A3-9C48-58CC-BD3E-6EB1D04349DF","فَقُلتُ لَها كُفّي عِتابَكِ نَصطَبِح","وَإِلّا فَبيني فَالتَعَزُّبُ أَمثَلُ"]]},"8BCA3017-9CDA-5944-97F1-8D15A72D8659":{"t":"أما الجلاح فإِنني فارقته","p":15,"s":"أما الجلاح فإنني فارقته","r":"437436","v":[["D9B64CCC-9F7F-5849-8BBB-E1396735FA4E","أَمّا الجُلّاحُ فَإِنَّني فارَقتُهُ","لا عَن قِلىً وَلَقَد تَشُطُّ بِنا النَوى"],["E2468051-AEBB-5333-BD47-1277B91764F2","فَلئِن ظَعَنتَ لَأُصبِحَنَّ مُخَيِّماً","وَلَئِن أَقَمتَ لَأَظعَنَنَّ عَلى هَوى"]]},"1057309E-C150-51FB-AE91-1B93CE54691C":{"t":"أَبَنِيَّ إِن أَهلِك فَإِنّي","p":15,"s":"أبني إن أهلك فإني","r":"477964","v":[["024F979F-8BFC-5B07-9124-FA2E869ECA31","أَبَنِيَّ إِن أَهلِك فَإِنّ","ي قَد بَنَيتُ لَكُم بَنِيَّه"],["ECB18A63-75A4-57B7-810B-C0DD66B186DE","وَجَعَلتُكُم أَبناءَ سا","داتِ زِنادُكُم وَرِيَّه"],["2AC4BDA5-F44A-5087-80CD-5D1C5AEDDD3D","مِن كُلِّ ما نالَ الفَتى","قَد نِلتُهُ إِلّا التَحِيَّه"],["42EA91B5-DB37-5A78-8AAB-62C3A0A13E11","كَم مِن مُحَيٍّى لا يُوا","زيني وَلا يَهَبُ الرَعِيَّه"],["230205A2-E033-5CFE-B51A-8C49FACD4927","وَلَقَد رَأَيتُ النارَ لِلسُ","لّافِ تُوقَدُ في طَمِيَّه"],["AE297439-2501-50B6-8A2F-66C658A0E1DF","وَلَقَد رَحَلتُ البازِلَ ال","وَجناءَ لَيسَ لَها وَلِيَّه"],["A9145629-FA29-5865-B2EA-3A5E0F4272B9","ولقد عَدَوتُ بِمُشرَفِ الطَ","رَفَينِ لَم يَغمِز شَظِيَّه"],["44404ACC-E9AB-5567-BA9D-83B00AE408C2","فَأَصَبتُ مِن حمرِ القَنا","نِ مَعاً وَمِن حُمرِ القَفِيَّه"],["97BD61DC-9ACC-50E3-AF31-BE9792C45ED9","وَنَطَقتُ خَطبَةَ ماجِدٍ","غَيرِ الضَعيفِ وَلا العَيِيَّه"],["4D7C732B-3A8A-5908-A5C6-80DAD8F2250C","وَالمَوتُ خَيرٌ لِلفَتى","وَليَهلِكَن وَبِهِ بَقِيَّه"],["06EC6059-F621-58AC-8CFD-813552337021","مِن أَن يُرى الشَيخَ البَجا","لَ وَقَد يُهادى بِالعَشِيَّه"],["1C3088D8-EA7C-59E7-AA51-0C5A6C29A951","جَدَّ الرَحيلُ وَما وَقَف","تُ عَلى لِميسَ الأَرأَشِيَّه"],["8A1A5531-4ABF-5059-BCBD-3AE21AD1BD52","وَلَقى ثَوائي اليَومَ ما","عَلِقَت حِبالُ القاطِنِيَّه"],["BDBCECAE-62A8-5F23-9E3E-C6407A693803","حَتّى أُوَدِّيَها إِلى ال","مَلِكِ الهُمامِ بِذي الثَوِيَّه"],["93C40B7F-283E-535B-B17C-6AAEEC702F6C","قَد نالَني مِن سَيبِهِ","فَرَجَعتُ مَحمودَ الحَذِيَّه"]]},"EEB1A86E-2418-5BC1-9F7A-69B366E20A37":{"t":"أَمن آل سلمى ذا الخيال المؤرق","p":15,"s":"أمن آل سلمى ذا الخيال المؤرق","r":"437452","v":[["733FCE8C-CB2C-55E2-B330-25C952F126C3","أَمِن آلِ سَلمى ذا الخَيالُ المُؤَرِّقُ","وَقَد يَمِقُ الطَيفَ الطَرَوبُ المُشَوَّقُ"],["C8553BD8-DD8A-5767-AA71-9E9B08886E90","وَأَنّى اِهتَدَت سَلمى وَسائِلَ بَينَنا","وَما دونَها مِن مَهمَةِ الأَرضِ يَخفُقُ"],["33659938-6AD8-53EE-9795-0140140DDB8F","فَلَم تَرَ إِلّا هاجِعاً عِندَ حُرَّةٍ","عَلى ظَهرِها كورٌ عَتيقٌ وَنُمرُقُ"],["4DC4CF5F-761F-564C-8079-E3DBEA7A54C4","فَلَمّا رَأَتني وَالطَليحَ تَبَسَّمَت","كَما اِنكلَّ أَعلى عارِضٍ يَتَأَلَّقُ"],["3968D813-9ECB-5413-B07A-0748EFCF3FB0","فَحَيّاكَ وَدٌّ زَوِّدينا تَحِيَّةً","لَعَلَّ بِها عانٍ مِنَ الكَبلِ يُطلَقُ"],["A1204D05-34E9-5567-8C24-A314A96909B8","فَرَدَّت سَلاماً ثُمَّ وَلَّت بِحَلفَةٍ","وَنَحنُ لَعَمري يا اِبنَةَ الخَيرِ أَشوَقُ"],["EAAE3FF3-E4BA-5F0A-8FC8-1A750F95DC20","فَيا طيبَ ما رَيّا وَيا حُسنَ مَنظَرٍ","لَهَوتُ بِهِ لَو اِنَّ رُؤياكَ تَصدُقُ"],["89A6D2DA-7D72-57BB-9ABC-99F7FEFF5606","وَيَوماً بِأَبلِيٍّ عَرَفَتُ رُسومَها","وَقَلتُ عَلَيها وَالدُموعُ تَرَقرَقُ"],["EA8D68AE-18BD-5D9E-BD87-D32B1C9349A9","فَكادَت تُبينُ الوَحيَ لَمّا سَأَلتُها","فَتُخبِرُنا لَو كانَتِ الدارُ تَنطِقُ"],["C407B012-24D4-5F1E-9C9B-B2B98008296F","فَيا رَسمَ سَلمى هِجتَ لِلعَينِ عَبرَةً","وَحُزناً سَقاكَ الوابِلُ المُتَبَعِّقُ"],["5EEFE102-4AB8-5593-BA11-17731971A47F","أَلَم تَذكُري إِذ عَيشُنا بِكِ صالِحٌ","وَإِذ أَهلُنا وُدٌّ وَلَم يَتَفَرَّقوا"],["AD63DB06-E0C0-5B56-AE60-8B0D8F67EBEB","لَمّا اِعتَلَيتُ الهَمَّ عَدَّيتُ جَسرَةً","زِوِرَّةً أَسفارٍ تَخُبُّ وَتُعنِقُ"],["7BA1A0B3-B865-500F-A827-00DBAA385E15","جُمالِيَّةً أَمّا السَنامُ فَتامِكٌ","وَأَمّا مَكانُ الرِدفِ مِنها فَمُحنَقُ"],["381397DF-0B12-5F86-8023-B4FDBE19C40F","شُوَيكِيَّةَ النابَينِ لَم يَغذُ دَرُّها","فَصِلاً وَلَم يَحمِل عَلَيها مُوَسِّقُ"],["5586788F-D2E2-5602-A38D-0600F97C13C7","إِذا قُلتُ عاجِ جَلَّحَت مُشمَعِلَّةً","كَما اِرمَدَّ أَدفى ذو جَناحَينِ نِقنِقُ"],["E254F48F-1553-550A-9496-6AE30B9DFCCB","أَبى قَومُنا أَن يَقبَلوا الحَقَّ فَاِنتَهوا","إِلَيهِ وَأَنيابٌ مِنَ الحَربِ تَحرُقُ"],["0E5A9FA2-8E3B-5C03-AF35-A665765CF7E6","فَجاؤوا إِلى رَجراجَةٍ مُكفَهِرَّةٍ","يَكادُ المُرَنّى نَحوَها الطَرفَ يَصعَقُ"],["6B8B77DC-2462-5299-A995-B6D2E2A5046E","دُروعٌ وَأَرماحٌ بِأَيدي أَعِزَّةٍ","وَمَوضونَةٌ مَمّا أَفادَ مُحَرِّقُ"],["9FEDA178-ED7F-51A2-BB9A-7B10FC8F4A99","وَخَيلٍ قَد جَعَلناها دَخيلَ كَرامَةٍ","عَتاداً لِيَومِ الحَربِ تُحفى وَتُغبَقُ"],["178FF6A5-992E-581A-BDDA-EEB643B615BC","فَما بَرِحوا حَتّى تَرَكنا رَئيسَهُم","تَعَفَّرَ فيهِ المَضرَحِيُّ المُذَلَّقُ"],["6BA2F0FC-7633-5543-88D6-EB1E5B7F3DDC","فَكائِن تَرى مِن ماجِدٍ وَاِبنِ ماجِدٍ","بِهِ طَعنَةٌ نَجلاءُ لِلوَجهِ تَشهَقُ"],["813D2CC6-F621-5900-8D2B-10843C80AB98","فَلا غَروَ إِلّا يَومَ جاءَت عَطينَةٌ","لَيَستَلِبوا نَسوانَنا ثُمَّ يَعنِقوا"],["F5E9D1DF-0EC6-56BD-B9B2-E9C4812F88CF","مَوالي يَمينٍ لاَمَوالي عَتاقَةٍ","أُشابةُ حَيٍّ لَيسَ فيهِم مُوَفَّقُ"]]},"A89804BE-9CD0-5567-A206-202064B04D99":{"t":"إِذا ما شئت أَن تسلى حبيباً","p":15,"s":"إذا ما شئت أن تسلى حبيبا","r":"437455","v":[["3271B554-4725-544B-98F4-88411B52D0CC","إِذا ما شِئتَ أَن تَسلى حَبيباً","فَأَكثِر دونَهُ عَدَدَ اللَيالي"],["A66C2D97-2291-594A-90F0-1C22946ECD4B","فَما نَسّى حَبيبَكَ مِثلُ نَأيٍ","وَلا بَلّى جَديدَكَ كَاِبتِذالِ"]]},"E75BDE00-6AB2-52CD-A909-30C6BAB645DE":{"t":"إِرفع ضعيفك لا يحربك ضعفه","p":15,"s":"إرفع ضعيفك لا يحربك ضعفه","r":"437437","v":[["A5415F13-9840-5AB3-B5B4-8DD9FE692661","إِرفع ضَعيفَكَ لا يُحِربِكَ ضُعفَهُ","يَوماً فَتُدرِكُهُ عَواقِبُ ما جَنى"],["F2051E9A-A797-5ACC-B8F5-FDBA75FC3513","يَجزيكَ أَو يُثني عَلَيكَ وَإِنَّ مَن","أَثنى عَلَيكَ بِما فَعَلتَ كَمَن جَزى"],["3B62EA34-D188-56EE-A3E3-757261C6A18F","إِنَّ الكَريمَ إِذا أَرادَ وِصالَنا","لَم يُلفِ حَبلي واهِياً رَثَّ القُوى"],["4505D6BF-01C7-51D4-9D1E-AAD13534F093","أَرعى أَمانَتَهُ وَأَحفَظُ غَيبَهُ","جَهدي فَيَأتي بَعدَ ذَلِكَ ما أَتى"]]},"F7C30065-51E8-5E32-BC36-C6CCD8DC8648":{"t":"إِن تنسني الأيام إِلا جلالة","p":15,"s":"إن تنسني الأيام إلا جلالة","r":"437443","v":[["8E439D47-9480-5503-A04C-26FC82728AEE","إِن تُنسِني الأَيّامُ إِلّا جَلالَةً","أَمُت حينَ لا تَأسى عَلَيَّ العَوائِدُ"],["1BEE5866-8E53-51C6-9EFE-5D6178C15B0F","فَيَأذى بِيَ الأَدنى وَيَشمَت بِيَ العِدا","وَيَأمَنُ كَيدي الكاشِحونَ الأَباعِدُ"]]},"DF138EE4-4105-5E51-B1B8-1C2351D5ABED":{"t":"تباً لتغلب أن تساق نساؤهم","p":15,"s":"تبا لتغلب أن تساق نساؤهم","r":"437457","v":[["09D2D4B9-E424-5CDA-B5FA-E231E1B88AB0","تَبّاً لِتَغلِبَ أَن تُساقَ نِساؤُهُم","سَوقَ الإِماءِ إِلى المَواسِمِ عُطَّلا"],["7D676A5E-0146-5C23-80A8-2119DE6CB0D0","لَحِقَت أَوائِلُ خَيلِنا سَرَعانَهُم","حَتّى أَسَرنَ عَلى الحُبَيِّ مُهَلهِلا"],["52830E61-FDF9-5FCC-A1BB-06A917BD001B","إِنّا مُهَلهِلُ ما تَطيشُ رِماحُنا","أَيّامَ تَنقُفُ في يَدَيكَ الحَنظَلا"],["1543AA52-D7D5-5875-916A-2BA0B7B00693","وَلَّت حُماتُكَ هارِبينَ مِنَ الوَغى","وَبَقيتَ في حَلَقِ الحَديدِ مُكَبَّلا"],["C61A937C-9CC4-5F6B-9244-8043E39D5E4F","فَلَئِن قُهِرتَ لَقَد أَسَرتُكَ عَنوَةً","وَلَئِن قُتِلتَ لَقَد تَكونُ مُرَمَّلا"]]},"EED9E502-305E-5B01-9EA7-511F70BA24A0":{"t":"جلح الدهر فانتحى لي وقدماً","p":15,"s":"جلح الدهر فانتحى لي وقدما","r":"437456","v":[["C6DADCAB-09C7-57B2-8559-2B2329B5D68C","جَلَّحَ الدَهرُ فَاِنتَحى لي وَقِدماً","كانَ يُنحي القُوى عَلى أَمثالي"],["5581D193-EED5-53FE-BECC-3B551FAA3E7C","يُدرِكُ التَمسَحَ المُوَلَّعَ في اللُجَّ","ةِ وَالعُصمَ في رُؤوسِ الجِبالِ"],["914A9771-95AC-5887-A060-25AAF01E6BE7","وَتَصَدّى لِيَصرَعَ البَطَلَ الأَر","وَعَ بين العَلماء وَالسِربالِ"]]},"E47F60F7-43FC-5EC5-A354-531EE8A03CA2":{"t":"حيي داراً تغيرت بالجناب","p":15,"s":"حيي دارا تغيرت بالجناب","r":"437438","v":[["821BC6B6-1A1A-5BF1-A613-FF1E5A8BA721","حَيّي داراً تَغَيَّرَت بِالجَنابِ","أَقَفَرَت مِن كَواعِبٍ أَترابِ"],["B813FE68-00CA-5D56-9EF4-5A04FB4E7274","أَينَ أَينَ الفرارُ مِن حَذَرِ المَو","تِ وَإِذ يَتَّقونَ بِالأَشَلابِ"],["C3531EEA-44D2-571C-8354-FDABD903D16F","إِذ أَسَرنا مُهَلهِلاً وَأَخاهُ","وَاِبنَ عَمرٍو في القِدِّ وَاِبينَ شِهابِ"],["6A502B0B-E729-59BF-81E5-197AA8842004","وَسَبَينا من تَغلِبٍ كُلَّ بَيضا","ءَ رَقودِ الضُحى بَرودِ الرُضابِ"],["7AB91C7C-6A11-5353-B283-EA6680C23FEE","يَومَ يَدعو مُهَلهِلٌ يا لَبَكرِ","ها أَهَذي حَفيظَةُ الأَحسابِ"],["E5D86604-59CC-585E-88FB-2B738125CA31","وَيْحَكُم وَيْحَكُم أُبيحَ حِماكُم","يا بَني تَغلِبَ أَما مِن ضِرابِ"],["BFEFE81F-BB68-52AF-B425-2101AF0C3DDD","وَهُمُ هارِبونَ في كُلِّ فَجٍّ","كَشَريدِ النَعامِ فَوقَ الرَوابي"],["2B0DC239-C864-5ADC-9E71-B1EF0F5456D7","وَاِستَدارَت رَحى المَنايا عَلَيهِم","بِلُيوثٍ مِن عامِرٍ وَجَنابِ"],["6AC3FFB6-DC6F-5B34-A78A-24D50D08096E","طَحَنَتهُم أَرحاؤُها بِطَحونِ","ذاتِ ظُفرِ حَديدِةِ الأَنيابِ"],["0A9A38F8-990E-54A1-8800-EE19044C7472","فَهُم بَينَ هارِبٍ لَيسَ يَألو","وَقَتيلٍ مُعَفَّرٍ في التُرابِ"],["6B5D57DC-8DAD-5081-9340-54F432C8FB0D","فَضَلَ العِزَّ عِزُّنا حينَ يَسمو","مِثلَ فَضلِ السَماءِ فَوقَ السَحابِ"]]},"3067FD70-1186-5B51-99EB-9EEA055FFE71":{"t":"سنها رابع الجيوشِ عليم","p":15,"s":"سنها رابع الجيوش عليم","r":"437446","v":[["F7B372BA-4705-58E4-995D-263A5F8B2C67","سَنَّها رابِعُ الجُيوشِ عَليمٌ","كُلَّ يَومٍ تَأتي المَنايا بِقَدرِ"]]},"4A136AFF-B55B-5A83-A744-FBD153499928":{"t":"فارس يكلأُ الصحابة منه","p":15,"s":"فارس يكلأ الصحابة منه","r":"437451","v":[["1DCB6D6A-3242-503C-9BD6-70F783A9E1DB","فارسٌ يَكلَأُ الصَحابَةَ مِنهُ","بِحُسامٍ يَمُرُّ مَرَّ الحَريقِ"],["B5F0E024-8CC0-574C-908A-D5A550FCEF83","لا تَراهُ لَدى الوَغى في مَجالٍ","يَعتَلي العَيرَ لا وَلا في مَضيقِ"],["CE2CC90F-AF8D-5D83-93AD-922B562674EE","مَن يَراهُ يَخَلهُ في الحَربِ يَوماً","أَنَّهُ أَخرَقٌ مُضِلُّ الطَريقِ"]]},"1459E17D-9636-5482-8CD0-701A9225B4CF":{"t":"فجعت عبد القيس أمس بجدها","p":15,"s":"فجعت عبد القيس أمس بجدها","r":"437453","v":[["9B1348D0-85A4-5448-87FA-BE6FD35FE891","فَجَّعتُ عَبدَ القَيسِ أَمسِ بِجَدِّها","وَسَقَيتُ هَدّاجاً بِكَأسِ الأَقزَلِ"]]},"8DEACDB1-C4FB-5488-B62D-54E053E86A7A":{"t":"في آل مرَّة شنأ","p":15,"s":"في آل مرة شنأ","r":"437447","v":[["FCA3C9BF-80D4-51FF-8E1C-ED28D7FC9188","في آلِ مُرَّةَ شُنَّأٌ","لي قَد عَلِمتُ وَآلُ مُرَّه"],["15A35C36-59F4-58B1-A055-2099CA5C66AA","ساداتُ قَومِهِمُ الأُلى","مِن وائِلٍ وَأُلى بِحَرَّه"],["01A121CE-E7F2-50F7-806C-FFD9DB816BA2","وَلِكُلِّهِم أَعدَدتُ تَيّا","حاً تُمَرُّ لَهُ الأَجِرَّه"]]},"7FEBE6F1-C925-5079-B2FE-934C7CB11813":{"t":"لقد علم القبائل أَن ذكري","p":15,"s":"لقد علم القبائل أن ذكري","r":"437448","v":[["97AA0C72-B0CF-536C-A132-C6BF677D70E0","لَقَد عَلِمَ القَبائِلُ أَنَّ ذِكري","بَعيدٌ في قَضاعَةَ أَو نِزارِ"],["81F6C4B2-3DCF-5AFD-87F9-B045CBA55624","وَما إِبِلي بِمُقتَدَرٍ عَلَيها","وَما حِلمي الأَصيلُ بِمُستَعارِ"],["3AAF9BA6-EE63-5557-A260-1841EA99E438","سَتَمنَعُها الفَوارِسُ مِن بَلِيٍّ","وَتَمنَعُها فَوارِسُ مِن صُحارِ"],["3B100F73-04A9-5915-BEC7-4AA4CCA980B3","وَيَمنَعُها بَنو القَينِ بنِ جَسرٍ","إِذا أَوقَدتُ لِلحَدَثانِ ناري"],["5AF58775-4BAB-517D-8AEE-7BBE8C73DAB1","وَيَمنَعُها بَنو نَهدٍ وَجَرمٌ","إِذا طالَ التَجاوُلُ في الغِوارِ"],["527916FB-B3AD-587A-A2AA-CA2CA8462A28","بِكُلِّ مُناجِدٍ جَلدٍ قُواهُ","وَأَهيَبُ عاكِفونَ عَلى الدُوارِ"]]},"56323ABD-0F59-5934-97FA-475ED79EB4F7":{"t":"لقد عمرت حتى لا أبالي","p":15,"s":"لقد عمرت حتى لا أبالي","r":"437442","v":[["D3B0B158-00B2-5B1E-9105-312F457A176E","لَقَد عُمِّرتُ حَتّى لا أُبالي","أَحَتفي في صَباحِيَ أَم مَسائي"],["BD5479A6-7015-5A84-9E2E-B2758FF8C844","وَحُقَّ لِمَن أَتَت مائِتانِ عامٍ","عَلَيهِ أَن يَمَلَّ مِنَ الثَواءِ"],["494987A3-7DC9-5D0D-AD56-839E9D1C6814","شَهِدتُ الموقِدين عَلى خَزازى","وَبِالسُلانِ مَعاً ذا زُهاءِ"],["4442AA8E-E703-5887-AC66-E3BE89375E42","وَنادَمتُ المُلوكَ مِن آلِ عَمرٍو","وَبَعدَهُمُ بَني ماءِ السَماءِ"]]},"D992A18C-6969-52A6-BAED-FAFF62B3F0F9":{"t":"لم تصبر لنا غطفان لما","p":15,"s":"لم تصبر لنا غطفان لما","r":"437441","v":[["833E614A-08DC-5D2E-9591-70B9834CD79A","لَم تَصبِر لَنا غَطَفانُ لَمّا","تَلاقَينا وَأُحرِزَتِ النِساءُ"],["A600B73D-834B-5D2D-BF01-7B09ED3FC799","فَلَولا الفَضلُ مِنّا ما رَجَعتُم","إِلى عَذراءَ شيمَتُها الحَياءُ"],["B67B8DB7-678C-5690-B139-C490F845F692","وَكَم غادَرتُمُ بَطَلاً كَمِيّاً","لَدى الهَيجاءِ كانَ لَهُ غَناءُ"],["435F21ED-84D5-57E0-9CC3-D23E4335C049","فَدونَكُمُ دُيوناً فَاِطلُبوها","وَأَوتاراً وَدونَكُمُ اللِقاءُ"],["FDD56C07-2C24-50FD-9080-14DC7E39D287","فَإِناَّ حَيثُ لا يَخفى عَلَيكُم","لَيوثٌ حينَ يَحتَضِرُ اللِواءُ"],["538A6FFD-C59E-58C5-8537-AEC3DEE4289D","فَخَلّى بَعدَها غَطَفانُ بَسّاً","وَما غَطَفانُ وَالأَرضُ الفَضاءُ"],["DEF3F656-9F51-57EB-BB5D-1BE410CB60BA","فَقد أَضحى لِحَيِّ بَني جَنابٍ","فَضاءُ الأَرضِ وَالماءُ الرَواءُ"],["C0E1C351-B93E-5673-A62A-5C12C024C7FC","وَيَصدُقُ طُعنُنا في كُلِّ يَومٍ","وَعِندَ الطَعنِ يُختَبَرُ اللِقاءُ"],["FA93FFF8-328E-5774-BA8F-5DB67F0FC439","نَفَينا نَخوَةَ الأَعداءِ عَنّا","بِأَرماحِ أَسِنَّتُها ظِماءُ"],["C853EACC-8A33-507C-BCB6-5389ACA0B297","وَلَولا صَبرُنا يَومَ التَقَينا","لَقينا مِثلَ ما لَقِيَت صُداءُ"],["12C2B81C-C6B3-5790-8E02-CE2B7DC3D8E2","غَداةَ تَعَرَّضوا لِبَني بَغيضٍ","وَصِدقُ الطَعنِ لِلنَوكى شِفاءُ"],["3901AC5F-FEF0-5B10-B03A-33C4E8C49695","وَقَد هَرَبَت حِذارَ المَوتِ قَيسٌ","عَلى آثارِ مَن ذَهَبَ العَفاءُ"],["8D6DEC1E-172B-5D0F-89E0-51D84AA10624","وَقَد كُنّا رَجَونا أَن يُمِدّوا","فَأَخلَفَنا مِنِ اِخوتِنا الرَجاءُ"],["D2EFD419-4386-59AC-89BA-F9E00C7870CE","وَأَلهى القَينَ عَن نَصرِ المَوالي","حِلابُ النيبِ وَالمَرعى الضَراءُ"]]},"16CB9728-A580-5EB9-AE57-D96782AC75D8":{"t":"لو كنت من جشم بن بك","p":15,"s":"لو كنت من جشم بن بك","r":"437440","v":[["59557BE1-0C36-5D6E-ACB8-2BC2AC918CA2","لَو كُنتُ مِن جُشَمَ بنِ بَك","رِ مَن إِذا أوذي غَضِب"],["944DB5D9-FD68-594F-B615-3EB35E8AB71B","قَتَّلتُ هِدماً بِغَيّا","ثٍ أَو عِكَبَّ بنَ عِكَب"]]},"5113D1F7-A3B2-58AD-ABAC-BE328EF84F6D":{"t":"هدوء الموسى ثم نصت سميعة","p":15,"s":"هدوء الموسى ثم نصت سميعة","r":"437449","v":[["B7C90AB4-F0D6-555B-8DE2-2AB8E32199A5","هُدوءَ المُوَسّى ثُمَّ نَصَّت سَميعَةً","شديدة أعلى ماضغ وحتار"],["B78D8CAB-7CF6-5814-99B8-F1BE68F19FDC","فَأَلقَت بِعِرنانِ الجِرانَ مُنيمَةً","وَضَمَّت حَشاً عَن كَلكَلٍ وَشِوارِ"],["2E30CB69-9F51-55D1-9227-5217F40BBE28","وَإِن عِفتَ هَذا فَاِدنُ دونَكَ إِنَّني","قَليلُ الغِرارِ وَالشَريجُ شِعاري"]]},"2A63D2CD-1ABF-50C3-9ACB-036CB085E0D9":{"t":"وأرسل مهملاً جذعاً وحقاً","p":15,"s":"وأرسل مهملا جذعا وحقا","r":"437439","v":[["B02BDF44-B6E4-50A8-9D42-3B8AF5BB4D24","وَأَرسَلَ مُهمَلاً جَذَعاً وَحِقّاً","بِلا جَحدِ النَباتِ وَلا جَديبِ"]]},"261528C3-A09D-51CF-9170-3BC7C0DDF898":{"t":"وكم مقل لا يقل ومكثرٍ","p":15,"s":"وكم مقل لا يقل ومكثر","r":"437445","v":[["C668A66D-DA4D-5E75-8460-0328FB47BEDF","وَكَم مُقِلٍّ لا يَقِلُّ وَمُكثِرٍ","مُقِلٍّ وَإِن كانَت كَثيراً أَباعِرُه"],["2029A04E-7A1C-5234-96E7-F269ABC219CF","وَكَم قائِلٍ إِنَّ اِبنَ بِنتٍ هُوَ اِبنُهُ","وَقَد هُدِمَ البَيتُ الَّذي هُوَ عامِرُه"],["F04C2A85-6D33-5041-8BC5-DB1178B9F37F","فَأَودى عَموداهُ وَرَثَّت حِبالُهُ","وَأُصلِحَ أولاهُ وَأُفسِدَ آخِرُه"]]},"A344FAA9-4F90-5620-A837-AFF481291C57":{"t":"وكيف بمن لا أستطيع فراقه","p":15,"s":"وكيف بمن لا أستطيع فراقه","r":"437450","v":[["70B8292A-45A8-54C9-9A38-CF352BC40919","وَكَيفَ بِمَن لا أَستَطيعُ فِراقَهُ","وَمَن هُوَ إِن لا تَجمَعِ الدارُ لاهِفُ"],["6891F58B-8831-5B40-B24F-C4C9DFF4F7C2","أَميرُ شِقاقٍ إِن أُقِم لا يُقِم مِعي","وَيَرحَل وَإِن أَرحَل يُقِم وَيُخالِفُ"]]},"0510699C-5BB1-5181-A109-D80610C6CD56":{"t":"ولم أَر حياً من معد تفرقوا","p":15,"s":"ولم أر حيا من معد تفرقوا","r":"437444","v":[["6820B866-8ABC-5C1D-B2BA-671E7B27BD6E","وَلَم أَرَ حَيّاً مِن مَعَدٍّ تَفَرَّقوا","تَفَرُّقَ مِعزى الفِزرِ غَيرَ بَني نَهدِ"]]}}}