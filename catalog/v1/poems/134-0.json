{"v":1,"poems":{"8D747D9B-A2BB-526F-965D-21DA57BD81CA":{"t":"أتعشى بغير خبزٍ وهذا","p":134,"s":"أتعشى بغير خبز وهذا","r":"472585","v":[["408DCB05-D84A-5E5A-87E1-E46C00A47833","أتعشى بغير خبزٍ وهذا","خبري منذ مدةٍ في غدائي"],["D4868A9C-FB23-5390-B7BE-A6B45846F529","فأنا اليوم من ملائكة الدو","لة وحدي أحيا بغير غذاء"],["4DB0989D-47F0-58B9-8471-1F934B92F403","أيةٌ لم تكن لموسى بن عمرا","ن ولا غيره من الأنبياء"]]},"C11C5899-A8C2-5251-A1B9-DB0474636564":{"t":"أسفر الصبح فاسقياني وقد كا","p":134,"s":"أسفر الصبح فاسقياني وقد كا","r":"472573","v":[["F634DB16-7B01-5E2A-ADF3-2E8A07CEB2E4","أسفر الصبح فاسقياني وقد كا","ن من الليل وجهه في ينقاب"],["FA875404-2DB9-558F-8EB7-750900ECAAED","وانظر اليوم كيف قد ضحك ال","زهر إلى الروض من بكاء السحاب"],["A6205594-7036-590C-9EAC-5B235CA3FA0C","إن صحوي وماء دجلة يجري","تحت غيمٍ يصوبُ غير صواب"],["77C47EC7-9AAE-545F-A4A5-AB63878C6C66","اتركاني ومن يعيرُ بالشي","ب وينعي إلي عهد الشباب"],["8E1EAA54-2E9F-5A04-94F6-85F4D7394BCE","فبياض البازي أصدق حسناً","إن تأملت من سواد الغراب"]]},"2C1CD74E-1522-525F-B600-D6AFF390FD15":{"t":"أفسد سوء مذهبي","p":134,"s":"أفسد سوء مذهبي","r":"472559","v":[["E3D8283A-2107-54F2-8312-D60E39F63C3A","أفسد سوء مذهبي","في الشعر حسن مذهبي"],["4EAECA1D-B67C-5C6A-8501-9D117C00049F","وحملي الجد على","ظهر حصان اللعب"],["85A9D011-13A1-5B9E-BDCC-43A4FDA9EDC7","لم يرض مولاي علي","سبي لأصحاب النبي"],["C7EAA437-A5CD-58D0-AF01-5995F6EFBB5F","وقال لي ويحك يا","أحمق لم لم تتب"],["EF322751-F7A1-51EF-8A78-75BBA2805EAE","من سب قوم من رجا","آلاءهم لم يخب"],["E611D33E-E4C3-5364-8718-9A80376732AF","رمت الرضا جهلاً بما","أصلاك نار اللهب"]]},"76312681-06FF-5618-998C-635831B9B761":{"t":"أيا من وجهه قمرٌ منيرُ","p":134,"s":"أيا من وجهه قمر منير","r":"472550","v":[["90DBF736-7212-5C54-8E93-10ACB1806742","أيا من وجهه قمرٌ منيرُ","يضيء لنا وراحته السحابُ"],["3034D043-4200-5F68-ACBA-80891342EF96","إذا حضر الحساب أعدت ذكري","وتنساني إذا حضر الشراب"],["03B89F99-614F-5CCB-AF5F-E4CA8023F43B","أجبني بالقناني والمثاني","ووجهك إنه نعم الجواب"],["9AC772E1-59D6-51EF-885C-FBEA25BBA31A","وكلني في الحساب إلى إله","يسامحني إذا وضع الحسابُ"]]},"1165B3CF-028C-5BD0-B80B-44D8CB10616A":{"t":"الصفح بالنفط في الثياب","p":134,"s":"الصفح بالنفط في الثياب","r":"472540","v":[["6A4F28C6-9CF9-5398-87B0-F114F5738926","الصفح بالنفط في الثياب","ما لم يكن قط في حسابي"],["E3A004C8-DDA5-59A5-8F73-ED89A5D41293","ليس يقوم الوصول عندي","مقام خيطين من ثيابي"],["C8DAEB12-E16C-529C-93CF-CC2375E2E716","يا رب من كان سن هذا","فزده ضعفاً من العذاب"],["7B499558-716D-5D7B-94F3-4E45492166EC","في قعر حمراء ليس فيها","غير بني البظر والقحاب"],["408062DE-E60F-595B-A66B-9EAEBB9C54AB","تفعل في لحمه المهري","ما يفعل الجمر بالكباب"],["B84DBC8E-D5B5-5FA5-B77C-2639565F4D81","فالقرد عندي جيل عمن","يسن هذا على الكلاب"]]},"1777CAB2-0B4A-5E9D-9183-76061D336194":{"t":"اليوم يوم سروري","p":134,"s":"اليوم يوم سروري","r":"472546","v":[["A1D46AEE-F49F-597D-ADB3-B922A65AE6AA","اليوم يوم سروري","بالموصلي الذنوب"],["AFE44BE4-58D9-547B-89B3-417692B94A56","من عند قرمٍ كريمٍ","جزل العطاء لبيب"],["AC5113C5-9CAE-5535-92CF-356A8F1C2D8E","آدابه جعلتهُ","يُعنى بكل أديب"],["206758D8-7063-54FF-8EDD-F454D8DF775B","ركبت فيه القوافي","فجاد بالمركوب"],["8587CF43-4975-5D43-98EE-E0914F621A88","ذو غرةٍ يتلالا","في حالكٍ غربيب"],["05DD1A7B-C83A-5204-BC87-FB2AB5A85B70","ولن الشباب عليه","مع غرةٍ كالمشيب"],["0F0598EA-2EAE-5613-95F9-A299C7370D23","صهيله جوف إذني","ولا غناء غريب"],["2146552E-F2FA-596B-9623-3B3F1DC1C162","وروثه المسك طيباً","بين اللحى والجيوب"],["845E1261-5E66-5A09-AF2D-81CDD62CFF5C","لولا اضطراري إليه","نزهته عن ركوبي"]]},"17BBE873-8155-50F6-AFAE-A0B96E4F0CA1":{"t":"بياض الشيب تكرهه الغواني","p":134,"s":"بياض الشيب تكرهه الغواني","r":"472554","v":[["E88B6845-30D3-5297-B28E-AD8221D94A2F","بياض الشيب تكرهه الغواني","ويعجبها سوادٌ في الشباب"],["844220A5-37B5-5C39-AB84-B751C8CFCE41","وشيبُ لحى الزناة فدتك","ضراطٌ في اللحى عند القحاب"]]},"CFC408B7-9794-52F0-B94D-9E16A42BBD33":{"t":"حدثُ السن لم يزل يتلهى","p":134,"s":"حدث السن لم يزل يتلهى","r":"472584","v":[["E9D1B33E-C8D6-5173-93E5-8F65420FCE11","حدثُ السن لم يزل يتلهى","علمه بالمشايخ الكبراء"],["F269B4B8-4002-56E3-B85E-77BD0F557C09","خاطرٌ يصفع الفرزدق في الشع","ر ونحو ينيك أم الكسائي"],["A1A64A2D-3E92-5358-824D-1128D7CE4134","غير أني أصبحت أضيع في القو","م من البدر في ليالي الشتاء"],["92989241-AA88-51E3-9C04-7688F3DBE949","رجل يدعي النبوة في السخ","ف ومن ذا يشك في الأنبياء"],["854242EA-3B07-58B6-A552-5F8A08C44A20","جاء بالمعجزات يدعو إليها","فأجيبوا يا معشر السخفاء"]]},"154D8A49-A437-559F-9474-877B79BEA674":{"t":"حقي على الأستاذ قد وجبا","p":134,"s":"حقي على الأستاذ قد وجبا","r":"472564","v":[["2237EAA3-B78C-56C8-8579-23586264B9D2","حقي على الأستاذ قد وجبا","فإيه قد أصبحت منتسبا"],["0B7E96BE-F51D-58C3-ADA3-17BABAE52CD1","مولاي ترك الشرب ينكره","من كان في بغداد محتسبا"],["8CE775EE-0706-53D6-8ED2-0DBF308E1586","إن كان من غم الأمير فلم","وزيره بالأمس قد شربا"],["9415B1B7-828F-5CFC-BAEC-47012CC99921","إن الملوك إذا هم اقتتلوا","أصبحتُ فيهم كلبَ من غلبا"],["0F9AB556-6C32-5395-9D4B-73D096074F7D","فلذاك أسكر غير مكترثٍ","وألف مع خيشومي الذنبا"],["306F43D1-B431-5631-AFEF-5EF334C36A08","يا سادتي قد جاءنا رجبٌ","فتفضلوا واستقبلوا رجبا"],["1FA9D15F-873F-5DDA-8343-1254CCC53A0A","بمدامةٍ لولا أبوتها","ما كنت قط أشرفُ العنبا"],["CC02A3AA-6593-5B39-BC93-AC6D0BE70ADF","حمراء مثل النار موقدةٍ","لم تلق لا ناراً ولا حطبا"],["72DC34B1-CEB2-5564-8091-A2DCF78A5CA6","من قال إن المسك يشببها","ريحاً فلا والله ما كذبا"]]},"EC628429-B806-538D-B200-DFBFF3AEB759":{"t":"خليلي قد اتسعت محنتي","p":134,"s":"خليلي قد اتسعت محنتي","r":"472592","v":[["8C8BF4F0-840E-59C0-8C81-A6E6DDE4591A","خليلي قد اتسعت محنتي","على وضاقت بها حيلتي"],["5E930953-3200-543A-98F5-3EE0B1C5E798","عذرت عذاري في شيبه","وما لمت أن شمطت لمتي"],["514A650A-29C5-586D-A3D4-04E207A84180","إلى كم يخاسسني دائماً","زماني المقبح في عشرتي"],["7433E8DF-6533-5CAF-A054-2423425A1F0E","تحيفني ظالماً غاشماً","وكدر بعد الصفا عيشتي"],["7F14EC54-5049-57B8-A223-76DE0D1F40B5","وكنتُ تماسكتُ فيما مضى","فقد خانني الدهر في مسكتي"],["1ECB502C-4DA9-54C8-B410-A9C99870C7D9","إلى منزلٍ لا يواري إذا","تحصلت فيه سوى سوأتي"],["CB90BAAC-A008-5338-BA35-C02F30ED8537","مقيماً أروح إلى منزلٍ","كقبري وما حضرت ميتتي"],["505F8E1F-DE33-5C63-8099-9EE68E480224","فرشت له فيه بسط الحدي","ث من باب بيتي إلى صفتي"],["DD42D0F6-7F7C-5778-9E7A-9DEA4227E410","ومعدته من خلال الكلا","م تشكو خواها إلى معدتي"],["171D9710-AB44-5A25-8A90-7776835C7E70","وقد فت في عضدي ما بهِ","ولكن عليه غلبت علتي"],["595FCAA3-FC14-54AD-B9B8-75CA7D8E8504","وأغدو غدواً ملياً بأن","يزيد به الله في شقوتي"],["34220A68-1DA8-51E6-83FB-8EF6FFF5FFF3","فأيةُ دارٍ تيممتها","تتيم بوابها حجتي"],["C9E6E2BD-AF7B-5D4C-8B07-F5E87FC86EA7","وإن أنا زاحمتُ حتى أموت","دخلتُ وقد خرجت مهجتي"],["175E9B41-69D2-57A2-8EBB-1492F2706D35","فيرفعني الناس عند الوصول","إليهم وقد سقطت عمتي"],["4CE0BA73-9500-54C8-91FF-E84F57514E59","وإن نهضوا بعد للأنصرا","ف أسرعت في إثرهم نهضتي"],["378D775E-5A62-57AA-9CF9-785F6DAEBF8D","وإن قدموا خيلهم للركوب","خرجت فقدمت لي ركبتي"],["171C195A-F97D-506F-A85B-F8FB66CAC814","وفي جمل الناس غلمانهم","وليس سوائي في جملتي"],["61BB10FC-9D6B-52DE-9D90-CCE9F313B289","ولا لي غلامٌ فأدعوا به","سوى من أبوه أخو عمتي"],["A22566B8-6608-58F7-A9F0-6430237FBB53","ركنت مليحاً أروق العيو","ن أيضاً فقد قبحت خلقتي"],["C9A344EA-FE53-55B6-B047-04CA6D14C1DF","يعرق خدي جفاف الهزال","وحاف الشناج على وجنتي"],["E6F7EE31-FE90-545D-9494-417E0B5BEC4E","وقوسني الهم حتى انطويت","فصرتُ كأني أبو جدتي"],["C7DC3A96-2B9D-5F84-8F50-181A2F15FF6D","وكان المزينُ فيما مضى","تكسرُ أمشاطه طرتي"],["BDCCBCDB-8D7B-52AE-9DDD-68192E7CB1C6","وكنت برأسٍ كلون الغداف","فقد صرت أصلع من فيشتي"],["5342DDD1-B71D-58E6-BE8B-F54044D390CD","ويا رب بيضاء رود الشبا","ب كانت تحن إلى وصلتي"],["669815E2-3317-5F45-9608-144A295EEBD5","فصارت تصد إذا أبصرت","مشيبي وتغضب من صلعتي"],["E8965B45-FF0A-5FAA-81EB-AB89D8C9DCB1","على أنني قلت يوماً لها","وقد أمضت العزم في هجرتي"],["82C25BF8-2761-595F-9490-D8E364C80C8E","دعي عنك ما فوقه عمتي","فإن جمالي ورا تكتي"],["D9F016A3-E2A6-53B4-A6F5-650A7553093C","هنالك أيرٌ يسرُّ العيون","طويلٌ عريضٌ على دقتي"],["87AA55DB-BDC3-597B-9F9B-73FAEA0187DE","سوى أنّ قلبي قد ضرفت","ه في شغله بالأسى عطلتي"],["5FFC6808-EFC9-5F22-BEAC-F9DBF662C520","وكانت بتكريت لي غلةٌ","فغلت بأجمعها غلتي"],["206C4741-32C5-5BA5-B6EB-721A8CAE0016","أغاروا على سمسمي غارةً","تعدت فأنضت إلى حنطتي"],["1371C386-1BA8-58B8-A9A0-C02328D5990D","فلا أزال في نقمةٍ كل من","أزال بحيلته نعمتي"]]},"577FB7F4-CE98-5532-9EEC-E874A8940E14":{"t":"دعوت نداك من ظمئي إليه","p":134,"s":"دعوت نداك من ظمئي إليه","r":"472552","v":[["65613403-C51C-5DBA-8FFD-85624C8DC526","دعوت نداك من ظمئي إليه","فعناني بقيعتك السراب"],["FDD2661A-0EFA-58ED-A8A4-23D44F78A544","سرابٌ لاح يلمع في سباخٍ","فلا ماءٌ لديه ولا شراب"],["49155270-1454-538C-9C7A-3678A2E38E6B","وليس الليث من جوعٍ بغادٍ","على جيفٍ تحيط بها كلاب"]]},"4EDA30A4-7A96-5006-9304-00340E39F2AB":{"t":"سيدي عبدك في الزيتِ","p":134,"s":"سيدي عبدك في الزيت","r":"472587","v":[["7663CD2B-39B1-5B9F-A84F-72671BE74B3A","سيدي عبدك في الزيتِ","فر من الموتِ إلى الموت"],["245228AD-0FBB-5E36-AA38-F6870853E90F","حال وأقطاعي خرابُ فقد","فررت من بيتي إلى بيتي"]]},"D7084B2A-C5F6-5A76-BD67-0A9B497220F4":{"t":"شعري الذي أصبحت فيه","p":134,"s":"شعري الذي أصبحت فيه","r":"472542","v":[["3B855C58-A4D3-5541-9CAA-58DE21B86E68","شعري الذي أصبحت فيه","فضيحةً بين الملا"],["AEF7A794-0439-5060-A4CA-3F3B783E086F","لا يستجيب لخاطري","إلا إذا دخل الخلا"]]},"3FBD7EF4-4941-506D-9257-FBB5F1D4D56C":{"t":"صمدت لها وجنح الليل داجٍ","p":134,"s":"صمدت لها وجنح الليل داج","r":"472558","v":[["3FD62097-E578-5ADC-B2E1-2124906F5875","صمدت لها وجنح الليل داجٍ","بأخطف للطريدة من عقابِ"],["DBCA63C4-77B7-5297-A015-5F351797FB94","وأولع بالمباعر من قرادٍ","وأوقع في المقاذر من ذباب"]]},"26F6D29E-ACBA-5FF5-917E-6CD726B2E5A4":{"t":"ضرطت ونحن بعكبرا","p":134,"s":"ضرطت ونحن بعكبرا","r":"472555","v":[["B7751A6B-64D9-5C98-9838-1627C49B23D1","ضرطت ونحن بعكبرا","فتشوشت سفن الغروبِ"],["695A3530-8711-5C29-B569-059965E44493","وفست على ريح الشما","ل فألحقتها بالجنوبِ"],["57F6E395-A8E9-59BA-8974-3BC83DC09841","ومسحتُ مبقلةً استها","فوجدتها ألفي جريب"],["F3896204-197D-5E1B-AAC1-D82411D8CFD8","جاءت إلي وجوفها","يغلي ولا قدرُ الزبيب"],["7F333504-4B0E-5E0E-B274-C278A6E39CA2","فسلقت بيضي في آستها","وشويت في حرها عسيبي"]]},"60BD01D0-3EF6-5094-B7D9-1848511B76A4":{"t":"عذرتُ الأسد أن صليت بناري","p":134,"s":"عذرت الأسد أن صليت بناري","r":"472530","v":[["8FFD8C78-83C5-570F-AEB5-0FE1BA60203F","عذرتُ الأسد أن صليت بناري","مخاطرةً فما بال الكلاب"],["871843CA-5CC5-583A-886F-218D2EA5EAFF","وأزواج الحرائر لم يجابوا","لدي فكيف أزواج القحاب"]]},"05206666-B1F5-557C-8D44-C5C3ADE1179B":{"t":"عفا الله عنها إنها يوم ودعت","p":134,"s":"عفا الله عنها إنها يوم ودعت","r":"472561","v":[["3F30C070-B24B-52D8-8765-DF9073822A76","عفا الله عنها إنها يوم ودعت","أجلَّ فقيدٍ في التراب مغيب"],["B3EACCD8-3D06-5B0C-A468-4F44204FC5CB","ولو أنها اعتلت لكان مصابها","أخف على قلب الحزين المعذب"],["B06AC2AE-71D4-52F0-8A1E-75237493F0EB","ولكن رأت في الأرض أفعى مجدلاً","على قدر غرمول الحمار المشغب"],["29AE3F1A-F154-518F-96C4-E6E8AB3508F9","فظنته أيراً والظنون كواذبُ","إذا أخبرت عن عام ما في المغيب"],["6F81CBA8-3F67-51A3-B878-435B9CA3028C","وأهوت إليه من يفاعٍ ودونه","ثمانون باعاً في علو مصوب"],["4029E776-C746-5448-BD55-F268C4CCB3A8","فصارت حديثاً شاع بين مصدقٍ","تحققه علماً وبين مكذب"],["0EAF67FD-E8E0-5CD7-9557-EFFB182F385D","سعى الطمع المردي إليها بحتفها","ومن يمتثل أمر المطامع يعطب"],["1C39CFEA-AE7D-5525-A9C0-BE7FF83FC085","فأعظم يا هذا لك الله ربها","وربك أجر الثكل في شاة أشعب"]]},"329F360C-0927-5FC2-B0EE-697B4B9E4859":{"t":"على أني أظنك سوف تنجو","p":134,"s":"على أني أظنك سوف تنجو","r":"472545","v":[["A3D8FCC6-EDAF-5C6A-933E-AA8EDEFE540D","على أني أظنك سوف تنجو","بعرضك من يدي منجى الذئابِ"]]},"423A66E1-5273-533E-8784-34D77F4A0B51":{"t":"فإن شعري ظريفٌ","p":134,"s":"فإن شعري ظريف","r":"472581","v":[["43C0A4DB-6502-5B66-9E10-CEC437EF9CC9","فإن شعري ظريفٌ","من بابة الظرفاء"],["0DCB9447-82B6-5BA2-B12C-332BAF57C15C","ألذ معنى وأشهى","من استماع الغناء"]]},"A96ABEB1-6453-5679-BAB4-48E79997478C":{"t":"فديت من لقبني مثلما","p":134,"s":"فديت من لقبني مثلما","r":"472571","v":[["86E35814-31BD-53B2-AA3E-08EBC2F88F98","فديت من لقبني مثلما","لقبته والحق لا يغضبُ"],["DABCEE7C-8C58-5119-B555-CB90B8D35A15","إن قلت يا عرقوب أطمعتني","قال فلم نفسك يا أشعبُ"]]},"6D983135-F3C0-5F9B-AA2D-5CADDAD24AF6":{"t":"فديت من مر في الرصافة بي","p":134,"s":"فديت من مر في الرصافة بي","r":"472567","v":[["114FD647-8B2A-580D-B45D-85172C3B8495","فديت من مر في الرصافة بي","فقلت يا سيدي فلم يُجب"],["5532BB12-BEE7-56BC-9E22-4B394244EB8C","واصفر غيظاً علي وامتزجت","صفرةُ ذاك اللجين بالذهب"]]},"8E5E9295-07F6-52E1-BA76-F4B13D3CFB83":{"t":"قال قوم لزمت حضرة حمد","p":134,"s":"قال قوم لزمت حضرة حمد","r":"472579","v":[["D6D80DA4-D974-506E-A537-6F1E101949A7","قال قوم لزمت حضرة حمد","وتجنبت سائر الرؤساء"],["EC9673B2-C732-5C81-BA1B-C6AD434585DF","قلت ما قاله الذي أحرز المع","نى قديماً قبلي من الشعراء"]]},"DFB74D8F-600E-5A4B-9619-604BC8467EAA":{"t":"قد قلت لما أن رجعت مولياً","p":134,"s":"قد قلت لما أن رجعت موليا","r":"472528","v":[["54ECA434-8568-58E6-A524-7DF0DC3F6E4D","قد قلت لما أن رجعت مولياً","ومعي مدابيرٌ من الكتابِ"],["E2F4C12F-A85C-5C94-8C2F-561FA22D6701","نحن الذين لهم يقال وكلنا","فل العصا وطريدة الحجاب"],["F729BC72-0199-5D5F-987E-6D23AA133094","قومٌ إذا قصدوا الملوك لمطلبٍ","نُتفت شواربهم على الأبواب"]]},"F7426119-030A-5929-B210-9BD3A569DC32":{"t":"قولاً لمن إحسانه لم يزل","p":134,"s":"قولا لمن إحسانه لم يزل","r":"472566","v":[["4AB2D085-EB4E-5560-983E-A4DDFA66D1CE","قولاً لمن إحسانه لم يزل","شفاء علاتي وأوصابي"],["DE666627-59FB-5D0A-94FE-90D84DF3810E","بي علةٌ تقطع أسبابها","من راحة الصحة أسبابي"],["62EDEE49-8CFA-56BA-AB0C-E736AC8D394C","أخفيت ما بي اليوم منها فما","تطلع الناس على ما بي"],["1D36427A-80AE-5747-9D9D-A804B51240AA","وليس يشفيني سوى نهشةٍ","من قطعةٍ من كبد بواب"],["DAC07F12-1F60-515D-B5E9-77FAFB0C5AE4","تبيت فيها وهي مشبوبة","بالنار أضراسي وأنيابي"],["E99FA3C6-1AA3-502C-91CE-74A60BB16328","فامنن بأن تذبح لي واحداً","بالنعل في دوارة الباب"],["9BEB0EC3-894C-52E4-83E7-E5299082E695","فنقطةٌ من دم أوداجه","أنفع لي من رطل جلاب"]]},"C74D6DA4-48D4-58DC-AEDE-5EB93A3BB535":{"t":"لا تدعني لصبوحٍ","p":134,"s":"لا تدعني لصبوح","r":"472538","v":[["05A5DC05-BE97-5EDC-9088-4D725CAD64D1","لا تدعني لصبوحٍ","إن الغبوق حبيبي"],["5CCC8BC8-F892-5AB1-B7AA-DB90DB5D86E2","الليل لون شبابي","والصبح لون مشيبي"]]},"31E4CF60-A0C1-5466-8BFD-A119B4078BBD":{"t":"مستحيل المعنى يصلى إلى الحش","p":134,"s":"مستحيل المعنى يصلى إلى الحش","r":"472534","v":[["CEAD5CC4-6324-536B-91BB-86F1AAB9E4AA","مستحيل المعنى يصلى إلى الحش","ر ويخرى في جانب المحراب"]]},"4580B506-0662-51D3-A8E1-29FEBCAAEEF0":{"t":"هربتُ من موطني إلى بلدٍ","p":134,"s":"هربت من موطني إلى بلد","r":"472594","v":[["76269F2E-F65E-5371-9F6E-06D6CCDD9FB0","هربتُ من موطني إلى بلدٍ","قد صفر الجوع فيه منقاري"],["C7B68875-B23C-59CD-863A-4667E1F77468","يقول قومٌ فر الخسيس ولو","كان فتى كان غير فرار"],["3D966544-9814-528E-B43E-CDB7B42E9888","لا عيب لا عيب في الفرار فقد","فر نبي الهدى إلى الغار"]]},"C610C5BF-9809-5961-99BA-9A20DDD36A1F":{"t":"وأولاد الحرائر لم يجابوا","p":134,"s":"وأولاد الحرائر لم يجابوا","r":"472526","v":[["BF43EA21-FB40-51FF-9635-42A90ED54FAF","وأولاد الحرائر لم يجابوا","لدي فكيف أولاد القحابِ"]]},"FFD0B1DC-67CE-5E8D-9D44-1AA368976AF2":{"t":"والكأسُ تسلبني عقلي وأهون ما","p":134,"s":"والكأس تسلبني عقلي وأهون ما","r":"472525","v":[["1359E6E9-BAC5-5907-B386-22742BCF1C64","والكأسُ تسلبني عقلي وأهون ما","لهوتُ عن ذكره عقلي إذا سلبا"],["2FF8EA16-5B98-5E31-9037-7D8B541B8D4E","حمراء يمسي يناني وهو فوق يدي","منها بمثل شعاع الشمس مختضبا"],["7DCA806C-F733-5BFC-8721-8E4772A5BD9D","ابتعتها غير مغبونٍ ولو طالبت الخ","مار روحي أعطيت ما طلبا"],["DDCE1175-8CD9-5B93-A1C0-D4365EC8AF96","وأربح الناس عندي في تجارته","محصلٌ يشتري بالفضة الذهبا"]]},"56D8371B-3661-590B-AC73-187A197FF835":{"t":"وعدتني وعداً وحاشاك أن","p":134,"s":"وعدتني وعدا وحاشاك أن","r":"472548","v":[["A601E7A7-3602-563D-BDDB-49213D302290","وعدتني وعداً وحاشاك أن","تروغ منه روغة الذيب"],["D65606DB-C37A-55CE-8FFB-E76072DB9820","ما كنت إذ أطمعتني أشعبا","فيه ولا أنت بعرقوب"]]},"9B91FEEB-CC07-5068-AF6B-19729FABB9B5":{"t":"وقد غمزوا مع العيدان عودي","p":134,"s":"وقد غمزوا مع العيدان عودي","r":"472536","v":[["09794B57-364C-5268-8E0D-8FF8B9BFA872","وقد غمزوا مع العيدان عودي","ليختبروا الصحيح من المريب"],["8627FFA8-E3ED-52EA-A543-550C3B6096F6","فلان الخروع الخوار منا","وبان تكرم النبع الصليب"]]},"F591E7D9-A15D-59AC-A1E3-E347F4B19931":{"t":"يا أبا أحمد بنفسي أفدي","p":134,"s":"يا أبا أحمد بنفسي أفدي","r":"472575","v":[["D3123FF1-A28A-5B48-A12E-5D826788B2C6","يا أبا أحمد بنفسي أفدي","ك وأهلي من سائر الأسواء"],["64A8FECE-5FA5-545B-9AAF-4020854EECAD","كيف كان انحطاط جعسك في طا","عة شرب الدواء يوم الدواء"],["2E88DB78-46A7-524E-83B7-7EA0AA86360B","كيف أمسى سبال مبعرك النذ","ل عريقاً في المرة الصفراء"],["6F0F275B-FA93-52BE-8499-3F46BD008B62","يا أبا أحمد ونصحك عندي","واجبٌ في الإخاء فاحفظ إخائي"],["E7691154-7EB7-50CC-8E40-A8FF71AEDC3F","رب ريح يوم الدواء دبورٌ","شوشت في عصاعص الأغبياء"],["A9E100A8-9323-5517-95F6-6395EF5102E3","قدروها فساً وقد كمن الجع","س لهم في مهب ذاك الفساء"],["BC73136E-C309-53A2-9541-88F00E59509C","فإذا الفرش في خليج سلاحٍ","ذائبٌ في قوام جسم الماء"],["CC4CFE19-24EB-5FF5-9C71-3D22C910E927","فاتق الله أن تغرك ريح","عصفت في جوانب الأحشاء"],["765B769A-89B2-55FB-938B-171D013281F6","لا تنفس خناق سرمك عنه","أو تخلي سبيله في الخلاء"],["F641B70C-9FD9-5A40-986D-5D11AC1B2C01","والغذاء الغذاء فاحذر بأن تفس","و فوق الفراش بعد الغذاء"],["19E42771-EF5B-52B9-B2E9-2A93B7192B4B","احترس إنها نصحية شيخٍ","حنكته تجارب الآراء"]]},"42CD5DFA-592E-5FC6-AEE1-E1FC58823433":{"t":"يا ربربُ اعبر بنا على ملكٍ","p":134,"s":"يا ربرب اعبر بنا على ملك","r":"472590","v":[["87D023B3-AD98-591A-8860-1884549A6AEC","يا ربربُ اعبر بنا على ملكٍ","توجهُ الله بالمهاباتِ"],["B7D8AA51-A78A-5631-9964-B6F74481607B","يقول للريح كلما عصفت","هل لك يا ريح في مباراتي"]]},"7DD0F447-F586-54A3-9458-90F06EACA3C5":{"t":"يا من إليها من ظلمها الهرب","p":134,"s":"يا من إليها من ظلمها الهرب","r":"472569","v":[["84880B80-7A72-598B-BAC2-AE530284AD69","يا من إليها من ظلمها الهرب","ردي فؤادي فقل ما يجب"],["2AF73A31-8CCB-5999-8AA7-C85082FBA142","ردي حياتي إن كنت منصفة","ثم إليك الرضا أو الغضب"],["301D90B2-C835-5311-A749-A137F57977E5","طلبت قلبي فلم أفتك به","سبحان من لا يفوته الطلب"]]},"C34D060D-2AA5-5804-A7A6-92C9EA734AE5":{"t":"يا من به تتباهى","p":134,"s":"يا من به تتباهى","r":"472577","v":[["DEE554DF-1547-585A-BECA-8E19A0D3E1BA","يا من به تتباهى","مجالسُ الخلفاء"],["AF9D7B76-9567-5FC5-AF2E-03149DA58110","ومن تقصرُ عنه","مدائح الشعراء"],["5BB57F30-31F5-5807-83A6-C0B0BDF34D37","يا سيدي كيف أصبح","ت بعد شرب الدواء"],["C775CFFC-7AAF-50B1-890D-1AD0A109578C","خرجت منه تضاهي","في الحسن بدر السماء"],["8BA08B7F-4B9D-5AC0-9DED-724598994FE1","في ثوب صحة جسمٍ","مطرزٍ بالشفاء"]]},"05DECC12-66C7-5C2A-B382-1D19C0FC4A1D":{"t":"يَا ديمةَ الصَّفع صُبيٍّ","p":134,"s":"يا ديمة الصفع صبي","r":"472532","v":[["E7CBE43C-4C53-58E7-958C-B635F1D58484","يَا ديمةَ الصَّفع صُبيٍّ","علَى قَفا المُتنبُّي"],["49AE41B5-02DE-5F68-BB49-844E4630B660","وَيَا قَفاهُ تَقدَّمْ","حَتَّى تَصيرَ بْجَنْبِي"],["615893CE-EA34-508C-A83C-8A81C051C068","وَأنتَ يَا ريحَ بَطنِي","عَلَى سِبالَيْهِ هُبيِّ"],["CFB61D09-4DD8-59C6-8C07-017D8A43F3E2","إِنْ كُنت أنتَ نَبياً","فَالقِرِدُ لا شكَّ رَبيِّ"]]}}}