{"v":1,"poems":{"8B37F2BA-E0E7-5AEB-A48D-CEC854112AB8":{"t":"أتَعْرِفُ رَسْماً كاطِّرَادِ المَذاهبِ","p":37,"s":"أتعرف رسما كاطراد المذاهب","r":"436911","v":[["7644A7EA-4D61-5BE4-B192-C0D140539CBB","أتَعْرِفُ رَسْماً كاطِّرَادِ المَذاهبِ","لعمرة وحشاً غير موقف راكب"],["FB19FC11-6F9C-5839-8B57-1F75F06E417A","ديارَ التي كادتْ ـ ونحنُ على مِنًى ـ","تَحُلُّ بنا، لولا نَجاءُ الرَّكائبِ"],["79C9F091-1EBB-5A5C-96D1-DE0C5CF30D21","تبدت لنا كالشمس تحت غمامة","بَدا حاجبٌ منها وضَنّتْ بحاجبِ"],["C6805B77-7D5E-539C-B9D8-00544B7B7630","ولم أرها إلا ثلاثاً على منى","وعَهْدي بها عَذْراءَ ذاتَ ذَوائبِ"],["C3D0FD8C-9C48-5D94-BDC3-EC4727062DB3","ومِثْلِكِ قد أصْبَيْتُ ليستْ بكَنّةٍ","ولا جارةٍ ولا حَلِيلةِ صاحبِ"],["208DAF6B-FAF7-53AB-A9A2-BC20FE38EAA9","دعَوْتُ بني عَوْفٍ لحَقْنِ دمائهمْ","فلمّا أبَوْا سامحْتُ في حَرْبِ حاطبِ"],["5EB5CFA6-7A70-5E30-B301-C9BC3D0D5D05","وكُنْتُ امْرءاً لا أبْعثُ الحَرْبَ ظالماً","فلمّا أبَوْا أشْعَلْتُها كُلَّ جانبِ"],["77F9E650-9774-5D3D-B5E0-0090F77D003C","أربت بدفع الحرب حتى رأيتها","عن الدفع لا تزداد غير تقارب"],["D90C6CD0-D2C9-5442-8A16-FA194B189AC4","فإذْ لم يَكُنْ عَنْ غايةِ الموْتِ مَدْفعٌ","فأهْلاً بها إذْ لم تَزَلْ في المَرَاحبِ"],["672A4262-EBF9-5562-8FA0-B4EE65378977","فلما رأيت الحرب حرباً تجردت","لبست مع البردين ثوب المحارب"],["16CD73B5-6695-599C-875F-ED8841FF7421","مُضَاعَفَةً يَغْشَى الأناملَ فَضْلُها","كأنَّ قَتيرَيْها عُيُونُ الجنادبِ"],["2352A96F-FEF9-5B20-92CC-7DF01F43B5DE","أتت عصبم الكاهنين ومالك","وَثَعْلَبَةَ الأثْرِينَ رَهْطِ ابن غالبِ"],["45B3F121-1D5B-59EB-9B12-A723E6ED8138","رجال متى يدعوا إلى الموت يرقلوا","إليه كإرْقالِ الجِمَالِ المَصَاعِبِ"],["2C3BA821-7EE4-5955-B760-192DE7CEE867","إذا فزعوا مدوا إلى الليل صارخاً","كَمَوْجِ الأتيّ المُزْبِدِ المُتراكِبِ"],["8344054F-E07A-5B48-B44C-76862F5D6A9B","تَرَى قِصَدَ المُرَّانِ تَهْوي كأنّها","تذرع خرصان بأيدي الشواطب"],["52D66DFB-C1E9-56D9-85B7-297BD798C508","صَبَحْنا بها الآطامَ حَوْلَ مُزاحِمٍ","قَوَانِسُ أُولى بَيْضِنا كالكَواكبِ"],["F8E6B12A-3BCE-566E-B7F5-3FC4B433CC27","لَوَانّكَ تُلْقي حنظلاً فوق بَيْضِنا","تَدَحْرَجَ عَنْ ذي سامِهِ المُتقارِبِ"],["ED1F26A7-8213-5100-ACDD-C13393DC0549","إذا ما فررنا كان أسوا فررانا","صدود الخدود وازورار المناكب"],["1C70E749-FB72-502F-9C26-7F864B92D19F","صدود الخدود والقنا متشاجر","ولا تبرح الأقدام عند التضارب"],["2F72FCE7-A9D0-5E9C-8D74-1F452811BC5F","إذا قصرت أسيافنا كان وصلها","خطانا إى أعدائنا فنضاربِ"],["5BE38BA8-E682-5573-BD12-C5A35B5BA047","أُجالِدُهُمْ يَوْمَ الحَدِيقةِ حاسِراً","كأنَّ يدي بالسّيفِ مخراقُ لاعبِ"],["607DFAEC-559A-5EEF-BC73-9715E29E7B44","وَيَوْمَ بُعاثٍ أسْلَمَتْنا سُيُوفُنا","إلى نَسَبٍ في جِذْمِ غَسّانَ ثاقِبِ"],["010CCC17-6F1F-5C0D-81FB-93641C12DF7C","يعرَّينْ بيضاً حينَ نلقى عدونَّا","ويغمدن حمراً ناحلاتِ المضاربِ"],["8CA70E55-BA65-5A7E-AF7A-488BA35665AB","أطاعَتْ بَنُو عَوْفٍ أميراً نهاهُمُ","عَنِ السِّلْمِ حتى كان أوَّلَ واجبِ"],["48584C43-7578-5271-A321-DDB7ADB22155","أويتُ لعوفٍ إذْ تقولُ نساؤهم","وَيَرْمِينَ دَفْعاً: لَيْتَنا لم نُحارِبِ"],["8BE30C30-F50F-52A0-88AF-0D461DDFFB24","صَبَحْناهُمُ شَهْباءَ يَبْرُقُ بَيْضُها","تبينُ خلاخيلَ النسّاء الهواربِ"],["9D2419C3-5D71-5E4C-948E-33566DF4633A","أصابت سراةً مِ الأغرّ سيوفنا","وغُودِرَ أولادُ الإماءِ الحَواطِبِ"],["4CACDC3D-7350-5D1A-867C-D843FC6314E7","ومنّا الذي آلى ثلاثين ليلةً","عنِ الخمرِ حتى زاركمْ بالكتائبِ"],["CEF97B9F-885C-57ED-87CD-8EFD7DC63363","رضيتُ لهمْ إذْ لا يريمون قعرها","إلى عازبِ الأموالِ إلا بصاحبِ"],["A00AC6D4-EBDD-58BA-A08B-D2554496AF8C","فَلَوْلا ذُرى الآطامِ قد تَعْلَمونَهُ","وتركُ الفضا، شوركتمُ في الكواعبِ"],["A4527A1A-D794-52DF-8BBB-B922CCA62FD7","فلم تمنعوا منّا مكاناً نريدهُ","لَكُمْ مُحْرِزاً إلا ظُهُورَ المشارِبِ"],["FCACAC7C-4C4C-574B-A871-556AC81C8727","فهلاَّ لَدَى الحَرْبِ العَوَانِ صَبَرْتمُ","لوقعتنا، والبأسُ صعبُ المراكبِ"],["625D0B1D-88D2-5A87-9A9D-3DAD77167164","ظَأرْناكُمُ بالبِيضِ حتى لأنْتُمُ","أذَلُّ مِنَ السُّقْبانِ بَينَ الحلائبِ"],["6ADF4E23-D35E-5CBD-9435-D703C8B266A1","ولمّا هَبَطْنا الحَرْثَ قال أميرُنا:","حرامٌ علينا الخمرُ ما لم نضاربِ"],["4D1442A8-717D-5DEB-BA80-1C0E70C1C938","فسامحهُ منّا رجالٌ أعزَّةٌ","فما بَرِحُوا حتى أُحِلّتْ لِشارِبِ"],["0B80277E-3D20-5E6D-A20D-B830CD604FA8","فَليْتَ سُوَيْداً راءَ مَن جُرَّ مِنْكُمُ","ومَن فَرَّ إذْ يحْدُونَهُمْ كالجلائبِ"],["3D1D407F-EEFA-5C61-A496-06096C490611","فَأُبْنا إلى أبْنائنا ونِسائنا","وما مَنْ تَرَكْنا في بُعاثٍ بآئبِ"],["0A6BE3A5-E187-53E4-8E38-35345034F1BA","وغُيّبْتُ عَن يَوْمٍ كَنَتْني عشيرتي","ويومُ بُعاثٍ كان يَوْمَ التّغالُبِ"]]},"D4C3E667-4CEE-59BB-B842-6117E7E2D264":{"t":"أجدَّ بعمرةَ غنيانُها","p":37,"s":"أجد بعمرة غنيانها","r":"436910","v":[["DC6E5416-03F3-557F-B68A-95F7ECECC96B","أجدَّ بعمرةَ غنيانُها","فَتَهْجُرَ، أم شَأنُنا شَانُها"],["DC7BE34A-3A86-530E-9CDF-2F55D028E2B9","وإن تمسِ شطتْ بها دارها","وَباحَ لَكَ اليومَ هِجْرانُها"],["C1FDED6B-81F6-5C4C-B915-0BF7EDBB84D4","فما روضة من رياض القطا","كأنَّ المصابِيحَ حَوْذَانُها"],["B9CBA7A7-24B2-54DF-8BBE-CF703B7BA22E","بأحْسَنَ منها، ولا مُزْنَةٌ","دَلُوحٌ تكَشَّفُ أدْجَانُها"],["A4E831EB-218C-541A-B60F-13BBCC772AB3","وعَمْرَة منْ سَرَوَاتِ النِّسَا","ء تَنْفَحُ بالمسْكِ أرْدَانُها"],["3DE81173-804E-513B-9A5D-5B85FB4C9192","ونحن الفوارس يوم البي","ع، قد علموا كيف فرسانها"],["97488CFE-FD76-5374-8A6C-C3A349FBAC03","جنبنا الحراءب وراء الصري","خ حتى تقصف مرانها"],["25833D85-C9A3-5588-8189-70D405D6D287","فلمّا اسْتَقَلَّ كَلَيْثِ الغَرِيـ","ـفِ زَانَ الكَتِيبةَ أَعْوَانُها"],["7B2C4C73-B907-5D18-840C-113B52474889","تَراهُنَّ يُخْلَجْنَ خَلْجَ الدِّلا","ء تختلج النزع أشطانها"],["19682654-2C73-5515-B4C5-AEDDEC2B8426","ولاقى الشَّقاءَ لدَى حَرْبِنا","دُحَيٌّ وَعَوْفٌ وإخْوانُها"],["F4128CDB-4AB1-5F92-879C-115DAF0AFCD5","رَدَدْنَا الكَتِيبةَ مَفْلولةً","بِها أَفْنُهَا وَبِها ذَانُهَا"],["79CF4351-EDC8-58E4-A7A5-5F6F3B98217D","وقد علموا أن متى ننبعث","عَلى مِثْلِها تَذْكُ نِيرانُها"],["E51500AC-8F55-52AE-AE84-71991A100F68","ولولا كَراهَةُ سَفْكِ الدِّماءِ","لعاد ليثرب أديانها"],["25B45A9F-6E66-5AFF-9985-D829EDFC07E4","ويثرب تعلم أن النبي","ت راس بيثرب ميزانها"],["F06938F8-54CE-5A9D-B6B1-867D711E0732","حِسَانُ الوُجُوهِ، حِدادُ السُّيو","فِ، يَبْتَدِرُ المَجْدَ شُبّانُها"],["FCF6C5EB-08A3-5A2F-9FC3-BDBBB64E2D13","وبالشوط منيثرب أعبد","سَتَهْلِكُ في الخَمْرِ أثمانُها"],["7031B917-CDE2-535E-845D-A08752BC4E22","يهُونُ على الأوْسِ أثمانُهمْ","إذا رَاحَ يَخْطِرُ نَشْوانُها"],["A5A576A0-25FD-546A-8580-8848FB4034EB","أتتهم عرانين من مالك","سراع إلى الروع فتيانها"],["03DCED01-6C9F-5854-B952-B4EA28287DEB","وقد علموا أن ما فلهم","حَدِيدُ النَّبِيتِ وأعيانُها"]]},"1927E659-A759-520C-997B-57AA7D60F9B4":{"t":"أجودُ بمضنونِ التّسلادِ وإنني","p":37,"s":"أجود بمضنون التسلاد وإنني","r":"436945","v":[["2EC08732-AC5A-50BD-A6FC-5A9F486D6A9B","أجودُ بمضنونِ التّسلادِ وإنني","بسرك عمّنْ سالتني لضنينُ"],["97884E11-C593-501C-AC12-0C0FA34EA9A4","فأبري بهمْ صدري وأصفي مودَّتي","وسِرُّك عندِي بعد ذاكَ مَصُونُ"]]},"1C7B104E-512A-5783-AB1D-5654DA30722F":{"t":"أصبحتْ من حلولِ قوميَ وحشاً","p":37,"s":"أصبحت من حلول قومي وحشا","r":"436932","v":[["925269FD-950A-531B-8E0D-CDADB2F53A5B","أصبحتْ من حلولِ قوميَ وحشاً","رحبث الجدارِ جلسها فالبطاحُ"],["1E1B972A-224B-5906-BC42-97A8DDC4119F","أعَلى العَهْدِ أصْبَحَتْ أُمُّ عَمْرٍو","لَيْتَ شِعْرِي، أم غالها الزُّمّاحُ؟"],["8E4C38CF-74A2-5D4F-9B58-5B70E0440631","إنْ ترينا قليلينَ كما ذيـ","ـدَ عَنِ المُجْرِبِينَ ذَوْدٌ صِحَاحُ"],["17F7786E-3DC3-56DB-8DBF-CB5AD5DF1194","فَبِهِمْ لِلْمُلايِنينَ أنَاةٌ","وطماحٌ إذا يرادُ الطِّماحُ"]]},"C699F8E0-030E-5787-BC09-5BE1E416D164":{"t":"ألا أبلغا ذا الخزرجيَّ رسالةً","p":37,"s":"ألا أبلغا ذا الخزرجي رسالة","r":"436929","v":[["A0A38738-2A23-57CA-9C87-A102382C3125","ألا أبلغا ذا الخزرجيَّ رسالةً","رِسَالَةَ حَقٍّ لَسْتُ فِيها مُفَنَّدا"],["425A631D-3195-56FC-B01A-552DBEECEFC0","فإنّ تركناكم لدى الردم غدوة","فَرِيقَيْنِ: مَقْتُولاً بهِ ومُطَرَّدا"],["31863B96-58CE-544B-9446-C225E240C763","صَبَحْناكُمُ مِنّا بهِ كُلَّ فارِسٍ","كريم النثا يحمي الذمار ليحمدا"],["AE963F01-9BB4-56D0-BB55-478FD655DC0D","أتَذْكُرُ أمْراً لَمْ تَنَلْهُ، وإنّما","تَناوَلَ سَجْلَ الحَرْبِ مَنْ كان أنجدا"],["150C1131-0B06-531A-8CE7-E7D629EAC970","فَذُقْ غِبَّ ما قَدَّمتَ، إنّي أنا الذي","صَبَحْتُكُمُ فيهِ السِّمامَ بِبُرْجُدَا"],["29CDEFCB-8CA2-53A7-927B-E91B66AB8892","ونحنُ حُماةُ الحَرْبِ لَيسَتْ تَضِيرُنا","نسوقُ خميساً كالقطا متبددا"]]},"53501586-A71C-5305-BB31-049204F49A21":{"t":"ألَمَّ خَيَالٌ مِنْ أُمَيْمَةَ مَوْهِناً","p":37,"s":"ألم خيال من أميمة موهنا","r":"436930","v":[["91384880-1330-55A7-8709-483CE2EC6473","ألَمَّ خَيَالٌ مِنْ أُمَيْمَةَ مَوْهِناً","فَلَمْ أغْتَمِضْ لَيلَ التِّمامِ تهجُّدا"],["A35740D3-7CE4-542D-B5BE-8A561B4DCF1A","وكانَ يراها القلبُ جيداءَ ترتعي","سوائلَ يمنٍ فالحساءَ فأرشدا"],["F680766B-7F7C-5B60-8185-9B7938C06870","وماءٍ على حَافاتِهِ أُبَّدُ القَطا","تَخَالُ بهِ دِمْنَ المعاطِنِ إثْمِدَا"],["3B889E5C-FBAD-509A-8DD8-0275A3E5430C","أقمتُ بهِ ليلاً طويلاً فلمْ أجدْ","لِذي أرَبٍ يَبْغي الرَّغائبَ مَقْعَدَا"],["E519EC0B-105C-5017-B76B-6B89062CD810","ونَحْنُ حُماةٌ لِلْعَشِيرةِ أيْنما","نكنْ لا يبالوا أن يغيبوا ونشهدا"],["FECADCC7-0FBD-5E70-8D34-BB257762E593","نُحامي على جِذْمِ الأغَرّ بِمالِنا","ونبذلُ حزراتِ النّفوسِ لنحمدا"],["9B100CDA-43CE-5C74-AAB7-B91452564CB1","صَبَحْناهُمُ عِنْدَ القِتَالِ بِغَارةٍ","فأصْبَحَ قَيْسٌ بَعْدَها مُتَلَدِّدا"],["7961937A-314A-5FDF-A4F8-C315329860B0","يَعَضُّ عَلى أطْرَافِهِ كُلّما بَدَا","لنا فراسٌ يبغي القتالَ تنجُّدا"]]},"5E42A41B-FE22-5E68-8549-A388886F5631":{"t":"ألَمَّ خَيَالُ لَيْلى أُمِّ عَمْرِو","p":37,"s":"ألم خيال ليلى أم عمرو","r":"436922","v":[["E9E47AD6-E33E-59D2-9363-A1A39880607E","ألَمَّ خَيَالُ لَيْلى أُمِّ عَمْرِو","ولمْ يلممْ بنا إلاَّ لأمرِ"],["263DF13A-ADA3-55C7-AC91-B507FCC28BC1","تقولُ ظعيني لمّا استقلّتْ:","أتتركُ ما جمعتَ صريمَ سحرِ"],["27E2248E-B226-5696-9B67-5EFCDF3330A1","فقلتُ لها: ذريني إنَّ مالي","يَرُوحُ إذا غَلَبْتُهُمُ ويَسْرِي"],["9E34663F-25BF-5DF7-805C-8E3E04F2B899","فلستُ لِحَاصِنٍ إنْ لَمْ تَرَوْنَا","نُجَالِدُكُمْ كأنّا شَرْبُ خَمْرِ"],["7250AABB-E167-5CB0-A2AF-28CC12D74136","وتحملُ حربهمْ عنا قريشٌ","كأنَّ بَنَانَهُمْ تَفْرِيكُ بُسْرِ"],["CE9ACBA7-F915-536A-AF3F-79E228F59894","وتُدْرِكُ في الخَزَارِجِ كلَّ وِتْرٍ","بذمِّ الكاهنينِ وذمِّ عمرو"],["A4A98302-1A44-578A-A0C0-21F32817CB12","زَجَرْنا النَّخْلَ والآطامَ حتّى","إذا هِيَ لَمْ تُشَيّعْنا لِزَجْرِ"],["F63D8E8D-F745-50CF-92C9-8A0B1A18F89F","هَمَمْنا بالإقامةِ ثمَّ سِرْنا","كَسَيْرِ حُذَيفَةِ الخَيْرِ بنِ بَدْرِ"],["480CC636-BEFF-5528-89DF-1DCE922A29E8","ورثنا المجدَ قدْ علمتْ معدٌّ","فَلَمْ نُغْلَبْ ولَمْ نُسْبَقْ بوِتْرِ"],["ABCC9022-2237-5C57-9906-73EBF3340482","متى تلقوا رجالَ الأوسِ تلقوا","لِبَاسَ أسَاوِدٍ وجُلُودَ نُمْرِ"],["E5EC5733-67E6-57BC-8DB9-E98396F07304","ونَصْدُقُ في الصَّبَاحِ إذا التَقَيْنا","ولَوْ كانَ الصَّباحُ جَحِيمَ جَمْرِ"],["212C187E-3FA5-523F-9897-D73E3A201465","ألا أبلغْ بني ظفرٍ رسولاً","فلَمْ نَذْلِلْ بيَثْرِبَ غَيْرَ شَهْرِ"],["1274B125-824B-559C-A08E-7FE8CF150EE8","خذلناهُ وأسلمنا الموالي","وفَارَقَنا الصَّرِيحُ لِغَيْرِ فَقْرِ"],["6290EFEF-0AAE-55D7-9923-EEF7591A4C0E","أبحنا المسبغينض كما أباحتْ","يَمانُونا بَني سَعْدِ بنِ بَكْرِ"],["0E2CE57E-CA8B-595A-BDB0-CC1CA5F0BC5E","فإنْ نلحقْ بأبرهةَ اليماني","ونعمانٍ يوجهنا وعمرو"],["8CD1BAD0-5430-5EF2-AF27-72BCC52F0F25","وإنْ نَنْزِلْ بذِي النَّجَدَاتِ كُرْزٍ","نلاقِ لديهِ شرباً غيرَ نزرِ"],["8AB1F2F5-2861-56E8-9C92-BBD179E97AB1","له سَجْلانِ: سَجْلٌ منْ صَرِيحٍ","وسجلُ تريكةٍ بعتيق خمرِ"],["A17100BE-FA58-5DE6-8C62-1B94379FDB10","ونمنعُ ما أرادوا، لا يعاني","مقيمٌ في المحلّةِ وسطَ قسرِ"],["98E0E4A5-FD91-5E9B-9B11-0D35B658A1B9","وإنْ تَغْدُو بِنا غَطَفانُ نُرْدِفْ","نِسَاءَهُمُ ونَقْتُلْ كُلَّ صَقْرِ"],["94AA85CF-0F07-5B17-83F1-84656830EC06","فنحنُ النّازلونَ على المنايا","ونَحْنُ الآخِذُونَ بِكُلّ ثَغْرِ"]]},"0B0F7E41-1C60-58C2-9EB2-B83FF9843973":{"t":"أنّى سَرَبْتِ وكنتِ غيرَ سَرُوبِ","p":37,"s":"أنى سربت وكنت غير سروب","r":"436909","v":[["04988F7C-BD45-5468-B47E-C11D0F4AD6AB","أنّى سَرَبْتِ وكنتِ غيرَ سَرُوبِ","وتُقرِّبُ الأحلامُ غيرَ قَرِيبِ"],["51FFB730-B4AD-55EA-9C98-B9444A84945E","ما تَمْنَعِي يَقْظَى فقد تُؤْتِينَهُ","في النّوْمِ غيرَ مُصَرَّدٍ مَحْسُوبِ"],["B762B976-3538-5F3E-852C-65E242A4A246","كان المُنَى بِلِقَائِهَا فَلَقِيتُها","فَلَهَوْتُ مِن لَهْوِ امرىء مكْذوبِ"],["B21452F0-D185-56FD-A3A3-BBE30A4C01D6","فرَأيْتُ مثْل الشّمْسِ عندَ طُلوعهِا","في الحُسْنِ أو كَدُنُوّها لِغُروبِ"],["ABC87536-499A-56A6-B7AA-A1AA8EF55499","صَفْراءُ أعْجَلَها الشّبَابُ لِدَاتِها","مَوْسُومةٌ بالحُسْنِ غيرُ قَطوبِ"],["6B889DC9-4448-549F-A95C-61042808DF47","تخطوُ على بردتينِ غذاهما","غدقَ بساحةٍ حائرٍ يعبوبِ"],["5C1546C6-2F6C-56B6-8DD6-0F257EA1C282","تنكل عن حمش اللثات كأنه","برد جلته الشمس في شؤبوب"],["6B3981A8-70D7-5922-A603-CD86EB9B9D6C","كشقيقة السيراء أو كغمامة","بَحْرِيّةٍ في عارضٍ مَجْنوبِ"],["CA69525A-8A6F-5756-8F8D-A6615369EB91","أبَني دُحَيٍّ، والخَنا مِنْ شأنكمْ","أنّى يَكونُ الفَخْرُ للمَغْلوبِ"],["CE96799F-4775-5E03-BEF6-A26CBB2A150D","وكأنهم في الحرب إذ تعلوهم","غَنَمٌ تُعَبِّطُها غُوَاةُ شُرُوبِ"],["39878EAF-A545-5FD6-B990-F8ABF00B9389","إن الفضاء لنا فلا تمشوا به","أبداً بِعَالِيَةٍ ولا بِذَنُوبِ"],["B2B60B8B-66E0-5950-B523-20BC9E3E91D5","وتفَقّدُوا تِسْعِين مِنْ سَرَوَاتِكُمْ","أشْباهَ نَخْلٍ صُرّعَتْ لِجُنوبِ"],["3F64F147-1165-5663-9A9D-C86D7A5FDA7F","وسَلوا صَرِيحَ الكاهِنَيْنِ ومالكاً","عن من لكم من دارع ونجيب"]]},"E98484BD-94FE-5D86-A7FD-DF64AC411E37":{"t":"أُكَثِّرُ أهْلي مِنْ عِيالٍ سِواهُمُ","p":37,"s":"أكثر أهلي من عيال سواهم","r":"436933","v":[["461FEFC5-7C99-5B27-89E8-E13FF3A350C0","أُكَثِّرُ أهْلي مِنْ عِيالٍ سِواهُمُ","وأطوي على الماء القراحِ المبرَّدِ"],["1300F3EF-FD11-5812-A2F0-97A6A6975A43","إذا المرءُ لمْ يشبهْ أباهُ وجدَّهُ","وأُقْحِمَ إقْحاماً فلَمْ يَتَسَدَّدِ"]]},"E5E2262D-1FC6-5647-AA17-834AE2AC87AF":{"t":"إذا أنتَ لم تَنْفَعْ فَضُرَّ فإنّما","p":37,"s":"إذا أنت لم تنفع فضر فإنما","r":"436941","v":[["966264E2-6749-5BFE-A4C4-072D69FF64D1","إذا أنتَ لم تَنْفَعْ فَضُرَّ، فإنّما","يُرَجّى الفَتى كَيْما يَضُرَّ ويَنْفَعا"]]},"38A63D11-C0A5-539D-994C-E8207E3F796A":{"t":"إذا جاوزَ الإثنينسرٌّ فإنّهُ","p":37,"s":"إذا جاوز الإثنينسر فإنه","r":"436920","v":[["839F5949-A322-5D42-847D-81AD1FF53895","إذا جاوزَ الإثنينسرٌّ فإنّهُ","بِنَشْرٍ وتَكْثيرِ الحَدِيثِ قَمِينُ"],["8190FB9B-F99E-597F-8F4E-3647228B4A4C","وإنْ ضَيّعَ الإخْوانُ سِرّاً فإنّني","كَتُومٌ لأسْرَارِ العَشِيرِ أمينُ"],["BF1EFB9B-45B5-5CB7-A1C2-EF98D00F4711","فذلك ما قَدْ تَعْلَمِينَ، وإنّني","مَقَرٌّ بِسَوْداء الفُؤادِ كَنِينُ"],["E6E2F0A7-5F09-5C8F-95D0-C1D21407427E","سلي منْ نديمي في النَّدامى ومألفي","ومنْ هوَ لي عندَ الصَّفاء خدينُ"],["D4FF5868-FA1C-5835-ADAF-975F382C78C9","وأيّ أخي حربٍإذا هيَ شمرتْ","ومدرهِ خصمٍ بعدَ ذاكَ أكونُ"],["D908CF64-68E2-5CE7-A65E-5DC257F41FB1","وهل يحذرُ الجارُ الغريبُ فجيعتي","وخَوْني، وبَعْضُ المُقْرِفينَ خؤونُ"],["EFCE4A45-151F-5ED0-B81D-EF4E97D66B0D","وما لمَعَتْ عَيْني لِغِرَّةِ جارةٍ","ولا ودَّعتْ بالذَّمّ حينَ تبينُ"],["F1D064DA-9A25-540F-9339-FCEBABD1B918","أبى الذَّمَّ نمتني جدودهمْ","لَجَلْدٌ على رَيْبِ الخُطوبِ مَتِينُ"],["E1FAD46C-040E-5A08-AF01-20518901CD38","أمرُّ على الباغي ويغلظُ جانبي","وذو القصدِ أحلولي لهُ وألينُ"],["0388159E-5102-5D30-99E0-E3F8A3E53223","وإنّي لأعْتَامُ الرّجالَ بِخُلّتي","أُولي الرَّأيِ في الأحْداثِ حِينَ تحِينُ"]]},"F5BC6030-56BD-5DCB-B6BC-E3B36612F41A":{"t":"إذَا قَبِيلٌ أرَادُونا بمُؤذِيَةٍ","p":37,"s":"إذا قبيل أرادونا بمؤذية","r":"436924","v":[["25D4C6A9-76CC-593F-B520-9485024BB86E","إذَا قَبِيلٌ أرَادُونا بمُؤذِيَةٍ","فَبالظّواهِرِ أهْلُ النّجْدَةِ البُهَمُ"],["45ED82D0-E4A7-58F3-9613-8EB2231ADB45","إذا الخَزارِجُ نادَتْ يَوْمَ مَلْحَمَةٍ","وشَدَّتِ الكاهِنانِ الخَيْلَ واعْترَموا"],["F8A002B5-A694-5074-9C88-1116CD02CCAF","تدارموا الأوسْ لمّا رقَّ عظمهمُ","حتى تلاقتْ بهِ الأرحامً ولاذِّممُ"],["2D106150-8C72-5303-9289-91D754115A2D","لمّا أتَتْ من بني عَمْرٍو مُلَمْلَمَةٌ","بها تهدُّ حزونُ الأرضِ والأكمُ"],["36511500-2484-555B-B5D7-2198794E5E4F","ومن بن خطمةَ الأبطالش قدْ علموا","لا يهلعونَ إذا أعدؤاهمْ سلموا"],["FAFF20B1-8C75-59CE-A04A-A82F9C77EC66","جزاهمُ اللهُ عنّا أينما ذكروا","لدى المَكارِمِ إذْ عُدَّتْ بها النِّعَمُ"],["EB28F8B9-F1FC-5D0A-B3C9-AF34005744D6","تاللهِ نكفرهمْ ما أورقتْ عضةٌ","وكانَ بالأرضِ منْ أعلامها علمُ"],["C24FA7A0-AFBB-5BA7-A945-E79A20694625","ساقوا الرُّهونَ وآسونا بأنفسهمْ","عندَ الشدائد قدْ برُّوا وقدْ كرموا"],["B5AE9F37-6F0F-52C8-B65D-C898A9683296","ولستُ ناسيهمْ إن جاهلٌ خطلٌ","خنا، وما جدبوا عرضي وما كلموا"]]},"F8B8C6C1-A60C-5AA0-AB94-B1A43CD16BA1":{"t":"الحافظو عورة العشيرة لا","p":37,"s":"الحافظو عورة العشيرة لا","r":"437454","v":[["63FC460D-9D5E-5899-A03D-CA710BA33952","الحافِظوا عَورَةَ العَشيرَةِ لا","يَأتيهُمُ مِن وَرائِنا وَكَفُ"],["C6830900-119C-5417-AC94-EABDF9E80117","يا مالِ وَالسَيِّدُ المُعَمَّمِ قَد","يَطرَأُ في بَعضِ رَأيِهِ السَرَفُ"],["ABC171E1-862D-53C2-BB0D-0CAE4C4EC482","نَحنُ بِما عِندَنا وَأَنتَ بِما","عِندَكَ راضٍ وَالرَأيُ مُختَلِفُ"],["96198BBF-C2BC-5BE3-A7EA-1220B67FDF00","نَحنُ المَكيثونَ حَيثُ يُحمَدُ بِال","مُكثِ وَنَحنُ المَصالِتُ الأُنُفُ"],["1451E4BF-3A6E-55B0-9569-121763FD39E8","يا مالِ وَالحَقُّ إِن قَنِعتَ بِهِ","فَالحَقُّ فيهِ لِأَمرِنا نَصَفُ"],["4C868533-0594-560F-A187-3465876B99A0","خالَفتَ في الرَأيِ كُلَّ ذي فَجَرٍ","وَالبَغيُ يا مالِ غَيرُ ما تَصِفُ"],["F5123ADA-6284-5DCA-AE6B-93E6D822D24B","إِنَّ بُجَيراً مَولىً لِقَومِكُمُ","وَالحَقُّ نُوفي بِهِ وَنَعتَرِفُ"],["CA0F0C40-BB9B-5AB7-A3B0-232462495E7B","إِنّي عَلى ما تَرينَ مِن كِبَري","أَعلَمُ مِن أَينَ تُؤكَلُ الكَتِفُ"],["BA38671F-92F9-5FC9-8976-B61E79D32AF0","إِنَّ بَني عَمَّنا طَغوا وَبَغوا","وَلَجَّ مِنهُم في قَومِهِم سَرَفُ"],["F00E65D9-9A73-579F-B9C2-689C88440CF8","بَينَ بَني جَحجَبي وَبَينَ بَني","كُلفَةَ أَنّى لِجارِيَ التَلَفُ"]],"n":"من بحر المنسرح"},"0DB75CAB-31AB-5D16-B313-D329DEFA63CD":{"t":"بَعْضُ القَوْلِ لَيْسَ لهُ عِيَاجٌ","p":37,"s":"بعض القول ليس له عياج","r":"436918","v":[["5EC97D94-62B3-5BD5-BBBC-0325B9D7ABBD","بَعْضُ القَوْلِ لَيْسَ لهُ عِيَاجٌ","كَمَخْضِ الماء لَيْسَ له إتاءُ"],["74D65CBE-BD78-5E5D-9DBC-8B9A2F8BD1FC","يَصُوغُ لكَ اللّسانُ على هَوَاهُ","وَيَفْضَحُ أكْثرَ القِيلِ البَلاء"],["E4F871FF-9BD9-5889-B2EE-8CC55FE6CD67","ومَا بَعْضُ الإقامَةِ في دِيارٍ","يكونُ بها الفتى إلاَّ عناء"],["E8566250-869B-52ED-A003-EF224003432A","وَلم أرَ كامْرِىءٍ يَدْنو لِخَسْفٍ","لهُ في الأرضِ سيرٌ وانتواء"],["8FED019B-7DF8-5F15-B3C2-E90340BCD863","وبَعْضُ خَلائقِ الأقْوامِ داءٌ","كداء الكشحِ ليسَ لهُ شفاء"],["9EBF1C8D-4138-52AA-A4D6-0E4A4AF0572F","ألا منْ مبلغُ الشّعراء عنّي","فلا ظُلْمٌ لَديَّ ولا ابْتِداء"],["E88FB963-3ADB-5CBD-BB44-965DDDB03E94","ولستُ بعابطِ الأكفاء ظلماً","وعندي للملمّاتِ اجتزاء"],["A850EF19-40EA-5918-A3D7-AF3030B53D6E","يحبُّ المرءُ أن يلقى مناهُ","وبأبى الله إلاَّ ما يشاء"]]},"7B785CB5-ADFC-52F5-ADE3-19E496478833":{"t":"تذكرَ ليلى حسنَها وصَفَاءها","p":37,"s":"تذكر ليلى حسنها وصفاءها","r":"436908","v":[["04C45A72-DFA4-5DDD-940B-79428C632066","تذكرَ ليلى حسنَها وصَفَاءها","وبانتْ فأمسىَ ما ينالُ لقاءهَا"],["8A0AEE47-BF39-5C87-96AD-1ABD77E72611","ومثْلِكِ قدْ أصْبَيْتُ، ليْسَتْ بكَنّةٍ","ولا جارةٍ، أفْضَتْ إليَّ حياءها"],["D5F99187-A508-58E0-85EC-09DB20ECE692","إذا ما اصْطَبَحْتُ أرْبَعاً خَطَّ مِئْزَري","وأتبعتُ دلوي في السَّخاء رشاءها"],["024049D2-CF5F-583A-8818-8BBDC18E3BC9","ثأرْتُ عَدِيّاً والخَطِيمَ فَلَمْ أُضِعْ","ولايةَ أشياءٍ جعلتُ إزءها"],["F132242A-D52F-5B11-A51E-080CA09C2B3A","ضَرَبْتُ بذِي الزِّرَّيْن رِبْقةَ مالكٍ","فأبتُ بنفسٍ قد أصبتُ شفاءها"],["28E0FBBD-CCFA-5316-8C88-4E364119A5F0","وسامحني فيها ابنُ عمرِو بنِ عَامِرٍ","خداشٌ فأدَّى نعمةً وأفاءها"],["C53290CB-51E2-5A14-85F4-C49F5D0C9855","طَعَنْتُ ابنَ عبدِ القَيْس طعنةَ ثائرٍ","لها نفذٌ لولا الشُّعاعُ أضاءها"],["73F471B9-67F0-59FA-A637-68412C139E6B","ملكتُ بها كفّي فأنهرتُ فتقها","يرى قائماً من خلفها ما وراءها"],["740FBC1A-98C0-5A5F-9C90-43137550BE9B","يَهونُ عليَّ أن تَرُدَّ جِرَاحُهُ","عيونَ الأواسي إذ حُمِدتَ بلاءهُا"],["1FAAD92C-4646-5FAD-8FF2-EF8F0E736495","وكنتُ امْرءاً لا أسْمعُ الدَّهْرَ سُبّةً","أسب بها إلا كشفت غطاءها"],["241E47A7-24C8-5E57-BCC7-A3183DEE4C71","وإنّيَ في الحرب الضَّرُوسِ مُوكَّلٌ","بإقْدامِ نَفْسٍ ما أُرِيدُ بَقاءها"],["DB59927F-87BB-51D5-88DE-4E782B4E83AD","إذا سَقِمَتْ نَفْسي إلى ذي عَداوةٍ","فإنّي بِنَصْلِ السّيْفِ باغٍ دواءها"],["831AA1A0-38D3-5FFD-B184-28E9A242506F","متى يأت هذا الموت لا تبق حاجة","لنفسي إلا قد قضيت قضاءها"],["CD63CAC0-D68A-51A6-A090-9619547A3A3F","وكانت شَجاً في الحَلْقِ ما لم أبُؤْ بها","فأبت بنفس قد أصبت دواءها"],["F077CC7F-0335-50FD-B964-531360F46188","وقد جربت مني لدى كل مأقطٍ","دُحَيٌّ إذا ما الحَرْبُ ألْقَتْ رِداءها"],["D5229AA1-969E-5828-B8BA-D8CFFDC986CB","وإنّا إذا ما مُمْتَرُوا الحَرْبِ بَلّحُوا","نُقيمُ بأسْبادِ العَرِينِ لواءها"],["94D09C96-A167-5D41-835D-3C5BA0A74B91","ونُلْقِحُها مَبْسُورةً ضَرْزَنِيّةً","بأسيافنا حتى نذل إباءها"],["9A774F18-26D6-577E-8336-A36E9011EC36","وإنا منعنا في بعاث نساءنا","وما مَنَعَتْ مِ المخْزِياتِ نِساءها"]]},"65E69C4F-5828-5934-BA16-123AD6AFF323":{"t":"تقولُ ابنةُ العمري آخرَ ليلها","p":37,"s":"تقول ابنة العمري آخر ليلها","r":"436925","v":[["67270894-60D7-5370-8519-609A7FE9CF3D","تقولُ ابنةُ العمري آخرَ ليلها","علامَ منعتَ النومَ، ليلكَ ساهرُ"],["980B1688-2480-585F-BE02-8498CF96FE3C","فقلتُ لها: قومي أخافُ عليهمُ","تَبَاغِيَهُمْ، لا يُبْهِكُمْ ما أُحاذِرُ"],["EB3F6746-485A-5B61-9EAF-2D097EDDA46E","فلا أعرفنكمْ بعدَ عزٍّ وثروةٍ","يُقالُ: ألا تِلْكَ النَّبيتُ عَساكِرُ"],["06751D77-0C8F-5E1C-BB15-B118A982262C","فلا تَجْعَلوا حَرْباتِكُمْ في نحورِكمْ","كما شدَّ ألواحَ الرِّتاجِ المسامرِ"]]},"F189FA05-0155-5B0C-BB55-51D4DBC59945":{"t":"ردَّ الخليطُ الجمالَ فانصرفوا","p":37,"s":"رد الخليط الجمال فانصرفوا","r":"436912","v":[["88B2BEDB-990D-5077-93D5-ED7F6DA6C9F1","ردَّ الخليطُ الجمالَ فانصرفوا","ماذَا عَلَيْهِمْ لَوَ انّهُمْ وَقَفُوا"],["2E50B834-15B3-5DCB-B5F1-82F4DC1043A5","لَوْ وَقَفُوا ساعةً نُسَائلُهُمْ","رَيْثَ يُضَحّي جِمَالَهُ السَّلَفُ"],["253071E3-9771-5F53-8EDA-FDC17B09E6A5","فِيهِمْ لَعُوبُ العِشاء آنِسَهُ الـ","دَّلّ، عروبٌ يسوءها الخلفُ"],["BBDD5251-9B58-5743-AA75-F96CA18E7BC2","بَيْنَ شُكولِ النّساء خِلْقَتُها","قصدٌ، فلا جبلةٌ ولا قضفُ"],["67803AC8-5D0E-5A7D-AC42-C0A484FA94B3","تغترقُ الطَّرفَ وهيَ لاهيةٌ","كأنّما شَفَّ وَجْهَها نُزُفُ"],["6F52E01A-BE56-52A0-83F7-62F67AEA5C1D","قَضى لهَا اللَّهُ حين يَخْلُقُها الـ","ـخالقُ ألاَّ يكنَّها سدفُ"],["82E64E06-A54A-56C2-BFD4-5ADF25BEE435","تَنامُ عَنْ كُبْرِ شَأنِها فإذا","قَامَتْ رُوَيْداً تَكادُ تَنْغَرِفُ"],["C7A95497-3A54-5270-8006-B7D3E37006B5","حَوْراءُ جَيْداءُ يُسْتَضاء بها","كأنّها خُوطُ بَانَةٍ قَصِفُ"],["189A3E8A-A824-5C27-9FDB-22200E4C731B","تَمْشي كمَشْيِ الزَّهراء في دَمَثِ الـ","ـرَّملِ إلى السّهلِ دونهُ الجرفُ"],["C534B3E6-F06A-5E5C-84D2-93C735D61857","ولا يغثُّ الحديثُ ما نطقتْ","وَهْوَ بِفِيها ذُو لَذَّةٍ طَرِفُ"],["51A9B482-4BED-5B98-A37E-3D4A9776C8CF","تَخْزُنُهُ وَهْوَ مُشْتَهًى حَسَنٌ","وهوَ إذا ما تكلمت أنفُ"],["85C4B360-D3CD-52EC-AE76-69C7D97E790F","كأنَّ لبّاتها تبدَّدها","هَزْلى جَرَادٍ أجْوَازُهُ جُلُفُ"],["00CB747B-2F10-522B-8DE3-D4A2E672D504","كأنّها دُرَّةٌ أحَاطَ بِها الـ","ـغوَّاصُ، يجْلو عن وجهها الصَّدَفُ"],["D1C9AA59-16F9-52E7-9782-7104973B7A76","واللهِ ذي المسجدِ الحرامِ وما","جُلِّلَ مِنْ يُمْنَةٍ لها خُنُفُ"],["8BAC51C1-B650-5B1C-86A6-C14367C04307","إِنّي لَأَهواكَ غَيرَ ذي كَذِبٍ","قَد شُفَّ مِنّي الأَحشاءُ وَالشَغَفُ"],["1C86E759-33EB-5E80-B4A3-10A36572C9FB","بَل لَيتَ أَهلي وَأَهلَ أَثلَةَ في","دارٍ قَريبٍ مِن حَيثُ تَختَلِفُ"],["01943058-6AFA-534A-99FD-017B09837788","أَيهاتَ مَن أَهلُهُ بِيَثرِبَ قَد","أَمسى وَمَن دونَ أَهلِهِ سَرِفُ"],["49FD37FB-C690-548F-AC66-75C9707BB8AB","يا رَبِّ لا تُبعِدَن دِيارَ بَني","عُذرَةَ حَيثُ اِنصَرَفتُ وَاِنصَرَفوا"],["046B144F-9A24-56C4-8526-77C16250B476","أَبلِغ بَني جَحجَبى وَقَومَهُمُ","خَطمَةَ أَنّا وَراءَهُم أُنُفُ"],["6DD59C91-CD34-5633-B057-50DFC00C06C9","وَأَنَّنا دونَ ما يَسومُهُمُ ال","أَعداءُ مِن ضَيمِ خُطَّةٍ نُكُفُ"],["C8575F84-B56B-5807-9C7A-9A5D1ADB51C7","نفلي بحدّ الصَّفيحِ هامهمُ","وفلينا هامهمْ بنا عنفُ"],["6E41565A-7F51-53D2-87BA-91EB2C24C0C5","إنّا وَلَوْ قَدَّمُوا التي عَلِمُوا","أكْبادُنَا مِنْ وَرَائهِمْ تَجِفُ"],["5303829B-4C5A-5DBC-A4D7-D8B345C92A64","لمّا بدتْ غدوةً جباههمُ","حنتْ إلينا الأرحامُ والصُّحفُ"],["C41868FB-771C-5FCB-A24E-86212B9DD801","كقيلنا للمقدِّمينَ: قفوا","عن شأوِكُمْ، والحِرَابُ تخْتَلِفُ"],["8FCB3528-FCB7-58FB-AF5A-03A839F1FF50","يتبعُ آثارها إذا اختلجتْ","سُخْنٌ عَبِيطٌ عُرُوقُهُ تَكِفُ"],["AA373DE9-D3C5-5FE0-A204-7E09978BE47B","قالَ لنا النّاسُ: معشرٌ ظفروا","قلنا: فأنّى بقومنا خلفُ"],["830696DF-7DF7-5511-AEF8-E29FD8C50F05","لنا معَ آجامنا وحوزتنا","بَيْنَ ذُرَاها مَخارِفٌ دُلُفُ"],["B25363B6-0C18-5449-A7B4-54B7598C967C","يذبُّ عنهنَّ سامرٌ مصعٌ","سودَ الغواشي كأنّها عرفُ"]]},"106E3C05-DB71-5D07-8690-5579D407CF50":{"t":"ردَّ الخليطُ الجمالَ فانقضبا","p":37,"s":"رد الخليط الجمال فانقضبا","r":"436921","v":[["CD0270D1-3A96-56B1-9268-DD99898C25D9","ردَّ الخليطُ الجمالَ فانقضبا","وقطّعوا منْ وصالكِ السَّببا"],["1541ED4F-E8CA-5C48-B15E-3D21ADFE3555","قادتهمُ للفراقِ شاطنةٌ","فشطَّ وليُ الحبيبِ فاغتربا"],["A96A8C78-3502-57C2-AC9A-3F11C2A715E3","لَمْ أدْرِ قَبْلَ النّوَى بِبَيْنِهِمُ","حتّى استطارتْ عصاهمُ شعبا"],["EF9C6718-6ADF-550F-8A8C-9BCFF41AC5CC","هِنْدٌ تَجَنّى الذُّنُوبَ عاتِبةً","يا حبَّ بالعاتبِ الذي عتبا"],["0865B21E-7C72-55FC-B185-48C95AE60720","أقسمتُ لولا الذي زعمتُ وما","خبرتُ قوماً عن مجدهمْ كذبا"],["FB089D5A-49CC-5A5F-B3C7-89ABC0C551EC","وقدْ أضعتِ الذي حفظتُ منَ الـ","ـودّ -لقدَّ متُ مدحةً عجبا"],["86D3D942-D0AF-5B58-BE67-6925380F8674","أفنيتُ دهري وطولَ دهركِ لا","نَنْفَكُّ نُزْجي مَقالةً لَعِبَا"],["79C97E09-67B5-53CC-AB16-987B04399E8A","يَسْلُكُ منْها الصَّعودَ مَنْ طَلَبَ الـ","ـقصدَ وتعوي سباعها كلبا"],["F8F221E7-3E27-57BC-A8FB-31DEC354574E","هلاَّ إذِ الخورُ في أصرَّتها","والحفلُ في الذَّرّ تقطعُ العصبا"],["4A295C81-B446-5742-B4DE-4C03D349092E","لاقَيْتِ أمري والرَّأيُ مُؤْتَنِفٌ","أتبعُ رأساً وأتركُ الذَّنبا"],["5C152CD8-20C9-5CD7-8FC1-8CDC005F31E1","في غيرِ ما كنههِ سفهتِ وما","أحدثتِ حالاً فتحدثي الخطبا"],["ABF41D05-3128-58B5-8289-588DB285B600","الحَمْدُ للَّهِ البَنِيّةِ إذْ","أمستْ دحيٌّ قدْ أثخنتْ غلبا"],["675440E5-6599-56F3-9E11-4085ED72E8D9","يَرْكَبُ حَزْنَ الطّرِيقِ أوَّلُهُمْ","يدعو يني عمهِ وقدْ كربا"],["6043ABDB-2A29-5389-95FC-AFE9A9C68EB4","غودرَ عندض المكرّ سيّدهمْ","فيهِ سنانٌ تخالهُ لهبا"],["A5CF57D3-E2F6-56A9-A8AF-F00CA8E644B1","وابنا حرامٍ وثابتٌ كشفتْ","خَيْلاهُما عَنْهُما وقَدْ عَطِبَا"],["54E0321D-ABDF-5D08-A00F-F74E4A8AA0B1","زُرْنَاهُمُ بالخَمِيسِ ضَاحِيةً","نُزْجي إلى المَوْتِ جَحْفَلاً لَجِبَا"],["B32B800A-FA0C-5B0C-8CCB-AEBCC77C9E00","جاءتْ بنو الأوسِ عارضاً برداً","تَحْلِبُهُ الرّيحُ مُقْبِلاً حَلَبا"],["B88E4BCD-D530-5869-A13B-29048F36E07C","أرْعَنَ مِثْلَ الأتيّ أعْقَبَهُ","صَوْبُ مُلِثٍّ يُسَيِّلُ الحَدَبَا"],["987D8228-5E07-5F86-B6C4-46A43C1B0767","إنَّ بني الأوسِ حينَ تستعرُ الـ","ـحَرْبُ لَكالنّارِ تأكلُ الحَطَبَا"],["23843F64-D19A-5040-9F4A-759541708733","إنَّ بني الأوسِ معشرٌ صدقوا الـ","ـضَّرْبَ وَسَنُّوا الإساءَ والنَّدَبَا"],["9501E25E-36E1-5F16-8182-761327B50B2D","فَصَمَدُوا رَأس كَبْشِ إخْوَتِهِمْ","حتّى تولَّوا واستنفروا هربا"],["77EA9A54-3570-535E-8220-B40FCB2DFF6B","بكُلّ لَيْنٍ ماضٍ ضَرِيبَتُهُ","عَضْبٍ إذا ما هَزَزْتَهُ رَسَبا"],["26FE93A4-DCA7-52A7-B149-DE74924503C4","قالتْ بنو الأوسِ منْ عفافهمُ","مرُّوا ولا تأخذوا لهمْ سلبا"],["8EDCCF8B-2DB0-5FB0-9B8E-6AE602AE2235","تسوقُ أخراهمُ أوائلهمْ","كما يسوقُ المعارضُ الجلبا"],["5EB74D1D-A73E-51C3-8B7A-E5408BFF2566","لمّا دعاهمْ للموتِ سيّدهمْ","ثَابَتْ إليهمْ جُمُوعُهُمْ عُصَبَا"]]},"61EADA0C-C432-54E0-9B7C-6C873329E2B1":{"t":"سلِ المرءَ عبدَ الله إذْ فرَّ هلْ رأى","p":37,"s":"سل المرء عبد الله إذ فر هل رأى","r":"436916","v":[["EB81FF3E-D9B3-5F64-A688-F6BC0E1A414E","سلِ المرءَ عبدَ الله إذْ فرَّ هلْ رأى","كتائبنا في الحربِ كيفَ مصاعها"],["BCEF9FC1-8B49-550F-AB80-04FD677AE8AA","ولوْ قامَ لمْ يلقَ الأحبّةَ بعدها","ولاقى أُسُوداً هَصْرُها ودِفاعُها"],["754859D7-FBA2-5B6F-95BC-75DC9CA03FD9","ونحنُ هَزَمْنا جَمْعَكُمْ بكَتيبةٍ","تَضَاءلَ مِنها حَزْنُ قَوْرى وقاعُها"],["047391A5-91AC-59CD-9969-DBD311B8E9CC","إذا هم جمع بانصراف تعطفوا","تعطف ورد الخمس أطّت رباعها"],["65587276-3E62-5FBC-A672-91FD6A92E5B1","تركنا بعاثاً يوم ذلك منهم","وقَوْرَى على رَغْمٍ شِباعاً ضِباعُها"]]},"0859B6AB-E0A7-5C34-BA6D-701F08C632C2":{"t":"صرمتَ اليومَ حبلكَ منْ كنودا","p":37,"s":"صرمت اليوم حبلك من كنودا","r":"436917","v":[["B2350F5D-2BF5-5A45-8E66-ABA5E8B1435B","صرمتَ اليومَ حبلكَ منْ كنودا","لتبدلَ حبلها حبلاً جديدا"],["71BD873F-8293-50E4-9914-10DCA2646664","مِنَ اللاَّئي إذا يَمْشِينَ هَوْناً","تجلببنَ المجاسدَ والبرودا"],["9A925B79-82FA-5ADD-A75E-BC2A299BA321","كأنَّ بطونهنَّ سيوفُ هندٍ","إذا ما هُنَّ زايَلْنَ الغُمُودا"],["E7992CF6-97A7-574A-B73D-DF86CE16C7C5","تبدَّتْ لي لتقتلني فأبدتْ","مَعَاصِمَ فَخْمَةً مِنْها وَجيدا"],["74404347-187B-5720-8F14-49E631BFFC95","ووجهاً خلتهُ لمّا بدا لي","غَدَاةَ البَيْنِ دِيناراً نَقِيدا"],["2757C8EF-FC74-5E67-B260-15C0A401E5F2","سقينا بالفضاء كؤوسَ حتفٍ","بني عوفٍ وإخواتهمْ تزيدا"],["AC72B911-7F9B-5696-A2BD-42D27C24C5EB","لَقِيناهُمْ بِكُلّ أخي حُرُوبٍ","يقودُ وراءهُ جمعاً عتيدا"],["219CD7D6-C73C-5894-B6F2-B2CDCCDA1B8A","وَمُشْرِفَةَ التَّلائلِ مُضْمَرَاتٍ","طَوَى أحْشاءها التَّعْداءُ، قُودا"],["37CCB128-0FC2-5744-A0DF-8D4385F3F53D","أكُنْتُمْ تَحْسِبُون قِتالَ قَوْمي","كأكْلِكُمُ الفَغَايا والهَبِيدا"],["24F83986-C27C-5156-8776-64D6023B7A35","وإنّ سُيُوفَنا ذَهَبَتْ عَلَيْكُمْ","بَني شَرِّ الخَنى مَهَلاً بَعِيدا"],["518E3D5D-D3D0-551B-A642-268519AA8504","ويأبى جَمْعُكُمْ إلاَّ فِرَاراً","ويأبى جَمْعُنا إلاَّ وُرُودا"],["1778759C-7CE5-5013-81BE-96D2084EB686","وإنَّ وعيدناكمْ حينَ نمشي","بهنَّ على المنون ولا وعيدا"],["74C6DCF6-700F-5DB5-AF67-3AAB98BC0179","ألا منْ مبلغٌ عنّي كعيباً","فهلْ ينهاكَ لبُّكَ أنْ تعودا"],["31CBA62C-6020-57B2-9D20-4494003B58AB","أراني كُلّما صَدَّرْتُ أمْراً","بني الرَّقعاء جشّمكمْ صعودا"],["E510D06B-9113-5623-AB24-13A29E4BFE26","فما أبقتْ سيوفُ الأوسِ منكمْ","وحَدُّ ظُباتِها إلاَّ شَرِيدا"],["41A0C17B-FAB9-5312-BF26-E659D0894A45","فَلَنْ نَنْفَكَّ نَقْتُلُ مَا حَيِينا","رجالكمُ ونجعلكمْ عبيدا"]]},"050B0022-3BD6-5896-8607-C04D2A5288C5":{"t":"فلا تَمْذُلْ بِسِرّكَ كلُّ سِرٍّ","p":37,"s":"فلا تمذل بسرك كل سر","r":"436939","v":[["7F2CFD56-03AD-5C9E-82CD-A898F528564B","فلا تَمْذُلْ بِسِرّكَ، كلُّ سِرٍّ","إذا ما جاوزَ الإثنينِ، فاشي"]]},"94277FED-96DF-52FC-866E-D57E07A6AE8F":{"t":"فَما ظَبْيَةٌ مِنْ ظِباء الحِسا","p":37,"s":"فما ظبية من ظباء الحسا","r":"436928","v":[["AB1F7511-38E0-52E2-9063-32F2DF0B4E44","فَما ظَبْيَةٌ مِنْ ظِباء الحِسا","ء عَيْطاءُ تَسْمَعُ مِنْها بُغاما"],["DA4100AC-E886-54A1-8699-B83D4F241D86","ترشِّحُ طفلاً وتحنو لهُ","بِحِقْفٍ قدَ انْبَتَ بَقْلاً تُؤاما"],["86175B9E-9757-5AB5-A229-A7933EF1E260","بأحْسنَ مِنْها غَدَاةَ الرَّحِيـ","ـلِ قَامَتْ تُرِيكَ أثِيثاً رُكاما"],["829F1FA6-0205-55B7-A242-827B39369671","فما كانَ حبُّ ابنةٍ الخزرجـ","ـيِّ إلاَّ عناءً وإلآَّ غراما"],["56B5497C-DE37-5268-AF49-9B9271D0F5EF","فهلْ ينسينْ حبَّها جسرةٌ","مِنَ النّاعِجاتِ تُباري الزِّماما"],["38730482-D93F-5E9A-9336-32E1C8BE0C83","كأنَّ قُتُودي على نِقْنِقٍ","أزجَّ يباري بجوٍّ نعاما"],["43E41853-68BB-5E93-9401-649E85A3FA77","وفي الأرضِ يسبقُ طرفَ البصيرِ","فَبَيْنا يَعُوجُ تَرَاهُ اسْتَقَاما"],["6419D506-5E4E-57CC-BD69-99BC8A017D70","ومأقِطِ خَسْفٍ أقَمْنا بِهِ","على ضتكهِ خشيةً أنْ نلاما"],["09737A46-1646-5250-A6EC-380E59742027","وقَوْماً أبَحْنا حِمَى مَجْدِهمْ","وكانوا لِمَنْ يَعْترِيهِمْ سَنَاما"],["340388DD-F9D8-57CA-933D-06FE0DD5B8EB","أذاعتْ بِهِمْ كلُّ خَيْفانةٍ","طروحٍ طموحٍ تلوكُ اللِّجاما"]]},"A7F3228E-B7A0-5EDC-BF4D-DFF72A0845DD":{"t":"كَتُومٌ لأسْرَارِ الخَلِيلِ أمِينُها","p":37,"s":"كتوم لأسرار الخليل أمينها","r":"436935","v":[["7A7F6E1E-4FEA-52C0-BC55-91FA00C45D22","كَتُومٌ لأسْرَارِ الخَلِيلِ أمِينُها","يرى أنَّ بثَّ السرّ قاصمةُ الظَّهرِ"],["F310D4A3-EF70-5967-9F12-B743264A5B93","وقد ضمرتْ حتى كأنَّ وضينها","وِشاحُ عَرُوسٍ جالَ مِنها على خَصْرِ"]]},"C189231A-E78C-527A-BC20-27BB8E9DEB31":{"t":"كَمْ قائمٍ يُحْزِنُهُ مَقْتَلي","p":37,"s":"كم قائم يحزنه مقتلي","r":"436927","v":[["D71F68F0-E8D5-513C-823A-0B015278F61C","كَمْ قائمٍ يُحْزِنُهُ مَقْتَلي","وقاعدٍ يرقبني شامتُ"],["F7CE513B-906E-59B2-92FA-5A2CE6CE5C59","أبلغْ خداشاً أنّني ميتٌ","كلُّ امرئٍ ذي حسبٍ مائتُ"]]},"A20A93A4-1B36-5A05-905E-664EE131A9C8":{"t":"لأُصَرِّفَنّ سِوَى حُذَيْفَةَ مِدْحتي","p":37,"s":"لأصرفن سوى حذيفة مدحتي","r":"436923","v":[["C96D3295-42F8-5CB6-938B-066395607EC7","لأُصَرِّفَنّ سِوَى حُذَيْفَةَ مِدْحتي","لفنى العشيِّ وفارسِ الأجرافِ"],["1729B911-6C7D-5C90-B101-D09857A38024","منْ لا يزال يكبُّ كلَّ ثقيلةٍ","وَزْماءَ غَيْرَ مُحاوِلِ الإنْزَافِ"],["93B092E5-121E-5C89-BD1E-928B0CB7E7B4","رحبُ المباءةِ والجنابِ موطّأٌ","مَأوًى لكُلّ مُعَصَّبٍ مِسْوافِ"],["B03D1F07-66BD-5ECC-B709-6818C30E0D12","الضَّارِبُ البَيْضَ المُتَقَّنَ صُنْعُهُ","يَوْمَ الهياجِ بكُلّ أبْيَضَ صافي"],["DB722411-6C10-5B29-AFAD-715BC167B4DA","إنْ تلقَ خيلَ العامريِّ مغيرةً","لا تلقهمْ متعنِّقي الأعرافِ"],["CAE9A75C-E428-521A-8D6C-71320EB5CC4F","وإذَا تَكُونُ عَظِيمَةٌ في عَامِرٍ","فَهُوَ المُدَافِعُ عَنْهُمُ والكافي"],["FAF46D0C-62AF-5DAB-81A4-4F118712EC1E","الواتِرُونَ المُدْرِكُونَ بتَبْلِهمْ","والحاشدونَ على قرى الأضيافِ"],["1F0B6EBB-1085-57DD-9441-7282D4D9AB9C","تعدوبهمْ في الرَّوعِ كلُّ طوالةٍ","تنضو الجيادَ، ومنهبٍ غرَّافِ"],["2838A17D-B5EB-5155-89FC-9745F7465FE9","ربذس قوائمهُ شديدٍ أسرهُ","صلتِ المعذَّرِ ذي بيبٍ ضافِ"],["F7C7BCDF-B277-5D81-874F-A8D50D732B31","ألْفَيْتَهُمْ يَوْمَ الهِياجِ كأنّهُمْ","أسدٌ ببيشةَ أو بغافِ روافِ"]]},"4C7F1B3B-03EF-5C6A-9F04-51EB3453DBF9":{"t":"لعمرة إذْ قلبهُ معجبٌ","p":37,"s":"لعمرة إذ قلبه معجب","r":"437179","v":[["E52FB049-B1D1-58AC-A3BA-CF6A2116B30E","لعمرة إذْ قلبهُ معجبٌ","فأنّى بعمرةَ أنّى بها"],["DF0DBF8D-4A0E-5210-BEE8-89E20FE19A87","ليالٍ لنا ودها منصبٌ،","إذا الشَّولُ لطت بأذنابها"],["16303F7E-3B36-537E-8396-55550FAD65D5","وراحت حدابيرُ حب الظهو","رِ مجتلماً لحم أصلابها"],["51127A2E-59B5-59F6-AC07-06CBA535EE79","كأن القرنفل والزنجبيلَ","وذاكي العبيرِ بجلبابها"],["BD5F43BA-FE80-5B59-A401-3463D2533E1B","نَمَتْها اليَهُودُ إلى قُبّةٍ","دوينَ السماء بمحرابها"],["28BD5AE2-CFF8-5D0F-A3BD-79ABD56D631B","ونارٍ يُقَصِّرُ عَنْها الدَّنِـ","ـيُّ آخِرَ لَيْلٍ صَلِينا بها"],["6A569E90-4DF6-55F3-A828-AD6286340135","ومَلْمومَةٍ كَصَفاةٍ المَسِيـ","ـلِ دارتْ رَحاها وَدُرْنا بها"],["7878C45B-334A-5EC2-ADE2-2957C6D78C8D","مَشَيْنا إليها كَجُرْبِ الجِما","لِ باقي الهِناء بأقْرابِها"]]},"F4E4EBA2-AAE8-5FD0-8C84-484F5DF349DE":{"t":"لو كنتمُ منّا قريباً لخفتمُ","p":37,"s":"لو كنتم منا قريبا لخفتم","r":"436934","v":[["236E92DD-909C-50C7-9604-2BA8B430172F","لو كنتمُ منّا قريباً لخفتمُ","سِبابي إذا أنْشَأتُ في شُرُبِ الخَمْرِ"],["7776501A-B5F7-5B9F-9D8B-527BFAF97B3D","وإنّي لَمِسْماحُ العَشِيِّ مُؤَزَّرٌ","أسامحُ في أمثالكمْ عصبَ التَّجرِ"],["C40EDBCC-DF93-5B40-A498-F1981479BB5C","كأنّهُمُ إذْ وَاقَفُوني على مِنًى","سيولُ الحجازِ ناطحتْ عرض البحرِ"],["287F0C56-FD2D-54EC-A416-FF566BA6F377","فما الأسدُ باللاَّتي الغريف مقيلها","ولكنَّ أُسْدَ الغابِ حافةَ ذي الجَدْرِ"],["2028119D-8272-5A4D-AD0B-5EBE05554A24","بَنُوا حَطْمَةَ الأبْطالُ إنّهُمُ بها","غذوا، وعليها ينشأونَ يدَ الدّهرِ"]]},"5200017E-AC08-5EB9-A41E-7259DD0F81F0":{"t":"مأوى الضَّريك إذا الرياحُ تناوحتْ","p":37,"s":"مأوى الضريك إذا الرياح تناوحت","r":"436943","v":[["E655A94F-CA99-5604-BE3B-7F733517C4E7","مأوى الضَّريك إذا الرياحُ تناوحتْ","ضَخْمِ الدَّسيعةِ مُخْلِفٍ مِتْلافِ"],["03F32E02-EB8B-5A7F-B63D-61568AA6B8A7","فَسقى الغوادي رَمْسَكَ ابنَ مُكَدَّمٍ","مِنْ صَوْبِ كلِّ مُجَلْجِلٍ وكّافِ"],["9BE7BCC7-FCCC-53BF-BE4C-1FCCBAA34C9A","أبلغْ بني بكرٍ وخصَّ فوارساً","لحقوا الملامة دون كلّ لحافِ"],["B4660F54-B0BD-5EED-9893-5DEEF267A42A","أسلمتمُ جذلَ الطِّعانِ أخاكمُ","بينَ الكَدِيدِ وقُلّةِ الأعرافِ"],["61B26520-D5D4-5BF4-A037-C707B163E356","حتّى هَوَى مُتَدائلاً أوْصَالُهُ","لِلّحْدِ بينَ جَنادلٍ وقِفافِ"],["E068FC43-FF22-5168-8FBE-549E55A6B6BD","للَّهِ دَرُّ بَني عَدِيٍّ إنّهُمْ","لَمْ يَثْأروا عَوْفاً وحَيَّ خِفافِ"]]},"DEDA2DA1-ECC8-5989-8A47-1FCD7F104D98":{"t":"معاقلهمْ آجامهم ونسائهمْ","p":37,"s":"معاقلهم آجامهم ونسائهم","r":"436915","v":[["B28D8528-67D6-51A4-8B5E-9E9F11EDD464","معاقلهمْ آجامهم ونسائهمْ","وأيماننا بالمشرفية معقلُ"],["9BCAFDFB-B9CC-522E-95FA-6B33FF3359D3","كأنَّ رؤوس الخزرجيّينَ -إذْ بدتْ","كتائبنا تترى معَ الصُّبحِ-حنظلُ"],["3B636FB1-EF4F-5F32-931B-343DE2D27043","فلا تقربوا جذمانَ إنَّ حمامهُ","وجنتّهُ تأذى بكم، فتحمّلوا"],["2C1E7F01-2997-5FF6-96FE-59381A534797","وكائنْ رأينا منْ أناسٍ ذوي غنىً","وجِدَّةِ عَيْشٍ أصْبَحوا قدْ تبَدَّلوا"],["372CF53B-C363-58F4-8E12-FC37B4C2A938","فإنْ تكُ قد أُوتيتَ مالاً فلا تكُنْ","بهِ بَطِراً والحالُ قَدْ تَتَحوَّلُ"],["DCFD1BD4-4C98-5D96-81E9-D62DBEDC7D71","فَلَيْس علينا قالَةٌ غَيْرَ أنّنا","نسودُ ونكفي، كلَّ ذلك نفعلُ"],["D765531C-EFE0-5E3F-B231-C33669463CCD","كأنّا وقدْ أجلوا لنا عنْ نسائهمْ","أسودٌ لها في عيصِ بشيةَ أشبلُ"],["B2584D5F-9701-5603-A458-6AAC7BEF4199","بِبِئرِ الدُّرَيْكِ فاسْتَعِدُّوا لمِثْلِها","وأصغوا لها آذانكمْ وتأمّلوا"]]},"C43B0E13-60D5-5519-B521-F8F520B5CF2E":{"t":"منْ يكُ غافلاً لمْ يلقَ بؤساً","p":37,"s":"من يك غافلا لم يلق بؤسا","r":"436919","v":[["D110AB82-7734-5A0C-ABF3-D408079BCB38","منْ يكُ غافلاً لمْ يلقَ بؤساً","يُنِخْ يَوْماً بسَاحَتهِ القَضَاءُ"],["8BD1CCF0-A1B4-5604-934F-EF92F8B1B49E","تَنَاوَلُهُ بَنَاتُ الدَّهْرِ حَتّى","تثلِّمهُ كما انثلمَ الإناء"],["E15D4EE4-62BB-5297-8918-75DB5DDE17CB","وكلُّ شديدةٍ نزلتْ بحيٍّ","سيأتي بعدَ شدَّتها رخاء"],["465DF396-5520-5BAD-8F73-DDC923BC055E","فَقُلْ للمُتّقي عَرَضَ المَنَايا:","تَوَقَّ، ولَيْسَ يَنْفَعُكَ اتّقاء"],["60777F7E-5725-51A1-AAFE-EEB795C826A4","فلا يعطى الحريصُ غنىً لحرصٍ","وقدْ ينمي لذي العجزِ الثَّراء"],["021CC5E3-346F-517B-A9E9-B0340A872FC9","غنيُّ النّفسِ، ما استغنى، غنيٌّ","وفَقْرُ النّفْسِ، ما عَمِرَتْ، شَقاء"]]},"8AD6D496-FE29-5C0D-9A8E-A4C8C814B485":{"t":"نحنُ بغرسِ الوديّ أعلمنا","p":37,"s":"نحن بغرس الودي أعلمنا","r":"436942","v":[["FA813D5F-2834-56A4-9F46-65FDE507BDEA","نحنُ بغرسِ الوديّ أعلمنا","منّا بِرَكْضِ الجيادِ في السَّدَفِ"],["6CA4BDFA-5780-54C1-B1CF-86306B28F649","يا لَهْفَ نَفْسِي وكيف أطْعنُهُ","مستمسكاً واليدانِ في العرفِ"],["1CD0F615-51B8-5BC2-85FF-77F005DCF5FB","قَدْ كُنْتُ أدْرَكْتُهُ فأدْرَكَني","للصَّيْدِ عرفٌ مِنْ مَعْشَرٍ عُنُفِ"]]},"91D3361F-9F6E-5EEB-A57B-37DE40C0AB9F":{"t":"واللَّهِ لا يأتي بِخَيْرٍ صدِيقَها","p":37,"s":"والله لا يأتي بخير صديقها","r":"436940","v":[["CC8D41AB-A48C-54AB-A365-E1AD92F304E9","واللَّهِ لا يأتي بِخَيْرٍ صدِيقَها","بَنو خَنْدَعَ ما اهتَزَّ في البحْرِ أيْدَعُ"]]},"11DC3284-B971-5CBD-A182-1ACDD68C82AC":{"t":"وقدْ لاحَ في الَصُّبْحِ الثُّريّا لمَنْ رأى","p":37,"s":"وقد لاح في الصبح الثريا لمن رأى","r":"436937","v":[["CEFC4775-8616-5CAD-9181-13AF5F012BCF","وقدْ لاحَ في الَصُّبْحِ الثُّريّا لمَنْ رأى","كَعُنْقُودِ مُلاَّحِيّةٍ حِينَ نَوَّرا"]]},"C1B927F0-3D6F-5266-BBDB-255BE84B21A8":{"t":"ولا ينسيني الحدثانُ عرضي","p":37,"s":"ولا ينسيني الحدثان عرضي","r":"436936","v":[["7A499B94-0B4E-5AD6-88C8-E1D0D953EA8F","ولا ينسيني الحدثانُ عرضي","ولا أرخي منَ المرحِ الإزارا"]]},"118504B2-2D90-572D-9E0D-3FACCADF972B":{"t":"وليسَ بنافعٍ ذا البخلِ مالٌ","p":37,"s":"وليسَ بنافعٍ ذا البخلِ مالٌ","r":"437637","v":[["67E9D8D9-E39A-592F-8F8C-E9DF80FE0C6C","‌وَلَيسَ ‌بِنافِعٍ ‌ذا ‌البُخلِ مالٌ","وَلا مُزرٍ بِصاحِبِهِ السَخاءُ"],["84FC6A54-E0E7-5B04-B9F1-2D1F1B1A53BA","وَبَعضُ الداءِ مُلتَمَسٌ شِفاهُ","وَداءُ النوكِ لَيسَ لَهُ شِفاءُ"],["D6887CCF-63CE-5C83-B9FD-EE37E386EFD2","يَوَدُّ المَرءُ ما تَعِدُ اللَيالي","وَكانَ فَناؤُهُنَّ لَهُ فَناءُ"],["6E33DFF6-CC47-5AEA-A811-99E0DB19A50D","كَذاكَ الدَهرُ يَصرِفُ حالَتَيهِ","وَيُعقِبُ طَلعَةَ الصُبحِ المَساءُ"],["BC851C8C-1337-50A7-B6EE-BCFE1426430F","فَإِنَّ الضَغطَ قَد يَحوي وِعاءً","وَيَترُكُهُ إِذا فَرَغَ الوِعاءُ"],["BF151889-1E14-5C3A-9943-21AE2DCEB6CA","وَما مُلِئَ الإِناءُ وَشُدَّ إِلّا","لِيُخرِجَ ما بِهِ اِمتَلَأَ الإِناءُ"]]},"E53D7240-220D-58E3-9E84-9D8CC5D5161C":{"t":"يا عَمرُو قَدْ أعْجَبْتني منْ صَاحِبٍ","p":37,"s":"يا عمرو قد أعجبتني من صاحب","r":"436926","v":[["190342B2-BC1E-56EF-BD5C-161E4E633ABF","يا عَمرُو قَدْ أعْجَبْتني منْ صَاحِبٍ","حيناً تشجُّ وتارةً تأسوني"],["4B8B92C1-4934-55CD-ACF2-51080F2772D7","أمّا الفُؤادُ فَنَاصِحٌ فيما بدا","والقولُ قولُ احمقِ المجنونِ"],["8F248F62-215F-5189-86EA-51E2CE1269F2","وإذا أقومُ بخطبةٍ ترضى بها","وإذا أوقمُ بخطبةٍ تخزيني"]]},"772BA472-C51F-56BF-874F-17F9206EB904":{"t":"يقولُ ليَ الحدَّادُ وهوَ يقودني","p":37,"s":"يقول لي الحداد وهو يقودني","r":"436938","v":[["4EF2C4DB-42BD-5ADC-96C5-D6AA50B18CE3","يقولُ ليَ الحدَّادُ وهوَ يقودني","إلى السِّجن: لا تجزعْ فما بك منْ باسِ"],["33B902B1-B772-5B28-A946-FD8037038C39","...........","وتتركُ عذري وهو أضحى من الشمس"]]}}}