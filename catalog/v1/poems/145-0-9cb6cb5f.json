{"v":1,"poems":{"E2AA62D7-62C4-5EB7-ABEC-04BF935575A4":{"t":"أبشر فقد سفر الثرى عن بشرهِ","p":145,"s":"أبشر فقد سفر الثرى عن بشره","r":"447489","v":[["7D625E7A-164A-51C3-B2D1-5E2095AFE29D","أبشر فقد سفر الثرى عن بشرهِ","وأتاك ينشرُ ما طوى من نشرهِ"],["E6E1F57F-F2A8-5304-82F8-96A972120E60","متحصناً من حسنهِ في معقلٍ","عقلَ العيون على رعايةِ زهرهِ"],["CED21243-FAE0-567A-B873-C50E4DE456A1","فضَّ الربيع ختامه فبدا لنا","ما كان من سرّائه في سرّهِ"],["D0DBF9EE-FFDB-56A9-96AF-869883BCF8B2","من بعد ما سحبَ السحابُ ذيوله","فيه ودرَّ عليه أَنفَس دُرّهِ"],["7A3A3DED-4676-5EDE-87ED-2250CE307914","فأجِل جفونكَ فيه تجلُ صَداً","بها لولا انبراءُ جماله لم تبرهِ"],["B1694564-7A46-5F59-8D75-A4846E2F3CA4","واشكُر لآذارٍ بدائع ما ترى","من حسنِ منظره جماله لم تبرهِ"],["59563E0A-E6B5-5E70-8CF0-DCF1525FAABF","واشكُر لآذارٍ بدائع ما ترى","من حسن منظره النضير وخُبرهِ"],["FEA9BAD2-F0A2-537F-9D4A-87EB07E64356","شهرٌ كأن الحاجب بن محمد","ألقى عليه مسحةً من بشرهِ"],["C4EFE460-BD03-55E3-A99C-780CF443A653","ملكٌ تملّكَ رقّنا بمكارمٍ","جعلت له غفر النجوم كعفرهِ"],["774FA399-ACA7-5455-A92F-FBF7BFBB4663","لا زال خطبُ زمانه في اسرِهِ","فلقد رأيتُ به هوايَ بأسرهِ"]]},"A0AA157C-05AA-56DA-B7FD-53D150D77388":{"t":"أرى الباقلاَء الباقل اللَّون لابساً","p":145,"s":"أرى الباقلاء الباقل اللون لابسا","r":"447482","v":[["AE244437-4182-525B-B430-62658ACED135","أرى الباقلاَء الباقل اللَّون لابساً","برودَ سماءٍ مِن سحائبها غُذي"],["B35B7A64-0A6B-510E-AA0F-22CE3C9CD568","ترى نَورَهُ يلتاحُ في ورقاتهِ","كبُلق جيادٍ في جِلال زُمرُّذِ"]]},"63BFB7C4-34A5-5CC3-B38E-05FBE11EED7B":{"t":"أمّا البنفسجُ فهو يشهدُ أنّهُ","p":145,"s":"أما البنفسج فهو يشهد أنه","r":"447494","v":[["765F7D5E-FB51-553E-BAEF-0760F75012B0","أمّا البنفسجُ فهو يشهدُ أنّهُ","مُتذمّمٌ ممّا جنى متنصّلُ"],["2CED6736-8A73-53FA-8BD7-40251F4FE3D3","متبرىءٌ من بيعةِ الوردِ التي","لم يَبرَ منها داؤهُ المتأصّلُ"],["E77E8415-3A65-53D7-BE15-4DDE942C14DC","متبيّن فضلَ البهارِ وعالمُ","أنَّ البهارَ هو المليكُ الأفضلُ"]]},"88FD5F15-CD44-5D3E-9EE9-DE100E7F8590":{"t":"أَشهدَ الأقحوانُ أنَّ جناهُ","p":145,"s":"أشهد الأقحوان أن جناه","r":"447476","v":[["474A1F53-1BFF-56D4-9EB9-D63FA4D2EC4A","أَشهدَ الأقحوانُ أنَّ جناهُ","كافرٌ بالذي سواهُ جناهُ"],["8B30C433-D3E7-5A71-AC57-EC67216F5E2A","قائلٌ قولَ من تبَّرأَ قِدماً","مِن هوى مَن قضى عليهِ هواهُ"],["B139891D-17FE-5E84-A7C7-6451AE1E7EC4","إنَّ نَورَ الرُّبى عبيدٌ وكُلٌّ","للبهارِ البهيّ يقضي وَلاهُ"]]},"B87280F2-E0BE-59A3-A77A-03678CC74B09":{"t":"أَشهدَ الخيريُّ أَنَّ الخير في","p":145,"s":"أشهد الخيري أن الخير في","r":"447495","v":[["55435AE9-8C55-50AC-8EB0-5C4105A0490F","أَشهدَ الخيريُّ أَنَّ الخير في","نقضِ ما اخطأَ فيه أولا"],["EF07825F-7BA5-5A0E-9C90-CBCE71E9A72A","موقناً أَن البهارَ المرتضى","بَهرَ الاملاكَ حالاً وحُلا"],["F6C9DA13-9525-5992-8684-EDF991DFAA00","فهوَ الموقظُ انوارَ الرُّبا","من سناتٍ فيها البِلا"]]},"72E666E9-1E5F-5274-A034-B51989BA12BA":{"t":"أَشهدَ النّرجسُ أَشهادَ مُحق","p":145,"s":"أشهد النرجس أشهاد محق","r":"447492","v":[["41995E9D-A50B-55B3-BE59-5F3C38DB7F68","أَشهدَ النّرجسُ أَشهادَ مُحق","أَنَّ بدرَ الوردِ في المُلكِ مُحق"],["5E39CE7C-6582-52FA-ADA0-942A958512A9","ورأى أنّ البهارَ المُجتلى","في سماءِ الحُسنِ بالمُلكِ أَحق"],["CCF056D4-91A1-5268-A0DC-2647A4A959F9","فمتى كُذّبَ قولٌ أَبداً","قيلَ في قولتهِ هذي صَدَق"]]},"07708CE0-AB52-5458-9C8A-919B88D7516A":{"t":"إنّما الوردُ في ذُرى شجراتِه","p":145,"s":"إنما الورد في ذرى شجراته","r":"447478","v":[["7BCBA6D4-0F97-5194-82C3-F4E08B320463","إنّما الوردُ في ذُرى شجراتِه","كأجَلّ الملوكِ في هَيئاتِه"],["A85AA908-DE6D-5AD6-99E5-8914C3DA6F9F","رائقٌ منظراً وخُبراً وفدُّ","في حُلاهُ التي حَلَت وصفاته"],["6E34B265-3F47-5474-9E17-84C63574E09F","نفحة المِسكِ من شذا نفحاته","خجَلُ الخدّ من سنا خَجَلاتِه"],["20067A75-1882-54BC-8953-1CDEEE5D2472","مُزجت حُمرةُ اليواقيتِ بالدُّ","رَ فجاءت بهِ على حَسبِ ذاتِه"],["283EDDFB-A55D-59E2-BB3E-6C508BCB7A09","مثلما جاء من سماحٍ وبأسٍ","خُلقُ الحميريّ سُمّ عُداتِه"],["54226EC3-AACE-5A7F-BF3E-A6FE103914C3","إن يعِد فالوفاءُ حتمٌ عليهِ","فرضُهُ في صِلاته كَصَلاتِه"]]},"708210F8-EC72-5789-AFEF-C2F848772544":{"t":"اصفرُ الخيريّ يشهد","p":145,"s":"اصفر الخيري يشهد","r":"447480","v":[["EFE81E87-2535-542D-BB15-FE8E009FF36D","اصفرُ الخيريّ يشهد","أَنّ عقدَ الوردِ قد رُد"],["F8D4FDE9-5663-5E2E-90CC-210CB7D0763C","ويرى أنَّ البهارَ ال","مُنتفى اغلى وامجِد"],["B1A16A67-F70F-5E2C-98F7-AFC1DDF0AA94","ملكٌ يقظانُ يأتي","وصُنوفُ النَّورِ هُجَّد"]]},"B2E554D4-C9D1-5D0B-8511-6051428AD2E6":{"t":"انظر إلى النهر واعجب","p":145,"s":"انظر إلى النهر واعجب","r":"447491","v":[["E4EC17AE-F035-5692-A34E-33F0DAC4D62A","انظر إلى النهر واعجب","لحسنِ مرآه وأَرضَه"],["68ADF8C0-1F3C-5CB8-A25F-A79159111849","قد حلّ بين رياضٍ","من النواوير غضّه"],["8EB40B5D-DFD0-5A03-A448-F1013B139949","فيها بهارٌ بهيُّ","بدا فزين أَرضه"],["43EF5DEE-D15E-5597-9C36-4887BE22E5B2","كأنّه جِيدُ تِبرٍ","يلوح في طوقِ فضه"],["E32B9204-E997-5FF2-909A-A66100E40B63","ونرجسٌ مثل لون المهجور","فارقَ غمضَه"],["B9306410-6FDB-5E95-95DA-2A007D7A93C4","واقحوانٌ أَنيقٌ","برودُهُ مُبيَضّه"],["5241D1F9-C71E-5F60-A351-04537420272C","قد طرَّزَتها بتبرٍ","عينُ الندى المرفَضَّه"],["5EE326C0-03EC-5BA2-BC27-5B5C83F852F1","وباقلاّءٌ قد أبدى","بنَوره الحسنَ مَحضَه"],["A1A45A43-4E93-5D61-9AB9-BC593377F6FD","كأنما النّهر أُفق","السماء عانقَ أَرضَه"],["B85D1367-943E-5836-96E7-A4F258C7E3AC","وقد كسا عُدوَتيهِ","من الأزاهر مَخضَه"],["6A1F6341-5F55-53C1-9814-A0C4E8E02B9A","كما ابن عبّادن النّد","بُ قد كسا الصون عرضه"],["51A08B88-7EAE-5466-94BB-78FD2BE38B74","سَمحٌ على المال فظٌّ","دأباً يجدّد فَضَّه"],["4FF21BF8-D2EB-5809-AAE5-EFC008ED6F24","له من الجاهِ حظٌّ","على التواضُع عَضَّه"]]},"80B70AF7-BAA9-5238-82BA-D0D922FCCE24":{"t":"بكتِ السماءُ فأضحكت سنَّ الثرى","p":145,"s":"بكت السماء فأضحكت سن الثرى","r":"447484","v":[["5BE60B6F-9D36-5FE9-AAC5-E56ADF03F91E","بكتِ السماءُ فأضحكت سنَّ الثرى","بمدامعٍ نظمت عليه جوهرا"],["DBC9786A-6E94-5B65-9A0B-064AA7A78D18","فكأنها خرقاء تنثر عِقدَها","وكأنه مُستغنم أن يُنثرا"],["A1E08384-377C-56FF-9CAC-44BD67212E0A","عكفت يداه علىنظام فريده","وجمانه فرداً لذاك مثمراً"],["056F6C5C-1AFF-5782-8D09-E9626267BE46","واعاده ابهى لطرف منظراً","واعدّه اذكى لانف مَخبَرا"],["6055A6DD-E38F-58AF-9526-D9DFDF9F3206","فانظر محاسن للربيع تبرّجت","لولا الربيعُ لما تجلّت للورى"]]},"080487EC-C5C5-5AD7-A705-A866EF643614":{"t":"حمامٌ بلحظك قد حُمَّ لي","p":145,"s":"حمام بلحظك قد حم لي","r":"447497","v":[["BEE44F82-CC69-5EA8-BE95-4BA98ECEB328","حمامٌ بلحظك قد حُمَّ لي","فما زال يهدي إلى مقتلي"],["88D8D3CA-A7A0-5094-B471-64006EAA1D19","وإن لم تغثني بمعنى الحياة","من ريق مبسمك السلسلِ"],["7C2F3CFC-452A-508D-BB3E-EDE1BA6C23FE","فها أنا قاض بداء الهوى","وقاضي جمالك لم يعدلِ"],["CA67E47A-6C57-5C2F-828D-35403844494C","فيا ليت قبري حيث الهوى","فاكرِم بذلك من منزلِ"],["7749E146-6EED-5019-B854-EBE1873ED11A","عسى من تلفتُ بحبي له","يرقّ على ذي بلاءٍ بلي"],["96979571-8012-5655-AA33-340369E658EC","فإن جاد بالوصل بعد الوفاةِ","رجعتُ إلى عيشي الأولِ"],["1D4EE677-CC5A-55B7-B0DB-732375AE9D98","فيا صاحبيَّ هناك احفرا","ولا تحفرا لي بقُطرَ بُّلِ"],["F3857546-6003-58B9-A2EC-F37EB1E676EA","إذا ما أدرت كؤوس الهوى","ففي شربها لستُ بالمؤتلِ"],["4EA22A97-78F4-5887-8838-522C0845CA41","صدام تعتق بالناظرين","وتلك تعتّق بالأرجلِ"]]},"2A594DCA-502B-5E25-90FE-C20F293A2853":{"t":"رياضٌ يُحيّيها الحَيا بانسكابهِ","p":145,"s":"رياض يحييها الحيا بانسكابه","r":"447487","v":[["6AC2AEFA-3B1A-56C1-A1DD-5B429A89A55E","رياضٌ يُحيّيها الحَيا بانسكابهِ","فَتسفِر للنُّظّار عن منظر نضرِ"],["301D2278-8C06-50FF-B16F-D7F3181A3376","فيها الشقائقُ خِلتَها","شعور العذارى لَحنَ في الخُمر الحُمرِ"]]},"59D04487-B680-576B-A72E-BD462B6054F0":{"t":"فالأرض في بردةٍ من يانعِ الزّهرِ","p":145,"s":"فالأرض في بردة من يانع الزهر","r":"447486","v":[["ACE2AE23-1AB8-5F63-94FE-2940B926F765","فالأرض في بردةٍ من يانعِ الزّهرِ","تُزري إذا قِستها بالوشى والحِبَرِ"],["3DA40DF7-EE55-588A-92F9-F2C03514FD7A","قد احكمتها أكف المزن واكفةً","وطرّزتَها بما تُهمي من الدّررِ"],["A6DF8507-04B1-5A08-85AB-957CE51F7F5F","تبرجت فسبت منا العيون هوى","وفتنةً بعد طولِ السِّتر والخَفَرِ"]]},"AB7C8136-A538-5D2A-9B35-10D1AF8BCBB1":{"t":"كأنّ نَورَ الكتّانِ حين بدا","p":145,"s":"كأن نور الكتان حين بدا","r":"447490","v":[["C120ACC3-CC17-565D-9BC1-1A2C591F8D09","كأنّ نَورَ الكتّانِ حين بدا","وقد جلا حُسنُهُ صدا الأَنفُس"],["1242367A-F690-5546-8A51-FF21BD038B72","اكفُّ فيروزَجٍ معاصمُها","قد سترتُهنَّ خُضرةُ الملبَس"],["EE893A07-311F-5694-8A66-4CD864302D13","أولا فزرقُ الياقوتِ قد وضعت","على بساطٍ تروقُ من سُندس"]]},"D51FF0DA-3A84-5CDF-A2BA-2D7890CD0CD3":{"t":"نهارُ خيريكَ في ليلهِ","p":145,"s":"نهار خيريك في ليله","r":"447477","v":[["FE48C669-230A-56D5-82BD-B0ACF37C302D","نهارُ خيريكَ في ليلهِ","كذلكَ اللَيلُ نهارُ الأَديب"],["DC08C018-12DF-5DA8-9C49-85024AC172C5","يَنمُّ فيهِ وينامُ الضُّحى","تصاوناً عن كلِّ امرٍ مَغيب"],["273A7025-EF0F-55CE-91BD-A26F637BF209","كأَنَّما اللّيلُ حبيبٌ لهُ","فهو إذا حلَّ اكتسى كل طيب"],["6A41061C-3454-5602-BC61-24157B373495","كأنَّما الصُّبحُ رقيبٌ لهُ","فيرعوي عند طلوعِ الرَّقيب"]]},"D19D3A3C-A4DA-5C72-9728-EB7816605C62":{"t":"وجُلّنارٍ تَبدّى","p":145,"s":"وجلنار تبدى","r":"447485","v":[["8045693C-3C91-5F70-9377-060F704C7758","وجُلّنارٍ تَبدّى","يختال في جُلِ نارِ"],["D3630689-5C38-5189-B2B3-36E199541E1D","احلى حُلى من جميع","الأنوارِ والازهارِ"],["F66C5499-958E-55F6-B8E2-41F2A245EA5C","حكى خدود العذارى","قد شُرّبت باحمرارِ"],["1A89D8BC-DA04-53CC-8992-9B40934E9271","وخّمشت باكُفّ","الاحاظ والابصارِ"]]},"C9693C8F-3C42-52D2-8495-48E72D39663B":{"t":"وخُرّمٍ حُلوِ الحُلى","p":145,"s":"وخرم حلو الحلى","r":"447479","v":[["5E5BF90A-3321-50BB-99E8-A18318F67A65","وخُرّمٍ حُلوِ الحُلى","يبدو لعَينَي مَن لَمَح"],["83E07E95-0A2F-50D7-AE0F-F061D50A53E1","تلوُّناً ومنظراً","كأنّهُ قوسُ قُزَح"]]},"BF201E4F-CCFF-50DA-B036-FF102D3FEFE4":{"t":"وروضةٍ رَضيت عن","p":145,"s":"وروضة رضيت عن","r":"447488","v":[["6EC54431-C334-5649-834D-C18AC5C4724A","وروضةٍ رَضيت عن","صوبِ الحيا المُستَمّرِ"],["518ADC5B-CD77-57AB-81C0-F09C949AF628","فأظهرت نَورَ نَيلو","فَرٍ مُنيرٍ أَغرِّ"],["18B1AAF9-C78F-5913-BD4A-A5A6969DB9C0","كمِحبَرٍ من لُجينٍ","فيهِ بقيّةٌ حِبرِ"]]},"FCC77197-E8CC-57B6-B5C8-12E3EA1C02A4":{"t":"وروضٍ أَريض لم يزل يغتذي بما","p":145,"s":"وروض أريض لم يزل يغتذي بما","r":"447481","v":[["A835F12E-E129-55E2-9B12-D9077A204B86","وروضٍ أَريض لم يزل يغتذي بما","يروحُ عليهِ من سحابٍ ويغتدي"],["59DBBF17-FCE8-5FE0-87B9-3E2FEF745FD8","بدا النرجسُ المُصفرُّ فيه مُباهياً","بلونٍ كلون المُستهامِ المُسهَّدِ"],["ABC6EB0E-9131-5DC8-B4B6-EDC2990CF24C","ترى كُلَّ نَورٍ منهُ فوقَ قضيبهِ","كلمَّة تِبرٍ فوق جيدِ زَبرجَدِ"],["E7C307F7-620F-5215-A0C5-AB9CE12B5DAA","إذا ما سرى منهُ نسيمٌ لوالِهٍ","سرى عنه جلبابُ الجوى المتوقدِ"],["90B78AAC-8F39-5530-988A-8619C4B44DC6","حكى منظراً نضراً وخُبراً خلائق","النَّجيب أبي عمرو سليلِ مُحمّدِ"],["2304DEC6-99C2-59B2-AB5B-482F518B5352","فداهُ عِداهُ كم لهُ مِن فضيلةٍ","وفضلِ ندىِّ يُغني به كلُ مُجتدي"]]},"4566B51F-B7A5-51EC-9E33-BC77F18A920D":{"t":"وسوسنٍ يتهادى للأنس","p":145,"s":"وسوسن يتهادى للأنس","r":"447499","v":[["E3E2BE13-621D-5027-A2B6-02213B6D7FB4","وسوسنٍ يتهادى","للأنس بالراحتين"],["7B89391C-44FE-5085-84C6-E2596A79711F","نعمَ المواصلُ لو لم","يُعد بنأيٍ وبَينِ"],["1DC41A6F-86A6-5FFD-861B-A48DDC66F469","كأنما خلقُهُ الفد","خَسَّةٌ من لُجينِ"],["D0A73DDD-D227-524F-97A2-03AAC3DD0A2B","أو أنمُلٌ بضَّةٌ ما","تركّبت في يَدينِ"],["F2F4858E-9631-5950-8B61-050A0F52E153","وبينَها حارسٌ لا","ينامُ طرفةَ عَينِ"],["60D6120D-5E2C-5760-85A9-D7FAA5ABA41E","علا واشرفَ منها","على جمالٍ وزَينِ"],["78ECD308-00AA-5B6B-8120-1EBF923B3860","كما علا الحاجبُ","المُنتقى على الشّعريينِ"],["06474CE0-1196-5174-A4E2-784039EA7142","مَلكٌ به حالَ دهري","بينَ الخُطوبِ وبَيني"]]},"98BCB31C-6EFD-5374-B434-E3D49599765A":{"t":"وقهوةٍ لا يجيدها مبصر","p":145,"s":"وقهوة لا يجيدها مبصر","r":"447483","v":[["3106964C-9553-5D4F-8180-FDD1D05CE80A","وقهوةٍ لا يجيدها مبصر","راقت ورقَت في أعيُن النُظَر"],["E98D5D72-FF3E-5D1D-BDCA-430E9E9BB893","إذا رنت فالسرور مبتسمٌ","وإن نأت فالسرور مستعبر"],["8A8B5A44-D13C-56ED-B5C8-82ABA7B8425C","كأنها والحباب يحجُبها","بحر من التبر يقذف الجوهر"],["E1122F99-314A-580C-8173-27C0BD3949C6","غنيتُ عنها فلستُ اقربها","بناظرٍ منهُ يُسكر المُسكِر"]]},"8E2A86F6-502C-54CA-B62C-136EABF46EAD":{"t":"وكأسٍ لها كيسٌ على اللُّبِ والعقلِ","p":145,"s":"وكأس لها كيس على اللب والعقل","r":"447496","v":[["65DF321C-ADB2-53A8-A592-4D57A84C0AD3","وكأسٍ لها كيسٌ على اللُّبِ والعقلِ","شمول تُريك الأُنس مجتمع الشمل"],["57AA685F-4603-58DC-B8A9-AC7D3A03071C","كأن حباب الماء في جنباتها","دروع لجين قد جلتها يدُ الصّقلِ"],["720C7BD9-7CBB-5FF2-9369-10FB0863E0DB","تزيدُ ذوي الألباب فضلاً ولم تزل","تُديل بطبع الجود من طَبَع البخلِ"],["04C480E4-B685-560C-B916-E826A7F5134D","غنيتُ بمن اهواهُ عن نشواتها","فمن طرفه خمري ومن ريقهِ نُقلي"]]},"A3DB849F-C47B-5D1E-87B7-952797DC1BB1":{"t":"يا من تأَزّر بالمكارمِ وارتدى","p":145,"s":"يا من تأزر بالمكارم وارتدى","r":"447493","v":[["56E283CF-91B3-5735-BE61-9A43CDF6119E","يا من تأَزّر بالمكارمِ وارتدى","بالمجدِ والفضلِ الرفيع الفائِق"],["B3A9B0E1-E270-5520-AECF-7A4BF2134A2D","انظُر إلى خدّ الربيع مركباً","في وجه هذا المهرجان الرائقِ"],["EE46F728-2972-52B6-A35C-93184D9CEBE1","وردٌ تقدّم اذ تأخرّ واغتدى","في الحسن والإحسان أول سابق"],["3AF5909A-2496-554B-B2DE-10031C7428EF","وافاكَ مشتملاً بثوبِ حيائهِ","خجلاً لأن حيائه آخرَ لاحق"]]},"713E8496-3D84-57A4-B996-4B1838629A27":{"t":"يا من حبوت بودّهِ حوباءِ","p":145,"s":"يا من حبوت بوده حوباء","r":"447475","v":[["9922C958-26BF-5CF7-819F-8A0E2C9CF81B","يا من حبوت بودّهِ حوباءِ","وهي الفداءُ له من الأسواءِ"],["AC93EE5D-6C7C-558E-A1C4-5B84BDAF47AD","وصل المطّيبُ مُعرباً عن طيبِ","من اهداهُ مكتبئاً من الاهداءِ"],["09FE7A22-822F-56CC-B17A-D7393B94C122","أظميتهُ من بعدما أرويتهُ","بِمُدامة فيهادواءُ الدّاءِ"],["F2AF24C9-D7D2-5396-BAD5-7C1CBFDDCCAC","ما كان اشهرَ طيبَه لو لم يكن","متُستّراً بالقطعة الغرّاء"],["85DBEF0B-D4D4-5BE8-B524-A60CAA1430E6","أربى عليه نظمُك الحُلوُ الحُلى","فانحطَّ بعد الرتبة العلياءِ"],["A1B8D1F0-BA3E-5471-9CDE-A154D5E1A94E","إن كان نورُ الآسِ في وَرَقاته","نوراً بدا في ليلةٍ ظلماءِ"],["38F8B6C4-D128-5884-B671-4BC1C2AD2D0F","فجمالُ خلقِك حين ينظم عقدهِ","كالبدر ينظم أنجم الجوزاء"]]},"F795EFC4-2991-50C1-B2D4-39C665D93C5E":{"t":"يا من يذم خلائق النّمامِ","p":145,"s":"يا من يذم خلائق النمام","r":"447498","v":[["1F004309-A3A0-5ECA-90F5-87DACFF837D5","يا من يذم خلائق النّمامِ","ويحطُّهُ عن خطّه الاكرامِ"],["1965CE66-98AA-5309-9F36-C954A3D14130","فدك اتئد عن لومهِ جهلاً به","فجمالُه زارٍ على اللُّوامِ"],["F50B6D4C-4262-5D2C-B451-0974D36A2F0A","هو أشهرُ الخيريّ حُسناً فاحبُهُ","من بينهِ بتحيّةٍ وسلامِ"],["AFA0E32A-4CA1-5AFB-A2EF-C65E2A49331B","متنزه عن أن يُرى مُستهتراً","غلا إذا اكتحل الورى بمنامِ"],["3E924136-6D8B-5DA5-AC40-D4B285F21BC9","مستطرفٌ في خلقه مستظرفٌ","في خُلقه مُستحسَنِ أَلالمامِ"],["74B3964C-96B9-5D55-9C3B-4768551F5487","لم يرض إلا المِسكُ مَسكاً جِسمُهُ","وبهِ يبوح إليكَ في الأظلامِ"],["77B675EA-5356-533E-9E83-808C08A014E9","والمنتمي أبداً إليه قُصارُهُ","في الفضل أن يُعى إلى النمّامِ"],["68F30989-70FB-534D-9767-D6553ED7BC43","إصفر من حسدٍ له وكآبةٍ","لما شآهُ بحُسنه البسّامِ"],["DAED722B-9441-5A11-AA88-E9F8A194F4BE","أيُقاسُ مٌنفردٌ بظرفٍ مُعجز","بمشاركٍ أخلاق نور"],["9E4E0228-387B-5C83-BBEF-6DD2CF63C357","لو كانت الشمس المنيرةُ سرمداً","لم تُلقَ بالاجلال والاعظام"]]}}}