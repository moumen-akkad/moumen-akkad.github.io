{"v":1,"poems":{"802CA98C-C9A3-5439-879E-9F3559017ACC":{"t":"ويومِ دجنٍ معلمِ البردينِ","p":191,"s":"ويوم دجن معلم البردين","r":"445535","v":[["ECDF9C91-523C-5C94-AE05-F26EFCC3C0C8","ويومِ دجنٍ معلمِ البردينِ،","سماؤهُ بالغيمِ في لونينِ"],["137270C8-B3BA-5EFB-8293-CF5087DF6803","كأنّها، وقد بدتْ للعينِ،","فيروزجٌ يلمعُ في لونينِ"],["CDA356CF-5BAC-5A6C-A112-56C657146EC7","قضيتُ فيهِ بالسرورِ ديني،","وسرتُ أفلي مفرقَ الشعبينِ"],["BD0F9F99-D3CD-51A8-B9F5-64B99953F65D","بأدهَمٍ مُحَجَّلِ الرّجلَينِ،","سبطِ الأديمِ مفلقِ اليدينِ"],["164812B7-C344-52E8-8ED2-973BD1DDD93A","خصبِ العَطاةِ ماحِلِ الرُّسغَينِ؛","وسربِ وحشٍ مذ بدا لعيني"],["DAF6A804-3382-5C2D-896E-294037E0B1F1","عارضتهُ في منتهى السفحينِ","بأرقطٍ مخططِ الأذنينِ"],["697CD9C7-8C7C-573B-811F-A552A0C1C830","ناقي الجبينِ أهرتِ الشدقين،","أفطسَ سَبَطِ الشّعرِ صافي العَين"],["519DD19B-5FF0-5690-B764-99C3E50FAF14","يَنظُرُ في اللّيلِ بجَمرتَيَنِ،","ذي كَحَلٍ سالَ من العَينَينِ"],["5FDEED39-E087-5F68-96EE-27A2ABF8F369","فخطّ لامينِ على الخدينِ،","محددِ النابينِ والظفرينِ"],["C1CA40A1-4EA0-50E5-AA96-38D76ADD141C","كأنّما يكشرُ عن نصلينِ،","ليسَ لها عَهدٌ بضَربِ قَينِ"],["9CDB8998-083D-5550-A8A9-2DF822AD9B80","رَقيقِ لحمِ الزّندِ والسّاقَينِ،","ذي ذنبٍ أملسَ غيرِ شينِ"],["2C8EC6AD-59D5-5B9A-AFF8-59F28CCB38E9","فخاتلَ السربَ بخطوتينِ،","وأردَفَ الخَطَو بوَثبَتَينِ"],["3087042E-3A18-518E-997B-DB2CA80D2C54","فكانَ فيها كغُرابِ البَينِ،","فرقها قبلَ بلوغِ الحينِ"],["AF0ED842-2F6E-533B-B53A-134345B13E12","ونالَ منها عفرَ المَتنَينِ،","أجيَدَ مَصقولِ الإهابِ زَينِ"],["C3EA118E-06DF-539C-8B7B-873372586779","جدلهُ في ملتقَى الصفينِ،","ولم يَحُل ما بَينَهُ وبَيني"],["D9BA22E9-C342-5EE7-B70C-824ACB7CEB8A","نِلتُ بمُهري وبه كفلَينِ،","إنهما للصيدِ عدتينِ"]]},"0B63FB96-0261-5CAE-87DF-D1DD427C6E71":{"t":"وَدِّعُوني من قَبلِ تَوديعِ حِبّي","p":191,"s":"ودعوني من قبل توديع حبي","r":"445730","v":[["ACF7AD48-1EBD-5F24-B9D9-DB5AE7425F79","وَدِّعُوني من قَبلِ تَوديعِ حِبّي،","أنا منهُ أحقّ بالتوديعِ"],["BC0FB45F-F2B7-5425-AB68-B0354AD141FE","ذاكَ يُرجَى لهُ الرّجوعُ، ولا يُطـ","ـمعُ، إنْ متُّ بعدَه، برجوعي"]]},"CC026932-3C87-5758-A3CC-1000804BECA8":{"t":"وَرَدَ الرَّبيعُ فمرحَباً بوُرُودِهِ","p":191,"s":"ورد الربيع فمرحبا بوروده","r":"445887","v":[["D6B297A0-0A8B-51E6-8AC5-A017F192C58B","وَرَدَ الرَّبيعُ، فمرحَباً بوُرُودِهِ،","وبنُورِ بَهجَتِهِ، ونَوْرِ وُرُودِهِ"],["B5D1E66B-ACDD-5731-A397-B706D0A6CAE6","وبحُسنِ مَنظَرِهِ وطيبِ نَسيمِهِ،","وأنيقِ ملبسهِ ووشي برودهِ"],["68CDB2B9-5160-52E9-AD7E-9C004FC4681C","فصلٌ، إذا افتخرَ الزمانُ، فإنهُ","إنسانُ مُقلَتِهِ، وبَيتُ قَصيدِهِ"],["BA93C913-8368-52D5-8125-6F6F7693E965","يُغني المِزاجَ عن العِلاجِ نَسيمُهُ،","باللطفِ عندَ هبوبهِ وركودهِ"],["7D27793E-363C-5BA7-89A6-6432B1909C3B","يا حبذا أزهارهُ وثمارهُ،","ونباتُ ناجمهِ، وحبُّ حصيدهِ"],["08195005-C9FF-5D81-933C-9953151476B6","وتَجاوُبُ الأطيارِ في أشجارِهِ،","كَبَناتِ مَعبَدَ في مَواجِبِ عُودِهِ"],["3FA14192-4FA5-59A7-B5B0-8F90DBFF7CD9","والغصنُ قد كُسِيَ الغَلائلَ، بعدَما","أخَذَتْ يَدا كانونَ في تَجرِيدِهِ"],["65946EC4-6E45-5F25-872D-EF238C377E93","نالَ الصِّبَا بعدَ المَشيبِ، وقد جَرَى","ماءُ الشبيبةِ في منابتِ عودهِ"],["3C091A5C-E8A7-5FCA-9A4B-D0BB50A41647","والوردُ في أعلى الغصونِ، كأنهُ","ملكٌ تحفّ بهِ سراةُ جنودهِ"],["62282CA7-7A89-5BBF-845F-66AC12872A46","وكأنما القداحُ سمطُ لآلىءٍ،","هو للقضيبِ قلادةٌ في جيدهِد"],["8AFF8D21-4B05-57ED-A958-E2DBA9BE3AFA","والياسَمينُ كعاشِقٍ قد شَفّهُ","جورُ الحبيبِ بهجرهِ وصدودهِ"],["86E9C1C4-7609-5199-B45E-99DEBE63AF84","وانظرْ لنرجسهِ الشهيّ كأنهُ","طرفٌ تنبيهَ بعدَ طولِ هجودهِ"],["80EF0801-3A73-5B07-B8F0-5D07B5379494","واعجبْ لأذريونهِ وبهارهِ،","كالتبر يزهو باختلافِ نقودهِ"],["13405E50-38E6-5E47-9972-D65DE361E460","وانظُرْ إلى المَنظُومِ من مَنثُورِهِ،","متنوعاً بفصولهِ وعقودهِ"],["6A86EEA0-9AED-5D4D-86C9-E49C26B36F9B","أو ما ترى الغيمَ الرقيقَ، وما بدا","للعَينِ من أشكالِهِ وطُرُودِهِ"],["6CCCBFA8-6C52-54DB-9A9B-E40FEC8C5136","والسّحبُ تَعقُدُ في السّماءِ مآتماً،","والأرضُ في عُرسِ الزّمانِ وعيدِهِ"],["8FA5368D-86F4-5408-A67C-E82FEE35E4C5","ندبتْ فشقّ لها الشقيقُ جيوبهُ،","وازرَقّ سَوسَنُها للَطمِ خُدودِهِ"],["02609BF6-0DB0-5E6E-9435-AB729755E807","والماءُ في تيارِ دجلةَ مطلقٌ،","والجِسرُ في أصفادِهِ وقُيُودِهِ"],["28323E6C-A9F1-5162-BE59-A65E5E5704BF","والغيمُ يحكي الماءَ في جريانهِ،","والماءُ يحكي الغيمَ في تجعيدهِ"],["E05D9A4A-E47D-5CC1-BEEC-8FEA030C2031","فابكُرْ إلى رَوضٍ أنيقٍ ظِلُّهُ،","فالعيشُ بينَ بسيطهِ ومديدهِ"],["5C4EA910-3388-5E26-BADC-AE68566592DB","وإذا رأيتَ جَديدَ روضٍ ناضرٍ،","فارشفْ عتيقَ الراحِ فوقَ جديدهِ"],["4A2DA70E-F321-5BB2-90E4-21393F2FB1DC","من كفّ ذي هيفٍ يضاعفُ خلقُه","سُكرَ المُدامِ بشَدوِهِ ونَشيدِهِ"],["AC1EE849-07E6-54CB-B4F6-C3804B859F05","صافي الأديمِ تَرَى، إذا شاهَدتَهُ،","تِمثالَ شَخصِكَ في صَفاءِ خُدودِهِ"],["B2C10ED8-BA90-5D84-9086-CCE9655565DC","وإذا بَلَغتَ من المُدامَةِ غايَةً،","فأقلِلْ لتُذكي الفَهمَ بعدَ خُمودِهِ"],["B3A090D3-7D54-5231-BF4C-5EEA8EA8C2C4","إنّ المُدامَ، إذا تَزايَدَ حَدُّها","في الشّربِ، كان النّقصُ في محدودِهِ"]]},"631AB412-3E1F-5B25-AEAF-2766901ADEA1":{"t":"وَلائي لآلِ المُصطَفى عِقدُ مَذهَبي","p":191,"s":"ولائي لآل المصطفى عقد مذهبي","r":"445440","v":[["9E1A4C5E-3D50-5664-BAEE-6A30EE69D608","وَلائي لآلِ المُصطَفى عِقدُ مَذهَبي،","وقلبيَ منْ حبّ الصحابةِ مفعمُ"],["56630920-4AF4-5EBA-8533-7382901E43F0","وما أنا مِمّنْ يَستَجيزُ بحُبّهِمْ","مَسَبّةَ أقوامٍ علَيهِمْ تَقدّمُوا"],["F3C47C58-562B-560C-812A-23C42DC6C891","ولكنِنّي أُعطي الفَريقَينن حَقّهم،","وربّي بحالِ الأفضليّةِ أعلَمُ"],["46375946-B807-5FEC-896E-DA5CF49DBD3E","فمن شاءَ تعويجي، فإنّي معوجٌ،","ومَن شاءَ تَقويمي، فإنّي مُقَوَّمُ"]]},"6E36ED0C-FB00-5900-B7C8-AF0A33FBDAF8":{"t":"وَلَيلَةٍ خَرّقْتُ عن صُبحِها","p":191,"s":"وليلة خرقت عن صبحها","r":"445844","v":[["797696DF-EE13-567C-A1B4-25C98F4AAF6B","وَلَيلَةٍ خَرّقْتُ عن صُبحِها","جيباً، من الظلماءِ، مزرورا"],["940D4EB6-BF5C-5893-AFD9-7B3D72616992","شاهَدتُ بَدرَ التّمّ فيها، وقد","كَوّرَ شَمسَ الرّاحِ تَكويرَا"],["5F98FB37-9598-51B2-9BD7-DB41622E296A","بتنا بها نشربُ من قهوةٍ","قدرها الساقونَ تقديرَا"],["0A68FB84-CC7C-56BE-8265-132C8275E6BC","إن لم تكن أكوابُنا فضّةً","كانتْ قواريرَ قواريرَا"]]},"625D2770-D7BB-5AAE-BFD1-AC39F779AD51":{"t":"يا بدوراً تغيبُ تحتَ الترابِ","p":191,"s":"يا بدورا تغيب تحت التراب","r":"445633","v":[["B30FB00E-C401-5616-A97F-39F06B68EBC8","يا بدوراً تغيبُ تحتَ الترابِ،","وجبالاً تمرّ مرّ السحابِ"],["E913E504-AB90-59A8-A8B0-6E7D122DDB3F","إنّ في ذلكَ، اعتباراً وذكرى،","يَتَوَعّى بها ذَوو الألبابِ"],["96FEEDE7-CB0A-5DD3-8EFE-5F2AD92986E4","قلْ لصادي الآمالِ لا تردِ العيـ","ـشَ، فإنّ الحياةَ لمعُ سرابِ"],["03DF9447-BC82-5B9F-A58E-09D75AF24D90","أينَ رَبّ السّريرِ والجيزَةِ البَيْـ","ـضاء ذاتِ النخيلِ والأعنابِ"],["61E0EB3C-BB6A-583C-AF19-FF6EA8C8A683","عَرَصاتٌ كأنّهنّ سَماءٌ،","قد توارتْ شموسُها في الحجابِ"],["FF2F3338-177B-50ED-BA86-5AAB946CD95C","أينَ ربّ الآراءِ والرّتَبةِ العَلـ","ـياءِ، والماجدُ الرفيعُ الجنابِ"],["DC99A169-9A16-5D96-9799-4BC2E44D4BCD","والذي لَقّبوهُ بالأبلَجِ الوَ","هابِ طوراً، والعابسِ النهابِ"],["17EC9F21-6E50-5182-ACD2-CCA8EFFAEBA0","لَيثُ إبنا أُرتُقَ الملكُ المَنـ","ـصورُ، ربُّ الإحسانِ والأنسابِ"],["04A2682C-A373-546F-A4C1-FEA1DCB6A1BC","صاحبُ الرتبةِ التي نكصَ العا","لمُ من دونِها على الأعقابِ"],["CEBD88CD-F497-5E62-AC8D-C4679CC0DE14","ومُجَلّي لَبسَ الأمورِ، إذا بَر","قَعَ قُبحُ الخَطا وجوهَ الصّوابِ"],["A939BD17-1F99-557D-B690-3C34136FA8DF","حازَ حِلمَ الكُهولِ طِفلاً وأُعطي","ورعَ الشيبِ في أوانِ الشبابِ"],["96E3EE1A-93D9-50B4-9409-F0499FF672F4","جلّ عن أن تقبلَ الناسُ كفيـ","ـهِ، فكانَ التقبيلُ للاعتابِ"],["C6138617-8FB7-5E70-81C9-CB390B0C29B3","لم تُرَنّحْ أعطافَهُ نَشوةُ المُلـ","ـكِ، ولا يزدهيهِ فرطُ أعتجابِ"],["4BB13C24-2E8B-5CAE-8F8C-28FFFE4C2193","رافعُ النّارِ بالبقاعِ، إذا أخْـ","ـمدَ بردُ الشتاءِ صوتَ الكلابِ"],["15BE82F7-9A08-5278-9D9A-469D5D1BF01D","ومحيلُ العامِ المحيلِ، إذا اعتا","دَ لسانُ الفصيحِ نطقَ الذبابِ"],["895A0A5C-137C-5802-9A6A-4625652CB178","عَرَفوا رَبَعهُ، وقد أنْكِرَ الجُو","دُ، برَفعِ اللّوا ونَصبِ العِتابِ"],["B6CA6539-2605-5CFD-8C6D-1B26E30CCF7D","وقدورٍ بما حَوتْ راسيِاتٍ،","وجِفانٍ مَملُوّةٍ كالجَوابي"],["C44AED82-EDB3-5E12-9DE2-63060CE16FDE","ملكٌ أصبحَ الخلائقُ والأ","يامُ والأرضُ بعده في اضطرابِ"],["FE9AFF71-8E34-5692-9C4B-3DEFD33117BB","فاعتَبِرْ خُضرَةَ الرّياضِ تَجِدْها","أثرَ اللطمِ في خدودِ الروابي"],["B11D900F-0518-55B7-AA2E-5DEBC73651D6","حَمَلوهُ على الرّقابِ، وقد كا","نَ نَداهُ أطواقَ تلكَ الرّقابِ"],["EF860A40-F6E8-5520-A94B-D2D11F41D58F","ما أظنّ المَنونَ تَعلَمُ ماذا","قصفتْ بعدهُ من الأصلابِ"],["DDFD737F-8A9C-5C04-9FAA-6FEEB721CA49","يا رجيمَ الخطوبِ، فاسترقِ السمـ","ـعَ، فأُفقُ العُلَى بغَيرِ شِهابِ"],["998CC165-B6F9-5D6B-A207-F621C91C3FB1","فليَطُلْ، بعدَه على الدّهرِ عَتبي،","ربّ ذمٍّ ملقبٍ بعتابِ"],["C33E6B4E-F7BE-5BF8-9544-B6A540021190","أيّها الذّاهبُ الذي عرّضَ الأمـ","ـوالَ والنّاسَ بعدَهُ للذّهابِ"],["378D947D-ABB5-57C3-A1F2-CFF7BF4EED24","طارَ لبّ السماحِ، يومَ توفيـ","ـتَ، وشُقّتْ مَرائرُ الآدابِ"],["B751F8C8-7EDB-5E90-A64C-702275F758EC","وعلا في العلا عويلُ العوالي،","ونَحيبُ اليَراعِ والقِرضابِ"],["8807629A-AA74-5FAD-B584-318500CED7CC","لو يُرَدّ الرّدى بقوّةِ بأسٍ","لوَقَيناكَ في الأُمورِ الصّعَابِ"],["1D008E83-3965-5D63-972C-3167A93A2D5F","بأسودٍ بيضِ الوجوهِ، طوالِ الـ","ـباعِ، شُمِّ الأنوفِ، غُلبِ الرّقابِ"],["56D7DCE3-AD64-5980-A6B9-03FAE2EC1F45","تَرَكوا اللّهوَ للغُواةِ، وأفنَوا","عُمرَهم في كتائبٍ، أو كِتابِ"],["C27F61D4-7FFF-5612-AE00-60E7F2A10B3F","وجِيادٍ مثلِ العَقارِبِ نحوَ الـ","ـروعِ تسعى شوائلَ الأذنابِ"],["07056BA8-28E5-54A7-ADB0-A74B3AAAE40C","كلِّ طرفٍ مطهمٍ، سائلِ الغُـ","ـرةِ، جعدِ الرسغينِ، سبطِ الإهابِ"],["19FB6C98-BD60-5C39-8FB0-A4D83B8A2252","كنتَ ذُخراً لنا، لوَ أنّ المَنا","يا جنبتْ عن رفيعِ ذاكَ الجنابِ"],["8094D8E5-55C5-5D43-8C17-7E30D9EE26BC","لم أكنْ جازعاً، وأنت قَريبٌ،","لبُعادِ الأهلينَ والأنسابِ"],["482FA2D5-FC00-5865-8A43-B29D12C7391C","كانَ لي جُودُكَ العَميمُ أنيساً","في انفرادي، وموطناً في اغترابي"],["E887876C-D880-585A-9781-3629326AF798","ما بَقائي من بعدِ فقدِكَ، إلاّ","كبَقاءِ الرّياضِ بعدَ السّحاب"]]},"13019204-1042-5ACE-9D53-1D40FB253507":{"t":"يا بصيراً إلاذ بإبصارِ كتبي","p":191,"s":"يا بصيرا إلاذ بإبصار كتبي","r":"445967","v":[["3C2977BE-9FA8-52BF-A568-DD85967F8DB0","يا بصيراً إلاذ بإبصارِ كتبي،","وجَواداً إلاَّ برَدّ جَوابي"],["CBD2FF29-C947-5629-8FF4-C2728C65D921","ولو أنّي بلغتُ سؤلي من الدهـ","رِ لَوافَيتُهُ مكانَ الكِتابِ"]]},"AD55F2A0-AD81-52EE-8266-7AC7995BB837":{"t":"يا بَعيداً يَشتاقُهُ لحظُ عَيني","p":191,"s":"يا بعيدا يشتاقه لحظ عيني","r":"445603","v":[["F8DFCE8F-713D-5DD8-A897-6DC158C4528E","يا بَعيداً يَشتاقُهُ لحظُ عَيني،","وقريباً محلُّهُ في فؤادي"],["62784208-7EED-5279-90E8-F1056062A58C","تشتهي العينُ أن تراكَ ولو بـ","ـتُّ مريضاً وأنتَ من عوّادي"],["9129FD3C-8117-5FEE-BFB9-5B5480F18EB7","وتمنيتُ لو كتبتُ كتابي","أنّ إنسانَها مَكانَ المِدادِ"],["F6484E06-D112-5DE0-BF09-2CBB8F32E66F","لا تظنّ البعادَ يخلقُ عهدي،","أو تُحلّ الأيّامُ عَقدَ وِدادي"],["3A27E4AD-5A2E-5A8E-A16A-E5E8FE454574","أنتَ من مُهجتي مكانَ السّوَيدا","ءِ ومن مُقلَتي مكانَ السّوادِ"]]},"8B14B756-759E-5456-A3CC-929277B3AAFB":{"t":"يا بَياضَ البَياضِ! أنتَ من الأعـ","p":191,"s":"يا بياض البياض! أنت من الأعـ","r":"445607","v":[["995BE901-C28D-5C8E-80D9-D9DB2CBA145C","يا بَياضَ البَياضِ! أنتَ من الأعـ","ـينِ والقلبِ في سوادِ السوادِ"],["4673F51F-C39B-5A7F-A9E3-B42D7C20B4B1","طالَ شَوقِي إليكَ، والسرّ خافٍ","عن جميعِ الأنامِ، والشوقُ بادِ"],["AA17E385-40A6-54AF-A239-DFD0B2367D44","فلَئن سِرتُ عن حِماكَ وحالَ الـ","ـشّوقُ ما بَينَنا بغيرِ مُرادِ"],["21D4C31E-63EB-5BD8-B6CE-D57151668FB6","ما تَزَوّدتُ مُذ رَحلتُ سوى الهَـ","ـمّ، فلا تَجعَلَنه آخرَ زادي"]]},"F6872B77-2BCC-564C-85CD-FD16A69448AB":{"t":"يا جنةَ الحسنِ التي","p":191,"s":"يا جنة الحسن التي","r":"445696","v":[["CD67DF72-0370-5F7E-ACAD-979B00A8270A","يا جنةَ الحسنِ التي","خفتْ لدينا بالمكاره"],["9024F56A-3B3C-5868-894F-90816B7D4E3E","إنّي لوَجهِكِ عاشقٌ،","ولمنظرٍ الرقباءِ كارِه"]]},"C4310278-40B5-5420-9942-6603E3CC68B9":{"t":"يا حَبيبَ الحَبيب دِنهُ كما","p":191,"s":"يا حبيب الحبيب دنه كما","r":"445799","v":[["B062ACA2-8FC9-504F-8727-B08932CEF7F5","يا حَبيبَ الحَبيب دِنهُ كما","دانَ مُحبّيه من صُدودٍ وهَجرِ"],["ED03A0CF-03BC-5461-9F81-6E43F6292F6E","ثمّ مرْ طرفكَ الصحيحَ بأنْ","يأخُذَ من طَرفِهِ السّقيمِ بوِترِ"],["E2F98A6E-3DE8-5AA4-81A6-47C694E9679D","جاءَ نصرُ الإله والفتحُ إلى أن","دُمتَ حَرباً له وقُمتَ بنَصرِي"],["2270C9C4-7186-5CB6-AF59-580C0E4F8DEA","أنتَ بَدرُ التّمامِ، فاجعلْ لنا بَيـ","ـنَكَ عهداً وبينهُ حربَ بدرِ"]]},"7539625E-9F30-51F3-A59B-E1A2C7DA3518":{"t":"يا دِيارَ الأحبابِ! باللَّهِ ماذا","p":191,"s":"يا ديار الأحباب! بالله ماذا","r":"445687","v":[["4EF8D6DE-7FAD-561E-A9CB-D9B7BE313794","يا دِيارَ الأحبابِ! باللَّهِ ماذا","فعلتْ في عراصِكَ الأيامُ"],["F47062E8-81FB-5137-915A-0E9ADB655A15","أخلَقَتها يَدُ الجَديدَينِ حتى","نكرتْ من رسومِها الأعلامُ"],["14FBAF9C-14FC-5C36-90FE-364982EE721E","قد شَهِدْنا فعلَ البِلى بمَغانيـ","ـكِ، ودمعُ الغيومِ فيكِ سِجامُ"],["4E8BB116-5FE3-52D7-9FC4-BB78A6D9905F","واقتَرَضنا منها الدّموعَ فقالَتْ:","كلُّ قرضٍ يجرّ نفعاً حرامُ"]]},"9029F5AA-1F15-5D73-88CC-83F25E868683":{"t":"يا ربّ أعطِ العاشقينَ بصبرِهم","p":191,"s":"يا رب أعط العاشقين بصبرهم","r":"445668","v":[["8BD97417-BD64-5EE5-ACB3-A775999D0DE0","يا ربّ أعطِ العاشقينَ بصبرِهم","في الخُلدِ غاياتِ النّعيمِ المُطلَقِ"],["2F5E5E3D-24A7-52A2-8022-4FBDCA09BE7E","وأقهمُ بردَ السرورِ، فطالما","صَبَروا على حَرّ الغَرامِ المُقلِقِ"],["38B22E60-10DD-5D6E-8F08-116795BFD6C6","حتى يَرى الجُبَناءُ عن حَملِ الهوى","غاياتِ عزهمُ، التي لم تلحقِ"],["E764E2BB-4932-55A1-B636-5D1923B48D37","فيكون أصغرُ جاهلٍ حملَ الهوى","يلهو بأكبرِ عالمٍ لم يعشقِ"]]},"B5ACD2C8-6F2D-54DF-902F-537D29507DDC":{"t":"يا ربّ إن كانَ ذنبي","p":191,"s":"يا رب إن كان ذنبي","r":"446158","v":[["5C5D90C4-645C-5663-BA53-F5C22667BC53","يا ربّ إن كانَ ذنبي","خلاف إخلاصِ قلبي"],["47EC907B-1584-59D8-9C24-39CA78384385","فليسَ ذلكَ إلاّ","لحُسنِ ظَنّي برَبّي"],["162A1501-5364-5F12-83FE-2ED95BEFF0A7","ما لي إليكَ شفيعٌ،","إلاّ اعترافي بذنبي"],["B13E9EC7-699A-56DC-A60E-381A473F030E","ولَيسَ حَسبيَ إلاّ","بأنّ عَفوَكَ حَسبي"]]},"325207BA-192B-51B0-B254-63DBC4B7176A":{"t":"يا ربّ! ذنبي عظيمُ","p":191,"s":"يا رب! ذنبي عظيم","r":"446155","v":[["103438A2-E90C-5225-85B5-EEC24264DBE5","يا ربّ! ذنبي عظيمُ،","وأنتَ عَنّي حَليمُ"],["D966CC5B-9977-58D5-8071-A2BA3799EEC0","بل عزني منكَ وعدٌ،","لهُ الأنامُ تَرُومُ"],["CD1DD267-C08D-54AB-A531-DCF163429268","إذ قلتَ في الذكرِ للمصـ","ـطَفَى، وأنتَ كَريمُ"],["D0C438F0-0EA2-5CF5-852E-F6AB9848B8D9","نَبِّىءْ عِباديَ أنّي","أنا الغَفُورُ الرّحيمُ"]]},"A549871E-CC57-53D8-ACB1-CAE8D1DC0B34":{"t":"يا رَبّ! إني دخلتُ بيتك والـ","p":191,"s":"يا رب! إني دخلت بيتك والـ","r":"446154","v":[["B7A25D93-7F8F-56DC-94BF-5B3783B30577","يا رَبّ! إني دخلتُ بيتك والـ","ـدّاخلُ بَيتِ الكَريمِ في حَسبِهِ"],["6A0DAB45-C0B9-5DC1-8FC6-3DB7A4E48145","لا يَختَشي سُخطَهُ علَيهِ، ولا","يحذرُ من مكرهِ ولا غضبِه"],["FD61DE00-A321-51C7-8B3D-2F8C521239CD","فكَيفَ يَرتاعُ مَن أناخَ بك الرّحْـ","ـلَ، ويخشَى من سُوءِ مُنقَلَبِهِ"],["27161528-0EA6-503B-81D4-F2AF8ED5CB66","لا يَسألُ العَبدُ غَيرَ مَن هوَ بالـ","ـعَفوِ جديرٌ، وأنتَ أجدرُ به"]]},"1D71CDC3-1B6C-56DF-AA24-647665CE4C4F":{"t":"يا سادةً حملتُ من بعدِهم","p":191,"s":"يا سادة حملت من بعدهم","r":"445597","v":[["C9DA3F65-932C-51B0-82A1-EDA78244F2DF","يا سادةً حملتُ من بعدِهم،","أكثرَ من عهدي ومن طوقي"],["0CDD1A8D-F3D1-5897-8948-C18ADF67FAF9","أصحبتُ كالورقاءِ في مدحكم،","لمّا غَدا إنعامُكُم طَوقي"],["2CBD1C6E-5A19-5FBC-B682-2152C1D6C941","إنّ حواسي الخمسَ مذ غِبتُمُ،","إليكمُ في غايةِ الشوقِ"],["95048D83-9F9F-597C-86D6-010F0CCDC781","تَحلونَ في عَيني وسَمعي، وفي","لمسي، وفي شَمْي، وفي ذوقي"],["A5CAE303-2105-5784-A915-46582E4416BA","كذا جهاتي الستّ من بعدِكم","مملوءةٌ من لاعجِ الشوقِ"],["2EBAF4BF-FE3B-5612-B1DA-C0638CB75E47","خلفي وقدامي، ويمنايَ واليسـ","ـرى، ومن تَحتي ومن فَوقي"]]},"B75FD262-3D80-53F2-99E1-1A5BADF7FC5B":{"t":"يا سادةً شخصُهم في ناظري أبداً","p":191,"s":"يا سادة شخصهم في ناظري أبدا","r":"445907","v":[["7372B16E-54F8-5297-9E78-A4CF9F34F4B0","يا سادةً شخصُهم في ناظري أبداً،","وطيبُ ذِكرِهمُ في خاطري وفَمي"],["9D941E86-0021-5A33-9551-8EB150AA3906","ومن لو أنّ صروفَ الدهرِ تسعدني","لما سعتْ نحو مغنى غيرهم قدمي"],["A4063AC7-DEBB-54C6-84DE-4F6C99A5450B","واللَّهِ لو علمتْ روحي بأنّ لكم","في قَتَلَتي غَرَضاً آثَرتكم بدَمي"]]},"5B3F0709-7069-58B0-967E-EA88F4A13DE7":{"t":"يا سادةُ مذ سعتْ عن بابهم قدمي","p":191,"s":"يا سادة مذ سعت عن بابهم قدمي","r":"445593","v":[["1DD8C6F5-F5D8-5E47-A70C-900A8BFD448C","يا سادةُ مذ سعتْ عن بابهم قدمي،","زلتْ، وضاقتْ بيَ الأمصارُ والطرقُ"],["067E0753-5827-59C8-8322-E2D5E222527D","قد حاربض الصبرَ والسلوانَ بعدكمُ","قلبي، وصالحَ طَرفي الدّمعُ والأرَقُ"],["485257C9-385F-5DDA-AFD1-5F4A53F72D24","ودوحةُ الشعرِ مذ فارقتُ مجدكمُ،","قد أصبحتْ بهجيرِ الهجرِ تحترِقُ"],["A54E7EA1-F508-567B-9B16-06817B183FFA","فإنْ أرَدتُمْ لها البُقيا بقُربكُمُ،","تداركوها، وفي أغصانِها ورقُ"]]},"4DB4EC91-E1FD-5B4E-8574-09C502068ADA":{"t":"يا سليماً من داءِ قلبي السليمِ","p":191,"s":"يا سليما من داء قلبي السليم","r":"445765","v":[["64878BDE-5BCA-522E-906C-C058B362356C","يا سليماً من داءِ قلبي السليمِ","ومقيماً على الودادِ القديمِ"],["241E5F5F-3543-57A0-A49B-EE259C811F45","إن تنم خالياً، فبعدكَ قلبي","كلَّ يومٍ في مقعدٍ ومقيمِ"],["15FB32D0-0BB7-5D84-9EF6-3E1CCE1A8A31","أو يكُن خاطري بذكرِكَ في الخلـ","ـدِ، فعينايَ في العذابِ الأليمِ"],["A1D9F9F6-2006-5AE1-8A3C-DB893BBB067D","فمتى يُسعِدُ الزّمانُ بلُقيا","كَ مُحِبّاً منَ النّوى في جَحيمِ"],["3BC1159F-1375-5B73-9253-C2CAA09C183A","ويقولُ الوصالُ يا نارُ برداً","وسلاماً كوني لإبراهيم"],["0C822923-5435-50A6-A719-5BB14B86D86B","يا سميّ الذي فدَى اللهُ إكرا","ماً لهُ نجلَهُ بذبِحٍ عَظيمِ"],["A4176231-6D7A-5AE7-A7F6-F2F8ACAB0072","لو تمكنتُ لافتديتُ تدانيـ","ـكَ بسَوداءِ مُهجَتي والصّميمِ"]]},"634ECC90-8F06-5E0D-A8C6-2FBAA79DD14C":{"t":"يا سميّ الذي بهِ اتهمَ الذئـ","p":191,"s":"يا سمي الذي به اتهم الذئـ","r":"445767","v":[["4DA9C289-A9E9-5CDB-9BF4-0F59C22FE1B2","يا سميّ الذي بهِ اتهمَ الذئـ","ـبُ، وأفضَى إليهِ ملكُ العزيزِ"],["275F72CB-3FDD-5418-9E4B-F1AE89DA7311","لو تقدمتَ مع سميكَ لم يمـ","ـسِ فريداً في حسنهِ المنبوزِ"],["AAE97CAF-3784-530E-A2BA-42E75425A11D","حُزتَ أضعافَ حُسنِهِ وَتَمَيّزْ","تَ عَلَيهِ بكلّ معنًى مَحوزِ"],["01D8BC36-51CD-525F-B9A5-980B2C62AF39","أنتَ حرّ الأديمِ، لم تشرَ في الرّ","قّ بنَزرِ اللّجَينِ والإبريزِ"],["E9C7D83C-00BA-5C8B-81AC-774E68904D65","تَتَمَنّى العشّاقُ لو كنتَ تُشرَى","بنفوسٍ نَفيسَةٍ وكنوزِ"],["3979241F-D9EC-515F-9B63-AF0C86117852","لا ومَن زانَ وَردَ خدّك بالخا","لِ، وزانَ العيونَ بالتلويزِ"],["B4FFEBCD-459F-53AF-948E-ABE6EE7EC3A9","ما تغيرتُ عن هواكَ ولا رُمـ","ـتُ سِوى ذلكَ الجَمالِ العَزيزِ"],["EFCBA3F5-1EEC-5F3F-B08C-AFC611DC6D00","كلّما هزّكَ الصِّبا هزّني الشّو","قُ إلى ضَمّ قَدّكَ المَهزوزِ"],["F3BF2C21-173B-54F0-B92B-A2AB8DE53C37","غيرَ أنّي أبيتُ نصباً على الهـ","ـمّ بحالٍ يغني عن التمييزِ"],["0C72B945-3129-5E0D-B584-BF1C9F334F8F","أتوقّى الأعداءَ إن رمتُ ذكرا","كَ فأكني عن اسمكَ المرموزِ"],["5AE4BDC6-96B7-52DC-BB2F-1CBA64F08552","فأُناجي بكلّ معنًى دَقيقٍ","وأُناجي بكلّ لَفظٍ وجيزِ"]]},"5E6BCDD5-B473-5BB7-89FC-31EC6CB104EA":{"t":"يا سميّ الذي دانتْ لهُ الجـ","p":191,"s":"يا سمي الذي دانت له الجـ","r":"445769","v":[["B76E39D9-A7AD-526B-BC1B-3D2D13B19F73","يا سميّ الذي دانتْ لهُ الجـ","ـنّ، وجاءَت بعرشِها بلقيسُ"],["D737E833-CBEA-548D-9975-7A5F3A410C49","غيرَ بدعٍ إذا أطاعتْ لكَ الإنـ","ـسُ، وهامتْ إلى لقاك النفوسُ"]]},"044A8DA7-92D7-5A0E-93E3-9CDB18908E7F":{"t":"يا سميّ الذي لهُ خبتِ النّا","p":191,"s":"يا سمي الذي له خبت النا","r":"445766","v":[["72E2C5BD-1765-5B4B-90CE-9D35755DDA65","يا سميّ الذي لهُ خبتِ النّا","رُ، وكانتْ لهُ سلاماً وبردَا"],["E2A5FC56-1F8E-5C95-805E-F657C32B7476","لِمْ عكَستَ القِياسَ في نارِ قلبي","فإذا ما ذُكِرتَ تَزدادُ وَقدَا"],["41DB1FF7-1F02-529B-879B-BAB43712EA48","مُذ حكَيتَ الهِلالَ والظّبيَ والغُصـ","ـنَ جَبيناً، وغنجَ طَرفٍ، وقَدّا"],["6DFE77C8-8CCF-586D-9B71-F82B8D21D826","شهدَ العالمونَ طرّاً لطرْفي","أنّهُ فيكَ أحسنُ النّاسِ نَقدَا"]]},"0D6FA487-726B-5949-BD01-BC71A9F16818":{"t":"يا صاحبَ الفَضلِ العَميـ","p":191,"s":"يا صاحب الفضل العميـ","r":"445856","v":[["A24EE8D6-C1A3-5376-9AD2-7BB78770D444","يا صاحبَ الفَضلِ العَميـ","ـمِ، وصاحبَ الربعِ الأنيسِ"],["B538F1A5-36FC-5555-BA31-0A18768E9580","ومَنِ انجَلَى بضِياءِ بَهـ","ـجته دجى الخطبِ العبوسِ"],["92AD7811-9688-5C80-A9D3-D8E85FB0E172","انظُرْ إلى زَهرِ الرّيا","ضِ عليكَ يجلى كالعروسِ"],["AB5ED138-7614-550E-8118-5D1005A06AE1","والدّوحُ قد جَعلَ الشّقيـ","ـقَ بَرانساً فوقَ الرّؤوسِ"],["36C88FF2-63EF-5969-8E19-2C0C20B19CBC","فاطردْ لَنا وَهمَ الحَوا","دِثِ بالكميتِ الخندريسِ"],["97FB6441-6D35-568D-ACA5-B4A7DD1EF309","في كلّ يوم تجتلي","صباً يجلَّى في الكؤوسِ"],["3D0D826C-DB51-5FD6-B3E2-BF568774E1A6","منَ الخَميسِ، إلى الخَميـ","ـسِ، إلى الخميسِ، إلى الخميسِ"]]},"83C17DC0-3E3F-5830-B696-D43EB7E25509":{"t":"يا ضَعيفَ الجُفونِ أضعَفتَ قَلباً","p":191,"s":"يا ضعيف الجفون أضعفت قلبا","r":"445669","v":[["B7626042-213B-59B4-A2C1-DA053EBCF824","يا ضَعيفَ الجُفونِ أضعَفتَ قَلباً،","كانَ قبلَ الهوَى قوياً مليّا"],["3001E6F9-0E34-5554-8AE4-EDD617AC40F0","لا تُحارِبْ بناظِرَيْكَ فُؤادي،","فضَعيفانِ يَغلِبانِ قَوِيّا"]]},"36D83B8F-3511-59B7-97DF-A426D00772B6":{"t":"يا طاهرض المأثراتِ والأصل","p":191,"s":"يا طاهرض المأثرات والأصل","r":"445951","v":[["87D6D162-CF5F-5288-B04D-0A46BEEFFCBE","يا طاهرض المأثراتِ والأصل،","وصاحبَ المَكرُماتِ والفَضلِ"],["3B41BC2F-F676-5E68-83CA-C35EF3547BF2","ومَن إذا ما احتَمَى النّزيلُ بهِ","كانَ لديهِ كالصارمِ النصلِ"],["F0B7192A-C76F-5BCA-99F0-BF9B777AFB8E","أشكُو إلى ظلّكَ الظّليلِ لَنا","من جورِ باغ مستحكم الجهلِ"],["90779D3F-0A26-53B1-9F9C-6B5507C1B0F5","أبَعدَما شاعَ أنّني لَكُمُ","عَبدٌ مُطيعٌ في القَولِ والفِعلِ"],["1D00A5EA-EB51-546B-9FDA-CB96D1A678B8","يصدرُ في مثلِ عصركم مثل هذا الـ","ـفعلِ من مِثلِهِ إلى مِثلي"]]},"21F3B94A-505D-581E-8C6C-C5C89A4E96E1":{"t":"يا طِيبَ يومٍ بالمُروجِ الخُضرِ","p":191,"s":"يا طيب يوم بالمروج الخضر","r":"445534","v":[["11F56071-A1DD-593F-BFDE-6C6182E18CAC","يا طِيبَ يومٍ بالمُروجِ الخُضرِ،","سرَقتُهُ مُختَلِساً من عُمرِي"],["86EEA4C0-B802-5F42-A2FA-26188E8E55AC","والطلّ قد كللَ هامِ الزّهرِ،","فعطرَ الأرجاءض طيبُ النشرِ"],["8DC74256-C9F7-5731-BB09-DC3102582EE6","باكرتُها بعدَ انبلاجِ الفجرِ","عندَ انبساط الشفقِ المحمرِّ"],["E49F94ED-A29F-545E-A4B1-A0AD9C29E749","والطّيرُ في لُجّ المياهِ تَسري،","كأنّها سفائنٌ في بحرِ"],["2B09BEBE-262E-5EF8-8451-225404794609","حتى إذا لاذَتْ بشاطي النّهرِ،","دعوتُ عَبدي، فأتَى بصَقرِي"],["A904BFA8-AAA3-531F-9579-7CBBD903F01C","من الغَطارِيفِ الثّقالِ الحُمرِ،","مُستَبعِدُ الوَحشَةِ جَمُّ الصّبرِ"],["C15B2194-9BED-5EDF-ABA7-20B0CC676654","معتَدلُ الشّلوِ شديدُ الأزرِ،","مُنفَسِحُ الزَّورِ رَحيبُ الصّدرِ"],["4B60E9D6-4344-5E7D-B254-DF70E5352129","مُتّسعُ العينِ عريض الظّهرِ،","بأعينٍ مسودةٍ كالحبرِ"],["D4EC41DD-7F23-5FB3-B5B4-0852AA5587AD","وهامةٍ عظيمةٍ كالفهرِ،","كأنّ فوقَ صدرهِ والنحرِ"],["C746DDA0-B9D0-568C-9952-B4EC0CED1C95","هامةِ هيقٍ في صماخيْ نسرِ،","طويلِ أرياشِ الجناحِ العشرِ"],["D6928F16-B0F5-592E-A2BD-DB0AA0FC8EAB","قصيرِ ريشِ الذنبِ المحمرّ،","قصيرِ عظمِ الساقِ تامِ الظفرِ"],["7FABF8CD-C1E7-5E55-A93E-7300F6F78937","فظَلّ يَتلوها، عظيمَ المكرِ،","يُغري بها هِمّتَهُ ونَصرِي"],["84402781-E434-5BB8-BB7D-3CB4C9CA5CD3","كأنهُ يطلبُها بوترِ،","فجاءنَا منها بكلّ عَفرِ"],["ACDB9F44-CAF0-5F47-82F3-EA3A307D20C2","فبِتُّ والصّحبَ بها في بِشرِ","كأنّنا في يومِ عيدِ النّحرِ"]]},"63E3DFEF-7107-5795-B969-A7EEF6872E5C":{"t":"يا ظبيةً قنصَ الأسودَ جمالها","p":191,"s":"يا ظبية قنص الأسود جمالها","r":"445683","v":[["A66B2CC9-9678-5D7E-9D9E-85597C1ADB4E","يا ظبيةً قنصَ الأسودَ جمالها،","ونرى الظباءَ يصيدها القناصُ"],["4939468A-54D5-54B5-A828-C34E42A320CF","أصمَتْ لواحظُكِ القلوبَ بأسهُمٍ،","لم يُغنِ عَنها نَثرَةٌ ودِلاصُ"],["87524EAD-B237-5467-85DF-9CE498083F9C","فهبني جَرَحتُ الخَدّ منكِ بنَظرَةٍ،","أفَما لأسرِ القَلبِ منكِ خَلاصُ"],["9FF5F241-F758-53A4-8F84-40EBC45FBBC4","ها قد جرَحتِ بنَبلِ عَينَيكِ الحَشَى،","فدعي فؤادي، فالجروحُ قصاصُ"]]},"5D4C4ACE-342B-5899-84E9-0ED0D493B668":{"t":"يا علماً لاحَ لخفضِ العدى","p":191,"s":"يا علما لاح لخفض العدى","r":"445997","v":[["3C06D0ED-5C66-527D-97D5-25874A7128F2","يا علماً لاحَ لخفضِ العدى،","وهوَ لرَفعِ الذّكرِ مَنصوبُ"],["347C7952-EA32-5A19-98A9-C51704E68564","عَبدُكَ قد جاءَكَ مُستَصرِخاً،","وقلبُهُ بالهَمّ مَكرُوبُ"],["4FE09A21-5630-5F95-B4FB-34A0673793FC","حاشاكَ أن تنصفَ من دونه،","وحقهُ عندكَ مغصوبُ"],["30D230BE-2B25-5308-9D50-FB5B4EF34C42","فكلُّ ما يغرسُ وحشُ الفلا","متهمٌ في فعلهِ الذيبُ"],["B5593FF8-291A-548A-8F4E-3271F09B1FCA","الذّئبُ لا يُؤمَنُ لكِنّهُ","علَيهِ في يُوسُفَ مَكذوبُ"],["E2FABAF4-CE32-572F-B1E5-BDA8FDB71DB9","وقد تَجَلّى الحَقّ من بَعدِ ما","صَدّقَ فيهِ السّعيَ يَعقُوبُ"],["9EA762A1-9B3B-5AA3-A2C1-03D11050A7D7","كذلكَ العبدُ الذي حقهُ","بباطلِ الأعداءِ مَغلوبُ"],["53C5BD99-D3BA-5043-A15F-8AE370EE6928","رأوكَ للسّعيِ بهِ سامعاً،","فَلُفّقتْ عَنهُ الأكاذيبُ"]]},"58B348C0-29DB-58BB-ACC9-90D282FB1638":{"t":"يا عِترَةَ المُختارِ يا مَن بهِمْ","p":191,"s":"يا عترة المختار يا من بهم","r":"445434","v":[["B9FB5811-F52D-59E4-85FC-F4C9E08223EF","يا عِترَةَ المُختارِ يا مَن بهِمْ","أرجو نجاتي من عذابٍ أليمْ"],["2AC3DAFD-1291-5DE6-9D81-A59933EBB577","حديثُ حبي لكمُ سائرٌ،","وسرُّ ودي في هواكمْ مقيمْ"],["DFC858DB-460C-5061-8C7A-98D5C716A921","قد فُزْتُ كلَّ الفَوزِ إذْ لم يَزَلْ","صراطُ ديني بكمُ مستقيمْ"],["BBA7C15D-5D70-5E25-8FF2-DC5E22FF0B8D","فمن أتَى اللهَ بعرفانِكُمْ","فقد أتَى اللهث بقلبٍ سليمْ"]]},"4698B931-E782-5E7E-98C1-FF322483C2D3":{"t":"يا عِترَةَ المُختارِ يَا مَن بهِم","p":191,"s":"يا عِترَة َ المُختارِ يَا مَن بهِم","r":"445433","v":[["16130770-E1E0-53B2-AB35-8FEB254292A3","يا عِترَةَ المُختارِ يَا مَن بهِم","يفوزُ عبدٌ يتولاهمُ"],["A1E866F6-9A8F-5C94-8969-9CFCD2A9C91D","أعرفُ في الحشرِ بحبّي لكم،","إذْ يُعرَفُ النّاسُ بسِيماهُمُ"]]},"558A23C8-18AA-5258-96B1-5AFFF0518AEE":{"t":"يا قابضَ المالِ الذي لم تزَلْ","p":191,"s":"يا قابض المال الذي لم تزل","r":"445782","v":[["646D7EA7-62DE-520A-9CF0-629EEC3F6114","يا قابضَ المالِ الذي لم تزَلْ","عَيني إلى بَهجَتِهِ تَطمَحُ"],["4739074A-78FF-52D8-83A2-9AA0B1B9FCFF","ومَن إذا جَرّحَني لحظُهُ","غداً بلحظِ خدهِ يجرحُ"],["1845E7A2-D858-5FFA-82E5-34AC341804B6","تاللَّه لا أنفَكّ مُستَهتراً","فيك بأشعاري ولا أبرَحُ"],["1C805B16-DF39-5B78-B157-DD75E4EBBBBA","يعذُبُ لي الإحماضُ في قابضٍ","حلوٍ إذا ما مرّ يستملحُ"]]},"728CBB14-4A96-5B53-9C1B-9369EA5BAA5C":{"t":"يا قَضيباً ذوى وكانَ نَضِيراً","p":191,"s":"يا قضيبا ذوى وكان نضيرا","r":"445630","v":[["7E06A4B3-6A37-5173-8329-716CAEA5506F","يا قَضيباً ذوى، وكانَ نَضِيراً","ما رأينا لهُ الغَداةَ نَظيرَا"],["3E602908-1BC3-5F39-948A-0C3026359893","أظلَمَتْ بعدَهُ الدّيارُ، وقد كا","نَ سِراجاً بها وبَدراً مُنِيرَا"],["648B59EE-2BE3-5FEA-98FE-2E16646E8FDD","غَيّبَتهُ الأرضونَ عنّا، وما خِلـ","ـتُ أديمَ التّرابِ يَحوي البُدورَا"],["E9899A45-373D-575B-B936-C8A9794A4605","لا ولا خِلتُ أنّ شُهبَ الدّراري","بعدَ أوجِ العُلى تحِلّ القبورَا"],["56C3EC3C-5B47-5007-B694-9DC14D5D3295","يا حَبيباً، فِراقُهُ أخرَبَ القَلـ","ـبَ، وقد كان مَنزِلاَ مَعمورَا"],["E89A2CB7-F182-5A6D-AD6C-35031EF51880","فاجأتْنا بالنّدبِ أصواتُ ناعيـ","ـكَ، وكادتْ قلوبنا أن تطيرَا"],["5C8B01D0-9DA3-5DDF-84E0-51B12976B8A1","فنَفَينا الرّقادَ عن كلّ عَينٍ،","فجّرَتها دُمُوعُها تَفجِيرَا"],["42BAFC69-8FFD-540C-83BF-69D8C8BB06E7","ما رأى النّاسُ قبل مثواكَ يوماً","كانَ بالبَينِ شرّهُ مُستَطيرَا"],["F98199A0-38D3-5E0C-BDAE-012E6ACAE8D8","ولقد خفتُ من فراقِكَ يوماً","باكياً بالثّبورِ يَنعَى ثَبيرَا"],["743A532E-B4D7-555D-9E31-3E2763E19E84","فبرغمي أنْ لا أرى منك وجهاً","يرجعُ الطرفُ من سناه حسيرَا"],["C1A0F7B4-3764-5C24-A7E7-83CA72C1606F","كنتَ ريحانَةَ القُلوبِ، فقد دا","رَبكَ التربُ عنبراً وعبيرَا"],["043CEA7A-C320-5F3B-9F7C-C34ED3A5BEE9","كنتَ شَهماً معَ الحَداثَةِ في السّـ","ـنّ، وجلداً على البلاءِ صبورَا"],["D91803FC-88C2-5003-ACA5-E35569FE5D7D","وحملتَ الأثقالَ عنّي فأمسَى","بكَ طَرفي بينَ الأنامِ قَريرَا"],["CEFE0177-C7EB-5765-8C38-FD2E258CE7BB","فجزاكَ الإلهُ عن ذلكَ الصبـ","ـرِ على الهولِ جنّةً وحريرَا"],["C17B0555-09DF-594E-9121-804D8FD3AB78","وأراكَ الإلَهُ في جَنّةِ الخُلدِ","نَعيماً بها ومُلكاً كَبيرَا"]]},"A048E155-F910-5056-B30D-FDE1111A7987":{"t":"يا للحماسةِ ضاقتْ بينكم حيلي","p":191,"s":"يا للحماسة ضاقت بينكم حيلي","r":"445425","v":[["8452E1CE-E855-5E78-9743-1870B106427B","يا للحماسةِ ضاقتْ بينكم حيلي،","وضاعَ حقيَ بينَ العذرِ والعذلِ"],["595EE656-A8F0-50EE-955C-F568347633B7","فقلتُ مع قلةِ الأنصارِ والخولِ:","لو كنتُ مِن مازِنٍ لم تَستَبِحْ إبِلي"],["F94C59A2-F22E-54E6-B07A-BC1D769B14E0","لو أنّني برُعاةِ العُربِ مُقترِنُ،","لهمْ نَزيلٌ، ولي في حَيّهِمْ سَكَنُ"],["12D19693-8233-5043-90CC-6048508C937B","ومسني في حمَى أبنائهمْ حزنُ،","إذنْ لقامَ بنصري معشرٌ خشنُ"],["2F861F8B-8C55-5FF5-8606-A807C6892EAE","لله قَومي الأُولى صانوا مَنازِلَهمْ","عن الخطوبِ، كما أفنوا منازلهمُ"],["71437CB9-C05E-590A-A2F7-73D10C0CC767","لا تجسرُ الأسدُ أن تغشَى مناهلهم،","قومٌ، إذا الشرّ أبدى ناجذيهِ لهمُ"],["69F2E4D9-8795-5E9D-964D-5A3703A49D87","قومٌ، نجيعُ دمِ الأبطالِ مشربهم،","ورنةُ البيضِ في الهاماتِ تطربهم"],["2CA949A9-A7D4-50EF-A402-4600F8D47A48","إذا دعاهم لحربٍ من يجربهمْ،","لا يسألون أخاهمْ حينَ يندبُهم"],["07BE4757-5A78-5BEE-82D5-012FE765057B","فاليومَ قومي الذي أرجو بهمْ مددي","لأستطيلَ إلى ما لمْ تنلهُ يدي"],["69550E76-B5F4-5AAB-9102-980A6FF04F21","تخونني مع وفورِ الخيلِ والعددِ،","لكنّ قَومي، وإن كانوا ذوي عَدَدِ"],["5A159245-C28E-56DB-8C0A-72E31C1E1CF6","يولونَ جاني الأسى عفواً ومعذرةً","كعاجزٍ لم يطقْ في الحكمِ مقدرةً"],["E25FF125-B0AA-5644-8BA8-5FB547E200B6","فإنْ رأوا حالةً في الناسِ منكرةً،","يَجزُونَ من ظُلمِ أهلِ الظّلم مغفرَةً"],["88E14E6D-DAE4-5F38-8D1B-78D367AD4F50","كُلٌّ يَدِلّ على الباري بِعفّتِهِ،","ويستكفُّ أذى الجاني برأفتِهِ"],["1623F580-1909-50B7-977F-772FA7CDA690","ويحسِبُ الأرضَ تَشكو ثِقلَ مَشيَتِه،","كأنّ ربكَ لم يخلقْ لخشيتِهِ"],["585F2797-5693-5F73-B5E8-B62DCBBCC209","لو قابَلوا كلّ أقوامٍ بما كَسَبوا،","ما راعَ سربهمُ عجمٌ ولا عربُ"],["A8DA0052-A92C-5649-9231-D2A221CB6FAD","بل ارتَضَوا بصَفاءِ العَيشِ واحتَجبوا،","فلَيتَ لي بِهمُ قوماً، إذا رَكِبُوا"]]},"6820DB66-28FF-5407-A55B-632BB7134822":{"t":"يا ليتَ شعري وقد أودى بك القدرُ","p":191,"s":"يا ليت شعري وقد أودى بك القدر","r":"445636","v":[["7B4FC6F4-B54F-5540-B6B4-CCEED8C58BF2","يا ليتَ شعري، وقد أودى بك القدرُ،","بأيّ عذرٍ إلى العلياءِ يعتذرُ"],["188BFF1B-8FB3-56EC-AF83-E0191C9DBD27","وكيفَ جارَ عليكَ الدهرُ معتدياً،","أما تعلمَ منكَ العدلَ يا عمرُ"],["08800584-EB92-5536-BBDE-59F6409B1333","يا ابنَ الملوكِ الأُلى كان الزّمانِ لهم","طَوعاً وأقبَلَ صرفُ الدّهرِ يأتَمِرُ"],["C2E483AE-B5D5-542B-9ACB-ED33974E45CE","يا ناصرَ الدّينِ، يا مَن جودُ راحته","بينَ الأنامِ على الأيامِ ينتصرُ"],["EB75B003-7EAA-5FE2-8B47-2391FE83E3EE","أنتَ الجَوادُ الذي لولا مكارِمُهُ،","لأصبحَ الجودُ عيناً ما بها بصرُ"],["03B9C569-0779-55AB-A723-C6D93656C014","تعطي وتبسطُ بعدَ البذلِ معذرةً،","وعُذرُ غَيرِكَ دونَ البَذلِ يُبتَدَرُ"],["1C2A3755-921C-5A36-B678-483BE1F6555D","فقتَ الملوكَ جميعاً في عطاً وسطاً،","فأنتَ كالبَحرِ فيه النّفعُ والضّرَرُ"],["F1FCDA11-D0D3-56ED-A46C-78C75F9F7E69","وحزتَ أخلاقَ شمس الدينِ مكتسباً","والشمسُ مكتسبٌ من نورِها القمرُ"],["3EEAD146-98EC-5C70-9C70-C7ADE0D483E1","خاطرتَ في طلبِ العلياءِ مجتهداً","وما يُخاطِرُ إلاّ مَن له خَطَرُ"],["675F365A-CDE7-5BF0-B76E-A5C4D21EEC60","رفعتَ ذكركَ بالإنعام منتجداً،","بهِ، وغَيرُكَ بالأموالِ يَفتَخِرُ"],["6AAE1DA4-0DB3-5E3F-80B8-9244DD82EC60","قد كانَ جودُك لي عينَ الحياةِ إذا","وَردتُه، وحَواني رَبعُكَ الخَضِرُ"],["BF0C564D-0748-52F1-8760-A49600325A96","أعزِزْ عليّ بأنْ أدعوكَ ذا أمَلٍ،","فلا يُجابَ برِفدٍ منكَ يَنهَمِرُ"],["2DFADE0B-F464-5856-BBC6-A9243402F11D","وأن يُحَثّ إلى مَغناكَ وفدُ ثَناً،","وليسَ منكَ به عَينٌ ولا أثَرُ"],["AC4D9A67-A5DA-5D2F-B0E1-899812C345C9","طابتُ مَراثيكَ لي بعد المَديحِ، ومن","بعد السرورِ براني الحزنُ والفكرُ"],["F98F1AC7-BEA5-58DA-956B-0176099585D1","كأنّ حُزنَكَ من أسمائِهِ سَقَرٌ،","فذاكَ في القلبِ لا يبقي، ولا يذرُ"],["65BBEF98-BAE3-579A-B743-2218E7E24987","سقى ضريحك صوبُ المزنِ منبجساً","حتى يدبجَ أقصى تربِه الزهرُ"],["5B4592CC-9BE9-5833-B2E1-B4D37ADEE7A9","وكيفَ أسألُ صَوبَ المزنِ رَيّ ثرًى","حللتَ فيه، وفيهِ البحرُ والمطرُ"]]},"C412E4D4-F922-53FD-B0CD-A967A81BA539":{"t":"يا مالِكَ العَصرِ ومَن","p":191,"s":"يا مالك العصر ومن","r":"445852","v":[["830E1A12-C902-5F22-B02C-5A3A0A585515","يا مالِكَ العَصرِ، ومَن","لجودهِ الغيثُ حسدْ"],["120DA5EB-2DCC-5EAA-91C5-016FF8DB4390","ومن حوى مكرمةَ الـ","ـأنواءِ مع بأسِ الأسَدْ"],["9F98C2F0-9899-5653-8177-1E301D69089F","أما تَرَى الزّهرَ، وقد","أججَ ناراً ووقدْ"],["6B597ECE-5EDC-53F3-A4BD-E3A3BE7DEDFC","وانتَبَهَ الدّهرُ لَنا،","مِن بَعدِ ما كانَ رَقَدْ"],["47FAB99C-92F8-5F5B-89F2-F6387A0D5025","فاغتنمِ العيشَ، ولا","تردّ منهُ ما وردْ"],["3147573C-1C83-5043-9A33-64463D561649","وواصِلِ الشّربَ، وقُل","أنجزَ حرٌّ ما وعدْ"],["12DEB56E-0147-536C-8D0D-37A2B9B5C7A8","من الأحدْ، إلى الأحد،","إلى الأحَد، إلى الأحَدْ"]]},"AA533E36-092D-5FB9-92EF-C7736941F1A6":{"t":"يا مانحي مَحضَ الوُعودِ ومانِعي","p":191,"s":"يا مانحي محض الوعود ومانعي","r":"445964","v":[["96C81545-2CB1-5D67-8143-188D9A3CA691","يا مانحي مَحضَ الوُعودِ، ومانِعي","حفظَ العهودِ، ومجتنى معروفهِ"],["168C1AC5-3879-5A57-87B6-7A96548D4F5D","لي، كلَّ يومٍ، منكَ عُذرٌ واضِحٌ،","وأخافُ أن يُفضِي إلى تَصحيفِهِ"]]},"911A3BA9-767C-589F-80DA-BD0CB448D8AB":{"t":"يا مليكاً بذكرِهِ يفخرُ المدْ","p":191,"s":"يا مليكا بذكره يفخر المد","r":"445500","v":[["BF8F67A2-AE52-5A6C-ACA7-871F4394D34C","يا مليكاً بذكرِهِ يفخرُ المدْ","حُ ويسمو الإيرادُ والورّادُ"],["CBB9B0F2-1329-50B1-B9EA-BD5107D5E3B8","أنتَ أعلى من أنْ تُهنّى بعيدٍ","بل تهنّى بمجدِكَ الأعيادُ"],["E3592E96-B529-598E-B611-85C290628AE5","فابقَ في نعمةٍ بها سرّ راجيكَ،","وردّتْ بغيظِها الحُسّادُ"],["A2B797CD-EB61-5CAB-9BE9-7069DBC6F40D","صُمّ في صَومِكَ العُداةُ، وفي","فطرِكَ منهم تفطَّرُ الأكبادُ"]]},"74D513CF-1372-5480-A4E6-281AF9CE423E":{"t":"يا مليكاً قد طابَ أصلاً وفرعاً","p":191,"s":"يا مليكا قد طاب أصلا وفرعا","r":"445473","v":[["77CD2930-1CA2-50AD-823B-064B41CFFD08","يا مليكاً قد طابَ أصلاً وفرعاً،","وزكتْ من أُصولِهِ الأعراقُ"],["C6633DF7-0533-5C28-9101-88481783790D","والذي جَمّعَ الفَضائلَ والحَمدَ","والمالَ في يديهِ افتراقُ"],["53211A97-6ADB-5F3E-85B5-3511565DDCEE","كم تحملتَ في طلابكَ للعلياءِ","ثِقلاً يَسيرُهُ لا يُطاقُ"],["AB990DCD-E69B-5B77-BC55-AB50869C6C4F","لا تَخَفْ إن أضاعتِ المالَ كَفّا","كَن ففيهنّ للعلاءِ اتفاقُ"],["7B78E1A7-58CC-5E55-BE17-A37D821271DE","لا يضرُّ القضيبَ، وهوَ نضيرٌ،","أنْ تَزولَ الثّمارُ والأوراقُ"]]},"9C2FD53C-EFED-5D69-AF58-8D46B72C52C9":{"t":"يا من جعلَ الظباءَ للاسدِ تصيد","p":191,"s":"يا من جعل الظباء للاسد تصيد","r":"445764","v":[["F8D47EAE-89DA-5B00-B26E-2E681651F39C","يا من جعلَ الظباءَ للاسدِ تصيد،","والسادةَ في مواقفِ العشقِ عبيد"],["D63D11F7-9F26-5DBE-8207-2F19FC4F6B4C","ألهمْ حدقَ الملاحِ في الحكمِ بنا","إنجازَ مَواعِدٍ وإخلافَ وَعيد"]]},"B5ED1ADC-E9B1-5A56-86C0-D6E3BC427637":{"t":"يا من حكتْ شمسَ النهارِ بحسنِها","p":191,"s":"يا من حكت شمس النهار بحسنها","r":"445697","v":[["63384541-75D6-5DD5-B148-3796613E3944","يا من حكتْ شمسَ النهارِ بحسنِها،","وبعادِ منزلِها وبهجةِ نورِها"],["D7DD9628-2D16-5D7A-83E1-C5D919EA0C37","هَلاّ عدَلتِ كعَدلِها، إذ صَيّرَتْ","للناسِ غيبتها بقدرِ حضورِها"]]},"70F7B948-EF5E-567B-A795-2A6C0ED7F2E3":{"t":"يا من حمتْ عنّا مذاقةَ ريقِها","p":191,"s":"يا من حمت عنا مذاقة ريقها","r":"445684","v":[["9CC463E3-388E-51FC-8EBB-53CC6F01EA2C","يا من حمتْ عنّا مذاقةَ ريقِها،","رفقاً بقلبٍ ليسَ فيهِ سواكِ"],["A5B79DF9-2BDA-5EDC-9ABA-669D6F29FBA0","فلكَمْ سألتُ الثّغرَ وَصفَ رُضابِهِ","فأبى، وصرحَ لي سيفهُ سواكِ"]]},"5E138A69-9AD9-528F-87F1-2841E3DEC93F":{"t":"يا من يلومُ على المدامة","p":191,"s":"يا من يلوم على المدامة","r":"445826","v":[["29500AFD-E414-5C66-955A-F4A13A7FAC15","يا من يلومُ على المدامة،","ما للمحبّ وللملامَه"],["2459241F-16D5-5379-BB13-01F6D7042EDB","لا حبّ عندي للذي","فيها يَلومُ، ولا كَرامَه"],["0EF1A958-5104-55F1-B3EA-FCC4D1C8C704","ما إن تنالُ، إذا عذلـ","ـتَ على المدامِ، سوى الندامَه"],["D6E86025-946D-59C1-8E5D-628DE6BBE30B","إنْ تسقني ماءَ الملا","مِ سقَيتُكَ اسمَ أبي دُلامَه"]]},"217CAC9E-8A4E-5027-A716-F48D1B6318C4":{"t":"يا مهيني عندَ المغيبِ ومبدٍ","p":191,"s":"يا مهيني عند المغيب ومبد","r":"445926","v":[["8AA7E7FE-737B-5811-BD45-50FEE0E016E7","يا مهيني عندَ المغيبِ ومبدٍ","مع حضوري خضوعَ عبدٍ لمولى"],["117C4987-8664-5FA6-9F5B-26571D2B536D","لا تَقُمْ لي معَ التّقاعُدِ عَنّي،","فقِيامُ النّفوسِ بالودّ أولى"]]},"16766A25-43FE-56EF-B911-53501121A7DF":{"t":"يا مَن غَدا للأنام غَيثاً","p":191,"s":"يا من غدا للأنام غيثا","r":"445854","v":[["9F950C1B-55CE-58DF-B99D-22C96D587B0E","يا مَن غَدا للأنام غَيثاً،","وجودهُ للورى غياثا"],["A51D0CBB-9C20-58A7-9971-82FF8E19D350","ومَن إذا جارَ صَرفُ دَهرٍ،","فقدَ نجا من بهِ استغاثا"],["AA3A272C-A8D2-5340-9400-F48B2E90A88A","أما تَرَى الزّهرَ وهوَ زاهٍ،","والجونَ قد جادَهُ وغاثَا"],["EEA08648-9F91-5DD6-8E95-D5CB374953F7","وقد وَفَى دَهرُنا، وكانَتْ","جبالُ ميعادهِ رثاثا"],["83C3C236-4FE9-56FC-A78D-13D597357E5F","فاغتنمْ وفي موعدِ الليالي","من قَبلِ أن تُحدثَ انتِكاثَا"],["2824E521-8C47-5381-8D29-285376F6F507","وباكِرِ الرّاحَ كلّ يومٍ،","ولا ترمْ دونها التباثَا"],["84B38324-0634-5253-B6E1-B428B6C3DCEB","من الثلاثا، إلى الثلاثاً،","إلى الثلاثَا، إلى الثلاثَا"]]},"791F4607-97F9-5A5F-A89D-3FB5012DC3B5":{"t":"يا مَن فَضَحَ الغصونَ في مَشيَتِهِ","p":191,"s":"يا من فضح الغصون في مشيته","r":"445763","v":[["6CB34B55-0C41-5E29-BADE-6AC50B4A1086","يا مَن فَضَحَ الغصونَ في مَشيَتِهِ،","والبدرَ، فما أفاقَ من غشيتهِ"],["202BE9A4-2428-5B25-9D90-1E8AF4B6F389","مَن شاهَدَ ظَبياً شارداً ذا مَرَحٍ،","قد أشفَقَتِ الأُسودُ من خَشيَتِهِ"]]},"6555A2B4-3E77-570B-BCE3-1343CE08D5D2":{"t":"يا مَن لجمالِ يوسفٍ قد ورثَا","p":191,"s":"يا من لجمال يوسف قد ورثا","r":"445762","v":[["5E1F1355-96D6-5E39-BF69-D52BA701025E","يا مَن لجمالِ يوسفٍ قد ورثَا،","العاذلُ قد رقّ لحالي ورثَى"],["C55D3D04-2851-5D5B-A9C8-748E5FDCBCF9","والناسُ تقولُ، إذ ترى حسنك ذا:","سُبحانَكَ ما خَلقتَ هذا عَبَثَا"]]},"7C96B2B1-729C-5161-9736-4ED023941E2F":{"t":"يا مَن يُعِزّ المالَ ضَنّاً بهِ","p":191,"s":"يا من يعز المال ضنا به","r":"446134","v":[["3EE0915D-B43D-59E1-846D-01936633E358","يا مَن يُعِزّ المالَ ضَنّاً بهِ،","إنّ المعالي ضدّ ما تزعمُ"],["7E62B2F1-C19D-59C0-88DB-9A986D583A46","ما عزّ بينَ الناسِ قدرُ امرىءٍ","إلاّ وقد ذَلّ بهِ الدّرهَمُ"]]},"F35CC038-5FFC-568C-8B04-F416B683D978":{"t":"يا مَنْ لهُ رايةُ العلياءِ قد رفعتْ!","p":191,"s":"يا من له راية العلياء قد رفعت!","r":"445419","v":[["675C5576-FF2C-5D78-B305-3844D3229B6A","يا مَنْ لهُ رايةُ العلياءِ قد رفعتْ!","إنّ العداةَ بنا لمّا نأيتَ سعتْ"],["E317842A-4B13-592A-8C61-BA4626036DBD","وقد أداروا لَنا بالسّوءِ دائرَةً","من النَّكالِ، وإن لم تَرْفُها اتّسعتْ"],["F3BF8826-9413-5873-92E9-6D04B72323B4","أراقِمٌ لِينُها عَن غَيرِ مَقدِرَة،","لذاكَ إن أمكَنتها فُرصةٌ لسَعتْ"],["63D4E7BC-A431-530B-BF06-9B75BBAA0A33","إنّ الصدورَ التي بالغلّ مشحنةٌ","لو قطعتْ بلهيبِ النّارِ ما رجعتْ"],["007CBC0C-D9F2-5983-9F6C-89C3FB42A3DA","وكيفَ تهواكَ أطفالٌ على ظمإٍ","رمتَ الفطامَ لها من بعد ما رضعتْ"],["E5EADA08-77DE-534A-8D25-D08935A0307D","تَبَسّمتْ لكَ، والأخلاقُ عابسةٌ،","إنّ القلوبَ على البَغضاءِ قد طُبعتْ"],["A79C805F-5B36-5376-9F34-7D682E22443F","تفرّقتْ فرقاً من خوفِ بأسكُمُ،","حتى إذا أمنَتْ من كَيدكَ اجتمعتْ"],["758DF9F0-D0D9-588B-AB05-FE7EBA64C49F","وحاذَرَتْ سَطَواتٍ منك عاجلَةً","عندَ القُدومِ، فمذ أمهلتَها طمعَتْ"],["59D2D23A-0F9B-5A5D-A73B-F11BD3447A13","وطالَعتْ بأُمورٍ ليسَ تَعرِفُها","ولا أحاطتْ بها خُبرا ولا اطّلَعتْ"],["1927C8BC-5439-5AD8-84B1-F273709EA278","فكيفَ لو عاينتْ أمراً تحاذرُهُ،","إن كان فعلٌ لها عن بعض ما سمعتْ"]]},"3D8ECB87-5104-5A97-AF12-7BA5B6FF5A0F":{"t":"يا نافخَ الصورِ بل يا نافخَ الصورِ","p":191,"s":"يا نافخ الصور بل يا نافخ الصور","r":"445791","v":[["750E91F1-F543-5DC1-B29A-A2F93E52B388","يا نافخَ الصورِ بل يا نافخَ الصورِ،","من رقدةِ السكرِ لا من ظلمةِ الحفرِ"],["528DA1A4-77B6-512D-AC65-C9EB05903033","قرنتَ حسنكَ بالإحسانِ فيهِ لنا،","فكانَ فيكَ مُرادُ السّمعِ والبَصَرِ"],["20146B06-C77C-5EE4-8BB0-3D8D2F8C739A","ضمنتَ للصحبِ إقبالَ السرورِ كما","ضَمّنتَ نايَكَ نأيَ الهمّ والكَدَرِ"],["FAB986EA-3447-57BC-819C-BE5B55EBF37D","صوتٌ بَسيطٌ بِهِ أرواحُنا انبَسطَتْ،","إذ جئتَ في اللفظِ والمعنى على قدَر"],["9948F269-52B6-5BCD-89E8-05EB3394DD6A","إذ ترنمَ ساوَى وزنَ نغمتهِ،","وإن عَلا جاءَ بالتّرخيمِ في الأثَرِ"],["0549EA6B-27DD-5162-9AE9-2480DD2DA469","يكادُ تخرسُ صوتَ العودِ صرختُه","حتى كأنّ لهُ وتراً على الوترِ"]]},"6F5C2D81-0B72-5E62-B86B-907A64934E1E":{"t":"يا هلالاً من سلطةِ العيّ حيي","p":191,"s":"يا هلالا من سلطة العي حيي","r":"446204","v":[["0D2EA66A-9E54-582E-8401-3031069EB300","يا هلالاً من سلطةِ العيّ حيي،","أشرقَ الصبحُ تحتَ ليلٍ دجي"],["252527A3-A373-598E-AD6B-FEA69821DECD","يُوسفيُّ الجَمالِ، كم تاهَ صَبٌّ","في معاني جمالهِ اليوسفيِّ"],["1CB95D7A-B44E-58D9-BA22-95AFF200D846","يا فتي في الأعراقِ واللّحظِ واللّفـ","ـظِ أيُّ حُسنٍ بحُسنِ خَلقٍ سوِيّ"],["9ACCA9D3-A452-5048-A172-F5C0494E55C7","يستعيرُ القضيبُ القودِ، هامي الجو","دِ، حتفُ الضّدودِ فَتحُ الوَليّ"],["E9EAE4B5-DE2A-51D4-8AFE-026F34B48081","يحملُ اللدنَ للقتالِ، ولم تغـ","ـنَ بلدنٍ من قدهِ السمهري"],["7A2FF98F-E344-519C-9BEB-0B4A043A876C","يَرنُو بعَينٍ تُغنيهِ في قَتلِهِ العُشّـ","ـاقَ عن كلّ ذابِلٍ يَزَنيّ"],["99E2B7F2-BA45-5EDC-993A-E98D749109C0","يَتَلَقّى دَمَ القُلوبِ بخَدٍّ","زانَهُ نَقطُ خالِهِ العَنبَرِيّ"],["E4F2D2F5-7F8F-5F93-B15B-FC2DDC21A980","ـنَ ويُزري بالذّابلِ الخطّي","قَوسُها خَطُّ حاجبٍ مَحنيّ"],["FFD5169D-2B0E-59B1-B7A4-CA1DF02FD2CA","يققٌ، مذ بدا العذارُ عليهِ،","أنبَتَ الآسَ في اللُّجَينِ النّقيّ"],["FBD7E91F-CBBF-57AC-8320-836190DB0AC2","يتَجَنى من بَعدِما باتَ طَوعي،","ويسقيني منَ المدامةِ ريّ"],["812D6E91-5A90-5158-AF04-5757BFF726BD","يمزجُ الكاسَ لي، فإن عزتِ الرا","حُ سقاني من ريقهِ السكريِّ"],["3BAA8AEA-D44B-5B67-914B-B487878831DA","يمنحُ المستهامَ خمرَ رضابٍ،","في حبابٍ من ثغرهِ اللؤلؤيِّ"],["5D2DFE99-2492-5F42-A268-282D1A64A7B9","يهتكث الليلَ نورها ببروقٍ","أذكرتنا برقَ الحمى الأرتقيِّ"],["08CB2729-FDD4-56D1-A940-EDC84989B975","يا حُداةَ المَطيّ ها نُورُ نجمِ الـ","ـدّينِ قد لاحَ يا حُداةَ المَطيّ"],["888F47A3-5F97-54F3-8A34-9203DEB63593","يمموا نحوهُ تلقوا سماحاً،","وولياً يجودنا بوليِّ"],["27DA96A9-69BA-5EA8-A1E7-FAB2A3298E36","يَرِدُ الرّكبُ منهُ بحرَ سماحٍ،","من وِلا الجُودِ، بَحرٍ رَوِيّ"],["0B5B47F0-7AAF-53E7-9EA5-2D0FC1154540","يَقِظٌ قد رَعَى الأنامَ بطَرفٍ،","ردّ عنهُ الردى بطرفٍ عميّ"],["20FC653C-30F9-575A-9069-FFD5C841695B","يافعٌ، شديدُ المعالي، ووا","تى الحُكم من قَبلِ رُشدِهِ المَرضِيّ"],["5377197B-2FBF-53BC-9986-D89127431857","يمُّ جودٍ جادتْ على الناسِ كفا","هُ، فأغنَتْ عنِ الحَيا الوَسميّ"],["CF8501D2-0AD6-53F4-9173-345DE7979D84","يَتّقي الهَولَ منهُ طَوراً، وطوراً","جودهُ سعدٌ لكلّ شقيِّ"],["77FA1854-0346-51DB-990C-F48514C5029B","يقسِمُ الدُّولَ بالسَّطا والعَطايا","بينَ يومي إقامةٍ ومطيِّ"]]},"195A6C43-9393-5501-9F39-F2F8B47112E3":{"t":"يبشرني قومٌ برتبتِكَ التي","p":191,"s":"يبشرني قوم برتبتك التي","r":"445518","v":[["940EEE6F-4463-5816-B8F5-3AACEAC7CCFE","يبشرني قومٌ برتبتِكَ التي","تمَنّيتُ فيها السُّؤلَ حتى لقيتُه"],["B394B25E-030C-598C-A595-F328934168FF","فبَشّرتُ نَفسي بالسّرورِ ولم أزَلْ","أُهَنّي بك القلبَ الذي أنتَ قوتُه"],["F8671CF0-2EC7-5E3F-BBD8-154547AA2CF6","وقلتُ لهم أعلى الإلهُ محلهُ،","وهذا دُعاءٌ لو سكَتُّ كُفيتُه"]]},"61798AC1-F11B-5439-B250-54147309A4BD":{"t":"يحفظُ في الجوعِ ألفَ منفعةٍ","p":191,"s":"يحفظ في الجوع ألف منفعة","r":"446093","v":[["E7B169ED-72D2-5B21-AEE7-B5572E3780E2","يحفظُ في الجوعِ ألفَ منفعةٍ،","ومثلها في مضرةِ البطنهْ"],["9998205F-6A9F-58C3-AAE6-C4A7210B4CCD","ويُوهمُ النّاسَ أنّ شِبعَهمُ","يُطفىءُ نورَ الذّكاءِ والفِطنَه"],["0A651992-4120-587D-9F3C-D620DC81E1CB","إن حَاوَلَ الضّيفُ أن يُلِمّ بهِ","أعطاهُ من قبلِ نطقهِ القطنهْ"]]},"2901BA21-B06B-5214-A8C1-79D21E1376F9":{"t":"يعطى البليدُ مع الخمولِ من الغنى","p":191,"s":"يعطى البليد مع الخمول من الغنى","r":"446128","v":[["5694BBFF-D93F-547D-BC74-05C06BC6E3FB","يعطى البليدُ مع الخمولِ، من الغنى","ما لم ينلهُ بعقلهِ وبحسهِ"],["7D4DEA7C-049A-5A21-BE43-A98A148E7FB0","كم مدركٍ، مع عجزهِ من دهره","في يومه، ما لم ينل من أمسهِ"],["CE6A13FB-C04A-55F1-A0F2-3032AC84AF60","لكنّها الأيّامُ، في تَصريفِها،","تقضي عليهِ بسعدهِ وبنحسهِ"],["973FCA47-11BD-501B-8D5F-6A05D5CC4251","إن أقبلتْ وهبتٍْ محاسنَ غيره،","أو أدبَرَتْ سَلَبَتْ مَحاسنَ نَفسِهِ"]]},"C998A962-4B40-5CCC-B019-5A61AE7F17ED":{"t":"يقبلُ أرضاً شرفتها ركابكم","p":191,"s":"يقبل أرضا شرفتها ركابكم","r":"445970","v":[["5F0C718A-EE49-5C4E-94AB-989741E1983D","يقبلُ أرضاً شرفتها ركابكم،","ويلصقُ أحناءَ الترائبِ بالتربِ"],["5DEA778E-0E7E-5E42-A1A1-C60B3ECE8D14","ويسألكم أن لا يكونَ نصيبُه","من الردّ ردّ أجوبةِ الكتبِ"]]},"DA802A9F-D449-5990-A9F8-1B3992B5F1FE":{"t":"يقبلُ الأرضَ عبدٌ تحتَ ظلكمُ","p":191,"s":"يقبل الأرض عبد تحت ظلكم","r":"445591","v":[["73F0C1AA-683F-5958-AB51-9B9CDBD534BA","يقبلُ الأرضَ عبدٌ تحتَ ظلكمُ،","عليكمُ بعدَ فضلِ اللهِ يعتمدُ"],["1C01A1FD-DBD2-50D6-A9E7-2EDF742C0FB6","ما دارُ ميةَ من أقصَى مطالبِه،","يوماً، وأنتمْ لهُ العلياءُ والسندُ"]]},"0F039F32-C0C5-5371-9262-88ECB45C88DF":{"t":"يقولونَ لي: قد حرمَ الراحَ معشرٌ","p":191,"s":"يقولون لي: قد حرم الراح معشر","r":"445839","v":[["01301EAB-3F77-58B6-AA4C-BA2F74D58E0C","يقولونَ لي: قد حرمَ الراحَ معشرٌ،","وعزّتْ، فقلتُ: اليَومَ عَفّ إزارُها"],["DBBBE40B-B9B4-5627-9189-6DE1918D2E6B","وقالوا: حِماها قد أحاطَتْ بِهِ الظُّبَى الـ","ـمواضي، فقلتُ: الآنَ طابَ مزارُها"]]},"566E87FB-BBB8-56B5-8A93-AAFAF616929B":{"t":"يَغارُ علَيكَ قَلبي مِن عِياني","p":191,"s":"يغار عليك قلبي من عياني","r":"445735","v":[["8435B12F-1945-549F-9153-69E7C1822C89","يَغارُ علَيكَ قَلبي مِن عِياني،","فأخفي ما أكابدُ من هواكَا"],["CF33F0E7-5353-52B5-95C5-288B8EAAFFFF","مخافةَ أن أشاورَ فيكَ قلبي،","فيعلمَ أن طرفي قد رآكَا"]]},"BEECA673-98B9-5E21-BCB4-F63097DA8557":{"t":"يَقولون: طولُ البُعد يُسلي أخا الهَوَى","p":191,"s":"يقولون: طول البعد يسلي أخا الهوى","r":"445693","v":[["1D2647C4-8A0A-5AFB-B6DB-93B758F93F00","يَقولون: طولُ البُعد يُسلي أخا الهَوَى،","فقلتُ: أجل عن صِحّةِ الجسمِ والقلبِ"],["1A3C73A0-0A03-566F-A857-5C1893FFCB0F","ولو أنّ طولَ البُعدِ يُحدِثُ سَلوَةً،","لما رَغبَ العُشّاقُ يوماً إلى القُربِ"],["540A8B66-F33D-5FB7-B649-A97B09AD8347","ولكنّهم ظَنّوا التّجَلّدَ سَلوَةً،","وما علموا ما في الفؤادِ من الكربِ"],["64F645C2-36E0-5CC5-A235-DDF8D35E5F57","وقد يَصبرُ المَغلوبُ رَغماً على الأذَى،","كما يَئِسَ الظّمآنُ من لذّةِ الشُّرْبِ"]]},"F210D55F-F8B3-56B8-A0AD-E0AB37544200":{"t":"يَقولُ وقد لاثَ في خَدّهِ","p":191,"s":"يقول وقد لاث في خده","r":"445800","v":[["97367500-0597-52BC-9642-267193C6A9EC","يَقولُ، وقد لاثَ في خَدّهِ","مِداداً حكَى اللّيلَ فوقَ النّهارِ:"],["2C8CDBB5-35BE-50A6-B6BC-97683EB54F21","أتَعجَبُ ممّا جَنَتهُ يَدي،","فما كانَ ذاكَ بغيرِ اختياري"],["5800499E-CADB-5B3F-9B4B-035809F7B2F2","ولكن أرَدتُ يَرَى عاشِقي","تَضاعُفَ حُسني بنَبتِ العذارِ"]]},"3AD85163-D30D-57DA-AE84-CE5616CF3E64":{"t":"يَلَذُّ لنَفسي بَذلُ ما قد مَلَكتُهُ","p":191,"s":"يلذ لنفسي بذل ما قد ملكته","r":"445410","v":[["41E039D5-3BAB-5965-B325-ED023173008A","يَلَذُّ لنَفسي بَذلُ ما قد مَلَكتُهُ،","وبَسطُ يَدي فيما تَجَمّعَ في قَبضي"],["B85229FB-F272-5B93-8BAB-FF2E965F64D0","ولم أُبْقِ بَعضَ المالِ إلاّ لأنّني","أُسَرُّ بما فيهِ الوَقائذُ عن عِرضي"]]},"C087B32C-7954-5D31-97D7-3AA4735BDFDD":{"t":"يُسائِلُني صديقي عن كتابٍ","p":191,"s":"يسائلني صديقي عن كتاب","r":"446139","v":[["8C9386AA-45D1-5164-8A2F-ECD6FFCCC93D","يُسائِلُني صديقي عن كتابٍ،","فأنكرهُ، وأشغلُ عنهُ بالي"],["97F643C7-B1B6-585A-8E66-124E7D804C0B","وأزعمُ أنهُ خطٌّ سقيمٌ،","وطِرسٌ دارِسٌ، كالشنّ بالي"],["C65D1871-DAE3-5C88-A098-D5FC7AE4B0A8","مخافةَ أن أرومَ لهُ ارتجاعاً،","فيَقطَعَ دونَهُ حَبلَ الوِصالِ"],["2E8D67A9-E99A-53AC-AF40-59F5E0E90010","ولَستُ بواصِفٍ يَوماً حَبيباً","أعرضهُ لأهواءِ الرجالِ"]]}}}