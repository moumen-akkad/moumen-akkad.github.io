{"v":1,"poems":{"7CDB38CE-9440-5CA3-B91C-4F0500630042":{"t":"يلقاكَ بالماءِ النميرِ الفتى","p":147,"s":"يلقاك بالماء النمير الفتى","r":"448151","v":[["2AB6DD66-C813-5A72-A787-1F9557CBB735","يلقاكَ، بالماءِ النميرِ، الفتى،","وفي ضميرِ النّفسِ نارٌ تَقِدْ"],["757187A5-E4D6-5B4F-A9DA-AA6780A60020","يُعطيكَ لفظاً، ليّناً مسُّهُ،","ومثلُ حدّ السيفِ ما يَعتَقِد"],["D4B73368-5627-5BAC-A637-0F6020187DE4","ويمرَحُ الإنسانُ، منْ جَهلِهِ،","وهو أسيرٌ في رباطٍ وَقِدّ"],["9936F62A-64B3-51CE-A249-5C329857635C","كمْ حلّتِ الأيّامُ من حِيلَةٍ،","ثُمّتَ حلّتْ كلّ عَقدٍ عُقد"],["DEBD724C-1263-58C0-B29B-4904F15C7808","والمرءُ كالبائع في سُوقِه،","يأخذُ ما يُعطى ولا يَنتَقِد"],["808EDE97-8AF0-59BA-81B9-ECAC17551792","حتى إذا اليومُ انقضى ساءَهُ","ما تجِدُ النفسُ، وما يفتقِد"],["2B30A625-C7A0-5A87-A125-15305FF65625","لا أحقِدُ، الآن، على صاحبٍ،","إن رابَني، مَعدِنَ خَيرٍ حَقد"],["ACA50C7E-E960-5E3B-AB57-EB7E817093A2","فهذه الدّنيا على ما تَرى،","لم تَدِ مَقتولاً ولم تَسْتقِد"]]},"D55BF50E-7664-57BC-934C-FD5F254A0DCC":{"t":"يمرُّ الحوْلُ بعدَ الحولِ عنّي","p":147,"s":"يمر الحول بعد الحول عني","r":"448898","v":[["7239B884-ABC0-5751-9976-EBF312273FED","يمرُّ الحوْلُ، بعدَ الحولِ، عنّي،","وتلكَ مصارعُ الأقوامِ حوْلي"],["5BDED9DB-7AA2-5E3F-B20C-ABF61AE73DB9","كأنّي بالأُلى حَفَرُوا لجاري،","وقد أخذوا المَحافرَ وانتَحَوْا لي"]]},"5FA028AD-9D8D-5A04-958E-45B1916C7516":{"t":"يمرُّ بكَ الزمنُ الدّغْفليُّ","p":147,"s":"يمر بك الزمن الدغفلي","r":"447894","v":[["F15B4CEE-1017-5650-9274-B7437C6DC51F","يمرُّ بكَ الزمنُ الدّغْفليُّ،","وكم فيه منْ رجلٍ أسْنَتا"],["63552E3D-F68D-5484-92A2-FEE95F5F3229","فلا تسألِ المرءَ عن سِنّهِ،","ولا مالِه، واخْشَ أن تُعْنتَا"],["99954E4F-B860-5315-8D66-DBD489BC3E8B","ولا تَبغِيَنْ لمحةً، في الحياة،","إلى جارَتيكَ إذا كَنّتا"],["E5330864-3C7B-5B69-81CD-C5542BE95E01","فلولا مخافةُ جَنِّ الشبابِ،","وسَوءِ الغريزة، ما جُنّتا"],["6EC45B52-AA22-57F3-AC6C-B618ACCC07BE","وحَسبُكَ من مخزياتِ الفعالِ","ما شكتا منك، أو ظنّتا"],["77CA9C4A-A84B-5AFA-9378-D5AEF680F8B5","طربتُ لقُمْرِيّتَيْ مَرْبعٍ،","على غُصُنَيْ ضالةٍ غَنّتَا"],["ADD688E7-B3D0-5F15-AB62-AE8CE28B6A78","بَدَتْ لهما زَهَرَاتُ الرّبيع،","فأحسنَتا القولَ، وافتنّتَا"],["11197DE9-A5AE-543C-8C37-43B1AAAB98FF","وتعذِرُ نفسكَ عندَ الحنينِ؛","وتعذُلُ نفسكَ أن حنّتا"]]},"6C82300A-F172-5807-86E3-6B86C5604099":{"t":"يَتحارَبُ الطّبعُ الذي مُزجَتْ بهِ","p":147,"s":"يتحارب الطبع الذي مزجت به","r":"448803","v":[["0812311E-D130-5F97-9B69-9B93699CBD71","يَتحارَبُ الطّبعُ الذي مُزجَتْ بهِ","مُهَجُ الأنامِ، وعَقلُهم، فِيفلُّهُ"],["136664AB-1650-547F-9118-DD011873AEFF","ويَظَلُّ يَنظرُ، ما سَناهُ بنافعٍ،","كالشّمسِ يَسترُها الغَمامُ وظِلّه"],["7A8C7B02-F088-54BC-8170-6841359B7541","حتى إذا حَضَرَ الحِمامُ، تَبَيّنوا","أنّ الذي فَعَلوهُ جَهلٌ كلّه"],["7D872966-6AAF-5FE5-8452-3B7E6CA903D8","والعقلُ في مَعنى العِقالِ ولَفظِهِ","فالخَيرُ يَعقلُ، والسّفاهُ يحلّه"],["22CBBF26-EE92-5570-B591-45A8EC83E86D","وتَغرّبُ الشرّيرِ يُوجبُ حَتفَهُ،","مثلُ الوِجارِ، إذا تَسَحّبَ صِلّه"],["882F1C75-44D5-5567-BA10-5FB3377E0E66","ولزومُهُ الأوطانَ أبقَى للرّدَى،","كالسِّيد يُسترُ، في الضّراءِ، أزلّه"],["462D784C-87A2-5E92-ABDB-D128B62438C4","والنّفسُ آِلفَةُ الحَياةِ، فدَمعُها","يجري، لذكرِ فِراقِها، مُنْهَلّه"],["14F1DDC0-BA0E-59F6-8639-67CA0A1E0F00","ما خُلّةٌ بأغرّ منها، والفتى","يَبكي، إذا ركبَ الصّريمةَ خِلّه"],["AE743497-5F40-5A99-B978-E602B1CFB732","لا تُحجَزُ الأقدارُ، وهيَ كثيرةٌ،","كالغَيثِ وابِلُهُ يَصُوبُ وطَلّه"],["D9DC861D-827E-5E5F-9899-95244A3C538C","ومن الجنودِ، على الكميّ، جَوادُهُ،","وحُسامُهُ، وسِنانُهُ، ومِتَلّه"],["BC23515C-B0E9-545F-99EE-3BD960A16754","ميّزْ، إذا انكَلّ الغَمامُ، وميضَه،","فالبرقُ يُخبرُ أينَ يَسْقُطُ كلّه"],["EE7280BA-13B6-5C81-A734-7DF970A74926","ولقدْ علمتُ، فما أسفتُ لفائتٍ،","أنّ البَقيّةَ من مدايَ أقَلّه"],["1323EE07-56D3-58A1-A405-D90A9506E6A5","والبَرُّ يلتَمسُ الحَلالَ، ولم أجِدْ","هذا الورى، إلاّ فقيداً حِلّه"],["C3FAB761-6310-5C92-A3CB-E0242096BD11","يُمسي، وقد ملّ البَقاءَ، ويَغتَدي،","وله رَجاءٌ فيهِ ليسَ يَمَلّه"],["3EBDCB27-D809-5149-B74B-AA36DA435753","فاحفظْ أخاكَ، وإنْ تَبَيّنَ أنّهُ","بالي الوَدادِ، ضَعيفُهُ مُختَلّه"],["F04275AA-9956-51F0-9931-B9963A5BA4C9","فالغِمدُ يذعَرُ، في اللّقاءِ، كَهامُه؛","والسيف لم يُبدِ الخَبيئَةَ سَلّه"],["13E9E453-7F1A-5617-8236-57F04CBDC1C1","والبُرْدُ يكفيكَ العيونَ دريسُه","والعُضوُ يَنفَعُ، في الخطوبِ، أشلّه"],["9B6A5C78-6823-5A24-974B-F72D49B3AE82","والعمرُ لا يَدري الحَكيمُ: أكُثْرهُ","خيرٌ له متغبَّراً، أم قُلّه"],["877D8B5A-F0E7-5CD1-8B18-3C3DC301F4D7","لا تَهزأنْ بالشّيخ، كم من ليلَةٍ","جازَتْ به كالبَدرِ، يحسنُ دَلّه"],["D6F34B24-13C1-5713-946E-C0DAD77D4FC6","أيّامَ يُهتَكُ، في البطالةِ، سترُه،","كالطِّرْفِ مُزّقَ، في التمرّحِ، جُلّه"],["AB0DAB65-9454-549A-8B86-05F0D69F342B","شرُّ الزّمانِ زمانُ أشيَبَ دالفٍ،","وصِباهُ أنفَسُ وقتهِ وأجَلّه"],["E46E3145-9389-5AD5-9A0E-F24F273B8AC5","ما لي! أيَفهمُ سامعيّ نَصيحتي،","فأبِيت أنهَلُ مُصغِياً، وأعُلّه؟"],["943B747E-04C7-57C5-B492-9A26B71B0AFA","يجري بفارِسِهِ الطِّمِرُّ مُؤجَّلاً،","وإذا انقضى أجلٌ، فليس يُقِلّه"],["E05CE6F7-6221-5B44-9526-B33E692EC044","والفَقرُ بَكرٌ تَرْتقيهِ شَذاتُهُ؛","واليُسرُ عَوْدٌ ما تَسَوّرَ عَلّه"],["561B35D6-8001-5C69-8394-CCB234A53C81","أجتابُ شَهراً أوّلاً؛ فأُبيدُهُ،","ويجيءُ ثانٍ، بعدَهُ، فأُهِلّه"],["0F131DA5-30E5-5D4B-8571-4EAE777E3FFD","يُمسي، على حدّ المُهَنّدِ، أخمَصي،","فترى اليَسيرَ من، من الأمورِ، يُزلّه"],["79DB8B4B-008F-5A6D-9483-748B81E8D40F","والنّاس جائرُ مسلكٍ مُسترشدٌ،","وأخٌ، على غيرِ الطّريقِ، يدلّه"]]},"F93EDEA8-8321-598F-89A7-B11D0004C8D4":{"t":"يَتلونَ أسفارَهمْ والحَقُّ يُخبرُني","p":147,"s":"يتلون أسفارهم والحق يخبرني","r":"448821","v":[["5FA00E9F-37BD-523D-BB2F-A21AC1F5AE8D","يَتلونَ أسفارَهمْ، والحَقُّ يُخبرُني","بأنّ آخِرَها مَينٌ، وأوّلَها"],["864A700A-0DBE-5847-A7B1-F6D92B1A7259","صدَقتَ يا عَقلُ، فليبعَدْ أخو سَفَهٍ،","صاغَ الأحاديثَ إفكاً، أو تأوّلَها"],["B246DA8A-E82F-50B3-813C-9F28B9B892BA","وليسَ حِبرٌ ببِدْعٍ في صحابَتهِ،","إنْ سامَ نَفعاً بأخبارٍ تَقَوّلَها"],["CC69D208-F1C6-59A9-9506-B4EE007309E4","وإنّما رامَ نسواناً، تَزَوّجَها،","بما افتراهُ، وأموالاً تَمَوّلَها"],["6F499B8F-5534-590A-804E-6A3BEFBF8230","طالَ العَناءُ بكونِ الشخصِ في أُمَمٍ،","تَعُدُّ فِرْيَةَ غاويها مُعَوَّلَها"],["BC5A4301-E970-58EA-8DE2-05BF854E306A","وسوفَ يرْقُدُ، في الغبراءِ، مضطربٌ،","قد سارَ آفاقَ دُنياهُ، وجوّلَها"],["554755AB-296F-5681-92A6-F622EAE8E1DD","لأهجُرَنّكَ لا عن بِغضَةٍ سَلَفَتْ،","بل شيمَةٌ حَمَّها قدرٌ وسوّلَها"],["1DFB6352-5178-5FB2-BF17-2F5BFEB49580","وصاحبُ الشرعِ كان القُدسُ قِبلتَهُ،","صلّى إلَيها زَماناً ثمّ حَوّلَها"],["E5F9D4D1-42B1-510F-85AD-6FB03005C47F","لا يَخدَعَنّكَ داعٍ قامَ، في مَلإٍ،","بخطبَةٍ، زانَ مَعناها وطوّلَها"],["BD8C8106-69EB-52D5-8DBD-BE8138544A51","فَما العِظاتُ، وإن راعتْ، سوى حيَلٍ","من ذي مَقالٍ، على ناسٍ، تَحَوّلَها"],["639BDDF5-5B8A-5445-894A-AD05B7661765","والدّهرُ يُنسي كميَّ الحربِ صارِمَهُ،","ودِرعَهُ، وفتاةَ الحيّ مِجوَلَها"],["C8D603B5-027A-527D-8D99-F0CC2E85C8B8","ويَستردُّ من النّفسِ، التي شرُفتْ،","ما كانَ في سالفِ الأيّامِ خَوّلَها"],["6AEACD4C-0521-566F-B3D7-FD099F82E758","وجِروَلٌ صارَ تُرْباً، بَعدَ مَنطِقِهِ،","ولم يُشابهْ، من الصّحراءِ، جَرْولَها"],["552D6044-8547-5D61-9927-CD39C14E9239","قَضِّ الزّمانَ بإجمالٍ وتَمشِيَةٍ","للأمرِ، إنّ وراءَ الرّوحِ مِغوَلَها"],["BCE6C580-CC5D-5B4C-9F46-EFDAFDD33790","والوِرْدُ، يكفيكَ، منه شَرْبةٌ حُملتْ","في الرّكبِ، إن منعتكَ الأرضُ جدوَلَها"]]},"FB4FD132-779B-57A5-92AF-E89E7A68D827":{"t":"يَحِلُّ بمَهْرٍ رَحيقُ الرُّضاب","p":147,"s":"يحل بمهر رحيق الرضاب","r":"447863","v":[["34D0D43A-1779-5F4C-BF76-1C7B1C28A1E7","يَحِلُّ بمَهْرٍ رَحيقُ الرُّضاب،","وليسَ يحلُّ رَحيقُ العِنَبْ"],["5156BA1D-9586-556B-887C-53F0AC65E561","يُعيدُ الفتى، كالذي نابَه","جنونٌ، على أنهُ لم يُنِبْ"],["00491B5E-913F-5DE0-BCE6-8219B4A41C19","وما أخذَ العَقلَ منْ أهلِهِ،","وإنْ هو غرَّ اللَّمى والشّنَبْ"]]},"BDEB1E47-96D2-560C-B7B0-71432E5FE558":{"t":"يَدعُو الغرابَ أناسٌ حاتماً سفهاً","p":147,"s":"يدعو الغراب أناس حاتما سفها","r":"449000","v":[["D63955A3-4E4C-5277-A4B7-198652BB2EAA","يَدعُو الغرابَ أناسٌ حاتماً سفهاً","لأنّهُ بفِراقٍ عندَهمْ حَتَما"],["780E3EF3-A898-5726-98FA-37F535AC2F26","هذا التكذّبُ، ما للجَوْنِ مَعرِفةٌ،","ولا يُبالي أنالَ المَدحَ أمْ شُتما"],["F957BB42-2681-5A8A-88BE-A57B5C3D53D1","السّيّدُ البَرُّ مَن لا يستَجيزُ أذى","ولا يَبوحُ بسرٍّ، عندَهُ، كُتِما"],["4559128F-6036-5C70-B71C-9B91427BFB19","الغامِرُ، الطّارِقُ المُحتاجَ نائِلُهُ،","أو ابنَ مِريَةَ من أُمّاتِهِ يَتِما"],["9D9E23C8-3D19-5D6D-B6ED-09DC1F3292C4","لا يرفعُ الصّوت بالقولِ الهَراءِ ضُحًى","ولا يَدِبُّ إلى جاراتِهِ عَتَما"],["FDFB031F-7204-58FB-82E5-A9E40043184C","والعمرُ كالذّابلِ الخَطّيّ، قد بُسطتْ","له كعوبٌ، ولكنْ بالرّدَى خُتِما"]]},"49A1F7B0-E8D9-5C6A-9340-A25047E44BED":{"t":"يَستأسِدُ النّبتُ الغضيضُ فلا تلُمْ","p":147,"s":"يستأسد النبت الغضيض فلا تلم","r":"448093","v":[["76E49318-DE04-5E18-A5D0-A4BDFB6F96CB","يَستأسِدُ النّبتُ الغضيضُ، فلا تلُمْ","رَجُلاً، متى أبصَرْتَهُ مُستأسِدَا"],["75A67E8A-2BE3-59DC-BE25-5114347B2DF8","وإذا حُسِدْتَ، فإنّ شكرَ فضيلةٍ","أنْ لا تُؤاخذَ، في الإساءةِ، حاسدا"],["50840AC0-CF1E-5EE7-9132-B98A8AE84FDD","ومن الرّزيّةِ أنْ تبيتَ مُكلَّفاً","إصلاحَ مَنْ صحِبَ الغريزَةَ، فاسدا"],["4A35EE59-7D5F-5F58-9342-EEB875BEB635","والدّينُ متجَرُ ميّتٍ، فلذاكَ لا","تُلفيهِ، في الأحياءِ، إلاّ كاسِدا"]]},"658EBDEB-78BD-5224-82AB-154ED1772686":{"t":"يَسودُ النّاسَ زيدٌ بعدَ عَمرٍو","p":147,"s":"يسود الناس زيد بعد عمرو","r":"448830","v":[["55BD6EC1-19D6-595C-B9D9-A3915CDEA226","يَسودُ النّاسَ زيدٌ، بعدَ عَمرٍو،","كَذاكَ تَقَلُّبُ الدّولاتِ دُولَهْ"],["521375F3-854F-5683-AB9D-34E195AE8FD2","ورُبّ شَهادَةٍ وَرَدتْ بِزُورٍ،","أقامَ لنَصّها القاضي عُدولَهْ"],["4368A1D2-2CBC-506B-9EC0-5CF33EFAF731","ومن شرّ البرِيّةِ ربُّ مُلكٍ،","يُريدُ رعيّةً أن يسجدُوا لَهْ"]]},"39DE02D9-8279-5539-967A-4DCFEAB88FF7":{"t":"يَسوسونَ الأمورَ بغَيرِ عَقلٍ","p":147,"s":"يسوسون الأمور بغير عقل","r":"448469","v":[["AECEDFA8-1E6C-523A-A273-2E975ACED088","يَسوسونَ الأمورَ بغَيرِ عَقلٍ","فينفُذُ أمرُهم، ويقالُ: ساسَهْ"],["CB624D25-FFCB-5EFF-82B6-2FB9B150AF0D","فأُفَّ من الحياةِ، وأُفَّ مني،","ومن زمَنٍ رئاستُهُ خَساسَهْ"]]},"29F3B114-F6C5-5756-8DAD-D263C6FBCDD8":{"t":"يَصونُ الحِجى والبَذلُ أعراضَ معشرٍ","p":147,"s":"يصون الحجى والبذل أعراض معشر","r":"448780","v":[["24EA4B90-14A4-5493-8725-3F5B3566C4E0","يَصونُ الحِجى والبَذلُ أعراضَ معشرٍ؛","وأينَ يُرى العِرْضُ الذي ليس يُبذلُ؟"],["C1A64C2A-FD43-5AF9-A66B-E9B430DC0D18","وصاحبُ نُكرٍ، باتَ يُعْذَرُ بَينَنا،","وفاعلُ مَعرُوفٍ يُلامُ ويُعذَل"],["8EE37062-412C-53BA-A3BD-3F07B45AB899","وقِدْماً وجَدْنا مُبطِلَ القوم يعتَدي،","فيُنصَرُ، والغادي معَ الحَقّ يُخذل"],["474C7D19-809B-536C-BBF7-DB1D3F8F0651","فإنْ يَكُ رَذلاً عصرُنا وأنامُهُ،","فَما بَعدَ هذا العَصرِ شَرُّ وأرْذل"]]},"8BED53A4-708B-586B-BE6B-98AE37C2D85C":{"t":"يَعرى اللّئيمُ من الثّناءِ ويكتَسي","p":147,"s":"يعرى اللئيم من الثناء ويكتسي","r":"448379","v":[["5B91BA5A-F2B5-5878-B492-35F8159C84FE","يَعرى اللّئيمُ من الثّناءِ، ويكتَسي","حُلَلَ النّواسجِ، فهوَ كاسٍ عارِ"],["A0AA2ED1-348B-5565-921E-55958540D45F","والدّهرُ لم يَشعُرْ بما هوَ كائِنٌ","فيهِ، فكيفَ يُذمُّ في الأشعار؟"],["81BBADD2-C0DE-59D7-87DE-FF59181D19D3","ما استُرجِعَتْ هبةُ الحياةِ من الفتى،","بل كانَ ما يُعطاهُ رَدَّ مُعار"]]},"7CCEF153-A0E0-5FFA-B0EC-E6E9F62EB0D9":{"t":"يَعيبُ أُناسٌ أنّ قوماً تجرّدوا","p":147,"s":"يعيب أناس أن قوما تجردوا","r":"448308","v":[["79BB032C-E4AD-5BBE-AF37-15038B7E4C84","يَعيبُ أُناسٌ أنّ قوماً تجرّدوا","لحَمّامِهم، نُصبَ العيون الشّوازِرِ"],["6626F38D-FCAC-5BAA-AC35-CE11BDB2FD72","لقد سَعِدوا، إن كان لم يَجرِ، عندَهم","من الوِزْرِ، إلاّ تَرْكُهُمْ للمآزِرِ"]]},"AF9DFE49-2E8D-534D-BBD2-2416AA79178C":{"t":"يَقولونَ: إنّ الجسمَ يَنقُلُ روحَه","p":147,"s":"يقولون: إن الجسم ينقل روحه","r":"448779","v":[["9F91BBEF-B6B6-52BC-804B-4F2FB33814D3","يَقولونَ: إنّ الجسمَ يَنقُلُ روحَه","إلى غَيرِهِ، حتى يُهَذّبَها النّقلُ"],["1DF0D1FE-7393-5532-B402-726CE60B8DB3","فلا تَقبَلَنْ ما يُخبرُونَكَ ضِلّةً،","إذا لم يُؤيّدْ، ما أتَوكَ به، العقل"],["52FF020A-BF0B-566A-9D5F-04E9FEBF0B86","وليسَ جسومٌ كالنّخيلِ، وإن سما","بها الفرعُ، إلاّ مثلَ ما نَبَت البقل"],["59ACF2F4-7887-581B-A22F-5AC6E50722A6","فعِشْ وادِعاً وارفُقْ بنفسِكَ طالباً،","فإنّ حُسامَ الهِندِ يَنهَكُهُ الصّقل"]]},"557F13C2-E960-5415-85D5-4369AD307115":{"t":"يَقولونَ: في المِصرِ العُدولُ وإنّما","p":147,"s":"يقولون: في المصر العدول وإنما","r":"448702","v":[["4258E521-6B42-5166-8333-783B0449CAB9","يَقولونَ: في المِصرِ العُدولُ، وإنّما","حَقيقةُ ما قالوا: العدولُ عن الحَقِّ"],["A2B9A7A1-AFD3-54AF-BB41-CD5EE08C3BD9","ولَستُ بمُختارٍ لقَوميَ كَونَهم","قُضاةً، ولا وَضعَ الشّهادةِ في رِقِّ"]]},"CC382880-2FF9-563A-929E-C9F46B869E14":{"t":"يَقولُ النّاسُ: إنّ الخَمرَ تُودي","p":147,"s":"يقول الناس: إن الخمر تودي","r":"449062","v":[["E9C8DEDB-9FBE-52A5-A50E-E43D293BEB7F","يَقولُ النّاسُ: إنّ الخَمرَ تُودي","بما في الصّدرِ من هَمٍّ قديمٍ"],["A8C0D96C-1662-5AFF-B3BE-EC8F27895132","ولَوْلا أنّها باللُّبّ تُودي،","لَكُنتُ أخا المُدامَةِ والنّديم"]]},"7402B72A-BC1B-57A7-AEE7-CD4F2A0BE88C":{"t":"يَنسَى الحَوادثَ أفتانا وأكبرُنا","p":147,"s":"ينسى الحوادث أفتانا وأكبرنا","r":"449130","v":[["D59BCCC5-B236-5721-926A-7BC171C237CE","يَنسَى الحَوادثَ أفتانا وأكبرُنا،","ولنْ تُصِيبَ فؤاداً حامِلاً حَزَنا"],["9A9D6FF3-767A-52E5-87FB-AA0446F455B1","لا يَفرَحَنّ، بهذا المالِ، جامعُهُ،","ليُحزِنَنّكَ صافي التّبرِ إنْ خُزِنا"],["AB87C231-01AA-57B9-8A37-5158626A7E46","يُعَدُّ بَيتُ نُضارٍ بيتَ قافَيةٍ،","لو زالَ منهُ القَليلُ النّزرُ ما اتّزَنا"]]},"7E158443-9081-5514-9018-17EE0F64AF3A":{"t":"يَهابُ الناسُ إيجافَ المنايا","p":147,"s":"يهاب الناس إيجاف المنايا","r":"447826","v":[["B27370F3-B96D-574F-967C-562CF1D5E27A","يَهابُ الناسُ إيجافَ المنايا،","وهل حادَ القضاء عن الهَيوب؟"],["F30C4001-894A-59F2-91AB-3EE69F5F959A","إذا كشّفْتَ أجناسَ البرايا،","وجدتَ العالمينَ ذوي عيوب"],["B23ACF8F-D407-53E1-B95C-B19FBFC48944","ذيولُهمُ كثيراتُ المخازي،","لما فقَدوه من نُصحِ الجيوب"],["7D30219D-49D9-5018-92D7-08C6E21A603F","تحدّثُكَ الظّنونُ بما تلاقي،","كأنّ الظّنّ علاّمُ الغيوب"]]},"91D484C5-A12D-57DD-91E3-010FB47F7124":{"t":"يَودُّ الفتى أنّ الحياةَ بسيطةٌ","p":147,"s":"يود الفتى أن الحياة بسيطة","r":"448029","v":[["50F38745-8FF7-5041-9940-7A0982F1FB6E","يَودُّ الفتى أنّ الحياةَ بسيطةٌ؛","وأنّ شقاءَ العيش ليسَ يبيدُ"],["986D91D0-B5B0-568F-9147-1B762ECBAB69","كذاكَ نَعامُ القفر يخشى من الردى،","وقوتاهُ: مَرْوٌ، بالفلا، وهبيدُ"],["B20833FD-5E15-55FC-AB0F-6848C67B28B0","وقد يخطىء الرأيَ امرؤٌ، وهو حازمٌ،","كما اختلّ، في وزن القريض، عبيد"],["4ADE6A7A-1EB5-54B1-A614-258EF5A40D76","مضى الواقفُ الكِنديّ، والسِّقطُ غابرٌ،","وصاحتْ ديارُ الحيّ: أينَ لبيد؟"],["39B2BAF3-0CC8-5DEE-803C-B01A3A5F281B","تولّى ابنُ حُجْرٍ، لا يعودُ لشأنِه،","وطالتْ ليالٍ، والمعالمُ بيدُ"]]},"CDFD9057-E632-5853-B4ED-D2EDF81B5B45":{"t":"يُباينُ شكلٌ غيرَه في حَياتِه","p":147,"s":"يباين شكل غيره في حياته","r":"448688","v":[["CD7CFADB-8C4D-5A23-8374-33D18C3C23DB","يُباينُ شكلٌ غيرَه، في حَياتِه،","فإنْ هَلَكا، لم تُلفِ، بينهما، فَرْقا"],["14766A55-8866-5767-BD21-7A0CE20B0A06","ومَن يَفتَقِدْ حالَ الزّمانِ وأهلَه،","يذُمُّ بهم غَرْباً، من الأرضِ، أو شرقا"],["02053F4B-82DE-5FF2-95B1-1E6977827C9E","يجدْ قولَهمْ مَيناً، ووِدَّهُمُ قِلًى،","وخَيرَهمُ شرّاً، وصَنعَتَهمْ خُرْقا"],["C07A8F8B-FBA8-53F2-840A-5BCA49CE1EE7","وبِشرَهُمُ خَدْعاً، وفَقرَهمُ غِنىً،","وعِلمَهمُ جَهلاً، وحِكمتَهم زَرقا"],["B018B07D-BE65-5511-BE1D-39FAF09123C6","أحيَّ كلابٍ! كم رعَى النّبتَ قَبلكم","فريقٌ، وشاموا، في حَنادِسهم، برْقا"],["5DC195D5-2288-5812-8513-7063D712B75C","وصابوا على عافٍ، وآبوا إلى رضًى،","وجابُوا إلى عَلياءَ نازحةٍ خَرْقا"],["DFD78066-56E8-5071-B24C-BE124C037342","وليلاً طَلَى قاراً بقارٍ، وأُكمُهُ","مراقبَةٌ، من شُهبِه، حَدَقاً زُرْقا"],["16DC3024-9C96-5FCD-A161-B8170A6056B3","إذا نَشأتْ فيهِ الغَمامةُ خِلتَها،","بإيماضِها، زِنجِيّةً فصَدَتْ عِرْقا"],["BE1FB21F-B39C-56A1-B151-249E3CD7E13F","ومَرّوا بمقصودِ الحِمامِ، فغادروا","خوالِدَ ضمّتْ فيهِ أفرُخَها الوُرْقا"],["26273AD4-00A3-5446-99F2-FF4076430247","رأينا شؤونَ الدّهرِ خَفضاً ورِفعَةً،","ونحنُ أُسارى، في الحوادثِ، أو غرْقى"],["44E25EE0-86F0-5BBE-AF30-44CD5066557F","هوى مُعتلٍ، كالغيثِ مِ المُزْنِ، واعتلى","خفيضٌ، كنقعٍ، من لدُنْ حافرٍ، يرْقى"],["77E68639-D032-5D94-9F3F-A9ADA9157933","فَلا تأمَنوا شاميّةً يَمَنيّةً","تُعادي، فلا تُبقي خِباءً ولا فِرقا"],["903FFEDF-2361-5ACF-B765-1E3F988A65DA","يُخَرِّقُ، دِرْعَ المَرءِ، سمرُ رِماحِها،","وإنْ كانَ مُرّاً، في مَذاقته، خَرقا"],["FAA21F90-77B4-5CEF-9452-2ECB051C3DD3","إذا طَلَبوا أقصى العُلا اتّخَذوا له،","بصُمّ العَوالي، في ترائبِكم، طُرْقا"],["C9B9A716-694C-57A1-BBB1-E620E8529906","إذا كُنتُمُ أوراقَ أثلٍ زَهَوْا لكُمْ","جَرادَ نِبالٍ، كيْ تُبيدَكمُ، وَرْقا"],["C7B3F64F-DF13-5A3A-B065-E311CF847E72","أطارِقَ همٍّ ضافَ، هل أنتَ عاذِرٌ،","متى لم تجدْ بي، عند مرتحلٍ، طِرقا؟"],["AD8CD662-016F-5EA5-AAB2-5BF4C91333B8","وأعوَزَني ماءٌ أُزيلُ بهِ الصّدَى،","فلا عيشَ، إنْ لم أشرَبِ الكدِرَ الطَّرْقا"],["AD3537B2-B95D-54B6-AF85-E55072B2DB0F","همُ النّاسُ، أجبالٌ شوامخُ في الذُّرى،","وأوديَةٌ لا تَبلُغُ الأُكمَ والبُرْقا"],["0F7ADC6E-DEAC-5923-94F2-EAC083E7A298","فسكرانُ يُسترقَى، ويبذُلُ بُسلَةً،","وآخرُ صاحي اللُّبّ، يغضَبُ أن يُرْقى"]]},"02DA3818-46DF-572F-ADAA-A809313A5698":{"t":"يُجَلُّ المَلكُ عن نَظمٍ ونَثرِ","p":147,"s":"يجل الملك عن نظم ونثر","r":"448337","v":[["17539F5C-81F1-5FFF-B212-A0A8A35BA1A8","يُجَلُّ المَلكُ عن نَظمٍ ونَثرِ،","وعنْ خَبرٍ تحدِّثُهُ بأثْرِ"],["D65B888D-5B14-5AE1-82AE-0C2C23B16730","وتضؤُلُ فيه هذي الشّمسُ، حتى","تَعودَ كأنّها دينارُ عَثرِ"],["33EDF509-66AF-5565-B379-4E5A01B59072","وكم دَثَرَتْ مَغانٍ منْ أُناسٍ،","وقد ضاقَتْ بذي لَجَبٍ ودَثْر"],["F229F84D-E8E0-56F6-BE5B-2DCBA50DE3A8","إذا أثْرَيْتَ من صبرٍ جَميلٍ،","فأنْتَ، وإنْ فَقَدْتَ المالَ، مُثر"],["47201291-CCA3-5DA3-86F9-A9AB6F91C912","كثيرٌ، منْ تكبّرَ بالمَعالي","على ما كانَ من قُلٍّ وكُثرِ"],["EDD6B4C6-A4F1-5006-84A2-3DD410FBF924","أُحاولُ، من بني الدّنيا، صلاحاً،","وتأبَى أن تُجيبَ نفوسُ غُثر"],["FA1574B3-2B72-5B3F-8635-6E0C462EBA02","وأُوثِرُ أن أصونَهُمُ بجُهْدي،","وكيفَ إثارَتي والمَوتُ إثري؟"],["372DD026-8AF0-5435-AB9A-0FC117F7208D","أُحاذِرُ، في الزّمان الرّغدِ، جَدْباً","وآمُلُ، في الجُدوبِ، زمان طَثر"],["20E556E0-152F-530E-BFBB-139E388BBF57","وبَثْرٌ مائحُ الحِدْثانِ يَطمو،","إذا التَقَتِ المياهُ بكلّ بثر"],["6447A657-C22A-5BF0-86D3-275AA5AB6448","ولو أني عَثَرْتُ على الثّرَيّا،","لكُنتُ مُحالِفاً زَللي وعَثري"],["078B87AA-98C8-5A37-B31C-C9661CCD0CFD","وأهلُ حَزُونَةٍ حَزِنوا، وسهلٍ","تَسَلَّوا أن ثوَوْا بثرًى دِمَثر"]]},"6FC02FFD-3960-5B7D-9593-326CC76A1B32":{"t":"يُحقُّ كسادُ الشعرِ في كلّ موطنٍ","p":147,"s":"يحق كساد الشعر في كل موطن","r":"448022","v":[["BE194D9E-F390-5C1E-8360-AD207A0A105B","يُحقُّ كسادُ الشعرِ في كلّ موطنٍ،","إذا نفَقَت هذي العروضُ الكواسِدُ"],["4AC96CF1-3638-5269-ACCB-B5BD5A86E119","عُفاةُ القَوافي، كالذي ولُماتِها،","إذا هنّ لم يُوصَلنَ، فاللّفظُ فاسد"],["FD7CBA73-0591-5962-A92F-81178CB4AB5E","ومن عاشَ بين النّاس لم يخلُ من أذًى","بما قال واشٍ، أو تكلم حاسد"],["8E07D2A4-A69B-53FA-9BD4-AC468C186F6F","وليس جِسادٌ في ترائبِ كاعبٍ،","كأحمرَ منه مضربُ السيفِ جاسدُ"]]},"875A94C9-7A66-52F4-B1BF-3EBC6A99FED6":{"t":"يُخَبّرونَكَ عن رَبّ العُلى كذِباً","p":147,"s":"يخبرونك عن رب العلى كذبا","r":"449108","v":[["7C40574D-CCAA-5226-8A90-865A8AFC9360","يُخَبّرونَكَ عن رَبّ العُلى كذِباً،","وما دَرى بشؤونِ اللَّهِ إنسانُ"],["B68DA30B-C91D-5ACD-9D7D-D8F13248FA00","وبالقضاءِ، لآسادِ الشّرى، لجُمٌ،","وللوُحُوش، بإذنِ اللَّهِ، أرسان"],["1C310358-EF05-5EAB-83B9-B7D95983B4B0","فألسِنُوني أُبَيّنْ مُشكِلاتِكُمُ،","أمْ ليسَ فيكمْ، لأهل الحقّ، إلسان؟"],["BE579A17-279B-5827-A2E0-2A55C107B262","هَل تَسمَعُونَ، فإنّي فارِسٌ، أرَبي","من الفِراسَةِ، إذ للحربِ فُرسان"],["5B4D88FB-6390-56B9-B60B-96493859DB7D","ما كانَ، في هذه الدّنيا، أخو رَشَدٍ","ولا يكونُ، ولا في الدّهرِ، إحسان"],["8978AD93-EA69-59A8-97AC-8CE27C76A2F8","وإنّما يتَقَضّى المُلكُ عن غِيَرٍ،","كما تَقَضّتْ بَنو نَصرٍ وغَسّان"],["C3CFE353-5BAC-5697-BF11-0BB89F9AADC2","حسّتهُمُ حادثاتٌ لم تبنْ أسَفاً،","كأنْ تأسّفَ إثرَ القومِ حسّان"],["5DA2DDAF-EA46-5AA0-87BE-A20F767419F5","بَنُو أُمَيّةَ، بالشّامَينِ، دِينَ لهم،","والهاشميّونَ والَتْهُمْ خُراسان"],["899DB6F6-397A-579E-BA9C-D9C9BE6B0918","ولَستُ آمَنُ أن يُدْعى إمامُكُمُ،","من عالةِ الزّنجِ، أو رَبَّتهُ مَيسان"],["12D15C12-F64E-5773-BC20-4F59221C7DF0","والرّأيُ أن تَبعَثُ الأنضاءُ واحدةً","إلى دِمشقَ، فبئسَ الدّارُ بِيسان"]]},"A6175A5A-4772-5D1D-8BF8-AE4070AEBDAE":{"t":"يُسمُّون بالجهْلِ عبدَ الرّحيم","p":147,"s":"يسمون بالجهل عبد الرحيم","r":"448153","v":[["07CEDBE7-6750-5A7F-BB0C-3ED1A4004970","يُسمُّون بالجهْلِ عبدَ الرّحيم،","وعبدَ العزيز، وعبدَ الصَّمدْ"],["719FFBFB-2E34-57E8-979B-AAEF107E8F47","وما بلَغُوا أن يكونوا لهُ","عبيداً، وذلك أقصى الأمَد"],["2C561597-A6C7-5240-A1E3-292A8C818CFF","ولكنّهُ خالقُ العالمينَ:","ذائبِ أجزائهمْ، والجَمَد"],["408DEFE7-A775-55D8-A5A1-A5D26DD1143E","تعمّدْهُ يُغنِكَ، بالهَدْي، أن","تُدرِّسَ مغنيَّهُم، والعُمَد"],["CF945026-99A9-599D-83D1-2692E3221CD9","إذا كان ما نالني، بالقَضاءِ،","فمن سُوءِ رَأييَ طولُ الكمَد"],["7CFC1070-D132-5AC3-B039-950790C8F78D","ولم يبقَ، في الأمر، منْ حيلةٍ،","فيُقصَرَ منْ عُمُرٍ، أو يُمدّ"],["5C1664C3-DA1E-5238-A138-FEF1B42067EE","وإنّ ثموداً أتتْ، بحرَهُمْ،","خُطوبٌ، فما تركتْ من ثَمَد"],["3A456C27-619D-5FC4-864D-97201BA3BF38","رأيتُ الفتى شَبّ حتى انتهَى،","وما زالَ يَفنى إلى أنْ همَد"],["9860636F-1D7A-583D-876C-427BB344310B","كمصباحِ ليلٍ بدا يَستَنيرُ،","ثمّ تَناقصَ حتى خَمَد"],["7E392DE1-D33F-50DB-9897-E909FDFF1FD5","ولولا الذي بانَ من حُكمِهِ،","لقُلنا: طويلُ زمانٍ سَمَد"],["D724EAFD-2194-5584-992E-7241BD9BB858","إذا طَفِئَتْ في الثّرى أعينٌ،","فقدْ أمِنتْ منْ عمًى أو رمد"]]},"FCFC044B-CC2C-5F1D-B181-87FB10DB5103":{"t":"يُسيءُ امرؤٌ منّا فيُبغَضُ دائماً","p":147,"s":"يسيء امرؤ منا فيبغض دائما","r":"448674","v":[["2DF0D6CF-11A0-55FA-AF13-5ED3E9D9C583","يُسيءُ امرؤٌ منّا، فيُبغَضُ دائماً،","ودُنياكَ ما زالتْ تُسيءُ وتومَقُ"],["74BF9463-5745-539C-A31C-3F662DADD60D","أسرّ هَواها الشّيخُ والكَهلُ والفتى،","بجَهلٍ، فمِنْ كلّ النّواظرِ تُرْمَقُ"],["E328DE33-C5A5-518B-8524-937D92616DE5","وما هيَ أهلٌ أن يؤهَّلَ مثلُها","لوُدٍّ، ولكنّ ابنَ آدَمَ أحمَقُ"]]},"96BE9E91-E0CF-5AEE-B9B8-85B8657E43EA":{"t":"يُشَجُّ بنو آدمٍ بالصّخور","p":147,"s":"يشج بنو آدم بالصخور","r":"447977","v":[["163F07DD-2F3E-5F3E-9E00-F05C940646C7","يُشَجُّ بنو آدمٍ بالصّخور؛","وإنّ المدامَ بماءٍ تُشَجّ"],["6FD34190-32D2-578B-8B28-AD85F73E1C71","فما نَزلَ اليُمْنُ في شَربها،","ولا في وعاءِ سُلافٍ نَشَجْ"]]},"D545EB98-9C5F-5FBD-A45F-7CB3F0283A15":{"t":"يُضحي الفتى المرؤوسُ بالسَّيِّدِ الـ","p":147,"s":"يضحي الفتى المرؤوس بالسيد الـ","r":"449071","v":[["CE46EF2D-8254-596E-B348-1C7F2E2E6899","يُضحي الفتى المرؤوسُ بالسَّيِّدِ الـ","ـماجِدِ، كالمَرؤوسِ بالصّارِمِ"],["A84D1F3C-A020-5E8D-A6FD-BA37F1840706","غريزَةٌ، في النّاسِ، مَعروفَةٌ،","تُنقَلُ للمَكرُومِ بالكارِم"],["3233EB3C-F90F-5A78-883C-0250772084EC","والدّهرُ لا يَنكِرُ تَسويدَهُ","بَني كُلَيبٍ لبَني دارِم"],["CE4525C6-E3B7-5AD9-BE49-A7A8196A1F4B","ويخمَصُ الإنسانُ من نَخوَةٍ،","ساكِنَةٍ في أنفِهِ الوارِم"],["B27E4011-B654-52D1-B216-343F82C74617","بَيتُ العُلى بيتُ قريضٍ، ولا","بُدّ من الكاسرِ والخارِم"],["41115BE1-46B3-59E2-A1A6-ED4B86642C3B","إن يُحرَمِ السّائلُ عندي جَداً،","فلَستُ، عندَ اللَّهِ، بالحارِم"],["5DE649B3-68C7-58A5-9D90-53216D888DF9","لو كنتُ أسطيعُ لهُ راحَةً،","راحَ بها في عامِهِ العارِم"],["2FD3ED0D-9AC7-5953-A890-6CD4225B66DA","صدّ زكاةَ المالِ من زادَ، في الـ","ـحالِ، عن المسكينِ والغارِم"],["1A70EA9A-3217-56C8-AD0E-16DBCD996708","والحَقُّ أن تُطلَبَ، ما بَينَنا،","جنايَةُ الجُرْمِ من الجارِم"]]},"D2A63959-5DAF-5549-99AD-4ED6D31662FE":{"t":"يُطهِّرُ الجسدَ المغرورُ صاحبُه","p":147,"s":"يطهر الجسد المغرور صاحبه","r":"448468","v":[["BF0EC27D-4C17-52EE-B0FC-B0F8D217DB22","يُطهِّرُ، الجسدَ، المغرورُ، صاحبُه،","وإنّما صِيغَ أقذاراً وأنجاسا"],["CCA6F136-BE65-572D-BE47-197136E17DDF","كم ادّعى الطُّهر ناسٌ، ثمّ كشّفهمْ","مَرُّ الزّمانِ، فكانَ القومُ أرجاسا"],["657AED4D-A1F0-53C4-91F7-98CF2024A9F5","لا يمنَعُ، الملِكَ الجبّارَ من قدَرٍ","يُغَيِّرُ الحالَ، ما أجدى وما جاسا"],["B43A3CFA-793B-5C57-BC71-2C5883EB60C5","ولو غدا الكوكبُ المِرّيخُ في يَدِه،","كالسّهم، واتّخذ البِرجيسَ برجاسا"]]},"E587142F-9E43-5F6F-98E3-2827E5933797":{"t":"يُغني الفَتى مَلبَسٌ يُسَتّرُه","p":147,"s":"يغني الفتى ملبس يستره","r":"448578","v":[["2949DF45-330D-5490-B4BD-4AA1D2FCB7DE","يُغني الفَتى مَلبَسٌ يُسَتّرُه،","وقوتُهُ في دُجَى الظّلام فقَطْ"],["D5BE0C7E-1F80-53ED-9D5A-E7D9245FE773","وحظُّهُ أن يكونَ منفَرِداً،","كَطائرٍ لا يُراعُ أينَ سَقَطْ"],["E570447D-8CCC-525C-8CFE-F0DBB2BE7AF3","لا يَلقُطُ الحَبَّ من زروعِهمُ،","وإنْ رأى حِبّةَ النّباتِ لَقَطْ"],["5066A499-EDF8-5579-BA3D-CD2D3161B5AD","فذاكَ لو طارَ في غَمامَتِهِ،","لما أصابَ الجَناحَ منهُ نُقَطْ"]]},"E480AB37-255E-57CE-B07B-D76540F1E33C":{"t":"يُغنيكَ ما حَلّ في السّجايا","p":147,"s":"يغنيك ما حل في السجايا","r":"448677","v":[["EFBB4702-E51E-5438-B42A-9E66CDD3FB53","يُغنيكَ ما حَلّ في السّجايا،","أنْ يَتَعَدّى بكَ الفُسوقُ"],["60C4DEF6-791F-5C8A-8D62-CB4DFB3F2997","كيفَ يُطيقُ النّهوضَ عادٍ،","عليه، من مأثمٍ، وُسُوقُ؟"],["A53D7BCA-EC62-55C0-9902-AB07A47C5ADC","كَم غُرِسَتْ نَخلَةٌ بأرضٍ،","فلم يُقَدَّرْ لها بُسوقُ"],["D64E3339-DE57-5A92-BD52-02A1B35C399C","لا يَفرَحَنْ، بالحَياةِ، غِرٌّ،","فإنّها، مَهْلَكاً، تسوقُ"],["4ACCC62A-B112-5012-ACFC-9829E0C37307","ما نَفَقَ الصّدْقُ في البرايا،","ولم تَزَلْ للمُحالِ سوقُ"]]},"09F830DE-4652-520E-8B29-AD2A8E6695B8":{"t":"يُقالُ: أنْ سوفَ يأتي بعدنا عصرٌ","p":147,"s":"يقال: أن سوف يأتي بعدنا عصر","r":"448965","v":[["951D5208-F807-5DB5-921F-92BADA052399","يُقالُ: أنْ سوفَ يأتي، بعدنا، عصرٌ","يُرضى، فتضبِطُ أُسْدَ الغابةِ الخُطمُ"],["ABF730BF-CC15-59C5-9FFD-AF3A7260ADBE","هيهاتَ هيهاتَ، هذا مَنطِقٌ كذِبٌ،","في كلّ صقرِ زمانٍ كائِنٌ قَطِم"],["8AF9D762-8CE8-547C-B48D-3155E09C9640","ما دامَ، في الفَلَك، المِرّيخُ، أو زُحلٌ،","فَلا يَزالُ عُبابُ الشرّ يَلتَطِم"],["C74B0071-0804-5CB2-8685-74DA8FF4F0A7","وإنْ تَغَيّرَتِ الأفلاكُ، وانعَكَستْ","بالسّعد، فالوَهدُ يُبنى فوْقَهُ الأُطُم"],["CBF07A6B-8EB3-5668-A9A9-17152BE9D20B","هبِ الفَتى نالَ أقصى ما يؤمّلُه،","ألَيسَ راعي المَنايا، خلفَه، حُطَم؟"]]},"C185A015-365E-59E1-A11D-136496A12132":{"t":"يُكسَى الوَليدُ جديدَ العُمرِ يَلبَسُه","p":147,"s":"يكسى الوليد جديد العمر يلبسه","r":"448879","v":[["79A74F79-8368-598B-9F36-F25FD56B1091","يُكسَى الوَليدُ جديدَ العُمرِ يَلبَسُه،","وكلَّ يَومٍ يَرِثُّ المَلبَسُ الغالي"],["FFFC530C-2BBB-560D-87C9-3C6697A2794B","يَظَلُّ في المَهدِ، لا يَسطيعُ جَلسَتَهُ؛","وسيرُهُ، للمَنايا، رهنُ إبغال"],["A812D64D-756E-54C5-9A26-E2D509B9A180","يَضيقُ صَدرُ الفتى ما لم يُوافِ لَهُ،","شُغلاً، فَيحتالُ للدّنيا بأشغال"]]},"7167011F-B90F-54EB-86B8-E4D91FE67B6E":{"t":"يُلامُ المُمسِكُ الإعطاءَ حتى","p":147,"s":"يلام الممسك الإعطاء حتى","r":"448890","v":[["77BFCFF0-F24C-538B-BA1B-6C0F557CFBCE","يُلامُ المُمسِكُ الإعطاءَ، حتى","جُفونٌ ما تُساعِدُ بانهِمالِ"],["593411D4-35D1-5746-8410-CF0492EAEF3B","أسيئي في فِعالٍ، أو كلام،","فقَد جرّبتِ صَبري واحتمالي"],["748F626E-5D9B-549A-922D-BFBC6D955527","إذا الحَيوانُ فُضّ العقلُ منهُ،","فَما فَضل الأنيسِ على النِّمال؟"],["D1695B90-6663-59F4-BE88-1E6C8F9D50D7","أرى زَمَناً تقادمَ غيرَ فانٍ؛","فسبحانَ المهَيمِنِ ذي الكمال"],["D958DD0E-DFFE-559E-8EE5-62CAE34A890F","قدِ اكتحلتْ عيونٌ للثّرَيّا،","بما يُرْبي على كُثُبِ الرّمال"],["F92745BF-C999-5708-8154-5A5EFDBC4AD3","غَدَوْنا سائِرينَ على وِفازٍ،","صُحاةً، مثلَ شُرّابٍ ثِمال"],["FB87A0F6-7193-57C6-B221-3125878E704D","على الفَرَسَينِ، لا فَرسَيْ رهانٍ،","أوِ الجَمَلينِ، لَيسا كالجِمال"],["49A935F7-548C-59AF-9923-732AB43DD55C","فلا يُعجَبْ، بصورته، جميلٌ","فإنّ القُبحَ يُطوى، كالجَمال"],["3858EB73-533B-5F18-A423-B196C7E52C62","وما غَضبي، إذا جَرَتِ القَضايا","بتَفضيلِ اليَمين على الشِّمال؟"],["1330033C-1CBF-51E1-8EFC-0F64CB51A8D2","كذاكَ الدّهرُ إظلامٌ وصُبْحٌ،","وريحٌ من جَنوبٍ أو شمال"],["43227E02-BF4E-5717-8910-43EF68123BD1","بلا مالٍ، عن الدّنيا، رحيلي،","وصُعلوكاً خَرجتُ بِغَيرِ مال"]]},"B0C59DEF-2A9F-5159-AECC-3C41FCC84C12":{"t":"يُنشَّرُ في الدّنيا الحديثُ ويَنطوي","p":147,"s":"ينشر في الدنيا الحديث وينطوي","r":"448442","v":[["F7C1D257-9004-58F2-B08C-260FC8A4661A","يُنشَّرُ، في الدّنيا، الحديثُ ويَنطوي،","وتَفرِسُ آسادُ العرينِ، وتُفرَسُ"],["4214B207-E3F3-5A3B-9A8A-10E76BD1553B","إذا أوجدتْ، يوماً، من الوُجد أوجدتْ","من الوَجد، هذا خُلقُها، وهو أشرس"],["14565D40-A0F3-5CFB-BAC2-47146F25D5E8","وقد يَعِظُ الإنسانَ عَيٌّ من الدّجّى،","ويُنذِرُهُ داعٍ، من الصّبحِ، أخرس"],["6E1FE366-EA0D-5DFA-B954-A353C9982461","وما حِرْصُهُ في العلم يدرسُ كُتْبَهُ،","وقد شاهدَ الآثارَ تُمحى وتُدرَسُ"],["79D74F73-7B6D-5EAE-AFA9-3E4A431C1B1C","نَسيرُ نهاراً، ثمّ نَسري، إذا دَجَتْ","علينا اللّيالي، والخَفيرُ المُعرِّس"],["4D23CC00-7F53-5C48-88C1-362D317D8AFA","ألمْ تَرَ أشجاراً تُحَرَّقُ، عَهدُها","قديمٌ، وأخرى للشّبيبَةِ تُغرَس؟"],["E8EEAEC0-1A37-51A8-A0C7-38542D685865","وتختَلِفُ الأغراضُ: ماءٌ على الصَّلى","يُحَمُّ، وماءٌ، في الشَّمالِ، يُغَّرس"],["631BF377-AA44-55DC-B480-D2BF5D6DCAD2","متى ماتحاولْ فارساً من فراسةٍ،","فإنّيَ من زيْدٍ وبسطامَ أفرس"],["8DB086F8-49A1-590B-94CB-7F9F37425E81","إخالُ، فلا أُشوي، وتلكَ فضيلةٌ،","ولكنّني بالخيلِ لا أتَمَرَّس"],["067E488A-17BD-5DCF-B159-D027B83F2CE8","ونومُك، في الصّحراء، أرْوَحُ من ذُرا","تُشادُ، وأموالٍ تُصانُ وتُحرَس"],["7EC1A8A8-0642-554C-8DAB-F70D4EF83452","وكم عُضّ مُغبَرُّ البَنانِ، تَنَدّماً","على ما جنى، قبلُ، البنانُ المورَّس"]]},"97579109-93C0-534C-BED7-BACA670954E6":{"t":"يُنَجّمونَ وما يَدرونَ لو سُئِلوا","p":147,"s":"ينجمون وما يدرون لو سئلوا","r":"448633","v":[["877D5D39-FDA7-5D4D-88C8-9F51C606E155","يُنَجّمونَ، وما يَدرونَ لو سُئِلوا","عن البَعوضةِ، أنّى منهُمُ تَقِفُ"],["80470C93-A15D-5B8C-9C26-8E21B2B7A7A4","وفرّقتهمْ، على عِلاّتِها، مِلَلٌ،","وعندَ كلّ فَريقٍ أنّهم ثَقِفُوا"],["8C4284CD-85E4-50FC-AB8C-7C0D77521A98","دَعِ البَريّةَ للخُطبانِ تأكُلُهُ،","فإنّهُمْ كَنَعامٍ فيهِ يُنتَقفُ"],["E7912F1D-699F-5736-BA05-68F38B09D845","ولو دَرَتْ، بمخازيهمْ، بيوتُهمُ،","هوَتْ عليهِمْ ولم تُنظِرْهمُ السُّقُفُ"]]}}}