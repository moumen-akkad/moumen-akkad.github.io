{"v":1,"poems":{"DB36B468-9725-585B-BAEF-6C58781AD5DD":{"t":"أضَعْتُمْ أبي إذْ قال شِقُّ وِسَادِهِ","p":9,"s":"أضعتم أبي إذ قال شق وساده","r":"436751","v":[["8CBB7C34-E6E2-599A-BFD9-A02448901961","أضَعْتُمْ أبي إذْ قال شِقُّ وِسَادِهِ","على جَنَفٍ قَدْ ضَاعَ مَنْ لم يُوَسَّدِ"],["43DA1D23-D8AB-50DD-8276-B738FC190A66","فإنْ تَطْعَنُوا الشَّيْخَ الذي لم تُفَوِّقُوا","مَنِيَّتَهُ وَغِبْتُ إذْ لَمْ أُشَهَّدِ"],["E218686C-FA73-5462-9BD0-1B44CE696E25","فَطَعْنَةُ خَلْسٍ مِنْكًمُ قَدْ تَرَكْتُها","تَمُجُّ على أقْطَارِها سُمَّ أسْوَدِ"]]},"90A1E106-D294-5084-A652-D6F8771ACE5C":{"t":"ألا أمُّ عَمْروٍ أجْمَعَتْ فاسْتَقَلَّتِ","p":9,"s":"ألا أم عمرو أجمعت فاستقلت","r":"545782","v":[["3759A165-A069-5859-B1BB-4C79C194EF1B","ألا أمُّ عَمْروٍ أجْمَعَتْ فاسْتَقَلَّتِ","وَمَا وَدَّعَتْ جِيرَانَها إذْ تَوَلَّتِ"],["3766DD3B-7B32-5F83-9FA8-D5E6A0D9C3F0","وَقَدْ سَبَقَتْنَا أمُّ عَمْرٍو بأمْرِهَا","وَكانَتْ بأعْنَاقِ المَـطِيِّ أَظَلَّتِ"],["C3ACDD2C-0D2D-594B-A943-8B064C1BA78B","بِعَيْنَيَّ ما أمْسَتْ فَبَاتَتْ فَأصْبَحَتْ","فَقَضَّتْ أمُورا فاسْتَقَلَّتْ فَوَلَّتِ"],["6B9315D6-620F-5AF8-9B38-4CE5EA5C6174","فَوَا كَبِدا على أُمَيْمَةَ بَعْدَما","طَمِعْتُ، فَهَبْهَا نِعْمَةَ العَيْشِ زَلَّتِ"],["0B98ADE3-7398-5011-9AF0-92F20D82AE8F","فَيَا جَارَتِي وأنْتِ غَيْرُ مُلِيمَةٍ","إذا ذُكِرَتْ ولا بِذَاتِ تَقَلَّتِ"],["83264A0A-D4B9-55BD-8A6D-E768AFC41029",". لَقَدْ أعْجَبَتْنِي لا سَقُوطاً قِنَاعُها","إذا مَشَتْ ولا بِذَاتِ تَلَفُّتِ"],["38F09FBB-3AFE-5FB4-9A61-E4FF78BC24C4","تَبيتُ، بُعَيْدَ النَّوْمِ، تُهْدِي غَبُوقَها","لِجَارتِها إذا الهَدِيَّةُ قَلَّتِ"],["6A1850F9-B802-56D9-9C7D-571F31B52BBE","تَحُلُّ، بِمَنْجاةٍ مِنَ اللَّوْمِ، بَيْتَها","إذا ما بُيُوتٌ بالمَذَمَّةِ حُلَّتِ"],["8EFB4B27-01A2-50A9-B0C4-15EC5F27088F","كأنّ لها في الأرْضِ نِسْيا تَقُصُّهُ","على أمُهِّا وإنْ تُكَلِّمْكَ تَبْلَتِ"],["E9AEF5F8-8D54-598F-A810-6E79684CBADC",". أمَيْمَةُ لا يُخزي نَثَـاها حَلِيلَها","إذا ذُكِرَ النّسْوَانُ عَفَّتْ وَجَلَّتْ"],["3CAD02FD-09DA-592A-8B31-25CD80F1C6DF",". إذَا هُوَ أمْسَى آبَ قُرَّةَ عَيْنِهِ","مَآبَ السَّعِيدِ لم يَسَلْ: أينَ ظَلَّتِ"],["CA0C7DB5-520B-52D8-A88E-8DB9D28B84F4",". فَدَقَّتْ،وَجَلَّتْ،واسْبَكَرَّتْ،وأُكْمِلَتْ","فَلَوْ جُنَّ إنْسَانٌ من الحُسْنِ جُنَّتِ"],["76081F3E-708F-5C20-BF9F-05CAF05DEECD","فَبِتْنَا كأنّ البَيْتَ حُجِّرَ فَوْقَنَا","بِرَيْحَانَةٍ رِيحَتْ عِشَاءً وَطُلَّتِ"],["71DC5239-F48E-5598-8A5C-E3BEBF398C24",". بِرَيْحَانَةٍ مِنْ بَطْنِ حَلْيَةَ نَوَّرَتْ","لها أَرَجٌ ما حَوْلَهَا غَيْرُ مُسْنِتِ"],["3EDC66DA-84BC-54EA-A0AC-A3338673602F",". وَبَاضِعَةٍ،حُمْرِ القِسِيِّ،بَعَثْتُها","وَمَنْ يَغْزُ يَغْنَمْ مَرَّةً، وَيُشَمَّتِ"],["6E550A83-58AD-5B4B-9496-69A500B94506","خَرَجْنَا مِنَ الوَادِي الذي بَيْنَ مِشْعَلٍ","وَبَيْنَ الجَبَا هَيْهَاتَ أنْشَأتُ سُرْبَتِي"],["C24DDF69-66BD-5377-B742-9F256F640E0E","أُمَشِّي على الأرْضِ التي لَنْ تَضُرَّنِي","لِأَنْكِيَ قَوْماً أو أُصَادِفَ حُمَّتِي"],["E5F28286-2F08-5914-9F73-A39938ECE3FC","أُمَشِّي على أيْنِ الغُزَاةِ وَبُعْدِها","يُقَرِّبُني مِنْها رَوَاحِي وَغُدْوَتي"],["2734C831-10D6-5477-8682-F74CF6A80AB9",". وَأُمُّ عِيَالٍ، قَدْ شَهِدْتُ، تَقُوتُهُمْ","إذا أَطْعَمَتْهُمْ أَوْتَحَتْ وَأَقَلَّتِ"],["8D494906-6313-56D9-B831-110B1C491575",". تَخَافُ عَلَيْنَا العَيْلَ إنْ هي أكْثَرَتْ","وَنَحْنُ جِيَاعٌ أيَّ آلٍ تَأَلَّتِ"],["D00BC901-1087-5760-AE37-B2CFF16CD283","مُصَعْلِكَةٌ لا يَقْصُرُ السِّتْرُ دُونَها","ولا تُرْتَجَى للبَيْتِ إنْ لمَْ تبَيِّتِ"],["C59A3C1D-BE5D-5F39-A850-AB081618AB3F","لَهَا وَفْضَةٌ فيها ثلاثونَ سَيْحَفا","إذا کنسَتْ أُولَى العَدِيِّ کقْشَعَرَّتِ"],["B899BABA-F128-5F7E-A42E-5585B80B14C9","وَتَأْتِي العَدِيَّ بارِزا نِصْفُ سَاقِها","تَجُولُ كَعَيْرِ العَانَة المُتَفَلِّتِ"],["A1D23826-6195-5031-A292-8E743A9A2FFA",". إذا فَزِعُوا طارَتْ بأبْيَضَ صَارِمٍ","وَرَامَتْ بما في جَفْرِها ثمَّ سَلَّتِ"],["CA339E72-18B1-5ED6-8309-B4411E2273A0","حُسَامٌ كَلَوْنِ المِلْحِ صافٍ حَدِيدُهُ","جُرَازٍ كأقْطَاعِ الغدِيرِ المُنَعَّتِ"],["4DD3EE93-1D3E-558A-9238-FFCE5F0C6521",". تَرَاهَا كأذْنَابِ الحَسِيلِ صَوَادِراً","وَقَدْ نَهِلَتْ مِنَ الدّمَاءِ وَعَلَّتِ"],["98313A55-D5E0-5891-AED2-8A2FBB709066",". قَتَلْنَا قَتِيلاً مُـحْـرِماً بِمُلَـبِّدٍ","جِمَارَ مِنىً وَسْطَ الحَجِيج الُمصَوِّتِ"],["95E694B4-D419-56F6-B950-24DE5B5EF7B0",". جَزَيْنَا سَلَامانَ بْنَ مُفْرِج قَرْضَها","بِمَا قَدَمَتْ أيْدِيهِمُ وأزَلَّتِ"],["AFEF9F68-771B-57C8-BA55-6ADC6128DC21",". وَهُنِّىء بي قَوْمٌ وما إنْ هَنَأْتُهُمْ","وأصْبَحْتُ في قَوْمٍ وَلَيْسُوا بِمَنْبِتِي"],["883C29CE-8BB6-51B8-A9F5-013C8391D34D","فَإنْ تُقْبِلوا تُقْبِلْ بِمَنْ نِيْلَ مِنْهُمُ","وإنْ تُدْبِروا فَأُمُّ مَنْ نِيْلَ فُتَّتِ"],["BD41C541-D80E-5364-A4E5-07506002F334","شَفَيْنَا بِعَبْدِ اللِه بَعْضَ غَلِيلِنَا","وَعَوْفٍ لَدَى الَمعْدَى أَوَانَ اُسْتَهَلَّتِ"],["E61DF522-C681-5376-826A-D4C7DA359825","إذا ما أتَتْنِي مِيتَتِي لم أُبَالِهَا","ولم تُذْرِ خالاتي الدُّمُوعَ وَعَمَّتِي"],["4FBF847A-BBC9-5A3A-9DDB-0C1DD041FE9E","ألاَ لا تَعُدْني إنْ تَشَكِّيْتُ خُلَّتي","شَفَاني بأعلى ذي البُرَيْقَيْنِ عَدْوَتي"],["46415B64-5FCE-5AA2-B12E-2BC33C3D8C88",". وإنّي لَحُلْوٌ إنْ أرِيدَتْ حَلَاوَتي","وَمُرُّ إذا نَفْسُ العَزُوفِ کسْتَمَرَّتِ"],["43E29033-0733-5D85-ABC0-65B6CFF88DB7",". أبيٌّ لِمَا يَأْبَى سَرِيعٌ مَباَءَتي","إلى كُلِّ نَفْسٍ تَنْتَحِي في مَسَرَّتي"],["8852CC72-A0CF-5FAE-8CBB-CE99F71FA1BC","وَلَوْ لَمْ أرِمْ في أهْلِ بَيْتي قاعِدا","أتَتْنِي إِذَنْ بَيْن العَمُودَيْنِ حُمَّتِي"]]},"0912D8AF-0F67-5F4C-9D09-93486FBDA250":{"t":"ألا هلْ أتى عنّا سعادَ ودونها","p":9,"s":"ألا هل أتى عنا سعاد ودونها","r":"436759","v":[["FF70BD1A-899F-594B-9765-93C90CE73B56","ألا هلْ أتى عنّا سعادَ ودونها","مهامهُ بيدٌ تعتلي با لصَّعالكِ"],["68112D38-B545-5C36-8E1B-D6E50CB372CD","بأنَّا صبحنا العوصَ في حرِّ دارهمْ","حِمامَ المَنايا بالسُّيوفِ البواتِكِ"],["B52ABADB-7F92-5A90-BEBE-E043478EF343","قتلنا بعمرٍو منهمُ خيرَ فارسٍ","يزيدَ وسعداً وابنَ عوفٍ بمالكِ"],["3061E964-ABFD-515C-B424-3F23BF6B7374","ظَلَلْنا نُفَرِّي بالسُّيوفِ رُؤوسَهُمْ","ونَرْشُقُهُمْ بالنَّبْلِ بَيْنَ الدَّكَادِكِ"]]},"8CC6D94F-8AC2-52BE-8629-2D3843F7B33D":{"t":"ألاَ هلْ أتى فتيانَ قومي جماعةً","p":9,"s":"ألا هل أتى فتيان قومي جماعة","r":"436760","v":[["0DCECB39-555D-57CC-BD7C-580CFB610A51","ألاَ هلْ أتى فتيانَ قومي جماعةً","بما لطمتْ كفُّ الفتاةِ هجينها"],["1F7D2E2F-7A8C-5D69-9CF7-CE0784B10F04","ولو عَلمتْ تلك الفتاة مناسبي","ووالدها ظلَّت تقاصرُ دونها"],["341253E9-9337-5724-8FA2-3E1E9037B72F","أليس أبي خيرَ الأواس وغيرها","وأمِّي آبنةَ الخيرينِ لو تعلمينها"],["A0742F21-53D7-5903-B3F0-5EA8C6CA37EB","إذا ما أرومُ الودَّ بيني وبينها","يؤمُّ بياضَ الوجه مني يمينها"]]},"BC86C28A-D13A-565F-B056-15961326E31C":{"t":"أنا السِّمْعُ الأَزَلُّ فَلاَ أُبَالِي","p":9,"s":"أنا السمع الأزل فلا أبالي","r":"436745","v":[["3B65EB58-BBA2-5428-A0E4-A77A257C0066","أنا السِّمْعُ الأَزَلُّ فَلاَ أُبَالِي","وَلَوْ صَعُبَتْ شَنَاخِيبُ العِقَابِ"],["25E6989E-9EAA-5ED6-A3E5-A74B8D692238","ولا ظَمَأُ يُؤَخِّرُني وَحَرٌّ","ولا خَمْصٌ يُقَصِّرُ مِنْ طِلَابِ"]]},"C69E6DFD-E182-59A1-85DA-0A2C5F674004":{"t":"إذا أصبحتُ بينَ جبالِ قوٍّ","p":9,"s":"إذا أصبحت بين جبال قو","r":"436761","v":[["397C5BB1-1C56-5691-9AFF-127C87C41510","إذا أصبحتُ بينَ جبالِ قوٍّ","وبيضان القرى لم تحذريني"],["8D97CBEA-B48C-5B2F-A845-62DD88548EA0","فإمّا أن تودِّينا فنرعى","أمانتكمْ وإمّا أنْ تخوني"],["6A7E1276-484A-5E6B-8DE4-7C6F7BB2249D","سأخلي للظَّعينةِ ما أرادتْ","ولستُ بحارسٍ لكِ كلَّ حينِ"],["C2818212-DF38-5F2F-8915-22B9A79B1D3B","إذا ما جئتِ ما أنهاكِ عنهُ","فلم أُنْكِرْ عَلَيْكِ فَطَلِّقِيني"],["A0CF6B23-785F-53B5-8625-4ECFF1A44818","فأنتِ البعلُ يومئذٍ فقومي","بِسَوْطِكِ لا أبا لَكِ فَکضْرِبِينِي"]]},"DEBE4B8B-D82E-532E-92FC-2F4CA768E0E2":{"t":"إذا همَّ لمْ يحذرْ منَ اللَّيلِ غمَّةً","p":9,"s":"إذا هم لم يحذر من الليل غمة","r":"436762","v":[["04E20B82-6F71-5B8A-9714-C62C99AB003B","إذا همَّ لمْ يحذرْ منَ اللَّيلِ غمَّةً","تهابُ ولم تصعبْ عليهِ المراكبُ"],["65C1936E-F1B4-5222-B81D-A710AECBCA0F","قَرَى الهَمَّ إذْ ضَافَ الزماعَ فأصْبَحَتْ","مَنَازِلُهُ تَعْتَسُّ فيها الثعالِبُ"]]},"80B57B07-44A8-5FC1-BC2A-453E6E747445":{"t":"إنَّ بالشَّعبِ الذي دونَ سلعٍ","p":9,"s":"إن بالشعب الذي دون سلع","r":"436763","v":[["E097AA01-4558-574F-A57C-43A70BE897C8","إنَّ بالشَّعبِ الذي دونَ سلعٍ","لقتيلاً دمهُ ما يطلُّ"],["C4EE4DBE-04D0-5419-A521-99376443B978","خَلَّفَ العِبْءَ عَلَيَّ، وَوَلَّى","أنا بالعبءِ لهُ مستقلُ"],["78EBAE61-8328-53C1-80B3-F30B2E042642","ووراءَ الثَّأرِ منِّيابنُ أختٍ","مَصِعٌ عُقْدَتُهُ ما تُحَلُّ"],["12CEF881-FC68-5BBF-89A5-F08C3F09787E","مُطْرِقٌ يَرْشَحُ مَوْتا كَما أَطْ","رَقَ أَفْعَى يَنْفُثُ السُّمَّ صِلُّ"],["7EC72602-1F3D-5FAB-A3C0-AC640591A4C1","خبرٌ ما نابنا مصمئلُّ","جلَّ حتَّى دقَّ فيهِ الأجلُّ"],["A06B6E7D-CFCF-5012-8B3B-0FAE52757F16","بزَّني الدّهرُ وكانَ غشوماً","بأبيٍّ جارهُ ما يذلُّ"],["C810F264-12A0-577A-9A85-6B898C89506B","شامسٌ في القرِّ حتَّى إذا ما","ذكتِ الشِّعرى فبردُ وطلُّ"],["DF8606B4-6F25-5A96-B358-D7D7D2F8C8DB","يابسُ الجنبينِ-منْ غيرِ بؤسٍ","وَنَدِيُّ الكَفَّيْنِ، شَهْمٌ، مُدِلُّ"],["13430F0D-ABC6-541F-B66A-3CF8C973CB1C","ظاعِنٌ بالحَزْمِ، حَتَّى إذا ما","حلَّ حلَّ الحزمُ حيثُ يحلُّ"],["1CD0C7BA-F9CE-56F9-947F-AFAC9F2C9888","غَيْثُ مُزْنٍ غَامِرٌ حَيْثُ يُجْدِي","وَإذا يَسْطو فَلَيْثٌ أَبَلُّ"],["6FF51A73-A4FB-5349-BD42-83A5E8973B26","مُسْبِلٌ في الحَيِّ، أَحْوَى، رِفَلُّ","وإذا يَغْزو فَسِمْعٌ أَزَلُّ"],["63E5E3CF-CDC6-57C8-8712-A11C52A86821","وَلَهُ طَعْمانِ: أَرْيٌ وَشَرْيٌ","وكلا الطَّعمينِ قدْ ذاقَ كلٌّ"],["66128111-5A67-572E-B4FA-0F886797F018","يركَبُ الهَوْلَ وَحِيدا، ولا يَص","يصحبهُ إلا اليمانيُّ الأفلُّ"],["72773FB6-441E-51F1-9E0E-732DF8630B4B","وفُتُّوٍّ هَجَّروا ثُمَّ أَسْرُوا","لَيْلَهم حَتَّى إذا انْجَابَ حَلُّوا"],["279EE6BB-15D7-5B28-A974-DC0A59F0D3D2","كلُّ ماضٍ قدْ تردَّى بماضٍ","كسنا البرقِ إذا ما يسيلُّ"],["52FB610E-D540-56C3-9A58-20DB62DE6360","فاحتسوا أنفاسَ نومٍ فلمَّا","ثملوا رعتهمُ فاشمعلُّوا"],["E21192B5-DA1D-5466-B121-52858C9044E8","فادَّرَكْنَا الثَّأْرَ مِنْهُمْ وَلَمّا","ينجُ مليِّينِ إلاّ الأقلُّ"],["0C93ECD4-8374-5514-B0E2-9A841C8DC360","فَلَئِنْ فَلَّتْ هُذَيْلٌ شَبَاهُ","لبما كانَ هذيلاً يفلُّ"],["BFBF2246-D884-5D70-ACE5-DC1989A06173","وبما أبركهمْ في مناخٍ","جَعْجَعٍ يَنْقَبُ فيهِ الأَظَلُّ"],["E25C7FCE-BFB0-5112-B405-39C1B07F56DF","وبما صبَّحها في ذراها","منهُ، بعدَ القتلِ، نهبٌ، وشلُ"],["075C35A5-9676-5A3A-9021-9EC0AC39B253","صليتْ منِّي هذيلٌ بخرقٍ","لا يملُّ السَّرُّ حتَّى يملُّ"],["664D0309-A0E0-5D50-9298-572B2E064323","ينهلُ الصَّعدةَ حتَّى إذا ما","نهلتْ كانَ لها منهُ علُّ"],["80BA4FD8-91A8-5B93-830D-3284F50EC567","تضحكُ الضَّبعُ لقتلى هذيلٍ","وترى الذِّئبَ لها يستهلُّ"],["1D7983E0-10AA-51EF-90B8-E77A84DCD7F6","وعتاقُ الطَّيرِ تهفو بطانا","تَتَخطّاهُمْ فَما تَسْتَقِلُّ"],["B2C84691-38FA-5A45-A79A-E234731AD57E","حَلَّتِ الخَمْرُ، وكانَتْ حَراما","وبلأيٍ ما ألمَّتْ تحلُّ"],["B650BCD5-CA2C-5576-A82A-46C88CACE920","فاسقنيها يا سوادَ بنَ عمرٍو","إنَّ جِسْمِي بَعْدَ خالي لَخَلُّ"],["772DA2A8-F998-5A89-AA5A-F7E67FAFC780","رائحٌ بالمَجْدِ غادٍ عَلَيْهِ","من ثيابِ الحمدِ ثوبٌ رفلُّ"],["7DBA8644-372E-5932-8147-E15F96D2BB10","أفتحُ الرَّاحةَ بالجودِ جوادً","عاشَ في جَدْوى يَدَيْهِ المُقِلُّ"]]},"7205BBCE-A435-5C41-92E5-2B6AC870F043":{"t":"بِكَفَّيِّ مِنْها لِلْبَغيضِ عُرَاضةٌ وَمَرْقَبَةٍ عَنْقَاءَ يَقْصُرُ دُونَها","p":9,"s":"بكفي منها للبغيض عراضة ومرقبة عنقاء يقصر دونها","r":"436757","v":[["44FF4E93-2863-5E64-8B20-8EACD8B3C848","بِكَفَّيِّ مِنْها لِلْبَغيضِ عُرَاضةٌ وَمَرْقَبَةٍ عَنْقَاءَ يَقْصُرُ دُونَها","أخُو الضِّرْوَةِ الرَّجْلُ الحَفِيُّ المُخَفّفُ"],["B229BD2D-1032-511F-8AC0-4F0092BD1572","نَعبْتُ إلى أدْنَى ذُرَاهَا وَقَدْ دَنَا","من اللَّيْلِ مُلْتَفُّ الحَدِيقَةِ أسْدَفُ"],["4DCB6D46-C2D7-55B5-B719-81DACB9F7895","فَِبِتُّ على حَدِّ الذِّراعينِ مُجْذِياً","كما يَتَطَوَّى الأرْقَمُ المُتَعَطِّفُ"],["B5E13194-8187-594B-9C0F-EF046846ED93","وليس جَهَازِي غَيْرُ نَعْلين أَسْحَقَتْ","صُدُورُهُما مَخْصُورَةً لا تُخَصَّفُ"],["D97798ED-072C-5E74-A9A9-2C82586343E3","وَضُنِّيَّةٍ؟ جُرْدٍ وإِخْلاَقِ رَيْطَةٍ","إذا أنْهَجَتْ مِنْ جانِبٍ لا تُكَفَّفُ"],["C817E61A-128A-58C5-BABF-02559569D815","وأبْيَضُ مِنْ ماء الحَدِيدِ مُهَنَّدٌ","مُجِذُّ لأطْرافِ السَّوَاعِدِ مِقْطَفُ"],["9F4B3C06-3466-5E0C-A94D-B01F2D78476D","وَحَمْرَاءُ مِنْ نَبْعٍ أبيٌّ ظهيرةٌ","تُرِنُّ كإرنانِ الشَّجِيَّ وَتَهْيِفُ"],["95C6D6A6-637D-588D-8209-344991F49DBF","إذا آلَ فيها النزْعُ تَأَبَى بِعَجْسِها","وَتَرْمِي بذَرْوَيْهَا بِهِنَّ فَتَقْذِفُ"],["1406897D-6937-5297-A5A2-F69523C7B94B","كَأَنَّ حَفِيفَ النَّبْلِ مِنْ فوقِ عَجْسِها","عَوَازِبُ نَحل أخطأَ الغارَ مُطْنِفُ"],["9CD15869-DDB6-5C2F-8885-D701EDF3E58A","نَأَتْ أُمُّ قَيْسِ المَرْبَعَيْنِ كِلَيْهِما","وَتَحْذَرُ أنْ يَنْأَى بها المُتَصَيَّفُ"],["0459D3C5-F881-5934-9B8A-4042F115DC85","وإَّنكَِلوْ تَدْرِينَ أنْ رُبَّ مَشْرَبٍ","مَخُوفٍ كداءِ البَطْنِ أوْ هُوَ أـخْوَفُ"],["5E42578C-265D-5BB8-807C-4C85AE501F11","وَرَدْتُ بِمَأْثُورِ يَمَانٍ وَضَالََةٍ","تَخَيَّرْتُها مِمّا أَرِيشُ وأرْصُفُ"],["4B95AE84-4016-5B78-8A13-B96AB08B2DD9","أُرَكِّبُها في كُلِّ أحْمَرَ غاثرٍ","وَأَنْسِجُ لِلْولْدانِ ما هو مُقْرِفُ"],["FCCFAE3A-9268-5BD2-B91A-2CF825A71E5B","وَتابعتُ فيهِ البريَ حتّى تركتُهُ","يرنُّ إذا أنقذتهُ وَيزفزفُ"],["0F9E1537-3936-5A09-89F2-B3E416FF5DEA","بكفَّيَّ منْها للبغيضِ عراضةٌ","إذا بعتُ خلاً ما له متعَّرفُ"],["C9A50235-BEE7-5632-A4F2-01C4E99C07B5","ووادٍ بَعِيدِ العُمْقِ ضَنْكٍ جُمَاعُهُ","مَرَاصِدُ أَيْمٍ قانِتِ الرأسِ أخْوَفُ"],["522C7B92-B7D1-58F4-B054-16AE83D64D98","وحوشٍ موًى؟ زادِ الذِّئابِ مضلَّةٍ","بواطنهُ للجنِّ والأسدِ مألفُ"],["38E69241-943D-5846-B27A-E7072622618F","تعسَّفتُ منهُ بعدَ ما سقطَ النَّدى","غَمَالِيلَ يَخْشى عَيْلَهَا المُتَعَسِّفُ"],["3A43C9CD-C640-59A2-962C-6E31D93B8330","وآبَ إذا أجرى الجبان وظنُّهُ","فلِي حيثُ يخشى أنْ يجاوزَ محشفُ"],["229B447C-F6EA-5212-B552-E27ACF5C0720","وإنّ کمْرَأً قَدْ جارَ سَعْدَ بْنَ مَالِكٍ","عليَّ وأثْوَابِ الأقَيْصِرِ يَعْنُفُ"]]},"9B27F2C7-398C-5757-8524-16959B416D3F":{"t":"دَعِيني وَقُولِي بَعْدُ ما شِئْتِ إِنَّني","p":9,"s":"دعيني وقولي بعد ما شئت إنني","r":"436744","v":[["8284F96B-48B1-58DF-815B-AFEAEB7EE0C2","دَعِيني وَقُولِي بَعْدُ ما شِئْتِ إِنَّني","سَيُغْدَى بِنَعْشِي مَرَّةً فَأُغَيَّبُ"],["F33DE139-8322-5E87-8A37-2E48C3DE6E46","خَرَجْنَا فَلَمْ نَعْهَدْ وَقَلَّتْ وَصَاتُنَا","ثَمَانِيَةٌ ما بَعْدَها مُتَعَتَّبُ"],["0FC2880E-4C22-5BC3-8075-0C04A68899A6","سَراحِينُ فِتْيَانٌ كـأنَّ وُجُوهَهُمْ","مَصَابِيحُ أوْ لَوْنٌ مِنَ المَاءِ مُذْهَبُ"],["4B2021CC-3732-5A01-857A-FF334158B2CA","نَمُرُّ بِرَهْوِ الماءِ صَفْحا وَقَدْ طَوَتْ","شَمَائِلُنَـا والـزَّادُ ظَنٌّ مُغَيَّـبُ"],["FD556449-B1B3-5AE7-85C1-B95A0CCF0A48","ثلاثاً على الأقْدامِ حتَّى سَمَا بِنَـا","على العَوْصِ شَعْشاعٌ مِنَ القَوْم مِحْرَبُ"],["540E1469-3F5E-5A21-BE7C-AC3529A5ED7B","فَثَاروا إِلَيْنَا في السَّوَادِ فَهَجْهَجُوا","وَصَوَّتَ فِينَـا بالصَّباحِ المثوِّبُ"],["CCC3A860-C3C0-5314-9412-279FC0D891DC","فَشَنَّ عَلَيْهِمْ هِزَّةَ السَّيْفِ ثَابِتٌ","وَصَمَّمَ فيهِمْ بالحُسَامِ المُسَيَّبِ"],["E6661C05-3C5D-5E46-8EAC-79084EEF0A3E","وَظَلْتُ بِفِتْيَانٍ معي أتَّقِيهِمُ","بِهِنَّ قليلاً سَاعَةً ثمَّ خَيَّبُوا"],["CAFDC3B1-1C99-561B-B3F0-9C5C1A2B7364","وَقَدْ خَرَّ مِنْهُمْ رَاجِلَانِ وَفَارِسٌ","كَمِيٌّ صَرَعْنَاهُ وقَرْمٌ مُسَلَّبُ"],["856ABA5C-6A06-5155-9D45-6D654AE2FE85","يَشُنُّ إلَيْهِ كُلُّ رِيعٍ وَقَلْعَةٍ","ثمانِيَةً والقَوْمُ رجْلٌ ومِقْنَبُ"],["B66F99AB-C4F4-5ED9-9BB3-F984B746C860","فلمّا رآنا قَوْمُنَا قِيلَ: أفْلَحُوا","فَقُلْنَا: کسْأَلُوا عَنْ قَائِلٍ لا يُكَذَّبُ"]]},"2DCBA54B-01D9-5FA5-9FB2-1C8DF23B47A4":{"t":"قتَِيلاَ فَخَارٍ أنْتُمَاإ نْ قُتِلْتُمَا","p":9,"s":"قتيلا فخار أنتماإ ن قتلتما","r":"436755","v":[["A3A9920A-D9C9-5121-BB0A-1EDB02C1DB46","قتَِيلاَ فَخَارٍ أنْتُمَاإ نْ قُتِلْتُمَا","بِجَنْبِ دَحِيسٍ أوْ تَبَالَةَ تَسمعا"]]},"C5FA2735-5F57-55C8-81AD-1F7380A50589":{"t":"كأنْ قَدْ فلا يَغْرُرْكِ مِنِّي تَمَكُّثِي","p":9,"s":"كأن قد فلا يغررك مني تمكثي","r":"436749","v":[["CC39C622-07FD-5F2D-95E7-5E62AAC1F1E1","كأنْ قَدْ فلا يَغْرُرْكِ مِنِّي تَمَكُّثِي","سَلَكْتُ طَرِيقا بَيْنَ يَرْبَغَ فالسَّرْدِ"],["33587699-5E4B-5434-9530-A2DF55B5F1FC","وإنِّي زَعِيمُ أنْ ألُفَ عَجَاجَتِي","عَلَى ذِي كِسَاءٍ، مِنْ سَلاَمَانَ، أوْ بُرْدِ"],["6E731C53-0F7D-5867-B424-6B771DAF9FF9","وَأَْمْشِي لدى العَصْدَاءِ أبْغِي سَرَاتَهُمْ","وَأسْلُكَ خَلاَّ بَيْنَ أرْفَاغَ والسَّرْدِ"],["41BE12C1-4FDA-5F0B-9EC1-E257C7A31DE7","هُمُ عَرَفُوني نَاشِئا ذا مَخيلَةٍ","أُمَشِّي خِلاَلَ الدَّارِ كالأسَدِ الوَرْدِ"],["88D150B9-9903-5619-B674-FAFF5E844DE5","كأنّي إذا لم أُمْسِ في دَارِ خالدٍ","بِتَيْمَاءَ لا أُهْدَى سَبِيلاً وَلاَ أَهدِي"]]},"83496463-3CE9-5F6D-8483-5FB4683D8AE3":{"t":"لا تَحْسَبِينِي مِثْلَ مَنْ هُوَ قاعِدٌ","p":9,"s":"لا تحسبيني مثل من هو قاعد","r":"436750","v":[["41820F6D-A039-58B3-A2E5-19F40683501E","لا تَحْسَبِينِي مِثْلَ مَنْ هُوَ قاعِدٌ","على عُثَّةٍ أَوْ وَاثِقٌ بِكَسَادِ"]]},"C77E7685-C366-5940-B289-D93053393051":{"t":"لا تَقْبُروني إنّ قَبْرِي مُحَرَّمٌ","p":9,"s":"لا تقبروني إن قبري محرم","r":"436753","v":[["545688D6-6409-5771-A660-C1962287B194","لا تَقْبُروني إنّ قَبْرِي مُحَرَّمٌ","عَلَيْكُمْ وَلكِنْ أبْشِرِي أمَّ عامِرِ"],["78C9F16D-1301-50A5-8FB8-74206909BB33","إذا کحْتَمَلُوا رَأْسِي وفي الرأس أَكْثَرِي","وَغُودِر عِنْدَ المُلْتَقَى ثُمَّ سَائِرِي"],["A7CE25ED-C34D-5561-8448-15AB8CAAB594","هُنَالِكَ لاأرْجُو حَيَاةً تَسُرُّني","سَجِيسَ اللَّيَالي مُبْسِلاً بالجَرَائِر"],["9511E959-16F7-5D3C-9E80-BD8BB8FA3A42","لقلْتُ لها قَدْ كان ذلك مرَّةً","ولَسْتُ على ما قَدْ عهدتِ بقادِرِ"]]},"029F22FF-40A8-5234-9457-1EDB12EB9CF5":{"t":"لامية العرب","p":9,"s":"لامية العرب","r":"425995","v":[["B37251BA-3FAB-5991-B623-CB44EDCB32FE","أَقِيمُـوا بَنِـي أُمِّـي صُـدُورَ مَطِيِّـكُمْ","فَإنِّـي إلى قَـوْمٍ سِـوَاكُمْ لَأَمْيَـلُ"],["B4816276-BCD9-51F7-80EB-7985AAB58C26","فَقَدْ حُمَّتِ الحَاجَاتُ وَاللَّيْـلُ مُقْمِـرٌ","وَشُـدَّتْ لِطِيّـاتٍ مَطَايَـا وَأرْحُلُ"],["F81F4E2D-F732-5075-97C0-C8A7C345B723","وفي الأَرْضِ مَنْـأَى لِلْكَرِيـمِ عَنِ الأَذَى","وَفِيهَا لِمَنْ خَافَ القِلَـى مُتَعَـزَّلُ"],["083CA221-4371-599C-A77C-0A50AB05D8C3","لَعَمْـرُكَ مَا بِالأَرْضِ ضِيـقٌ على امْرِىءٍ","سَرَى رَاغِبَـاً أَوْ رَاهِبَـاً وَهْوَ يَعْقِـلُ"],["00EA8BC3-3243-52EE-B166-10E76F371208","وَلِي دُونَكُمْ أَهْلُـون : سِيـدٌ عَمَلَّـسٌ","وَأَرْقَطُ زُهْلُـولٌ وَعَرْفَـاءُ جَيْـأََلُ"],["8F3264B1-43CD-53D6-A37C-41DAC6CD9382","هُـمُ الأَهْلُ لا مُسْتَودَعُ السِّـرِّ ذَائِـعٌ","لَدَيْهِمْ وَلاَ الجَانِي بِمَا جَرَّ يُخْـذَلُ"],["9F4421FA-A846-5C1C-AD81-ECDCC0201057","وَكُـلٌّ أَبِـيٌّ بَاسِـلٌ غَيْـرَ أنَّنِـي","إذا عَرَضَتْ أُولَى الطَرَائِـدِ أبْسَـلُ"],["A36F5B26-2544-5402-A62C-064E639D4D74","وَإنْ مُـدَّتِ الأيْدِي إلى الزَّادِ لَمْ أكُـنْ","بَأَعْجَلِهِـمْ إذْ أَجْشَعُ القَوْمِ أَعْجَلُ"],["85BAEE27-E4C8-54F2-985C-735ACE695BFC","وَمَـا ذَاكَ إلّا بَسْطَـةٌ عَـنْ تَفَضُّـلٍ","عَلَيْهِـمْ وَكَانَ الأَفْضَـلَ المُتَفَضِّـلُ"],["2372EFB1-BAF3-5FA8-B465-B6288E53FB3C","وَإنّـي كَفَانِـي فَقْدَ مَنْ لَيْسَ جَازِيَاً","بِحُسْنَـى ولا في قُرْبِـهِ مُتَعَلَّـلُ"],["8B5E6889-64EF-5CE2-9F0D-28D6507CEB67","ثَـلاَثَـةُ أصْحَـابٍ : فُـؤَادٌ مُشَيَّـعٌ","وأبْيَضُ إصْلِيتٌ وَصَفْـرَاءُ عَيْطَـلُ"],["360E7BDA-2650-56C5-9784-116560D262FF","هَتُـوفٌ مِنَ المُلْـسِ المُتُـونِ تَزِينُـها","رَصَائِعُ قد نِيطَـتْ إليها وَمِحْمَـلُ"],["0B2D8F6D-3CB6-556C-891B-5A107B6E4B9D","إذا زَلََّ عنها السَّهْـمُ حَنَّـتْ كأنَّـها","مُـرَزَّأةٌ عَجْلَـى تُـرنُّ وَتُعْـوِلُ"],["28D0972C-1765-5C4E-B5E0-16BBF5505D9E","وَأغْدو خَمِيـصَ البَطْن لا يَسْتَفِـزُّنيِ","إلى الزَادِ حِـرْصٌ أو فُـؤادٌ مُوَكَّـلُ"],["8B736CCA-BD1C-5A91-80D4-CB8B2D8D5BDE","وَلَسْـتُ بِمِهْيَـافٍ يُعَشِّـي سَوَامَـه","مُجَدَّعَـةً سُقْبَانُهـا وَهْيَ بُهَّـلُ"],["736234EF-5436-524C-B2ED-B5320D4C656A","ولا جُبَّـأٍِ أكْهَـى مُـرِبٍّ بعِرْسِـهِ","يُطَالِعُهـا في شَأْنِـهِ كَيْفَ يَفْعَـلُ"],["5F6A657B-A590-59C1-A74B-EB520DF05974","وَلاَ خَـرِقٍ هَيْـقٍ كَـأَنَّ فــؤادَهُ","يَظَـلُّ به المُكَّـاءُ يَعْلُـو وَيَسْفُـلُ"],["08FC0162-5C45-5AAE-A2B3-F6074720A885","ولا خَالِــفٍ دارِيَّــةٍ مُتَغَــزِّلٍ","يَـرُوحُ وَيغْـدُو داهنـاً يَتَكَحَّـلُ"],["68202F7F-12D6-5AB0-A63F-7D520603BBF8","وَلَسْـتُ بِعَـلٍّ شَـرُّهُ دُونَ خَيْـرِهِ","ألَفَّ إذا ما رُعْتَـهُ اهْتَـاجَ أعْـزَلُ"],["6414DB98-F4AB-59E4-B8F8-1488795A0CC7","وَلَسْـتُ بِمِحْيَارِ الظَّـلاَمِ إذا انْتَحَتْ","هُدَى الهَوْجَلِ العِسّيفِ يَهْمَاءُ هؤجَلُ"],["6BDCBB66-74AC-5DDB-8F3F-F92637DF16E6","إذا الأمْعَـزُ الصَّـوّانُ لاقَـى مَنَاسِمِي","تَطَايَـرَ منـه قَـادِحٌ وَمُفَلَّـلُ"],["90F5F330-9D6E-56AA-9732-F19BCD117562","أُديـمُ مِطَـالَ الجُـوعِ حتّـى أُمِيتَـهُ","وأضْرِبُ عَنْهُ الذِّكْرَ صَفْحاً فأُذْهَـلُ"],["429C18B6-8742-53F2-B165-EC5FFEE2507F","وَأَسْتَـفُّ تُرْبَ الأرْضِ كَيْلا يُرَى لَـهُ","عَلَـيَّ مِنَ الطَّـوْلِ امْـرُؤٌ مُتَطَـوِّلُ"],["BF90B628-9057-5120-A9CD-F66EF5127E4E","ولولا اجْتِنَابُ الذَأْمِ لم يُلْـفَ مَشْـرَبٌ","يُعَـاشُ بـه إلاّ لَـدَيَّ وَمَأْكَـلُ"],["E1C567EE-EF20-56B4-9474-81D0C1BE9C70","وَلكِنّ نَفْسَـاً مُـرَّةً لا تُقِيـمُ بـي","علـى الـذامِ إلاَّ رَيْثَمـا أَتَحَـوَّلُ"],["03C9C22E-4432-505D-8C15-F5828C3689F4","وَأَطْوِي على الخَمْصِ الحَوَايا كَما انْطَوَتْ","خُيُوطَـةُ مـارِيٍّ تُغَـارُ وتُفْتَـلُ"],["00E10EAD-4E04-537B-9BDC-BBD95909FE60","وأَغْدُو على القُوتِ الزَهِيـدِ كما غَـدَا","أَزَلُّ تَهَـادَاهُ التنَائِـفَ أطْحَـلُ"],["E527FEA2-24DF-509A-B7F8-21CA6515F59E","غَدَا طَاوِيـاً يُعَـارِضُ الرِّيـحَ هَافِيـاً","يَخُـوتُ بأَذْنَابِ الشِّعَابِ ويُعْسِـلُ"],["84633B4E-949A-552E-8099-70E6DCAE6ACC","فَلَما لَوَاهُ القُـوتُ مِنْ حَيْـثُ أَمَّـهُ","دَعَـا فَأجَابَتْـهُ نَظَائِـرُ نُحَّـلُ"],["6F6077FF-193A-5A75-8E38-60311DF69668","مُهَلَّلَـةٌ شِيـبُ الوُجُـوهِ كأنَّـها","قِـدَاحٌ بأيـدي ياسِـرٍ تَتَقَلْقَـلُ"],["2BF11DF5-BAB6-508E-9FD9-FB22AEE923CE","أوِ الخَشْـرَمُ المَبْعُـوثُ حَثْحَثَ دَبْـرَهُ","مَحَابِيـضُ أرْدَاهُـنَّ سَـامٍ مُعَسِّـلُ"],["647C3D1A-FAC7-5D42-BFB7-F18133114C05","مُهَرَّتَـةٌ فُـوهٌ كَـأَنَّ شُدُوقَـها","شُقُوقُ العِصِـيِّ كَالِحَـاتٌ وَبُسَّـلُ"],["BD9A6CBB-A297-512C-8C25-8699B4BFFE22","فَضَـجَّ وَضَجَّـتْ بالبَـرَاحِ كأنَّـها","وإيّـاهُ نُوحٌ فَوْقَ عَلْيَـاءَ ثُكَّـلُ"],["89270168-FD8F-5F2B-92B4-68746175F087","وأغْضَى وأغْضَتْ وَاتَّسَى واتَّسَتْ بـه","مَرَامِيـلُ عَـزَّاها وعَزَّتْـهُ مُرْمِـلُ"],["F93EAA6D-6B80-5133-9D51-65A80C7ACE29","شَكَا وَشَكَتْ ثُمَّ ارْعَوَى بَعْدُ وَارْعَوَتْ","وَلَلْصَبْرُ إنْ لَمْ يَنْفَعِ الشَّكْوُ أجْمَلُ"],["8E9DF40B-1F8D-58CD-9F84-278A0D14EF3B","وَفَـاءَ وَفَـاءَتْ بَـادِراتٍ وَكُلُّـها","على نَكَـظٍ مِمَّا يُكَاتِـمُ مُجْمِـلُ"],["F55368FA-A0C1-5CF8-B849-7AD057D69277","وَتَشْرَبُ أسْآرِي القَطَا الكُـدْرُ بَعْدَما","سَرَتْ قَرَبَـاً أحْنَاؤهـا تَتَصَلْصَـلُ"],["EFB01A4C-4EE6-57D8-989B-2D13AF7A439E","هَمَمْتُ وَهَمَّتْ وَابْتَدَرْنَـا وأسْدَلَـتْ","وشَمَّـرَ مِنِّي فَـارِطٌ مُتَمَهِّـلُ"],["82BC9B9D-B051-55EB-BEEB-4FA792D7F433","فَوَلَّيْـتُ عَنْها وَهْيَ تَكْبُـو لِعُقْـرِهِ","يُبَاشِـرُهُ منها ذُقُـونٌ وَحَوْصَـلُ"],["01E400CE-E8E1-5D07-853A-406D0B9860E8","كـأنَّ وَغَـاها حَجْرَتَيـْهِ وَحَوْلَـهُ","أضَامِيـمُ مِنْ سَفْـرِ القَبَائِـلِ نُـزَّلُ"],["D9265AAF-32F1-52B2-B3B7-0C020F34831D","تَوَافَيْـنَ مِنْ شَتَّـى إِلَيـْهِ فَضَمَّـهَا","كما ضَـمَّ أذْوَادَ الأصَارِيـمِ مَنْهَـلُ"],["7AF20207-8991-5C10-9972-0C6CACADA654","فَغَـبَّ غِشَاشَـاً ثُمَّ مَـرَّتْ كأنّـها","مَعَ الصُّبْحِ رَكْبٌ مِنْ أُحَاظَةَ مُجْفِلُ"],["55CE4E26-220D-599B-8B93-BB0F28470CD3","وآلَفُ وَجْـهَ الأرْضِ عِنْدَ افْتَراشِـها","بأَهْـدَأَ تُنْبِيـهِ سَنَاسِـنُ قُحَّـلُ"],["F26509EE-DF47-55C9-B97F-BB036D479295","وَأعْدِلُ مَنْحُوضـاً كـأنَّ فُصُوصَـهُ","كعَابٌ دَحَاهَا لاعِـبٌ فَهْيَ مُثَّـلُ"],["D9C1B91C-BB52-557C-B1D8-C4A872DA4B67","فإنْ تَبْتَئِـسْ بالشَّنْفَـرَى أمُّ قَسْطَـلٍ","لَمَا اغْتَبَطَتْ بالشَّنْفَرَى قَبْلُ أطْـوَلُ"],["6505ECFB-58E2-5182-8493-F37446B1509F","طَرِيـدُ جِنَايَـاتٍ تَيَاسَـرْنَ لَحْمَـهُ","عَقِيرَتُــهُ لأِيِّـها حُـمَّ أَوَّلُ"],["43295C4C-68BB-5213-9935-F1A1761A5871","تَنَـامُ إذا مَا نَـامَ يَقْظَـى عُيُونُـها","حِثَاثَـاً إلى مَكْرُوهِـهِ تَتَغَلْغَـلُ"],["62DE4665-5582-5B2C-9FA3-D0FD9A0B96AD","وإلْـفُ هُمُـومٍ مـا تَـزَالُ تَعُـودُهُ","عِيَاداً كَحُمَّـى الرِّبْـعِ أو هِيَ أثْقَلُ"],["589252A5-4481-59F1-B108-1564F0EEDFA5","إذا وَرَدَتْ أصْدَرْتُـها ثـمّ إنّـها","تَثُـوبُ فَتَأتي مِنْ تُحَيْتُ ومِنْ عَـلُ"],["1574ADE2-D1B0-5EBC-AEAF-1AB961427D51","فإمّا تَرَيْنِي كابْنَـةِ الرَّمْـلِ ضَاحِيَـاً","على رِقَّـةٍ أحْفَـى ولا أَتَنَعَّـلُ"],["019A2050-E2E8-56B7-93BC-84AA3B60D3EC","فإنّي لَمَولَى الصَّبْـرِ أجتـابُ بَـزَّهُ","على مِثْلِ قَلْبِ السِّمْعِ والحَزْمَ أفْعَلُ"],["A5C4B2C0-D6D5-5B75-B02D-C7C3719E3D00","وأُعْـدِمُ أَحْيَانـاً وأَغْنَـى وإنَّمـا","يَنَـالُ الغِنَى ذو البُعْـدَةِ المُتَبَـذِّلُ"],["A021B189-A061-57CA-BEC0-7BBE7A2191DD","فلا جَـزِعٌ مِنْ خَلَّـةٍ مُتَكَشِّـفٌ","ولا مَـرِحٌ تَحْتَ الغِنَى أتَخَيَّـلُ"],["80B886F5-C390-5F4A-A339-281596687397","ولا تَزْدَهِي الأجْهـالُ حِلْمِي ولا أُرَى","سَؤُولاًَ بأعْقَـاب الأقَاويلِ أُنْمِـلُ"],["EA7E22DF-573A-566B-B29C-A27640186B79","وَلَيْلَةِ نَحْـسٍ يَصْطَلي القَوْسَ رَبُّـها","وَأقْطُعَـهُ اللَّاتـي بِـهَا يَتَنَبَّـلُ"],["7CE7AE84-43A7-53DF-B1D5-82255870A83E","دَعَسْتُ على غَطْشٍ وَبَغْشٍ وَصُحْبَتـي","سُعَـارٌ وإرْزِيـزٌ وَوَجْـرٌ وَأفَكَلُ"],["B36BB774-86EA-5C45-8831-A02B2F1399A5","فأيَّمْـتُ نِسْوَانَـاً وأيْتَمْـتُ وِلْدَةً","وَعُـدْتُ كما أبْدَأْتُ واللَّيْلُ ألْيَـلُ"],["FCBD3961-B605-59EB-85BA-FEC181E9F99D","وأصْبَـحَ عَنّـي بالغُمَيْصَـاءِ جَالسـاً","فَرِيقَـانِ: مَسْـؤُولٌ وَآخَرُ يَسْـألُ"],["381B270E-A039-5A30-A230-C9117228588F","فَقَالُـوا: لَقَدْ هَـرَّتْ بِلَيْـلٍ كِلَابُنَـا","فَقُلْنَـا: أذِئْبٌ عَسَّ أمْ عَسَّ فُرْعُـلُ"],["C819DD6E-E400-5DB7-B2C2-57AD9CD5E6E6","فَلَمْ يَـكُ إلاَّ نَبْـأةٌ ثُـمَّ هَوَّمَـتْ","فَقُلْنَا: قَطَـاةٌ رِيـعَ أمْ رِيعَ أجْـدَلُ"],["E9C6FACD-3C4F-5291-960E-8D68A75CD87E","فَإِنْ يَـكُ مِنْ جِـنٍّ لأبْـرَحُ طارِقـاً","وإنْ يَكُ إنْسَـاً ما كَها الإنسُ تَفْعَلُ"],["FD3E8B93-9ED8-59D0-9749-7869FEEBAE2C","وَيومٍ مِنَ الشِّعْـرَى يَـذُوبُ لُعَابُـهُ","أفاعِيـهِ فـي رَمْضائِـهِ تَتَمَلْمَـلُ"],["5A532D59-E1B8-5A92-993B-EF4108397A3A","نَصَبْـتُ له وَجْهي ولا كِـنَّ دُونَـهُ","ولا سِتْـرَ إلاَّ الأتْحَمِـيُّ المُرَعْبَـل"],["CC03D0AA-C72E-5182-8898-1E7A9D2C6A74","وَضَافٍ إذا طَارَتْ له الرِّيحُ طَيَّـرَتْ","لبائِـدَ عن أعْطَافِـهِ ما تُرَجَّـلُ"],["68C69B38-E9FA-54D3-A8A9-C1A1C58572BA","بَعِيـدٌ بِمَسِّ الدُّهْـنِ والفَلْيِ عَهْـدُهُ","لـه عَبَسٌ عافٍ مِنَ الغِسْل مُحْـوِلُ"],["7E62AA2A-B137-5494-ADA1-3606B453E7A4","وَخَرْقٍ كظَهْرِ التُّـرْسِ قَفْـرٍ قَطَعْتُـهُ","بِعَامِلَتَيْـنِ ، ظَهْـرُهُ لَيْسَ يُعْمَـلُ"],["2A34562E-3A7D-5AF2-80FF-832377CE2B60","فألْحَقْـتُ أُوْلاَهُ بأُخْـرَاهُ مُوفِيَـاً","عَلَى قُنَّـةٍ أُقْعِـي مِرَارَاً وَأمْثُـلُ"],["7A01573C-0961-5DEB-B5F4-DFBE4F75FC15","تَرُودُ الأرَاوِي الصُّحْـمُ حَوْلي كأنّـها","عَـذَارَى عَلَيْهِـنَّ المُلاَءُ المُذَيَّـلُ"],["69BEB405-F856-51F3-8861-0FECD3E047EC","ويَرْكُـدْنَ بالآصَـالِ حَوْلِي كأنّنـي","مِنَ العُصْمِ أدْفى يَنْتَحي الكِيحَ أعْقَلُ"]],"o":"المصدر : ديوان الشنفرى - جمع وتحقيق وشرح الدكتور إميل بديع يعقوب - دار الكتاب العربي بيروت ، 1996 . و بوابة الشعراء : ديوان الشنفرى"},"348A6605-4D94-5E07-9BE5-5F8960AC293A":{"t":"ليس لوالدة همُّها","p":9,"s":"ليس لوالدة همها","r":"436756","v":[["04BF650D-0A07-504B-BC25-E50DD898267B","ليس لوالدة همُّها","ولا قِيلُهَا لابْنِها دَعْدَعِ"],["3794FC70-8E78-5635-B7CC-5BFB201B0594","تَطُوفُ وَتَحْذَرُ أحْوَالَهُ","وَغَيْرُكِ أمْلَكُ بالمَصْرَعِ"]]},"7CCD71EC-CE31-5D5F-88FA-7B6583DC0710":{"t":"وكفِّ فَتًى لم يَعْرِفِ السَّلْخَ قَبْلَها","p":9,"s":"وكف فتى لم يعرف السلخ قبلها","r":"436747","v":[["142F3BA1-7A4A-5F42-9A24-B17CADF93864","وكفِّ فَتًى لم يَعْرِفِ السَّلْخَ قَبْلَها","تَجُورُ يَدَاهُ في الإهَابِ وَتَخْرُجُ"]]},"1CF35D50-EE88-55B2-91B3-470C23297CE8":{"t":"وَمُسْتَبْسِلٍ ضَافي القَمِيصِ ضَمَمْتُهُ","p":9,"s":"ومستبسل ضافي القميص ضممته","r":"436748","v":[["988D6A8D-6B2A-5E46-914A-0F2CA7301303","وَمُسْتَبْسِلٍ ضَافي القَمِيصِ ضَمَمْتُهُ","بِأزْرَقَ لانِكْسٍ ولا مُتَعَوِجِ"],["302E0575-3BFC-5E57-9BAA-15B09BDE0087","عَلَيْهِ نُسارِيٌّ على خُوطِ نَبْعَةٍ","وَفُوْقٍ كَعُرْقُوبِ القَطَاةِ مُدَحْرَجِ"],["EE6DD4AB-B280-5583-91EB-55C67AE6082F","وقارَبْتُ مِنْ كَفَّيَّ ثُمَّ نَزَعْتُها","بِنَزَعٍ إذا ما اسْتُكْرِهَ الَّنزْعُ مِحْلَجِ"],["73BA5CF8-3833-55D7-9903-5C0F65209797","فَصَاحَتْ بِكَفِّي صَيْحَةً ثُمَّ راجَعَتْ","أنِينَ المَرِيضِ ذِي الجِرَاحِ المشجَّجِ"]]},"6E72E9E6-B146-568A-9DE6-18029E048473":{"t":"وَنَائِحَةٍأَوْحَيْتُ في الصُّبْحِ سَمْعَها","p":9,"s":"ونائحة أوحيت في الصبح سمعها","r":"436752","v":[["08E1BEB5-66A0-5326-9687-0654DA03BB8E","وَنَائِحَةٍأَوْحَيْتُ في الصُّبْحِ سَمْعَها","فَرِيعَ فُؤَادِي وآشْمَأَزَّ وَأَنْكَرَا"],["3D99DD79-4BEB-5C1A-A081-802D73BC2667","فَخَفَّضْتُ جَأْشِي ثُمَّ قُلْتُ:حَمَامَةٌ","دَعَتْ سَاقَ حُرٍّ في حَمَامٍ تَنَفَّرَا"],["83372776-336D-5ACF-85C2-2485C78940D8","وَمَقْرُونَةٍ شِمَالُها بِيَمِينِهَا","أجنِّبُ بَزِّي مَاؤها قَدْ تَعَصَّرَا"],["E2043085-BEE7-55DF-9E62-39EDF2BEA4D3","وَنَعْلٍ كَأِشْلاَءِ السُّمَانَى تَرَكْتُها","على جَنْبِ مَوْرٍ كالنَّحِيزَةِ أغْبَرَا"],["CFABFFE0-B348-5808-B0B8-96FA070B1423","فإنْ لا تَزُرْني حَتْفَتِي أوْ تُلاقِني","أُمَشِّ بِدَهْرٍ أو عِدَافٍ فَنَوَّرا"],["9100AE4B-8D8F-5788-B421-B900B02DA7EC","أُمَشِّي بأطرافِ الحَمَاطِ وَتَارَةً","ينفِّضُ رِجْلِي بُسْبُطاً فَعَصَنْصَرَا"],["AC424B30-FD6B-5E82-A5D4-982C247FE597","أُبَغِّي بَنِي صَعْبِ بْن مُرٍّ بلادَهُمْ","وسوفَ أُلاَقِيهِمْ إنِ اللهُ أخَّرَا"],["1FF38F89-27FE-516D-AEC1-E91513B5915B","وَيَوْماً بِذَاتِ الرسِّ أو بَطْنِ مِنْجَلٍ","هُنَالِكَ نَبْغِي القاصِيَ المتَغَوِّرا"]]},"BC615DB6-D86A-5946-A93F-3F2FDBD94758":{"t":"يا صاحبيَّ هلِ الجذارُ مسلِّمي","p":9,"s":"يا صاحبي هل الجذار مسلمي","r":"436758","v":[["3464772E-7064-5936-9C00-09E184DB67AF","يا صاحبيَّ هلِ الجذارُ مسلِّمي","أوْ هلْ لحتفِ منيَّةٍ منْ مصرفِ"],["B20A6EDF-72D5-5F5B-A269-EAF7FD506659","إنّي لأعلمُ أنّ حتفي في التي","أخْشَى لَدَى الشُّرْبِ القَلِيلِ المُنْزِفِ"]]}}}