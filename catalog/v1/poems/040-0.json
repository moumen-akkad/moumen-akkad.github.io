{"v":1,"poems":{"FA2FCE78-25BD-5BAD-82EA-56BCAD506D19":{"t":"أظُنّ الكُلَيْبَ خانَني أوْ ظَلَمْتُهُ","p":40,"s":"أظن الكليب خانني أو ظلمته","r":"436631","v":[["15EF95D0-6351-5784-8CB7-B5E13BDBABDB","أظُنّ الكُلَيْبَ خانَني أوْ ظَلَمْتُهُ","بِبُرْقَةِ حِليّتٍ وما كانَ خائِنَا"],["6EF9BF14-379F-5B54-AA58-1AAEC832A9A7","وأعْذِرُهُ أنّي خَرُقْتُ وإنّمَا","لَقيتُ أخا خِبَ وصُودِفتُ بادِنَا"]]},"1AF55D01-66D0-5526-AD8C-A1E91A42B960":{"t":"ألا أبْلِغْ عُوَيْمِرَ عَنْ زِيادٍ","p":40,"s":"ألا أبلغ عويمر عن زياد","r":"436579","v":[["860291A2-1F2E-5AC3-AB45-88E000477336","ألا أبْلِغْ عُوَيْمِرَ عَنْ زِيادٍ","فإنّ مَظِنّةَ الجَهْلِ الشّبابُ"],["509413CF-018D-5567-9701-9ACAA5091C27","فإنّكَ سَوْفَ تَحْلُمُ أوْ تَنَاهى","إذا ما شِبْتَ أوْ شابَ الغُرابُ"],["3F738CF7-9C4D-564B-A296-AC3CF7B11D7B","فَكُنْ كأبيكَ أوْ كأبي بَراءٍ","تُوافِقْكَ الحُكومَةُ والصّوابُ"],["3D107E81-E08E-5401-908C-1B3229555944","ولا تَذْهَبْ بحِلْمِكَ هَافِياتٌ","مِنَ الخُيَلاءِ لَيسَ لَهُنّ بابُ"],["651CD630-EB89-5BA3-BE96-5B4B72949337","فإنْ يَكُ رَبُّ أذْوادٍ بحِسْمى","أصابُوا في لِقائِكَ ما أصابُوا"],["1EA8690C-BA87-5BC8-A91E-8E8B13C1EFB2","فمَا إنْ كانَ مِنْ نَسَبٍ بَعيدٍ","ولكِنْ أدرَكوكَ وهمْ غِضابُ"],["8740B56B-254C-57A7-B82D-AF6AEF668DF3","فَوارِسُ مِنْ مَنُولَةَ غَيرُ مِيلٍ","ومُرّةُ فَوْقَ جَمعِهِمِ العُقابُ"]]},"E33C7833-2A90-515B-9665-5124659677DA":{"t":"ألا طَرَقَتْكَ مِنْ خَبْتٍ كَنُودُ","p":40,"s":"ألا طرقتك من خبت كنود","r":"436636","v":[["DF78FA9B-664F-5195-AD09-58FD23DEC753","ألا طَرَقَتْكَ مِنْ خَبْتٍ كَنُودُ","فَقَدْ فَعَلَتْ وآلَتْ لا تَعُودُ"],["791B6BA4-BC26-58ED-B9B4-FCABA23DEAF1","كأنّكِ لم تَرَيْنَا يَوْمَ غَوْلٍ","ولمْ يُخبِرْكِ بالخَبَرِ الجُنُودُ"],["8238B5BE-B96B-5D99-BE23-7713CF758331","بِمَا لاقَتْ سَراةُ بَني لُجَيْمٍ","تَعَضّ سَراتَهُمْ فِينا القُيُودُ"],["9D5920D9-A5FB-53F4-AFC1-0BDE72282223","وعَبْدُ القَيسِ بالمَرْداءِ لاقَتْ","صَباحاً مِثلَ ما لَقِيَتْ ثَمُودُ"],["85612843-604D-5E01-845D-3D0C389C7690","صَبَحْناهُمْ بكُلّ أقَبّ نَهْدٍ","ومُطّرِدٍ لَهُ يَقِدُ الحَديدُ"],["224B3ABB-A83A-5481-A710-686B384B35CA","وأبيضَ يَخطَفُ القَصَراتِ عَضْبٍ","رَقيقِ الحَدّ زَيّنَهُ غُمُودُ"],["DE01027F-07EA-5549-A845-2CD1CEFE5233","وكلِّ طِمِرّةٍ خَفِقٍ حَشَاهَا","مُلَمْلَمَةٍ تَلاقيها بَعِيدُ"],["192FAA95-2DEB-5772-9513-08A3CB722926","لَقينَا جَمْعَهُمْ صبحاً فكانُوا","كمِثْلِ الضّأنِ عاداهنّ سِيدُ"],["6408F567-DB17-5891-86FE-94345F5201D7","فَغُودِرَ مِنهُمُ عَمْروٌ وعَمْرٌو","وأسْوَدُ والكُماةُ بها شُهُودُ"],["D9765D62-09CB-51A8-8796-DADFB8BF3A0F","وعَبْدُ اللَّهِ غُودِرَ وابنُ بِشْرٍ","وعَتّابٌ ومُرّةُ والوَليدُ"],["5A706724-B94D-542B-8FCB-AF4CBC1AC8E6","لَقيناهُمْ بِبيضٍ مُرْهَفَاتٍ","نُقَتّلُهُمْ بها حتى أُبِيدُوا"],["90401317-BD83-53CF-BD29-373EEC8D8102","وأرْدَفْنَا نِساءَهُمُ وجِئْنَا","وقد دَمِيَتْ من الخمشِ الخُدودُ"]]},"061F3229-A5CC-5011-B798-1339F3C02585":{"t":"ألا كلُّ ما هَبَّتْ بهِ الرّيحُ ذاهِبُ","p":40,"s":"ألا كل ما هبت به الريح ذاهب","r":"436580","v":[["F9851664-B763-52A4-9A27-071707BFE794","ألا كلُّ ما هَبَّتْ بهِ الرّيحُ ذاهِبُ","وكُلُّ فَتًى بَعدَ السّلامةِ شاجِبُ"],["092EE47B-60C3-5840-955F-800036C5EA71","ألا إنّ خَيرَ النّاسِ رِسْلاً ونَجْدَةً","بهِرْجابَ لم تُحْبَسْ عَلَيْهِ الركائِبُ"],["BFD1D80A-C585-5D6D-A99A-32E8FD9D5E37","وهَوَّنَ وَجْدي أنّني لَوْ رَأيْتُهُ","يُساوِرُهُ ذو لِبْدَتَينِ مُكالِبُ"],["D556D95F-ED05-56AF-8BF3-263C62EA71E0","لمَارَسْتُ عَنْهُ الخَيْلَ غيرَ مُهَلِّلٍ","لَعَمْرُ أبي أوْ تَشْتَعِبْني الشّواعِبُ"]]},"DB4E4775-9BBF-544E-8A82-727525F336D3":{"t":"ألا مَنْ مُبْلِغٌ أسْماءَ عَنّي","p":40,"s":"ألا من مبلغ أسماء عني","r":"436598","v":[["02938EBE-F2D4-538B-BFEA-2AD69E17EF15","ألا مَنْ مُبْلِغٌ أسْماءَ عَنّي","ولَوْ حَلّتْ بيُمْنٍ أوْ جُبَارِ"],["65581033-B2F7-566E-A509-801C1DA5298F","بأنّ حَليلَها دَرَهَتْ عَلَيْهِ","خُطوبٌ لا تُفَرَّجُ بالسِّرارِ"]]},"E7031210-CF2A-5CB9-89B8-6346DF7CDEFE":{"t":"ألا مَنْ مُبْلِغٌ عَنّي زِياداً","p":40,"s":"ألا مَنْ مُبْلِغٌ عَنّي زِياداً","r":"436578","v":[["778C8CB1-55F4-5A40-AF15-7042927150CB","ألا مَنْ مُبْلِغٌ عَنّي زِياداً","غَداةَ القَاعِ إذ أزِفَ الضِّرابُ"],["CA734AFC-944A-558B-A5E1-F0F71B81B94E","غَداةَ تَثُوبُ خَيلُ بَني كِلابٍ","على لَبّاتِها عَلَقٌ يُشابُ"],["307B73FD-3EFB-5A33-9AFC-0540FA308921","فإن لنا حكومة كل يوم","يُبَيَّنُ في مَفاصِلِهِ الصّوابُ"],["695B70A4-E091-5198-8A59-232291BC833E","وإني سوف أحكم غير عاد","ولا قذع إذا التمس الجواب"],["88015DD5-1D53-5D94-890E-EB53BBA73E8E","حُكومَةَ حَازِمٍ لا عَيْبَ فيها","إذا ما القوم كظهم الخطاب"],["64CA044B-738B-55A2-B721-F152210DDF56","فإنّ مَطِيّةَ الحِلْمِ التّأنّي","على مَهَلٍ وللجَهْلِ الشّبابُ"],["E5365A09-579E-56BC-873E-78E470ADDC2B","وليس الجهل عن سن ولكن","غَدَتْ بنَوافِذِ القوْلِ الرّكابُ"],["2169B528-E7D1-549E-AFD3-0C9597E41100","فإنّ بَني بَغيضٍ قَدْ أتاهُمْ","رسول الناصحين فما أجابوا"],["6478C24E-FDE5-53D5-816C-06FC4B43F198","ولا ردوا محورة ذاك حتى","أتانا الحلم وانخرق الحجاب"],["093454D1-4AF1-553F-B2B1-65F17A02D601","فإن مقالتي ما قد علمتم","وَخَيْلي قَدْ يَحِلّ لها النّهابُ"],["B6DF4370-4FA3-5C80-8CD3-C47DF89AF28C","إذا يَمّمْنَ خَيْلاً مُسْرِعاتٍ","جرَى بنُحوسِ طَيرِهمُ الغُرابُ"],["67FBB603-E832-5407-8FC6-C22E30B6320A","وإنْ مَرّتْ على قَوْم أعَادٍ","بساحتهم فقد خسروا وخابوا"]]},"EB5A95B3-D128-58F7-A0DA-9197AC54DA91":{"t":"ألا يا لَيْتَ أخْوالي غَنِيّاً","p":40,"s":"ألا يا ليت أخوالي غنيا","r":"436600","v":[["7C345F55-EE0C-52AD-BE1C-4076BBD184D1","ألا يا لَيْتَ أخْوالي غَنِيّاً","عَلَيْهِمْ كُلمَا أمْسَوْا دُوَارُ"],["37EE9734-290C-5BA5-A9E3-1AD8E59A33EE","بِبِرّ إلَهِهِمْ ويَكُونُ فيهِمْ","على العافِينَ أيّامٌ قِصارُ"]]},"0EEE9BF6-DA41-5097-AF72-6CF999FD7149":{"t":"ألَسْنَا نَقُودُ الخَيْلَ قُبّاً عَوَابِساً","p":40,"s":"ألسنا نقود الخيل قبا عوابسا","r":"436626","v":[["A6D01E73-90DC-5232-A437-4E364DC2359B","ألَسْنَا نَقُودُ الخَيْلَ قُبّاً عَوَابِساً","وَنخضِبُ يَوْمَ الرّوْعِ أسْيافَنا دَمَا"],["CA6C6D21-C5EA-5B53-A727-0C616A85BA51","وَنَحْمي الذّمارَ حينَ يَشتَجرُ القَنَا","ونَثني عن السَّرْبِ الرّعيلَ المُسَوَّمَا"],["921D3387-F44E-504B-A63E-E31D4D5188E7","ونَسْتَلِبُ الحُوّ العَوَابِسَ كالقَنَا","سَوَاهِمَ يَحْمِلْنَ الوَشيجَ المُقَوَّمَا"],["3ADB4D36-9F50-519B-93E6-E10420A82E5A","ونَحْنُ صَبَحْنَا حَيّ أسمَاءَ غارَةً","أبَالَتْ حَبَالى الحَيّ من وَقعِها دَمَا"],["1FFDF0E9-A3B8-5854-8833-183E86DDC932","وبالنّقْعِ مِنْ وادي أبِيدَةَ جاهَرَتْ","أُنَيْساً وقَدْ أرْدَينَ سَادَةَ خَثْعَمَا"],["4626FB28-F5E8-5677-B25F-27DDB8AF4F44","وَيَوْمَ عُكَاظٍ أنْتُمُ تَعْلَمُونَهُ","شَهِدْنا فأقْدَمْنا بها الحَيّ مُقدَمَا"],["AAA70C32-7AB6-50C0-8F1C-1E1418987FC4","ونَحْنُ فَعَلْنَا بالحَليفَينِ فَعْلَةً","نَفَتْ بَعدَها عنّا الظَّلومَ الغَشمشَما"],["5663244D-16AB-5CA5-B79B-6D04AEF76FB0","وما بَرِحَتْ في الدّهْرِ مِنّ عِصابَةٌ","يَذودونَ عن أحْسابِنا من تَعَرّمَا"],["C10E8B5E-3D92-574D-B010-1A67B06CDE99","يَقُودونَ جُرْداً كالسّراحِينِ تَستَمي","صُدورَ العَوالي من كُميتٍ وأدْهَمَا"],["9288D10E-7DED-5B52-BE3A-A16B17A7C527","ونَحْنُ أبَرْنَا حَيّ أشْجَعَ بالقَنَا","ونَحْنُ تَرَكْنَا حَيّ مُرّةَ مأتَمَا"]]},"DA8AD0D5-5753-5D93-A338-2450019DF962":{"t":"أنازِلَةٌ أسماءُ أمْ غَيرُ نازِلَهْ ؟","p":40,"s":"أنازلة أسماء أم غير نازله ؟","r":"436619","v":[["9FBF7DE2-34F4-5BA3-B6C4-97BDC2571ACD","أنازِلَةٌ أسماءُ أمْ غَيرُ نازِلَهْ؟","أبِيني لَنا يا أسْمَ ما أنتِ فاعِلَهْ"],["9B60A101-781B-51F0-BFEE-7DED8566BFCB","فإنْ تَنْزِلي أنْزِلْ ولا آتِ مَوْسِماً","ولوْ رَحلَتْ للبَيعِ جَسْرٌ وباهِلَهْ"]]},"F3251151-B8C1-590B-8974-B2EFA4D01B14":{"t":"أُنْبِئْتُ قَوْمي أتْبَعُوني مَلامَةً","p":40,"s":"أنبئت قومي أتبعوني ملامة","r":"436606","v":[["AA2249E0-D9B4-5AEB-A394-793162B9B200","أُنْبِئْتُ قَوْمي أتْبَعُوني مَلامَةً","لَعَلّ مَنَايا القَوْمِ مِمّا أُكَلَّفُ"],["132626E6-595D-5108-B1EC-99D8E9BD44E6","فَإنْ تَكُ أفْرَاسٌ أُصِبْنَ وفِتْيَةٌ","فَإنّي لَجَرّافٌ بهِنّ مُجَرَّفُ"]]},"60AD4D1B-6921-53EB-88B3-E1CCC1B84ED4":{"t":"إذا شِئتَ أن تَلقى المَناعةَ فاسْتَجِرْ","p":40,"s":"إذا شئت أن تلقى المناعة فاستجر","r":"436625","v":[["3CEB9FD0-93E0-5877-AA6B-2A93E4E346B5","إذا شِئتَ أن تَلقى المَناعةَ فاسْتَجِرْ","خِذامَ بنَ زَيْدٍ إنْ أجَارَخِذامُ"],["9F880A09-303B-5757-8DFE-8570FB5D001C","دَعَوْتُ أبَا الجَبّارِ أخْتَصّ مالِكاً","ولمْ يَكُ قِدْماً مَن أجَرْتَ يُضامُ"],["5EBFB0FF-53B6-5B13-A4CD-55181F922FE9","فَقَامَ أبو الجَبّارِيَهْتَزُ للنّدَى","كمَا اهْتَزّ عَضْبُ الشّفرَتَينِ حُسامُ"],["985CB48C-9379-585D-A05C-626E2EFCCBF7","وكُنْتُ سَنَاماً من فَزارَةَ تَامِكاً","وفي كُلّ قَوْمٍ ذِرْوَةٌ وسَنَامُ"],["DC80E662-4B5F-50AC-BD26-35A76E67EDA8","فنَكّبْتَ عَنّي الشّارِعِينَ ولم أكُنْ","مَخَافَةَ شَرّ الشّارِعِينَ أنَامُ"]]},"203EF6ED-092A-5E82-B833-D183C9F276CC":{"t":"إني وإنْ كنتُ ابنَ سَيّدِ عَامِرٍ","p":40,"s":"إني وإن كنت ابن سيد عامر","r":"436576","v":[["3CA126F3-5052-5962-9487-EB38883CA22C","إني وإنْ كنتُ ابنَ سَيّدِ عَامِرٍ","وفارِسَهَا المَنْدوبَ في كلّ مَوكِبِ"],["5170370E-8EC9-5C27-B2D9-A24EFDB3A3BE","فَما سَوّدَتْني عامٍرٌ عَنْقَرابَةٍ","أبَى اللهُ أنْ أسْمُو بأُمٍّ ولا أبِ"],["B8B92C6E-7E93-5A5A-AF23-D96A084E864B","وَلَكِنّني أحْمي حِمَاها وأتّقي","أذاها وأرْمي مَنْ رَماها بمَنْكِبِ"]]},"AD934649-CFB0-577C-9558-52BDECE5AE11":{"t":"إنّي إذا انْتَتَرَت أصِرّةُ أُمّكُمْ","p":40,"s":"إني إذا انتترت أصرة أمكم","r":"436577","v":[["70F10ECF-D3AF-5462-A690-589E0206C5AF","إنّي إذا انْتَتَرَت أصِرّةُ أُمّكُمْ","مِمّنْ يُقالُ لَهُ تَسَرْبَلْ فاركَبِ"],["E8DFC32B-B717-5936-8588-905AACD7AB30","لا ضَيرَ قّدْ حكّتْ بِمُرّةَ بَرْكَها","وتَرَكنَ أشجَعَ مثلَ خُشبِ الأثأبِ"],["B856F8FA-9873-5E22-AE0F-A61B085CE9F6","لا يَخْطُبُونَ إلى الكِرامِ بَنَاتِهِمْ","وتَشيبُ أيّمُهُمْ ولَمّا تُخْطَبِ"],["7BE2462A-E0A9-5D94-901E-2AEA87B82F46","أفَرِحْتَ أنْ غدَرَ الزّمانُ بفارِسٍ","قُلْحَ الكِلابِ وكنتُ غَيرَ مُغَلَّبِ"],["0F7AC217-41DD-5747-BC31-598E37D4826D","يا مُرَّ قّدْ كَلِبَ الزّمانُ عَلَيْكُمُ","ونَكَأتُ قَرْحَتَكُمْ ولمّا أُنكَبِ"],["C65B741B-4FD2-5895-9DF3-EB44EE3BD348","وتَرَكْتُ جَمعَهُمُ بِلابَةِ ضَرْغَدٍ","جَزَرَ السّباعِ وكلِّ نَسرِ أهْدَبِ"],["C4A2AA69-C5ED-5BE7-8136-7132E98171EC","ولَقَد أبَلْتُ الخَيلَ في عَرَصاتِكُمْ","وَسْطَ الدّيارِ بكُلّ خِرْقٍ مِحرَبِ"],["B9EDB5D8-55F1-5C65-AD65-66D187132C77","وَشَفَيْتُ نَفسي مِنْ فَزارَةَ إنّهُمْ","أهْلُ الفَعالِ وأهْلُ عِزٍ أغْلَبِ"],["DA607499-F05A-51F8-B7F8-84AFE6185448","ولَقَدْ فَخَرْتَ بباطِلٍ عَدّدْتَهُ","فإذا أتَيْتَ بَيُوتَ قَوْمِكَ فاحسُبِ"],["0573FD1D-AF19-5675-8779-99613DA2FCEB","فَلَتُخْبِرَنّكَ فَاقِدٌ عَنْ شَجْوِهَا","حَذِلٌ مَدامِعُها بدَمْعٍ سَيكَبِ"],["1684E79E-23EA-5837-8588-5E544EE02580","ولَقَدْ لَحِقْتَ بخَيْلِنا فَكَرِهْتَها","وصَددتَ عن خيَشومِها المُستكلِبِ"],["DFCE6239-F09A-555D-A34B-3A764AC0F976","فبَني فضزارَةَ قَدْ عَلَوْنَ بكَلْكَلٍ","والحَيَّ أشْجَعَ قد رَمَينَ بمنَكِبِ"],["AE1B47D4-82C6-56CF-B039-DDC3B13D79B8","غادَرْنَ مِنْهُمْ تِسْعَةً في مَعْرَكٍ","وثَلاثَةٌ قَرّنّهُمْ في المِشْعَبِ"]]},"F77DFF57-5BA4-5371-B7A1-AF6463711499":{"t":"بَعَثَ الرّسولُ بِما تَرَى فكأنّما","p":40,"s":"بعث الرسول بما ترى فكأنما","r":"436601","v":[["B59B7B16-C721-52CA-828C-5BE4134838EB","بَعَثَ الرّسولُ بِما تَرَى فكأنّما","عَمْداً نَشُدّ على المَقانِبِ غَارَا"],["8B17824B-D9FE-52B4-9D8E-48EB54EE17CE","ولَقَدْ وَرَدْنَ بِنَا المَدينَةَ شُزّباً","وَلَقَدْ قَتَلْنَا بِجَوّهَا الأنْصارَا"]]},"403078C9-24B4-5BC6-A65B-C8BD954D904B":{"t":"بَني عامِرٍ غُضّوا المَلامَ إلَيْكُمُ","p":40,"s":"بني عامر غضوا الملام إليكم","r":"436637","v":[["23EE160C-ED27-5B3D-87D6-23443BC8F362","بَني عامِرٍ غُضّوا المَلامَ إلَيْكُمُ","وهاتُوا فعُدّوا اليومَ فيكمْ مَشاهدي"],["446EDC40-A6B8-50E2-BFAF-8E09D25FD747","ولا تَكْفُرُوا في النّائِباتِ بَلاءَنَا","إذا عَضّكُمْ خَطبٌ بإحدى الشّدائدِ"],["7304225F-687F-501B-A27C-1928C21AE1B6","سَلوا تُخْبَروا عَنّا غَداةَ أُقَيصِرٍ","وأيّامَ حِسْمَى أو ضَوارِسَ حاشِدِ"],["0A81F519-89EC-5D0E-87C4-31DD6689F2D0","وبالكَوْرِ إذْ ثابَتْ حَلائِبُ جعفرٍ","إلَيكُمْ وجاءَتْ خَثْعَمٌ للتّحاشُدِ"],["A7759C03-1266-5475-81DC-E9390269C2B5","ليَنْتَزِعُوا عِلْقاتَنا ثُمّ يَرْتَعُوا","فأرْدَتْ قَناتي منهُمُ كُلَّ مَاجِدِ"],["0446348F-184C-5018-92AA-AA24D8778774","فأنْفَذْتُ عَبدَاللهِ ثَمّ بضَرْبَةٍ","وقَدْ خامَ عَنْها كلُّ حامٍ وذائِدِ"],["4A6A4FEE-7189-5DE9-B609-DD70576C50B2","تَرَكْتُ صَريعاً بالعَراءِ مُجَدَّلاً","ضُبَيْعَةَ إذْ نَجّى شُتَيْرَ بن خالدِ"],["5D1C2664-5659-594C-9CC9-E39FDC0B7FDE","طِمِرٌّ وزَيْدُ الخَيْلِ قد نالَ طَعْنَةً","إذِ المَرْءُ زَيْدٌ جائِرٌ غَيرُ قاصِدِ"],["0EE73183-93D9-5A66-A61E-4D0817EF017C","فَذَلِكَ ما أعْدَدْتُ في كلّ مأقِطٍ","كَريهٍ وعَامٍ للعَشِيرَةِ آئِدِ"]]},"179A0C74-E412-5391-9953-970B11B93702":{"t":"ترَكْتُ نِساءَ ساعدَةَ بنِ مُرّ","p":40,"s":"تركت نساء ساعدة بن مر","r":"436615","v":[["C740F7CE-6F6F-5A4F-956E-03E86E626D04","ترَكْتُ نِساءَ ساعدَةَ بنِ مُرّ","لَهُنّ لَدَى مَزاحِفِهِ عَويلُ"],["7A1EADEC-BA99-5BFC-B529-15F5030DE443","جَمَعْتُ لهُ يدَيّ بذي كُعُوبٍ","يُقَدِّمُ نَصْلَهُ أظْمَى طَويلُ"],["1940BF83-DE76-59E5-8CEA-4CE076142128","شَكَكْتُ بهِ مَجامِعً رُحْبَيَيْهِ","فَصارَ رِداؤهُ مِنْهُ طَمِيلُ"]]},"68BAF704-E87F-59C8-B978-BE8402275C7D":{"t":"تَجَنّبْ نُمَيراً ولا تُوطِهَا","p":40,"s":"تجنب نميرا ولا توطها","r":"436595","v":[["43843578-3864-5C3D-8E4C-9C507A4B4D73","تَجَنّبْ نُمَيراً ولا تُوطِهَا","فَإنّ بِهَا عَامِراً حُضَّرُ"],["84A4FBB0-7E01-5D57-855A-CD766DB8A295","وإنّ رِمَاحَ بَني عَامِرٍ","يُقَطِّرْنَ مِلْ عَلَقِ الأحْمَرِ"],["583AD100-BB77-5C43-98DD-D311E0A2B9EE","هُمُ الجابِرونَ عِظامَ الكَسيرِ","إذا مَا الكَسائِرُ لَمْ تُجْبَرِ"],["3BF9E57B-AC9B-5CE9-AA22-1F1DFEAFC36E","وهُمْ يَضْرِبُونَ غَداةَ الصّبَا","حِ أنْفَ المُدَجَّجِ ذي المِغفَرِ"],["AF73F068-B847-5D7F-B612-EFC3744E15E2","يُقيمُونَ للحَرْبِ أصْعارَهَا","إذا ثُوّرَ القَسطَلُ الأغْبَرُ"],["053F11EA-D6DF-5F54-A313-6FD23D5C7818","كُمَاةٌ حُمَاةٌ إذا مَا الشّفا","هُ يَعْجِزُ عَن ضَمّها الِمشْفَرُ"],["682E0CCC-BD87-5070-B283-8D0E85D8A5A3","يُطيلُونَ للحَرْبِ تَكْرارَهَا","إذا ألْهَبَتْ لَهَباً تُسْعَرُ"],["A9106D4A-7A8C-5B6C-B1F3-A6F07365A2C3","وإنّ الذي قَدْ أتَيْتُمْ بِهِ","سَيَكْذِبُهُ عَنْكُمُ المُخْبَرُ"],["04B04B30-F405-5B39-8F92-EE7D845A7A1C","سَتَعْلَمُ إنْ رُمْتُمُوهُمْ إذا","تَلَقّى كَتَائِبُهَا الحُسَّرُ"],["6D7F4736-7384-56DA-A7AD-6D099F0CC773","تَبَيّنُ في شُبُهاتِ الأمُورِ","فَإنّ التّجارِبَ قَدْ تُؤثَرُ"],["BBECDFED-B3F3-5AD8-9DFB-4D7839FBFC77","لَقَدْ كانَ فِيمَا خَلا عِبْرَةٌ","وبالعِلْمِ يَعْتَبِرُ الُمْبصِرُ"],["C0BDEA9F-6C4E-55BB-B9E8-4780E0D3EDE7","يُلامُ المُفَرّطُ في أمْرِهِ","إذا صَرّحَ الأمْرُ للمُعْذِرِ"]]},"0A5BE6BB-CC8C-5417-B333-BC8CC55006D4":{"t":"تَرْعَى فَزارَةُ في مَقَرّ بِلادِهَا","p":40,"s":"ترعى فزارة في مقر بلادها","r":"436610","v":[["61FB506E-EF83-5E03-8B51-5C47466E4E5C","تَرْعَى فَزارَةُ في مَقَرّ بِلادِهَا","وتَهيمُ بَينَ شَقائِقٍ ورِمَالِ"],["8F7BE97D-292F-56C4-8170-374E885FF426","يُعْطُونَ خُرْجَهُمُ بغَيرِ هَوَادَةٍ","والدّهْرُ ذو غِيَرٍ وذو بَلْبالِ"],["4956AA18-AEEF-51C4-B319-E3ECBCF4F9DD","نَحْنُ الكُماةُ لِذي الوَغَى في هَوْله","والخَاضِبُونَ مُجَوَّبَ السّرْبالِ"],["AA138A02-383C-5328-ADEF-FAEC3684BC1C","وقَضَتْكُمُ بَكْرٌ قَضاءً واجِباً","وَبَنُو فَزارَةَ جُلْنَ حِينَ مَجَالِ"]]},"86686F80-F1BD-5E95-8A3D-E26EE1155399":{"t":"تَقُولُ ابنَةُ العَمريّ ما لَكَ بَعْدَما","p":40,"s":"تقول ابنة العمري ما لك بعدما","r":"436581","v":[["466EB187-488A-5BD7-A7A1-303E3B22DB3D","تَقُولُ ابنَةُ العَمريّ ما لَكَ بَعْدَما","أراكَ صَحيحاً كالسّليمِ المُعَذَّبِ"],["D66F02CA-B046-5F08-A613-0238F5078155","فقُلْتُ لهَا: هَمّي الذي تَعْلَمينَهُ","من الثّأرِ في حَيّيْ زُبَيْدٍ وأرْحَبِ"],["CF240D7E-EC9F-527B-8C99-E65AE9A3A4FB","إنَ اغْزُ زُبَيْداً أغْزُ قَوْماً أعِزّةً","مُرَكَّبُهُمْ في الحَيّ خَيرُ مُرَكَّبِ"],["90065283-E8EF-5863-A56B-B6B4C74AA5E5","وإنْ أغْزُ حَيّيْ خَثْعَمٍ فَدِماؤهمْ","شِفاءٌ وخَيرُ الثّأرِ للمُتَأوِّبِ"],["EC961721-AB8C-5834-A8E9-A291F666CBBA","فَما أدْرَكَ الأوْتارَ مثلُ مُحَقِّقٍ","بأجْرَدَ طاوٍ كالعَسيبِ المُشَذَّبِ"],["5E728B02-F7AD-517F-A62F-4FE3B42D7531","وأسْمَرَ خَطّيٍّ وأبْيَضَ باتِرٍ","وزَعْفٍ دِلاصٍ كالغَديرِ المُثَوِّبِ"],["96DE509C-010D-54BF-8F1A-CA3C9C27D839","سِلاحُ امرىءٍ قد يَعلَمُ النّاسُ أنّهُ","طَلُوبٌ لثأراتِ الرّجالِ مُطَلَّبِ"],["A88F8A86-0E86-5F26-AD68-07B52F46B7E5","فإنّي وإنْ كنتُ ابنَ فارِسِ عامِرٍ","وفي السرّ منها والصّريحِ المُهَذَّبِ"],["E994D620-C0D6-5EED-A2E7-AA6534D3AABA","فَما سَوَّدَتْني عامِرٌ وِراثَةٍ","أبَى اللهُ أنْ أسْمُو بأُمٍّ ولا أبِ"],["5FD7178B-7EB7-5457-81E3-91A21A5560FD","ولَكِنّني أحْمي حِماها وأتّقي","أذاها وأرْمي مَنْ رَمَاها بمِقْنَب"]]},"30070F81-AC8A-5507-AF12-EEE783F73D31":{"t":"تَوَضّحْنَ في عَلْيَاءِ قَفْرٍ كأنّهَا","p":40,"s":"توضحن في علياء قفر كأنها","r":"436635","v":[["5DC1C81B-AAA0-58A0-AF57-1A4CDD4FE187","تَوَضّحْنَ في عَلْيَاءِ قَفْرٍ كأنّهَا","مَهَارِقُ فَـلُّوجٍ يُعارِضْنَ تَالِيَا"]]},"D8FFA312-E298-5B52-81F6-8A3A81FA933E":{"t":"جَاؤوا بِشَهْرانِ العَريضَةِ كُلّهَا","p":40,"s":"جاؤوا بشهران العريضة كلها","r":"436611","v":[["BC466A0C-D5AE-5C23-BF00-C841B5D4B78B","جَاؤوا بِشَهْرانِ العَريضَةِ كُلّهَا","وأكْلُبِها مِيلادِ بَكْرِ بنِ وائِلِ"],["A9F0A669-9A30-595F-BC13-2809DD148274","وَسَعّتْ شُيُوخُ الحَيّ بَينَ سُوَيْقَةٍ","وبَينَ جَنُوبِ القَهْرِ مِيلَ الشّمائلِ"],["FF912AE6-BED9-5F2E-A6B4-86788CDCF3F9","فَلَوْ كانَ جَمْعٌ مِثْلُنا لم يَبُزّنَا","ولَكِنْ أتَانَا كُلُّ جِنٍّ وخابِلِ"],["5938BCCB-6CDE-5427-8A22-2D1BFF6F1369","فَبِتْنا ومَنْ يَنْزِلْ بِهِ مثلُ ضَيفِنا","يَبِتْ عَنْ قِرَى أضيافِهِ غيرَ غافِلِ"]]},"43873E65-BB29-5EB5-84CF-7D662C729219":{"t":"رَهِبْتُ وما مِنْ رَهبةِ الموْتِ أجزَعُ","p":40,"s":"رهبت وما من رهبة الموت أجزع","r":"436605","v":[["0347F6B8-58E0-546D-A236-E8897F357F0E","رَهِبْتُ وما مِنْ رَهبةِ الموْتِ أجزَعُ","وعالَجتُ هُمّاً كنتُ بالهمّ أُولَعُ"],["72C038D7-B16D-51DB-9707-F5515904BB85","وَليداً إلى أنْ خالَطَ الشّيبُ مَفرَقي","وَألبَسَني منْهُ الثَّغَامُ المُنَزَّعُ"],["C5248E27-ADB0-56CC-9570-E7AF6BF6D5F3","دَعاني سُمَيْطٌ يوْمَ ذَلِكَ دَعْوَةً","فَنَهْنَهْتُ عَنْهُ والأسِنّةُ شُرَّعُ"],["29E06448-2AA3-5F39-AC9B-4FD42D3240A2","ولَوْلا دِفاعي عَنْ سُمَيْطٍ وكَرّتي","لَعَالَجَ قِدّاً قَفْلُهُ يَتَقَعْقَعُ"],["23B46705-3688-520C-9419-9DBD96D16F43","وأقْسَمْتُ لا يَجْزِي سُمَيْطٌ بنعمةٍ","وكَيفَ يُجازيكَ الحِمارُ المُجدَّعُ"],["7CD3FADA-8415-5EDA-85EB-C41E059F15C0","وأمكَنَ منّي القَوْمَ يوْمَ لَقيتُهُمْ","نَوافِذُ قد خالَطْنَ جِسميَ أرْبَعُ"],["1820EF9C-C641-5C63-9119-1E18E396DFED","فَلَوْ شِئْتُ نَجّتْني سَبوحٌ طِمِرّةٌ","تَحُكّ بخَدّيْهَا العِنَانَ وتَمزَعُ"]]},"8F1C7B22-FD4A-58C9-8A6A-CDF0174CD77A":{"t":"زَعَمَ الوُشَاةُ بأنّ دُومَةَ أخْلَفَتْ","p":40,"s":"زعم الوشاة بأن دومة أخلفت","r":"436607","v":[["0D51903B-CFF3-54E2-82BE-8D2B47B462D5","زَعَمَ الوُشَاةُ بأنّ دُومَةَ أخْلَفَتْ","ظَنّي وقَلّصَ خَيرُها المَوْعُودُ"],["C971FE22-0739-593A-883A-D02C5F9D3120","صَدَقُوا وبَيّنَ لي شَواكِلُ أمْرِهَا","وجَرَى به حَرِقُ الجَنَاحِ قَعِيدُ"],["A49277C4-659C-5E5E-AD3C-A1A0F74FAE2A","مُتَقَارِبُ الحَنَكَينِ شَحّاجُ الضّحَى","أرِنٌ كأنّ جَنَاحَهُ مَشْدودُ"],["83B62457-7438-5908-8AFE-0E5B7E043714","فَزَجَرْتُهُ أنْ لا يُفَرِّجَ بَيْضُهُ","ويُصيبَهُ صَدىءُ الرِّصافِ سَديدُ"],["BC93E924-08E0-5B5F-B3B1-6B1A38E9A7E7","أفَرِحْتَ أنْ جُرْحٌ ألَمّ بفارِسٍ","لمْ يَبْقَ مِمّنْ سُدْتَ غَيرَ مَسُودِ"],["76D4AD1B-70A4-595A-B0A2-77CB84E88158","وَكَأنّ هادِيَهُ إذا اسْتَعْرَضْتَهُ","جِذْعٌ تَحَسّرَ ليفُهُ مَجْرُودُ"]]},"4AFFDC9F-25D7-523E-9110-9BDBCD10A599":{"t":"سَمَوْنَا بالجِيَادِ لِحَيّ وَرْدٍ","p":40,"s":"سمونا بالجياد لحي ورد","r":"436593","v":[["4B5E7F69-F4EF-5C3A-AD09-37475D544EF2","سَمَوْنَا بالجِيَادِ لِحَيّ وَرْدٍ","فَلاقَوْا بَعْدَ وَقْعَتِنا النّكِيرَا"],["9D6DC9A2-57D9-5A39-A099-743733C346FC","أبَدْنَا حَيّ ذي البَزَرَى وكَعْباً","ومالِكَها وأهْلَكْنَا بَشِيرَا"],["383DDDDF-A241-5A10-91B8-4080594559A7","وقَرّبْنا الرِّبابَةَ يَوْمَ فَجٍّ","إلى هُلْكٍ وأعْلَقْنا عَشِيرَا"],["5599DADA-9F58-5506-A1E3-955E4293131A","وسَيّاراً فَتى سَعْدِ بنِ بَكْرٍ","وأقْعَصْنَا بِمَفْرُوقٍ بَحِيرَا"]]},"69F8119D-DAC2-5DA2-B35B-70A789C12D42":{"t":"سُودٌ صَناعِيَةٌ إذا ما أوْرَدوا","p":40,"s":"سود صناعية إذا ما أوردوا","r":"436582","v":[["9749FEDE-8D38-5458-B022-5599F3EFD396","سُودٌ صَناعِيَةٌ إذا ما أوْرَدوا","صَدَرَتْ عَتُومَتُهُمْ ولمّا تُحلَبِ"],["F6414CF5-93E2-5F9E-83EC-F215A833C2F8","صُلْعٌ صَلامِعَةٌ كأنّ أُنُوفَهُمْ","بَعَرٌ يُنَظّمُهُ الوَليدُ بملْعَبِ"],["A36E18E1-B217-5C9B-BC97-5A6BBDB2B2DC","لا يَخْطُبونَ إلى الكِرامِ بَناتِهِمْ","وتشيبِ أيّمُهُمْ ولَمّا تُخْطَبِ"]]},"B3A9C25D-1D34-5D09-95F2-517A2D063F24":{"t":"صَبَحْنا الحَيَّ مِن عَبسٍ صَبوحاً","p":40,"s":"صبحنا الحي من عبس صبوحا","r":"436613","v":[["2498E93E-D965-5A15-9484-2B0974960534","صَبَحْنا الحَيَّ مِن عَبسٍ صَبوحاً","بِكَأسٍ في جَوانِبِها الثّميلُ"],["ECB5312C-9B09-5577-AC50-4D3872563276","وأبْقَيْنا لِمُرّةَ يَوْمَ نَحْسٍ","وإخوَتِهِمْ فَقَدْ ذَهَبَ الغَليلُ"],["8667B38B-9B5F-55A4-888A-4F43215E60EA","تَرَكْنَا دُورَهُمْ فيهَا دِمَاءٌ","وأجْسادٌ فَقَدْ ظَهَرَ العَويلُ"],["7782BC54-635E-5483-850D-6F91B11141C5","فَذَلّ الأبْلَخُ المُخْتَالُ إنّا","نُخَيّسُهُ وعَزّ بِنَا الذّليلُ"],["8CC6C55D-73D6-5941-A12C-D1E3954F9053","قَتَلْنَا مالِكاً وأبَا رَزِينٍ","غَداةَ القاعِ إذ لَمَعَ الدَليلُ"],["24599ECC-06BB-59B8-B086-AF94CA6864E0","لَنا في الرّوْعِ أبْطالٌ كِرامٌ","إذا ما الخَيلُ جَدّ بهَا الصَّهيلُ"],["01BAB5E6-DD4F-5810-AA28-3C1504DC9F07","على جُرْدٍ مُسَوَّمَةٍ عِتَاقٍ","تَوَقَّصُ بالشّبابِ وبالكُهُولِ"],["180DFF30-58B3-5450-80BB-BD5325DB0768","إذا ما الرّكْضُ أسهَلَ جانِبَيها","وَجَدّ السّيرُ وانْقَطَعَ النّقيلُ"],["3E6EF487-8F89-55DE-A3EA-E570F78125D2","ويَوْمَ الشِّعْبِ غادَرْنَا لَقيطاً","بأبْيَضَ صارِمٍ عَضْبِ صَقيلِ"],["BDDCC1E3-1800-5825-9D3F-B475544572DC","غَداةَ أرادَ أنْ يَسْمُو إلَيْنَا","بأُسْرَتِهِ وأخْلَفَه القَبيلُ"],["FBEDB42C-ED51-5901-8E94-99F245EE6BF5","فأُبْنَا غَانِمِينَ بِما اسْتَفَأنَا","نَسوقُ البِيضَ دَعْواها الأليلُ"]]},"3645F2F9-11D0-5F4A-A9C8-4805C71732E2":{"t":"طُلّقْتِ إنْ لم تَسألي أيّ فارِسٍ","p":40,"s":"طلقت إن لم تسألي أي فارس","r":"436629","v":[["30E6208C-A541-5082-A403-D8E14860B09D","طُلّقْتِ إنْ لم تَسألي أيّ فارِسٍ","حَليلُكِ إذْ لاقَى صُداءً وخَثعَمَا"],["38C95C7F-9C71-5F5D-8E8C-4ACFE24E834D","أكُرّ عَلَيْهِمْ دَعْلَجاً ولَبَانُهُ","إذا مااشتكَى وَقعَ الرّماحِ تحَمحَمَا"]]},"315122CF-C2B2-52A7-B07D-58933950028D":{"t":"عَجَباً لِواصِفِ طَارِقِ الأحْزانِ","p":40,"s":"عجبا لواصف طارق الأحزان","r":"436633","v":[["AABCAE48-0E09-5820-8B57-14F8610F71EF","عَجَباً لِواصِفِ طَارِقِ الأحْزانِ","وَلِمَا تَجيءُ بِهِ بَنو الدّيّانِ"],["668EE7B9-DD81-58AC-B6FF-C91EF441C592","فَخَرُوا عَلَيّ بِجِبْوَةٍ لِمُحَرِّقٍ","وإتاوَةٍ سِيقَتْ إلى النّعْمانِ"],["4EC0A55C-46A4-5B0D-B320-05731C18DE9E","ما أْنَت وابنَ مُحَرِّقٍ وقَبيلَهُ","وإتَاوَةَ اللّخْمِيّ في عَيْلانِ"],["9A0F697F-E393-5A59-B1AA-3B0DD6B97149","فاقصِدْ بذَرْعكَ قَصْدَ قوْمكَ نصرَهم","وَدَعِ القَبائِلَ مِنْ بَني قَحطانِ"],["E53DBE35-E4C6-5F9A-B72B-EA8FFBB5C7AA","إنْ كانَ سالِفَةُ الإتَاوَةِ فيكُمُ","أوْلى فَفَخْرُكَ فَخْرُ كلّ يَمَاني"],["3B8DD0E3-47E7-5FE6-B25E-00EC74E63C7E","وافخَرْ برَهْطِ بَني الحِماسِ ومالكٍ","وبَني الضِّبابِ ورَعْبَلٍ وقِيَانِ"],["C1828DC7-F1A1-55E0-8878-5516CAB273A4","فأنَا المُعَظَّمُ وابنُ فارِسِ قُرْزُلٍ","وأبُو بَراءٍ زانَني ونَمَاني"],["E1EF75CF-D0E7-5373-B839-2591BFFE86A5","وأبُو جَرِيٍّ ذو الفَعَالِ ومَالِكٌ","مَنَعَا الذّمارَ صَبَاحَ كُلّ طِعَانِ"],["7C6C1441-F11B-530C-B62D-2715CC2B1FF4","وإذا تَعَاظَمَتِ الأمُورُ هَوازِناً","كُنْتُ المُنَوَّهَ باسْمِهِ والبَاني"]]},"EBAC53A5-95A6-5060-938F-4D68AE8CDE3C":{"t":"عَرَفْتَ بِجَوّ عَارِمَةَ المُقَامَا","p":40,"s":"عرفت بجو عارمة المقاما","r":"436620","v":[["EAA241C3-3919-50F1-AD53-CF9552CD9FB8","عَرَفْتَ بِجَوّ عَارِمَةَ المُقَامَا","لسَلْمَى أوْ عرَفتَ لهَا عَلامَا"],["FF47BAD1-7B51-5327-B780-0592FE3ED08A","لَيَاليَ تَسْتَبيكَ بذي غُرُوبٍ","ومُقْلَةِ جُؤذَرٍ يَرْعَى بَشَامَا"],["C7A80209-970A-5120-8C63-75F63A0817D5","فإنْ يَمْنَعْكِ قَوْمُكِ أنْ تَبيني","فَقَدْ نَغنى بعارِمَةٍ سِلامَا"],["C4A88381-68B7-58A6-A576-E9CF9AAD521D","فلَوْ عَلِمَتْ سُلَيْمَى عِلْمَ مثلي","غَداةَ الرّوْعِ واصَلَتِ الكِرامَا"],["263E3311-F1CB-5564-855D-33877402D34C","تَرَكْنا مَذْحِجاً كحديثِ أمسٍ","وأرْحَبَ إذْ تكفّنُهُمْ فِئَامَا"],["3156DBE0-172F-501A-95D5-E530E3BF11DF","وبِعْنا شاكِراً بِتِلادِ عَكٍّ","ولاقَى مَنْسِرٌ مِنّا جُذامَا"],["AE51E590-4927-52BF-86D4-58418BE9CF29","وَطَحْطَحْنا شَنوءَةَ كلَّ أوْبٍ","ولاقَتْ حِمْيَرٌ مِنّا غَرامَا"],["9F619466-80EC-5257-9BB4-ADCB520BE96F","وهَمْدانٌ هُنالِكَ ما أُبَالي","أحَرْباً أصْبَحُوا لي أمْ سِلامَا"],["8FAA21DE-987A-536D-803A-64D6EE4AA6A5","ولاقَيْنا بأبْطَحِ ذي زَرُودٍ","نِساءَهُمُ مُسَلِبَةً أيَامَى"],["5488B1FA-F887-52D7-BC8B-D9CF58AFC2A2","وَقَتّلْنَا سَرَاتَهُمُ جِهَاراً","وأشبعنا الضِّباعَ خُصًى عِظاماَ"],["D40BE6D6-466A-52DC-9667-405C68A6623D","وقَتّلْنَا حَنِيفَةَ في قُرَاهَا","وأفْنى غَزْوُنَا حَكَماً وحَامَا"],["B7D0A291-E801-51D4-A808-2EC3D6088679","قَتَلْنا كَبْشَهُمْ فنَجَوْا شِلالاً","كمَا نَفّرْتَ بالطّرْدِ النَّعَامَا"],["5BABFF00-2861-5592-B555-90A209ED8EEB","وحَيّاً مِن بَني أسَدٍ تَرَكْنَا","وأذْوادٍ فَكُنّ لَنَا طَعَامَا"],["41ADFEB1-1FE8-5036-AF49-70EE9C931DEF","وبَيّتنَا زُبَيْداً بَعْدَ هَدْءٍ","فَصَبّحَ دارَهُمْ لَجِباً لُهَامَا"],["8275300B-4EBC-53C4-A85A-35683DF09783","وقَدْ نِلْنَا لعَبدِ القَيسِ سَبْياً","منَ البَحْرَينِ يُقْتَسَمُ اقتِسامَا"],["601F689B-D123-5798-B4A7-142E83177947","ولاقَيْنَا بِذي نَجَبٍ حُصَيْناً","فأهْلَكْنَا بمَقْلَتِنَا أُسَامَا"],["3BADC201-745E-5B96-A35F-A670F6D1A03F","وأفْلَتَنَا على الحَوْمانِ قَيْسٌ","وأسْلَمَ عِرْسَهُ ثُمّ اسْتَقَامَا"],["A6846717-8C37-547A-B5A1-C2F35A8D9640","وَلَوْ آسَى حَليلَتَهُ لَـلاقَى","هُنَالِكَ مِنْ أسِنّتِنَا حِمَامَا"],["D4AA0DC7-74B3-5284-B153-8C9AC9BF371E","وآلُ الجَوْنِ قَدْ سارُوا إلَيْنَا","غَداةَ الشِّعبِ فاصْطُلموا اصْطلامَا"],["6C721287-4842-57B2-939B-2338F2249D85","قَتَلْنَا مِنْهُمُ مائَةً بِشَيْخٍ","وَصَفْدْناهُمُ عُصَباً قِيَامَا"],["3560E96D-BA4D-50D1-B8E0-BE0E314C78C1","ويَوْمَ الشِّعْبِ لاقَيْنَا لَقِيطاً","كَسَوْنَا رَأسَهُ عَضْباً حُسامَا"],["08291A31-EC7E-5B28-8F98-E6410567A456","أسَرْنَا حاجِباً فَثَوَى أسِيراً","ولَمْ نَتْرُكْ لأسْرَتِهِ سَوَامَا"],["9A64B139-CE4A-55B5-9AD7-1B5271DCAA7A","وجَمْع بَني تَميمٍ قَدْ تَرَكْنَا","نُبِينُ سَواعِداً مِنهُمْ وهَامَا"],["4CA38EDE-5E74-5B8E-A6BB-C08104DF84FB","وكانَ لَهُمْ بهَا يَوْمٌ طَوِيلٌ","لتُبْليَ بَيْنَها سَجْلاً وخَامَا"],["49867117-5382-51AF-972A-B82CA4E95557","بدارِهِمُ تَرَكْنَا يَوْمَ نَحْسٍ","لَدَى أوطانِهِمْ تُسْقَى السِّمامَا"],["1D6841EB-068D-53A4-9530-50F1398621F4","فإنْ لا يُرْهِقِ الحَدَثانُ نَفْسِي","يُؤدّوا الخَرْجَ لي عاماً فَعَامَا"],["72630449-6DF7-5584-897E-D6A852522509","يُؤدّوهُ على رَغْمٍ صَغَاراً","ويُعْطُونَا المَقادَةَ والزّمَامَا"],["C2AF2A1D-3706-51FE-9729-A82318745A7F","فأبْلِغْ إنْ عَرَضْتَ جميعَ سَعدٍ","فَبيتُوا لَنْ نَهيجَكُمُ نِيَامَا"],["75C9F8E7-3D4D-5D0E-8B8A-439295EE4BF9","نَصَحْتُمْ بالمَغيبِ ولَمْ تُعينُوا","عَلَيْنا إنّكُمْ كُنْتُمْ كِرامَا"],["FD141357-D0F8-52D6-8172-77D705AA6174","فلوْ كُنتُمْ معَ ابنِ الجَوْنِ كنتُمْ","كَمَنْ أوْدى وأصْبحَ قد ألامَا"]]},"FD53ED67-30DD-57A4-8FFD-F6E4556FB23A":{"t":"فإنْ تَنْجُ مِنْها يا ضُبَيْعَ فإنّني","p":40,"s":"فإن تنج منها يا ضبيع فإنني","r":"436624","v":[["11813F70-D5FC-57C4-83E6-D9E3E4DD4559","فإنْ تَنْجُ مِنْها يا ضُبَيْعَ فإنّني","وجَدِّكَلم أعْقِدْ عَلَيْكَ التّمَائِمَا"],["B073B106-FD3A-5465-B461-E1E29E801DC5","فَأنْزَلْتُهُ إنْزَالَ مِثْليَ مِثْلَهُ","بِنَجْلاءَ بَلّتْ ظَهْرَهُ والمَآكِمَا"],["A8995D29-5918-594B-AAB7-92757EE425D1","وأدّيْتُ زَيْداً بَعْدَمَا كانَ ثَاوِياً","إلى أهْلِهِ يَوْمَ الثّنِيّةِ سالِمَا"],["9F55ED3F-8AB4-5CF6-A052-804D9F0CDD00","فأصْبَحْتُمُ لا في سَوَامِ فِدائِهِ","وأصْبَحَ في تَيْمانَ يَخْطِرُ نَاعِمَا"],["FE2644EB-1D0B-55D2-A704-E979848FA819","يُزَجّى جِيادَ الخَيلِ نحوَ دِيارِكُمْ","وقد كانَ في جِلْدٍ مِنَ القِدّ آزِمَا"],["EB9FD4D6-08AE-52BA-A677-2DE1220C975D","فَلا تَعجَلَنْ وانْظُرْ بأرْضِكَ فارِساً","يَهُزّ رُدّيْنِيّاً وَأبْيَضَ صَارِمَا"],["39DD5AD4-1A36-5CE0-A028-AC9E54A9B0D5","لَهُ كُلَّ يَوْمٍ غارَةٌ عُرِفَتْ لَهُ","إذا قادَها للمَوْتِ جُرْداً سَواهِمَا"],["04AA913F-A7AD-553C-8AF4-86C4F02C46FA","وعَبْدَ بَني بَرْشَا تَرَكْنَا مُجَدَّلاً","غَداةَ ثَوَى بَينَ الفَوارِسِ كازِمَا"],["F0B15E6B-5DFD-5D86-BC8E-D069E98F727A","تَنَاوَلْتُهُ فاخْتَلَّ سَيْفي ذُبَابُهُ","شَراسيفَهُ العُلْيَا وجَدّ المَعاصِمَا"],["D796429C-39FD-54A1-8CE9-8252E8AEE570","وأنْتَ قَرِيبٌ قد رأيْتَ مَكانَهُ","تُنادي شَتِيراً يَوْمَ ذاكَ وعاصِمَا"]]},"F5C2167C-985F-5E4E-B7A0-59C8D0419670":{"t":"قَتَلْنَا يَزدَ بنَعَبْدِ المَدانِ","p":40,"s":"قتلنا يزد بنعبد المدان","r":"436623","v":[["C0C4FFF1-B2FE-5EF7-9F16-81ACE9967373","قَتَلْنَا يَزدَ بنَعَبْدِ المَدانِ","على غَيرِ جُرْمٍ ولمْ نَظْلِمِ"],["E9560989-051C-5A32-90DC-7A2BD0DDA6E1","بأعْوَى ويَوْمَ لَقينَاهُمُ","بأرْعَنَ ذي لَجَبٍ مُبْهِمِ"]]},"12AF3EDD-0AF6-5B51-AAF4-0336847AF2D9":{"t":"قَضَى اللهُ في بَعضِ المَكارِهِ للفَتّى","p":40,"s":"قضى الله في بعض المكاره للفتى","r":"436599","v":[["436911D0-863D-508D-9C2B-69CEEA94F7BB","قَضَى اللهُ في بَعضِ المَكارِهِ للفَتّى","برُشْدٍ وفي بَعضِ الهَوَى ما يُحاذِرُ"],["A5442D38-7DA3-5267-8956-F3AD2FEEEDCF","ألَمْ تَعْلَمي أني إذا الإلْفُ قادَني","إلى الجَوْرِ لا أنْقادُ والإلْفُ جائِرُ"]]},"4B8303FD-DA7D-5B03-8EC6-92AC14E67765":{"t":"قَضَيْنا الجَوْنَ عَن عَبسٍ وكانَتْ","p":40,"s":"قضينا الجون عن عبس وكانت","r":"436617","v":[["B2BCD5D9-17BF-599B-B6D6-E7DD2BB830B6","قَضَيْنا الجَوْنَ عَن عَبسٍ وكانَتْ","مَنِيّةُ مَعبَدٍ فينَا هُزَالا"]]},"8EBDDFFE-0E27-5277-B99F-05AFF229AC93":{"t":"قُلْ لزَيْدٍ قد كنتَ تُؤثَرُ بالحِلْـ","p":40,"s":"قل لزيد قد كنت تؤثر بالحلـ","r":"436616","v":[["6515B3CC-4924-5E6A-9CCF-B5EBFF643A84","قُلْ لزَيْدٍ قد كنتَ تُؤثَرُ بالحِلْـ","ـمِ إذا سَفِهتْ حُلُومُ الرّجالِ"],["DBDB56F6-1C45-59C8-BDE5-A062EEE4FECF","لَيسَ هذا القَتيلُ مِن سَلَفِ الحَـ","ـيّ كَلاعٍ ويَحْصُبٍ وكُلالِ"],["98F1EB02-947F-5EC7-97C0-F601E7B14A79","أوْ بَني آكِلِ المُرارِ ولا صِيـ","ـدِ بَني جَفنَةَ المُلوكِ الطّوالِ"],["0FA80F4F-F8C9-5035-9C1D-E525FC09B50F","وابنِ ماءِ السّماءِ قَدْ عَلِمَ النّا","سُ ولا خَيرَ في مَقالَةِ غَالي"],["B1178F15-785E-5F73-B3EB-7E0CBAB04973","إنّ في قَتْلِ عامِرِ بنِ طُفَيْلٍ","لَبَوَاءً لِطَيّءِ الأجْبَالِ"],["657786D6-00C6-5101-A7BC-8E3A8E5EFC08","إنّني والّذي يَحُجُّ لَهُ النّا","سُ قَليلٌ في عَامِرٍ أمْثالي"],["176FAF4E-4993-59A7-90AD-A914C603100F","يَوْمَ لا مالَ للمُحارِبِ في الحَرْ","بِ سِوَى نَصْلِ أسْمَرٍ عَسّالِ"],["99936163-BBE7-5A9F-9DF5-44F04F681B30","ولِجَامٍ في رأسِ أجْرَدَ كالجِذْ","عِ طُوالٍ وأبْيَضٍ قَصّال"],["ADD65004-E639-5F83-B87F-8058DCF8F16A","ودِلاصٍ كالنّهْيِ ذاتِ فُضُولٍ","ذاكَ في حَلْبَةِ الحَوادِثِ مالي"],["3BAC7CB1-625B-5EF6-9993-5353ECFC6E85","ولِعَمّي فَضْلُ الرّئَاسَةِ والسّـ","ـنّ وجَدٍّ على هَوازِنَ عَالي"],["569F2C57-3FFF-5926-8FE1-31F8DC46BCA1","غَيرَ أنّي أوْلى هوازِنَ في الحَرْ","بِ بضَرْبِ المُتَوَّجِ المُخْتالِ"],["C9F9C2FE-DE33-5C60-94EC-D326B485B7CD","وبطَعْنِ الكَميّ في حَمَسِ النّقْـ","ـعِ على مَتْنِ هَيْكَلٍ جَوّالِ"]]},"46CFDF67-FCA8-5B27-AC19-633F69143CD9":{"t":"كانَ التّبابِعُ في دَهْرٍ لهُمْ سَلَفٌ","p":40,"s":"كان التبابع في دهر لهم سلف","r":"436628","v":[["8A2E8947-E4D6-50BF-B60B-7C033B253619","كانَ التّبابِعُ في دَهْرٍ لهُمْ سَلَفٌ","وابنُ المُرارِ وَأمْلاكٌ على الشّامِ"],["F4C78DA7-BF94-514B-84FD-7EBE6ED4067C","حتى انتَهَى الُملْكُ من لخمٍ إلى مَلكٍ","بادي السّنانِ لمَنْ لم يَرْمِهِ رامي"],["43ED5411-0915-593B-860E-D5CFCBA26581","أنْحَى عَلَيْنَا بأظْفارٍ فَطَوّقَنَا","طَوْقَ الحَمامِ بإتْعاسٍ وإرْغامِ"],["70056C93-448E-57BA-B40C-EC5C3ABF8DF2","إْن يُمكِنِ اللهُ مِنْ دَهْرٍ تُساءُ بهِ","نَترُككَ وَحدكَ تَدعو رَهطَ بِسطامِ"],["950EA635-93EA-5A47-853D-8E056ADD5CE4","فانظرْ إلى الصِّيدِ لم يحموكَ من مُضَرٍ","هل في ربيعَةَ إنْ لم تَدْعُنا حامي"]]},"0D98FFEA-90ED-5040-862F-0C23EEBDB3D6":{"t":"لا تَسْقِني بيَدَيْكَ إنْ لمْ أغْتَرِفْ","p":40,"s":"لا تسقني بيديك إن لم أغترف","r":"436583","v":[["49F2FB8D-9B03-51BD-A0F8-2918D33224A0","لا تَسْقِني بيَدَيْكَ إنْ لمْ أغْتَرِفْ","نِعْمَ الضَّجوعُ بغارَةٍ أسْرابِ"]]},"92FDBCD5-B868-536C-ABD6-ACA9108CB053":{"t":"لقد عَلمِتْ عُليا هَوازنَ أنَّنِي","p":40,"s":"لقد علمت عليا هوازن أنني","r":"436594","v":[["AE00785B-F844-5F35-A730-61662D1D2F16","لقد عَلمِتْ عُليا هَوازنَ أنَّنِي","أنا الفارس الحامي حَقيقةَ جَعْفرِ"],["458CDE1C-721B-5CC6-BC64-2A87D80D906E","وقد عَلِمَ المزنُوقُ أنِّي أكِرُّهُ","عَشِيّةَ فَيْفِ الرّيحِ كَرَّ المُشَهَّرِ"],["2EFDC578-A3E6-5AD2-BE3D-0D93F28C6987","إذا ازْوَرّ مِنْ وَقْعِ الرّماحِ زَجَرْتُهُ","وقُلتُ له ارجِعْ مُقبِلاً غيرَ مُدبِرِ"],["D9D1D394-888A-5029-A7CF-591DE6BAE923","وَأَنبَأتُهُ أَنَّ الفِرارَ خَزايَةٌ","عَلى المَرءِ ما لَم يُبلِ عُذراً فَيُعذَرِ"],["EEB789EC-5A71-56C7-89ED-8ABF221AF409","ألستَ تَرَى أرماحَهم فيَّ شُرَّعاً","وأنتَ حِصانٌ ماجِدُ العِرْقِ فاصْبِرِ"],["E2CB3650-50D7-5ADA-85A8-402814C01611","أردتُ لكيلاَ يعلمَ الله أننِي","صَبَرتُ وأخْشَى مثلَ يوم المُشَقَّرِ"],["CBD2E0C7-7584-5B51-8C1A-9144938CBD94","لَعَمري ومَا عَمْري عَليَّ بهَيِّنٍ","لقد شَانَ حُرَّ الوجهِ طعنَةُ مُسْهِرِ"],["0A40761B-D2AA-589F-92C9-04093C575893","فَبِئْسَ الفتى إنْ كُنتُ أعوَرَ عاقِراً","جَبَاناً فَما عُذري لَدى كلِّ محْضَرِ"],["45D7E452-A149-56E5-91C6-B7FB80C09569","وقَدْ علِمُوا أنّي أكُرّ عَلَيْهِمِ","عَشِيّةَ فَيْفِ الرِّيحِ كَرَّ المُدَوَّرِ"],["419723EE-D779-585D-BA47-A500A7823897","وما رِمْتُ حَتَّى بَلَّ صَدْري وصَدْرَهُ","نَجيعٌ كَهُدّابِ الدِّمَقْسِ المُسَيَّرِ"],["8959DCB1-B7D3-506C-A2BB-438DC4998B22","فَلَو كانَ جَمعاً مِثلَنا لَم يَبُزُّنا","وَلَكِن أَتَتنا أُسرَةٌ ذاتُ مَفخَرِ"],["11E7CB01-DFF5-5CF9-B347-2E5CB4031651","أَتَونا بِشَهرانِ العَريضَةِ كُلِّها","وَأَكلُبَ طُرّاً في جِيادِ السَنَوَّرِ"]]},"36BE0CEE-076E-5F14-827F-FE5E0D159422":{"t":"للمُقْرَباتِ غُدُوٌّ حِينَ نُحْضِرُهَا","p":40,"s":"للمقربات غدو حين نحضرها","r":"436585","v":[["32B451BF-EFD5-54D0-A560-833607E6012A","للمُقْرَباتِ غُدُوٌّ حِينَ نُحْضِرُهَا","وغارَةٌ تَسْتَثِيرُ النّقْعَ في رَهَجِ"],["B580C75B-8545-54C7-903D-D8F4ECA80097","فَما يُفارِقُني المَزْنُوقُ مُحْتَمِلاً","رِحَالَةً شَدَّهَا المِضْمارُ بالثّبَجِ"],["EF8EFF15-267D-5DDD-9234-6FCD43A424C8","إذا نَعَى الحَرْبَ ناعُوها بَدَتْ لهُمُ","أبْناءُ عامِرَ تُزْجي كُلّ مُخترَجِ"],["24DC8754-15CB-5EC4-B3F7-46AE287C2D6C","عَلَيْهِمُ البَيضُ والأبدانُ سَابِغَةً","يُقَحِّمُونَ كأنّ القَوْمَ في رَهَجِ"],["D8731941-915D-52FA-A9AE-77F7C83111C3","صَبَحْنَ عَبْساً غَداةَ الرَّوْعِ آوِنَةً","وهُنّ عالَينَ بابنِ الجَوْنِ في دَرَجِ"],["FD95B62C-944B-536C-87C8-D9A3285D344F","وانقَضّتِ الخيلُ من وادي الذِّنابِ وقد","أصْغَتْ أسِنّتَها حُمراً منَ الوَدَجِ"],["83BE5AD8-20A8-5292-9B97-2717C6DDB098","إنْ تَسألي الخَيلَ عَنّا في مَواقِفِها","يَوْمَ المُشَقَّرِ والأبْطالُ في زَعَجِ"],["36E36EE3-BA60-5C81-AE2E-F807B7C7D1DA","تُخْبِرْكِ أنّي أُعِيدُ الكَرَّ بَيْنَهُمُ","إذا القَنَا حُطِمَتْ في يوْمِ مُعتَلَجِ"]]},"AE0FAFB4-3956-511A-B806-740D9CC53407":{"t":"للَّهِ غارَتُنا والمَحْلُ قَدْ شَجِيَتْ","p":40,"s":"لله غارتنا والمحل قد شجيت","r":"436632","v":[["FDA19585-E736-5734-9448-EF47FA937AD7","للَّهِ غارَتُنا والمَحْلُ قَدْ شَجِيَتْ","مِنْهُ البِلادُ فَصارَ الأُفْقُ عُرْيانَا"],["B13E27D4-CF33-56CE-A2DB-38AAB3F0C860","حتى صَبَبْنَا على هَمْدانَ صَيّقَةً","سُؤرَ الكِلابِ وما كانوا لنا شَانَا"],["F5B54269-E627-52DD-B8EB-4ABFA409D036","فَظَلّ بالقَاعِ يوْمٌ لمْ نَدَعْ كَتَداً","إلاّ ضَرَبْنَا ولا وَجْهاً ولا شَانَا"],["843FCA7D-E085-5C88-81D7-5292EAB8B673","ثمّ نَزَعْنَا وما انْفَكّتْ شَقاوَتهُمْ","حَتى سَقَيْنَا أنَابِيباً وخِرْصَانَا"],["3B621FEC-05A7-578A-AB1D-5BA550D3A495","وما أرَدْناهُمُ عَنْ غَيرِ مَعْذِرَةٍ","مِنّا ولَكِنّهُ قَدْ كانَ ما كانَا"],["13B9323A-AFBE-5F70-AB8A-A1278F3C6E96","سِرْنَا نُريدُ بَني نَهْدٍ وإخْوَتَهُمْ","جَرْماً ولكِنْ أرادَ اللهُ هَمْدانَا"]]},"70F2CB82-52F0-55EF-9529-0D8F981B713D":{"t":"لَتَسْألَنْ اسْمَاءُ وَهْيَ حَفِيّةٌ","p":40,"s":"لتسألن اسماء وهي حفية","r":"436592","v":[["CFB4745B-D56C-5126-9533-E3630F2AE76D","لَتَسْألَنْ اسْمَاءُ وَهْيَ حَفِيّةٌ","نُصَحاءَها أطُرِدْتُ أم لم أُطْرَدِ"],["479D09E8-7821-5180-80D5-F825472FFDFD","قالُوا لها: إنّا طَرَدْنَا خَيْلَهُ","قُلْحَ الكِلابِ وكنتُ غيرَ مُطرَّدِ"],["B642F9B6-B864-55DB-8D17-6C626F0EF19A","فَلأبْغِينّكُمُ المَلا وعُوارِضاً","ولأورِدَنّ الخَيلَ لابَةَ ضَرْغَدِ"],["3940F885-D984-5F16-A4C4-C8574E698B7B","والخَيْلُ تَرْدي بالكُماةِ كأنّها","حِدأٌ تَتابَعُ في الطّريقِ الأقصَدِ"],["F156611E-50D1-5D70-ACD7-0622F60F75D1","فَلأثْأرَنّ بِمَالِكٍ وبِمالِكٍ","وأخي المَرَوْراةِ الذي لم يُوسَدِ"],["A7FDAA4C-3133-526E-BAD7-8AA6FB32AAA4","وقَتيلِ مُرّةَ أثْأرَنّ فإنّهُ","فَرْعٌ وإنّ أخاهُمُ لم يُقْصَدِ"],["E582C55C-3D5C-57AD-9E57-4FCE85A45D85","يا أسْمَ أُخْتَ بَني فَزارَةَ إنّني","غازٍ وإنّ المَرْءَ غيرُ مُخَلَّدِ"],["12EFEE70-259C-55AE-897F-350DC86123B9","فِيئي إلَيْكِ فَلا هَوادَةَ بَيْنَنا","بعدَ الفَوارِسِ إذ ثَوَوْا بالمرْصَدِ"],["411F7312-4AD4-516F-BFC4-77975671794D","إلاّ بكُلّ أحَمّ نَهْدٍ سَابِحٍ","وعُلالَةٍ مِن كلّ أسمَرَ مِذْوَدِ"],["B92903A0-AF69-5933-84F2-1E86ABBBFBA9","وأنَا ابنُ حَرْبٍ لا أزالُ أشُبّهَا","سَعْراً وأُوقِدُها إذا لم تُوقَدِ"]]},"CA327217-7B75-5E7E-AB16-689D0E0BF5A0":{"t":"لَعَمْري لَقَدْ أهدي زِيادٌ مَقالَةً","p":40,"s":"لعمري لقد أهدي زياد مقالة","r":"436596","v":[["A3BC069B-7BD1-5258-989A-FB21A8162946","لَعَمْري لَقَدْ أهدي زِيادٌ مَقالَةً","عَلَينا فهلْ إنْ كان ذا مِرّةٍ ضَرَرْ"],["351BB60B-E96B-5907-94CB-8B10AD8C34AB","تُعَيّرُنَا يَوْمَ المَرَوْرَاةِ سَادِراً","وعِنْدَكَ مِنْ أيّامِنا قَبلَها غِيَرْ"],["8129BB5C-888B-5E8A-9474-2821160E192C","فَمَنْ مُبلِغٌ ذُبْيانَ عَني رِسالَةً","مُغَلْغَلَةً مني وَما تَنفَعُ العِذَرْ"],["348A96E5-256A-578E-B273-75A6D3FE8F2F","وَقَدْ عَلِمَتْ عُلْيَا هَوازِنَ أنّنَا","بنو الحربِ لا نَعْيا بوِرْدٍ ولا صَدَرْ"],["E4DD22A1-72F5-5497-A6EB-CE1CC116130B","نَشُدّ عِصابَ الحَرْبِ حتى نُدِرّها","إذا ما نُفوسُ القومِ طالَعَتِ الثُّغَرْ"],["E6653E0D-3912-5D61-BECD-328C8EEAC873","تَرَى رائِداتِ الخَيْلِ حَوْلَ بُيُوتِنا","أبَابيلَ تَرْدي بالعَشِيّ وبالبُكُرْ"]]},"6A5BA58A-BE67-517E-A4E0-7DFACEDD2963":{"t":"لَعَمْرُكَ ما تَنفَكّ عني مَلامَةً","p":40,"s":"لعمرك ما تنفك عني ملامة","r":"436597","v":[["3EE5EFC5-3F24-5B94-885D-D51025C21CFF","لَعَمْرُكَ ما تَنفَكّ عني مَلامَةً","بَنو جَعْفَرٍ ما هَيّجَ الضّغنُ جعفَرَا"],["8AD31ECA-659F-5A5D-82CC-555F0FDD7A93","إذا قُلتُ هذا حِينَ راجَعَ وُدُّهَا","أبَى حِقْدُها في الصّدرِ إلاّ تَذكُّرَا"],["D792D074-9D63-5280-A979-6F1481EDE228","لمَهْلَكِ أفْرَاسٍ أُصِبْنَ ورُبّمَا","أصابُوا بها أمْثالَها ثُمّ أكْثَرَا"],["37A65CF6-4B2D-5242-AC0E-67533331E7B3","منَ الأرْضِ أهْلاً بَعدَ مالٍ وَجيرَةٍ","وَأبْقَتْ لَهُمْ مِنّي مَآتِمَ حُسَّرَا"]]},"B4FEBCFA-4190-5DBB-99B2-C05D74CD8F2C":{"t":"لَقَدْ تَعْلَمُ الحَرْبُ أنّى ابنُها","p":40,"s":"لقد تعلم الحرب أنى ابنها","r":"436622","v":[["C95E8F66-ED79-57CA-A4B1-02B46D595E58","لَقَدْ تَعْلَمُ الحَرْبُ أنّى ابنُها","وأنّى الهُمامُ بِها المُعْلِمُ"],["88BAE944-DB2A-5B64-A823-4894D889671D","وأنّي أحُلّ عَلى رَهْوَةٍ","منَ المَجدِ في الشّرَفِ الأعظَمِ"],["A68B46C8-1DEE-5699-8662-57D62A9C20BF","وأَنّي أُشَمِّصُ بالدّارِعِيـ","ـنَ في ثَوْرَةِ الرَّهَجِ الأقْتَمِ"],["31C6A337-60DE-5A43-BE7E-7CB347C2D44B","وأَنّي أكُرّ إذا أحْجَمُوا","بأكْرَمَ مِنْ عَطْفَةِ الضّيغَمِ"],["B9EA8D48-E089-5B10-989C-EDF384AA0430","وأضرِبُ بالسّيفِ يَوْمَ الوَغَى","أقُدّ بهِ حَلَقَ المُبْرَمِ"],["A6139A8E-FCC1-57C7-B430-E00E6A8EA0F0","فَهَذا عَتَادي لَوَ انّ الفَتَى","يُعَمَّرُ في غَيرِ ما مَهْرَمِ"],["D5A861A1-B50A-51D7-837A-B59D1984F0B0","وقَدْ عَلِمَ الحَيُّ مِنْ عامِرٍ","بأنّ لَنَا ذِرْوَةَ الأجْسَمِ"],["BCA90969-0D4A-56A3-A3C2-7753C92A4FAC","وأنّا المَصاليتُ يَوْمَ الوَغَى","إذا ما العَواويرُ لَمْ تُقْدِمِ"]]},"A4542BA9-DA2C-581E-8D70-161ED876946C":{"t":"لَقَدْ تَعْلَمُ الخَيْلُ المُغِيرَةُ أنّنَا","p":40,"s":"لقد تعلم الخيل المغيرة أننا","r":"436591","v":[["3A421DA9-5C9A-5108-8853-AD4C950338B0","لَقَدْ تَعْلَمُ الخَيْلُ المُغِيرَةُ أنّنَا","إذا ابْتَدَرَ النّاسُ الفَعالَ أُسُودُهَا"],["DE4B233E-F569-5DD1-BCF6-EC08386F9688","على رَبِذٍ يَزْدادُ جَوْداً إذا جَرَى","وقد قَلِقَتْ تحتَ السّروجِ لُبودُهَا"],["F55BC4A8-4CE6-5292-A630-99F1F9AA3FE1","وقد خُضِبَتْ بالماءِ حتى كَأنّمَا","تَشَبّهُ كُمْتَ الخَيلِ منهنّ سودُهَا"],["9F161AC1-355F-5583-BD9D-1F8557D82C92","ونَحْنُ نَفَيْنا مَذْحِجاً عن بِلادِها","تُقَتَّلُ حتى عادَ فَلاًّ شَديدُهَا"],["7DE201E4-FCA8-5FF7-A4E1-2F66DF72EFED","فأمّا فَريقٌ بالمَصامَةِ مِنْهُمُ","فَفَرّوا وأُخرَى قد أُبيرَتْ جُدودُهَا"],["5BB3177D-A1CF-5E64-A877-40521BEC1B1C","إذا سَنَةٌ عَزّتْ وطالَ طِوالُهَا","وأقْحَطَ عَنها القَطرُ واصفَرّ عُودُها"],["75AC9C17-1D59-5467-931A-C3F2B2B3D9BF","وُجِدْنا كِراماً لا يُحَوَّلُ ضَيفُنا","إذا جَفّ فَوْقَ المَنزِلاتِ جَليدُهَا"],["2B2014B7-039A-5BCA-8F9F-929211D6B552","وقد أصبَحَتْ عِرْسي الغَداةَ تلومُني","على غَيرِ ذَنْبٍ هَجرُها وصُدودُها"],["824809A8-166A-52A8-931E-93A471A051FE","فإنّي إذا ما قُلتُ قَوْليَ فانْقَضَى","أتَتْني بأُخرَى خُطّةٌ لا أُريدُهَا"],["A424D264-7DFB-5627-8E5C-C4EB94FA18A0","فَلا خَيرَ في ودّ إذا رَثّ حَبْلُهُ","وخَيرُ حِبالِ الوَاصِلينَ جَديدُهَا"]]},"BA5AF23D-8081-5F3D-ACE7-C69182E28204":{"t":"نَحْنُ قُدْنَا الجِيادَ حَتى أبَلْنَا","p":40,"s":"نحن قدنا الجياد حتى أبلنا","r":"436584","v":[["E811847A-FD7E-5AB4-8F29-DE0EB610F02B","نَحْنُ قُدْنَا الجِيادَ حَتى أبَلْنَا","ها بِثَهْلانَ عَنْوَةً فاسْتَقَرّتْ"],["63A65027-62A3-562F-BF62-23E7179274C1","وَزَجَرْتُ المَزْنُوقَ حتى رَمَى بي","وَسْطَ خَيْلٍ مَلْمُومَةٍ فابذعرّتْ"],["ABF56C15-858F-53C1-8966-941D3681F228","وصَبَحْنا عَبْساً ومُرّةَ كأساً","في نَواحي دِيارِهِمْ فاسْبَطَرّتْ"],["40B42222-FB71-5A49-A29C-0AB4F06869B6","وجِياداً لَنا نُعَوّدُها الإقْـ","ـدامَ إنْ غارَةٌ بَدَتْ وازْبَأرّتْ"],["AB510BA5-7F0F-5380-A259-0184400BBF99","مُقْرَباتٍ كالهِيمِ شُعْثَ النّواصِي","قد رَفَعْنا مِنْ حُضْرِها فاستَدَرّتْ"],["1F2035FC-8B83-588D-A0B5-BB0B1FAD88F7","بِشَبابٍ مِنْ عامِرٍ تَضرِبُ البَيْـ","ـضَ إذا الخَيلُ بالمَضيقِ اقشَعَرّتْ"],["4CD35C79-13C5-558B-AE2C-1197E9D24427","بمَضيقٍ تَطيرُ فيهِ العَوالي","حينَ هَرّتْ كُماتُها واستَحَرّتْ"],["97AD47C9-0B26-52CA-88EB-97943961DEBE","يضربونَ الكُماةَ في ثَوْرَةِ النّقْ","ـعِ إذا حَرْبُهُمْ بدَتْ واسجهَرّتْ"],["552AAEB9-EE50-5A38-808D-3B4640788D6C","وأثارَتْ عَجاجَةً بَعْدَ نَقْعٍ","وصَهيلٍ مُسْتَرْعَدٍ فاكْفَهَرّتْ"],["1371CA5E-947D-5E97-9AAD-325D29C8F5A4","بجِيادٍ غَدَتْ بِجَمْعٍ عَزيزٍ","وأصابَتْ عُداتَهَا فَأضَرّتْ"]]},"F7FE40B2-D24F-5BE2-80DD-E8CA35B4DC22":{"t":"هَلاّ سألْتِ إذا اللّقاحُ تَرَوّحَتْ","p":40,"s":"هلا سألت إذا اللقاح تروحت","r":"436602","v":[["6C10D415-FADF-5F3E-90F3-B7C37C92B3E8","هَلاّ سألْتِ إذا اللّقاحُ تَرَوّحَتْ","هَرَجَ الرّئَالِ ولَمْ تَبُلّ صِرارَا"],["D0D1BC4D-E85E-55E9-93F0-6B4ECB16E379","إنّا لَنَعْجَلُ بالعَبيطِ لِضَيْفِنَا","قَبْلَ العِيَالِ ونَطْلُبُ الأوْتَارَا"],["C3431077-DDBE-5E4D-9594-7B06951A5330","ونَعُدّ أيّاماً لَنَا ومَآثِراً","قِدْماً نَبُذّ البَدْوَ والأمْصارَا"],["900FB3FA-EC36-577C-856B-F2F36A4913EF","مِنْهَا خُوَيٌّ والذّهَابُ وبالصّفَا","يَوْمٌ تَمَهّدَ مَجْدُ ذاكَ فَسَارَا"]]},"F5A5BDAE-69AC-5B47-A7EC-99C6C044E109":{"t":"هَلاّ سَألْتِ بِنا وأنْتِ حَفِيَّةٌ","p":40,"s":"هلا سألت بنا وأنت حفية","r":"436590","v":[["40E4DE05-AD16-53B8-95FE-CC236BF38967","هَلاّ سَألْتِ بِنا وأنْتِ حَفِيَّةٌ","بالقَاعِ يَوْمَ تَوَرّعَتْ نَهْدُ"],["80C67E00-BB3B-5CF1-A034-6B4646E53797","والحَيُّ مِنْ كَلْبٍ وجَرْمٌ كُلّها","بالقَاعِ يَوْمَ يَحْثّها الجَلْدُ"],["29091B56-0838-5E37-BB25-8BECDDA5B6BD","بالكَوْرِ يَوْمَ ثوَى الحُصَينُ وقد رَأى","عَبْدُ المَدانِ خُيُولَها تَعْدُو"],["A4795B24-81AF-5C49-98B8-74DC938E8080","بالباسِلِينَ مِنَ الكُماةِ عَلَيْهِمُ","حَلَقُ الحَديدِ يزينُها السّرْدُ"],["7E4FFDC3-5A30-5AB7-AB52-D72A039968F3","أيُّ الفَوارِسِ كانَ أنْهَكَ في الوَغى","للقَوْمِ لَمّا لاحَها الجَهْدُ"],["65DD8A2F-9616-551D-A9AA-06E980426997","لَمّا رَأيتُ رَئيسَهُمْ فتَرَكْتُهُ","جَزَرَ السّباعِ كَأنّهُ لَهْدُ"],["16DB6556-107C-5C16-A3AB-09B1C6BE74C1","وَثَوَى رَبيعَةُ في المَكَرّ مُجَدَّلاً","فَعَلا النّعِيُّ بِمَا جَدَا الجَدُّ"],["C4B33DCE-50B0-57C7-9EF3-6FA4F21ECA35","هَذا مَقامي قَدْ سَألْتِ ومَوْقِفي","وعَنِ المَسيرِ فَسَائِلي بَعْدُ"],["8576F2DC-C0E0-5865-B44A-A9D0951B3105","أسَألْتِ قَوْمي عَنْ زِيادٍ إذْ جَنى","فيهِ السّنانُ وإذْ جَنى عَبْدُ"],["357C1ACC-E15F-53CA-A9C2-886F65215353","والمَرْءَ زَيْداً قد تَرَكْتُ يَقُودُهُ","نَحْوَ الهِضابِ ودونَهَا القَصْدُ"]]},"DB38096C-85AE-5752-A5F5-27032F6E7D8D":{"t":"وأبُو أُبَيٍّ ما مُنِيتُ بِمِثْلِهِ","p":40,"s":"وأبو أبي ما منيت بمثله","r":"436603","v":[["72213342-8881-5FDA-9163-F2BDC2790B26","وأبُو أُبَيٍّ ما مُنِيتُ بِمِثْلِهِ","يا حَبّذا هُوَ مُمْسِياً ونَهَارَا"],["59DF36CE-44F2-586D-B291-DBC2CCF6486D","لَقِيَ الخَميسَ أبُو أُبَيٍّ بارِزاً","ألْوائِليُّ وحَرّمَ الإدْبَارَا"],["36AFEBDE-43FB-51B2-9A36-A48B922DCE7D","يَحْمي إذا جَعَلَتْ سَلُولُ وعامرٌ","يَوْمَ الهِياجِ يُجَبّبُونَ فَزَارَا"]]},"241AFCD1-E9F5-5AF6-BAE7-374B99AEC73C":{"t":"وأنْتَ لِسَوْداءِ المَعاصِمِ جَعْدَةٍ","p":40,"s":"وأنت لسوداء المعاصم جعدة","r":"436609","v":[["DE9B609C-8E96-5592-83D0-A0613F8F0137","وأنْتَ لِسَوْداءِ المَعاصِمِ جَعْدَةٍ","واقعَسَ مِنْ نَسلِ الإماءِ العَوارِكْ"],["7B2CF383-85C4-501D-8C78-BF6C5D66735F","تَبيعٍ لِقَوْمٍ لمْ يَكُنْ مِنْ صَميمِهمْ","ولَكِنّهُ مِنْ نَسْلِ آخَرَ هَالِكْ"],["B0780EE1-C73E-5B6B-B808-9A3D7CEE1C2A","أبُوكَ أبُو سَوْءٍ وخالُكَ مِثْلُهُ","وهَلْ تُشبِهَنْ إلاّ أباكَ وخالَكْ"]]},"F39ED7FB-A4FA-5683-AF23-C7D8ADABB7D5":{"t":"وأهْلَكَني لَكُمْ في كُلّ يَوْمٍ","p":40,"s":"وأهلكني لكم في كل يوم","r":"436627","v":[["58BB5A6F-37C1-5335-8001-8E38CADE5C76","وأهْلَكَني لَكُمْ في كُلّ يَوْمٍ","تَعَوّجُكُمْ عَلَيّ وأسْتَقيمُ"],["B1381CFF-73B6-5216-9080-E35A52E33C45","رِقَابٌ كالمَواجِنِ خَاظِياتٌ","وأسْتَاهٌ على الأكْوارِ كُومُ"]]},"40531B58-A263-5F92-8ACD-064069C87B03":{"t":"وإنّكِ لَوْ رَأيْتِ أُمَيْمَ قَوْمي","p":40,"s":"وإنك لو رأيت أميم قومي","r":"436634","v":[["D5B964E4-1C5B-5D60-9F80-9FD5D7CBB231","وإنّكِ لَوْ رَأيْتِ أُمَيْمَ قَوْمي","غَداة قُراقِرٍ لَنَعِمْتِ عَيْنَا"],["85422F88-0B14-5FD3-AD25-A819A62B0AF1","وهُنّ خَوارِجٌ منْ حَيّ كَعْبٍ","وقَد شُفيَ الحَرارَةُ واشْتَفَيْنَا"],["9F11B4BA-B38E-5034-8798-87E1C762F7B9","وقَد صَبّحْنَ يَوْمَ عُوَيْرِضاتٍ","قُبَيلَ الشّرْقِ باليَمَنِ الحُصَيْنَا"],["CC36383A-6761-5FEC-8CF8-A859DEC6E100","وبالمَرْداتِ قَدْ لاقَيْنَ غُنْماً","وَمِنْ أهْلِ اليَمامَةِ ما بَغَيْنَا"]]},"0F164397-E22A-52C2-AE94-9BDEA62F06D6":{"t":"وبالفَيْفَا مِنَ اليَمَنِ اسْتَثارَتْ وبالفَيْفَا مِنَ اليَمَنِ اسْتَثارَتْ","p":40,"s":"وبالفيفا من اليمن استثارت وبالفيفا من اليمن استثارت","r":"436604","v":[["2CF6BCC8-68BC-5421-B15E-8F0CAD288306","وبالفَيْفَا مِنَ اليَمَنِ اسْتَثارَتْ وبالفَيْفَا مِنَ اليَمَنِ اسْتَثارَتْ","قَبائِلُ كانَ ألّبَهُمْ فَخَارَا"]]},"F9361061-B2EB-5B87-8B12-165CF5E8E1A5":{"t":"وما الأرْضُ إلاّ قَيسُ عَيْلانَ أهلُها","p":40,"s":"وما الأرض إلا قيس عيلان أهلها","r":"436630","v":[["7775D2F9-31B4-52A3-BD86-F19A2F6C96F9","وما الأرْضُ إلاّ قَيسُ عَيْلانَ أهلُها","لهُم ساحَتاها سَهلُها وحُزُومُهَا"],["6BC9AE82-25A9-5CD6-831B-92EB99B13DB4","وقَدْ نالَ آفاقَ السّماواتِ مَجدُنَا","لَنَا الصّحْوُ من آفاقِها وغُيُومُهَا"]]},"E24793B2-018E-5879-9647-B983CB8B0134":{"t":"ونِعْمَ أخُو الصّعلوكِ أمسِ ترَكْتُهُ","p":40,"s":"ونعم أخو الصعلوك أمس تركته","r":"436608","v":[["2233C50B-BE8B-5603-9C47-DFFD1E1C0719","ونِعْمَ أخُو الصّعلوكِ أمسِ ترَكْتُهُ","بتَضرُوعَ يَمري باليَدينِ ويَعسِفُ"]]},"582874C5-B099-5059-8DF4-EAB3DAF2675B":{"t":"وهَلْ داعٍ فيُسمعَ عَبدَ عَمْرٍو","p":40,"s":"وهل داع فيسمع عبد عمرو","r":"436586","v":[["69CB2117-7657-5301-8F91-F50D2517AB1C","وهَلْ داعٍ فيُسمعَ عَبدَ عَمْرٍو","لأخرَى الخَيلِ تَصرَعُها الرّماحُ"],["EC447588-39FF-5AD1-9D19-24707CBC7CDE","فَلا وأبِيكَ لا أنْسَى خَليلي","بِبَدْوَةَ ما تَحَرّكّتِ الرّيَاحُ"],["E904A52E-1BF8-537D-AD05-D1B8147F0060","وكُنتَ صَفيّ نَفسي دونَ قَوْمي","ووُدّي دونَ حامِلَةِ السّلاحِ"]]},"BB7B897F-832B-5348-A459-01D19DA419DE":{"t":"ويَحْمِلُ بَزّي ذو جِراءٍ كأنّهُ","p":40,"s":"ويحمل بزي ذو جراء كأنه","r":"436587","v":[["EB5EE250-220C-5418-8BE4-2ACACC160D73","ويَحْمِلُ بَزّي ذو جِراءٍ كأنّهُ","أحَمُّ الشَّوَى والمُقْلَتَينِ سَبُوحُ"],["60242255-FAB9-53FE-BF73-895815F6D996","فَرُودٌ بِصَحْراءِ اليَفاعِ كأنّهُ","إذا ما مشَى خَلفَ الظّباءِ نَطيحُ"],["2B5C53E8-4D87-522F-A5BA-B89F90220983","فَعايَنَهُ قُنّاصُ أرْضٍ فأرْسَلُوا","ضِراءً بكُلّ الطّارداتِ مُشيحُ"],["C7DA7273-03E8-5CE1-841D-41AAE977A82B","إذا خافَ منهُنّ اللّحاقَ ارْتَمَى بِهِ","عنِ الهوْلِ حَمْشاتُ القَوائمِ رُوحُ"]]},"DBD40EE4-8167-5410-A2E2-C9DB8814E87C":{"t":"وَفَدْنَا فَآوَيْنَا بأشْرافِ دارِمٍ","p":40,"s":"وفدنا فآوينا بأشراف دارم","r":"436621","v":[["C923D894-1A9C-5583-ACB0-58329E386454","وَفَدْنَا فَآوَيْنَا بأشْرافِ دارِمٍ","غداةَ جَزَيْنا الجَوْنبالجَوْن صَيْلَمَا"],["E1317188-1CEA-5AFF-845E-6E04CC357B88","ولمْ يَكْفِنَا قَوْمٌ مَقاماً ولمْ نَعُذْ","بغَيرِ القَنا في خَشْيَةٍ أوْ تَجَرُّمَا"],["270EB570-1A47-5534-84FD-C9C808DC110B","وَلَمْ أرَ قَوْماً يَرْفَعُونَ لِواءَهُمْ","لغايَتِنَا في المَجْدِ مِمّنْ تكَلّمَا"],["C3ED0FA7-6089-5918-98F1-C52379B01B75","مِنَ النّاسِ إلاّ يَعْرِفُونَ عَلَيْهِمِ","لَنَا في جَسيمِ الأمْرِ أن نَتَكَرّمَا"],["56C7E2E2-8650-5B6C-B945-2CBEB6FAED02","ونَحْنُ الأُلى قُدْنا الجِيادَ على الوَجا","كمَا لَوّحَ القَوّاسُ نَبْعاً وسأسَمَا"],["B6931B58-197B-5029-AB24-EF397D0B4933","ونحنُ صَبَحْنا حَيّ أسْماءَ بالقَنا","ونَحْنُ تَرَكْنَا حَيّ مُرّةَ مأتَمَا"],["F91DDE0B-6F4E-511C-9F29-908FB075B811","بَقَرْنا الحَبالى من شَنُوءَةَ بَعْدَمَا","خضبَطنَ بفَيفِ الرّيحِ نَهداً وخثعَمَا"],["BE0BFDEA-0B3B-5436-B536-2469E7CB5A69","مُجَنَّبَةً قد لاحَها الغَزْوُ بَعْدَمَا","تُبارِي مَراخيها الوَشيجَ المُقَوِّمَا"],["9DD7FDA7-ADB3-5D19-940A-259702A4636B","ونَحْنُ صَبَحْنَا حَيّ نَجْرانَ غارَةً","تُبيلُ حَبالاهَا مَخافَتَنَا دَمَا"]]},"76F54A06-88E4-580D-A89F-23C13AC7A463":{"t":"يا رُبّ قِرْنٍ قَدْ تَرَكْتُ مُجَدَّلاً","p":40,"s":"يا رب قرن قد تركت مجدلا","r":"436612","v":[["64825C3E-7BB1-51A1-8555-1FF27B56C569","يا رُبّ قِرْنٍ قَدْ تَرَكْتُ مُجَدَّلاً","ضَخمِ الدّسيعةِ رَأسِ حيٍّ جحفَلِ"],["542CDA22-11AF-5C69-A66A-F0332D7B9AF4","وتَرَكْتُ نِسوَتَهُ لَهُنّ تَفَجّعٌ","يَنْدُبْنَهُ أُصُلاً بِنَوْحٍ مُعْوِلِ"],["ECD0B760-73F1-58D3-85B5-9F63FE2109DC","مِنْ آلِ عَبْسٍ قد شَفَيْتُ حَرارَتي","وغَنِمْتُ كلّ غَنيمَةٍ لمْ تَضْهَلِ"],["E86E9D2E-0375-50A5-B299-F064172D30CE","ونَجَا بعَنْتَرَةَ الأغَرُّ مِنَ الرّدَى","يَهوي على عَجَلٍ هُوِيَّ الأجدَلِ"],["D5CEC95D-1EF7-5216-B339-996D18DB4E2D","وتَرَكْتَ عَبْلَةَ في السّواءِ لفِتْيَةٍ","بَاتُوا على كُتُفِ الخُيولِ الجُوَّلِ"],["7F6E9FEB-E00D-5BCA-9CB0-83AB83E2063D","راحُوا بِهِنْدٍ والوَجيهَةِ عَنْوَةً","يَوْمَ الوِقَاعِ على نَجائِبَ ذُمَّلِ"]]},"439207C7-904D-5980-A07F-31806707DF2A":{"t":"يا لَهَفي على ما ضَلّ سَعْيِي","p":40,"s":"يا لهفي على ما ضل سعيي","r":"436614","v":[["F2D5953F-250C-5803-B52B-540B7CFA002B","يا لَهَفي على ما ضَلّ سَعْيِي","وسَيْرِي في الهَواجِرِ ما أقِيلُ"],["69BC88CF-5AC2-5B24-A891-FDBED41E525B","فَإنّ الحَيّ خَثْعَمَ أحرَزَتْهُمْ","رِماحُهُمُ وتُنذِرُهُمْ سَلولُ"],["A2D828EA-AE71-5C39-8B10-EEE48D921135","بمَخْرَجِنا فلا نَخْفَى عَلَيهِمْ","ويأتِيهِمْ بعَوْرَتِنا الدّليلُ"],["32E18541-7E4E-5AC4-9338-9908F1725E54","ولَوْ أنّي أُطِعْتُ لَكانَ مِنّي","لِمُدْرِكِ أكْلُبٍ يَوْمٌ طَوِيلُ"],["85C3311C-40E6-52A0-BD43-B9E6BB4F0C2C","ولَكِنّي عُصِيتُ وكانَ جَهْلاً","بهِمْ ألاّ يُبالُوا ما أقُولُ"],["9819F423-C72C-5749-ABE6-B41039A7E79D","يَلُومُنيَ الّذينَ تَرَكْتُ خَلْفي","ويَعْصِيني الّذين بهِمْ أَصُولُ"]]}}}