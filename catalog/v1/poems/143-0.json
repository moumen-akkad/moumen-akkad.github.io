{"v":1,"poems":{"75182A1D-D91B-5214-8AB6-8ED3276426D6":{"t":"أتذيلُ دَمعك كُلُّه إن بانوا","p":143,"s":"أتذيل دمعك كله إن بانوا","r":"476646","v":[["04C09C32-0349-5D40-B2B4-FE2B4B244515","أتذيلُ دَمعك كُلُّه إن بانوا","صُن بعضَهُ فوراك الأوطانُ"],["0FF8F1E4-0E73-5167-BEBD-DF8EB2F064CD","حَقّ الديار كحقِّ من عاشرتَهُم","فيها كذا حكَمت به الفتيانُ"],["3B3706F7-6D60-53E9-B6B5-33237CC58F38","سَلني أقفك على الهوى وشروطهِ","لا عار أن يستسقي الظمآنُ"],["69AB21E5-09F8-5831-A3E5-3B5BDF67F7A1","أُبدي السُلوَّ عو الأحبَّة إن نأوا","عمداً وأنأى منهمُ السلوانُ"],["D1115199-4729-5E5C-950B-390B91490770","غالطتُ عاذلتي بذاك ولم يزَل","لي في مُغالطةِ العواذل شانُ"],["A08D7926-F828-587B-8C67-7077C96DF8AF","ومن البليَّةِ انّ كتمانَ الهوى","دأبي وإن اودي بيَ الكتمانُ"],["4EC9F7E4-11F6-5D1C-A62C-86EC1648FEAC","ومَلولةٍ ألِفَت فنافعُ بذلها","شرٌ وضائرُ مَنعِها إعلانُ"],["3544DACF-A154-5549-B5D5-71C7D765AE07","وقف الجنون على جنان مُحبّها","انّ المجانةَ عندها مجَّانُ"],["7D097C57-FBA2-5D3C-81BD-AAEF148E348C","غازلتُها سَحَراً وقلتُ لها اسحري","قد طالما سَحَرَتني الغزلانُ"],["6E191797-5394-55B6-BB04-E2332A4FC539","عِينُ الصَّريم عُيونُهنَّ صوارمٌ","مسلولةٌ أجفانها الأجفانُ"],["24FEA918-2FD4-5B6C-96F5-59FD41302508","فَخُذي الى ديوان عطفِك وقّعي","يُكتَب لنا من مُقلتيك أمانُ"],["CB873029-E914-57DE-96D1-C866D9FECA9A","أمن الحبيب تعلُّلٌ وتعزّزٌ","ومن الرقيب تهدُّدٌ وهوانُ"],["8A919809-09BE-5EDB-A24D-ADD03D42C28E","فتبسَّمَت واستعجلَتها عَبرةٌ","واضاء دُرٌّ واستهلَّ جُمانُ"],["9567EB22-BA52-5DFB-9A70-83C642F57AE0","وقفَت تعضُّ على الوشاة بَنانَها","فاخُطُّ خدّي والدموعُ بَنانُ"],["3805205D-4C17-5A2E-9A5B-5D3AAFB36B24","تشكو الصَّبابةَ بامتداد تَنَفُّسٍ","تشكو غوائل حرِّه النيرانُ"],["D6B6D3AB-9C34-5A1A-A06A-745959FAD176","حَرٌّ لو انَّ المشركين بلوا به","فيما مضى لم تعبدِ الأوثانُ"],["64788476-203F-5C89-B4EC-5C29F9D65B26","فكم التصبّرُ والوداع حقيقة","وكم التجلّدُ والفراق عيانُ"],["783D5423-80FE-51E7-8608-91D8C91CC22E","وكم امتعاضُ الكاشحينَ من النَّوى","كانوا هُمُ سَبَبُ النوى لا كانوا"],["49E85E79-F0CC-571C-BB3D-EACEBEB57B7F","وأعِزَّةٍ قد كنتُ دِنتُ بحبّهم","ولذاك سائرهم بحبّي دانوا"],["72B9AEE3-A6DE-5E63-A3BD-308FDFA360CC","كنتُ المُفَدَّى بينهم ولديهم","بحياةِ رأسي كانت الإيمان"],["00AC9532-FED9-5F01-BF31-969B345F33F6","فَسَعى الأعادي بالنمائم بيننا","حتى تنافرنا فبنتُ وبانوا"],["49608F90-7DE3-5BFF-8C03-9AF4576D7EF7","نَأَت المسافةُ والتذكّر حظّهُم","منّي وحظي منهُمُ النسيانُ"],["D8F72EBD-77DC-58B3-8805-39CBDCA85561","دعوى الاخاء على الرجاء كثيرةً","بل في الشدائد تعرف الأخوانُ"],["253A5309-CF57-5567-A03E-E4BCDC916321","الدمعُ وافٍ إن وفوا أو أخلَفوا","والشوقُ راعٍ إن رَعَوا أو خانُوا"],["881DD6F3-E619-5DDC-B7DC-0E7BF8E95929","مالي على الأيّام إن بخلوا يدٌ","وعلى الزمان اذا نبوا سُلطان"],["2B36B7B8-2052-5A22-B412-61DD00D63618","كالموج اثر الموج ليس بفاترٍ","فقدانُ إلفٍ اثرَهُ فقدانُ"],["9EDBB91C-4DD5-5727-A91E-D79E075606EE","ولقد فرى حالي بمخلب ضيمه","ليثٌ خلى عن مثله خفَّانُ"],["D6692DE2-9FA8-5A98-84D8-3D72E22706E2","يُبدي الشجاعةَ في اقتناص ذوي النُّهى","وعن اقتناص المقترين جَبانُ"],["56CD1CB6-BA20-50AC-AC5F-8DF2C5907FC2","نَزع الغني عنّي ليصدأ شيمتي","عَجَباً له هل يصدأ العِقيانُ"],["148CC9AA-0416-5128-A944-8D6F5275480E","وأهانني والمسكُ طيبُ نسيمِه","يزداد تحت السحق حين يُهان"],["80D0926E-F683-59A4-8C61-69605BC1A7E4","لمّا حُرِمتُ به الثَّراَء حَرَمتُهُ","منّي الثناَء فَعَمَّنا الحرمانُ"],["719F7A4F-A836-51CB-B399-E60035F86FD3","أربِح بصفقة تاجرٍ يبتاعني","ولمن سعى في بَيعي الخسرانُ"],["CA128FAA-63A2-5EC4-AF32-5FA3998619B9","مثلي يُضَنُّ به ويحمل جاهُه","طوعاً على حَدَقِ العُلى ويُصان"],["A9B03E27-E958-5BD6-8904-C9F659DC3165","وأنا الذي أضنَتهُ هِمَّةُ نَفسِه","لا الهَمُّ أضناهُ ولا الاحزانُ"],["1339991B-D116-54E3-B4FA-50A8F54E4159","عطل المروَّةِ خَانَهُ إمكانُه","إنَّ المروَّة حَليُها الامكانُ"],["0D7CD7B8-9BFC-5F70-B7CA-6091335431EB","واذا أَحَبَّتني العراقُ فَهَيِّنٌ","عندي إِذا نشزَت عليَّ عمانُ"],["2F1E8C1B-5FE9-553D-AD45-0718F0B244E2","سَيُعيدُ أيامي كأيّام الصِّبا","حُرٌّ أعَزُّ من الملوك هجانُ"],["66473C67-6E7B-5E8C-AE86-74AE30B29E33","قمراً يُسامرُ فكره تحت الأجى","في المكرمات هجانُ"],["C2675563-E364-545D-926A-CB96508DEF6D","وينام حين ينام غِبَّ سُهادِه","والمجدُ بين ظلوعه يقضان"],["EFC06FEA-9048-539A-8C0E-24FAC575D7D3","أرضى ملوك بني بُوَيه بِنُصحِه","والنجحُ جسمٌ روحُه الايمان"],["C8454149-2553-59C7-A08C-5D15ED329F6C","ولو انّ أمر الملك نيطَ بغيره","أبت الاسرَّةُ والتِّيجانُ"],["CCED233C-9F01-5B71-ABD4-8B41EC11A977","بَشَّرتَ آمالي ببشرك انَّه","لكتاب ادراك الغنى عنوانُ"],["FD0B5813-B541-5847-8BDF-AE2E893AD090","أيّامُ فخر الملك أكثر بهجةً","من أن يقومَ بوصفهنَّ لسانُ"]]},"3F55607D-50F1-5EF6-9458-D271465EEFF1":{"t":"أراك على العِلاّت غيرَ موفّقٍ","p":143,"s":"أراك على العلات غير موفق","r":"476669","v":[["93791805-3878-5A23-9B48-FCA56B09B339","أراك على العِلاّت غيرَ موفّقٍ","وما أحسنَ التوفيق حيث تكونُ"],["0532E358-8AFF-51CE-ABB2-F52B023CB348","تريدُ تلافي الأمر من بعد فوتهِ","ولو شئتَ كان الصعب منه يهون"],["9363E195-71E1-5E3B-BFC6-20AADEEEC4B1","كبلهاء قومٍ حين بلّت طحينها","بدت تنخل المبلول وهو عجين"]]},"845EBB29-2052-55AB-A972-7674BC969EBE":{"t":"أفدي الذي زارني والليلُ معتكرٌ","p":143,"s":"أفدي الذي زارني والليل معتكر","r":"476661","v":[["27F0DB15-E73D-535B-BDA6-1DC285FC3A53","أفدي الذي زارني والليلُ معتكرٌ","والأفقُ ممّا اكتسى من عُرفِه عَطِرُ"],["C9679B02-51D3-52D4-B60C-A602DCB20986","فلم نَزَل نتجارى في العتاب معاً","أشكو اليه جفاهُ وهو يعتذرُ"],["25D0DD66-7136-5593-98BE-842FAE163336","حتى إذا ما اعتنقنا واستتبَّ لنا","على ارادتنا عيشٌ له خَطَرُ"],["75810C9D-9F56-5EBE-8EFA-8DC3E0639754","ناديتُ ياليل دُم ليلاً بلا سَحَرٍ","فقال ليلك هذا كلَّه سَحَرُ"]]},"16D0EFB7-437E-5222-8ED3-9841221DE1EE":{"t":"أفي الركب قَلبي أم ترى سَبَقَ الرَّكبا","p":143,"s":"أفي الركب قلبي أم ترى سبق الركبا","r":"476648","v":[["4A5A2A04-C2FE-52C6-84D8-5886BCE4B7EF","أفي الركب قَلبي أم ترى سَبَقَ الرَّكبا","فلست أرى ما بين أحشائي القلبا"],["A7329F70-7579-58BA-A5EE-5ECCE7704334","هوى إثر من يهوى فأودى وإنّما","لسائر أعضائي على إثره العُقبى"],["8E73074D-6E4D-50E3-B209-7822BFAA217D","وقالوا ادعيتَ الحقَّ غير مُسَهَّدٍ","ولا يستلذُّ النوم من عالج الحُبّا"],["9380F75A-2581-585E-B2BE-20143A2CAC6E","فقلتُ لهم لو كنتُ اعلم انّني","على يقظتي أو في الكرى لم أكن صَبّا"],["0E33E35D-7618-53C5-8609-27FF1D6BA802","يذكّرني عهدَ الصِّبا ونسيمَهُ","نسيمُ الصَّبا من نحو نجدٍ إذا هَبّا"],["CEB340F2-E157-5EEB-9DE9-8CDA451FA035","وماضي شباب ينثُر الدمع كُلّما","تصوَّرتُه في النفس أو ينظم الكربا"]]},"5E076F39-7CC0-5D1D-BA8E-8C0F89E2BD7B":{"t":"أنتِ يا نرجسة الروض","p":143,"s":"أنت يا نرجسة الروض","r":"476657","v":[["335F90AC-3892-5D00-B0F8-EB46EC44F984","أنتِ يا نرجسة الروض","لما في الروض سِتُّ"],["E9C7938D-40C8-5A5E-8A58-6C856FBE1F0D","ودليل القول فيه","انّ اوراقك سِتُّ"]]},"2191A6AA-928B-5B9A-B121-2BEB8E942455":{"t":"أيّها العاذلُ مهلاً","p":143,"s":"أيها العاذل مهلا","r":"476672","v":[["3C29E471-52FB-5A47-AEB0-A2ED9707B5DE","أيّها العاذلُ مهلاً","ليس هذا العذلُ شيّا"],["BFAF399A-E114-534F-AE80-EF1744721B48","لا تُكَلِّفني سُلُوَاً","إنّ ذا لا يَتَهيّا"]]},"7185A70C-6D70-5762-B669-FF2F42871A9F":{"t":"إذا الجدّ لم يُسعد فجدّ الفتى لعب","p":143,"s":"إذا الجد لم يسعد فجد الفتى لعب","r":"476656","v":[["901C6599-3791-56B0-9D63-6923C4E490FA","إذا الجدّ لم يُسعد فجدّ الفتى لعب","وابطل سَعيٍ سَعيُ من جدّ في طَلَب"],["47647FE9-A6A8-50B3-B2C3-86FCAD2B3841","فكم ضيعةٍ ضاعت وكم خلّةٍ خَلَت","وكم فضّة فضّت وكم ذهبٍ ذَهَب"]]},"81D35B3F-9765-50C9-90C7-8945013B1E3D":{"t":"إلى ملكٍ يجلو بثاقب رأيهِ","p":143,"s":"إلى ملك يجلو بثاقب رأيه","r":"476671","v":[["863DB1E9-C269-5A9E-B1AA-CA16D09D58CB","إلى ملكٍ يجلو بثاقب رأيهِ","صدا الخطب والصادي برؤيته يروى"],["0F8ABCCD-1569-53C2-AA0C-0E7F61F7BA81","فكم من أخى فقرٍ نفى باسمه الطوى","وكم مَهمَهٍ قَفرٍ إلى بابه يُطوى"]]},"7C01969D-08BF-5F62-90D3-C62C12A2734D":{"t":"الزَم جفاءك لي ولو فيه الضَّنا","p":143,"s":"الزم جفاءك لي ولو فيه الضنا","r":"476641","v":[["6E91BA3A-CCA6-5A62-9FE4-DACA6EEB8A3D","الزَم جفاءك لي ولو فيه الضَّنا","وارفع حديثَ البين عَمّا بيننا"],["47C757EF-55AA-563E-BBD5-99786A63503A","فسمومُ هجرِكَ في هواجرِه والأذى","ونسيمُ وَصلِكَ في أصائِله المُنى"],["C217BE59-DF16-5ECC-BD6E-1FE74E7C75AD","ليسَ التلوُن من امارات الرضا","لكن إذا مَلَّ الحبيبُ تَلَوَّنا"],["A0D5242D-A6B9-54AE-966A-DDEEB4417749","تُبدي الاسادة في التيقُّظِ عامداً","وأراك تُحسِنُ في الكرى أن تُحسِنا"],["CB9A5E75-09AF-5AB9-B537-C42EF93B6144","ما لي إذا استعطفتُ رأيك رمتَ لي","عيباً جديداً من هناك ومن هنا"],["41B080F2-B411-5DCD-B962-48AEC875B1D5","مُثنِ عليك وما استفاد رغيبةً","عجبٌ ومعتذرٌ اليك وماجنا"],["860F4C64-91EC-5EAA-80E1-7F36B913DA52","ما جرَّ هذا الخطب غير تَغَرُّبي","ومن التغرُّب ما أذلّ وأهونا"],["E85F2564-7C4D-5843-9A39-780B78CDA860","أزكى بقاع الأرض وهي فسيحةٌ","ما كان سِربُ العيش فيها آمنا"],["C0D07381-12D8-5DAF-A0E7-397DF22603BF","والرزقُ أنواعٌ فما صادفتَهُ","أخَلى من التبعات أحلَى مُجتَنى"],["380513A0-22B4-594F-A6E8-7E8A7D9A714A","والدهرُ لا يفشي غوامضَ سِرِّهِ","إِلاّ الى ذي الفقر من بعد الغنى"],["91725336-4A0B-5AFA-B2C5-1029D2A857E2","أدمِن مُصاحبةَ الرجال فلم يخب","سعي امرىءٍ صحب الرجال فأِّدمَنا"],["1642BF2A-158C-5A2C-9E6C-354B607253E6","لا تغرّر بالمانعين قلوبَهم","إن سالموا والمانحين الألسنا"],["2A3FF0A5-2810-5CF3-9299-FBE8866F0EEB","الحرُّ أدنى ما يكون اذا نأى","والوغد أنأى ما يكون أذا دنا"],["7BB7F61B-8AF4-5E6E-A16D-F6F48A07E75B","وإذا الأماني لم تنلها مُعرِقاً","فاثن العنان وسر تَنَلها مُعمِنا"],["4B020380-7C8B-5097-8135-BD86E73E5A53","أوصالَ سلطانُ الحوادث فارمِهِ","بمؤيد السلطان حتى يذعنا"],["ACC1829D-4492-52DC-890D-35DD6576D5DB","مَلِكٌ مُنى فلك السماء لو انّهن","بجلاله بدل الكواكب زُيِّنا"],["87A4177B-4913-5BD3-B598-A0C3FCBC4194","ألِفَ العُلوَّ فكاد يأبى حُلّةً","إِلا السناء وحِلّة الاّ السَّنا"],["ECC5C023-53E9-534D-A09D-0FDF11D33981","سائلتُ بعد اللائذين بظلِّه","عَنهُ فقال لي المقال البيِّنا"],["966F4929-20D4-5BB4-B5B7-92F91D796EF5","كم ترسلون اعنَّة الهجرانِ","فقدُ الحياة وَفقدكُم سيّانِ"],["94F7150F-02FE-5D4B-A720-11BFCD95467C","فصلوا جناحي بالوصال فَمُنكَرٌ","إِخلالُ أهلِ الفضلِ بالخلاّن"],["7A7C31E7-CDD4-54CA-83E2-A641497F235C","انّي أغارُ عليكم أن تسلكوا","في الودِّ غيرَ طرائق الفتيانِ"],["58961DA0-7525-5DBD-8AE5-750075802BD6","وأخافُ مُرَّ عِتابكم ما لم أَخَف","تحت العجاج عواليَ المُرَّانِ"],["37D96091-FA08-5D8C-A497-BFC45E30C138","لم أجن فاستعطفتكم لكنَّ بي","شوقاً الى استعطافكم الجاني"],["0279B33B-7B8E-5E11-94AF-6EC3DEE3D193","وهبوني الجاني ألَستُ شقيقكم","هلاّ غفرتم للشقيق الجاني"],["3EAD51B7-0659-5251-A23D-4636381E5CA4","غَطُّوا بأذيال التجاوز منكم","صفحات جانٍ للندامة جاني"],["96DB6B0D-3A06-55C5-84E2-4041163B7D5C","ولربّما كرهَ العقوبةَ حازمٌ","كيما يفوز بلذَّةِ الغُفران"],["1E5E8375-CB8B-5550-9A80-FD17A67F2CF9","ما كان أيمن طائري بلقاكُم","ايام عودي أنضر العيدان"],["903892A0-4F6F-5E30-9093-E5C44629F007","لولا الفراق لما فرقت ولو هوى","نجم الهوى أمن الجنون جناني"],["24405F98-B57D-5D34-949A-8AF87B61C999","ببعادكم أبغضت دار كرامتي","وبقربكم أحببتُ دارَ هواني"],["7D8BDD63-01F4-5CE3-B387-BD6DD1813F84","فاستأنفوا بتعهدي احسانكم","انَّ التعهُّدَ صيقلُ الاحسانِ"],["2E6E1B17-3F60-5969-8AB4-622E99145803","وتبيّنوا انّي بليتُ بمعشرٍ","طلبُ التملّس منهم ايلاني كذا"],["D4432CEB-EB7F-5CA8-B0B2-3782133D5FA4","حتى أعود من المسرَّة ناسياً","أن كنت يوماً من بني الأحزان"],["9C85DEF8-19B8-538C-9AAC-545C4FC8721C","ويعود بعد اليأس فكري طامعاً","في كُلِّ بكرٍ للمنى وعَوانِ"],["13987AF1-0800-5019-ACAB-E4936840BA75","ويشوقني بعد السلوّ عن الصّبا","حَدَقُ المها وسوالفُ الغزلان"],["00B8F9E0-049E-548A-BF29-4E41E46C38DB","للهِ درُّ المكرميّين الأُلى","خَرَّ الكرامُ لهم على الأذقانِ"],["74D277B7-88B6-5E7D-BF67-E91DFCEF3A2D","الناصحين الملك علماً منهمُ","ان النصيحة حليةُ الإيمان"],["F20C09FB-6D88-5221-A4F1-BBF81CCF0F42","والسالكين بحُبِّ آل محّمدٍ","سُبُلَ الهدى في السرِّ والاعلان"],["4BF278C1-1DC6-57AD-AC15-BB8BCD7C7684","فمديحهم سَبَبٌ إلى نيل العُلا","وولائهم من الحدثانِ"]]},"A3530006-5776-50FD-B890-F867810871D1":{"t":"بأبي حبيبٌ كلّما عانقته","p":143,"s":"بأبي حبيب كلما عانقته","r":"476666","v":[["69ADA79D-2595-50FE-9B87-C5C20D46540B","بأبي حبيبٌ كلّما عانقته","عادت اليّ شبيبتي بعناقهِ"],["4B244683-86BD-50FD-9BD7-B83E94ED65C0","كالراح يجمع بين طيب نسيمه","وبهاء منظره وطيب مذاقه"],["6400314A-7412-59AD-9003-93A104C5420D","أخلاقه نُزهُ القلوب وبالحَرِي","أن يستعير الروض من اخلاقه"],["5A2F7263-2D74-5E4C-99D8-581E02E3009F","أيقنتُ أن لا عيش غيرُ لقائه","أبداً وأن لا موتَ غيرُ فراقه"]]},"1E3A42E8-08EE-570C-914C-7AA7528B9325":{"t":"تأبى قبولي أيُّ أرضٍ زرتها","p":143,"s":"تأبى قبولي أي أرض زرتها","r":"476665","v":[["7EF1239E-E4D5-5470-B932-DCD8A234555D","تأبى قبولي أيُّ أرضٍ زرتها","قدمي رجائي وافتقاري سائقي"],["23F1DDD9-1916-5E6D-9023-D6180E9156BD","فكأنّما الدنيا يدا متحرِّزٍ","وكانني فيها وديعةُ سارق"]]},"CF471F47-E2AF-564D-B1BA-DE858E9FA56B":{"t":"جاء الربيعُ وبحرك الفيّاضُ","p":143,"s":"جاء الربيع وبحرك الفياض","r":"476664","v":[["E457CBE3-99D0-5EC7-9528-52A104E3561D","جاء الربيعُ وبحرك الفيّاضُ","فَغَدَت فقارُ الأرضِ وهي رياضُ"],["0142099A-717E-50AF-8D99-E41FD9EBFDDC","والروضُ أصبحَ بعد صفرةِ لونهِ","وبوجنتيه حمرةٌن وبياضُ"],["5FE3E0B3-505F-5A9D-957D-B34E9EEC459D","وكأنَّ نوارَ الحدائقِ في الضُّحى","حَدَقٌ لدى عُشّاقهنَّ مراض"],["7E6F7435-19C9-5829-8AA9-C0CC476EC42B","فانظر ترى الدنيا عروسَ منصَّةٍ","يصيبك بُردُ شبابها الفضفاضُ"],["00DFDEEF-FCBC-5865-AD34-AA3077EA43AD","والمزعجاتُ جفونهنّ غضيضةٌ","والمبهجاتُ غصونهنّ غضاض"],["7998C042-97AC-5D81-B5C0-F222D99E93C6","بنداك يصبغ ثوب شرَّته الغنى","أبداً ويصبغ صبغه الايقاض"]]},"C3977678-B4D7-51E1-A2FC-DFD9B6417358":{"t":"رقَّ خلق الزمان واعتدل الجوّ","p":143,"s":"رق خلق الزمان واعتدل الجو","r":"476653","v":[["605A2E5C-0236-5011-9C9A-42C8605D97EB","رقَّ خلق الزمان واعتدل الجوّ","اعتدالاً وخفَّ وزنُ الماءِ"],["D4AD2D8E-C0C2-5F15-8FCB-E19AA8B8954D","وترى الأرض بعدما هرمت عادت","الى سنِّ كاعبٍ حسناءِ"],["B89E5595-E2AC-5D04-AA18-11432644B4A6","فتحارُ العيونُ في كلّ روضِ","نَسَجَت وَشيَهُ يدُ الانواءِ"]]},"FDF4CEE6-26C8-5BDB-B752-2A4A2FE2564F":{"t":"سَكَنٌ ساكنٌ سوادَ الفؤادِ","p":143,"s":"سكن ساكن سواد الفؤاد","r":"476659","v":[["A492BF1D-430F-5341-8EAA-4598CDE4944F","سَكَنٌ ساكنٌ سوادَ الفؤادِ","ملَّ قُربي ومال نحو بعادي"],["BED131CC-F546-53C0-9DE6-09F8CFAFCD5A","قال لِمْ لا تنام قلت لإِعْرا","ضك وهو الخلافُ للمعتادِ"],["B98B1D37-F657-5F1B-AEB6-4610CF4BF707","إنّما اشتهي الكرى لأَرى","طيفَكَ فيه وأنت سَهلُ القيادِ"],["51EADFE4-197D-53E1-B5FC-5A45082137DE","فإذا لم يَزُر خيالك إلاّ","مُغضَباً فالكرى فداء السُّهادِ"]]},"66172E86-9B6F-5EDC-ADF7-9501044E9681":{"t":"على منبر العلياء جَدُّكَ يخطبُ","p":143,"s":"على منبر العلياء جدك يخطب","r":"476655","v":[["A54053A9-494E-57A6-9152-C5B5B5C0F132","على منبر العلياء جَدُّكَ يخطبُ","وللبلدة العذراء سَيفُك يخطبُ"]]},"88BB5D1E-A6AD-502D-ABA3-1025AAC2A89E":{"t":"عَسى وعَسى من بعد طولِ التفرُّقِ","p":143,"s":"عسى وعسى من بعد طول التفرق","r":"476649","v":[["D6C24A1D-D7BF-5A17-A14D-AEF640EE7572","عَسى وعَسى من بعد طولِ التفرُّقِ","على كُلّ ما نرجوا من العَيش نَلتَقي"],["B8EF2171-D4EB-5562-A868-173932F7A517","ولو ظَفِرت عيني بشخصِكَ ساعة","لكنتُ على عيني من العين أتَّقي"],["CAF4EFB9-F36D-5058-9116-C1517C0A0F29","فيا ليتَ شعري كيف انت أَشَيِّقٌ","فؤادك كالمعهود أم غير شَيِّقَ"],["4D917CC0-D267-5254-86F1-3E9121E8ED7D","فما روضُ عهدي في ضميري بمجدوبٍ","ولا رَبعُ وُدِّي في فؤادي بمخلقِ"],["D92D574D-7A50-59BD-BA2D-BF91A0DD4D31","فيا حبّذا عصر الصِّبا","عذارى أمانينا وناهيهِ لو بَقي"],["47172F8D-887E-5F50-A5EB-E271775C1434","زمانٌ نَظَمنا عقد كُلّ تَيَسُّرِ","به وحَلَلنا عَقدَ كل تَعَوُّقِ"]]},"C4714EDC-7477-51D0-BD26-10DBDBC2C9A1":{"t":"عَصرُ الصِّبا عُد فالهوى","p":143,"s":"عصر الصبا عد فالهوى","r":"476650","v":[["94CE06D6-08C3-58E7-AD5C-5433CC6D70B0","عَصرُ الصِّبا عُد فالهوى","باقٍ وركبُ الشوقُ طارق"],["DA19C82D-A9EF-565E-8A69-9D4E14651D5B","ما كنتَ الاّ رَجعَ طَرفٍ","لا بثاً أو لَمحَ بارِق"],["B035E5EF-34ED-5DBA-A887-35E50309D331","سَوَّدتَ من عَجَلٍ أما","نينا وَبيَّضتَ المفارق"],["B074FF03-E412-5E80-B751-115221BBD883","ومضَيتَ باللذّاتِ مُر","تجلاً وخَلَّفتَ العوائق"],["0E04CC4F-BAD9-5A29-AAE5-962F150D910E","ما هكذا كُنّا نظنّ","وأيُّ ظنٍ فيك صادق"],["304BCC10-4A0B-5D1C-975B-C2922973DE8A","فارقتُ أربَعةً لها","يهوى المنيَّة من يُفارق"],["C2D4E784-2229-52DE-9C6D-962892D4CAFC","شرخَ الشبيبة والغنى","وعُمانَ والإلفَ الموافق"],["0939C32C-8C5F-596C-A9C7-50412BAE98E6","هذا على انّي قديماً","كنتُ مفتاح المغالق"],["D5F0EE56-01CE-5B47-A4CA-F11CD05128D9","وبلغتُ غاياتِ العُلى","سبقاً وصلتُ على البوائق"],["3EBA7AB5-D301-5EDA-90D2-5E1BA7FE9A59","زَمَنٌ خلا وعيون حُسّادي","الى نِعَمي روامق"],["D68568FA-866E-5CD6-949D-F06A86C6E6EE","أيّام رَيبُ الدهر عنِّي","ساكتٌ والعيشُ ناطق"],["1FE79027-2F41-5B04-AECD-878AA32E0C63","يا سادةً نكثوا العهودَ","على النَّوى ونسوا المواثق"],["A17C3BD2-6B02-5916-8B0D-45E70321B874","الحزنُ معتقلٌ لديّ","ببُعدكم والصَّبرُ آبق"],["BC2E4A9C-1605-51BD-B000-DF4441938C1C","أَنا من بَلَوتُم فِعلَهُ","وخلائقي تلك الخلائق"],["78F1E450-8036-53C4-B314-815EAE090508","فكما علمتم في معا","تبة الأَحِبَّة لا أُضايق"],["42CC0F32-2C2A-5BA4-9C01-761564460829","حاشاكُمُ أن تذنبوا","الذنبُ للزمن المنافق"],["BFE0B88C-E30D-5D8B-9AFE-DF7C71E02EC2","ما الغَدرنُ من أخلاقكم","لكن قضاء الله سابق"]]},"92692668-1DF7-5A10-83E6-61ACE398DD79":{"t":"فرِق الفراقُ لطولِ ما نَتَلاقى","p":143,"s":"فرق الفراق لطول ما نتلاقى","r":"476651","v":[["61CC2517-2D61-51B5-8ABE-DFDF74D273D6","فرِق الفراقُ لطولِ ما نَتَلاقى","من أن أصُبَّ على الفراق فراقا"],["034CF7D0-66E8-5614-94C8-4BD9520C6EDB","فعلام تحسبُني الوشاة مُنَزَّها","في الشوق عما يتلفُ المشتاقا"],["08E05968-81CF-5834-B422-5B44483E6C2E","أوَ ما يرونَ الجفَنَ خاطب لوعةٍ","بكرٍ وقد بذل الدموع صداقا"],["01518D5F-4C28-5DED-8806-F88A1129B65A","يا عين إن لم يكفهم أن تسكبي","دمعاً فذوبي واسكبي الآماقا"],["5D462698-144A-5506-B45A-66EFC4EE3173","تَرَك اصفراري والنحولُ كلاهما","في العشق جسمي يُنذِرُ العَشَّاقا"],["AE907A0E-6682-5341-BDC7-8A6308F957CB","فكأنَّهُ أَلِفٌ بِخَطٍ مُذهَبٍ","جَعَلَ الدُّجى أرقي له ورّاقا"],["52105E9D-B732-59FF-8E9B-4F84E27D96ED","لام الحسودُ وقالَ دَع عنكَ الهوى","ليزيدني بملامِه أشواقا"],["87A0EB92-750F-5C38-B30C-121C7ED9D0AD","وعزيزةٍ قالت مقال مُجَرّبٍ","ساوى الحكيمَ بفَهمِه أو فاقا"],["1B91CEA6-C2DB-5AF7-9362-EA44019B7850","كم مُضمرٍ كيداً إِذا جالَستَهُ","أبدى الخُنُوَّ وأظهر الإشفاقا"],["B0A14604-87D8-5E12-B737-7438F0135F1D","والنار نورٌ ملء عينيك ساطعٌ","لو لم تجد في طبعها الاحراقا"],["91142F02-1B8B-5ADB-ABED-5D1210BC6DDA","ومن الضَّلالةِ أن تُعاشِرَ مَعشراً","ساقوا الى سُوقِ النِّفاقِ نفاقا"],["6DA15F66-EC05-5132-9398-1C2BEC5E437E","تَسعَى ولو اعطيتَ سَعيَكَ حقَّهُ","لبلَغتَ ما أمَّلتَهُ استحقاقا"],["883BE802-6699-5212-B7F5-50B2E1FA1274","فمؤيَّدُ السلطان زُر ودع الورى","وعمانَ يَمِّم واهجُرِ الآفاقا"],["73DD3AED-F9E5-5AC4-906F-8CF143B6AF0A","فيه يروقك وجهُ جاهِك منظراً","وبها تطيبُ لك الحياةُ مَذاقا"],["3DC7BCEE-27B3-51A3-BD30-95D1B3E406C8","عاود بلادك واقصد الملك الذي","يكسو دُجى آمالك الاشراقا"],["8EFAA555-677F-5FBD-9B51-7C87034CD010","مَلِكٌ اذا لسعَتك يوماً نكبةٌ","صادفتَ من إنعامِه دِرياقا"],["7C0215B4-2D64-5C7E-AC7D-DA1EA2C981A4","يستعذبُ الاطلاق حتى انَّه","ليرى غذاَء سماحِهِ الاطلاقا"],["F9925031-E614-5110-A2D9-760F4D7C1EA9","لو سرتَ فُزتَ من اليسار بطائلٍ","تسرو به عن قومك الاملاقا"],["29A63F46-B707-5161-9FC6-FA0F986B6689","هذا وقلتُ لعاذلٍ لك عندما","تهبُ الهباتِ فتكثر الانفاقا"],["F40FE748-E183-55D6-9E50-B4EA4A7B1E34","يا مَن يلوم على السَّماح رفيقه","رفقا فلم أَرَ كالغنى إرفاقا"],["782C1D6E-8752-5565-A3AE-260D04853337","فلئن رآك اطوعَ خادمٍ","إن حَلَّ راق وإن ترحَّلَ شاقا"],["92EDC09B-DEB5-587C-A38D-CEB7180A1294","لو حُمِّلَ الأمرَ الجسيمَ وفَا بهِ","أو حُمِّلَ العبَء الثقيلَ أطاقا"],["088FF1E8-9368-5CB2-AE49-0A258FD6EB1B","في السِّلم يخدم باللسان وفي الوغى","بالسيف ليس بهائبٍ ما لاقى"],["6DB79599-8ED6-5F2F-A8BE-E94DDAE9652F","فعلمتُ انّي إن اخذتُ برأيها","لم أعدُ في ترك الخلاف وفاقا"],["F6F4EF24-E6E0-54C3-AB23-B62D7E65112A","ووجدتُ من قبل الرَّحيل جوارحي","يُرهِقنَ عزمي في السُّرى ارهاقا"],["99DB9CD9-44DB-524C-AFF2-34B658484279","حُبّاً لطلعة ذلك القمر الذي","لا يكتسي غبَّ التماممُحاقا"],["901754D5-835A-5C70-B3F4-587E775E59E7","ومصالح الاقليم في قلمٍ لهُ","يتكفَّلُ الآجال والارزاقا"],["9BD61079-1DC0-54DF-A865-121E091311C0","يقظان يرعى المكرماتِ كأنَّه","وجد الرقادَ أمَرَّ شيءٍ ذاقا"],["FE5A1398-99C8-5495-A42B-FCD3D8E3AD74","ويُطالع العلياَء حتى أنَّه","عند الرَويَّة يكرهُ الاطراقا"],["0E18D256-1C79-589D-95FB-BF3F90508256","وتخالُ تحت الليل ضوَء جبينهِ","صُبحاً يَمُدُّ على الظلام رواقا"],["C8163F0C-B744-5AB0-B06A-6CAD5F380B5B","ويكاد من فرط التناهي في العُلى","يَرقَى مع الهِمَمش التي تتراقى"],["1542C23B-316B-57A8-82B9-2D807E5879A5","وسيوفُهن في كُلِّ يوم كريهةٍ","تَسقى العدى كاسَ الحمام دهاقا"],["36201F11-C8E7-5C80-B3CE-15B7C4B80959","ما في خلائقها هنالك رقَّةٌ","لكن مضاربها خُلِقنَ رقاقا"],["98EDB104-70A3-5812-A9AA-F1460F61D434","ولو استطاع الناسُ يومَ ركوبهِ","فرشوا لِوَاط جيادِه الاحداقا"],["D52F7FB0-C164-56EF-8031-76A03598E936","ولقد نذرت لئن رأيت وقد حدا","بركائبي حادٍ اليه فَساقا"],["79F9C7A5-15DD-5E12-BD5C-3CBCB060C572","لا زوِّجَن بنت السرور بخاطري","ولاعطيَن بنت الهموم طلاقا"],["61C7BEE4-AC46-5B02-AF69-13625C822FF3","ولا غِفرَن للدهر سالف ذنبهِ","ولا وسِعَن من عُذره ما ضاقا"],["5F8AAF58-5DD3-5EED-B5D7-073529A8B8C0","ولا منحَن ما عشتُ هجري غُصَّةً","جعلوا بغَدرهم الزلال زُعاقا"],["FCB9E0E3-F982-5E53-8120-800830F339B4","وكأنّما أخَذَ الإِلهُ عليهم","ميثاقَه أن ينقضُوا الميثاقا"],["2F226DB9-F1C1-5526-8384-71A1D4B9A054","ما أن دَهاني قَطُّ مكرٌ سَيّىءٌ","إِلاّ رأيتُ باهِله قد حاقا"],["F84E4B44-6149-519E-BC9A-EA8503C5E3A7","يا أيُّها الملك الذي عزماتُه","تركَت زئير الخالعين نُهاقا"],["5BBE53F2-F522-5DB8-902E-E9869BF4B30E","طَرَّزتَ خُلقك بالعفاف وحبَّذا","من بالعفاف يُطرِّزُ الاخلاقا"],["F66202A7-FD76-584C-BB42-CA25A70EEB4A","وجعلتَ عفوكَ حَليَ سطوتك التي","من دأبها أن تضربَ الاعناقا"],["BDFB980F-F502-5F81-A49F-17ED49250AA9","فلذاك لم يسمع بذكرك خالعٌ","إِلاّ صحا من ذكره فأفاقا"],["0203F62E-51BF-5C89-AE24-ED88ED818728","لا زلتَ مثل أبيك أوحد دهرِهِ","سبقاً الى أمد العُلى سَبّاقا"]]},"CDBF676A-B373-577D-803D-11E4AB829220":{"t":"فهجرنا القنا وَزُرنا القناني","p":143,"s":"فهجرنا القنا وزرنا القناني","r":"476654","v":[["1F6D44CA-9409-53D5-923D-C8F9D2D58D67","فهجرنا القنا وَزُرنا القناني","واشتغلنا عن الظُّبا بالظِّباءِ"]]},"AA3EFDD4-3443-5396-AE7F-87695DE908DA":{"t":"قد كنتُ أرجوك للبلوى إذا عرضت","p":143,"s":"قد كنت أرجوك للبلوى إذا عرضت","r":"476662","v":[["3CEFF693-5414-5624-8014-BC6C6F0F29E8","قد كنتُ أرجوك للبلوى إذا عرضت","فصرتُ أخشاك والأيامَ للغِيَرِ"],["397F2620-0FB0-5B51-A222-B59EF93F8890","أخشى وحكميَ أن ارجو ولا عجب","وربَّما يتأذَّى الروضُ بالمَطَرِ"]]},"7C0BD36A-A1AC-5622-8D08-2AB06744D844":{"t":"كم ذا يُناصِحُ في الهوى ويُخادعُ","p":143,"s":"كم ذا يناصح في الهوى ويخادع","r":"476642","v":[["FB3D8ABB-7B2F-5645-AC20-F3D6489821BF","كم ذا يُناصِحُ في الهوى ويُخادعُ","سَكَنٌ يُواتي مَرَّةً ويمانعُ"],["0B77EE52-78E6-5EBB-A42F-570D5E45EA4D","جزت الخيام وقد أحاط بها الدجى","فَجلا الدجى قمرُ الخيام الطالعُ"],["80D80039-345A-5465-897B-FC786A06779C","فدنوتُ منه فاعترته نفرةٌ","فمضى يقول وليس غيري سامعُ"],["AD9BFF03-B5E2-55DD-8363-EC5DEF288F5A","وذمام قومي يلا رجعتُ ولا الكرى","يوماً إِلى أجفان عينيك راجعُ"],["594C2B68-9070-55D4-9D14-1F3A185A39A1","فأجبتُهُ والدمع يخدمُ لوعتي","ولكُلِّ عضو لي هناك مدامعُ"],["EF831B1F-3648-5913-AC71-AC487774492F","يا ربّةَ الخدر الذي بفنائه","أبداً لافئدة الرجال مصارعُ"],["DAD8B5FE-C5F7-50A9-90CF-B9C7D06DD5DF","فاخرتُ قومك فاعتقدت ضغينةً","بِرُماتها من لحظ عينك ساطعُ"],["E14A5824-27EA-58F2-A264-5E53DFEE1960","لا تُضمري حِقداً عليَّ فاننّي","لكلاب حبّك دون قومك تابعُ"],["766C2385-58A2-53BC-AD7B-CE648EECB7B7","أخليتَ صدرك من هواي كأنني","في صدر بِرِّك عند ذكرك دافعُ"],["0DE99F2D-0168-5D0E-802B-90D7D7862C61","ومللتني حتى كأن لم تعلمي","انّي لمفترق المحاسن جامعُ"],["5CD0D657-DE3E-55C9-BB56-58DEEC08C61B","لّما مَنَعتِني الوداد فبعدما","حكم التطوُّل أن يذمّ المانعُ"],["E46B0F6D-AB75-5687-818F-BAD9A98DAD44","أوضاع دمعي في هواك فطالما","أنا بين أرباب الممالك ضائع"],["7A197BDD-C2F1-56E0-96B2-3D8ABC8313AD","فدنَت تقبلُّني وتَمسَحُ عَبرتي","وتقول لي مذعورةً وتُطالع"],["362E3EBD-D0FD-5130-85E9-B842D84240C2","أنأى القلوب الجازعاتِ إصابةً","قلبٌ على لم يَفُتهُ جازعُ"],["4C4FE3D7-8489-5710-B08F-F0151E8B423A","مهلاً فقد تكبو الزناد وحشوُها","نارٌ وقد يَنبو الحُسامُ القاطع"],["2CEEF063-8AB2-5B30-9EAE-8E88561B37D3","والمرءُ يُولَعُ بالمُنى وبلوغها","والدهرُ يأبى ذاك ثُمَّ يُطاوع"],["D3B855C7-2A66-5E6C-828A-117F4A9CD95A","لك في معاتَبةِ الملوك طرائقٌ","هي للخدود إلى السعود سوافع"],["B43352A3-68BE-500B-AB1B-93C53B423C1B","ومؤيَّد السلطانُ يلبسك الغنى","فلباسُ موعِدِه الوفاء الناصع"],["33CAADF0-D829-5BB6-BAE7-4D5013DAB777","قد كان منكَ اليه ما هو سائرٌ","في الأرض تنقلهُ الرواةُ وشائع"],["B5FE7183-8B6A-5576-91AE-602E1AAAD183","وبعَقبِ هذا الرشّ سيلٌ دافعٌ","ووراء هذا النثّ روضٌ يانعُ"],["C94BB59A-55CF-5CCB-8995-C7CD3A1FA6E0","وكذا الكتائب تلتقي لقراعها","ولها أمام الالتقاء طلائع"],["AECA9567-CE56-5BE0-AAFB-75B0A9F578A3","فشكرتُ عطفَتَها وما كشفَتهُ لي","بِحَديثها فكلامُها لي نافعُ"],["B4B0F494-DFA2-5558-9019-880F1BB97405","ورجنعتُ موفوراً وجأشي ساكنٌ","وهجعتُ مَسروراً وقلبي وادعُ"],["69CE5300-F630-57F1-A10C-B0AFD7D4B16D","وعلمتُ أن سَيُفيقُ لي غبَّ الكرى","بمؤيَّد السلطان جدٌّ هاجع"],["5637936D-069D-5F52-8BB9-CE8E0C0053CA","ملك غداء العَدل منه والنَّدى","شكر الرعية والمديح الرابع"],["4D7714AE-C133-55C5-B41B-029F212AA278","صولاتُه للنائبات مآفلٌ","وصِلاتُهُ للمأثرات مَطالعُ"],["41312371-8C66-523F-B00C-963665C8C905","ولذكرِ ما صنعَت قديماً خيلُهُ","قبلَ الوقائعِ في النفوس وقائع"],["159C927D-93E8-5A45-B012-ABE84557F0EC","والنصر حيثُ ترى هلالَ لوائهِ","لك طالعاً وسط العجاجة طالعُ"],["DD846871-C479-5DB1-8033-EFC84991B8B3","وله إذا صرع العَزائمَ حادثٌ","لألأُ عَزمٍ للحوادث صارعُ"],["D55C2D72-B418-5E6C-B631-9334318FEE01","ومكيدةٌ في الروع سُلطانيَّةٌ","هي هقبل نَقعِ الخيل سَمٌّ ناقعُ"],["ACC3D36B-31A8-5CE1-9920-605E8E707874","وطريقةٌ في المكرمات غريبةٌ","حُمِدَ الحريصُ بها وذُمَّ القانعُ"],["45B0D625-0C3F-5DC0-8237-856EED569F78","يولي صنائعَهُ الرجال وعندَهُ","علَلُ السؤال إِذا فصلن صنائعُ"],["E9CDA59D-F813-54C0-A815-4C8FFB5FE79E","وأجلّهم حَظّاً وقد وسعتهمُ","من لا يُزايِلُهُ الرجالءُ الواسعُ"],["0A582D4C-067F-54E1-A137-4B21618A99ED","فكأنّما كانت لدى آبائه","قدماً لآباءِ العُفاة ودائعُ"],["1C2294EB-44B0-54E7-AAF5-422DD0809FE1","شِيَمٌ لو اتَّبع الأكابرُ هَديَها","لغَدَت هوادي الكبر وهي توابعُ"],["FCC114D5-4256-532B-BFFB-07EBFD20A79C","والفعلُ ما لم ينتفع في سيرةٍ","برياضَةِ الانصافِ فعلٌ طالعُ"],["D0719F83-CF9E-5498-9E38-E85ADC639B30","لم يعتمد هذا الزمان مساءتي","حنقاً عليَّ بل اتفاقٌ واقعُ"],["835B1FE1-5854-5906-A25B-BAE774C96DA3","ما كان ينأى أن يُصانعنى الرضا","لو كان يَدرني كُنهَ ما هو صانعُ"],["47B255FF-B174-51AA-90D8-AEC60B290D51","أفنى الاعزَّةَ غير كلّ مُسَربَلٍ","بالعجز يركبُ أخدعيه الخادع"],["91E0C654-CB94-5136-9DF9-0CBCE2572F1D","يبكي إذا سجع الحمامُ صَبابةً","نجوى فيُسعِدُه الحمامُ الساجعُ"],["BCD450E0-77FC-5783-A47F-B0B45E3BCD8A","وتذكرّ الأوطان أمرٌ فادحٌ","وتشوُّق الاخوان خَطبٌ فاجع"],["57FA82D9-7CC8-56D6-AFCB-0916888D5E94","وكذاك عُمرانُ الديارِ إِذا خَلَت","ممَّن تُحِبُّ فانَّهنَّ مَسامع"],["26BD13B9-1D15-5035-87E8-50813808BCAD","أمؤيّد بالسلطانَ عاوَِد نظرةً","بمكانها يدنو المكان الشاسعُ"],["38F9F400-3281-56AB-82F0-B00C9FBBD20C","واسمع مُحَبَّرَةً إِذا هي أنشِدَت","وَدَّ الجوار انهنَّ مسامع"],["794440DD-913D-5DB0-8834-D7AD58DD442F","ارسلتُها كيما تكونُ ذريعةً","وقصائدي حيث اتجهن ذرائعُ"],["0EF08FD4-CA9D-5CA1-BE0B-2FAAB39680B7","ولئن بقيتُ لتأتَينكَ غرائبٌ","تَسبي عقول رُواتها وبدائع"],["0E825947-7C7F-5060-81D3-E843570A5233","بل لا يُطيقُّ صفاتَ مجدك واصفٌ","ما لم يُطق ذرع البسيطة ذراع"],["96C8011D-D772-57FF-87BF-DDDB60B00059","فذراك للأموال فيه مناهبٌ","أبداً وللآمال فيه مراتع"]]},"C670E6A2-4C4F-5CAE-9AE2-FC2278A7844C":{"t":"لا تحسبُوني ناسياً عَهدكم","p":143,"s":"لا تحسبوني ناسيا عهدكم","r":"476644","v":[["11B757A1-A513-51E3-9E77-0DC40DDAB3C1","لا تحسبُوني ناسياً عَهدكم","نسيانُكُم ضربٌ من السُّخفِ"],["067BA1AC-57B3-545F-B922-FF1638DA48C5","سيّان أن أفتَر عن ذكركم","أو أعبُد الله على حَرفِ"],["FA7A4FCF-9118-5756-AB34-4F16D705CD49","وكيف أنساكم وفي وَصلكُم","عَيشي وفي هجرانكُم حَتفي"],["230646FE-FE4A-5C85-AAF1-F2E8DB475C1E","لهفي على عُمرٍ مضى لم يكُن","ذلك في خدمتكم لهفي"],["C20FBBBA-5940-5B07-BCA7-B843E93BA0FD","هذا ويدنو في غدٍ دارنا","وكُلُّ حزنٍ فالى كَشفِ"],["59579463-95A7-5CD6-85CD-3E73B6884471","رُبَّما يجلو صدا أُنسنا","تشاغلٌ باللهو والقصفِ"]]},"81E4D8F6-EA64-5BAB-9928-524C59E86BBF":{"t":"لثبات حكمك كاد يذبل يذبلُ","p":143,"s":"لثبات حكمك كاد يذبل يذبل","r":"476668","v":[["50B9FC27-88CF-533D-ACB6-216EB3C5B743","لثبات حكمك كاد يذبل يذبلُ","ويشمّ رائحة الزوال شمامُ"],["CE164686-7921-5AD7-8A90-CFCDE8A067A5","وإذا كتائبهُ انبرت أو كتبه","فُلِقَت هناك الهامُ والأوهامُ"]]},"32B90537-21F7-5467-B6EE-5DF4AF4BC192":{"t":"ليهنِك أنَّ ملككَ في ازديادِ","p":143,"s":"ليهنك أن ملكك في ازدياد","r":"476658","v":[["B5CDD7CC-66FF-5667-9BE0-26A4B2E63C21","ليهنِك أنَّ ملككَ في ازديادِ","وانّ عُلاكَ واريةُ الزنادِ"],["8C5BABB7-2C40-5F1B-BC3D-959B4DE552A7","وأنّك مَن اذا وصف المُوالي","مناقِبَهُ أقرَّ به المعادي"],["4245A826-44DC-5E73-9769-C30AD41610D3","حديثُ قِراك مَتَّع كلَّ سَمعٍ","وذكرُ نداك عَطَّر كلَّ نادِ"],["62D89B2B-3DCB-540A-8CF0-C704C21BAB65","وينقاد الملوكُ لك اعتقاداً","وما انقادوا لغيرك باعتقاد"],["FF3B3B01-2B89-56D4-9682-6D146D17BA8E","ملكتَ رقابهم بأساً وجوداً","فهم مِلكُ السيوف أو الأيادي"],["16AE3A33-35AD-5470-959F-6263F44CB6B1","إذا استعرضت جيش الرأي ليلاً","جعلتَ عطاَءهُ طول السُّهادِ"],["14B470F0-07FA-52A4-9D95-E58A55B80F28","إِذا ادَّرعوا الدُّجى والهولُ بادٍ","سروا ونجومُهم غُررُ الجيادِ"],["3E098647-C162-5FFC-A87C-40B36B47F224","فبالسُّمرِ الِّلان إِذا تماروا","ألنتهُمُ وبالبيض الحداد"]]},"673DDFB7-CC71-5DA3-9410-4493DEC4E43F":{"t":"متى أردت أيادي راحتيك كَسَت","p":143,"s":"متى أردت أيادي راحتيك كست","r":"476660","v":[["180A6F29-9E47-5B8F-BD76-ECF8BF634FB1","متى أردت أيادي راحتيك كَسَت","حَيا الغوادي حياَء الغادةِ الرودِ"],["613CA744-A690-55A4-8F88-3A1A5E52B838","فكان عيشٌ على السرّاءِ مُطَّرِدٌ","يُزري بِهَمٍ عن الاحشاءِ مطرودِ"]]},"2207AE3E-B4B1-5A8D-99FA-DC7E17F0817A":{"t":"هل في مَودَّةِ ناكثٍ من راغبِ","p":143,"s":"هل في مودة ناكث من راغب","r":"476640","v":[["7F6167DD-53A5-51E5-9E0F-E3ADD591BB29","هل في مَودَّةِ ناكثٍ من راغبِ","أم هل على فقدانها من نادبِ"],["1103BE38-0E10-5819-BCDC-16405DC84520","أم هَل يُفيدُكَ أن تُعاتِبَ مُولعاً","بتَتَبُّعِ العثراتِ غير مُراقبِ"],["EEC0D2DF-18C6-5238-BCEE-2948E5C666FC","جعل اعتراضك للسَّفاهَةِ ديدناً","والذئبُ ديدنهُ اعتراضُ الراكبِ"],["E5112545-A089-5166-B388-94DB13D83192","نفرٌ تُعاقبُهم بعفوكَ عنهمُ","كم بالغٍ بالعَفو فِعلَ مُعاقبِ"],["36E921BF-AD78-591F-92AF-4EBC5BB90CC0","ولربَّما صادفتَ أعصَى مُذنبٍ","مُتَبَختِراً في ثوب أطوعِ تائبِ"],["0063E11F-F3F2-5E3D-91FB-049A6CD0EF00","يُوليك نُصحاً من لسان مُسالمٍ","وًَيُسِرٌّ كيداً في ضمير مُحاربِ"],["C51C72A5-337E-5441-90A8-A5C0F79D8B49","والحزمُ تصديقُ العدوّ المدّعي","وُدّاً وإرضاءُ الصديق العائب"],["B54BBA3A-A429-5A7B-BF1E-D4A3004D0D84","إنَّ الفتوَّةَ علَّمتني شيمةً","تُهدي الضياَء الى الشهاب الثاقبِ"],["0EDFF668-CB04-5B55-8EC5-945A3CE212DC","أرعى ذمامَ موافقي ومخالفي","وأصونُ غيبَ مُعاشِري ومُجانبي"],["66329142-A33C-5CDA-8429-F5D24E33D9FE","وتعلّلي بحديث أيّامِ الصِّبا","من عُظم لذّاتي وجُلّ أطايبي"],["548A07AD-D989-5C5A-A3F2-6A96BFE49AD1","ما زال يسلبُ كلَّ من حمل الظُّبا","قلمي وأحداقُ الظِّباءِ سوالبي"],["6B6608A3-2E7D-5049-8233-37328FD47084","فهوى التصرُّفِ والتصرفُ في الهوى","دفنا شبابي في قذالي الشائب"],["B4AB4FC2-C10A-5BD4-AC08-80C1D0EDF27B","فتظلّمي من ناظرٍ أو ناظرٍ","وتألُّمي من حاجبٍ أو حاجبِ"],["F388E3C8-A33A-5E4A-B46D-7EABF32A4305","تالله لم يخطر ببالك أن ترى","ذا الجدِّ يخطر في شمائل لاعبِ"],["F96356D4-15FB-5E2D-853D-FE85136CFE75","وعزيمةُ البطل المُعانقِ قرنَهُ","تَصدى فيجلُوها عناقُ الكاعبِ"],["92A6E4DA-7B7D-5AE1-A8AE-B201887385E3","مارَستُ هذا الدهرِ حتّى انَّه","لضرائرٌ أحداثهُ وتجاربي"],["E2400DBD-3F35-54D7-99C0-6B2BD29EFAC4","ووجدتُه كالسيفِ ليس بفارقٍ","بين الأُلى ضربوا بهِ والضاربِ"],["ABA71D66-6C2C-5670-BFCE-89B825CE03AA","وقبلتُ عُذرَ بني الزمان لانَّهم","سلكوا طريقَ بني الزمان الذاهبِ"],["39D34C26-0B8E-5D3D-AED9-215417738978","جُبلُوا على رفض الوفاء لغيرهم","وتَمسَّكوا بالغَدرِ ضربةَ لازبِ"],["B90E0AAD-6EC8-5ACF-A9FE-2DE16F65E26C","ومركّبٌ في طبع كلّ مُكلَّفٍ","حمل الرجاء طلابُ فوقِ الواجب"],["C8A6867C-74CA-5C0C-9261-792147ED5546","والرزقُ يطلع من رفاهة قاعدٍ","لطلوعه من سعي آخر طالبِ"],["35EE9304-A638-58C9-8DC7-A6C86357B0EA","وسجيَّةُ الأيّام ستر فضائلي","عن عَينِ رامقِها وبثّ مثالبي"],["DF1C0B38-B3A2-57DA-A383-4141474D39B3","أيّامُ عمري في تلوّن جريها","تحكي الرياح فهل لها من عاتب"],["1E56E763-3AD5-597E-BCBE-D5B6938D90AD","الحال تهزل بين جذب شمائلٍ","منها وتَسمَنُ بينَ خضب جنائب"],["7BAEDA57-7278-5782-BC66-BDAB5C157D6F","قُسِمَت وتلك غنيمةٌ بحظوظهم","ورموا وراَءهُمُ بحظِّ الغائبِ"],["63FE049A-0025-57B6-AAD6-237C3DEDCC25","لو نلتُ عزَّ متوّجٍ في توّج","لم أخل من دلّ وظنٍ كاذب"],["F269A224-E1C5-5F92-A2E7-757AA5581F26","ما إن أسأتُ الاختيار وإنَّما","قاد الضّلالُ الى اللئام ركائبي"],["2999765A-9239-5E97-9348-D8337173DA23","نَهبوا ولجوّا في اقتضاء مديحهم","وقضيَّةٌ شنعاء مَدحُ الناهب"],["0268B3F0-365C-541E-B510-04A852BDCAFD","من دأبهم منع الحقوق فهل لهم","منع اللسان عن الملام الذاهب"],["C09E601B-C2EA-53D3-B797-94699B6B47A0","الآن ما بيني وبين بصيرتي","رُفع الحجابُ فالنجاح مآربي"],["8E94F8EB-0343-509D-A278-7C097958E82A","أكفى المؤنةَ في مذمَّةِ مانعٍ","نفسي وفي لمنَّةِ واهب"],["B0E6B720-E4DF-55EB-A385-310D654FCBA3","ها انّ أرضَ عمانَ أنفَسُ بقعَةٍ","ومؤيَّدُ السلطان أكرم صاحبِ"],["85C035BD-08A9-5CB2-9B35-65EA492C4B1C","ما زال إمّا في صدور مجالسٍ","يبني العُلا وفي قلوب مواكبِ"],["87F09516-A49F-5BC0-81ED-179CDF87DBAA","والى أياديه صرفتُ مطامعي","وعلى مَعاليه وقفتُ مطالبي"],["8EFD3A15-0F2A-51BF-ACED-F607423524C3","أأُعاتبُ الأخوان في استبدادهم","دوني بها فأكون شرّ معاتبِ"],["280B99BD-E94C-56F3-821E-E24CC016B3F9","لبسوا بخدمتهم لديه مواهباً","لا كالمواهبِ طُرِّزَت بمراتبِ"],["23CCF753-1BB3-55BA-9023-408C984E1610","فاذا آمالهم بصِلاتِه","فصِفِ التقاء أجنَّةٍ بجنائب"],["34C8F67F-8CDD-5929-B854-D3F2A14F9F41","قمرّ سرادقُه لِلَحظِك بُرجهُ","يرمي العداء بعزائمٍ ككواكبِ"],["E98CA7FF-4D26-5E19-BB8F-EABE23323550","فَلَهُ المنابرُ والمحاربُ حَبَّذا","من كان رَبَّ مآثرٍ ومَحاربِ"],["0FD27F8E-8B97-58C3-96A8-5D03E8B43BE0","وأهلّه الرايات تطلع تحتها","أبَداً نجومُ أَسِنَّةٍ وقواضبِ"],["63B17602-CF61-5D50-9961-C5EBF499AF61","والخيل مازالت تشبّهُ والعدا","بالليل أن طلبتهمُ والهارب"],["7547E42C-B5F8-5BB8-BD62-35973EE9B46D","فالأرض تشكو ركضَها من جانبٍ","والجوّ يشكو نقعها من جانبِ"],["16F66D81-B818-50AF-BF8E-1E248D56E4BB","وسرى السرايا تحت كلّ دجُنَّةٍ","كُسِيَ الخيالُ هناك ثوبَ الهائب"],["3441F921-F6BE-5221-901E-5B579F6FEE11","من كلّ أروع للحياة مُطَلِّقٍ","تحت العجاج وللحميَّةِ خاطبِ"],["8AC9E0B8-28C1-51F9-B8A1-71A9DA451C5A","ما زال يجمعُ بين بأسٍ صادقٍ","يجلى به الجُلّى ورأيٍ صائبِ"],["550461C9-D4A6-5E50-9239-CA8DC396E1C6","والمشرفيّاتُ التي بشفارها","هلكت ملوكُ أعاجمٍ وأعارب"],["9DB5D931-1A69-5FB6-B9DD-C0E306BAB12B","طُبعَت شُموساً فَهيَ في أغمادها","والهام بين مشارقٍ ومغاربِ"],["BC998768-EAFB-5310-B772-DD2A76A548CF","تنقادُ أبكار البلاد لحدِّها","بعد النشوز وبعد منع الجانب"],["D8D2BF02-22B7-5C13-BEF2-250D8C577442","ومناقبٌ ودَّت مَصابيحُ الدُّجى","حَسَداً لها لو لُقِّبَت بمناقبِ"],["D950234E-657C-553E-93B8-847EC04AD5DF","وغرائب الكَرَم التي إن فتشت","في آل مُكرم فَهيِ غيرُ غرائب"],["FCB93C04-5CB8-5015-935F-9ACDFB21B0FB","والملك يشهد انّهم بولائهم","يكفون شرَّ الخالع المتشاغب"],["B01ED7A6-0529-55B2-9786-FE2FD8EC975B","أنصارُهُ في كُلّ خطبٍ فادحٍ","وحُماتُه في كُلّ أمرٍ حازبِ"],["47FBBE78-D827-5A7F-9463-A284C2D53827","هذا العُلى حقاً فهل من شاعرٍ","يصف العُلى وصفي لها أم كاتب"]]},"51E984F0-D424-544E-9F3C-A8171C3B6F27":{"t":"وأعزّةٌ عَزَّيتُ بعد فراقهم","p":143,"s":"وأعزة عزيت بعد فراقهم","r":"476643","v":[["967774F0-A79E-53D6-A69D-50C781BFCA73","وأعزّةٌ عَزَّيتُ بعد فراقهم","باليأس قلبي أن يكون لقاءُ"],["BB2AE524-6A6C-5702-AE2C-E28A3769CE79","أشتاقُهم والى الترنُّمِ مَفزعي","والى الترنُّم يفزعُ الادباءُ"],["E1D2F07C-358B-57FB-A0C5-0E04E9319545","ولربّما شَبَّعته بتنفُّسٍ","فيكاد يَصدَع قلبيَ الصعداءُ"],["D31AFCDA-333E-55D0-AF7C-44B44A92F7F8","فإذا أضفتُ الى التنفس عَبرةً","فالجوُّ نارٌ والبسيطة ماءُ"],["2A25F827-3EAD-5192-8C43-D2479048B395","كم أندبُ القُرناء شَجواً والصِّبا","فاتَ الصِّبا وتفرَّقَ القُرناءُ"],["CF27F1B6-1660-5830-97E7-5EDF82C026F9","والجمع مَع فقد الشَّبيبة بيننا","قبل الممات مُرُوَّةٌ عذراءُ"]]},"BB159351-EDB3-53E9-809C-71062D123E87":{"t":"وصحراَء رَدَّتها الظِّباءُ حفائراً","p":143,"s":"وصحراء ردتها الظباء حفائرا","r":"476663","v":[["78F6A2C9-77F3-561E-BD5E-55F1B6D654EB","وصحراَء رَدَّتها الظِّباءُ حفائراً","بأظلافها أَحسِن بها من حفائرِ"],["8E6323C2-420D-5FD1-AB5A-EEE6F10C2633","فَهَبَّت رياحٌ للصيّا فطممنها","بمسكٍ فعادت نُزهة للنواظر"]]},"A7750217-F2C0-5F7D-9A7B-F5040DDFFBA2":{"t":"وقومٍ أخَلُّوا بالذمام لمن رَعى","p":143,"s":"وقوم أخلوا بالذمام لمن رعى","r":"476647","v":[["F6B096A5-2638-5E2E-A88D-C1064818685A","وقومٍ أخَلُّوا بالذمام لمن رَعى","لَهُم ونسوا حفظَ المودَّةِ في القُربى"],["1D636F76-3850-594C-9AD6-EE3C95272F42","مَحضنا لهم نُصحاً فجاءوا بغَدرَةٍ","وكُنّا لهم سِلماً وكانوا لنا حَربا"],["C8FC5944-726B-5F46-9235-7E23ADBB9152","ولم نجزهم بالسُّوءِ سُوءاً ولم نَلُم","ولم نُظهرِ الشكوى ولم نُظهر العُتبا"],["E72E9064-EB43-50F3-A1AA-4F3CE728E0A0","وقُلنا عَسى أن يَنتهوا عن فعالِهم","فيستَوجِبوا منَّا لأن نغفِرَ الذَّنبا"],["7FD7C42D-EBAD-5EBD-BEBD-83B9067B885E","فلمّا أبوا إِلاّ اعتماداً لشرِّهم","وبَغياً جَذَبناهم الى شَرِّنا جَذبا"],["FC5AD005-9C25-5114-B75F-85A0C795195D","وقلنا لهم ذُوقوا وبال أموركم","فمن يَسق مُرَّ الماءِ لا يشرب العَذبا"]]},"66D2E00D-2EE8-5A74-A1AA-1B9D71E7CAFE":{"t":"ويلك يا ثابت ما أخملك","p":143,"s":"ويلك يا ثابت ما أخملك","r":"476667","v":[["F0BDB218-709A-5338-B4B3-1D95244D4D68","ويلك يا ثابت ما أخملك","ولّلذي يعلوك ما أحملك"],["2893AA24-A9C8-5C7C-B8DE-DCD43373B9CB","ما كان من فألٍ جميلٍ فلي","أو فَلَكٍ دار بنحسٍ فَلَك"]]},"251A6987-B69F-5255-B396-3B94B769A271":{"t":"وُعودُ وصالها عادَت نَسايا","p":143,"s":"وعود وصالها عادت نسايا","r":"476645","v":[["C166789F-D007-55AE-848F-DB02D8590E86","وُعودُ وصالها عادَت نَسايا","وعاد نوالُها الميسورُ وايا"],["327E08E5-8247-5512-81BF-B09E47DC5FA1","إِذا أنشدتُ في التعريض شِعراً","تَلَت من سُورة الإعراض آيا"],["E7AC4333-4EC9-51A7-994E-F37DD8DD3598","ولستُ أخافُ حَيفَ الدهر ما لم","تُبَدِّلُ دارُها بالقُربِ نايا"],["01177FAA-A379-5F7C-B33B-BF9C1D5DB68F","ورُبَّ قَطيعةٍ كَانَت دلالاً","وكم في الحُبِّ من نُكَتٍ خَفايا"],["9BB673F1-2704-510D-B12B-DBDFC431D486","شَكَت فعلي إِليَّ فآنسَتني","وبعضُ الأُنس في بعض الشكايا"],["2C47120B-990C-5611-A748-EFD404C86DA4","فلا مَلَّت مُعاتبتي فانّي","أُعُدُّ عتابَها إحدى الهدايا"],["02EA52BC-F5AD-51EA-B239-025A726B0227","ألا يا حبَّذا يوماً جَرَرنا","ذيولَ اللهو فيه بجرجرايا"],["E4ABE399-CDF4-519A-B804-B87E2B121712","ويومَ مَشَت تميلُ من التصابي","وتضحك بين أترابٍ صبايا"],["DE470706-76E7-5B25-8FCF-C369E5A7FE8C","ثَنَينا السوَء عن ذاك التثنِّي","وأَثنَينا على تلك الثنايا"],["52F664AA-0D10-54B6-ABD8-9C5CC89CE60B","ألَمَّ خيالُها وَهناً فَحَيّا","باحسنَ ما يكونُ من التَّحايا"],["9DB353E5-5525-5E95-9C91-1E65E42B2921","وقال صُنِ وَصِيَّتَة بنُصحٍ","فانَّ النُّصح حَليٌ للوصايا"],["1A6F5A06-75D3-532D-8FF3-D4DB5845E28E","وما استتمتُ رؤيا الطيفِ حتى","تَرَنَّم بالسُّرى حادي المطايا"],["F0B67A1B-5593-5622-8B5F-9F5DF79879BD","وفاضَ الدمعُ في أثناءِ جَفنٍ","تردَّد للكرى فيه بقايا"],["0753E78F-813F-5406-835C-BEB650B1105A","وما خُلِقت عيونُ العِين إمّا","نَظَرتَ سوى بلايا للبرايا"],["32AA3143-AC5F-5696-886F-04553460833F","فمنها ما يبيحُ لكَ الأماني","ومنها ما يُتيحُ لكَ المنايا"],["7FFFD088-75B4-5ED6-98C7-7A7FBAC2B818","ألا يا صاحبيَّ دعا كلامي","فليس الَّلومُ من كَرَمِ السَّجايا"],["6ECDF817-0857-5306-880F-39414B34A601","إِذا طرقَتنيَ الأشواقُ ليلاً","فَرَشتُ لُهنَّ أفكاري خبايا"],["B24A613D-C32D-5BC7-B44E-7F8D28B07429","وفي بعض القُلوبِ عيون فكرٍ","بِكُنهِ عواقب الدنيا جَلايا"],["D22653FD-3ABA-5A50-A4DB-3E1C558004E0","وأوضحَ لي طريقَ العيش شُغلي","بمدح أغرَّ وضّاح العشايا"],["8954E56D-AECB-5839-A20D-CEDF7ED2F3AB","ومن شاع اسمه بالعدل حتى","أَمُرَّ به الأعادي والولايا"],["F429BBC7-B329-5BC7-9097-490ABE46977D","ومن رضي التُّقى خُلُقا فأَرضَى","قوامَ الدين بالخُلق الرضايا"],["079CA0AF-61E0-51A1-AA2C-A95BA07845BA","عميدَ جيوشِه عزماً وبأساً","وحارس ملكِه حَزماً ورايا"],["3C3D4BD7-3B73-50B8-8EFC-0B0538C43B4C","تُرجِّيه على بُعدٍ فيكفي","بما يرجوه أسبابَ البلايا"],["5990E480-C425-58F6-BE35-B8E3EC288CBB","ونقصِدُه فلا جَهمَ المحيّا","نُصادِفُه ولا نَزرَ العطايا"],["02A969B1-B220-51CC-9811-CD989F5FF3B0","نصاحبُ كلّ مجدٍ صاحبيِّ","مزيَّتُه تتيهُ على المزايا"],["3FC19B35-A0CE-59F9-A088-84CE4A00920B","لنا منهُ إِذا سرنا إليه","سناء الذكر والخلعُ السَّنايا"],["BFE32DE6-00DA-5482-B87F-0AC331E25E50","على أيدي الملوك عَلَت يداهُ","علوّ الباسقات على الودايا"],["FFD508C5-47D6-5925-A667-30F0E0F06678","لقد نُظمت لاعناق المعالي","قلائدُ من خلائقه الرَّضايا"],["80350771-E26C-590B-9A65-0F366A6E3B0B","وايُّ فَضيلةٍ جُعِلَت لقومٍ","له المرباعُ منها والصَّفايا"],["F0E731E1-24B4-595E-8668-69870FE73EB5","أقول لمن خراسانٌ ومصرٌ","بأيديهم وأنفُسُهم دَنايا"],["17ECD2EF-4F5E-5493-B490-ED8C22E1D087","دنا نَبشُ الخبايا فاستنيموا","إِلى قولي دنا نبش الخبايا"],["5C12ACEC-6EFC-5A41-9691-A371D0241F55","أزيلوا الشكَّ وانتظروا وشيكاً","سُرى يقظان ميمون السَّرايا"],["65FC5A78-4B3D-5FC4-97A2-1A8C2D0170B4","سيرمي أرضكم بجنود صدقٍ","فوارسُكم لرجلهم رمايا"],["0AA36829-5E7A-5499-B8DB-5A8296C9BCA7","وتأخذكم سيوفهم فتقضي","على هاماتكم نَثر القضايا"],["5BF61B8F-95DC-5BCE-8B31-8376187DC029","رجالٌ كُلَّما غنموا فآبوا","رؤوس الخالعين لهم سَبايا"],["772BF97A-8E64-5980-99CB-ED9BF2949AFC","رأوا ان الاصابةَ في رداهم","كأنَّ حياتهم احدى الخطايا"],["F86D8BB5-226D-5493-BA0E-20D2DD6A46F4","ألا يا صاحب الأصحاب أنِّي","أرى الايمان باسمك لي ألايا"],["3EF83F7E-254E-5AF3-B594-1AAE78A55860","وإنَّ من الجنايات التقاطي","سوى ثمرات أنعُمك الجنايا"],["3C7ECCB6-6522-5ADF-B6B3-F472CD16C8AF","فعند أبيك عاينتُ الأماني","فخانتني بَكاياها مرايا"],["6A3DC78E-8655-5073-B75F-4CD6C8054F4B","ورُبَّ فتىً ينالُ النجح لكن","إِذا عادَت ركائبه ردايا"],["3DE22F24-5676-5009-A934-EC418C1BE575","وأنتم معشرٌ خُلِقُوا لتبقى","على الدنيا أكُفّهُم السَّخايا"],["80BBB7F7-C36A-5BAB-A974-5CF2B5027398","تُقَبّل بسطَكم قِدماً فَقِدماً","يعيشُ ببسط عدلكم الرعايا"],["EB531BA0-4AA3-5E32-9B83-159CF2CA605F","فقايسكم إِلى نفرٍ سواكُم","يقيس الزاخرات إِلى الركايا"],["6E82B385-73A8-502F-BA85-3BE8C4858297","وحظّكم الصدور من النوادي","وحظّ سواكم منها الزوايا"],["44E1D48F-1A0D-5DB8-BB59-366EC5A971C1","وفيكم سار لا في الغير شعري","وكيف تسير في البرِّ الخلايا"]]},"0929FC2D-E7B6-5EEB-B5C4-AA426AAFDFAE":{"t":"يا حسن عاطلةٍ بالحسن حاليةٍ","p":143,"s":"يا حسن عاطلة بالحسن حالية","r":"476670","v":[["7EF85A32-DFDB-507F-BBEA-002A3F0F5027","يا حسن عاطلةٍ بالحسن حاليةٍ","سوداء يشفي بنيها الدهرُ من فيها"],["B6A51543-F783-50AB-9BD8-26CAEC933AB4","لكن بنوها إذا قيست طبائعهم","الى طباع بني الدنيا نبوا فيها"],["BDDDF743-FC19-5520-9F37-4DD58DCCA441","يلقون إن أُرضِعوا كداً وإن فُطموا","كان الفطامُ لهم في الحال يرقيها"],["572C7DA7-0BD3-568B-A22F-59B9CFA83CE6","خرسٌ إذا رَعَفَت آنافُهم نطقوا","فأحسنوا صفة الدنيا وما فيها"]]},"F2CE228D-39D8-53ED-8DB9-169386077244":{"t":"يقولون لي ألفاظُ هجوك عندنا","p":143,"s":"يقولون لي ألفاظُ هجوك عندنا","r":"476652","v":[["A4297FE9-99A0-51C5-8B6D-6BA68D0D230C","يقولون لي ألفاظُ هجوك عندنا","إلى القَلبِ من ألفاظِ مدحِك أسبَقُ"],["32549AFC-9448-583B-AB4E-70962D75B880","فقلت لهم كذبٌ مديحيَ فيكُمُ","وهجوي لكم صِدقٌ وللصدقِ رَونَقُ"]]}}}