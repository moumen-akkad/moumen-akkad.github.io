{"v":1,"poems":{"4A831315-DE5E-532E-A51A-2C40293C5CA8":{"t":"أراني إذا غالبتُ بالصبر حبّها","p":81,"s":"أراني إذا غالبت بالصبر حبها","r":"468154","v":[["2471A04A-7445-5B49-A89A-EA4848D50C91","أراني إذا غالبتُ بالصبر حبّها","أبى الصبرُ ما ألقى بسعدى فأُغلبُ"],["E0578B72-0D0F-56CE-9540-BDFF9E901648","وقد علمت عند التعاتبِ أنّنا","إذا ظلمتنا أو ظلمنا سنعتبُ"],["D4C64610-97FA-5F1B-A387-AB0FC9A43488","و إني وإن لم أجنِ ذنباً سأبتغي","رضاها وأعفو ذنبها حين تذنِبُ"],["5A1BFBAE-C505-536D-845B-3081184988D6","و إني إذا أذنبت فيها يزدني","بها عجباً من كان فيها يؤنّبُ"]]},"97494F3E-EFB9-5BAC-BE5C-153027D8E08E":{"t":"أرقَ الحزينُ وعادهُ سهدهْ","p":81,"s":"أرق الحزين وعاده سهده","r":"468158","v":[["825B251E-8463-5069-AA38-AF0E1F9AD049","أرقَ الحزينُ وعادهُ سهدهْ","لطوارقِ الهمَّ التي تردهْ"],["8677D6BC-B51C-519E-AED1-95FD2EC28DC8","وذكرت منْ لانتْ لهُ كبدي","فأبى فليسَ تلين لي كبدهْ"],["1396123A-5CB6-542E-A7BD-B4343DB85822","وأبى فليس بنازلٍ بلدي","أبداً وليسَ بمصلحي بلده"],["872548F8-1A9A-586A-9ECB-7D9ED906A753","فصدعتُ حين أبى مودتهُ","صدعَ الزجاجة دائمُ أبدْه"],["16EBCC1B-25E7-5C86-ACCA-E4A9E640DCA6","وعرفتُ أنَّ الطيرَ قدْ صدقتْ","يوم الكدانةِ شرَّ ما تعدهْ"],["67F9E809-D4FD-58C0-B330-E770BBC19B4A","فأصبرْ فإنَ لكلِِّ ذي أجلٍِ","يوماً يجيء فينقضي عددهْ"],["6FCE4DC9-9702-5DFB-8275-84C6033CC204","ماذا تعاتبُ منْ زمانكَ إذْ","ظعنَ الحبيبُ وحلَّ بي كمدهْ"]]},"DE4DE56A-DAAE-5A52-9357-CDA25D4FCA33":{"t":"أستغفرُ الله ربي منْ مخدرةٍ","p":81,"s":"أستغفر الله ربي من مخدرة","r":"468164","v":[["0D1FB0AD-093D-5897-9896-61066623D3C4","أستغفرُ الله ربي منْ مخدرةٍ","يوماًبدا ليَ منها الكشحُ والكتدُ"],["A8437CE9-92CB-5D73-9BD5-34DD1FACB13A","منْ رفقةٍ صاحبونا في ندائهمُ","كلُّ حرامٌ فما ذموا ولا حمدوا"],["246E1CE2-4F1A-58E0-830C-4E77519BFB65","حتى إذا البدن كاستْ في مناحرها","يبلو المناسم منها مزبدٌ جسدُ"],["C274741D-8692-57E3-8E8F-273C26CF1AAD","وحلقَ القومُ واعتموا عمائمهمْ","فحلَّ كلٌّ حرامٍ رأسه لبدُ"],["B02CFDCB-A411-549A-91FC-1E60586F49A2","أقبلتُ أسالها مابالُ رفقتها","وما أبالي أغابَ القوم أم شهدوا"],["4AA31D8E-D9F2-57F3-851E-3A0D72382A93","فقربتْ لي واحلولت مقالتها","وخوفتني وقالت بعض ما تجدُ"],["6535C1D6-9E4F-5C8E-8738-D2C39E28DB97","أنى ينالُ حجاريٌّ بحاجته","إحدى بني القينِ أدنى دارها برجُ"]]},"F7918520-3641-5EE0-8AEB-CBA02937323D":{"t":"أعيني جودا بالدموع وأسعدا","p":81,"s":"أعيني جودا بالدموع وأسعدا","r":"468217","v":[["D5576375-3702-5476-BFEA-8BD8E6B09F58","أعيني جودا بالدموع وأسعدا","بني رحمٍ ما كان زيدٌ يهينا"],["BEE956B5-98E6-56D8-9145-3C39E815705F","ولا زيدَإلا أنْ يجودَ بعبرةٍ","على القبر شاكي نكبةٍ يستكينها"],["23716A0D-D5B5-5A35-9448-303D28B934FE","وما كنت تلقى وجه زيدٍ ببلدةٍ","من الأرض إلا وجهُ زيدٍ يزينها"],["516D4653-F352-529C-8CCD-798F12161171","لعمرُ أبي الناعي لعمت مصيبةٌ","على الناس واختصت قصياَّ رصينها"],["D246D3F0-67FD-58F3-A434-050130E9A916","وأنى لنا أمثالُ زيدٍ وجده","مبلغُ آياتِ الهدى وأمينها"],["2750DBAD-DB73-5B04-BA77-55777487899A","وكان حليفيهِ السماحةُ والندى","فقدْ فارقَ الدنيا نداها ولينها"],["E45587F4-F5C0-5C1D-BB9A-6ED2EE6A96A2","غفدتْغدوةً ترمي لؤيُّ بن غالبٍ","بجعدِ الثرى فوق امرىءٍ مايشينها"],["E253A044-E573-50F4-9E63-F4E70334F3F0","أغرُّ بطاحيُّ بكتْ منْ فراقهِ","عكاظُ فبطحاءُ الصفا فحجونها"],["71D60E7D-902E-53BA-9394-29839F9239AD","فقل للتي يعلو على الناس صوتها","ألاَ لا أعانَ اللهُ منْ لا يعنيها"],["CA22C1E7-44A2-5FE3-AD9A-5BD64FAFAEDB","وأرملةٍ تبكي وقد~ شقَّ جيبها","عليه فآبتْ وهي شعتٌ قرونها"],["B87922F8-A273-58CC-9B6E-3F42130C6309","ولو فقهتْ ما يفقهُ الناس أصبحتْ","خواشعَ أعلامُ الفلاة وعينها"],["702DF878-A059-5A1A-85EB-F5F846B28F5C","نعاهُ الناعي فظلنا كأننا","نرى الأرض فيها آية حان حينها"],["76E181C5-BDC4-59DE-B6A1-E3FD0AFC2132","وزالتْ بنا أقدامن وتقلبتْ","ظهورُ روابيها بنا وبطونها"],["EB5CF642-1790-53F3-A802-C36FAEB0A8E0","وآب أولو الألباب منا كأنما","يرونَ شمالاً فارقتها يمينها"],["BE50ADB0-EA85-51AA-BEEE-AD3C1F8CB659","سقى الله سقيا رحمةٍ تربَ حفرةٍ","مقيمٍ على زيدٍ ثراها وطينها"]]},"23495335-2C01-58D3-A492-320EE999B5A9":{"t":"أعينيَّ لا تستعجلاَ الدمعَ وانظرا","p":81,"s":"أعيني لا تستعجلا الدمع وانظرا","r":"468183","v":[["51F659DA-76F9-565F-84D5-FF667BB89927","أعينيَّ لا تستعجلاَ الدمعَ وانظرا","شبيه ابنِ أمَّ المؤمنين المودعِ"],["0824BCE8-F886-5F3E-82D9-7F57B1C8DDCF","ولاَ تأسا أنْ يشعبَ الصدعَ بعدهُ","أريبٌ كفرع النبعةِ المتزعزعِ"],["9BFED3CA-76D2-5554-85C8-E5204D0E59A1","جديرٌ بأنْ يسعى ابن صدقٍ كما سعى","أبوه على مسعى أبٍ لمْ يضيعِ"],["73A8E6A4-8EF8-5AD9-9AF9-9B8BAA48B7FA","فإنَّ أخلاء ابن زينبَ أصبحوا","شتات النوى منْ مصعدٍ ومفرعِ"],["3DD3776F-3C94-56DA-8274-41A76CE70A05","وكانوا كحيًّ قبلهمْ ذعذعتْ بهم","نوائبُ من أيام دهرٍ مذعذعِ"],["9A7855E7-F3DE-5D14-B181-91308966EDAC","فلما تبينتُ النعيَّ تبادرتْ","دموعي كسكب الواكف المتسرعِ"],["F9408A72-0771-5D98-8E1A-EBAEEBC301B3","بمحكولةٍ بالصاب ظلت كأنها","كلى الغرب أتاه طبابُ المرقعِ"],["3788A37F-5AFB-5354-93CA-4492E58410D6","على هالكٍ مستودعٍ قعرَ حفرةٍ","على جالها الأعلى مقامُ المشيعِ"],["79841F97-816B-52E2-B4C6-8666B6FA6492","فكيف سلمتمْ لمْ تموتوا وعهدكمْ","به وهو يذري عن أكفًّ وأنرعِ"]]},"A4C4A5D9-98A2-547D-A97A-0306097C2464":{"t":"أقول له والدمع مني كأنهُ","p":81,"s":"أقول له والدمع مني كأنه","r":"468179","v":[["508D0D5A-838F-584F-B92C-CDFA3E5BCB10","أقول له والدمع مني كأنهُ","جمانٌ وهي منْ سلكةِ متبادرُ"],["3FF7101C-912D-5981-B115-B2CA4CA5209F","ألا أيها الناعي ابنَ ينبَ غدوةً","نعيتَ الندى دارت عليكَ الدوائرُ"],["69587F7C-7545-5CCC-8D8D-C152D3C54F4B","لعمري لقدْ أمسى قرى الضيف عاتماً","بذي الفرشِ لما غيبتكَ المقابرُ"],["D7A73BA9-F8F5-5E90-9AC7-A6B0A326AB24","إذا سوفوا نادوا صداك ودونه","صفيحٌ وخوارٌ من الترب مائرُ"],["A1AA7FA6-B967-5DCC-A6B7-E2EBCF5E2DF4","ينادون منُ أمسى تقطعُ دونه","من البعد أنفاسُ الصدور الزوافرُ"],["1D68B0E8-CF1D-558B-9DDB-A99595603D13","فقومي اضرب عينيك ياهند لنْ تريْ","أباُ مثلهُ تسمو إليه المفاخرُ"],["BBDA49D4-A3B2-5D1B-A5E2-94495CB1DBF3","وكنتِ إذا فاخرت أسميتِ والداُ","يزين كما زان اليدين الأساورُ"],["F0442CF7-3A6D-5498-A820-C47D10CBAB7A","فإنْ تعوليه تشفِ يوم عويله","غليلك أوْ يعذركِ بالنوح عاذرُ"],["9A476506-E5CD-5808-BA46-185267F3ADD5","وتحزنكِ ليلاتٌ طولٌ وقدْ مضتْ","بذي الفرشِ ليلاتٌ تسرُّ قصائرُ"],["185F4361-5EAB-5264-BE3C-11F221C0EBA1","فلقاك ربُّ يغفر الذنب رحمةً","إذا بليت يومَ الحساب السرائرُ"],["D0321AD6-1950-5669-A22D-D40B9CA966C3","إذا ما ابن زاد الركب لمْ يمسِ ليلةُ","قفا صفرٍ لم يقربِ الفرشَ زائرُ"],["CEE91C93-AD13-58F4-B71E-8230E65AE266","وقدْ علمَ الأقوامَ أنَّ بناتهُ","صوادقُ إذْ يندبهُ وقواصر"]]},"6290FCB0-1018-5289-9FC7-059ACBF41620":{"t":"ألأا أيها الباكي أخاه وإنما","p":81,"s":"ألأا أيها الباكي أخاه وإنما","r":"468215","v":[["A8FB9399-419F-59E2-AFF4-BA4307FB750A","ألأا أيها الباكي أخاه وإنما","يبكى بيوم الفدفد الأخوانِ"],["0DDA637B-15C7-570A-A1F3-B7F6FA3A7AEF","أخي يوم أحجار الثمام بكيته","ولو حمَّ يومي قبلهُ لبكاني"],["42124371-45CA-56D5-AA5E-375FD789AB4C","تداعتْ به أيامهُ واخترمنهُ","وأبقينَ لي شجواً بكل مكان"],["B5FE284D-CF62-5397-862F-4408BE51C4F5","فليت الذي ينعى سليمان غدوةً","بكى عندَ قبري مثلها ونعاني"],["AB8529B2-50D1-5E32-8BB1-AD8D01485DC0","ولو قسمت في الجن والإنسِ لوعتي","عليهِ بكى منْ حرها الثقلانِ"],["99B56633-D016-5B8E-93EE-9366884E4DED","ولو كاننتِ الأيامُ تطلبُ فديةً","إليه وصرف الدهر ما ألواني"]]},"987DEEA5-9B02-5149-97B5-4C19D0CF604E":{"t":"ألا أبلغا أهل المخاضةِ أنّني","p":81,"s":"ألا أبلغا أهل المخاضة أنني","r":"468168","v":[["2B5D9F6A-2B6C-5F93-86B5-13E49CF828A2","ألا أبلغا أهل المخاضةِ أنّني","مقيمٌ بزوار آخر الدّهر معتمرْ"]]},"E1FA4054-6494-51EF-86A7-F2BD6581B44D":{"t":"ألا قدْ رابني ويريبُ غيري","p":81,"s":"ألا قد رابني ويريب غيري","r":"468148","v":[["32ABCB01-45F9-5B78-9D93-5186B021BC55","ألا قدْ رابني ويريبُ غيري","عشية حكمها حيفٌ مريبُ"],["2E78230F-5C2A-5655-90CB-77CD07566946","وأصبحتِ المودةُ عندَ ليلى","منازلَ ليس لي فيها نصيبُ"],["8AB3A382-5B3D-55ED-9FB7-77654E5A6E11","ذهبتُ وقدْ بدا لي ذاك منها","لأهجوها فيغلبني النسيبُ"],["BD023FED-921C-5CD5-A4CB-669616A4056B","وأنسى غيظ نفسي إن قلبي","لمن واددتُ فائتهُ قريبُ"],["E78A2C47-3FAC-5E85-A386-9C4DCC4A1470","فلا قلبٌ يبصرُ كل ذنبٍ","ولا راضٍ بغير رضاً غضوبُ"],["8CAFBEA9-0142-5D48-900B-A884005F9988","فدعها لستَ هاجيها وراجع","حديثك إنَّ شأنكما عجيبُ"]]},"DF1F0F2A-6DDE-5E3A-817E-A1F2E0D1B614":{"t":"ألمْ تروا أنَّ فتىً سيداً","p":81,"s":"ألم تروا أن فتى سيدا","r":"468203","v":[["F38485BE-20C3-5717-B5E3-A6BBAF74122C","ألمْ تروا أنَّ فتىً سيداً","راح على نعشِ بني مالك"],["2BBBFE12-5F22-5FB5-85EA-71E629BD194D","لا أنفسً العيشَ لمن بعده","وأنفسُ الهلكَ على الهالك"]]},"DD9AAA93-A212-5EF5-8F48-92595258C147":{"t":"أما لك أن تزور وأنتَ خلوُ","p":81,"s":"أما لك أن تزور وأنت خلو","r":"468174","v":[["A4E2C6B2-9453-5907-AF61-F997E473D15C","أما لك أن تزور وأنتَ خلوُ","صحيح القلب أختَ بني غفارِ"],["E2136594-EA40-5EFA-A1BB-70CCD71BBDB5","فما برحت تعيركَ مقلتيها","فتعطيك المنّية في استتارِ"],["B385734A-FD4D-5577-9E28-1D6E36F023CA","و تسهو في حديث القوم حتى","تبيّن بعض أهلك ما تواري"],["A23FCC1E-56B3-5339-B73B-2D294D82FAFB","فمت يا قلب ما بك من دفاعٍ","فينجيك الدفاع ولا فرار"],["2A93BFEC-E48E-594D-9C1E-A049C851D664","فلم أر طالباً بدمٍ كمثلي","أودّ وحسنَ مطلوب بثار"],["BC17D3B7-1C08-5FF2-8FB5-A9271A72677C","إذا ذكرا بثأري قلتُ سقياً","لثأري ذي الخواتم والسوار"],["C6ED213A-D7F7-59E3-B1F8-87D81829FD84","و ما عرفت دمي فتبوء منه","برهنٍ في حبالي أو ضمارِ"],["F0E29B52-4117-5362-81D2-597B80774DA7","وقد زعم العواذل أنّ يومي","و يومك بالمُحَصّب ذي الجمار"],["30CDE89B-D0AC-546B-BCD5-7362BEA5B078","منَ الأعباء ثم زعمتِ أنْ لا","و قلتِ لذي التنازع والتماري"],["C5814764-CAFD-57E7-A6CA-0B3BE5A14BBC","كذبتم ما السلامُ بقول زورٍ","ولا اليوم الحرام بيوم ثارِ"],["2783E7D1-6827-54A2-B2FA-000B6F3253A9","ولا تسليمنا حرماً بجرم","ولا الحبّ الكريم لنا بعارِ"],["7761F277-98E6-57D9-9801-AB58A3660F67","فإن لم نلقم فسقى الغوادي","بلادك والرّويّاتُ السواري"]]},"E0DF9F8F-846B-5CE9-A346-1A295D885EAE":{"t":"إذا افتقرَ المولى سعى لك جاهداً","p":81,"s":"إذا افتقر المولى سعى لك جاهدا","r":"468170","v":[["15E0604B-9F40-50A7-88F7-7F0E6D80BB10","إذا افتقرَ المولى سعى لك جاهداً","لترضى وإن تال الغنى عنك أدبرا"]]},"E6987A82-5F5A-5587-A912-7F736BEB3910":{"t":"إذا نزل ابن المصطفى بطنَ تلعةٍ","p":81,"s":"إذا نزل ابن المصطفى بطن تلعة","r":"468166","v":[["677B106E-F0F7-59EA-9DED-1E4BDA7CB9CC","إذا نزل ابن المصطفى بطنَ تلعةٍ","نفى جدبها واخضرّ بالغيث عودها"],["7F74473F-41FD-58DA-856F-79881B8C8E1F","وزيد ربيع النّاس في كل شتوةٍ","إذا اختلفتْ أنواؤها ورعودها"],["650878DE-FC08-535A-A013-62BD884FBF2C","حمولٌ لأشتات الدّيات كأنهُ","سراجُ الدجى إذ مارنتهُ سعودُها"]]},"0181A246-6DED-5219-98A5-6DF54C2079CD":{"t":"إني لأعجبُ مني كيف آفكهمْ","p":81,"s":"إني لأعجب مني كيف آفكهم","r":"468187","v":[["A48A8413-B20D-532E-A81B-E144409D9A26","إني لأعجبُ مني كيف آفكهمْ","أمْ كيفَ أخدع قوماُ ما بهم حمقُ"],["D739F12C-4B16-5DE9-BE51-556CED188B5F","أظلُّ في البيد ألهيهمُ وأخبرهمْ","أخبارَ قومٍ وما كانوا وما خلقوا"],["9720F9E1-6848-5DE0-AC30-6DC697848135","ولو صدقت لقلتُ القومُ قد قدموا","حينَ انطلقنا وآتى ساعةَ انطلقوا"],["0DE696F2-DA22-5CBC-9E1E-4E747DE82DB9","أمْ كيف تحرمُ أيدٍ لم تخنْ أحداً","سيئاً وتظفر أيديهم وقدْ سرقوا"],["B5E55DC0-D547-5FEC-8A75-85FBEEAF6007","ونرتمي البومَ حتى لا يكون لهُ","شمسٌ ويرمون حتى يبرقَ الأفقُ"],["13AE574D-EF41-55CE-9F0F-A4214F332536","يرمون أحورَ مخضوباً بغير دمٍ","دفعاً وأنتَ وشاحاً صيدكَ العلقُ"],["D7102178-59D0-5BD5-9FD2-0AADC10D97C7","تسعى بكلبين تبغيه وصيدهمُ","صيدٌ يرجى قليلاً ثم يعتنقُ"],["1345109A-0FEE-5423-8DFB-283CF712DBFD","ما زلت أحدرهمْ حتى جعلتهمُ","في أصلِ محنيةٍ ما إنْ لها طرقُ"],["57F4683B-DD62-5B65-93F8-08B9A7C84817","ولوْ تركتهمُ فيها لمزقهمْ","شيخا مزينةَ إنْ قالا انعقوا نعقوا"],["EDD1134B-FDDE-54AD-8522-17BBD5C346A3","إنْ كنتمُ أدباً جاريْ صديقكمُ","والدهرُ مختلفٌ ألوانه طرقُ"],["D15BF34A-0684-559D-9389-46A9CE226EE8","فمتعوني فإني لا أرى أحداً","إلا له أجلٌ في الموت مستيقُ"]]},"6120ABE4-1632-57CE-8397-A5E059A845D4":{"t":"باتتْ لعينكَ عبرةٌ وسجومُ","p":81,"s":"باتت لعينك عبرة وسجوم","r":"468213","v":[["838B47B0-FE4B-50C7-80A4-C35320D0C55E","باتتْ لعينكَ عبرةٌ وسجومُ","وثوبْ بقلبكَ زفرةٌ وهمومُ"],["4EDFE16C-6478-53F8-9A10-F6CFDD7D7D13","طيفٌ لزينتَ ما يزال مؤرقي","بعدَ الهدوَّ فما يكاد يريمُ"],["0F7DA8D5-1425-5D43-A2D2-53B54BD23A9A","وإذا تعرض في المنام خيالها","نكأ الفؤادَ خيالها المحلوم"],["9CDFA176-764D-5762-B1D2-AEB14F22FAF7","ُأجعلتِ ذنبكِ ذنبهُ وظلمتهِ","عند التحاكم والمدلُّ ظلومُ"],["64760729-93EA-57B9-AF81-26816C2DEFC1","ولئن تجنيتِ الذنوب فإنه","ذو الداء يعذر والصحيحُ يلومُ"],["ADA70DC7-900C-5360-8689-899ADD87DE88","ولقدْ أراك غداةَ بنتِ وعهدكمْ","في الوصل لا حرجٌ ولا مذمومُ"],["5EDE1231-06FE-5772-A3E4-4AEC090D6A22","أضحتْ تحكمكِ التجاربُ والنهي","عنهُ ويكفله بك التحكيمُ"],["D1AC21B3-F690-5446-ADC3-7EDC4406831A","برأ الألى علقوا الحبائل قبلهَ","فنجوا وأصبح في الوثاق يهيمُ"],["F1F81B3D-5B0A-53A3-9187-C116459A5A79","ولقد أردتُ الصبر عنكِفعاقني","علقٌ بقلبي منْ هواكِ قديمُ"],["974C62B0-35E6-5BE7-8958-77BF6DC6E141","يبقبى على حدث الزمان وريبهِ","وعلى جفائك إنه لكريمُ"],["7112BFE1-827D-5A1E-85BC-CF22B704A847","ضعفتْ معاهدُ حبهنَّ مع الصبا","ومع الشباب فبنَّ وهو مقيمُ"],["93E09AE7-4B40-5B9A-BA10-B1570D2C2A5A","وعتبتِ حين صححتِ وهو بدائه","شتان ذاك مصححٌ وسقيمُ"],["0CF246A7-B445-516E-8E7E-13716270D482","وأذيتهِ زمناً فعادَ بحمله","أنَّ المحبَّ عن الحبيب حليمُ"],["4465AB74-CC31-5EE5-9742-91D2C3B50AC0","وزعمت أنك تبخلن وشفهُ","شوقٌإلك وإنْ بخلتِ أليمُ"]]},"65208B0F-06E9-5CE2-AF17-BDB268259F03":{"t":"تثاقلتِ أنْ كنتُ ابن عمًّ نكحتهِ","p":81,"s":"تثاقلت أن كنت ابن عم نكحته","r":"468207","v":[["51F400AA-A2CD-5320-8223-23728E3CC8FA","تثاقلتِ أنْ كنتُ ابن عمًّ نكحتهِ","فملتِ وقدْ يشفى ذوو الرأي بالعذلِ"],["CEA22EBA-53CF-5098-91C6-FC69C1F71138","فإنكِ إلأا تتركي بعضَ ما أرى","تنازعكِ أخرى كالقرينة في الحبلِ"],["9155D85A-0E02-5038-9E44-C84507364915","تلزكِ ما اسطاعتْ إذا كان قسمها","كقسمكِ حقاً في التلاد وفي البعلِ"],["2672754B-A94E-5C39-AAF6-016CCACEAAC3","متى تحمليها منكِ يوماً لحالةٍ","فتبعها تحملكِ يوماً على مثلِ"]]},"C614FD38-6E64-5C5B-ABCB-073A4177AA60":{"t":"حرقَ يا صفاةُ في ذراكِ","p":81,"s":"حرق يا صفاة في ذراك","r":"468191","v":[["460E69D2-49E1-5106-A491-E3A9A70EB412","حرقَ يا صفاةُ في ذراكِ","بالنار إنْ لم تمنعي أرواكِ"],["42D5A522-DD37-5EB1-8055-F4A0663402D3","تعلمي أنَّ بذي الأراك","أيتها الأروى ذوي عراكِ"],["38DF805A-B461-5153-8DC1-EDD524E86F29","قوماً أعدوا شبكَ الشباك","يبغون ضبعاً قتلتْ أباكِ"],["3B9B557B-AD67-566B-8D28-6FB43FC5FE36","نعمَ ملوي الحيدِ المداكِ","إذا صوت الجالبُ في أخراكِ"],["4C9973A0-D9FD-5B86-8AFA-2D6BCC736901","ولم يقلْ منتصحاً إياكِ","بين مقاطيها ركبتِ فاكِ"],["F74C4CEB-66B3-5E9F-8C33-F0FF8F37B03F","فعدتُ والطعنُ على كلاكِ","مثل الأضاحي بيدِ النساكِ"],["74A1BCD5-E416-54A6-8AF9-4701B20BE0B0","يرمى بالاكتافِ على الأوراكِ","كما أطحتِ العبدَ عن صفاكِ"],["E5898F1C-EAB4-5DFF-8597-61B07664B08D","أما السيالي فلنْ ينساكِ","لوْ يرتميك الناس ما رماك"]]},"CB7C3320-6AED-5B14-9A5E-5BE637273931":{"t":"خليليَّ دلاني عباثرَ إنها","p":81,"s":"خليلي دلاني عباثر إنها","r":"468189","v":[["BEFC2152-5868-599D-BCBE-DBCBA4F4F6A8","خليليَّ دلاني عباثرَ إنها","يمرُّ على قيس بن سعيدٍ طريقها"],["0F317B4F-A5E4-535B-9653-C49E74F6E585","هدتنا لها مشبوبةٌ يهتدى بها","يضيءُ ذرا ذاتِ العظومِ حريقها"]]},"5D4F566B-FAED-5325-B866-68FCAC489D2A":{"t":"سبحان ربّك تبْ مما أتيت به","p":81,"s":"سبحان ربك تب مما أتيت به","r":"468156","v":[["F67ACCDB-AE4A-5DB0-A8E6-EF6F5B25E530","سبحان ربّك تبْ مما أتيت به","ما يسدد الله يصبحْ وهو مرتوجُ"],["8FFC8E8A-B8B7-57A2-8A41-B6F4408C30D9","وهل يسدّ وللحجّاج فيه إذا","ما صعّدوا فيه تكبير وتلجيجُ"],["7A9F49D5-ED03-5BC8-98D0-A8195FEBA5EB","ما زال مندُ أذَلّ اللهُ موطئهُ","و مندُ أذّن أنّ البيت محجوجُ"],["C847459F-BD01-5E03-B86E-A0F28AA379AA","يهدي له الوفد وفد الله مطربهُ","كأنه شطبُ بالقدّ منسوجًُ"],["B84F7EE4-ED99-5BC0-855E-786A4AAA3C71","خلّ الطريق إليها إنّ زائرها","و الساكنين بها الشّمّ الأباليجُ"],["CC6448A1-072F-5FCD-BCE4-88A9B3C293CD","لا يسدد الله نقباً كان يسلكه البيض","إليها ليل والهوجُ العناجيجُ"],["ADC7FDC8-C1D6-51A9-968B-2D255C42D521","لو سدّهُ الله يوماً ثمّ عجّ له","من يسلكُ النقبُ أمسى وهو مفروجُ"]]},"5DD63C62-8E20-5989-B921-1633A8D94CD0":{"t":"سقى الله أطلالاً بأكثبةِ الحمى","p":81,"s":"سقى الله أطلالا بأكثبة الحمى","r":"468220","v":[["F4894840-FF6D-517B-9DCD-B17D908DCD27","سقى الله أطلالاً بأكثبةِ الحمى","وإن كنَّ قدْ أبدين للناس ما بيا"],["F9FD4FB2-E9DD-556E-8741-E0186978B5EA","منازل لوْ مرت بهنَّ جنازتي","لقال الصدى يا حامليَّ أربعا بيا"]]},"A9636D5A-269F-543B-AAAD-8894DBE831C2":{"t":"شهدتُ غداة خصم بني سليمٍ","p":81,"s":"شهدت غداة خصم بني سليم","r":"468160","v":[["D95A5687-2C36-526C-BCD5-3F253CC89DA4","شهدتُ غداة خصم بني سليمٍ","وجوهاً منْ قضائك غير سودِ"],["2E1EA144-1CF0-53B3-A46A-17D35DEC1B0A","قضيتَ بسنةٍ وحكمتَ عدلاً","ولمْ ترثِ الحكومةَ منْ بعيدِ"],["5484FC9D-098F-58B2-AFF0-1B18C2C77439","إذا غمزَ القنا وجدت لعمري","قناتك حين تغمزُ خير عودِ"],["41763E2A-1A9D-5628-B8A3-2922EB21891A","إذاعضَّ الثقاف بها اشمأزتْ","إباء النقسِ بائنةَ الصعود"],["805E226C-E3BE-5242-AFE7-798364CAC2DC","حمى حدباً لحوم بنات قومٍ","وهم تحت التراب أبو الوليد"],["EF199F42-6651-52D3-8858-6F830B48ADFE","وفي المئتين للمولى نكالٌ","وفي سلبِ الحواجب والخدودِ"],["340BA864-9298-54DB-841E-F9ADCE7451C1","إذا كافاتهمْ ببناتِ كسرى","فهل يجدُ الموالي منْ مزيدِ"],["86EF68CD-6EE8-50D9-A20A-909F396C3434","فأي الحقَّ أنصفُ للموالي","من أصهار العبيد إلى العبيدِ"]]},"7737709E-7336-5987-8960-A118161EF5D1":{"t":"طلبتُ فلمْ أدركْ بوجهي وليتني","p":81,"s":"طلبت فلم أدرك بوجهي وليتني","r":"468146","v":[["CCCE4D7F-FCFF-5ACD-A336-8F1A9A3E6811","طلبتُ فلمْ أدركْ بوجهي وليتني","فعدتُ فلم أبغِ الندى بعد سائبِ"],["04E6430E-5EA9-5EA3-853D-787568243A60","ولو لجأَ العافي إلى رحلِ سائبٍ","ثوى غيرَ قالٍ أو غدا غيرَ خائبِ"],["4A1ED056-E02A-5175-BDCB-FFDD6983F11E","أقول وما يدري أناسُ غدوا به","إلى اللحدِ ماذا أدرجوا في السبائبِ"],["1BDA2B7D-1335-5507-B706-52C5E8E140A9","وكل أمريءٍ سيركب كارها","على النعشِ العدا والأقاربِ"]]},"9DEE6CAB-CB47-56DB-99C6-818F4285EE18":{"t":"ظللت لدى أبياتها وكأنني","p":81,"s":"ظللت لدى أبياتها وكأنني","r":"468199","v":[["22F1AB15-DE09-52B6-946D-B2938C9DFAB8","ظللت لدى أبياتها وكأنني","أسيرٌ معنى في مخلخلهِ كبلُ"],["23D7A3BF-43C4-5248-A693-4CBFACEE171A","أخيرُ إما جلسةٌ عند كارهٍ","وإما مراحٌ لا قريبٌ ولا سهلُ"],["C7C2E695-2010-5BB7-94C2-6D30FD6453F5","فإنكِ لو أكرمتِ ضيفكِ لم يعبْ","عليكِ الذي تأتين عمٌّ ولا بعلُ"],["93F1E8E2-C073-5201-A1F4-EF00E8605EE6","وقدْ كانَ ينميها إلى ذروةِ العلا","أبٌ لا تخطاه المطيةُ والرحلُ"],["430C1ECE-24E7-5AA7-A3D5-3B9CFA8C361D","فهلْ أنتِ إلاَّ جنةٌ عبقريةٌ ا","يخالط من خالطتِ من حبكم خبلُ"],["563CC738-D2EF-5314-AD9B-CF14BEE5B1E4","وهلْ أنتِ إلا نبعةٌ كان أصلها","نضاراً فلم يفضحكِ فرعٌ ولا أصلُ"],["4B64F0D0-895A-509F-BD56-C77437F6055D","صددتِ امرأً عنْ ظلَّ بيتك مَا لهُ","بواديكِ لو لا كمْ صديقٌ ولا أهلُ"]]},"FEFC0780-7B76-573F-B70C-A698407492E5":{"t":"كأني موفٍ للهلاكِ عشيةً","p":81,"s":"كأني موف للهلاك عشية","r":"468172","v":[["4498FD34-F75F-5FFC-845C-0B282B317676","كأني موفٍ للهلاكِ عشيةً","بأسفلِ ذاتِ القشع منتظر القطر"],["096B2B4C-431C-54C0-B936-157BB362B6E2","وأنّتنّ تلبسَ الجديدة بعدما","طردتُ بطيّ الوطبِ في البلقُ والقفرِ"],["45F4E42F-D7FA-51A5-9F9D-161735280C1A","فكان الذي قلتنّ أعدد بضاعةً","لتأخذ بيضاء الترائب والنّحرِ"],["09A79E00-C863-5DF4-A2F9-ABAC8DEF5CE2","كأنّ سموط الدّرّ منها معلقٌ","بجيداء في ضالٍ بوجرة أو سدرِ"],["C1D48D1B-C55C-504A-AA58-7EB5F016E1D8","تكون بلاغاً ثمّ لست بمخبر","إذا وديتْ لي ما وديتنّ ما أمري"]]},"1128894C-D16B-5F27-A7E2-AB6261DB5E94":{"t":"كفاني الذي ضيعتَ مني وإنما","p":81,"s":"كفاني الذي ضيعت مني وإنما","r":"468185","v":[["C41B5B9C-1A9C-55AE-AA91-702DE33792A4","كفاني الذي ضيعتَ مني وإنما","يضيع الحقوق ظالماً من أضاعها"],["E7E34A96-B718-57DD-A324-6F8200ACBC8A","صنيعةَ منْ ولاك سوءَ صنيعها","وولي سواكَ أجرها واصطناعها"],["89EE349D-432D-5F36-8BB1-AFABC3E33B74","أبى لك كسبَ الخير رأيٌ مقصرٌ","ونفسٌ أضاق الله بالخير باعها"],["A8D10EDB-6C18-5BC6-9B40-178283D20259","إذا هيَ حثنهُ على الخير مرةً","عصاها وإنْ همتْ بشرًّ أطاعها"],["C713CD64-DFF4-5F2A-9494-6439D4ED8BE7","فلولاَ رجالٌ كاشحونَ يسرهم","أذاكَ وقربى لا أحبُّ انقطاعها"],["D2D8F68D-D207-5D3D-86E8-EC854A7B0E3C","إذا كان إنْ زلتْ بك النعل زلةً","فراقُ خلالٍ لا تطيقُ ارتجاعها"],["6972EAC4-72DA-552E-BB17-53C077369DAC","وإني متى أحملْ على ذاك أطلعْ","إليكَ عيوناُ لا أحبُّ اطلاعها"],["54CB1F38-B6C0-5430-A737-594E854FBF77","فإنْ تكُ أحلامٌ تردُّ إخاءنا","علينا فمنْ هذا يردُّ سماعها"],["8D6528B1-9AA1-581A-B3BD-CF2ED1A3872C","سأنهاكَ نهياُ مجملاُ وقصائداُ","نواصح تشفي منْ شؤونٍ صداعها"],["D4DBF55B-BEBA-54B4-A968-B295D4F0BDFB","ومنْ يجتلبْ نحوي القصائدٌ يجتلبإذا ما الفتى ذو اللُّبِّ حَلَّتْ قصائدٌإليه فَخلَّ للقوافي رِباعَها","قراه ويتبع من يجب اتباعهاسقط بيت ص"]]},"72EED84B-C47A-5300-B446-5A899067B0E2":{"t":"لأنْ أزجي عند العري بالخلقِ","p":81,"s":"لأن أزجي عند العري بالخلق","r":"468227","v":[["C9087C57-A329-5D19-BEEC-3ACE8F8320A3","لأنْ أزجي عند العري بالخلقِ",",اجتزي منْ كثيرِ الزاد بالعلقِ"],["43B8F7B4-7297-5383-83CC-0E3F79ABA40B","خيرٌ وأكرمُ لي منْ أنْ أرى منناً","خوالداً للئام الناس في عنقي"],["5F01CE60-AEDC-5B43-8FBF-B93CD8921423","إني وإنْ قصرتْ عنْ همتي جدتي","وكان مالي لا يقوى على خلقي"],["7B990185-47CC-5549-8702-BE33159CEDC1","لتاركٌ كلَّ أمرٍ كان يلزمني","عاراً ويشرعني في المنهل الرنقِ"]]},"24DB2466-475D-55E7-B614-98D0E6FBD563":{"t":"لئن عانسُ قد شاب ما بين قرنها","p":81,"s":"لئن عانس قد شاب ما بين قرنها","r":"468152","v":[["9D8A4BE2-35DF-5A16-A491-567FA0F507E4","لئن عانسُ قد شاب ما بين قرنها","إلى كعبها وامتصّ عنها شبابها"],["7EF4A525-3BBD-5D33-BEF5-3BD1B04860E4","صبت في طلاب اللهو يوماً وعلقت","حجاباً لقد كانت ستيراً حجابها"],["A7BBCF7D-09E6-5934-98DA-6B6F672DE5EF","لقد متّعت في العيش حتى تمتعت","من اللهو إذ لا ينكر اللهو بابها"],["B5244BBF-1C4B-52C3-AAC0-866BA6819E8C","فبيني برغمٍ ثمّ ظلّي فربما","ثوى الزعمُ منها حيث يثوي نقابها"],["C7C9B150-F2AC-5DC1-9A77-88E9A20D130E","لبيضاء لم تنسب لجدّ يعيبها","هجانٍ ولم تنبح لئيماً كلابها"],["2C6D0B55-8DF0-5D7E-AA20-BB754BEF9AB8","تأوّد في الممشى كأنّ قناعها","على ظبيةٍ أدماء طابت ثيابها"],["DDE7BA9F-E4B5-50F0-A5C1-3F690390FF55","مهفهفة الأعطاف خفّاقة الحشا","جميلٍ محيّاها قليلٍ عتابها"],["2A3F610C-3BE3-5A46-A2C6-3DB48A06C2D0","إذا ما دعت بابني نزارٍ ونازعت","ذرا المجد لم يردد عليها انتسابها"]]},"9D3A94D7-9626-5FDF-BB7C-36EFC60E3F15":{"t":"لئنْ أقمتُ بحيثُ الفيضُ في رجبٍ","p":81,"s":"لئن أقمت بحيث الفيض في رجب","r":"468150","v":[["7C14DD83-FA92-5E6F-9CA3-6149934E56B5","لئنْ أقمتُ بحيثُ الفيضُ في رجبٍ","حتى أهلَّ به من قابلٍ رجبا"],["32942C57-EA77-54C6-AFEC-C0B907E45E59","وراح في السفرٍ ورادُ وهيجني","أنّ الغريب إذا هيجته طربا"],["1782D25E-7074-566F-AAE0-D193BB5C9278","إنّ الغريب يهيج الحزنُ صبوتهُ","إذا المصاحبُ حياهُ وقد ركبا"],["164D195A-C204-56A2-82BD-18293BDDCDBA","قد قلتُ أمسِ لواردٍ وصاحبه","عوجا على الخارجيّ اليوم واحتسبا"],["D883B2FD-873D-563F-9A1E-9D28C7B51F42","و أبلغا أمَّ سعد أنّ غائبها","أعيا على شفعاء الناس فاجتنبا"],["5CBA0E9B-ACB2-51FB-AC7E-CFA3CD62745C","لما رأريتُ نجيّ القوم قلتُ لهم","هل يعدونّ نجيّ القوم ما كُتبا"],["C30A5000-8DCF-5BD5-98EE-0B11CC7F06FE","وقلت إني متى أجلب شفاعتكم","أتدمْ وإنَّ أشقَّ الغيّ ما اجتلبا"],["24F36F16-C159-58C2-9BA0-A7B5D08C7C23","و إن مثلي متى يسمع مقالتكم","و يعرفِ العينَ ينزع قبلَ أنْ يجبا"],["E849135D-2793-5933-A507-D3603EF89E61","إني وما كبّر الحجّاج تحملهم","بزل المطايا بجنب نخلةِ عصبا"],["6C1E5EEF-4898-5406-A8BE-0CCEB453CDB5","و ما أهل به الداعي وما وقفتْ","عُليا ربيعة تزمي بالحصا الحصبا"],["39081A57-A411-5A60-9158-B520B64EB138","جهداً لمن ظنّ أنّي سوفَ أُّظعنها","عن ربع غانيةٍ أخرى لقد كذبا"],["1B8EFDDC-17A6-5001-A2D6-ED44556124C0","أأبتغي الحسن في أخرى وأتركها","فذاك حين تركتُ الدين والحسبا"],["699E52AC-7C82-57E2-8D23-9C14EBB7EF67","ولا انقضى الهمّ من سعدى وما علقتْ","منّي الحبائلَ رُمْتُها حِقبا"],["38463F40-CC43-56AB-A338-3E03A286028D","وما خلوت بها يوماً فتعجبني","إلا غدا أكثر اليومين لي عجبا"],["2834A55B-A53A-56FA-80F8-6A11B7382090","يا أيها السائلي ما ليس يدركهُ","مهلاً فإنك قد كلّفتني تعبا"],["98F1A7D3-8D4E-5A3C-BD35-18CD2723DEA0","كم من شفيع أتاني وهو يحسب بي","حسباً فأقصره من دون ما حسبا"],["61B6C1B1-0568-528D-8AB4-9B774D78891A","فإن يكن لهوها أو قرابتها","حبُّ قديم فما غابا ولا ذهبا"],["5BC19B9E-A18A-5AC5-97E4-C262210A122F","هما عليّ فإن أرضيتهما رضيت","عنيّ وإن غضبت في باطلٍ غضبا"],["341D6FB0-82D4-5562-93A1-FFB8E0940268","كائن ذهبتُ فردّاني بكبدهما","عمّا طلبتُ وجاءاها بما طلبا"],["1A6D4BFD-C419-5ADD-B79A-7B2B5C2BDD4E","وقد دهيتُ فلمْ أصبحْ بمنزلةٍ","إلا أنازع من أسبابها سببا"],["463D111D-DC15-5521-AC18-F2DD7A0F8034","ويل أمها خلةً لو كنت مُسْجِجحةً","أو كنتَ ترجعُ من عصريك ما ذهبا"],["847069C8-EEA9-5505-8258-826AF7D1B9DB","أنتِ الظعينهُ لا يرمى برمتها","ولا يفجعها ابنُ العم ما اصطحبا"]]},"EF949632-8FB8-50B7-A82B-69DA475F78E4":{"t":"لا تتبعن لوعةً إثري ولا هلعا","p":81,"s":"لا تتبعن لوعة إثري ولا هلعا","r":"468224","v":[["4C4D2BFC-CBAE-53A3-8C19-9DEAE79958D8","لا تتبعن لوعةً إثري ولا هلعا","ولا تقاسنَّ بعدي الهمَّ والجزعا"],["F43D55A1-0F50-55EF-88E6-1D2665A82126","بل آئتسي تجدي إن ائتسيتِ أسىً","بمثل ما قدْ فجعتِ اليوم قدْ فجعا"],["2171ED2E-3608-59C9-9FA3-B35F11CD5C83","ما تصنعين بعينٍ عنكِ طامحةٍ","إلى سواك وقلب عنك قد نزعا"],["F1B5A3C1-1025-5596-8111-DD13087C34F0","إنْ قلت قدْ كنتُ في ودًّ وتكرمهٍ","فقد صدقتِ ولكنْ ذاك قدْ منعِا"],["761EF1AF-5659-5A64-A2F4-58D3381A2141","وأي شيءٍ من الدنيا سمعت به","إلا إذا صار في غاياته انقطعا"],["2995D59B-ED38-5EC2-8AF5-655CCEE50126","لم تبقِ عيناً حسينٍ عندَ لحظهما","لغيرها في فؤادي بعدها طمعا"],["0AC971CA-95BD-534B-89EE-1EDDF171103F","ومنْ يطيقُ مذك عند صبوته","ومن يقومُ لمستورٍ إذا خلعا"]]},"952A762D-058B-5055-BFB0-566462D15367":{"t":"لعلك والموعود حق وفاؤه","p":81,"s":"لعلك والموعود حق وفاؤه","r":"468143","v":[["7BD98309-A5DC-548E-A91C-55216DB47EF5","لعلك والموعود حق وفاؤه","بد لك في ذاك القلوص بداءُ"],["0B5AE24F-3B59-5999-B6B9-AFCAF472659E","فإنَّ الذي ألقي إذا قال قائلٌ","من الناس هلْ أحستها لعناءُ"],["27BCC00D-A547-5112-9D4A-D001B8F0C66C","أقول لمنْ يبدي الشمات وقوله","علي وإشماتُ العدوّ سواءُ"],["C2F6422E-E1F7-54CC-B2BD-74996801195D","دعوتُ وقدْ أخلفتني الوأي دعوة","يزيدٍ فلمُ يضللْ هناكَ دعاءُ"],["76E86E50-F9E4-5CF0-8A8C-0F489348B0E9","بأبيضِ مثلِ البدر عظمَ حقهُ","رجالٌ منَ المصطفى ونساءُ"]]},"0659580F-5946-5FE8-B331-C61D53B725DD":{"t":"لوْ بينتْ لكَ قبلَ يوم فراقها","p":81,"s":"لو بينت لك قبل يوم فراقها","r":"468162","v":[["6732240A-7D84-5E00-BBF4-45E23E753DF2","لوْ بينتْ لكَ قبلَ يوم فراقها","أن التفرقَ منْ عشَّية أوْ غدِ"],["39D918C1-2121-5439-BCD2-014FE8C96C60","لشكوتَ إذْ علقَ الفؤاد بهائمٍ","علق حبائل هائم لم يعهدِ"],["EC2512DE-4B71-54B6-8000-66A32AD224D6","وتبرجتْ لكَ فاستبتك بواضحٍ","صلتٍ وأسود في النصيف معقدِ"],["90DD780D-D03F-5204-84B5-1B4E0476850C","بيضاءُ خالصةُ البياض كأنها","قمرٌ توسطَ ليل صيف مبردِ"],["4EF829A9-675C-5200-9E5C-6B5254D4301C","موسومة بالحسن ذات حواسد","إنَّ الجمال مظنةٌ للحسدِ"],["65422548-4132-55DC-81E6-64CDCA04F0D1","لم يطفها سرفُ الشباب ولمْ تضعْ","فيها معاهدَة النصيح المرشدِ"],["E3FFAAD4-0637-580F-8E49-49B72E743D19","خودٌ إذا كثر الكلام تعوذت","بحمى الحياءِ وإنْ تكلمْ تقصدِ"],["0F19518B-43DD-5222-9CDA-3D830E368EFB","وكأنَّ طعمَ سلافةٍ مشمولةٍ","تنصبُّ في إثر السواك الأغيدِ"],["7EEF4812-A4AF-5271-82F0-89DA3BD7669D","وترى مدامعها ترقرِق مقلةً","حوراءَ ترغبُ عنْ سواد الإثمدِ"],["2931950A-7190-564E-88F3-703679E497BD","ماذا إذا برزت غداة رحيلها","مِ الحسنِ تحتَ رقاقِ تلك الأبردِ"],["E1480C86-7CCF-5688-B787-F05CCB57E97D","ولدتْ بأسعدِ أنجمٍ فمحلها","ومسيرها ابداً بطلقِ الأسعدِ"],["0911740D-38EC-5C17-B18E-AB4A0992773E","اللهُ يصحبها ويسقي دارها","خضلُ الرباب سرى ولما يرعدِ"]]},"ABDD3E9A-AF13-5BB8-9C75-7A1C70EBDB56":{"t":"ماذا يكلفكَ الروحات والدلجا","p":81,"s":"ماذا يكلفك الروحات والدلجا","r":"468222","v":[["858B0895-9FC4-58E9-8FDA-2A397750DA3B","ماذا يكلفكَ الروحات والدلجا","البر طوراً وطورا تركب اللججا"],["73B76A6D-AD4C-55A4-96A7-DBFE2E621495","كمْ منء فتىً قصرت في الرزق خطوته","ألفيتهُ بسهام الرزقِ قدْ فلحا"],["4562D4D5-70AE-584F-89DE-9B650F7B30B8","لا تيأسنَّ وإنْ طالتْ مطالبةٌ","إذا استعنت بصبرٍ أنْ ترى فرجا"],["66036FFB-411F-59D9-97BD-9FC63459393C","إنَّ الأمور إذا انسدتْ مسالكها","فالصبر يفتح منها كلَّ ما ارتتجا"],["B11F0AF9-C2D9-507B-8C9F-93BE13EA3505","أخلقْ بذي الصبر أنْ يحظى بحاجته","ومدمنِ القرع للأبواب أنْ يلجا"],["0681A750-FFAE-5027-AEC5-20D0B69D7996","فاطلبْ لرجلكَ قبلَ الخطو موضعها","فمن علا زلقاً عنْ غرةٍ زلجا"],["75190184-E0EA-5CFD-A878-9BEC703E85E0","ولا يغرنكَ صفوٌ أنتَ شاربهُ","فربما كان بالتكدير ممتزجَا"],["4D0525D4-A302-5F46-9916-9DCD486A20EC","لا ينتج الناس إلا منْ لقاحهم","يبدو لقاح الفتى يوماً إذا نتجا"],["F4BD68B9-7AB1-5A50-9BEA-B787E1CEC5ED","لا يمنعنك يأسٌ منْ مطالبةٍ","فضيقُ السبل يوماً ربما انتهجا"]]},"39C7E9D6-20BF-5931-84A5-7762F5A39E96":{"t":"نعمَ الفتى فجعتْ بهِ إخوانهُ","p":81,"s":"نعم الفتى فجعت به إخوانه","r":"468209","v":[["9772DE22-E112-5777-888A-ABA47A9AD466","نعمَ الفتى فجعتْ بهِ إخوانهُ","يومَ البقيع حوادثُ الأيامِ"],["C9A70B91-7193-5BB0-8104-6CD18A7ABFE5","سهلُ الفناءِ إذا حللتَ ببابهِ","طلقً اليدين مؤدبً الخدامِ"],["15329783-3C6D-551F-9F02-0DA10B105D61","وإذا رأيت شقيقهُ وصديقهُ","لمْ تدْرأيهما ذوو الأرحامِ"]]},"EF202415-E26F-531C-A724-C2C8596C7C79":{"t":"وإني قدْ نصحتُ فلمْ تصدقْ","p":81,"s":"وإني قد نصحت فلم تصدق","r":"468205","v":[["57D29284-2BA0-5938-9170-4E3E4D921BE9","وإني قدْ نصحتُ فلمْ تصدقْ","بنصحي واعتددتَ فما تبالي"],["143982C4-B64C-5B6E-8E57-76ABC594B75A","أراني قدْ بدا لي أنَّ نصحي","لغيكَ واعتدادكَ في ضلال"],["B83A2706-5FFE-5383-8F6E-9052FDC8EEEE","فكم هذا أذودك عنْ قطاعي","كتذويد المحلاةِ النهالِ"],["05EDC659-38A1-5581-B394-92BAE9C29678","فلا تبغِ الذنوب علي واقصدْ","لأمركَ منْ قطاعٍ أوْ وصالِ"],["1A9B7712-E36D-52DD-AA9C-B060B66986C3","فسوف أري خلالك منْ تصافي","إذا فارقتني وترى خلالي"],["18BF77E9-75C9-5888-9188-2CC243E7D85F","وإنَّ جزاءَ عهدكَ إذْ تولي","بإنْ أغضي وأسكتَ لا أبالي"]]},"C525F42D-D63A-59A7-BD68-AC7B82B7D16E":{"t":"وايدي الهدايا ما رأيتُ معاتباً","p":81,"s":"وايدي الهدايا ما رأيت معاتبا","r":"468201","v":[["695EA802-26F3-5914-8722-7FB675F1768F","وايدي الهدايا ما رأيتُ معاتباً","من الناس إلا الساعدية أجملُ"],["B3F810DC-728B-5672-B910-86C6AE941D18","وقدْ أخطأتني يوم بطحاءِ معمر","لها كففٌ تصطادُ فيها واحبلُ"],["A4F80C8E-B017-564B-ACE2-D501896A5B59","وقدْ قال أهلي حين كنيتُ كنيةً","أبا الجون فاكسبْ مثلها حين ترحلُ"],["E7CF1036-076B-5352-96CC-C10B45D09455","وإنْ بات إيضاعي مسرةٍ","لكنَّ فما تسخطنَ في العيش أطولُ"]]},"E46F7160-6F83-5E00-8110-A4462DA29E74":{"t":"وقصيرةة الأيام ودَّ جليسها","p":81,"s":"وقصيرةة الأيام ود جليسها","r":"468211","v":[["F6C4B0D3-ADCD-50DF-9429-E85B07FB7223","وقصيرةة الأيام ودَّ جليسها","لو دامَ جلسها بفقدِ حميمِ"],["1B3099EE-BF81-5749-BDA4-09F33D746966","كلفٌ بها وبه قديمُ صبابةٍ","قدمتْ وما عهد الفتى بقديمِ"],["1CF17C29-26B1-53A6-98B7-5EA5B85D238A","منْ محذياتِ أخي الهوى جرع الأسى","بدلال غانتةٍ ومقلةِ ريمِ"],["0AF432CF-31B4-5128-A308-E0F27848B07A","صفراء منْ بقرِ الجواءِ كأنما","ترك الحياءُ بها رداع سقيمِ"]]},"5EDED08C-6213-50F6-ACFE-D7244555505E":{"t":"يأيها المتمني أنْ تكون فتىً","p":81,"s":"يأيها المتمني أن تكون فتى","r":"468197","v":[["DB2962D0-969A-5B2C-BDFC-FE43E92FAA86","يأيها المتمني أنْ تكون فتىً","مثل لبن ليلى لقدْ خلى لك السبلا"],["6A4AC5BB-CEA5-58E1-8FC1-E09D3DB8D8A5","إنْ ترحلِ العيس كي تسعى مساعيه","يشفقْ عليك وتعملْ دون ما عملا"],["DFD5F8E6-9B80-552E-A9D6-6A85E20A6B12","لوسرتَ في الناس أقصاهم وأقربهم","في شقةِ الأرض حتى يحرثوا الإبلا"],["CA5C4C70-3C85-5E7F-8FCB-F23A186AEB1A","تبغي فتىً فوق ظهر الأرض ما وجدوا","مثل الذي غيبوا في بطنها رجلا"],["B630671E-1E31-5E7A-8168-B0B557D61161","أعددْ ثلاث خصالٍ قدْ عرفنَ لهُ","هل سبَّ منْ أحدٍ أو سبَّ أو بخلا"]]},"D575AFCF-7300-586D-A82B-62402097E6B2":{"t":"يا أحسنَ النّاس لولا أنّ نائلها","p":81,"s":"يا أحسن الناس لولا أن نائلها","r":"468177","v":[["68D6CF3E-11CD-594F-B5F1-4D6F8721204F","يا أحسنَ النّاس لولا أنّ نائلها","قدماً لمن يبتغي ميسوراً عسرُ"],["3DED9849-1D88-5C43-BEB7-46D6BCBFD41A","وإنما دلُّها سحرُ لطالبهِ","وإنَّما قلبها للمشتكي حجرُ"],["45E600D9-86FE-5816-825A-67799F1AC66B","هلْ تذكرين كما لمْ أنس عهدكم","وقدْ يدوم لعهد الخلَّةِ الذكرُ"],["3E694D3A-0D87-56F4-B998-E665A65AC752","قولي وركبكِ قدْ مالتْ عمائمهم","وقد سقاهم بكأس السّكرة السفرُ"],["CD4EFEFE-1D60-5B35-B894-CF07F46C8E57","يا ليت أنِّي بأثوابي وراحلتي","عبدُ لأهلكِ هذا العام مؤتجرُ"],["63D89272-F127-53C8-8E4B-8F5644963294","وقد أطلتِ اعتلالاً دون حاجتنا","بالحجّ أمسِ فهذا الحلُّ والنّفرُ"],["F9CAC3D2-2E03-51BB-AE07-9F6666108B37","ما بال وأيكِ إذ عهدي وعهدكمُ","إلفان ليس لنا في الودّ مزدجرُ"],["719520FA-EF97-5987-AED1-5F0A087264F9","فكان حظّكَ منها نظرةً طرفت","إنسان عينك حتّى ما بها نضرُ"],["E4FDA87B-3D83-5D4D-B88D-EFCCCCE8A155","أكنت أبخل من كانت مواعده","ديناً إلى أجلٍ يرجى وينتظرُ"],["09D9C807-40A3-5B92-8A82-F2B9DC89CA1A","وقد نظرتُ وما ألفيتُ من أحدٍ","يعتاده الشوق إلاّ بدؤه النّظرُ"],["89067FAE-93D0-53F5-9F83-196BEC5CD0B3","أبقت شجىً لك لا ينسى وقادحةً","في أسود القلب لم يشعر به بشرُ"],["2B487978-6EB1-54B2-AE9A-63F816C347A3","جنيةٌ أو لها جن تعلّمها","رمي القلوب بقوس ما لها وترُ"],["C3290365-837C-5A37-9B20-5630EE54AC92","تجلو بقادمتي ورقاءَ عن بردٍ","حوّ المفاخر في أطرفها أشرُ"],["AF9AC4F9-CCB3-5812-99C0-EF74724588F9","خودٌ مبتلةٌ ريّا معاصمها","قدرُ الثياب فلا طولٌولا قصرُ"],["05DC1282-EFCB-5FF8-99DB-FFF8EADF4592","إذا مجاسدها اغتالت فواضلها","منها روادفُ فعماتٌ ومؤتزرُ"],["D7AAB716-FBBF-56E5-A0FA-61A667A453B8","إن هبت الريح حنت في تنسّيمها","كما يجاوب عود القينةِ الوترُ"],["039EC07C-C7BD-5789-B193-8F7CB5262B41","بيضاءُ تعشو بها الأبصارُ إن برزتْ","في الحج ليلة إحدى عشرة القمرُ"],["FB2F1977-9C1A-5E72-8E02-08A72D2DEDE0","ألا رسول إذا بانت يبلغها","عنَّا وإنْ تمسِ تؤلفْ بيننا المررُ"],["D3FEFA25-A92A-535E-BFD3-1D1EAF6591EC","أني بآيةِ وجدٍ قدْ ظفرتِ به","مني ولمْ يكْ في وجدي بكم ظفر"],["B9F421B9-AD84-5887-9436-BE662C48343B","قتيلُ يوم تلاقينا وأنَّ دمي","عنها وعمنْ أجارت منْ من دمي هدرُ"],["C5D3B668-13EF-59A8-AA59-A0126E450C4B","تقضينَ فيَّ ولا أقضي عليك كما","يقضي المليك على المملوك يقتسرُ"],["A708616C-68EB-512E-B3B9-0654DA8C16BC","إنْ كان ذا قدراً يعطيك نافلةً","منا ويعجزنا ما أنصفَ القدرُ"]]},"33FE29F1-8905-5A00-BAE3-9106FD159299":{"t":"يا ينَ الهشامين طراً حزتَ مجدهما","p":81,"s":"يا ين الهشامين طرا حزت مجدهما","r":"468181","v":[["C0FCA2FA-A3EF-5EC9-A132-14530ECDA4E9","يا ينَ الهشامين طراً حزتَ مجدهما","وما تخونه نقضٌ وإمرارُ"],["8AA6DDFF-C715-5654-9857-5E1F8BECDA36","لا تشمتنَّ بي الأعدادَ إنهم","بيني وبينك سماعُ ونظارُ"],["F1D7EF9B-06F5-5A2C-AAEC-163AE0C98516","وإنَّ شكريَ إنْ ردوا بغيظهمُ","في ذمةِ الله إعلانٌ وإسرارُ"],["E05FE7A9-7C7C-56D4-8495-EDBC4CA45D59","فاكررْ بنائلك المحمود منْ سعةٍ","علي إنك بلمعروفِ كرارَ"]]},"B8DF417F-49FB-5020-B3A9-AE341124AF5C":{"t":"يسعى لكَ المولى ذليلاً دقعاً","p":81,"s":"يسعى لك المولى ذليلا دقعا","r":"468195","v":[["777E21C6-9361-5248-966B-DC98ECE88268","يسعى لكَ المولى ذليلاً دقعاً","ويخذلكَ المولى إذا اشتدَّ كاهلهْ"],["34EF3893-5D45-55FB-B86F-6C11F5375CE4","فأمسكْ عليكَ العبدَ أول وهلةٍ","ولا تنفلنْ منْ راحتيكَ حبائلهُ"]]},"F38F09F9-FC11-533D-AF5E-6CE9A732EAF6":{"t":"يسعى لكَ المولى ذليلاً مدقعاً","p":81,"s":"يسعى لك المولى ذليلا مدقعا","r":"468193","v":[["FD52F248-FFD5-5D5B-936F-4E04210C0833","يسعى لكَ المولى ذليلاً مدقعاً","ويخذللكَ المولى إذاشتد كاهلة"],["C6AD68D7-9870-5728-981F-23F8E53782C7","فأمسكْ عليكَ العبدَ أولَ وهلةٍ","ولا تنفلتْ منْ راحتيكَ حبائلهُ"]]}}}