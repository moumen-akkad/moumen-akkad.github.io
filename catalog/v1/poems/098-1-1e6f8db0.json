{"v":1,"poems":{"74439586-9706-5433-9CA7-9DCB8234C006":{"t":"مَنْ نافَسَ النّاسَ لم يَسلَمْ من النّاسِ","p":98,"s":"من نافس الناس لم يسلم من الناس","r":"450396","v":[["F02452EE-440C-53AB-97A6-BEBFA1A118B2","مَنْ نافَسَ النّاسَ لم يَسلَمْ من النّاسِ،","حتى يُعَضّ بأنْيابٍ وَأضراسِ"],["B40D7203-8F80-594D-8673-AA3CC797FA24","لاَ بأسَ بالمرءِ مَا صحَّتْ سَرِيرتُهُ","مَا النَّاسُ إلاَّ بأهْلِ العِلْمِ والنَّاسِ"],["99CDD1E5-806B-50EF-B2CC-A0DC5CA75568","كاسَ الألى أخذُوا لِلْمَوْتِ عُدَّتَهُ","وَما المُعِدّونَ للدّنْيا بأكْياسِ"],["E5F6CBE4-7BA7-53D5-907E-2EB7942BC291","حتَّى متَى والمنَايَا لِي مخاتِلةٌ","يَغُرّني في صُرُوفِ الدّهرِ وَسْوَاسِي"],["B9555F72-3B22-5FAB-9DE4-68ACD7F6AE11","أينَ المُلُوكُ التي حُفّتْ مَدائِنُها،","دونَ المَنَايا، بحُجّابٍ وحُرّاسِ"],["184F455A-0245-5247-9841-31631DF6A090","لقدْ نسيتُ وكأْسُ الموتِ دائرةٌ","في كفِّ لا غافلٍ عنها ولا ناسي"],["0D204E87-227D-5B03-AAEA-3CD4A18ED60B","لأشربنَ بكأسِ الموتِ منجدِلاً","يوماً كمَا شرِبَ الماضُونَ بالكاسِ"],["846F8B47-985C-536B-8AAE-0AEF7C40B38D","أصْبَحْتُ ألعَبُ والسّاعاتُ مُسرِعَةٌ","ينقصنَ رزقِي ويستقصينَ أنفاسِي"],["E358C100-21C3-5B63-A257-1570B143AFCD","إنّي لأغْتَرّ بالدّنْيا وَأرْفَعُهَا","مِن تحتِ رِجليَ، أحياناً، على رَاسِي"],["D0BC4D60-6EA1-5895-AE37-97D0EB1B4A93","ما استعبدَ المرءَ كاستِعْبادِ مطمعهِ","ولاَ تسلَّى بمثلِ الصَّبْرِ واليَاسِ"]]},"85AE7B86-1723-52AD-8598-389D7BC84692":{"t":"مَنْ يعشْ يكبرْ ومنْ يكبَرْ يمُتْ","p":98,"s":"من يعش يكبر ومن يكبر يمت","r":"450359","v":[["1630CE91-C491-5621-A426-C06F09CD4F59","مَنْ يعشْ يكبرْ ومنْ يكبَرْ يمُتْ","والمَنايا لا تُبالي مَنْ أتَتْ"],["9E3619E1-25E6-524F-AAF1-310A778CEF77","كم وكم قد درَجتْ، من قَبلِنا،","منْ قرونٍ وقُرُونٍ قَدْ مضتْ"],["CAA550DC-9405-5F29-A4BD-983866EFA9C1","أيّها المَغرورُ ما هذا الصِّبَا؟","لَوْ نهيتَ النفْسَ عَنْهُ لانْتَهتْ"],["B6FCCB68-1D94-5D03-ACEA-D3AD0BF9203B","أنِسِيتَ المْوتَ جَهْلاً والبِلَى","وسَلَتْ نفْسُكَ عَنْهُ ولَهَتْ"],["A4FC95BA-1FF0-54EA-A7EC-BB9D0797E1C7","نحنُ في دارِ بَلاءٍ وأذًى،","وشَقَاءٍ، وعَنَاءٍ، وعَنَتْ"],["5190B2EC-A6E8-510E-9E6E-F7DAFC985781","مَنْزِلٌ ما يَثبُتُ المَرْءُ بِهِ","سالماً، إلاّ قَليلاً إنْ ثَبَتْ"],["C257CBB1-DB94-5080-B9FD-79B77FCA6A3B","بينمَا الإنسانُ فِي الدُّنيا لَهُ","حرَكاتٌ مُقلِقاتٌ، إذْ خَفَتْ"],["A4EC466F-CE95-5A19-A722-6B148609C41F","أبَتِ الدّنْيَا على سُكّانِها،","في البِلى والنّقصِ، إلاّ ما أبَتْ"],["C30F3E5A-9C00-50D3-8A4A-761BFA83A1F2","إنّما الدّنْيا مَتاعٌ، بُلغةٌ،","كَيفَما زَجّيْتَ في الدّنيا زَجَتْ"],["AA73DCCE-4643-5736-AD05-2E8AC954D039","رحمَ اللهُ امرءاً انصفَ مِنْ","نَفسِهِ، إذ قالَ خيراً، أوْ سكَتْ"]]},"80E8C5B5-357B-57AC-A1B4-94298BED6CD4":{"t":"نامَ الخليُّ لأنه خِلْوُ","p":98,"s":"نام الخلي لأنه خلو","r":"450491","v":[["9CD5B0FA-4E05-5A0D-8C60-FBEA69F5295D","نامَ الخليُّ لأنه خِلْوُ","عمَّنْ يؤرِّقُ عينَهُ الشجوُ"],["BFBFC9D2-035E-599A-837E-40D52EC306D8","ما إنْ يَطيبُ لذي الرّعايَةِ للـ","ـأيّامِ لا لَعِبٌ، وَلا لَهْوُ"],["2A5A2489-F2BA-5BA4-983D-9761E2200DBE","إذْ كانَ يُسرِفُ في مَسَرّتِهِ،","فيَموتُ، من أعضائِهِ جَزْوُ"],["EFE6BCDB-A22C-5AA2-8DDF-5B544465AFC4","وإذا المشيبُ رمَى بوهنتهِ","وهَتِ القُوَى وتقاربَ الخطوُ"],["B0835713-68C5-57AD-AEA4-D50FDE2196C3","وَإذا استَحالَ بأهْلِهِ زَمَنٌ،","كثُرَ القَذى، وَتكَدّرِ الصّفوُ"]]},"E40BFBE5-D2B7-5B13-9C9A-B70FF1EF3C49":{"t":"نسيتُ الموتَ فيمَا قدْ نسِيتُ","p":98,"s":"نسيت الموت فيما قد نسيت","r":"450358","v":[["9AB51415-8458-5593-931D-331A756BCB4F","نسيتُ الموتَ فيمَا قدْ نسِيتُ","كأنّي لا أرَى أحَداً يَمُوتُ"],["F53D7866-85A7-58FB-9B3A-2C9D4E39ADC2","أليسَ الموْتُ غايةَ كلّ حيٍّ،","فَمَا لي لاَ أُبادِرُ مَا يفوتُ"]]},"08E7D9F2-0C28-5242-9D30-D42E48ECA72C":{"t":"نهنهْ دموعَكَ كُلُّ حيٍّ فانِ","p":98,"s":"نهنه دموعك كل حي فان","r":"450473","v":[["6E29C784-5747-5511-8A5A-36613BA335C6","نهنهْ دموعَكَ كُلُّ حيٍّ فانِ","واصبر لقرعِ نوائبِ الحدثانِ"],["1DFFCEB3-7BC2-5EEF-844C-4C76B01A99D1","يا دارِيَ الحَقَّ التي لم أبْنِهَا","فيما أُشيدُهُ من البنيانِ"],["972AFE97-C24C-5FCE-957D-6D633692F469","كيفَ العزاءُ ولا محالةَ إنني","يَوْماً، إلَيكِ، مُشَيٌّع إخوَاني"],["C91AF041-1359-5147-9C38-3F3C90A01C69","نَعْشاً يُكَفْكِفُهُ الرّجالُ، وَفَوْقَه","جسدٌ يُباعُ بأوكسِ الأثمانِ"],["C0F44524-A83D-5D8E-ACAA-A391ACC3AD83","لولا الإلهُ وإنَّ قلبي مؤمنٌ","واللهُ غيرُ مُضيعٍ إيمانِي"],["8BF24388-53A4-5A0C-8FFF-BE44B27DFF28","لَظَنَنْتُ، أوْ أيْقَنتُ عندَ منيّتي،","أنّ المَصِيرَ إلى مَحَلّ هَوَانِ"],["A7F240F4-58F1-54FF-813E-8D62643D4444","فبنورِ وجهكَ يا إلهَ مراحمٍ","زَحْزِحْ إلَيكَ، عنِ السّعيرِ، مكاني"],["A9CD12B8-DFCC-57A3-A8AD-9D81D82FED2F","وامنُنْ عليَّ بتوبةٍ ترضَى بهَا","يا ذَا العُلَى والمنِّ والإحسانِ"]]},"27A0031D-881C-567A-B7D1-69049C51E398":{"t":"نو الحكمة يخوضُ أُناسٌ في الكَلامِ ليُوجزُوا","p":98,"s":"نو الحكمة يخوض أناس في الكلام ليوجزوا","r":"450392","v":[["DC0D053A-A92D-58FE-8CE9-A0B99869DF20","نو الحكمة يخوضُ أُناسٌ في الكَلامِ ليُوجزُوا،","وللصَّمتُ في بعضِ الأحايينِ أوجَزُ"],["6EC520C0-3D02-5A94-B618-B9341A3F0727","فإنْ كنتَ عنْ أن تحسنَ الصمتَ عاجزاً","فأنتَ، عنِ الإبلاغِ في القوْلِ، أعجَزُ"]]},"76DEDBEB-62D9-5B6A-A432-B52DFA305084":{"t":"نَسألُ اللّهَ بِما يَقضِي الرّضَى","p":98,"s":"نسأل الله بما يقضي الرضى","r":"450409","v":[["7FCAECC4-8825-507E-A1EC-CE2977B18799","نَسألُ اللّهَ بِما يَقضِي الرّضَى،","حَسْبَيَ اللهُ بِمَا شاءَ قَضَى"],["6709CF39-2FB4-59AB-8363-92A084550313","قَد أرَدْنَا، فأبَى اللّهُ لَنَا،","وأرَادَ اللهُ شيئْاً فمضَى"],["7D279BA2-1A93-51C7-B6A4-6A0DBA812D21","ربَّ أمرٍ بِتُّ قدْ أبرَمْتُهُ","ثُمَّ مَا أصْبَحْتُ إلاَّ فانقَضَى"],["FA40A40C-3673-551E-A3E2-3E089103D081","كمْ وكمْ من هَنَةٍ مَحقُورَةٍ،","ترَكَتْ قَوْماً كَثيراً أمْرَضَا"],["9A3977A1-0F22-5DC7-994B-84D15E141878","رُبَّ عَيْشٍ لأنَاسٍ سلَفُوا","كانَ ثُمَّ انقرَضُوا أوْ قُرِضَا"],["EA4F4419-85A5-5324-AA60-E9638BFEED4D","عَجَباً للمَوْتِ مَا أقْطَعَهُ،","مَا رَأيْنَا ماتَ رُفِضَا"],["30B31EE4-949D-527A-90DC-DCA597B405D1","رُفِضَ المَيّتُ مِنْ ساعَتِهِ،","وَجَفَاهُ أهْلُهُ حينَ قَضَى"],["A75E82B6-DE60-583C-BAFD-EE169159B891","شَرُّ أيّامي هوَ اليَوْمُ الذي","أقْبَلُ الدّنْيَا بديني عِوَضَا"]]},"24224117-653D-5DE0-94C6-A72545CF6A45":{"t":"نَسيتُ مَنيّتي وَخدعتُ نَفسي","p":98,"s":"نسيت منيتي وخدعت نفسي","r":"450393","v":[["48BA1337-D5DD-5555-99D2-27D8B2C973A7","نَسيتُ مَنيّتي، وَخدعتُ نَفسي،","وَطالَ عَليّ تَعمِيري، وغَرْسِي"],["6B649728-1079-5329-9C9A-27EB54291B40","وكُلُّ ثمينةٍ أصبحتُ أغلِي","بها ستُباعُ من بعدي بِوكْسِ"],["A430A402-B2FB-5C20-8C28-48F4619E28EA","وَما أدري، وإنْ أمّلتُ عُمراً،","لعَلّي حينَ أُصْبحُ لَستُ أُمْسِي"],["2552913B-9B44-5608-854C-242F1108C6F9","وَساعَةُ مِتَتي، لا بُدّ مِنها،","تُعَجّلُ نُقلَتي، وتُطيلُ حَبسِي"],["3AEF24F6-5F60-508E-8E2C-B41BF0AA3AC1","أموتُ ويكرهُ الأحبابُ قُربِي","وتَحضَرُ وَحشتي، ويَغيبُ أُنسِي"],["D3CA9267-F9A5-5C72-A792-0E6673169D73","ألا يا ساكنَ البيتِ الموشَّى","ستُسكِنُكَ المَنِيّةُ بَطنَ رَمسِ"],["F9C37FF1-8AFB-55DC-92F4-03DB067AC04D","رَأيْتُكَ تَذْكُرُ الدّنْيا كَثيراً،","وَكَثرَةُ ذِكْرِها للقَلْبِ تُقْسِي"],["AB2C6C8B-ACD9-59A7-B91D-7D85E26AB58B","كأنّكَ لا تَرَى بالخَلْقِ نَقْصاً","وأنتَ تراهُ كُلَّ شروقِ شمسِ"],["DE18355B-7B78-5E8E-8BCC-ECD4EA3AFBFA","وطالِبِ حاجَةٍ أعْيَا وَأكْدَى","ومُدركِ حاجةٍ في لينِ لمسِ"],["1E4F4BD6-6E7D-5D44-97A8-B5EC7E874A1D","ألا وَلَقَلّ ما تَلْقَى شَجِيّاً","يُسيغُ شَجَاهُ إلاّ بالتّأسّي"]]},"F2B96E80-8E12-5AFB-8E74-FC5D10D8C327":{"t":"نَصَبْتُ لَنَا دونَ التَّفَكُّرِ يَا دُنْيَا","p":98,"s":"نصبت لنا دون التفكر يا دنيا","r":"450345","v":[["EC8A9562-83BE-544B-A20C-599478797706","نَصَبْتُ لَنَا دونَ التَّفَكُّرِ يَا دُنْيَا","أمَانِيَّ يَفْنَى العُمْرُ مِنْ قبلِ أن تَفْنَى"],["FB1EB949-42F5-52EE-A5B5-2905C01F17AF","مَتَى تنقَضِي حَاجَاتُ مَنْ لَيْسَ وَاصِلاً","إلى حاجَةٍ، حتى تكونَ لهُ أُخرَى"],["2D5426AF-709D-5BB1-A1DE-C511F6726A8B","لِكُلِّ امرىءٍ فِيَما قَضَى اللهُ خُطَّةٌ","من الأمرِ، فيها يَستَوي العَبدُ والموْلى"],["CF4945DF-C89C-5C04-B7EE-09D96B96970C","وإنَّ أمرءًا يسعَى لغَيْرِ نِهَايةٍ","لمنغمِسٌ في لُجَّةِ الفَاقةِ الكُبْرَى"]]},"63F7AAD7-4BC4-5FD0-8078-DAE975815B40":{"t":"نَمُوتُ جَميعاً كُلّنا غيرَ ما شكِّ","p":98,"s":"نموت جميعا كلنا غير ما شك","r":"450447","v":[["4B4906B8-9A8F-5DDF-BD92-30066DEBA4E2","نَمُوتُ جَميعاً كُلّنا، غيرَ ما شكِّ،","وَلا أحَدٌ يَبقَى سِوى مالِكِ المُلْكِ"],["BC03C3D0-48BD-51E6-929E-79DEA5B46D6C","أيا نفسُ أنتِ الدهرَ في حالِ غفلةٍ","وليستْ صروفُ الدهرِ غافلةً عنكِ"],["E1544978-3029-5B57-B920-6B31F609AE50","أيا نفسُ كمْ لي عنكِ منْ يومِ صرعةٍ","إلى اللّهِ أشكُو ما أُعالجُهُ مِنْكِ"],["D7834C06-CF7F-5890-8DB1-9748725571DF","أيا نفسُ إن لمْ أبكِ ممَّا أخافهُ","عليكِ غَداً عندَ الحسابِ فمن يَبكي"],["2E580698-0E92-5FAE-B1A5-02130FE4AA5E","أيا نفسُ هذي الدارُ لا دارُ قلعةٍ","فلا تجعَلِنّ القَصْدَ في منزِلِ الإفْكِ"],["E6CB4067-4550-5533-8A5A-BA33C7FE10B4","أيا نفسُ لا تنسي عنِ اللهِ فضلهُ","فتأييدُهُ مُلكي، وَجِذْلانُهُ هُلكي"],["719A5905-DFEE-5178-B3DE-A0CFA2C252FA","وَلَيسَ دَبيبُ الذَّرّ فوْقَ الصَّفاةِ، في","الظلامِ بأخفى من رياءٍ ولا شركِ"]]},"3C732CC7-0750-5142-8D18-B30327FE7B48":{"t":"نَنْسَى المَنَايَا على أنّا لَهَا غَرَضُ","p":98,"s":"ننسى المنايا على أنا لها غرض","r":"450405","v":[["A8129690-2594-55AA-8877-62A2B9337122","نَنْسَى المَنَايَا على أنّا لَهَا غَرَضُ،","فَكَمْ أُنَاسٍ رَأَيْنَاهُمْ قَدِ انقَرَضُوا"],["8B3FF4BC-AE9B-5AD5-A258-460CCFF2CCDB","إنّا لَنَرْجُو أُمُوراً نَسْتَعِدّ لهَا،","والموْتُ دونَ الَّذِي نرْجُو لمعترضُ"],["D31D3EB7-4FA5-5950-87AA-4721573197C3","للّهِ دَرُّ بَني الدّنْيا لَقَدْ غُبِنُوا","فِيمَا اطْمانُّوا بهِ منْ جهْلِهِمْ ورضُوا"],["D96EADC1-BE20-51BF-B102-3F9709AAE9C9","مَا أرْبَحَ اللهُ فِي الدُّنيا تجارَةَ إنْـ","ـسانٍ يَرَى أنّها مِنْ نَفسِهِ عِوَضُ"],["48327CBC-D952-5831-8D35-52F64CE17A7D","فَليْسَتِ الدَّارُ داراً لاَ تَرَى أحداً","من أهلِها، ناصِحاً، لم يَعدُهُ غَرَضُ"],["85670A1E-99BB-5A78-8E4B-C91928FAD4CC","مَا بالُ مَنْ عرَفَ الدُّنْيَا الدَّنيَّةُ لاَ","يَنكَفّ عن غَرَضِ الدّنيا ويَنقَبِضُ"],["536BDCE7-65B2-518A-B94E-7BFBFC2623E4","تَصِحّ أقْوالُ أقوامٍ بوَصْفِهِمِ،","وَفِي القُلُوبِ إذا كشَّفْتَهَا مَرَضُ"],["CE8C4CDA-2CD4-5F88-B868-E596756DAC5C","والنَّاسُ فِي غَفْلَةٍ عَمَّا يُرَادُ بِهِمْ","وكُلُّهُمْ عنْ جَديدِ الأرْضِ منقرضُ"],["17331C1A-2760-57AD-97F8-006E577C4741","والحادِثَاتُ بِهَا الأقْدارُ جارِيةٌ","وَالمَرْءُ مُرْتَفعٌ فيها، وَمُنخَفِضُ"],["BBF5AEED-4F51-5DB3-A5C8-F4DA71B8B5C2","يَا ليْتَ شعري وقَدْ جَدَّ الرَّحيلُ بِنَا","حَتَّى متَى نحْنُ فِي الغُرَّاتِ نرْتكِضُ"],["B0ED3690-CF94-55BE-B395-18351E9E5158","نفسُ الحكيمُ إِلَى الخيرَاتِ ساكِنَةٌ","وَقَلبُهُ مِنْ دَواعي الشّرّ مُنقَبِضُ"],["FFDB3CDC-1817-5A07-B525-00F1EF46C004","اصْبِرْ عَلَى الحقِّ تستعذِبْ مغبَّتَهُ","وَالصّبرُ للحَقّ أحياناً لَهُ مَضَضُ"],["0470310E-3F43-549B-A3B8-4E1ED61C8DA5","ومَا استرَبْتَ فَكُنْ وقَّافَةً حذراً","قد يُبرَمُ الأمرُ أحْياناً فيَنتَقِضُ"]]},"CB4647B2-D914-5D13-B777-1EF7CBC1FEAA":{"t":"هوَ المَوْتُ فاصْنَعْ كلَّ ما أنتَ صانعُ","p":98,"s":"هو الموت فاصنع كل ما أنت صانع","r":"450423","v":[["8D77ACC9-0716-5BFD-9883-9D70A3432FDF","هوَ المَوْتُ، فاصْنَعْ كلَّ ما أنتَ صانعُ،","وأنْتَ لِكأْسِ المَوْتِ لاَ بُدَّ جارِعُ"],["C5CD72B1-2083-5F61-A559-0BCF1BC52293","ألا أيّها المَرْءُ المُخادِعُ نَفسَهُ!","رُويداً أتَدْرِي مَنْ أرَاكَ تخَادِعُ"],["3A0CF64B-4144-5A80-98A7-9509F94675F9","ويا جامِعَ الدُّنيا لِغَيرِ بَلاَغِهِ","سَتَتْرُكُهَا فانظُرْ لِمَنْ أنْتَ جَامِعُ"],["B0AFB766-6D24-5F39-9B5B-09D06567DF52","وَكم قد رَأينا الجامِعينَ قدَ اصْبَحَتْ","لهم، بينَ أطباقِ التّرابِ مَضاجعُ"],["63B93864-F712-5F7A-B1B9-376D17C81D04","لَوْ أنَّ ذَوِي الأبْصَارِ يَرَعُوْنَ كُلَّمَا","يَرَونَ، لمَا جَفّتْ لعَينٍ مَدامِعُ"],["C6BFF857-EEE2-5343-AAEC-5149EA389AA0","فَما يَعرِفُ العَطشانَ مَنْ طالَ رِيُّهُ،","ومَا يَعْرِفُ الشَّبْعانُ مَنْ هُوَ جائِعُ"],["AD0F612F-7A82-54FF-B8CF-DCFC3DA49D86","وَصارَتْ بُطونُ المُرْملاتِ خَميصَةً،","وأيتَامُهُمْ منهمْ طريدٌ وجائعُ"],["5DFBCB40-5EAB-542B-88A2-2F80B0A7A662","وإنَّ بُطُونَ المكثراتِ كأنَّما","تنقنقُ فِي أجوافِهِنَّ الضَّفَادِعُ"],["B577F1D3-50DD-52B0-A4FA-4C74A7B38F8F","وتصْرِيفُ هذَا الخَلْقِ للهِ وَحْدَهُ","وَكُلٌّ إلَيْهِ، لا مَحَالَةَ، راجِعُ"],["7A2D299A-7694-5FC1-A333-B45D1872B1A4","وللهِ فِي الدُّنيَا أعَاجيبُ جَمَّةٌ","تَدُلّ على تَدْبيرِهِ، وبَدَائِعُ"],["D456EE35-2FE9-599E-B56C-92B0151F56B4","وللهِ في أسرارُ الأمُورِ وإنْ جَرَتْ","بها ظاهِراً، بَينَ العِبادِ، المَنافِعُ"],["3244AE77-22CC-5E0B-9447-F63319C9D926","وللهِ أحْكَامُ الْقَضَاءِ بِعِلْمِهِ","ألاَ فهوَ معْطٍ مَا يَشَاءُ ومَانِعُ"],["94AB69D4-5CE3-5B8D-A3AE-C122DC5E0BF1","إذا ضَنّ مَنْ تَرْجو عَلَيكَ بنَفْعِهِ،","فذَرْهُ، فإنّ الرّزْقَ، في الأرْضِ، واسعُ"],["6ECC8E9B-C862-56D1-9152-5D9972752B50","وَمَنْ كانَتِ الدّنْيا هَواهُ وهَمَّهُ،","سبَتْهُ المُنَى واستعبدَتْهُ المَطَامِعُ"],["7AD4B006-2F86-5ABA-A4B4-E2D400E395DD","وَمَنْ عَقَلَ استَحيا، وَأكرَمَ نَفسَه،","ومَنْ قَنِعَ استغْنَى فَهَلْ أنْتَ قَانِعُ"],["A850A227-76A6-529B-8D15-8B4D48B70380","لِكلِّ امرِىءٍ رأْيَانِ رَأْيٌ يَكُفّهُ","عنِ الشّيءِ، أحياناً، وَرَأيٌ يُنازِعُ"]]},"736624EB-174C-5E57-BF1D-5656BD16317E":{"t":"هُوَ التنقُّلُ من يومٍ إلى يومِ","p":98,"s":"هو التنقل من يوم إلى يوم","r":"450461","v":[["231C9F5B-9C79-5F1A-B70D-54FDBD708B69","هُوَ التنقُّلُ من يومٍ إلى يومِ","كأنّهُ ما تُريكَ العَين في النّوْمِ"],["E0D099BC-AA08-5AF4-84F0-52AD86EED2D6","إنَّ المنايَا وإن أصبحت في لعبٍ","تحومُ حولكَ حوماً أيَّما حومِ"],["6559434F-6F1D-5B06-95E9-DCF174C00C8A","وَالدّهرُ ذو دُوَلٍ، فيهِ لَنا عَجَبٌ،","دنيا تنقَّلُ من قومٍ إلى قومِ"]]},"6411FC7F-0FAB-5F9D-9D23-484E86CE13B8":{"t":"وإذا انقضَى هَمُّ امرىءٍ فقد انقضَى","p":98,"s":"وإذا انقضى هم امرىء فقد انقضى","r":"450363","v":[["06C6F94D-D480-5F11-94F1-0245D2AE7B8D","وإذا انقضَى هَمُّ امرىءٍ فقد انقضَى،","إنَّ الهُمُومَ أشَدُّهُنَّ الأحْدَثُ"]]},"9CF25F76-B960-5BF6-B625-A34A16E6FBF3":{"t":"وَإنّي لمُشْتاقٌ إلى ظِلّ صاحِبٍ","p":98,"s":"وإني لمشتاق إلى ظل صاحب","r":"450488","v":[["7BE55FDE-5D7E-5C84-84E4-B7669CB9660D","وَإنّي لمُشْتاقٌ إلى ظِلّ صاحِبٍ،","يَرُوقُ وَيَصْفُو، إنْ كدِرْتُ علَيْهِ"],["E7A0CDE8-5A12-5702-BBEE-354BEFE711E3","عَذيري مِنَ الإنْسانِ لا إنْ جَفَوْتُهُ","صفَا لي ولا إنْ كُنتُ طوعَ يديهِ"]]},"B9E0BA31-01DF-578B-A7FD-47B422816669":{"t":"وَما المَوْتُ إلاّ رِحْلَةٌ غَيرَ أنّهَا","p":98,"s":"وما الموت إلا رحلة غير أنها","r":"450445","v":[["AB4D623D-CCA8-5960-8386-897AF7F44328","وَما المَوْتُ إلاّ رِحْلَةٌ، غَيرَ أنّهَا","مِنَ المَنْزِلِ الفَاني إلى المنزِلِ الباَقي"]]},"8B8E1C5C-669B-5AF4-BD5B-1C03B898C551":{"t":"يا ذا الذي يقرأُ في كتبهِ","p":98,"s":"يا ذا الذي يقرأ في كتبه","r":"450458","v":[["25F0A3EC-97F9-50D6-8D9A-979046C32018","يا ذا الذي يقرأُ في كتبهِ","ما أمَرَ الله، وَلا يَعْمَلُ"],["4453A9F7-A810-5CBF-8675-9D71A40D5AB7","قد بينَ الرحمان مقتَ الذي","يأمر بالحقِّ ولا يفعلُ"],["448D4423-C234-5A02-BB92-86E7B3DEF2E3","مَنْ كانَ لا تُشْبِهُ أفْعَالُهُ","أقْوالَهُ، فصَمْتُهُ أجْمَلُ"],["DAAFA4C8-D558-5CAB-A224-CE55DD6B2B19","من عذلَ الناسَ فنفسي بمَا","قد فارَقَتْ مِنْ دِينِها أعْذَلُ"],["470E5C59-8805-5846-A395-A1B967041BB3","إنّ الذي يَنْهَى، ويأتي الذي","عنهُ نَهَى في الخَلقِ، لا يَعدِلُ"],["B08F1804-BFEF-5999-8353-652D24493C0A","والراكبُ الذنبِ على جهلهِ","اعذَرُ ممنْ كانَ لا يجهلُ"],["0E320937-9510-59F8-8E5A-BF29B34AC493","لا تَخْلِطَنْ ما يَقْبَلُ الله مِنْ","فعلٍ بقولٍ منكَ لا يُقبلُ"]]},"CB9DA793-E092-592C-B265-9C8C5800D444":{"t":"يا راكِبَ الغَيّ غيرَ مُرْتَشِدِ","p":98,"s":"يا راكب الغي غير مرتشد","r":"450378","v":[["537016DD-5C47-5851-BAE1-E4B93487F53C","يا راكِبَ الغَيّ، غيرَ مُرْتَشِدِ،","شتَّانَ بينَ الضَّلالِ والرشَدِ"],["74999C02-6584-56C0-8F69-86C7D735A95E","حَسْبُكَ ما قَدْ أتَيْتَ مُعْتَمِداً،","فاستغفرِ اللهَ ثمَّ لاَ تعُدِ"],["F378DFAD-44BF-5540-AA4E-B41479E65C26","يَا ذا الذي نقصُهُ زيادَتُهُ","إنْ كنتَ لم تَنتَقِصْ، فلَمْ تَزِدِ"],["9D6B2D3C-0F50-56BC-BEEB-105897EAFC1B","مَا أسرعَ الليلَ والنَّهارَ بِسَا","عاتٍ قِصارٍ، تأتي عَلى الأمَدِ"],["D0D72CF5-933B-5BCD-B54F-B734DA288FAC","عجبْتُ منْ آمِلٍ وَوَاعظُهُ","المَوْتُ فَلَمْ يتَّعِظْ ولَمْ يكَدِ"],["61EFA114-B254-52F7-9C44-9C1A79966945","يجرِي البِلَى فِيهَا عَلَيْنَا بِمَا","كانَ جَرَى قَبْلَنَا عَلَى لُبَدِ"],["C969F556-DB50-5BFE-AC06-76D211F35B69","يا مَوْتُ يا مَوْتُ كمْ أخي ثقةٍ","كلَّفْتنِي غمضَ عينهِ بيدِي"],["D5478722-BDA2-5AA1-9C10-29806BB1E9BD","يا مَوْتُ يا موتُ قد أضفتَ إلَى","الفِلَّةِ منْ ثروةٍ ومنْ عُدَدِ"],["7281745F-FBFE-5030-88C0-88A098631127","يا مَوْتُ يا موتُ صحبتْنَا بِكَ","الشَّمْسُ ومسَّتْ كوَاكِبُ الأسَدِ"],["02FB792A-0BE5-5C10-93BB-1B7F4C9C4B65","يا مَوْتُ يا موتُ لاَ أرَاكَ منَ","ـخَلْقِ، جَميعاً، تُبقي على أحَدِ"],["80671D55-6837-5F09-B14E-7C29B0D6207D","ألحَمْدُ لله دائِماً أبَداً،","قَدْ يَصِفُ القَصْدَ غَيرُ مقتصدِ"],["1954FBB7-AA8D-5FA9-B9FB-D97EB8F767FB","منْ يستتِرْ بالهدَى يبَرَّ ومَنْ","يبغِ إلى اللهِ مَطْلَباً يَجِدِ"],["1D46833D-A2D9-5E63-9428-705647965719","قُلْ للجَليدِ المَنيعِ لَستَ منَ الـ","الدُّنيا بذِي منعةٍ ولاَ جَلَدِ"],["B7378F67-A053-5BC9-9362-EABFED6E05FB","يا صاحبَ المُدّةِ القَصيرَةِ لا","تغفُلْ عنِ المَوْتِ قَاطِعِ المُدَدِ"],["4321A62C-F904-5FFE-AE81-0C8028F43C40","دَعْ عنكَ تقوِيمَ منْ تقَوِّمُهُ","وابدأ، فَقَوّمْ ما فيكَ منْ أوَدِ"],["3C0CA9CC-415B-5610-8A8E-A76928F82BC6","قدْ ملأَ المَوْتٌ كُلَّ أرْضٍ وَمَا","يَنزِعُ مِنْ بَلْدَةٍ إلى بَلَدِ"]]},"029BD912-24F2-54F1-8697-34D8D949C92B":{"t":"يا عَينُ! قَدْ نِمْتِ فإستَنْبِهي","p":98,"s":"يا عين! قد نمت فإستنبهي","r":"450464","v":[["1A668F57-225B-5EED-8CB0-5CC4EDA1D7A1","يا عَينُ! قَدْ نِمْتِ، فإستَنْبِهي،","ما اجتمعَ الخوفُ وطيبُ المنامْ"],["F766B4FA-F9B9-51C1-B889-ABFAC678AA5A","أكْرَهُ أنْ ألْقَى حِمامي، وَلا","بُدّ لحَيً مِنْ لِقَاءِ الحِمَامْ"],["6B53AAFA-078E-5946-AAF7-02D8C9A84150","لا بدَّ من موتٍ بدارِ البِلَى","واللهُ بعدَ الموتِ يحيي العِظامْ"],["0AD936C3-06D8-537E-8BC6-CB69F7A05B45","يا طالبَ الدنيَا ولذَّاتِهَا","هلْ لكَ في مُلْكٍ طَويلِ المُقامْ؟"],["0FACFEA5-567C-54AA-BF12-ECF7C8912E17","مَنْ جاوَرَ الرّحْمَنَ، في دَارِهِ،","تَمّتْ لَهُ النّعمَةُ كُلَّ التّمَامْ"]]},"49A3EC9F-F9A6-5583-A904-67A6DE0B6C70":{"t":"يا نَفسُ أينَ أبي وأينَ أبو أبي","p":98,"s":"يا نفس أين أبي وأين أبو أبي","r":"450353","v":[["9250193D-A035-54C5-A48D-3E71D09546DA","يا نَفسُ أينَ أبي، وأينَ أبو أبي،","وأبُوهُ عدِّي لا أبَا لكِ واحْسُبِي"],["9910D6BC-4B42-570A-8DB3-E9A0C40313A5","عُدّي، فإنّي قد نَظَرْتُ، فلم أجدْ","بينِي وبيْنَ أبيكِ آدَمَ مِنْ أبِ"],["7CBF7EF4-3339-56FE-9577-D37D3FE4300E","أفأنْتِ تَرْجينَ السّلامَةَ بَعدَهمْ،","هَلاّ هُديتِ لسَمتِ وجهِ المَطلَبِ"],["1E804CB0-5C23-590B-AE8F-A95A9380661E","قَدْ ماتَ ما بينَ الجنينِ إلى الرَّضيعِ","إلى الفطِيْمِ إلى الكبيرِ الأشيبِ"],["C2A72202-E2EF-5D5A-9B7E-BB67F8FDB16D","فإلى متَى هذَا أرانِي لاعباً","وأرَىَ المنِّيةَ إنْ أتَتْ لم تلعَبِ"]]},"9BF1FC9C-8321-5E68-895E-9173B6BB940A":{"t":"يا نَفْسِ! ما هوَ إلاّ صَبرُ أيّامِ","p":98,"s":"يا نفس! ما هو إلا صبر أيام","r":"450467","v":[["B8C3C212-972E-55AD-BF22-28DE3A5ED3BD","يا نَفْسِ! ما هوَ إلاّ صَبرُ أيّامِ،","كأنَّ لَذَّاتِهَا أضغاثُ أحلامِ"],["192DD54F-FEA8-5FC6-B2E4-60D52BEA8FCA","يا نَفسِ! ما ليَ لا أنْفَكّ مِنْ طمعٍ","طرفِي غليهِ سريعٌ طامحٌ سامِ"],["A7E00B53-0059-5197-8D70-FAE3B9CAC20C","يا نَفْسِ! كوني، عن الدّنيا، مُبعدةً،","وَخَلّفّيها، فإنّ الخَيرَ قُدّامي"],["4C362C94-0845-5B39-BD43-E1BA9E2788CA","يا نَفْسِ! ما الذُّخرُ إلاّ ما انتَفَعتِ به","بالقَبرِ، يَوْمَ يكونُ الدّفنُ إكرامي"],["9E15939B-81A9-50DB-9A16-054CC2CE15D4","وَللزّمانِ وَعيدٌ في تَصَرّفِهِ،","إن الزمانَ لذو نَقْضٍ وإبرامِ"],["463F2E75-CC0D-527B-9156-FF0C446329DE","أمّا المَشيبُ فقَد أدّى نَذارَتَهُ،","وَقَدْ قَضَى ما عَلَيْهِ مُنذُ أيّامِ"],["9BB83BAC-C4D9-567A-8698-8EB9BC125DB8","إنّي لأستَكْثِرُ الدّنْيا، وأعْظِمُها","جهلاً ولم أرَهَا أهلاً لإعظامِ"],["6172A822-E939-59F8-B2B6-BE436BC08FB0","فَلَوْ عَلا بِكَ أقْوامٌ مَناكِبَهُمْ،","حثُّوا بنعشكَ إسراعاً بأقدامِ"],["01F9FBF5-2408-5775-A9F9-021E692A3193","في يومِ آخرِ توديعٍ تودعهُ","تهدي إلى حيث لا فادٍ ولا حامِ"],["DF393D8B-75AB-5D1D-B2AC-869021617F6E","ما الناسُ إلا كنفسٍ في تقاربهِمْ","لولا تفاوتُ أرزاقٍ وأقسامِ"],["30489E5F-5D84-5FBF-BE09-BB258BE15907","كَمْ لابنِ آدَمَ من لهوٍ، وَمن لَعبٍ،","وللحوادِثِ من شدٍّ وإقدامِ"],["F14FBCA0-ACAD-570C-91B0-638E29613EB3","كمْ قد نعتْ لهمُ الدنيَا الحلولَ بِهَا","لوْ أنّهُمْ سَمِعوا مِنْها بأفْهامِ"],["6378B32A-2B80-532B-BF24-ECC81A8B98E9","وكمْ تحرمتِ الأيامُ من بشرٍ","كانُوا ذوِي قوةٍ فيهَا وأجسامِ"],["A28D54BD-E7D0-5940-8A6B-077817272679","يا ساكِنَ الدّارِ تَبْنيها، وَتَعمُرُها،","والدارُ دارُ منيَّاتٍ وأسْقامِ"],["8D594A5F-76AF-59EC-BCD6-007371921E38","لا تَلْعَبَنّ بكَ الدّنيا وَخُدْعَتُها،","فكَمْ تَلاعَبَتِ الدّنْيا بأقْوامِ"],["C65D3CD5-89DF-5736-98D7-6F73B43769FE","يا رُبَّ مُقتصدٍ من غيرِ تجربةٍ","وَمُعْتَدٍ، بَعدَ تجريبٍ، وَإحكامِ"],["18865B4E-F468-50A8-AD73-CB5B370CCE16","وربَّ مُكتسبٍ بالحكْمِ رامِيَهُ","وربَّ مُستهدِفٍ بالبغيِ للرامِي"]]}}}