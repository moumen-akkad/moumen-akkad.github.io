{"v":1,"poems":{"7164E325-FF4A-58CC-8870-B7A7B5CCDC86":{"t":"لامية العجم","p":159,"s":"لامية العجم","r":"469706","v":[["96B5F70A-5E2D-5EF7-8F53-6094F644C824","أصالةُ الرأي صانتْنِي عن الخَطَلِ","وحِليةُ الفضلِ زانتني لدَى العَطَلِ"],["C28BE312-EE24-52A8-BBE2-D9A7A339937F","مجدي أخيراً ومجدِي أوّلاً شَرَعٌ","والشمسُ رأْدَ الضُحَى كالشمسِ في الطَفَلِ"],["6415FCCA-889E-52C0-AF72-6ABB9834EFE5","فيمَ الإقامُة بالزوراءِ لا سَكَني","بها ولا ناقتي فيها ولا جَملي"],["1E3AB232-021E-5D13-B304-CD91D57F5CD9","نَاءٍ عن الأهلِ صِفْرُ الكفِّ منفردٌ","كالسيفِ عُرِّيَ متناهُ من الخَللِ"],["6780E1C0-521F-5E99-9370-C5C981B3FEBF","فلا صديقَ إليه مشتكَى حزَنِي","ولا أنيسَ إليه منتَهى جذلي"],["32D698F9-1443-58B7-9F93-488C6886FF63","طالَ اغترابيَ حتى حنَّ راحلتي","ورحُلها وقرَى العَسَّالةِ الذُّبلِ"],["0C6279EA-7266-528E-B60C-3CFF6364C660","وضَجَّ من لَغَبٍ نضوي وعجَّ لما","يلقَى رِكابي ولجَّ الركبُ في عَذَلي"],["5439EC56-7399-5DAC-B0B8-D845A9F7A06E","أُريدُ بسطةَ كَفٍ أستعينُ بها","على قضاءِ حُقوقٍ للعُلَى قِبَلي"],["D59EE263-E8CA-5057-98E7-FF16ACF4D233","والدهرُ يعكِسُ آمالِي ويُقْنعُني","من الغنيمةِ بعد الكَدِّ بالقَفَلِ"],["57C516A1-6CD1-5EB3-9E28-80EF198C6156","وذِي شِطاطٍ كصدرِ الرُّمْحِ معتقلٍ","لمثلهِ غيرَ هيَّابٍ ولا وَكِلِ"],["B40759D3-A26E-5A29-B0FA-D8C5F2FA49F5","حلوُ الفُكاهِةِ مُرُّ الجِدِّ قد مُزِجتْ","بقسوةِ البأسِ فيه رِقَّةُ الغَزَلِ"],["76EDF263-C4AE-51F9-B043-D970A85FF94F","طردتُ سرحَ الكرى عن وِرْدِ مُقْلتِه","والليلُ أغرَى سوامَ النومِ بالمُقَلِ"],["4AE12DDF-19C9-5590-AF80-E64B5405B927","والركبُ مِيلٌ على الأكوارِ من طَرِبٍ","صاحٍ وآخرَ من خمر الهوى ثَمِلِ"],["83445D6E-973C-5945-A517-651A8B5C16B6","فقلتُ أدعوكَ للجُلَّى لتنصُرَنِي","وأنت تخذِلُني في الحادثِ الجَلَلِ"],["0FD530E6-FAF9-5B40-88F5-7562A91082AD","تنام عيني وعينُ النجمِ ساهرةٌ","وتستحيلُ وصِبغُ الليلِ لم يَحُلِ"],["3BD0DC0A-9A76-53EF-BF38-B52F83A105AA","فهل تُعِيُن على غَيٍّ هممتُ بهِ","والغيُّ يزجُرُ أحياناً عن الفَشَلِ"],["A85797EF-C420-5A26-BCA5-DD9594B1CDF4","اني أُريدُ طروقَ الحَيِّ من إضَمٍ","وقد رَماهُ رُماةٌ من بني ثُعَلِ"],["B577CDED-E407-58D1-A7F2-ADE203FE744C","يحمونَ بالبِيض والسُّمْرِ اللدانِ بهمْ","سودَ الغدائرِ حُمْرَ الحَلْي والحُلَلِ"],["DAD73C2E-6776-5DE7-8039-72A8302158D3","فسِرْ بنا في ذِمامِ الليلِ مُهتدياً","بنفحةِ الطِيب تَهدِينَا إِلى الحِلَلِ"],["2E6C8BCD-7490-5E16-844C-CE0C6A0DA0A1","فالحبُّ حيثُ العِدَى والأُسدُ رابضَةٌ","نِصالُها بمياه الغَنْجِ والكَحَلِ"],["32F15294-A899-5AFD-8E6F-D8FF441ABD9A","قد زادَ طيبَ أحاديثِ الكرامِ بها","ما بالكرائمِ من جُبنٍ ومن بُخُلِ"],["689BB728-0B57-5BD9-ACD2-ECC82BE5B75E","تبيتُ نارُ الهَوى منهنَّ في كَبِدٍ","حرَّى ونار القِرى منهم على القُلَلِ"],["EA61FE84-D75A-523D-8B96-CDF20759B860","يقتُلنَ أنضاءَ حبٍّ لا حَراكَ بها","وينحرونَ كرامَ الخيلِ والإِبِلِ"],["717B1A12-F680-55D6-A01D-A98CD395E9C4","يُشفَى لديغُ الغوانِي في بُيوتهِمُ","بنهلةٍ من لذيذِ الخَمْرِ والعَسَلِ"],["85D6BAA5-AF30-5CE3-9FB8-BB90C53B7598","لعلَّ إِلمامةً بالجِزعِ ثانيةً","يدِبُّ فيها نسيمُ البُرْءِ في عللِ"],["D25D7902-9D1E-53EA-9252-33A8F1EC99BF","لا أكرهُ الطعنةَ النجلاءَ قد شُفِعَتْ","برشقةٍ من نِبالِ الأعيُنِ النُّجُلِ"],["E00200D0-998C-521D-86D1-415DF0CA820F","ولا أهابُ صِفاح البِيض تُسعِدُني","باللمحِ من صفحاتِ البِيضِ في الكِلَلِ"],["D0BCF6C6-791C-5219-A617-E465A6096E88","ولا أخِلُّ بغِزلان أغازِلُها","ولو دهتني أسودُ الغِيل بالغيَلِ"],["C5C0145B-8BBC-58B5-B226-402E62DF513D","حبُّ السلامةِ يُثْني همَّ صاحِبه","عن المعالي ويُغرِي المرءَ بالكَسلِ"],["2DD0B099-4B85-5290-8E05-97CCC0CBC1A2","فإن جنحتَ إليه فاتَّخِذْ نَفَقاً","في الأرضِ أو سلَّماً في الجوِّ فاعتزلِ"],["58BC0C18-2A9D-5851-B2C6-46BDEFE1C7F3","ودَعْ غمارَ العُلى للمقديمن على","ركوبِها واقتنِعْ منهن بالبَلَلِ"],["7DA91E98-2B76-5834-AB0F-3354072890D9","رضَى الذليلِ بخفضِ العيشِ يخفضُه","والعِزُّ عندَ رسيمِ الأينُقِ الذُلُلِ"],["E5A432DC-898F-5E15-8F9C-8A21B72864AF","فادرأْ بها في نحورِ البِيد جافلةً","معارضاتٍ مثانى اللُّجمِ بالجُدَلِ"],["4EE06953-6253-53E2-BDFD-7D1613E62912","إن العُلَى حدَّثتِني وهي صادقةٌ","في ما تُحدِّثُ أنَّ العزَّ في النُقَلِ"],["B13B679F-3122-5326-AF61-B086F5BCA881","لو أنَّ في شرفِ المأوى بلوغَ مُنَىً","لم تبرحِ الشمسُ يوماً دارةَ الحَمَلِ"],["D7176772-464A-5B0D-9D6B-34AD724B05EB","أهبتُ بالحظِ لو ناديتُ مستمِعاً","والحظُّ عنِّيَ بالجُهَّالِ في شُغُلِ"],["3F5716CD-65B0-56F2-8AB4-B60BBAD47F74","لعلَّهُ إنْ بَدا فضلي ونقصُهُمُ","لعينهِ نامَ عنهمْ أو تنبَّهَ لي"],["A0967567-1DCF-5439-8A93-644E9509297A","أعلِّلُ النفس بالآمالِ أرقُبُها","ما أضيقَ العيشَ لولا فسحةُ الأمَلِ"],["88E024EE-4DC4-5234-8CFA-E5F9EE66F6F7","لم أرتضِ العيشَ والأيامُ مقبلةٌ","فكيف أرضَى وقد ولَّتْ على عَجَلِ"],["B878C8B9-A8CA-5D2B-A285-A8478F16629D","غالى بنفسيَ عِرفاني بقيمتِها","فصُنْتُها عن رخيصِ القَدْرِ مبتَذَلِ"],["2C39F5CF-92BB-5F6E-A84B-8705B7CE27D8","وعادةُ النصلِ أن يُزْهَى بجوهرِه","وليس يعملُ إلّا في يدَيْ بَطَلِ"],["5B831241-463C-505E-B696-656AB136D8A5","ما كنتُ أُوثِرُ أن يمتدَّ بي زمني","حتى أرى دولةَ الأوغادِ والسّفَلِ"],["67AE22E3-611F-56DA-BAA6-72DB7D25C700","تقدَّمتني أناسٌ كان شَوطُهُمُ","وراءَ خطويَ إذ أمشي على مَهَلِ"],["A2F47D45-39B0-5395-9BBE-5B4CCF81C2C9","هذا جَزاءُ امرئٍ أقرانُه درَجُوا","من قَبْلهِ فتمنَّى فُسحةَ الأجلِ"],["CBE56DD0-7672-590F-B3F8-B6A012B7FBA5","وإنْ عَلانِيَ مَنْ دُونِي فلا عَجَبٌ","لي أُسوةٌ بانحطاطِ الشمس عن زُحَلِ"],["C09C13DC-50D1-5E9D-88DF-0F9FE802B9B9","فاصبرْ لها غيرَ محتالٍ ولا ضَجِرٍ","في حادثِ الدهرِ ما يُغني عن الحِيَلِ"],["2B4DA191-6C18-5A16-9F31-1A59BC6BFCCE","أعدى عدوِّكَ أدنى من وَثِقْتَ به","فحاذرِ الناسَ واصحبهمْ على دَخَلِ"],["C733E0BD-B71A-5AC6-AC30-3353073143E2","وإنّما رجلُ الدُّنيا وواحِدُها","من لا يعوِّلُ في الدُّنيا على رَجُلِ"],["4380ECDD-60B0-5A94-BF13-0B9E8D229972","وحسنُ ظَنِّكَ بالأيام مَعْجَزَةٌ","فظُنَّ شَرّاً وكنْ منها على وَجَلِ"],["63B5FCF8-F338-519B-A25D-02942A5FF770","غاضَ الوفاءُ وفاضَ الغدرُ وانفرجتْ","مسافةُ الخُلْفِ بين القولِ والعَمَلِ"],["171A1F6B-D84B-5193-940E-32E4B3A20C11","وشانَ صدقَك عند الناس كِذبُهمُ","وهل يُطابَقُ معوَجٌّ بمعتَدِلِ"],["660AE796-E014-56DC-84F5-317FB285DE81","إن كان ينجعُ شيءٌ في ثباتِهم","على العُهودِ فسبَقُ السيفِ للعَذَلِ"],["BE331C49-3C9B-586D-AAFA-B3C77CBD00B6","يا وارداً سؤْرَ عيشٍ كلُّه كَدَرٌ","أنفقتَ عُمرَكَ في أيامِكَ الأُوَلِ"],["2500CF9A-D6E3-5CF8-A06B-A2D3D932A26A","فيمَ اعتراضُكَ لُجَّ البحرِ تركَبُهُ","وأنتَ تكفيك منه مصّةُ الوَشَلِ"],["31ED2CB5-0E54-57B4-97F5-1DB7D0AD48EE","مُلْكُ القناعةِ لا يُخْشَى عليه ولا","يُحتاجُ فيه إِلى الأنصار والخَوَلِ"],["F213FF2E-4A69-50BB-B089-FE5A65BFCCA5","ترجو البَقاءَ بدارِ لا ثَباتَ لها","فهل سَمِعْتَ بظلٍّ غيرِ منتقلِ"],["6403334A-7B68-5720-B419-91168A383AB3","ويا خبيراً على الأسرار مُطّلِعاً","اصْمُتْ ففي الصَّمْتِ مَنْجاةٌ من الزَّلَلِ"],["FFB7530F-1658-5BDE-A411-194F353CC913","قد رشَّحوك لأمرٍ إنْ فطِنتَ لهُ","فاربأْ بنفسكَ أن ترعى مع الهَمَلِ"]]}}}