{"v":1,"poems":{"7C4AAF87-364A-539F-8DB8-70E8101C8E3C":{"t":"يادَهْرُ قَدْكَ وقَلَّما يُغني قَدِي","p":102,"s":"يادهر قدك وقلما يغني قدي","r":"451161","v":[["97346391-E591-51B8-B020-72391DB6BFE2","يادَهْرُ قَدْكَ وقَلَّما يُغني قَدِي","وأراكَ عِشْرَ الظمْءِ مُرَّ المَوْرِدِ"],["C236F23A-0FB6-5DE9-84BF-5DA83524B037","ولقدْ أحيط بنا ولم نكُ صورة","بكَ واستُعِدَّ لنا ولمّا نُولَدِ"],["6FFFC674-30C9-5306-B03A-C1C59074D7BE","يادَهْرُ أَيَّةُ زَهْرَةٍ لِلمَجْدِ لم","تجففْ وأيةُ أيكة لمْ تخضُدِ!"],["65D09DC8-0444-5092-8CE1-14EC1F1F3F09","أترعتَ للعنقاءِ في أشعافِها","كأساً تدفقُ بالذعافِ الأسودِ"],["1E745D89-4E12-5BF3-AF2E-669166CBC3A5","قَدْ كانَ قَرْمٌ كاسمِهِ قَرْمَاً وما","ولَدَتْ نِسَاءُ بَنِي أبيهِ كأحمَدِ"],["57D6F010-3EC4-5D7B-9A1A-AC6FADD26D50","نجما هدىً هذاكَ نجمُ الجدي إنْ","حارَ الدليلُ وذاكَ نجمُ الفرقدِ"],["37ED0D28-A301-5795-ADAB-714F7380D0AF","هذا سنانٌ زاغبيٌّ في الوغى","وكأنما هذا ذبابُ مهندِ"],["E2CC6D5E-7835-5F42-BF24-980AC832675A","وجَبِينُ هذا كالشهَابِ جَلا الدُّجَى","عنه وهذا كالشهابِ المُوقَدِ"],["F132CB52-8A7C-52A2-9D25-CA4F7F183C1D","ولَنِعْمَ دِرْعا الحّي في يَوْمَيْهِما","كانا ونِعْمَ الذُّخْرِ كانا لِلغَدِ"],["A4B8FBA8-2EF3-5314-83FE-06B5A0E4E72D","لم يَشْهَدا نَجْوَى ولاحَشّا لَظَى","حَرْبٍ تُسَعَّرُ بالقَنا المُتَقَصدِ"],["912A3F33-2EB8-59FD-87EC-E128973C1CD4","إلاَّ رأَيْنا ذَا على تلك الرَّحا","قُطْباً وذَا مِصْبَاحَ ذَاكَ المَشْهَدِ"],["25CC427C-2C31-5FFF-BEEE-066E1C3F173E","رُزِئَت بَنُو عَمْرو بنِ عامرٍ الذُّرَى","بِهما وصَوَّحَ نَبْتُ وَادِيها النَّدى"],["B36B12C3-4795-5085-89E6-85C24E209CCD","وكذا المنايا ما يطأنَ بمسيمٍ","إلا على أعناق أهلِ السؤددِ"],["A555C374-4BF4-52B8-AF9D-DD69B5432EDD","ولَئِن أُصِيبُوا إِنَّ تِلكَ لَغَيْضَةً","لم تخلُ من ليثٍ هنالكَ ملبدِ"],["801C2AE9-F406-5B4B-B560-6DAD5650DCEF","ما دامَ ذاك المعدنُ الزاكي الثرى","في جزعِنا لم نلتفتْ للعسجدِ"],["6A34237E-CED0-5E8F-A227-F28BAC0FBF1F","تلكَ المصائبُ مشوياتٌ كلها","إلا مصيبةَ حجوةَ بنِ محمدِ"],["D58BC71F-E766-5CDE-8AB1-4664BF242C67","ولقَدْ أصابَ غَليلُها مَنْ لم يُصَبْ","ولَصُيرَتْ فقْداً لِمَنْ لم يَفْقِدِ"],["F0BB0A6C-27D3-59E3-BBA6-7CA1C3D13D56","طامنْ حشاكَ أبا الحبابِ فإنها","نوبٌ تروحُ على الأنامِ وتغتدي"],["907BAB34-B9EE-500F-940D-896B19B354CC","فلقدْ أفاقِ متممٌ عن مالكٍ","وسلا لبيدُ قبلهُ عنْ أربدِ"],["167F33EF-0AC2-54AA-B3D9-6B1781122010","فَلَئِنْ صَبَرْتَ لأنتَ كوكبُ مَعْشَرٍ","صَبَروا وإنْ تَجْزَعْ فغَيْرُ مفَنَّدِ"],["23B1E39B-DD65-56C6-A464-F31C4789C8FF","هذي المعونةُ باللسانِ ولو أرى","عَيْن الحِمَامِ لَقَدْ أَعَنْتُكَ باليَدِ"]]},"CD751966-8CB4-594E-9C6C-5223CEAA6106":{"t":"ياسميَّ النبيِّ حينَ يسمّى","p":102,"s":"ياسمي النبي حين يسمى","r":"451285","v":[["77DF544B-2369-5002-8349-5852191783DE","ياسميَّ النبيِّ حينَ يسمّى","والذي خُصَّ بالجَمالِ وعُمّا"],["1B0015C2-5186-5378-AF9A-5F83F27DEB74","والذي هَمَّ خَصْرُه بانبِتَاتٍ","فثناهُ الحشى فكادَ ولمّا"],["35BF701D-E7D0-551C-B37B-E96C3D710CED","لست أنسى مقالةً ليَ سرَّا","أحسنُ الحبِّ ما يكونُ معمى"],["159D943A-92FF-5638-A905-3CAE5FC3A203","حفظَ اللهُ لي صحيحَ هواهُ","وكَفاني مِنْ حُبهِ ما أَهَمَّا!"]]},"DDA0DC4C-8CF6-5AF6-9674-29C83BE73573":{"t":"ياسهمُ للبرقِ الذي استطارا","p":102,"s":"ياسهم للبرق الذي استطارا","r":"451021","v":[["44FBECB0-17DA-5504-978D-7B2458EC030A","ياسهمُ للبرقِ الذي استطارا","باتَ على رَغْمِ الدُّجَى نَهَارا"],["D92C7012-6846-5867-B952-1F75FFEC81EA","حتى اذا ما انجدَ الأبصارا","وبلاً جهاراً أو ندى سرارا"],["B26E902D-66A9-55A1-9368-136885611651","آضَ لنا ماءَ وكان نارا","أَرضى الثَّرَى وأَسخَطَ الغُبارا"]]},"51AF689B-8885-57C7-8BAD-7548D6C4EDE3":{"t":"ياشدناً صيغَ من الشمسِ","p":102,"s":"ياشدنا صيغ من الشمس","r":"451213","v":[["4DDFD032-569C-5E81-A936-0BD5F499A463","ياشدناً صيغَ من الشمسِ","تِهْ بالمَلاحاتِ على الإنْسِ"],["5B7B26D4-2EFD-5F5E-85AA-811220518E43","في كلِّ يومٍ انت في صورةٍ","غيرِ التي كنتَ بها أَمْسِ"],["719E480C-526A-58F4-A8D5-C6648D6D43EB","تَزْدادُ طِيباً كلَّ يومٍ كما","يَزدادُ غُصْنُ البانِ في الغَرْسِ"],["CA1F8E5A-6B3B-54CD-B99F-3A0319274EB4","واللّهِ لَوْلا اللّهُ لا غَيرُهُ","وخَوْفيَ النَّارَ على نَفْسِي"],["1B47A4A7-287F-5E41-B826-91728C3F33A5","صليتُ خمساً لك من هيبةٍ","وازدَدْتُ ثِنْتَينِ على الخَمْسِ!"]]},"80DD8002-AC9D-511E-8707-F00FEACED1C5":{"t":"ياعَمْرُو قُلْ للقَمرِ الطَّالعِ","p":102,"s":"ياعمرو قل للقمر الطالع","r":"451383","v":[["07414536-5F03-5A77-83C0-D2FB5D2E74AE","ياعَمْرُو قُلْ للقَمرِ الطَّالعِ","إتسعَ الخرقُ على الراقعِ!"],["704D9AB2-399D-5CC8-B551-985F50B8F7E1","يا فِتْنَةَ النَّاظرِ قَدْ صِرْتَ في","فِعْلِكَ هذا فِتنَةَ السَّامِعِ"],["A41ABDAF-E7D9-5A59-8A26-4AB2D1682F30","هلْ أنتَ إلا رشأٌ خاذلٌ","حَلَّ بمَغنَى أَسدٍ جائعِ؟!"],["2E070B28-CDDE-5D95-89EC-2B1A15313404","ما كانَ في المخدَعِ منْ أمركمْ","فإنَّه في المسجد الجامعِ!"],["6459410E-E3C5-5975-8F17-B484B371C27E","ياطُولَ فِكْري فيكَ مِنْ حاملٍ","صَحِيفةً مكسورَة الطَّابعِ!"]]},"D1B2883D-EFE0-56F1-9687-0793805C1E3E":{"t":"ياعِلِيلاً حَشَا الجَوانِحَ نارَا","p":102,"s":"ياعليلا حشا الجوانح نارا","r":"451173","v":[["4E22705A-7CA6-5C8E-86CD-6DF5189CDCBF","ياعِلِيلاً حَشَا الجَوانِحَ نارَا","كانَ لي فيكَ حافِظُ الجارِ جارَا"],["BA5080A6-C8C2-511B-8DA5-8204A9E77A62","معدنُ الحسنِ والملاحةِ قد","ـبحَ لِلسُّقْمِ مَعْدِناً وقَرارَا"],["6F97B9AB-CCBE-5389-A62F-443F829BE3B4","إِنَّ وَجْهَ الحُمَّى لَوجهٌ صَفِيقٌ","حِينَ تَسطُو بهِ نَهاراً جَهارَا"],["9EA1CA9C-5F0E-596D-9EF2-F995B715C48D","لم تشن وجههُ المليحَ ولكن","جعلتْ وردَ وجنتيهِ بهارا"]]},"A1AE4B9B-A740-5512-95D6-B83505871404":{"t":"يالابِساً ثَوْبَ المَلاحَةِ أبْلهِ","p":102,"s":"يالابسا ثوب الملاحة أبله","r":"451219","v":[["AEE14967-F75E-5606-88EF-04253CF4B4EE","يالابِساً ثَوْبَ المَلاحَةِ أبْلهِ","فلأنت أولى لابسيهِ بلبسهِ"],["9A1778B6-BFB7-5763-B2F3-AF15AE034F43","لم يُعْطِكَ اللَّهُ الذي أعطَاكَه","حتَّى استَخَفَّ بِبَدْرِهِ وبِشَمْسِهِ"],["63544771-E075-512B-B1CD-B848423CC191","رَشَأ إذا مَاكادَ يُطلِقُ نَفْسَه","في فَتْكِه أَمَرَ الحَيَاءُ بِحَبْسِهِ"],["8D195568-77F1-5C9D-9A9F-C9FE06718DE3","و أنا الذي اعطيتهُ محضَ الهوى","وصَمِيمَهُ وأخذْتُ عُذْرَةَ أُنْسِهِ"],["1EFE79ED-C680-5D79-B57F-372CB8C5983E","فَلَئِنْ جَنَيْتُ ثِمارَه وغَرَسْـتُهُ","ما كنتَ أولَ من جنى من غرسهِ"],["820ED3F5-498B-57AC-B50C-9C6BA6455969","مولاك يا مولايَ صاحبث لوعةٍ","في يومهِ وصبابةٍ في أمسهِ"],["89537889-6D41-5C93-AD31-42078629F1A6","دَنِفٌ يَجُودُ بِنَفْسِهِ حتى لقَدْ","أمسَى ضَعِيفاً أَنْ يَجُودَ بِنفسِهِ!"]]},"2329E02F-AB04-5AB3-A3EE-592CA4419EC9":{"t":"يامَنْ بهِ يَفْتَخِرُ الفَخْرُ","p":102,"s":"يامن به يفتخر الفخر","r":"451160","v":[["FF6FD658-54CC-55FD-A9FE-4B9A18DB4497","يامَنْ بهِ يَفْتَخِرُ الفَخْرُ","ومنْ بهِ يبتهجُ الشعرُ"],["AA381B58-3A9D-57BD-96C6-4DCC91E14198","ماطلَبِي للإذْنِ أَنْ شَاقَنِي","شَمْسٌ مِنَ الإنْسِ ولا بَدْرُ"],["2233C648-E4BE-532C-9C9D-C5DB3ABED70B","بَلى كتابٌ أَخْرَسٌ ناطِقٌ","أَنْطَقَ مِنه طَيَّهُ النَّشْرُ"],["2C9FB4ED-E242-5E76-88B7-D8DEED8B0D58","فانتشرتْ حينَ بدا طيهُ","سَرائِرٌ يَكتُمها الجَهْرُ"],["FCE327A1-8F6D-5FDA-9902-3106E2EED7B4","جاءَ نذيرُ الحزنِ في بطنهِ","بحادثٍ أظهرهُ الظهرُ"],["2656D102-73FC-5081-8176-F4AE760565E3","فانهلَّ في أسطرهِ أسطرٌ","للدمعِ سطرٌ فوقهُ سطرُ"],["9B3DDEB9-DE32-5E22-8EBB-F9632094D087","فمنَّ بالإذنِ على نازحٍ","عن أهلهِ ساعتهُ دهرُ"],["0A3C7F66-BC32-5DCF-915E-B195D8BC6C49","فَقدْ صَدقْتَ الظَنَّ في كل ما","رَجَوْتُه إِذْ كَذَبَ القَطْرُ"]]},"45E8CC11-CDCB-5858-9C17-27DC79D4635C":{"t":"يامَنْ تَرَدَّى بِحُلَّةِ الشَّمْسِ","p":102,"s":"يامن تردى بحلة الشمس","r":"451216","v":[["2DE8811C-CD83-537A-A70A-245D31464660","يامَنْ تَرَدَّى بِحُلَّةِ الشَّمْسِ","ومَنْ رَماني بأسْهُمٍ خَمْسِ"],["5C13BF5D-AC2E-56CC-8B67-65D35535B262","بالطرفِ والثغرِ والسوالف والنـ","حرِ وشيئٍ يطيبث في اللمسِ"],["5993FD3F-86E2-5F97-8932-CD62F312EE91","هاأناذابالذُّنُوبِ مُعْتَرِفٌ","فَهَبْ لِذُلي جِنَايَتَيْ أمْسِ"],["66FD25F0-21DD-557E-B2D4-759BCA055577","وجدْ لمستمطر الجفون دماً","شغلتهُ عن صلاتهِ الخمسِ"],["D91C5DEB-9296-5BEA-AF0A-EB26878A0961","سألتث عن وصفيك الصفاتِ فما","نَطَقْنَ إلاَّ بألسُنٍ خُرْسِ"]]},"C9306A52-F25C-5C8C-978D-D73FBDDF4AF9":{"t":"يقولُ أناسٌ في حبيناءَ عاينوا","p":102,"s":"يقول أناس في حبيناء عاينوا","r":"451087","v":[["1B8E9CF4-3651-5EE2-97B7-C6B01BEC9C25","يقولُ أناسٌ في حبيناءَ عاينوا","عمارةَ رحلي من طريفٍ وتالدِ"],["A9D11F4A-EFD6-5076-B466-02C99B2744D0","أَصَادفْتَ كَنْزاً أَمْ صَبَحْتَ بِغَارَةٍ","ذوي غرةً حاميهمُ غيرُ شاهدِ"],["62430E90-5F69-532A-9127-F294066FED27","فقلْتُ لهُمْ لا ذَا ولا ذَاكَ دَيْدَني","ولكنَّني أقْبَلْتُ مِنْ عِنْدِ خَالِدِ"],["B05F167A-BD42-5251-B6F0-9982C0FC7FED","جذبتُ نداهُ غدوَ السبتِ جذبةً","فخَرَّ صَريعاً بيْنَ أيْدِي القَصَائِدِ"],["2A3BFB16-0212-55EF-A7BA-E057F584610D","فأبتُ بنعمى منهُ بيضاءَ لدنةً","كثيرةِ قَرْحٍ في قُلوبِ الْحَواسِدِ"],["4A7E8843-4A0D-5D5D-B26B-F8A510572E1C","هيَ الناهدُ الريا إذا نعمةُ امرىء","سواهُ غدتْ ممسوحةً غيرَ ناهدِ"],["9367DF12-BF5B-56C6-BEA0-3DDF318360F2","فرعتُ عقابَ الأرضِ والشعرِ مادحاً","لهُ فارْتَقَى بي في عِقَابِ المحامِدِ"],["027C01B5-14B3-5EAC-A389-A723DFC4264A","فألبسني من أمهاتِ تلادهِ","وألبستهُ من أمهاتِ قلائدي"]]},"07925235-CA3F-5652-83AE-06BB6D053B97":{"t":"يقَولُ في قُومسٍ صَحبْي وقدْ أَخذَتْ","p":102,"s":"يقول في قومس صحبي وقد أخذت","r":"451131","v":[["EA34FCAA-8F61-5C5E-A033-8442CC93A95E","يقَولُ في قُومسٍ صَحبْي وقدْ أَخذَتْ","بِنَا السُّرى وخُطا المَهْريَّةِ القُودِ"],["6D19DDCD-B69D-50F6-83FF-826ACFBCCB63","أمطلعَ الشمسِ تنوي أنْ تؤمَ بنا","فقلتُ كلاَّ ولكن مَطْلِعَ الجُودِ"]]},"1E774090-2610-5E4C-9617-83D50C43A373":{"t":"يومَ الفراق لقدْ خلقتَ طويلا","p":102,"s":"يوم الفراق لقد خلقت طويلا","r":"451009","v":[["2FE465CF-87EE-542B-8171-CEFFB79ACBF9","يومَ الفراق لقدْ خلقتَ طويلا","لم تُبقِ لي جلداً ولا معقولا"],["F66BBBDD-FF6E-5982-83FD-24D419E7F955","لَوْ حارَ مُرتَادُ المَنِيَّةِ لَمْ يُرِدْ","إلا الفراقَ على النفوسِ دليلا"],["8E09E690-ECD5-5E06-87DC-9A611609ABB9","قالوا الرَّحِيلُ فَما شَككْتُ بأُنَها","نفسي عن الدنيا تريد رحيلا"],["89B6F87A-079F-5C92-B697-2AD89B490419","الصَّبرُ أَجمَلُ غَيْرَ أَن تَلَدُّداً","في الحُب أَحرَى أَنْ يكونَ جَمِيلا"],["B4D95458-6F25-5FDA-90CB-3ABCDC842745","أتظنني أجدُ السبيلَ إلى العزا","وجدَ الحمامُ إذاً إليَّ سبيلا!"],["6D7BFA5A-4CB9-51A3-9F8A-A6129C750552","ردُّ الجموحِ الصعبِ أسهلُ مطلباً","من ردِّ دمعٍ قدْ أصابَ مسيلا"],["A962DC9A-23D7-56DB-8B0A-36AE7E4FD709","ذكرتكم الأنواءُ ذكري بعضكمْ","فبكتْ عليكمْ بكرةً وأصيلا"],["79C5DFDB-3C73-563E-9710-EA93BB1F4510","وبنفسيَ القمرُ الذي بمحجَّر","أمسى مصوناً للنوى مبذولا"],["FF959AA9-3A0F-5DA7-9791-BA0A40FBD692","إني تأمَّلْتُ النَّوى فوجَدتُها","سَيْفاً عَليَّ معَ الهَوَى مسْلُولا"],["D29D9EB3-DE1A-5A80-9E81-5115EA02958F","لا تأخذيني بالزمان، فليسَ لي","تبعاً ولستُ على الزمانِ كفيلا"],["B1C848A3-414F-5BF3-ACB8-58AA9B9C4B89","مَنْ زَاحَفَ الأّيَّامَ ثُمَّ عَبَا لَها","غيرَ القناعةِ لمْ يزلْ مفلولا"],["8C5EE105-5164-58C8-B06C-38C12F64B43F","من كانَ مرعى عزمِهِ وهمومِهِ","رَوضُ الأَماني لَم يَزَل مَهْزُولا"],["24CA8EB6-2D72-5F65-803B-C96B1C20F2DB","لَوْ جَازَ سُلطانُ القُنُوعِ وحُكْمُهُ","في الْخَلْقِ ما كانَ القَلِيلُ قَليلا"],["FF15FC1E-FBB2-52E3-82AE-24090304BBF2","الززْقَ لا تَكْمَدْ عليهِ فإنَّهُ","يَأْتي ولَمْ تَبْعَثْ إِليهِ رَسُولا"],["11D13617-B333-572F-A75A-1C4A22EBF4DD","للّهِ دَرُّكِ أَيُّ مَعْبَرِ قَفْرَةٍ","لا يُوحشُ ابنَ البيضةِ الإجفيلا"],["E529C0AE-8283-5659-8BF5-2A8C55D16F73","بِنْتُ الفَضَاءِ متى تَخِدْ بِك لا تَدَعْ","في الصَّدْرِ مِنكَ على الفَلاةِ غلِيلا"],["B7D06D03-4536-5B1E-B429-B3FED9DF4DE2","أو ما تراها، ما تراها، هزَّةً","تشأى العيونَ تعجرفاً وذميلا!"],["80F1F43E-88BF-5FF4-A9C0-B06AE8F20218","لوْ كانَ كلفها عبيدٌ حاجةً","يوماً لأنسيَ شدقماً وجديلا"],["C9F0A776-CB2B-5D0E-A134-3759BA1B68D6","بالسَّكْسكي المَاتِعي تَمَتَّعتْ","هممٌ ثنتْ طرفَ الزمان كليلا"],["5BE9F535-86CE-5F61-8968-BBC12C97BE84","لا تدعونْ نوحَ بن عمروٍ دعوةً","للخطبِ إلا أنْ يكونَ جليلا"],["9706F73E-CE55-5C10-A448-700560D547F9","يَقِظٌ إذاما المُشكلاتُ عَرَوْنَهُ","ألْفَيْنَهُ المُتَبَسَّمَ البُهْلُولا"],["AF5E4D86-6F4B-5B8D-B226-83C169EDE2AF","ما زَالَ يُبرِمُهُنَّ حتَّى إِنَهُ","لَيُقالُ، ما خَلَقَ الإِلَهُ سَحِيلا"],["23B4C56A-8614-5A0A-A054-3A553A0C43F6","ثَبْتُ المَقَامِ يرَى القَبيلَةَ واحِداً","ويرى فيحسبُه القبيلُ قبيلا"],["5455345B-ABBC-5BA2-83C0-319C7A6C25F8","كَمْ وَقْعَةٍ لكَ في المَكارِمِ فَخْمَةٍ","غادرْتَ فيها ما ملكتَ فتيلا"],["BB6869A1-003E-5060-BE1E-A2BCF70585E2","أوطأتَ أرضَ البُخلِ فيها غارةً","تَركَتْ حُزونَ الْحَادَثات سُهُولا"],["417D5FBD-52B0-5918-A8D2-900A5F121C7C","فَرَأّيْتَ أكثَرَ ماحَبَوْتَ مِنْ اللُّهى","نَزْراً وأصغَرَ ما شُكِرْتَ جَزِيلا"],["0C4038FD-D6EE-55CF-8EA3-36698DEDC32A","لَمْ يَتَّرِكْ في المَجْدِ مَنْ جَعَلَ النَّدى","في مالِهِ لِلمُعتَفِينَ وَكِيلا"],["A236E414-6461-5E89-870F-0459794395B6","أَولَيسَ عمْروٌ بَثَّ في الناسِ النَّدَى","حتّى اشتَهَينا أَن نُصِيبَ بَخِيلا"],["FACEE44E-678C-57DC-AEA6-EAD111D13DB6","أشدُدْ يديك بحبلِ نوحٍ مُعصماً","تلقاه حَبلاً بالندى موصُولا"],["C0016489-A21B-5AA1-BA58-DD2BB26FE5CD","ذَاكَ الَّذي إِنْ كَانَ خِلَّكَ لم تَقُلْ","يا لَيْتَني لَمْ أَتَّخِذْه خَليلا"]]},"AB0428D8-5967-5DFF-BAF7-E6AF98A662D1":{"t":"يومَ الفراقِ لقد خلقتَ عظيما","p":102,"s":"يوم الفراق لقد خلقت عظيما","r":"451054","v":[["9C14A173-D005-57C6-896C-154B92AD9F79","يومَ الفراقِ لقد خلقتَ عظيما","و تركتَ جسمي لا سقمتَ سقيما"],["66531698-2942-56A3-9870-A685E3171C0D","ما للفراقِ تفرقت أعضاؤهُ","ما زَالَ يَعْصِفُ باللقِاءِ قَدِيما!"],["3F1A99B9-5006-5401-898D-9ABB3FF4BF0D","ما زِلْتُ بعدَكَ يا أَخي في حَسْرَةٍ","و تلددٍ حتى أراك سليما"],["2B9F8D90-2E57-510E-B646-344448E3C901","اقْرَ السّلامَ عليكَ مِني كُلَّما","جرت الرياحُ فانشقتكَ نسيما"]]},"C528E772-8D55-51B8-A4B6-880D89B632D2":{"t":"يَا أَكْرَمَ النَّاسِ آبَاءً ومُفْتَخَرَا","p":102,"s":"يا أكرم الناس آباء ومفتخرا","r":"451366","v":[["C89BC7A8-AEBD-52A9-890C-EA69A9FBF560","يَا أَكْرَمَ النَّاسِ آبَاءً ومُفْتَخَرَا","وألامَ الناسِ مبلواً ومختبرا"]]},"E1BCD409-81BA-50C9-88F2-F073F6C32653":{"t":"يَا وَارِثَ المُلْكِ إنَّ المُلْكَ مُحْتَبسٌ","p":102,"s":"يا وارث الملك إن الملك محتبس","r":"451180","v":[["A680C83F-780C-58B2-AFCD-DFEE9513110F","يَا وَارِثَ المُلْكِ إنَّ المُلْكَ مُحْتَبسٌ","وَقْفٌ عَليْكَ إلى أَنْ تُنشَرَ الصُّوَرُ"],["74884955-01D5-5B26-9C5A-74B1D56BEEA1","لم يذكر الجودُ إلاَّ خضتَ واديهِ","ولا انتُضِي السَّيْفُ إلاَّ خافَكَ القَدَرُ"],["87CAAFC9-63BD-59EF-9508-59041B5A1B8D","ما ضرَّ مَنْ أصْبَحَ المأْمُونُ سائِسَهُ","أَنْ لم يَسُسْهُ أبو بَكْر ولا عُمَرُ"],["DF241DF4-1B0B-5191-8A76-EA7DEDEA9590","وما على الأرضِ والمأمونُ يملكها","أنْ لا تضيءَ لنا شمسٌ ولا قمرُ"]]},"CEE7B022-AAF9-5C8A-B084-CA5254DC1A41":{"t":"يَدُ الشَّكوى أَتَتْك على البريدِ","p":102,"s":"يد الشكوى أتتك على البريد","r":"451007","v":[["5F8E3B57-4737-56E7-A5C9-08D096F433A8","يَدُ الشَّكوى أَتَتْك على البريدِ","تمدُّ بها القصائدُ بالنشيدِ"],["EA4C358E-F76D-54E9-921F-08884D166EDC","تقلبُ بينها أملاً جديداً","تَدرَّعَ حُلَّتيْ طَمعٍ جَديدِ"],["271AEC37-0EE4-5931-BDB2-8069BE6CA176","شَكوتُ إلى الزَّمانِ نُحُولَ جِسْمي","فارشدني الى عبدِ الحميدِ"],["9B5E306B-9CD5-5E05-9C4D-E071A9FBBD2A","فجئْتُكَ راكباً أَملَ القوافِي","على ثقةٍمن البلدِ البعيدـِ"]]},"E64F457B-639C-540B-88F8-98BFD226C919":{"t":"يَصُدُّني عَنْ كَلامِكَ الشَّفَقُ","p":102,"s":"يصدني عن كلامك الشفق","r":"451265","v":[["AC0E1E83-6933-5DB5-A339-C5C0D8FFFD86","يَصُدُّني عَنْ كَلامِكَ الشَّفَقُ","فالرسلُ بيني وبينك الحدقُ"],["B71D544F-3C50-593B-8FDA-C9DA654A2A39","حَدِيثُنا في الضَّمِيرِ مُتَّفِقٌ","وأمرُنا في الجَمِيعِ مُفْتَرِقُ"],["9D2DAF97-5778-564F-9BC1-4A7F99C01A13","تُوحِي بأسرَارِنا حَوَاجِبُنا","و أعينٌ بالوصالِ ترتشقُ"]]},"285519CB-4D6E-5936-AB40-7539CFE98C80":{"t":"يُترجِمُ طَرْفي عن لِسَاني بِسرهِ","p":102,"s":"يترجم طرفي عن لساني بسره","r":"451329","v":[["C4B34829-3088-5D23-A862-3C69EB7C7E28","يُترجِمُ طَرْفي عن لِسَاني بِسرهِ","فيظهرُ منْ وجدي الذي كنتُ أكتمُ"],["0DE20FFD-A722-578B-8BF7-9342D7137D3E","أليسَ عجيباً أنَّ بيتاً يضمني","وإياكَ لا نخلو ولا نتكلَّمُ؟!"],["732B989E-7189-5FE1-902F-99871525C535","إشارةُ أفواهٍ وغمزُ حواجبٍ","وتَكسِيرُ أبْصارٍ وطَرْفٌ يُسَلمُ"],["A60236F6-9144-55B5-AD5E-2BEF52C805F3","وألسننا ممنوعةٌ منْ مرادِنا","وأبصارُنا عنَّا تجيبُ وتُفهمُ!"]]}}}