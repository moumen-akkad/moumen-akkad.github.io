{"v":1,"poems":{"3CFB588F-93F6-56A4-B9B8-FEA5417D458B":{"t":"يا من رأى البرق على الأنعم","p":136,"s":"يا من رأى البرق على الأنعم","r":"460024","v":[["D91A0FCC-63F3-55FF-8C2C-5761FDB96A64","يا من رأى البرق على الأنعم","يَطْوِي بِسَاطَ الغَسَقِ المُظْلِمِ"],["2A4523D1-FA10-5737-8671-6E3C8406902C","محمرة منه كفاف الدجى","نَضْحَ جِرَاحِ الفَرَسِ الأدْهَمِ"],["D8402187-7532-5CE9-A9B0-66F59156786F","قام نساء الحي يقبسنه","نَاراً مِنَ الإيمَاضِ لمْ تُضْرَمِ"],["AB8EC22B-A493-5820-B474-F4ED532C836F","تطاول المنجد ضنا به","وقد عطا للبلد المتهم"],["BBEF9F6C-79CC-5221-9D53-F98C1D07DC88","حَتّى رَمَى الإصْبَاحَ في لَيْلَةٍ","لفت إزار الرجل المحرم"],["C0F31570-CEAB-52A3-BFC1-1D4A9B246D17","لا جَازَ مَغْنَاهُمْ بذاتِ النّقَا","قَطْرُ الغَوَادِي وَطِلالُ السُّميّ"],["1F408837-076F-5BC4-AA5C-717010B1FC38","وَلّوْا عَلى قَلْبي عَنِيفَ الجَوَى","يُعَاقِبُ القَلْبَ، وَلَمْ يُجرِمِ"],["DBD4B1B3-5DB6-5464-AA3C-91BB4ECFB2F1","الله في طرفٍ بكم دامعٍ","دامٍ، وَقَلْبٍ بِكُمُ مُغْرَمِ"],["EB35CCF8-6D66-523E-A58F-3B0A993B8CEE","لا يَتْعَبُ العَاذِلُ في حُبّهِمْ","قَدْ ذَهَبَ السّهْمُ بقَلْبِ الرّمي"],["2BDFC77D-14C5-5EEA-91E5-233DDA43DA4F","عيني مع اليقظى غراماً بهم","وَعَينُ مَنْ يَلْحَى معَ النُّوَّمِ"],["DBE3F493-5E2D-52A5-89F1-697E4C647F67","لولا قوام الدين ما استوسقت","أعناقها في السنن الأقوم"],["F0325693-959C-5ECB-9AC9-656E0B522191","ولا أينا النّجم ذا خفية","من قارع الحافر والمنسم"],["97F64334-6313-558F-A275-2718EE30FAC6","يغير للمجد إذا غيره","أغَارَ للسّلّةِ وَالمَغْنَمِ"],["2C77E7F0-A6CB-5044-94BD-012AF4990410","لا يصحب الأغماد من لم تزل","سيوفه في حلل من دم"],["4054E080-2FB4-5E0D-AC5A-BAFC94D4B83D","لِلَّهِ نَعْلٌ حُذِيَتْ في العُلَى","أخمص ذاك العارض المرزم"],["909F82AE-DA9B-5195-86B5-E668AC6090B1","يودّ لو أصبح شعسا لها","نِجَادُ عُنْقِ المَلِكِ الأعْظَمِ"],["BCB3F935-546D-59C3-93A3-763F25313FA2","أغَرُّ مِنْ غُرٍّ رَبَوْا في العُلَى","وأفصحوا بالكرم الأعجم"],["5D0BCE81-E1E9-5295-8685-3F406FE24530","بنوا على مضطربات القنا","بِنَاءَ عِزٍّ غَيرِ مُسْتَهدِمِ"],["6B41C31D-D5A0-5EF8-A86C-0CACDA702811","تُشَبّ بِالمَنْدَلِ نِيرَانُهُمْ","لِطَارِقِ اللّيْلِ، وَلَمْ يُظْلِمِ"],["4AE51414-9EDF-5C0E-81BE-0957F863E7D7","لا يدفع الأضياف منهم إلى","مَمْنُونِ زَادٍ وَقِرًى مُعتِمِ"],["03C9F47C-BA9A-59E6-B24B-02F67E62C969","قَلّتْ عُيُونُ النّاسِ عَنْ نَيلِهم","فَعَوّذُوا مِنْ أعْيُنِ الأنْجُمِ"],["8529FC3E-A95F-52D7-9C3E-0A0AFE146FC2","أساود تنتجها في العلى","أسد إلى أمثالها تنتمي"],["06094987-CDA0-5695-8500-871367972EAB","فيخرج الأرقم من ضيغم","ويخرج الضيغم من أرقم"],["EA4E157E-8843-5FC8-809F-DC47BBB95AA4","سُمّيَتِ الغَبرَاءُ في عَهْدِهِمْ","حمراء من طول قطار الدم"],["2BF7546B-8CA0-50DD-97DF-EC90D55CB887","تحمرّ منها كلّ مخضرّة","كأنَّ لا نبت سوى العندم"],["E5CB0F41-3BD1-590A-9464-74FF4254D6C7","كل فتى يفضح أطواقه","وجه مضيء الجيد والملطم"],["26153FDF-5808-5FE5-A216-6D8651431671","للبشر في ديباجه لامع","طِرَازُ عَصْبِ اليَمَنِ المُعْلَمِ"],["67C3C35B-31C9-5D68-95F6-E7D0C65A5DBD","قوم رباط الخيل في دورهم","كالبهم في غامد أو يقدم"],["502A2C32-AFA3-5D7A-8464-DBD4B6239562","مِن كُلّ مَحبوكِ القَرَا مِحصَفٍ","أُمِرّ فَتْلُ الرّسَنِ المُبْرَمِ"],["1155F3D2-3361-5B10-A71C-1F586A76C49B","كأَنّه ينظر مستوجساً","ربيئة قام على مخرم"],["93D61150-CC45-5515-9523-FFAD64E10F91","مَتَى أرَاهَا كَذِئَابِ الغَضَا","تُحَرِّضُ الهَائِبَ بِالمُقْدِمِ"],["1DE705D0-C734-59F9-B650-D9B843E59E53","أعنة الفرسان أعرافها","عجلى عن المسرج والملجم"],["12B0E1A6-CD4F-5F42-B5B2-EF8DAE8CB265","من فارس يحمل أسد الشرى","لمُلتَقَى يَوْمِ رَدًى أيْوَمِ"],["618A3BE1-A8E6-5A16-8DB3-1A166FB3DCBE","ترمي جبال لثلج من قدحها","نَارَ الوَغَى بالشّرَرِ المُضْرَمِ"],["14074E0C-7687-5F50-A662-5847E3A531DB","أرْعَنُ قَدْ كَدّرَ مَاءَ الحَيَا","في مزنه بالرهج الأقتم"],["CC906B47-612F-5908-B13E-AE58BDEF24EC","يوم يود القرن لو أنهُ","يزيد في الرّمح من المعصم"],["FE356849-5A3E-5C01-AA06-34264F473744","كم قلة ممتنع طودها","إلاّ عَلى ذِي الجُدَدِ الأعْصَمِ"],["18CB7B44-A14B-50DB-9086-D17E9A4F400D","قد أمست الخيل ضيوفاً بها","للوعل العاقل والقشعم"],["82A3EF28-2FB2-5346-8145-14AC86F44EB8","ثَلَّمتَهَا كَيداً، وَكَمْ شابَكَتْ","أيْدِي المَقادِيرِ وَلَمْ تُثْلَمِ"],["CA1FDB4A-793A-5199-A8D7-C1CFD12D1DB2","يخال باقي روق أطوادها","باقيَ أنياب فم الأهتم"],["AE56405D-243A-59BC-B2D7-297113200BAD","قد ينفذ الحلم على غرزة","بمحفظات الغادر المجرم"],["40F43A5F-CD47-5CC8-B145-C1B2BB70088A","وطول نزف النغب يفنى به","غمر جمام الغدق المفعم"],["D08DB64B-0D9D-507C-A641-6E4ABC4EA98E","أقدم للحين ويا ربما","أجلَى الوَغى، وَالغُنْمُ للمُحجِمِ"],["C2BB0179-0774-5BD7-93C8-F53C0A9699E9","يسلم كعب الرمح مستأخراً","ويوقع الأقدام باللهذم"],["665FA193-F85B-572F-9F55-EC6ACA679C75","ما كان إقداماً ولكنه","تسرع العير على الضيغم"],["8E7D7792-A875-5369-BD24-D1DE0DCCAA2F","وَلّى، وَقَدْ أرْدَفَ هَدّارَةً","يَقْظَى عَلى اللّيْلِ لَغُوطَ الفَمِ"],["75962A6A-A39C-5D85-B707-3218833364C7","لا يُؤمَنَنْ، بَعدَ كَلالِ الشَّبَا","كَمْ صَائِلٍ بالسّاعِدِ الأجْذَمِ"],["1608FF0C-2AF7-5DA4-A2E3-FC5C78BCCF3E","قد يهلك النسر وفي ريشه","عون الردى الجاري مع الأسهم"],["FC6A3407-7CAA-5FC5-B649-77A049CB5BF2","يثمّرُ المال ويأبى الغنى","إلا من الذابل والمخذم"],["9C357DF0-15F2-5DB9-8B62-A65B8B0272BD","لا يَدْخَرُ الضّيغَمُ مِنْ قُوتِهِ","ما يدّخر النمل من المطعم"],["1AF7B261-A020-5F55-B966-B8FEE408B017","لا تَستَشِرْ غَيرَكَ في كَيّهَا","قد بلغ الداء إلى الميسم"],["DA2DC5E7-4D83-57AE-8175-BDA35B987AF8","وَاخطُبْ على سَيفِكَ بِكرَ العُلَى","فقد تملأت من الأُيّم"],["B905EAC6-84D6-5D55-8425-A0907340F431","حُسَامُكَ النّصْرُ، فَصَمّمْ بِهِ","وَدِرْعُكَ الإقْبَالُ، فَاستَلْئِمِ"],["A9647AB9-1BA3-5697-9A82-56C67D90CF5A","لا يصلح الناس لأربابهم","غير بياض السيف والدرهم"],["D400B7D1-8B04-565D-8729-C4C5EE4CFA5D","يا مُلْبِسِي النُّعْمَى التي أوْرَقَتْ","عُودي مِرَاراً وَكَسَتْ أعظُمي"],["CD29B725-5C47-535C-ABF9-5D2795B707CB","وَمُطْلِعي في رَأسِ عَادِيّةٍ","تَخْسَأُ طَرْفَ الجَذَعِ الأزْلَمِ"],["31218390-EFF0-5988-ADB1-1ECCF7683803","نَزْعُ العُلَى عَنّي كَإلْبَاسِهَا","وَالغُنْمُ بالبَذْلَةِ كَالمَغْرَمِ"],["826D17FA-F5A3-5BD3-B61E-9A8CC7FB97CC","أُكْرَمُ عَنْهَا، وَبِهَا مَرّةً","كِلاهُمَا عِنْدِي مِنَ الأنْعُمِ"],["714E0C13-D4F9-5E16-8650-775EB55F24D8","وَكَيْفَ نَوْمُ المَرْءِ مِنْ تَحتِهِ","دونَ الكَرَى مُضْطَرَبُ الأرْقَمِ"],["12836CD2-8B32-5A63-B374-1BBCACE015B8","بَينَ خِصَافَيْ نَعْلِهِ شَوْكَةٌ","إنْ شَدّدَ الوَطْءَ عَلَيها دَمي"],["6180CFDE-6EE6-5476-822F-8065E1B53CA4","فأملك بها رقي وحرّر بها","عُنقي، وَرِقُّ الحُرّ للمُنْعِمِ"],["3704E3B8-06EB-5CA9-AFD1-237B1AAFDAC7","وَحُزْ بِهَا مَا بَقِيَ العُمْرُ لي","صَفَاءَ قَلْبي، وَصَفَايَا فَمي"],["419D0590-18AB-564D-9BF7-7FC4251C246F","غوثك منها ياغياث الورى","قد ثقل العبءُ على المهرم"],["958E97B1-A8D4-5143-B5D1-40A03CFB0A95","صونوا بها عرضي ووجهي معا","صونهما في الزمن الأقدم"],["ED44EAE3-0518-5146-871B-D7A30744BC08","لا تحسبوا أني على جرأتي","أحجمت حتى ضاق لي مقدمي"],["AEA2903A-3051-56D4-8ABF-F209E321D54F","ما لان عودي في يدي غيرها","يوماً ولا خار على معجم"],["AD40775E-6C92-5D83-8091-75624EC277FF","عَطْفاً عَلَينَا أنْ يَقُولَ امرُؤٌ:","إن علوق المجد لم ترأم"],["C9D6A928-B711-5AD4-A69F-8D0D3ABA89D6","يخدع بالشهد مذاق الفتى","وَرُبّمَا آلَ إلى العَلْقَمِ"],["83977A51-719E-5DE4-9D1E-6E5172776F4F","عظيمة ناديت من ثقلها","بالبَازِلِ النّاهِضِ بِالمُعْظَمِ"],["DEECDE42-D41A-5498-8A75-15D6B5B21486","عادات إحسانك أمثالها","قَدْ لَؤُمَ الدّهْرُ بِهَا، فاكرِمِ"],["8D89057B-8D5F-5E1E-84B2-96BBB86640B0","وطل وصل واعف وهب وانتقم","وابق ودم واعل وثب واسلم"]]},"EE0BC619-64C4-5CB5-8721-45546A2218A8":{"t":"يا يوسف ابن ابي سعيد دعوة","p":136,"s":"يا يوسف ابن ابي سعيد دعوة","r":"459839","v":[["88C6604E-EB30-5FBA-A395-77C8FBEC97D6","يا يوسف ابن ابي سعيد دعوة","اوحى اليك بها ضمير موجع"],["CE1C93F3-8D3C-5B30-B1B1-6F94ED366F12","إنّ الفَجائِعَ بالرّجَالِ كَثِيرَةٌ","وَلَقَلّ مَن يَرْعَى وَمَن يَتَفَجّعُ"],["6C41F79B-FF3F-55AA-8071-3F1BEE3D1B6B","لما رأيت الناس بعدك نكبوا","سننن الحفاظ فغادر ومضيع"],["27894B40-F7A9-5FA2-8D35-F803DFD3041E","قرطست في غرض الوفاء بقولة","لأكونَ بَعدَكَ حافِظاً ما ضَيّعُوا"],["0EA4C749-069F-5D0A-A965-09ABD278EE73","من كان اسرع عند امرك نهضة","قَدْ بَاتَ، وَهوَ إلى سُلُوّكَ أسرَعُ"],["1DF6921B-4937-5390-B23B-1C00AC5BF5EB","كم من أخٍ لكَ لم يَدُمْ لكَ عَهدُه","قد كانَ مِنكَ بحَيثُ تُثنى الإصْبعُ"],["A410BFD1-986F-5235-A453-7817AB2A0D05","لمْ يُنسِنَا كافي الكُفَاةِ مُصَابَهُ","حَتّى رَمّانَا فيكَ خَطبٌ مُظلِعُ"],["6B29C612-94DF-5A7C-B7C9-013830A86108","قِرْفٌ عَلى قَرْحٍ تَقارَبَ عَهْدُهُ","إنّ القُرُوفَ على القرُوحِ لأوْجَعُ"],["D9B24A40-D403-583A-98D9-2B96D40A8A74","وتلاحق الفضلاء اعضم شاهد","ان الحمام بغير علق مولع"],["B81870EB-7F41-5D96-8599-F3A8F292B97A","واهاً له لو كان اسرٌ يفتدى","برَغِيبَةٍ أوْ كَانَ خَرْقٌ يُرْقَعُ"],["6E4DD6BE-E751-54BC-A4F7-AA3AA74358C9","في كُلّ يَوْمٍ للنّعُوشِ مُشَيِّعٌ","منا يرف وراجع يسترجع"],["87B84F0C-B194-55EF-B98B-3930EF12A5BC","كيف الغرور وللفناء ثنية","ويد المنون تشير ثم المطلع"],["8B6DCD31-17C8-5CE0-8815-842CBAC9B894","وَلَرُبّ أصْغَرَ عَاقِدٍ عِرْنِينَهُ","أمسَى لَهُ في الأرْضِ خَدٌّ أضرَعُ"],["59222020-4AE2-525B-824A-D089E714C9C4","ما كنت ابخل ان اطيل لو انه","يُجدِي المُطيلُ إذا أطالَ وَيَنفَعُ"],["A2976974-678B-57D0-8066-48610B9BA8B7","لكنه سيان من تجرى له","عِندَ الفَجَائِعِ دَمعَةٌ أوْ أدمُعُ"]]},"1F2972C5-F1AA-5DA5-848D-4136608D99B1":{"t":"ياذا المعارج كم سألتك نعمة","p":136,"s":"ياذا المعارج كم سألتك نعمة","r":"459762","v":[["8D3C7BC3-19BD-54BC-B100-7154710D9BAE","ياذا المعارج كم سألتك نعمة","فَمَنَحتَنِيهَا بِالذَّنُوبِ الأوْفَرِ"],["EA198546-A708-5395-8E0F-49DC51B9AD12","أيّ العَوَارِفِ مِنكَ أشكُرُ فَضْلَهُ","عَجَزَ المُقِلُّ وَزَادَ طَولُ المُكْثِرِ"],["6A1B62C2-CC5B-5036-B279-3E23D721F648","اكفأتني ما قد حذرت وقوعه","أمْ مَا كُفِيتُ من الذي لمْ أحْذَرِ؟"]]},"2718DAD3-DD57-5F40-B1DC-1AC5B7789E05":{"t":"يعبن موتاهم باحياثهم","p":136,"s":"يعبن موتاهم باحياثهم","r":"459614","v":[["8365630D-1074-5470-8259-8C1EFC5FCDB7","يعبن موتاهم باحياثهم","كما يعاب الحي بالميت"],["BF40866C-ED25-5B18-B460-A7E38B88D6E1","قَوْلُكُمْ زُورٌ، وَقَوْلي لكُمْ","يبقَى بَقَاءَ الجَبَلِ المُصْمَتِ"]]},"B9E3F0A4-7867-5EDC-AFBC-84134AED239A":{"t":"يفاخرنا قوم بمن لم يلدهم","p":136,"s":"يفاخرنا قوم بمن لم يلدهم","r":"459671","v":[["6D162E96-2FAC-5925-899D-259F76025D5E","يفاخرنا قوم بمن لم يلدهم","بتيم اذا عد السوابق اوعدي"],["12BFB731-5BF1-563E-BB96-9CDB2FF6716B","وَيَنسَوْنَ مَنْ لَوْ قَدّمُوهُ لقدّموا","عِذارَ جَوَادٍ في الجِيادِ مُقَلَّدِ"],["844F85FF-45DC-55A3-A9A7-0A8CA2B80EBD","فتى هاشم بعد النبي وباعها","لمرمى على أو نيل مجد وسؤدد"],["9DE916B5-4691-5584-B81F-1BC05DCE4178","وَلَوْلا عَليٌّ مَا عَلَوْا سَرَوَاتِهَا","ولا جعجعوا منها بمرعى ومورد"],["1A1C7E6C-CA9B-5B94-A891-391158D937DA","أخَذْنا عَلَيهِمْ بالنّبيّ وَفَاطِمٍ","طِلاعَ المَساعي من مَقامٍ وَمَقعَدِ"],["C6C45DFA-E479-52A8-9A7E-BA6BF441074C","وطلنا بسبطي احمد ووصيه","رِقابَ الوَرَى من مُتهِمينَ وَمُنجدِ"],["6BD74B0B-5588-5F56-B28F-90D36682A071","وحزنا عتيقاً وهو غاية فخركم","بمولد بنت القاسم بن محمد"],["04863521-CA93-53A9-B74F-12C5ACA863B8","فَجَدٌّ نَبيّ ثمّ جَدٌّ خَلِيفَةٌ","فَما بَعدَ جَدّينَا عَليٍّ وَأحمَدِ"],["A9A9068B-1F0C-5571-8692-0C2EF92C4BE7","وَما افتَخَرَتْ بَعدَ النّبيّ بغَيرِهِ","يَدٌ صَفّقَتْ يَوْمَ البَياعِ على يَدِ"]]},"28D50744-9AEB-5982-A1CF-031A61A33327":{"t":"يقر بعيني ان ارى لك منزلاً","p":136,"s":"يقر بعيني ان ارى لك منزلا","r":"459559","v":[["BB3545B9-401F-516C-A498-D9259413EBEA","يقر بعيني ان ارى لك منزلاً","بنعمان يزكو تربه ويطيب"],["FC385659-E960-59FB-BBD5-6713707EDB42","وَأرْضاً بِنُوّارِ الأقَاحي صَقيلَةً","تَرَدَّدُ فيهَا شَمْألٌ وَجَنُوبُ"],["1039AD19-BFF7-5F8C-9B2C-6681C334A7B1","واي حبيب غيب الناءي شخصه","وَحَالَ زَمَانٌ دُونَهُ وَخُطُوبُ"],["BDEE61F5-4219-5872-8600-1283337547C4","تطاولت الاعلام بيني وبينه","واصبح نائي الدار وهو قريب"],["2D59DB26-B0F2-56B8-B69B-35D0CEE427EF","لك الله من مطلولة القلب بالهوى","قَتيلَةِ شَوْقٍ، وَالحَبيبُ غَريبُ"],["A1649E76-8404-5A14-8326-4553E866F41C","أُقِلُّ سَلامي إنْ رَأيْتُكِ خِيفَةً","وَأُعْرِضُ كَيما لا يُقَالَ مُرِيبُ"],["DD52B718-75AA-50A8-96FB-D7CC72C52127","واطرق والعينان يومض لحظها","إلَيكِ، وَمَا بَينَ الضّلوعِ وَجيبُ"],["6D29AA3B-15B1-5566-A866-A31E937B3679","يقولون مشغوف الفؤاد مروع","وَمَشغُوفَةٌ تَدْعُو بِهِ فَيُجيبُ"],["2501084C-5FA7-513C-BA63-68F228A4E012","وما علموا انا الى غير ريبة","بقاء الليالي نغتدي ونؤب"],["097DFF99-10B9-5DC8-9293-2877B4ED213C","عَفَافيَ مِنْ دُونِ التّقِيّةِ زَاجِرٌ","وَصَوْنُكِ من دونِ الرّقيبِ رَقيبُ"],["F415B829-AA87-502A-979A-9A5209AC2303","عشقت ومالي يعلم الله حاجة","سوى نظري والعاشقون ضروب"],["923847FF-DDC4-51CF-8AA9-8D6EF87D5AF0","وما لي يالمياء بالشعر طائل","سوى ان اشعاري عليك نسيب"],["CF3939B3-5083-5718-955E-36C439FA7C93","أُحِبّكِ حُبّاً لَوْ جَزَيْتِ بِبَعضِهِ","أطاعَكِ مِنّي قَائِدٌ وَجَنِيبُ"],["35395F28-ABC5-5009-B03C-1BD498B7544F","وفي القلب داء في يديك دواؤه","إلاَ رُبّ داءٍ لا يَرَاهُ طَبِيبُ"],["DAAD3060-B660-5C26-913F-B52B8CCBDE0D","سرى لك من اوطانه كل عارض","تَضاحَكَ فيهِ البَرْقُ وَهوَ قَطُوبُ"],["DAB8B642-4A5F-536D-820E-B660942F4739","ولا زال خفاق النسيم مرقرقاً","عَلَيْكِ، وَأنْوَاءُ الغَمَامِ تَصُوبُ"]]},"4F31C958-DE67-5DB7-8238-76274B198E56":{"t":"يقولون ماش الدهر من حيث مامشى","p":136,"s":"يقولون ماش الدهر من حيث مامشى","r":"459859","v":[["E2A722CD-549B-5D1E-BE03-5139D37995E9","يقولون ماش الدهر من حيث مامشى","فكيف بماش يستقيم واظلع"],["B24A912A-8840-5ACE-BA28-BE243AC96210","وما واثق بالدهر الا كراقد","على فضْل ثوْبِ الظّلّ وَالظلُّ يُسرِعُ"],["FF569D22-F8CC-5DB1-B54D-2A937E45FB5C","وَقالُوا: تَعَلّلْ! إنّما العَيشُ نوْمةٌ","يقضى ويمضى طارق الهم اجمع"],["91CB812C-B7A0-5E8F-8405-1AEA7E1933CE","ولو كان نوماً ساكناً لحمدته","وَلَكِنّهُ نَوْمٌ مَرُوعٌ مُفَزّعُ"]]},"F8E07171-58B9-5413-ABD0-13C76AB04AC1":{"t":"يقولون نم في هدنة الدهر آمناً","p":136,"s":"يقولون نم في هدنة الدهر آمنا","r":"459774","v":[["1DCCC11A-002F-5DEE-AEB3-413BF7E466B2","يقولون نم في هدنة الدهر آمناً","فقلتُ: وَمَنْ لي أنْ يُهادنَني الدّهرُ"],["89244189-5CC3-556A-92CD-C819867AFAF2","هل الحرب الا ماترون نقيصة","منَ العُمرِ، أوْ عُدمٌ منَ المالِ أوْ عُسرُ"],["332BA375-15D7-5148-B797-CBAD61106C94","فَلا صُلْحَ حتّى لا يَكُونَ لِوَاجِدٍ","ثَرَاءٌ، وَلا يَبْقَى عَلى وَافرٍ وَفْرُ"]]},"88423E47-ADEB-5592-85C6-7A2E205D96FB":{"t":"يَا آمِنَ الأقْدارِ بَادِرْ صَرْفَهَا","p":136,"s":"يا آمن الأقدار بادر صرفها","r":"459616","v":[["E776FEE0-ED22-54A6-B412-CE432A11A0B8","يَا آمِنَ الأقْدارِ بَادِرْ صَرْفَهَا","و اعلم بان الطالبين حثاث"],["E7520695-77AA-5ADD-A036-E59BBB81B179","خُذْ مِنْ تُرَاثِكَ ما استَطَعتَ فإنّما","شركاؤك الأيام والوراث"],["29AA1466-B5C5-5436-8A86-DAB77E44881B","لم يقض حق المال الا معشر","وَجَدُوا الزّمَانَ يَعيثُ فيهِ، فَعاثُوا"],["17B6DD77-3215-5F11-BDFC-D9FF3B694D07","تحثوا على عيب الغني يد الغنى","وَالفَقْرُ عَنْ عَيْبِ الفَتى بَحّاثُ"],["BCD8A50F-EC45-58BF-A241-EF3A29F9B4A2","المال مال المرء ما بلغت به الشـ","ـشّهَوَاتُ، أوْ دَفَعَتْ بِهِ الأحداثُ"],["12EA4DB5-1232-5327-B426-7B5741197F0D","ما كان منه فاضلاً عن قوته","فَلْيَعْلَمَنّ بِأنّهُ مِيرَاثُ"],["F104F8BB-5F71-53F2-812E-C05AA3754E47","مالي إلى الدنيا الغرورة حاجة","فليخز ساحر كيدها النفاث"],["8B0BB6F7-04A6-59F8-85B7-E2E41C7A22D0","طَلّقْتُهَا ألفاً لأِحْسِمَ دَاءَهَا","وَطَلاقُ مَنْ عَزَمَ الطّلاقَ ثَلاثُ"],["1E98BA2E-8161-54B1-B514-14FD5DF84D69","سكناتها محذورة وعهودها","مَنْقُوضَةٌ، وَحِبَالُهَا أنْكَاثُ"],["67C7D471-F263-5509-BADE-6EF9991CA53F","أم المصائب لا يزال يروعنا","مِنهَا ذُكُورُ نَوَائِبٍ وَإنَاثُ"],["082139D3-D27B-5D27-A811-28C1D4E017C3","إنّي لأعْجَبُ مِنْ رِجَالٍ أمسَكُوا","بحَبَائِلِ الدّنْيَا، وَهُنّ رِثَاثُ"],["D2B62B5A-1CC0-5F33-8F99-FEF0AB0581B3","كَنَزُوا الكُنوزَ، وَأغفَلوا شَهَوَاتهم","فالارض تشبع والبطون غراث"],["3B7B1192-6826-5B66-89D9-66C3F6F877DE","اتراهم لم يعلموا ان التقى","أزْوَادُنَا، وَدِيَارُنَا الأجْداثُ"]]},"770F07F9-AC37-55EF-8B14-67FD2B501636":{"t":"يَا قَلْبِ جَدّدْ كَمَدَا","p":136,"s":"يا قلب جدد كمدا","r":"459668","v":[["46097F33-B4E3-5D5C-9C46-7C175F333663","يَا قَلْبِ جَدّدْ كَمَدَا","فَمَوْعِدُ البَيْنِ غَدَا"],["1F8F9E6B-3567-546D-99D4-31EED8CE437E","لَمْ أرَ فَرْقاً بَعْدَهُمْ","بَيْنَ الفِرَاقِ وَالرّدَى"],["7BF51F39-48C1-5606-AC3A-9EBB2BFD6717","يَا زَفْرَةً هَيّجَهَا","حاد من الغور حدا"],["22D85D75-5B81-52F1-AA3A-0A2B145225AA","أغْنَى زَفِيرُ العَاشِقِيـ","عيسه عن الحدا"],["B85893E1-2CF5-5B98-968D-E5E463C0C097","ارعى الحمول ناظراً","مُزَاحِمٌ يَقْذِفُ في"],["173FE13E-688B-5D48-9C55-12C62E19AE08","واطرد الطرف على","اثارهم ما انطردا"],["CB0B0755-A1A3-5249-9622-C11EAF5EF1A7","وَمُذْ أذَابُوا مَاءَ عَيْـ","جمر الغضا ما خمدا"],["39298773-C844-58F0-9EAC-1D478FC78DE2","بالاسى ما جمدا","يا هل ارى من حاجة"],["CE14F497-A75E-50C8-B939-08AE805B8843","حقف النقا والجمدا","أنَا الغُلامُ القُرَشِيّ"],["744D8632-3BFE-51A7-B21D-C5BF4A4C8B32","جرعائه وانعقدا","وَهَلْ أُعِيدُ نَاظِراً"],["9632F98B-E851-575A-82F4-1D00E2824F7E","يتبع سرباً منجداً","يمشين هزات القنا"],["282CF027-D716-59F6-9C3D-A5679A7416AC","مَالَ وَمَا تَحَصّدَا","هَلْ نَاشِدٌ يَنْشُدُ لي"],["20430982-CF0D-514E-8D59-859E94CD2CA3","ذاك الغزال الاغيدا","ما ضل عني انما"],["8ACA51F8-A837-54F9-96D4-25655DEEB2AF","ضل بقلبي كمدا","رَهَنْتُهُ قَلْبي، وَمَنْ"],["B8606D7A-BD7F-5EA2-9040-1E32F874ACBB","يَرْهُنُ قَلْباً أبَدَا","يا منجزاً وعيده"],["6B4FE039-ACAE-5EC5-965D-04B8A89BBECF","وماطلا ما وعدا","أرَاكَ مِنّي أقْرَباً"],["831E5796-0C20-5789-B6AA-F61C7F015AF5","وان غدوت ابعدا","عذبت قلبي عنتا"],["E25C1CC5-D96D-595A-9861-595CA498A940","والطرف لا القلب بدا","رب ثنايا بردت"],["26851262-5E19-5EB1-B908-5C4CFFFC71C5","لذي جوى ما بردا","يَا حَرّ قَلْبي! مَنْ سُقي"],["D3206F3D-D8D4-5F6A-B374-457D4E16B1AB","رضابهن الابردا","لم يدر هل ذاق بها"],["BF4F01C4-44ED-54FD-85E5-AF7F0A469CED","جمر غضا أو بردا","يا كبدي تجلداً"],["A58A84E9-3A3F-52E9-87DC-D59AFA82CC75","فما اطيق الجلدا","عَسَى فُؤادٌ يَرْعَوِي"],["69D0283A-64AA-5FEE-960D-F494A5A55E9A","رب مضل وجدا","وَحَمّلَ الحَاجَ الرّمَا"],["08930440-A921-5B20-8575-3B0E7D5DD944","حَ لا الأمُونَ الجَلْعَدَا","اني اذا ما لم اجد"],["FE54C61C-86FB-54B7-972B-A11D02B76CE9","إلاّ الهَوَانَ مَوْرِدَا","كنت اداوي كبدي"],["44A48ADD-D7C3-5B4F-A9DA-6D563F8C5030","لَوْ غَادَرُوا لي كَبِدَا","دَعْ للمَشِيبِ ذِمّةً"],["C9E75420-3C9B-5790-AF91-11EF605E0BB6","إنّ لَهُ عِنْدِي يَدَا","اعتق من رق الهوى"],["03C32A52-BB92-5A41-A450-CA546424940A","مُذَلَّلاً مُعَبَّدَا","لَكِنْ هَوًى لي أنْ أرَى"],["898C2189-135A-55F5-9879-75D85C6C6288","لون عذاري اسودا","شائباً وامردا"],["C04E54D6-D0B3-5047-9643-53491B5C9EDA","ما اخلق البرد فلم","بَدّلَ لي وَجَدّدَا"],["1A5DD135-DC7B-51BD-9064-D9F8E74C1382","لولا تكاليفك لم","أُعْطِ الزّمَانَ مِقْوَدَا"],["82BD06E9-A8F0-5F97-A13A-048BE4700E18","وَلا ثَنَيْتُ عُنُقِي","إلى اللّيَالي صَيَدَا"],["FB251BD0-E9C5-53B5-8943-9FD69418AAAA","سجية من بطل","لازم ما تعودا"],["B2258703-EF71-52F6-A677-AFC6CF4E1060","بايع اطراف القنا","وَعَاقَدَ المُهَنّدَا"],["948B2046-40DD-5D48-8A88-54E5E224832D","شَاوَرْتُ قَلْباً آبِياً","فقال لي لاتردا"],["81F6B986-1554-5A8E-BE16-7E5B423AB15C","إنّي لِقَوْمٍ بَعُدُوا","في المَجْدِ وَالجُودِ مَدى"],["FC4526AF-E16B-5DB5-A2A1-9EC73D5908B7","شوس اذا الباغي بغى","سُمْحٍ، إذا الجَادي جَدَا"],["5E12AE5E-FD20-581C-8A2B-EDBBEEAC03AF","تَفَرّعُوا طَوْدَ العُلَى","وَالجَبَلَ العَطَوَّدَا"],["9435CDC7-CFE3-5BE0-AA4E-D2BA0029E464","مَجْدُهُمُ أقْدَمُ مِنْ","هضب القنان مولدا"],["DBE188CB-2CFD-502E-91E3-D84F0F55BAC0","اصادق في الخطب","للسيف وللمال عدا"],["66494ABB-9472-5F9C-8BCF-24D987F7B08D","إذا اهْتَدَى بِنَارِهِمُ","طارق ليل ما اهتدى"],["0C6383DB-CDDA-5E3B-8FB3-C97E70D73904","تقارعوا على القرى","وَاقْتَرَعُوا عَلى الجَدَا"],["81C2BCEA-A370-5863-8E68-6D8F0D8EFFA8","وَغَارَةٍ في سُدْفَةٍ","توقظ حياً رقدا"],["6BE88506-971F-51EF-A79D-ED23791F93DB","بِضُمَّرٍ أسْقَطَهَا","عليهم مع الندا"],["C6DDB927-40EC-5F26-8E6D-138E88585E2F","تلهب نضاً زعزعا","او قربا عمردا"],["71D59E4F-36B7-5267-9C69-BCA89F673B55","كانني ابعثها","فيهم ثنى وموحدا"],["907BA937-7C4A-574F-B04C-39B336B4D160","يَوْمِ الحِصَابِ جَلْمَدَا","مِنْ كُلّ مَحْبُوكٍ كَما"],["7F1A2455-3654-5811-AC1F-676A2C482D9D","أمَرّ لاوٍ مَسَدَا","يُغْني الفَتى عِنَانُهُ"],["90A60D62-74AD-50C9-A450-73E1CC419E33","عن سوطه اذا عدا","كَأنّمَا فَارِسُهُ"],["DFCAE4AF-E112-505E-AD41-5DE250CD0E93","يَقْدَعُ ذِئْباً أصْرَدَا","أنْزَعُ عَنْ صَفْحَتِهِ"],["DC2D8450-E6F4-5141-B7CD-08B463F80DDA","شوك القنا مقصدا","لَوْ شِمْتَهُ بِبَارِقٍ"],["7301F123-EB0A-537C-A38D-4C8D036F0057","ماء الكلاب اوردا","وكل صل لامظ"],["43415FA8-1B56-5107-8E7B-F0A580E6DCF0","يطلب ريا للصدى","أقْدَمَ مِنْ سِنَانِهِ"],["F91C45CC-7A4D-55E1-B5DC-6AD8C33742E7","اذا الجبان عردا","مَاضٍ، فَإنْ شَمّ طُرُو"],["B99FF5CD-717E-5380-A341-3AB2586EBE67","قَ الضّيْمِ زَاغَ حَيَدَا","يَلْقَى الطّرَادَ جَذِلاً"],["0524E29D-BADB-557A-AD45-B53B5932075C","كَمَا يُلاقي الطّرَدَا","انا الغلام تالقرشي"],["25EB21EF-8E59-556A-B733-417169FABF2C","مُنْجِباً مَا وَلَدَا","أنْزَعتُ دَلوِي قَبْلَكُمْ"],["746170B9-D1D2-54FE-AFFE-DAD8A2E1E848","إلى العِرَاقِ سُؤدُدَا","ما زال عزمي لي عن"],["BD19F954-B660-50E9-9E2D-E5889087E9E8","دار الهوان مبعدا","مُرَحِّلي عَنْ بَلَدٍ"],["4A83BC7E-975B-5175-801E-8F52D808E1D4","وَرَاجِماً بي بَلَدَا","إنْ لَمْ يَكُنْ نَيلُ مُنًى"],["75ECD198-9F8D-5E53-A734-CE4EC6ED8FEC","فابغ اذا ورد ردا",""]]},"8CF28605-B190-55C8-A1CF-B7419B6EFC7C":{"t":"يَا نَاشِدَ النَّعْماءِ يَقْفُو إثْرَها!","p":136,"s":"يا ناشد النعماء يقفو إثرها!","r":"459713","v":[["05EE71CE-2AAE-574B-B018-8F78105E4166","يَا نَاشِدَ النَّعْماءِ يَقْفُو إثْرَها!","قف المطايا قد بلغت بحرها"],["CB90C9DB-C1E1-5286-8862-8956227AE629","مَسِيلُهَا فِينَا، وَمُسْتَقَرُّهَا","طود العلى وشمسها وبدرها"],["FB02BDCA-7DB1-5613-ADA7-8A77E406C041","فَوّضَتِ الدّنْيَا إلَيْهِ أمْرَهَا","وَقَلّدَتْهُ نَفْعَهَا وَضَرّهَا"],["85368E3A-51EE-5481-830B-B7CAD08EBD95","عُدّتْ مَساعِيها، فكَانَ فَخرَها","لم تقذ عين المجد مذ اقرها"],["0CDD95D1-AC21-54A3-B30D-88B54339402C","ذو شيمة تعطي العيون خبرها","لا تحوج الناظر ان يقرها"],["D1162385-0255-57BD-86FC-D29E78DAAF4F","نَرْجُو وَنَخْشَى حُلْوَها وَمُرّها","كجمة الماء نرجي غمرها"],["4A3F31A9-684F-5EA5-A830-4EF36D5AB6E1","يَوْمَ الوُرُودِ، وَنَهَابُ قَعْرَهَا","يبعثها بعث السحاب قطرها"],["CB09C0F7-3385-5862-A9DA-FD69E6F8FE55","محجلات نعم وغرها","شغلتنا حتى نسينا شكرها"],["336F0146-5299-54FC-9082-CAA4B9E413F6","يُهْدِي إلَيْنَا شَفْعَهَا وَوِتْرَهَا","عياب دارين حملن عطرها"],["CE6E4483-990F-51BC-938A-7DD87995A379","إنّ المَعَالي وَلَدَتْكَ بِكْرَهَا","ما ضمنت مثلك يوماً حجرها"],["78E349EF-780D-5F08-9867-1841CF3BC001","اماً رؤما ارضعتك درها","لَوْ ألّفَتْ عَلى النّظامِ نَثْرَهَا"],["D2632ABC-750E-5FC3-AA87-D7BE8F77A84A","قلائد المجد لكنت درها","نرى الاعادي ان عزمت ثغرها"],["A3432AAA-BE40-5944-A3A7-E8750CE047C3","أباغِثَ الطّيرِ تَرَاءتْ صَقرَهَا","فحل وغى يئسي الفحول هدرها"],["85E6F951-5005-56F3-AE47-E0EE6A752495","لاصبحتنا ووقينا شرها","ظَلمَاءُ أمْرٍ لا تكُونُ فَجرَهَا"]]},"B29A203C-F138-5A83-8E2C-1B30A6F1712B":{"t":"يَدٌ في قَائِمِ العَضْبِ","p":136,"s":"يد في قائم العضب","r":"459518","v":[["301F0932-EEBB-5416-BA9F-9F49C958D58C","يَدٌ في قَائِمِ العَضْبِ","فما الانظار بالضرب"],["B38F823E-8D72-57B9-8D1F-23D902CD7DEC","وَقَدْ أمْكَنَتِ الهَامُ","ظبي المطرورة القضب"],["BCEFC294-B2F3-5AAE-B1DB-84B28D6922D7","وَلِلأرْمَاحِ بِالقَوْمِ","حِكَاكُ الإبِلِ الجُرْبِ"],["59088C6D-DA85-5C18-9A40-76F95D0F630B","ينازعن نزاع الذو","د يرمين عن الشرب"],["1F5410D4-A5C8-5E9A-AF0E-CC082AE2F2B4","قِوَامُ الدّينِ وَالدّنْيَا","غياث الازل واللزب"],["F6E915E3-F38A-5643-9E9C-FAE7DED35321","لَزِدْتَ المُلْكَ أوْضَاحاً","إلى أوْضَاحِهِ الشُّهْبِ"],["B690A69B-9554-59FE-849A-354FA1D65621","وَقَرّرْتَ مَبَانِيهِ","عَلى الذّابِلِ وَالعَضْبِ"],["D158953E-5685-520F-9248-F2C5E3C43708","وَأوْضَحْتَ إلى المَجْدِ","منار اللقم اللجب"],["75DE3BC8-DFC4-5042-8DE6-8A0736E9749E","رَأيْنَا المُلْكَ مِنْ بَأسِـ","ك قد دار على القطب"],["D945BB18-B8FC-5BB3-8BE2-4C5561366037","فَقُلْ للخَائِنِ المَغْرُو","رِ: مَنْ أغراكَ بالشّغْبِ"],["C2E25BFE-E7F8-5226-B5E2-DA5193499524","وَمَنْ طَوّحَكَ اليَوْمَ","بِدارِ الأُسُدِ الغُلْبِ"],["BF21BFCF-A1F8-5289-8E0A-EC6DC3EC2691","فاقبلت بمحفار","ك كي تصدع بالهضب"],["DECBDA62-F708-5ACA-BC14-D361EDE9F556","وهيهات لقد طالعك","ـكَ الحَينُ مِنَ النَّقْبِ"],["E07687C7-E441-576B-8A0F-C9E556F2BBEA","ضَلالاً لكَ مِنْ غَاوٍ","سليب الراي واللب"],["02349976-FBD9-583D-A47E-2C1B35B3EB49","أبى العز لبيت الصـ","ان يطرق بالضب"],["00D0149B-232C-58A5-86E7-51CFDDFE4B01","وماذا آنس الكرد","بمن زلزل بالعرب"],["A2B54691-E46C-5EB9-91F4-D787354BD20F","شِمِ السّيْفَ، فَقَدْ قُوتِـ","ـلَ أعْداؤكَ بِالرُّعْبِ"],["56F47054-C0FE-5B25-BB14-51761F09C3B7","وَمُذْ أسْخَطَكَ المَغْرُو","رُ مَا قَرّ عَلى الجَنْبِ"],["004A5130-04EA-53A5-A865-A2FDA58A7FA1","وقدما طله الخوف","مطال المخض للوطب"],["C2D02B81-9DF6-5469-BB7E-73533F0BC0C7","بَغَى السّلْمَ، وَقَدْ أشْفَى","عَلى مَزْلَقَةِ الخَطْبِ"],["FE74010F-360B-5C03-B51C-6220EF6D54F6","وَكَمْ سِلْمٍ، وَإنْ غَرّ الـ","عدى ادمى من الحرب"],["FE6F534F-F387-52E6-85B5-8897C7F5D8B1","نَقَلْتَ الطّعْنَ في الجِلْدِ","الى طعنك في القلب"],["F236BB27-C43E-5891-834D-D92BEAF76DC6","تَقُوا مِنْ رَبْضَةِ اللّيْثِ","فَقدْ يَرْبِضُ للوَثْبِ"],["1246113D-35B0-51AF-8C16-D85846309082","وَخَافُوا نَوْمَةَ الأسيَا","ف في الأغماد والقرب"],["E1B5EB95-B8D7-5F69-9A74-B23B15E17591","سَتُرْمَوْنَ بِهَا يَقْظَى","إذا قَالَ لهَا: هُبّي"],["D027CD91-F482-5803-A2BD-C27A0ECC13BE","قضى اللة لراياتك","بالإظهار والغلب"],["6198472C-3AD0-58FE-A046-AEE1C9A57A65","وَأصْفَاكَ، بِمُلْكِ الأرْ","ضِ مِنْ شَرْقٍ إلى غَرْبِ"],["981AECB5-0147-58D5-A12E-2865CEE29F76","وَأغْنَى بِكَ مِنْ عُدْمٍ","واسقى بك من جدب"],["E96B49AB-83AA-57AD-8C33-AFE1EC34FB66","وولى بأعاديك","مع الزعازع النكب"],["C15EFA42-952A-57BE-A496-73B6C8AA2A83","على آثارهم حدو القنا","ـقَنَا بِالضُّمّرِ القُبّ"],["89F2FCE9-4126-583F-91C1-EF389E817ECD","رفعت اليوم من قدري","وأوطئت العدى عفبي"],["66E457BA-8A52-5040-B0FC-E902AE6A38A2","وَوَطّأْتَ ليَ الرّحْلَ","عَلى عَرْعَرَةِ الصّعْبِ"],["9B68CAAB-32CA-5A56-91AD-FF7D78940765","وحليت لي العاطل","بالطوق وبالقلب"],["EDB04F90-71A0-5DA5-B085-2158F0D92701","ووسعت لي الضيق","إلى المضطرب الرحب"],["99157505-6D27-5587-93F9-C5A40606F790","وَزَاوَجْتَ ليَ الطَّوْلَ","زَوَاجَ المَاءِ للعُشْبِ"],["E670ABF2-80BB-5E65-9FEB-C69C8CF4ACA6","فَكَمْ مِنْ نِعْمَةٍ مِنْكَ","كَعَرْفِ المَنْدَلِ الرّطْبِ"],["DCE6FD06-759F-5D7D-A371-152B65AD29CD","أتَتْني سَمْحَةَ القَوْدِ","ذلولاً سهلة الركب"],["877A5E19-0289-5F7F-9B0B-0AAD61D63AC0","مهناة كما ساغ","زلال البارد العذب"],["1A7DEC7C-143E-58DE-8374-AFB7F585B048","وَلَمْ أظْفَرْ بِهَا مِنْكَ","جذاب العلق بالعضب"],["A8713C93-87EC-513C-9DBF-6FF2C4297A80","وما أنعامك الغمر","بزوار على الغب"],["F2E0606B-CB3B-599C-852A-E3EFEF836F4F","سَقَاني كَرَعَ الجَمّ","بِلا وَاسِطَةِ القَعْبِ"],["67C3A684-3529-5734-A160-9B8184D1CBFC","وأرضاني على الأيا","م بعد اللوم والعتب"],["6BB1BE64-F627-5D74-B6AA-DED02883E0EB","وأعلى المدح ما يثني","به العبد على الرب."]]},"08399CDC-A6BC-5327-8C68-E8B0A1B2DAA3":{"t":"يَعْلَمُ الجَدُّ أنّني لا أُضَامُ","p":136,"s":"يعلم الجد أنني لا أضام","r":"460084","v":[["9401762B-F7B2-5997-B51F-7C5B0F193F36","يَعْلَمُ الجَدُّ أنّني لا أُضَامُ","ومجيري من الزّمان همام"],["50598233-AAAF-58A0-8766-823A467AEB93","لحماني أغرّ شمته الكرّ","ونصلٌ حليّه الأحرام"],["3A73618C-D05C-562D-A477-1AC6436FDCCF","ربّ قول نمي إليَّ وعزمي","غَافِلٌ، وَالهُمُومُ عَنّي نِيَامُ"],["FBDAB338-D488-5F47-A002-681CF5240464","وَتَعَرّفْتُ قَائِلِيهِ، وَلَكِنْ","آهِ لَوْ كَانَ في يَمِيني حُسَامُ"],["6A170B0E-F411-5178-9592-4102E841DD26","كَيفَ تَخدي إليهِمُ الذُّبَّلُ السُّمـ","وتعدي عليهم الأقلام"],["10A54E5B-79DC-5209-ADDC-E2C25365624A","دون أن أقبل المذلّة للعز","ـزِّ إبَاءٌ وَنَخْوَةٌ وَعُرَامُ"],["1DCE3B48-A944-54E3-8784-9DC566B4030B","وطعان تندقّ فيه العوالي","وضراب يزورّ منه الحمام"],["56006C12-7C78-533D-9C7D-A1CA780A8F43","لَسْتُ أدْرِي مَاذا يَقولُ لِسَاني","وفمي للمقال فيه ازدحام"],["0F8E7D14-E0EB-58ED-BB42-21880315D872","وكأنّ الحمام فينا جنيب","يتبع العيش والزمان زمام"],["26972894-392E-525B-9A85-B136074EA34B","فاصرف الهم إنّما العيش يوم","ودع القول إنّما الدّهر عام"],["4C06F332-37F8-5305-94D3-5A81E0EFCCA3","أيها العاجز المكدر وردي","رُبّمَا عَرّفَتْكَ تِلْكَ الجُمَامُ"],["208E8912-DC67-5ADE-A24B-459FAE51A584","فانتَفِقْ في الوِجَارِ، وَاقعُد ذَليلاً","قَدْ كَفاكَ الجُلّى رِجالٌ قِيَامُ"]]},"261EB88C-1765-58DE-A933-28164A859E4E":{"t":"يُصَافِحُهُ نَشْرُ الخُزَامَى كَأنّما","p":136,"s":"يصافحه نشر الخزامى كأنما","r":"459918","v":[["620EA485-B5CF-5A79-B275-5E20A8A23730","يُصَافِحُهُ نَشْرُ الخُزَامَى، كَأنّما","يمسح أعطاف الرماح السواهك"],["85F0CDCE-08A5-5115-892A-ABDDE289D4E1","فجاءت باسد الحديد ترقرقت","عَلَيها بمَاءِ الشّمسِ غُدرُ التّرَائِكِ"],["86F28DBB-6BA8-5EC5-90DF-3016597A400C","بَدَتْ تَزْلَقُ الأبْصَارُ في لمَعَانِهَا","على أنها في ثوب اقتم حالك"],["65BDFD7B-773F-5F7D-9701-E21619548C7D","تُلِفُّ بأعرَافِ الجِيَادِ رِمَاحَها","وتنشر من أطمار بيض بواتك"],["D890BBF8-278B-58CA-84EE-D85EB922F1CA","وَتَنكِحُ أوْتَارَ الحَنَايَا نِبَالُهَا","فتشرد عنها في نصال فوارك"],["F87E7079-C3AC-5940-BDC2-362F699880D2","ألَفَّ بِلألاءِ السّمَاحِ فُرُوجَها","تُبَيّضُ أعجَاسَ القِسِيّ العَوَاتِكِ"],["DF3598F0-7C46-52E1-B995-86C01D337D32","بيَوْمِ طِرَادٍ قَنّعَ الشّمْسَ نَقْعُهُ","تردوا بموَّار الدماء الصوائك"],["A1B14773-C72A-54DD-96C3-153628EC90DA","وَلا يَألمُونَ الطّعنَ حَتّى كأنّهُم","أسرّوا ضُلوعاً من كُعوبِ النيازِكِ"]]},"D2CEB292-2C65-59C2-B1D4-A3E719DED4E6":{"t":"يُعَاقِبُني وَهُوَ المُذْنِبُ","p":136,"s":"يعاقبني وهو المذنب","r":"459589","v":[["AC5CCC80-9F67-516C-ABF1-19AA8AD69090","يُعَاقِبُني، وَهُوَ المُذْنِبُ","لَقَدْ ذَلّ جَارُكَ يا جُنْدُبُ"],["7B45FA39-AE12-5AC6-87B5-D18E5E0C0997","ويعجب من غضبي جهلة","ومن ذا يضام فلا يغضب"],["0F2419D6-DE52-57C4-BDC1-02D3AD6308FE","نُزَادُ مِنَ اللّوْمِ عَنْ وِرْدِكُمْ","فَعَمّ نُزَادُ وَلا مَشْرَبُ"],["6B5B2900-0EF5-564B-8EFE-119005B29000","نعم اعوز الطول راجيكم","فَلِمْ أعْوَزَ الأهْلُ وَالمَرْحَبُ"],["66C9F624-AF9C-5885-8F26-42F927D1B70B","اذا ابلي مطلت رعيها","فهل ينفع البلد المعشب"],["D115DAA0-503F-5052-A0E7-C98EC4B8C383","وَهَلْ نَافِعِي ظَاهِرٌ بَاسِمٌ","وَمِنْ خَلْفِهِ بَاطِنٌ يَقْطِبُ"],["B1FA7A5A-4FE2-5308-90EC-105B4AAA9CAA","لَقَدْ وَقَفَ الرّكْبُ مِنْ بابِكُمْ","على مطلب ماؤه مطلب"],["FAD907F1-4EB6-5ACC-9A6B-B3980A05DD5F","وَمَا كُنْتُ في النّفَرِ الشّائِمِيـ","ـنَ، بِأوّلِ مَنْ غَرّهُ الخُلَّبُ"],["92D03D08-2B95-5E4B-AA60-E28DB49A4847","ذُنَابَى مَصَعْنَ بِأبْعَارِهِنّ","وقد يمصع الذنب الاهلب"],["22C0FEC4-CC94-5339-93A3-084867532CEF","لقد ساءني ان يموت السماح","بموت الكرام ولا يعقب"],["4B146671-733A-5AB8-870D-64565330D60E","ألاَ تَعْجَبُونَ لِذِي سَوْءَةٍ","تحكك في عرضه الاجرب"],["595D5DEA-5050-54A3-922D-48C5B131576E","وجعجع لي ظهر عاري الصفاح","حِ عَقِيرٍ، وَقال: ألا تَرْكَبُ"],["0937B268-94CA-5E0C-BACF-13DECD0519FD","وَسَوْفَ أُغَنّي بِأعْرَاضِكُمْ","غِنَاءً مِنَ الشّرّ لا يُطْرِبُ"],["47A4A521-6194-5BDE-9369-AF1DD6EA68DA","قواف مطلن لحز الجنوب","مطل المدى جرعها موعب"],["80F54509-58AB-5E2F-88DC-E88853B97AD1","وَحَسْبُكَ مِنْ سَفَهٍ أنّني","أجُدّ، وَتَحْسَبُني ألْعَبُ"],["F4C34166-C92D-5C26-B839-2D67BCD5826B","وَقالُوا: احتَلِبْ دَرّهمْ بالسؤا","لِ، إنّ الغَوَارِزَ لا تُحْلَبُ"],["67A13CAC-9203-52D4-A276-A6E14DECE24B","وكيف ولم يرغبوا في الثناء","إلى المَادِحِينَ وَلمْ يَرْغبُوا"],["26D0657A-F5E2-5437-AD46-CD793015762C","لَقَدْ وَسّعَ اللَّهُ مَا ضَيّقُوا","وقد عوض الله ما خيبوا"]]}}}