{"v":1,"poems":{"0CE29C92-4779-5E68-8895-187FD9D85090":{"t":"أراني جمعي من فنائي تقرباً","p":114,"s":"أراني جمعي من فنائي تقربا","r":"477719","v":[["6BBFD269-D1AF-5B1B-888E-167B92BA79A4","أراني جمعي من فنائي تقرباً","وهيهات إلا منك عنك التقرب"],["108A6AFE-7A73-5FA9-9258-012560AEBB5F","فما عنك لي صبر ولا فيك حيلة","ولا منك لي بد ولا عنك مهرب"],["1FB96E14-C5DC-50F5-878B-4E0D6C808066","تقرب قوم بالرجا فوصلتهم","فما لي بعيداً منك والكل يعطب"]]},"C1AFF067-41AF-5FEE-95ED-4856E7BF8291":{"t":"أريد دوام الذكر من فرط حبه","p":114,"s":"أريد دوام الذكر من فرط حبه","r":"477722","v":[["19703148-69FC-52DD-9757-81245E360926","أريد دوام الذكر من فرط حبه","فيا عجباً من غيبة الذكر في الوجد"],["76A7D1FE-E387-5FEC-A0FD-17F183E95D3E","وأعجب منه غيبة الوجد تارة","وغيبة عين الذكر في القرب والبعد"]]},"B7364D35-98C6-5734-A6EC-DB445A1E6BB8":{"t":"أزعجتني عن نعوت الحال بالحال","p":114,"s":"أزعجتني عن نعوت الحال بالحال","r":"477735","v":[["08EDF8E5-394D-5A94-8815-47B275578929","أزعجتني عن نعوت الحال بالحال","فكيف ينعت من لا قال بالقال"],["9D5DCFE1-7BC5-5B46-B145-C71F75E62FB1","ما كل من يدعي حالاً تصدقه","حتى يترجم عنه صاحب الحال"]]},"F88A43A6-2155-59A1-8C3C-1DE4E0C3085D":{"t":"أشار قلبي إليك كيما","p":114,"s":"أشار قلبي إليك كيما","r":"477740","v":[["9D928790-33CB-50A0-88EA-747B951C01B2","أشار قلبي إليك كيما","يرى الذي لا تراه عيني"],["7DA253FE-CF58-5481-87DC-02127A4CF2F4","وأنت تلقي على ضميري","حلاوة السؤل والتمني"],["1AF640A6-B374-50FE-9649-E1BDA920A24E","تريد مني اختبار سري","وقد علمت المراد مني"],["ADE51019-E251-5922-8607-3DA72AB21703","وليس لي في سواك حظ","فكيفما شئت فامتحني"]]},"149D3928-C0BF-5A04-AD9F-777AB697505D":{"t":"أقول أكاد اليوم أن أبلغ المدى","p":114,"s":"أقول أكاد اليوم أن أبلغ المدى","r":"477720","v":[["10E95AE8-15F5-50C5-8607-1D9475E071BA","أقول أكاد اليوم أن أبلغ المدى","فيبعد عني ما أقول أكاد"],["96A14D4A-ECE2-574B-B0DA-AC25BAB026D0","فما لي جهاد غير أني مقصر","وعجزي عن طول الجهاد جهاد"],["C5DEE99B-3764-5062-BDBD-04C27435E3DA","وان رجائي عودة منك بالرضا","وإلا فحظي في المعاد بعاد"]]},"CFD3431D-02D9-532C-A3DE-098C3BDAC948":{"t":"أنعى إليك إشارات القلوب معاً","p":114,"s":"أنعى إليك إشارات القلوب معا","r":"477736","v":[["CACF9108-1471-5D78-B8C6-FAE3963198FB","أنعى إليك إشارات القلوب معاً","لم يبق منهن إلا دارس العلم"],["4CECB38E-5B19-531A-B799-E1A37F74C128","أنعى إليك قلوباً طالما هطلت","سحائب الجود منها أبحر الحكم"],["B98867D0-3063-5E81-AF09-39297AEFFFD9","أنعى إليك نفوساً طاح شاهدها","فيما ورا الحيث بل في شاهد القدم"],["444F35E2-05B1-56F3-8B8D-AB23140B6205","أنعى إليك لسان الحق مذ زمن","أودى وتذكاره في الوهم كالعدم"],["56EAD38A-3D57-5DD7-93A5-4FCBB92BF1D3","أنعى إليك بياناً تستكين له","أسماع كل فصيح مقول فهم"],["392398B7-341E-56E8-BB41-2BB2732C9FF8","أنعى وحقك أخلاقاً لطائفة","كانت مطاياهم من مكمن الكظم"],["C1E2C0EE-1886-5A59-918D-AE4472C09CA0","مضى الجميع فلا عين ولا أثر","مضي عادٍ وفقدان الألى إرم"]]},"211BC352-8C06-53C4-A15B-6086DB9DF40A":{"t":"إذا استتر الحق عن أحد","p":114,"s":"إذا استتر الحق عن أحد","r":"477726","v":[["E630986C-8F2A-5945-A421-DCF4D0627393","إذا استتر الحق عن أحد","لم يهده استدلال ولا خبر"]]},"C1D49B28-C029-598A-AFC0-BCED2B63618F":{"t":"إذا كنت فيما لست بالوصف فانياً","p":114,"s":"إذا كنت فيما لست بالوصف فانيا","r":"477728","v":[["1502631C-5EF6-5A79-9054-8A8DF3F6A267","إذا كنت فيما لست بالوصف فانياً","وقوفك في الأوصاف عندي تحير"]]},"62EA7BF5-1E14-5D0E-A2CF-D9C4F3AFA968":{"t":"إلى الله أشكو طول شوقي وحيرتي","p":114,"s":"إلى الله أشكو طول شوقي وحيرتي","r":"477717","v":[["EC69D065-EA36-5B55-A7D8-2B89192B51FC","إلى الله أشكو طول شوقي وحيرتي","ووجدي بما طالت علي مطالبه"],["975B246F-474D-5688-BD4F-CB87C7F31E17","ومن قد برى جسمي وكدر عيشتي","ويمنعني الماء الذي أنا شاربه"],["461BC054-9124-5D66-8DA5-7FBDA9470850","إذا سمت نفسي سلوة عنه ردني","إليه شهود ليس تفنى عجائبه"],["CB3430B3-EAB5-5F82-8D93-3112E51AA599","فيا ليت شعري ما الذي فيه راحتي","وما آخر الأمر الذي أنا طالبه"]]},"8CF8E85A-D4B5-5B4D-9006-8524154E5930":{"t":"إن الرضى لمرارات نجزعها","p":114,"s":"إن الرضى لمرارات نجزعها","r":"477727","v":[["6FAFB5E4-6317-52A5-BE83-24200F60DD8E","إن الرضى لمرارات نجزعها","عند القنوع إذا ما استعذب الكدر"],["322E8A44-C17F-5386-876A-5BA9FE41D66D","عواقب أشهدت بعض الحضور فما","يرعى التكثر إلا ناقة نزر"]]},"32AFDAA3-295F-5836-BFC4-D2A7D2F05561":{"t":"إن كنت للسقم أهلاً","p":114,"s":"إن كنت للسقم أهلا","r":"477734","v":[["80D19792-46E7-5232-977B-C3661A2D428C","إن كنت للسقم أهلاً","وكنت للشكر أهلا"],["C5F8807A-8DBB-5C4C-8643-A1B7FE58123D","عذب فلم يبق قلب","يقول للسقم مهلا"]]},"E761DAC0-CFCF-5A27-8B32-D19F0B5E17B4":{"t":"إني اتقيتك لا مهاد","p":114,"s":"إني اتقيتك لا مهاد","r":"477725","v":[["ACE41B1C-3421-5DD5-90FC-90A427AC120C","إني اتقيتك لا مهاد","ة من محاذرة المصير"],["CD0CCF72-E22B-53B6-A21B-A6B752ED13F9","إني وكيف وأنت لي","إلف يفوق مدى السمير"],["6A97A115-8695-528A-B031-F6029208FF60","توفي السرائر سرها","وتحوط مكنون الضمير"],["FB5D81C2-AEA8-5CC5-84A8-D397AF01D89C","لكن أجلك إن أجا","ل سواك للخطر الحقير"]]},"7117BBE1-3591-5167-B17C-0105A46DC15A":{"t":"الذكر يقطعني والوجد يطلعني","p":114,"s":"الذكر يقطعني والوجد يطلعني","r":"477732","v":[["F783BD48-32A2-583C-912B-B979D9F83C36","الذكر يقطعني والوجد يطلعني","والحق يمنع عن هذا وعن ذاك"],["C43BDD33-9CA0-5157-8F94-9CBD59711834","فلا وجود ولا سر أسر به","حسبي فؤادي إذا ناديت لباك"]]},"C4EAC7D4-C082-5DC8-A60A-52C965A24A36":{"t":"تأمل بعين الحق إن كنت ناظراً","p":114,"s":"تأمل بعين الحق إن كنت ناظرا","r":"477724","v":[["15425728-784C-5BFE-A965-441DC8655D9B","تأمل بعين الحق إن كنت ناظراً","إلى صفة فيها بدائع فاخر"],["BBA4FA04-4C00-52F2-AF15-2E9243B64ACE","ولا تعط حظ النفس منها لما بها","وكن ناظراً بالحق قدرة قادر"]]},"B4A29E49-02D4-56AC-9B98-402FF322F648":{"t":"تسترت عن دهري بستر همومه","p":114,"s":"تسترت عن دهري بستر همومه","r":"477723","v":[["C22E301B-5EBD-57D3-AC6F-597BF1CF06C3","تسترت عن دهري بستر همومه","محيرة في قدر من جل عن قدري"],["534E3E60-8FA7-5573-8E60-12C46F098612","فلا الدهر يدري أنني عنه غائب","ولا أنا أدري بالخطوب إذا تجري"],["68667838-4399-5413-9AFE-112FF9EA8666","إذا كان كلي واقفاً بوفائه","فلست أبالي ما حييت يد الدهر"]]},"9D8EDD7D-FC7D-5E3E-A3A8-21FB54311220":{"t":"جوع وعري وحفا","p":114,"s":"جوع وعري وحفا","r":"477730","v":[["9EFB83CB-D503-50A5-881B-54DA7C0EE084","جوع وعري وحفا","وماء وجه قد عفا"],["4D91DD88-9D5E-5EF1-BD31-A86F937E34AB","وليس للأنفس إن","تخبر عما قد خفا"],["286862B2-06BA-56B7-B3B7-B00A29B085A2","قد كنت أبكي طرباً","فصرت أبكي أسفا"]]},"5AE43B95-7CA6-58AE-BD27-24C13810D5C4":{"t":"ذكرت ولم أذكر حقيقة ذكره","p":114,"s":"ذكرت ولم أذكر حقيقة ذكره","r":"477731","v":[["CCEBA655-193E-50D0-B10F-88FBBFC6FB98","ذكرت ولم أذكر حقيقة ذكره","ولكن بداوي الحق تبدو فأنطق"],["D8C1805A-3B05-51CA-A6FD-8C1668C469F2","إذا ما بدا ذكر لذكر ذكرته","يغيبني عن ذكر ذكري فأغرق"],["81265F73-7360-5D6E-BEFD-1439D73EF3D9","وأغرق بالذكر الذي قد ذكرته","عن الذكر بالذكر الذي هو أسبق"]]},"EFAB23A8-B921-575E-A8FB-59F2E181809D":{"t":"رب ورقاء هتوف في الضحى","p":114,"s":"رب ورقاء هتوف في الضحى","r":"477745","v":[["E36CE304-E0DE-5BD4-B53B-830BDCD5789F","رب ورقاء هتوف في الضحى","ذات شجو صدحت في فنن"],["19BE0D84-EF41-5790-88A4-4464C941BEF4","ذكرت إلفاً ودهراً صالحاً","فبكت حزناً وهاجت حزني"],["CD516CCD-A6F2-5ABF-9A55-C2892A5445B5","فبكائي ربما أرقها","وبكاها ربما أرقني"],["8B0FD6F1-09C2-52AE-9949-FDF4176410FA","ولقد تشكو فما أفهمها","ولقد أشكو فما تفهمني"],["5CA1F5D3-E225-557F-9274-694A8B05D4C0","غير أني بالجوى أعرفها","وهي أيضا بالجوى تعرفني"],["532FD514-0373-5318-84E8-AEB5C50E4A81","أتراها بالبكا مولعة","أم سقاها البين ما جرعني"]]},"E7C707CF-7438-5977-A780-C67AF784AC80":{"t":"شهدت ولم أشهد لحاظاً لحظته","p":114,"s":"شهدت ولم أشهد لحاظا لحظته","r":"477721","v":[["0D050708-B199-5413-A7DA-1BDB0B9F1E43","شهدت ولم أشهد لحاظاً لحظته","وحسب لحاظٍ شاهد غير مشهد"],["54F8AAFB-D2F5-58FB-8045-24BC7CDBFD86","وغبت مغيباً غاب للغيب غيبه","فلاح ظهور غيبه غير مفقد"]]},"3A876D0F-2A4C-5F9E-8090-5F083A14E2C0":{"t":"قالوا غدا العيد ماذا أنت لابسه","p":114,"s":"قالوا غدا العيد ماذا أنت لابسه","r":"477729","v":[["3226A2E0-6EFC-5442-B79F-4A677D6EDB29","قالوا غدا العيد ماذا أنت لابسه","فقلت خلعة ساق عبده جرعا"],["508974FE-ACFC-5DD2-B284-B2C2D94DC5CD","فقر وصبر هما ثوباتي تحتهما","قلب يرى ربه الأعياد والجمعا"],["0F746DEE-DBD1-5BE2-A4B8-B79BA3D6CCF8","أحرى الملابس أن تلقى الحبيب بها","يوم التزاور في الثوب الذي خلعا"],["24E156F6-C74C-56D8-ABF9-B24C6E05D24C","الدهر لي مأتم إن غبت يا أملي","والعيد ما دمت لي مرأى ومستمعا"]]},"41C4AA23-735D-5C5B-8FB0-C09840CA1E01":{"t":"كادت سرائر سري أن تسر بما","p":114,"s":"كادت سرائر سري أن تسر بما","r":"477744","v":[["0C80D203-59EC-59A2-8613-134DD60C0A68","كادت سرائر سري أن تسر بما","أوليتني من سرور لا أسميه"],["DA9CD0B3-5457-5AF0-9966-6C80B76C63C7","فصاح للسر سر منك يرقبه","كيف السروربسر دون مبديه"],["4E8ECA31-9C6A-5684-9220-C7CA1D1A3BD9","فظل يلحظه سراً ليلحظه","والحق يلحظني ألا أراعيه"],["B70346AC-C10F-5DA9-80AA-8F0D0DDD05EC","وأقبل السر يغني الكل عن صفتي","وأقبل الحق يغنيني ويغنيه"]]},"3D3711A7-E845-5147-BC20-DFB090F67669":{"t":"كفى حزناً أني أناديك دائباً","p":114,"s":"كفى حزنا أني أناديك دائبا","r":"477718","v":[["0C71A803-A46D-5053-B155-0405D6C08161","كفى حزناً أني أناديك دائباً","كأني بعيد أو كأنك غائب"],["5D0A3322-0CF8-5FD9-BF19-141E6B93BBAD","واسأل منك الفضل من غير رغبة","فلم أر مثلي زاهداً وهو راغب"]]},"9B2447B7-590F-5B7B-A6ED-6D77E5AA18B9":{"t":"كم حسرة لي قد غصت مرارتها","p":114,"s":"كم حسرة لي قد غصت مرارتها","r":"477733","v":[["847D664A-A429-56FF-AD52-1B2DF817465D","كم حسرة لي قد غصت مرارتها","جعلت قلبي لها وقفاً لبلواكا"],["1189F251-43CD-5EE9-9039-5CCAE146FC53","وحق ما منك يبليني ويتلفني","لأبكينك أو أحظى بلقياكا"]]},"797C8300-B254-56B7-9BC2-6C7FA1C4AA99":{"t":"كما ترى صيرني","p":114,"s":"كما ترى صيرني","r":"477739","v":[["A8B508D5-81AD-5F99-B4FD-5CC56B4C48F7","كما ترى صيرني","أقطع قفر الدمن"],["C9C2B6F9-1CF8-5ABC-8783-D59E163E2210","شرقني غربني","أزعجني عن وطني"],["E75FE615-8963-5BDA-8B16-C0513EB7EFC9","إذا تغيبت بدا","وإن بدا غيبني"],["A4430F95-583D-5DF4-A5AC-63ADC9F0AF7E","واصلني حتى إذا","واصلته فاصلني"],["7CEDB89A-F594-50A4-94B1-A6DA404E55EA","وقال لا تشهد ما","تشهد أو تشهدني"]]},"2893411C-5020-544C-A39D-A8D88562F53D":{"t":"لعمري ما استودعت سري وسرها","p":114,"s":"لعمري ما استودعت سري وسرها","r":"477742","v":[["C06F6C13-1E8F-5819-9C52-82BD15DF926E","لعمري ما استودعت سري وسرها","سوانا حذاراً أن تشيع السرائر"],["B764785B-3102-55D1-A012-A9DB8DEF6D00","ولا لاحظتها مقلتاي بلحظة","فتشهد نجوانا العيون النواظر"],["26E7E3DC-13E6-5D3F-B23D-47AA1992940D","ولكن جعلت الوهم بيني وبينها","رسولاً فادي ما تُكن الضمائر"],["BD734344-86F8-5108-B9B1-01796591F6DA","أصول الهوى بقيا عليها من العدا","مخافة أن يغرى بذكراه ذاكر"]]},"170B2B43-8C96-5A8F-84F3-7FB5B6FEA71E":{"t":"ليس عيد الحب قصد المصلى","p":114,"s":"ليس عيد الحب قصد المصلى","r":"477741","v":[["83932249-108A-52FF-BB8B-85982B715702","ليس عيد الحب قصد المصلى","وانتظار الجيوش والأعوان"],["670F3608-58B3-58D8-AE91-7CEB3EFC00A3","إنما العيد أن تكون لدى الح","ب كريما مقربا في الأمان"]]},"17791DE4-B716-595C-B860-A5BCD2D7B6D6":{"t":"وكم رمت أمراً خرت لي في انصرافه","p":114,"s":"وكم رمت أمرا خرت لي في انصرافه","r":"477737","v":[["DB71C22D-4C4D-5C82-AA29-3B6ADDCEB3E9","وكم رمت أمراً خرت لي في انصرافه","فلا زلت بي مني أبر وأرحما"],["BE8A89AF-A18E-5591-8E91-65D9DBB0DABF","عزمت على ألا أحسن بخاطر","على القلب إلا كنت أنت المقدما"],["61B3BB88-A999-5A8E-B9E0-2770D178E3E0","وألا تراني عندما قد كرهته","لكونك في قلبي كبيراً معظما"]]},"4F314D0C-9566-539E-8180-30EC584C41E4":{"t":"يا من تشاهده عيني فأحسبه","p":114,"s":"يا من تشاهده عيني فأحسبه","r":"477716","v":[["6F4D8544-9842-5653-83D7-C8879FD49AC8","يا من تشاهده عيني فأحسبه","مني قريباً وقد عزت مطالبه"]]},"FBCA4E22-0240-5D74-8446-F3BC750A734B":{"t":"يناجيك سر سائل عن ثلاثة","p":114,"s":"يناجيك سر سائل عن ثلاثة","r":"477743","v":[["B80394AB-1F29-5161-8429-851BAAC9917F","يناجيك سر سائل عن ثلاثة","سرائرهم كتم وإعلانهم ستر"],["C92F8CEA-C353-51B2-8B8A-870521CFA324","فتى ضاع كتم السر بين ضلوعه","عن إدراكه حتى كأن لم يكن سر"],["ECEF364F-636F-599F-91F2-470BF9E05132","فأسبل أستار التخفر صائناً","لكل حديث أن يكون هو السر"],["085D7530-09D1-5AA7-B751-5095DC9473AB","فكتّام سر مدرك الكتم لم ينل","سوى حد كتم السر من ظنه ذكر"],["874FA421-DB5A-5359-A7A8-EB6588962B