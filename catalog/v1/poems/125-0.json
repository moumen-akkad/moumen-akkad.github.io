{"v":1,"poems":{"92917933-5888-5F9F-AE91-B9B5D8BE5A5F":{"t":"أبا محمد المحمود يا حسن","p":125,"s":"أبا محمد المحمود يا حسن","r":"477707","v":[["5C238D37-78E4-52FF-A9DB-994382BC1EDF","أبا محمد المحمود يا حسن ال","إحسان والجود يا بحر الندى الطامي"],["B770BDA7-B042-565F-B0FF-F3892AC7EED2","حاشاك من عود عواد إليك ومن","دواء داء ومن إلمام آلام"]]},"62DC199E-9D27-51AE-97FD-69E41B1A2615":{"t":"أبعين مفتقر إليك رايتني","p":125,"s":"أبعين مفتقر إليك رايتني","r":"477703","v":[["47C6213C-0EDC-5055-9B80-84A33C1F2E8D","أبعين مفتقر إليك رايتني","بعد الغنى فرميت بي من حالق"],["CBB19845-36BE-5507-8BAF-66143C1E2B53","ست الملوم أنا الملوم لنني","أملت للإحسان غير الخالق"]]},"C5CEF29E-738C-5705-BB3F-877C0416EA91":{"t":"أذل فيا حبذا من مدل","p":125,"s":"أذل فيا حبذا من مدل","r":"477705","v":[["35AE9A5B-00E9-5A94-B522-14891DE14AC6","أذل فيا حبذا من مدل","ومن ظالم لدمي مستحل"],["6D864ACC-ADAD-501D-93C3-CC4C24C1B136","إذا ما تعزز قابلته","بذل وذلك جهد المقل"]]},"D90115D0-AB28-57E4-AAF4-AB86FE290EF8":{"t":"أسعد بمولود أتاك مباركا","p":125,"s":"أسعد بمولود أتاك مباركا","r":"477694","v":[["1F514475-0924-5E3A-9615-2DC4AF28BD0D","أسعد بمولود أتاك مباركا","كالبدر أشرق جنح ليل مقمر"],["5A97E28C-AEAF-56AC-8F8A-390EF6E3BF94","سعد لوقت سعادة جاءت به","أم حصان من بنات الأصفر"],["230FBC8B-C47A-5106-8A7A-19BEB8F62BB6","منتبحبح في ذروتي شرف العلا","بين المهلب منتماه وقيصر"],["5B101C72-2747-537E-A7F1-CF514164282C","شمس الضحى فرنت إلى بدر الدجى","حتى إذا اجتمعا أتت بالمشتري"]]},"F466FEF4-FE68-5BAC-BC3A-FDA86C63B4AE":{"t":"إذا ما علا في الصدر والنهى والأمر","p":125,"s":"إذا ما علا في الصدر والنهى والأمر","r":"477692","v":[["EF80998C-1727-5C3C-8493-8EF743382E4F","إذا ما علا في الصدر والنهى والأمر","وبثهما في النفع منه وفي الضر"],["5AC53FB7-1A36-5748-ADAD-1E2B66B2003B","وأجرى طبا أقلامه وتدفقت","بديهته كالمستمد من البحر"],["8C240755-6C2D-5D54-9478-99022DD10EB9","رأيت نظام الدر في نظم قوله","ومتشوره الرقراق في ذلك النثر"],["0F0E1EC9-69AF-594B-852D-DFB63A598383","ويقتضب المعنى الكثير بلفظة","ويأتي بما تحوي الطوامير في سطر"],["C7F12CA1-D80B-5FEE-A2CA-A6F14B1CBB1B","أيا غرة الدهر ائتنف غرة الشهر","وقابل هلال الفطر في ليلة الفطر"],["6D165F7E-AB9D-525E-971B-BBC1405FD620","بأيمن إقبال واسعد طائر","وأفضل ما ترجوه من أفسح العمر"],["FF911816-29C3-5502-9A1E-1B6375FD85D0","مضى عنك شهر الصوم يشهد صادقا","بطهرك فيه واجتنابك للورر"],["73810E19-A37C-5EF6-BCC0-EDF242BA7E6E","فأكرم بما حط الحفيظان منهما","وأثنى به المثني وأطرى به المطري"],["48173D0F-F9DD-5994-8925-5EE9F0D8868C","وركتك أوراق المصاحف وانتهى","إلى الله منها طول درسك والدكر"],["C031F395-81C1-538A-93FE-C96B40DDCD08","وقبضك كف البطش عن كل مجرم","وبسطكها بالعرف والخير والبر"],["3089F4C1-D786-5C67-B3C2-38AE168E096B","وقد جاء شوال فشالت نعامة الص","يام وأبد لنا النعيم من الضر"],["2F8B954B-FB49-5F47-9764-4C74463C6246","وضجت حبيس الدن من طول حبسها","ولامت على طول التجنب والهجر"],["54B8790F-2CE9-5774-90F9-5DBCCBDAC405","وأبرزها من قعر أسود مظلم","كإشراق بدر مشرق اللون كالبدر"],["A5C63167-18C7-5C60-ACDF-A07A071C9F51","إذا ضمها والورد فوة وكفه","فلا فرق بين اللون والطعم والتشر"],["F55EF94E-A905-5851-9ADC-9C2C13B19652","وتحسبه إذ سلسل الكأس ناظما","على الكوكب الدري سمطا من الدر"]]},"DDDEF1B9-5791-5238-812B-482DF6BD63FB":{"t":"اسمع حديثي تسمع قصة عجبا","p":125,"s":"اسمع حديثي تسمع قصة عجبا","r":"477686","v":[["10E5099E-9EAA-55FD-B810-55BBF9FC10BE","اسمع حديثي تسمع قصة عجبا","لا شيء أعجب منها تبهر القصصا"],["D216CB22-912A-5A79-AED4-B5363B3CCFCE","طلبت عكارة للوحل تحملني","ورمتها عند من يحبي العصا فعصى"],["EC9331C5-6D45-5F89-8A7D-D038108BDF0E","وكنت أحسبه يهوى عصا عصب","ولم أخل أنه صب بكل عصا"]]},"BD08B688-30EE-5260-8C2B-66514D62D88B":{"t":"الحمد لله على ما أرى","p":125,"s":"الحمد لله على ما أرى","r":"477685","v":[["5EB2507B-C69B-5047-BF42-40D9F8E521B4","الحمد لله على ما أرى","من ضيعتي ما بين هذا الورى"],["1BAD4A46-EA01-51A5-B7B3-9F8AEB58BE68","أصارني الدهر إلى حالة","يعدم فيها الضيف عندي القرى"],["2E6095CD-0C1A-516E-B7CE-EA23CA668161","بدلت من بعد الغنى حاجة","الى كلاب يلسبون الفرا"],["604AB5D1-FFD3-5EDF-AA68-05935DEABBCD","أصبح أدم السوق لي ماكلا","وصار خبر البيت خبر الشرا"],["9ED7053F-1527-526E-A3C6-40560DB84B12","من بعد ملكي منزلا مبهجا","سكنت بيتا من بيوت الكرا"],["D8CC6F07-23ED-5A1C-B8F2-E18E5F17E5E4","فكيف ألفى ضاحكا لاهيا","وكيف أحظى بلذيذ الكرى"],["8F7EE16F-B47B-5070-8AF0-6E97601283FD","سبحان من يعلم ما خلفنا","وتحت أيدينا وتحت الثرى"],["FF60DDA6-6E46-5BB9-BB3F-CE939D2CE977","والحمد لله على ما أرى","وانقطع الخطب وزال المرا"]]},"053CD378-6091-5B55-88D3-713CFF925BD8":{"t":"الدهر يلعب بالفتى فيهيضه","p":125,"s":"الدهر يلعب بالفتى فيهيضه","r":"477699","v":[["85311E04-A5F4-5D0A-BC35-D6A94B8A50D4","الدهر يلعب بالفتى فيهيضه","طورا ويحبر عظمه فيراش"],["5290395C-E7E9-569B-8130-E3B17F18E710","وكذا رأينا الدهر في اعراضه","ينحى وفي إقباله يتناش"]]},"6480F07C-B28A-5647-BA64-571287A1192E":{"t":"بت وبات الحبيب ندماني","p":125,"s":"بت وبات الحبيب ندماني","r":"477711","v":[["9B6708CB-6D5B-5C41-888B-9712D3D20141","بت وبات الحبيب ندماني","من بعد نأي وطول هجران"],["9C5BBEF0-18FE-5A22-812B-F07EEE41E277","نشرت قفصية معتقة","بحانة الشط منذ أزمان"],["BF1C26D9-0BC1-5BB3-8C8C-B23B1DF51B0E","وكلما دارت الكئوس لنا","ألثمني فاه ثم غثاني"],["9C1D5695-252A-5086-A8C3-B117E7396BD3","الحمد لله لا شريك له","أطاعني الدهر بعد عصيان"]]},"A847C0DD-6A4D-5170-BCCE-E8B0A1017900":{"t":"تأوب عيني طيف ألم","p":125,"s":"تأوب عيني طيف ألم","r":"477708","v":[["449106CC-FD8D-597E-B9FA-9B56C287FB73","تأوب عيني طيف ألم","لظالمة طرقت في الظلم"],["F53BCD31-2808-5E5A-A476-B4F7EEFF3163","تخيل منها خيال سرى","فيسلب حلمي بذاك الحلم"],["8DFE3D49-C66A-5CBB-9E09-96BBF790B064","فما أنس لا أنس إقبالها","تميسن بغصن سقته الديم"],["684E71B9-B9FF-5CFF-9F91-568E3C49DE7F","وقد بدرت مثل بدر الدجى","سما في السماء علوا وتم"],["2F1188C1-26E5-5901-9610-3E219E5BA474","على رأسها معجر أزرق","وفي جيدها سبحة من برم"],["C9A4307E-423A-5493-AB68-E08A6787F3F2","ولم ترتقب لطلوع الرقيب","ولم تحتشم لطلوع الحشم"],["6A633E6B-4059-5C31-92CA-5748AC179011","لقد سؤتني يا نظام السرور","وأسقمتني يا شفاء السقم"],["6E37CE0F-940A-5170-917A-FDF8B672DBFB","أهذا المزار أم الإزورار","والمامكم ألم أم لم"],["A3A37281-27BC-5538-AD50-254963AD7E65","ويوم كمثل رداء العرو","س حسنا وطيبا إذا ما يشم"],["E4B2414B-FF08-5944-8B2F-F6B65145B6AE","خلعت عذاري ولم اعتذر","ولم أحتشم فيه من يحتشم"],["423820CA-468C-5D53-BD23-58E34C5F20B3","وقابلت فيه صفاء الشمال","بصفو الشمول وشجو النغم"],["CD0662CD-DC93-5B7B-B61D-9B2ABB5359AC","فداؤك نفسي هذا الشتاء","علينا بسلطانه قد هجم"],["B9F7CF57-184B-5D71-AD96-EBD01BA31843","ولم يبق من نشبي درهم","ولا من ثيابي إلا رمم"],["F18D6C27-4D18-598C-A2B6-DA0F469A05BB","يؤثر فيها نسيم الهواء","وتخرفها خافيات الوهم"],["8D94248E-2350-5D77-8F11-F99B32AF706B","وأنت العماد ونحن العفاة","وأنت الرئيس ونحن الخدم"]]},"6C7322B8-018D-5A2D-8BB4-E4B67055C13A":{"t":"تصارمت الأجفان لما صرمتني","p":125,"s":"تصارمت الأجفان لما صرمتني","r":"477695","v":[["F9CCA242-C4BA-592C-8F24-02A578AA04F3","تصارمت الأجفان لما صرمتني","فما تلتقي إلا على دمعة تجري"]]},"6E4C85BC-41B0-5965-A828-25E074F0A997":{"t":"حضرتكم دهرا وفي الكم تحفه","p":125,"s":"حضرتكم دهرا وفي الكم تحفه","r":"477709","v":[["CE4493D8-3270-56AE-8DD2-7D75ABC2658F","حضرتكم دهرا وفي الكم تحفه","فما أذن البواب لي في لقائكم"],["2C55D21A-1EB5-595C-876D-78721A4E6CBD","إذا كان هذا حالكم يوم أحدكم","فما حالكم بالله يوم عطائكم"]]},"A97A5BBA-37F7-58E1-9583-D14C5B74D8DF":{"t":"خطب طرقت به أمر طروق","p":125,"s":"خطب طرقت به أمر طروق","r":"477702","v":[["7DF7F2EE-779A-5F8A-92DB-BD345822CC53","خطب طرقت به أمر طروق","فظ الحلول علي غير شفيق"],["DB54CDC2-C8ED-58B8-9D48-883552BE46A0","فكأنما نوب الزمان محيطه","بي راصدات لي بكل طريق"],["4AB0AB1D-90D8-5F7A-B5C3-6519931E9663","حتى متى تتحي علي صروفها","وتغصني فجعاتها بالريق"],["485F08E3-8D12-53EC-83F9-90221E73F6E3","ذهبت بكل مصاحب ومناسب","وموافق ومرافق وصديق"],["620ADF57-46D3-5A7E-840E-F03D8CE69BE3","حتى بديك كنت آلف قريه","حسن إلي من الديوك رشيق"],["B11A6B46-2480-5C53-8D1B-0C247D89B5E7","القى عليه الدهر منه كلكلا","يفني الورى ويشت كل فريق"],["B9086896-A418-5B61-8A11-1C2A4C7CC362","ورماه منه بجد سهم شائك","لذخائر المستظهرين علوق"],["073054F0-1803-5B0B-9B88-93CFAC3D9921","غلبت صروف الدهر فيه محالتي","إني لريب الدهر غير مطيق"],["7F518F43-6406-5487-90BA-0E317231F210","حزني عليه دائم ما غردت","ورق الحمام ضحى بذروة نيق"],["898CFBC7-B324-5EB5-9339-5C1B4A1DF0DE","أربيب منزلنا ونشو حجورنا","وغذي أيدينا نداء مشوق"],["ED4C1147-B0A2-5CEB-B884-CA1CDAB23697","لهفي عليك أبا النذير لو انه","دفع المنايا عنك لهف شفيق"],["6F0D074D-37E5-5341-B82D-756C4E3308D8","وعلى شمائلك اللواتي ما نمت","حتى ذوت من بعد حسن سموق"],["E804B091-4039-54FE-9DE9-32D49BADA737","لما يفعت وصرت علق مضنه","ونشأت نشء المقبل الموموق"],["BCADE0CE-D95A-5C95-851F-03B5038B5F2F","وتكاملت جمل الجمال باسرها","لك من جليل واضح ودقيق"],["DD1AAA10-2841-5D17-B3AC-D9501CA42FF4","وكسيت كالطاووس ريشا لامعا","متلألئا ذا رونق وبريق"],["A0C35E63-C324-5DCA-B3A0-60D3FE3A42F4","من حمرة في صفرة في حضرة","تخييلها يغني عن التحقيق"],["FCED8E6C-F5DF-590B-A92C-267B85C15605","عرض يجل عن القياس وجوهر","لطفت معانيه عن التدقيق"],["2385B35C-4ABD-5901-866A-13697A63B6B3","وخطرت ملتحفا ببرد حبرت","منه بديع الوشي كف أنيق"],["67F7B3DB-6AD6-55DF-B3E0-8B7B1FDFDFE4","كالجلنارة أو صفاء عقيقة","أو لمع نار أو وميض بروق"],["07E3CB72-07E9-591F-A7D7-EA8C71E41EA0","أو قهوة تختال في بلورة","يتألق الترويق والتصفيق"],["6F8FD447-06B5-5D62-A25E-6DBF6C94F327","وكأن سالفتيك تبر سائل","وعلى المفارق منك تاج عقيق"],["749A865C-4968-596F-B622-23B3F49E56F4","وكأن مجرى الصوت منك إذا نبت","وجفت عن الأسماع بح حلوق"],["339309EB-E66B-5BFF-8896-6E1AB51778CC","ناي دقيق ناعم قرنت به","نعم مؤلفة من الموسيقي"],["626CEE4B-A207-5490-8568-F8B05D6EAEA9","يزقو ويصفق بالجناح كمنتش","وصلت يداه النقر بالتصفيق"],["5D3CA3FF-A66A-5E31-AC47-26120D03AD43","ويمس ممتطيا لسبع دجائج","مثل المهاري اجدقت بفنيق"],["D4E5CD35-127A-54FC-9CCA-4BB98FFACB33","فيميرنا منهن بيضا دائما","رزقا هنيئا ليس بالمحوق"],["5678302C-0C7D-545A-924F-E8874E92568F","فيه بدائع صنعة ولطائف","أتقن بالتهذيب والتدقيق"],["8A3169BB-2566-5F18-926A-E5576A2B940E","خلقان مائيان ما اختلطا على","سيل ومؤتلف المزاج رقيق"],["939DD7F0-7657-5E9C-BD49-49C85D5DE8FC","صنع يدل على حقيقة صانع","للحلق طرا ليس بالمخلوق"],["879E4E39-EA7D-55B9-A053-4DD3F7FCE77E","فبياضها ورق وتبر محها","في حق عاج بطنت بدبيقي"],["59559DC1-8E84-5A6D-8ABB-BAB661BCE348","يعدو علينا من طهاه بعجة","ويروح بالمشوي والمسلوق"],["276B5CAD-087B-5877-B7AE-CF0D12A2EE0D","نعم لعمركلو تدوم هنيئة","هل دام رزق لامرىء مرزوق"],["0104E9AF-911F-5724-A1A3-E9BBFC5ED0EE","أبكي إذا ابصرت ربعك موحشا","بتحتن وتاسف وشهيق"],["B938E790-4837-5B92-B681-5A7A50DD4DD5","ويزيدني جزعا لفقدك صادح","في منزل دان الي لصيق"],["1A425C91-8685-5B12-B133-6FA73537F33C","فزع الفؤاد وقد زقا فكأنه","نادى ببين أو نعي شقيق"],["1A4D9C9A-8FF3-532B-8F34-74330B5FA5C5","فتأسفي أبدا عليك مواصل","بسواد ليل أو بياض شروق"],["0582E1F8-9E16-52C2-9AAB-1F6A039C4811","وإذا أفاق ذوو المصائب سلوة","وتصبروا أمسيت غير مفيق"],["A989739C-7C11-5240-94F2-26A3D4BE5B5D","صبر المفقدك لا قلى لك بل كما","صبر الأسير لشدة ومضيق"],["0B443D53-002B-5658-A66E-98628068902A","لا تبعدن وإن نأت بك نية","في منزل ناء المحل سحيق"]]},"B18D7D5A-E77F-5E3B-93AE-6A2C57ADEEB7":{"t":"خلائق كالحدائق طاب منها الن","p":125,"s":"خلائق كالحدائق طاب منها الن","r":"477691","v":[["AB507EBB-DD4D-538F-AA6C-2CDD142E0EE9","خلائق كالحدائق طاب منها الن","سيم وأينعت منها الثمار"]]},"1CE09122-B0FC-5F21-BA05-2C56B0301893":{"t":"طازاد مشتق من الطيز","p":125,"s":"طازاد مشتق من الطيز","r":"477698","v":[["9DE490FA-92FD-54EB-A405-F995B7A642E0","طازاد مشتق من الطيز","فعد عن ذكر فتى الحوز"],["F1DDD7E3-71C3-51EB-AE42-B1CAD3ED05BF","كأن رجليه إذا ما مشى","مخثث يلعب بالشير"]]},"B46AC545-F3BD-5E5B-B8B0-1EEEAE37CAE7":{"t":"عجبت لما بلغت عني باطلا","p":125,"s":"عجبت لما بلغت عني باطلا","r":"477687","v":[["DB01E894-FCC2-5E75-941A-86E1C2F9706A","عجبت لما بلغت عني باطلا","وظنك بي فيه لعمرك أعجب"],["9F66DFEA-1D9C-52A1-8A5F-E62A68342AD6","ثكلت إذا نفسي وعزي وأسرتي","بفقدي ولا أدركت ما كنت أطلب"],["C240EF57-2334-5E67-A767-1AED33B000C6","فكيف بمن لاحظ لي في لقائه","وسيان عندي وصله والتجنب"],["E93342E3-C298-56EF-989E-2F3AF69C07F2","فتق بأخ أصفاك محض مودة","تشاكل منها ما بدا والتغيب"]]},"8DA36571-8431-5037-A3C0-94BC643E8F6E":{"t":"فداؤك نفسي من الحادثات","p":125,"s":"فداؤك نفسي من الحادثات","r":"477696","v":[["A5CB26FD-F9B5-502A-9A85-4F761094CC59","فداؤك نفسي من الحادثات","وريب الردى وحلول الحذر"],["CDA58AA3-EC34-53D1-8CAA-03B6E183177C","فعالك تكبر عن موعد","ووعدك يسبق أن ينتظر"],["0C5C0C12-A69A-5EC2-A4A3-583D7CD8E7C9","وكفك تهمي على المعتفين","بفيض عفا وصفا من كدر"],["26F2AD29-9723-5F63-9CB5-E94F7F029916","إذا عاقك الشغل عني ولم","أذكرك نفسي خوف الضجر"],["2DAFB7F4-B9C0-5659-AF57-1F06337A6E4C","تسكعت في حيرة إلا أجو","زمنها إلى عضد أو وزرز"],["02CF4AA0-73C2-5F61-BCD1-EFBFDECB4A89","رهنت ثيابي وحال القضا","ء دون القضاء وصد القدر"],["8246931A-6ADA-52CB-974A-BBB3CACF7DED","وهذا الشتاء عسوف علي","كما قد تراه قبيح الأثر"],["7DD58BD2-003D-55E5-8D76-75C4F01452C0","يغادي بصر من العاصفا","ت أو دمق مثل وخز الإبر"],["27B61C03-03A5-57C2-A4BF-EE46CD109FCE","وسكان دارك ممن أعو","ل يلقين من برده كل شر"],["BC4D7C17-D0CA-5B2A-8A02-7BF8A49693E1","فهذي تحن وهذي تئن","وأدمع هاتيك تجري درر"],["C193D1C6-1039-5B8D-BE92-7052F28F4A14","إذا ما تململن تحت الظلام","يعللن منك بحسن النظر"],["1C289A78-05A5-55DA-B751-A771A47307FF","ولا حظن ريعك كالمحلي","ن شاموا البروق رجاء المطر"],["F4E280A9-F0CA-5C2A-ABA7-8FC789CC3971","يؤملن عودى بما ينتظرن","كما يرتجى آئب من سفر"],["B2B30862-B86C-5D48-803D-CF341D865B65","فأنعم بانجاز ما قد وعدت","فما غيرك اليوم من ينتظر"],["03CD28D4-1075-5F64-A24D-B385D64A6CA6","وعش لي وبعدي فأنت الحيا","ة والسمع من جسدي والبصر"]]},"5948050D-6290-565F-9328-1745BB18479F":{"t":"كأنه التيس قد أودى به هرم","p":125,"s":"كأنه التيس قد أودى به هرم","r":"477714","v":[["149539BB-78EA-5A8D-BDA4-F44970868DDC","كأنه التيس قد أودى به هرم","فلا للحم ولا عسب ولا ثمن"]]},"80197EF8-4410-582D-91D8-D195BFF63B31":{"t":"لست صدرا ولا قرأت على صد","p":125,"s":"لست صدرا ولا قرأت على صد","r":"477701","v":[["1732E78D-25DC-5BD7-9330-523819C5D702","لست صدرا ولا قرأت على صد","ر ولا علمك البكي بكاف"],["CB56EA00-E82D-5699-8A84-A6ADA9C09F26","لعن الله كل شعر ونحو","وعروض يجيء من سيراف"]]},"EADD24C5-CED4-5C44-8350-F553A669BA4B":{"t":"مالك موفور فما باله","p":125,"s":"مالك موفور فما باله","r":"477706","v":[["15A962AC-3195-5556-A6E3-C3178336145C","مالك موفور فما باله","أكسبك التيه على المعدم"],["6807E30A-83E6-5801-A38C-A87DAF622241","ولم إذا جئت نهضنا وان","جئتا تطاولت ولم تتمم"],["D396ABCC-DFCE-5DC4-A5B1-3BFFE59C396A","وإن خرجنا لم تقل مثل ما","نقول قدم طرفه قدم"],["9188672A-E5CA-556F-A420-7D2A2DB6AB4A","إن كنت ذا علم فمن ذا الذي","مثل الذي تعلم لم يعلم"],["8A29AA1B-FC70-5218-ACD9-B252F4E3F4BD","ولست في الغارب من دولة","ونحن من دونك في المتسم"],["8728BA57-56D0-5ECC-97F1-506F5EBAA3DC","وقد ولينا وعزلنا كما","أنت فلم نصغر ولم تعظم"],["90029647-092A-5D47-B056-B7040D4895CA","تكافأت أحوالنا كلها","فصل على الانصاف أو فاصرم"]]},"DE80A171-670A-5989-80B2-072B4F1F2D1C":{"t":"مرت بنا في الدير خمصانة","p":125,"s":"مرت بنا في الدير خمصانة","r":"477715","v":[["1F3DC299-87E9-505A-A5AB-06901A470E6B","مرت بنا في الدير خمصانة","ساحرة الناظر فتانه"],["0BCCAA1A-8792-5F66-8E3A-772A2EEAE2D4","أبرزها الرهبان من خدرها","تعظم الدير ورهبانه"],["A9DE55D1-BDB0-5A98-B7B6-0BE8916CB0AB","مرت بنا تخطر في مشيها","كأنما قامتها بانه"],["6395A46D-B946-5B95-A477-667A74BA3236","هبت لها ريح فمالت بها","كما تثنى غصن ريحانه"],["828892F7-4EAA-5CE9-921C-B1F9E942EB1F","فتيمت قلبي وهاجت له","أحزانه قدما وأشجانه"]]},"6622EA55-4474-5AC5-9B10-969FC2D1E763":{"t":"وإذا رأيت فتى بأعلى رتبة","p":125,"s":"وإذا رأيت فتى بأعلى رتبة","r":"477700","v":[["AB517919-809B-58C1-AE1E-D20821EFF2AC","وإذا رأيت فتى بأعلى رتبة","في شامخ من عره المترفع"],["B8EA0B8D-F8A2-5412-BF92-6A882AB46F33","قالت لي النفس العروق بفضلها","ما كان أولاني بهذا الموضع"]]},"0BB6F3F6-2187-540B-92CF-6147FA31F7C2":{"t":"والبدر يزهر في السماء كأنه","p":125,"s":"والبدر يزهر في السماء كأنه","r":"477712","v":[["C127A143-2A48-55BD-BDA5-683A4D854402","والبدر يزهر في السماء كأنه","وحبه الذي أهوى ولا يهواني"],["1D6A8DB6-5877-5A6C-B921-429BB5B7CC8D","والكاس دائرة بكف مقرطق","خنث الكلام مفتر الأجفان"],["F4228E74-1195-5D54-A724-95237782B9C0","لم أنس ليلتنا به ياليتها","دامت فكانت مدتي وزماني"]]},"71332CC2-A71A-5D75-B219-4D28D2852AFC":{"t":"وبكر شربناها على الورد بكرة","p":125,"s":"وبكر شربناها على الورد بكرة","r":"477690","v":[["3F92D2C2-0967-5128-9C13-945479DD52F2","وبكر شربناها على الورد بكرة","فكانت لنا وردا إلى ضحوة الغد"],["99195DD4-BB8E-5ED6-9C9C-C3E844579BDF","إذا قام مبيض اللباس يديرها","توهمته يسعىبكم مورد"]]},"5F19C225-E611-54D8-8876-070FDB771F1F":{"t":"وسلاف كالتبر أذكى من الم","p":125,"s":"وسلاف كالتبر أذكى من الم","r":"477713","v":[["B7345AC6-07BC-53A4-9550-06D68C428718","وسلاف كالتبر أذكى من الم","سك وأصفى صبغى من الزعفران"],["1A200F6D-5D99-5E11-AD24-9ECEB9281CB0","وكأن اليد التي تحتويها","من صبيب العقيان في دستبان"]]},"178A9344-3C20-5D80-8557-1EBC8F878459":{"t":"ولما انتجعنا لائذين بظله","p":125,"s":"ولما انتجعنا لائذين بظله","r":"477710","v":[["A89A5534-266F-5075-B3A2-301739591DC9","ولما انتجعنا لائذين بظله","أعان وما عنى ومن وما متى"],["2619755C-3CB7-5B91-84FE-8412A6CAC3B2","وردنا عليه مقترين فراشنا","وردنا نداه مجدبين وأخصبنا"]]},"F494CE7E-0403-5B67-BC52-0A6A9D8952BF":{"t":"يا أيها القاضي السني الذكر","p":125,"s":"يا أيها القاضي السني الذكر","r":"477693","v":[["8E5433D5-ED04-561D-81C2-82506DBC9CDA","يا أيها القاضي السني الذكر","ومن علا على قضاة العمر"],["270D00CE-C4E3-5A90-9209-680B3C8A8893","قد اجتمعنا في محل وعر","ومنزل ضنك ومثوى قمر"],["6DD88B3B-9CA2-5EB4-9B68-D61C4B652F31","خال من الخير كثير الشر","نلقى زماني ألم وضر"],["4D9AB2A6-5D3B-5F82-9B1A-606B5335A86F","من ليل بق ونهار حر","فقد فقدت جلدي وصبري"],["DB3CE4F1-2032-59B2-B054-2C62CEFE2544","وليس لي عند مجيء فكري","سوى تشكي فادحات أمري"],["83FE1E98-4AF2-5F5F-9F64-7991C9528035","بقلم يحطها في سطر","إلى فتى ذي أدب وقدر"],["EABBD3F9-4AB1-5FF8-9C0A-4D8BD468374E","فاسمع لكشواي وحبد بعذر","قد صفرت محبرتي من حبر"],["56201999-D599-5CEF-A055-4748676F1AC6","ولم أجده مشترى فأشري","فجد حباك الله طول عمر"],["831001E7-AC77-5D6B-8755-276D665DF05A","بمثلها حبرا وفر بشكري","من بين نظم حسن ونشر"],["79162413-83CB-5601-AD62-135C12B7B938","ورب مجد باسق وفخر","نالهما الحر ببذل النزر"]]},"07F4E1FA-130B-539B-9226-7CD0C09CE2B6":{"t":"يا سماء اسقطي ويا أرض ميدي","p":125,"s":"يا سماء اسقطي ويا أرض ميدي","r":"477689","v":[["4E13D106-DD80-519F-B490-B10CA0796113","يا سماء اسقطي ويا أرض ميدي","قد تولى الوزارة ابن البريدي"],["1ED2E54B-E195-579E-ACA6-468A2C827E6B","جل خطب وحل أمر عضال","وبلاء أشاب رأس الوليد"],["5103E8E2-EE01-5DF4-AFD6-F05C2E2699EE","هد ركن الإسلام وانتهك المل","ك ومحيت آثاره فهو مودي"],["A47DF1D2-CB85-5938-9633-38BD83462A37","اخلقت بهجة الزمان كما أن","هج طول اللباس وشي البرود"],["946A4F5A-A8AB-5BDD-936E-B65BB3470DEF","يا لقومي لحر صدري وعولي","وغليلي وقلبي المعمود"],["CF5971D6-F249-53F0-8137-638BF3A6365C","حين سار الخميس يوم خميس","بالبريدي في ثياب سود"],["D558491F-5335-5699-B4A1-BF162229A8A2","قد حباه بها الإمام اصطفاء","واعتمادا منه لغير عميد"],["5855DDFB-1D19-5752-BF40-927FA0C2FC2F","خلع تخلع العلا ولواء","عقدة حل عقدة المعقود"],["73DA5CA0-7B41-5AC4-BBD0-6C3EBC216784","وتوهمت أن سيخدعه ذا","ك فيغتاله اصطياد الصيود"],["AC5C19B1-023D-5C96-A284-976BA328EB65","هو أزنى مما تقدر أما","ليس ممن يصاد بالتقليد"]]},"4F4FA3E1-2B03-5A62-96DC-FF8996352FE2":{"t":"يا فرحة الهم بعد اليأس من فرج","p":125,"s":"يا فرحة الهم بعد اليأس من فرج","r":"477704","v":[["9A24B6DD-FD50-5B09-AC0C-BB4E61420658","يا فرحة الهم بعد اليأس من فرج","يا فرحة الأمن بعد الروع من وهل"],["C569693D-5D9C-5D74-B0AD-014736AD90CD","اسلم ودم وابق واملك وانم واسم ورد","واعط وامنع وضر وانفع وصل وصل"]]},"406EEE74-922B-5360-BA9A-7F00F735C456":{"t":"يا لحدب الظهور فصع الرقاب","p":125,"s":"يا لحدب الظهور فصع الرقاب","r":"477688","v":[["6ED58751-980D-53FF-ADBD-C6FAF3DC84C3","يا لحدب الظهور فصع الرقاب","لدقاق الأنياب والأذناب"],["1002596C-1179-5D74-B66A-E425AFE2B946","خلقت للفساد مذ خلق الخل","ق وللعيث والأذى والخراب"],["50A09C76-AD41-58B3-B6AB-A7A6DD91536A","ناقبات في الأرض والسقف والحي","طان نقبا أعيا على النقاب"],["8CA60D5C-4E61-5F68-83BE-4AE9D623701F","أكلات كل المآكل لاتا","منها شاربات كل الشراب"],["0D6DADA1-77C5-5248-A44B-240347F0A635","آلفات قرض الثياب وقد يع","دل قرض القلوب قرض الثياب"],["CE785612-FA96-5FA4-8EC3-BED66ABCDF48","زال همي منهنّ أزرق ترك","ي السبالين أنمر الجلباب"],["7B24993C-85C5-57F2-A695-4007596EF4CD","ليث غاب خلقا وخلقا فمن لا","ح لعينيه خاله ليث غاب"],["2915A971-EBBC-54F3-A6AB-F3671CB16A56","ناصب طرفه إزاء الروايا","وإزاء السقوف والأبواب"],["7347CA5F-192C-5626-9428-067217CBA9B5","يتتضي الظفر حين يطفر للصي","د وإلا فظفره في قراب"],["1B709768-8018-5A67-9AEC-850CD899EFFD","لا ترى اخبثيه عين ولا يع","لم ما جثتاه غير التراب"],["54D2E55D-C350-5998-B73A-7086F07D45D2","قرطوه وشتفوه وحلو","ه أخيرا وأولا بالخضاب"],["E2B0B1FA-0EE8-5C62-A396-E396457E3DE0","فهو طورا يمشي بحلى عروس","وهو طورا يحطو على عتاب"],["F27F49C4-10A7-5E8A-BFAA-9362C8BCBA8B","حبذا ذاك صاحبا هو في الصح","بة أوفى من اكثر الأصحاب"]]},"1C9157EF-0217-50CD-9E6B-5907866B68F7":{"t":"يا من أظل بباب داره","p":125,"s":"يا من أظل بباب داره","r":"477697","v":[["BBE660B8-BB03-592A-AB91-3C21B68FE603","يا من أظل بباب داره","ويطول حبسي بانتظاره"],["E7C88C63-2CCC-5786-990E-66CA1B8AEFD4","وحياة وجهك واحمراره","وجمال صدغك في مداره"],["4870F7CB-BCC5-5000-A08C-74B6CE0A44A3","لا حلت عمري عن هوا","ك ولو صليت بحر ناره"]]}}}