{"v":1,"poems":{"764D4362-EE33-59DE-A21F-530E01286C6E":{"t":"و ما كنتُ أخشى أنْ أبيتَ وبيننا","p":126,"s":"و ما كنت أخشى أن أبيت وبيننا","r":"451584","v":[["7208655F-79C0-5F5C-8831-B048E30E061F","و ما كنتُ أخشى أنْ أبيتَ وبيننا","خليجانِ و\" الدربُ \" الأشمُّ و\" آلسُ \""],["EE273F3F-B7C7-5BF5-9B36-C6D451596169","ولا أنني أستصحبُ الصبرَ ساعةً","ولي عنكَ مناعٌ ودونكَ حابسُ"],["A1DA61CF-1AC0-5C16-9C68-7175B5822984","ينافسني فيكَ الزمانُ وأهلهُ","وَكُلُّ زَمَانٍ لي عَلَيْكَ مُنَافِسُ"],["90B09F0A-CD15-5496-96D5-FFB647ACCE0B","شرَيتُكَ من دهرِي بذي النّاس كلّهم","فلا أنا مَبخُوسٌ وَلا الدّهرُ بَاخِسُ"],["B3C7C6F7-C53E-5A6A-9899-61D073A3C8AF","وَمَلّكتُكَ النّفسَ النّفيسَة طائِعاً،","و تبذلُ للمولى النفوسُ النفائسُ"],["A9325826-EAB1-50F3-A245-3D81EF66005C","تَشَوّقَني الأهْلُ الكِرَامُ وأوْحَشَتْ","مَوَاكِبُ بَعْدِي عِنْدَهُمْ وَمَجالِسُ"],["A0DDDC2F-0D25-557B-9F99-1F408019C1DC","وَرُبّتَمَا زَانَ الأمَاجِدَ مَاجِدٌ،","وَرُبّتَمَا زَانَ الفَوَارِسَ فَارِسُ!"],["04D37873-1201-571A-9E6C-29375404F526","رفعتُ على الحسادِ نفسي؛ وهلْ همُ","و ما جمعوا لوْ شئتُ إلا فرائسُ؟"],["A343C4FF-CF3C-5533-A439-905AFDF06943","أيدركُ ما أدركتُ إلاَّ ابنُ همةٍ","يُمَارِسُ في كَسبِ العُلى ما أُمارِسُ؟"],["E10A2628-BAE4-5FDD-B4FA-5331D085A0FB","يضيقُ مكاني عنْ سوايَ لأنني","عَلى قِمّةِ المَجْدِ المُؤثَّلِ جَالِسُ"],["4EB76D7E-A159-53FB-A8C3-EEDAE0D0F0D4","سبقتُ وقومي بالمكارمِ والعلاَ","و إنْ زعمتْ منْ آخرينَ المعاطسُ"]]},"4D98043B-B67C-51B5-9EF1-BB45C1E6636E":{"t":"و ما هوَ إلاَّ أنْ جرتْ بفراقنا","p":126,"s":"و ما هو إلا أن جرت بفراقنا","r":"451498","v":[["180C80BF-C187-5470-8B2D-C18E9EFC547D","و ما هوَ إلاَّ أنْ جرتْ بفراقنا","يَدُ الدّهرِ حتى قيلَ، مَن هُوَ حارِثُ؟"],["AD4C6EF6-8DD4-5CAA-BB22-0F0438C2C6D7","يُذَكّرُنا بُعْدُ الفِرَاقِ عُهُودَهُ،","وَتِلْكَ عُهُودٌ قَدْ بَلِينَ رَثَائِثُ"]]},"4E017096-2286-5807-B26A-721E8B0717B8":{"t":"و مرتــدٍ بطرةٍ","p":126,"s":"و مرتــد بطرة","r":"451607","v":[["21EC2118-10B2-5582-8E49-5CC3CF1A4DD4","و مرتــدٍ بطرةٍ،","مُسْبَلَةِ الرّفَارِفِ"],["286CA0D0-4EFB-5BC5-8815-EBD75FE0D91C","كَأنّهَا مُرْسَلَةٌ","مِنْ زَرَدٍ مُضَاعَفِ"]]},"5F44963C-DA79-5993-A51D-50BCEAE1C2F8":{"t":"و يومٍ جلا فيهِ الربيعُ بياضهُ","p":126,"s":"و يوم جلا فيه الربيع بياضه","r":"451576","v":[["0BDAD40F-5297-57AB-9BF1-C2FF63735982","و يومٍ جلا فيهِ الربيعُ بياضهُ","بِأنْوَاعِ حَليٍ، فَوْقَ أثوَابِهِ الخُضْرِ"],["94FACD72-501C-54D8-860E-F5B05289DC3B","كأنَّ ذيولَ الجلنارِ، مطلةً،","فُضُولُ ذُيولِ الغانِياتِ من الأُزْرِ"]]},"C3D870F2-F7A1-59D8-8193-4B958916EBAA":{"t":"وإنْ ضاقَ الخناقُ حماها","p":126,"s":"وإن ضاق الخناق حماها","r":"451710","v":[["78DF465F-1AAC-59C1-8945-6E3C6D90BBB5","..........","علاها، وإنْ ضاقَ الخناقُ حماها"],["671C881F-933F-52D4-87A8-6E39E572517A","و ما اشتورتْ إلاَّ وأصبحَ شيخها،","وَلا أحْرَبَتْ إلاّ وَكَانَ فَتَاهَا"],["1732FB68-6227-5DBF-A86A-36123CB3B1F0","وَلا ضُرِبَتْ بَينَ القِبَابِ قِبَابُهُ،","وأصبحَ مأوى الطارقينَ سواها"]]},"F7FE8AE3-729F-5A3E-A7EE-53C50D9A06F7":{"t":"وداعٍ دعاني والأسنةُ دونهُ","p":126,"s":"وداع دعاني والأسنة دونه","r":"451535","v":[["C974840D-4B47-5611-B59C-BD2BD6BF3DFE","وداعٍ دعاني، والأسنةُ دونهُ،","صببتُ عليهِ بالجوابِ جوادي"],["69355747-36BF-5C33-AC37-22BFA1C31244","جنبتُ إلى مهري المنيعيِّ مهرهُ","وَجَلّلْتُ مِنْهُ بِالنَّجِيعِ نِجَادي"]]},"5FE21B59-7E0A-5913-8AF3-3840C5C435E7":{"t":"وراءكِ يا \" نميرُ\" ‍! فلا إمامُ","p":126,"s":"وراءك يا \" نمير\" ‍! فلا إمام","r":"451670","v":[["60BD2552-5CEE-5FB1-BB5F-3928AF9804DF","وراءكِ يا \" نميرُ\" ‍! فلا إمامُ","فَقَدْ حَرُمَ الجَزِيرَةُ وَالشّآمُ"],["7EC79A00-FBE4-5573-AD0D-1E44550E774C","لَنَا الدّنْيَا، فَمَا شِئْنَا حَلالٌ","لِسَاكِنِهَا، وَما شِئْنَا حَرَامُ"],["EDDADFB9-F263-5AFB-966B-38838A079102","وَيَنْفُذُ أمْرُنَا، في كُلّ حَيٍّ،","فَيُدْنِيهِ وَيُقْصِيهِ الكَلامُ"],["BC5B0842-8245-5469-A8B0-EE1ECC3B85A7","أرَاجِيَةً خُوَيْلَفَةً ذِمَاماً","وراءكِ، لا أمانَ ولا ذمامُ ‍!"],["A843629D-C422-5898-9CAF-522C5854174E","ألَمْ تُخْبِرْكِ خيلُكِ عن مَقامي","بِبَالِسَ يَوْمَ ضَاقَ بِهَا المَقَامُ!"],["F8DB3711-4455-5B4F-9095-FA3B19ABFBA4","وَولّتْ تَتّقي، بَعْضاً بِبَعْضٍ،","لهمْ -والأرضُ واسعةٌ - زحامُ"],["46E316E2-8A16-52E0-B194-D3C6960B908F","سروا والليلُ يجمعنا، ولمنْ","يبوحُ بهمْ،ويكتمنا الظلامُ"],["8F274790-8F03-5ECB-9648-1DADF8125172","إلى أنْ صبَّحتهمْ بالمنايا","كَرَائِمُ، فَوْقَ أظْهُرِهَا كِرَامُ"],["15E98A49-58FC-56EF-B80C-0A2898915E1B","مِنَ الَعَرَشَاتِ تَلْحَقُ مَا رَأتْهُ","إذا طلبتْ، وتعطى ما تسامُ"],["3E778119-5748-5754-9EAC-7152F246DAC9","تَنَازَعُ بي وَبِالفُرْسَانِ حَوْلي","تجفلهمْ، كما جفلَ النعامُ"],["5C7FAD37-11E6-5785-A9EF-491C9AA9702F","بطحنا منهمُ \" مرجَ بنَ جحشٍ \"","فَلَمْ يَقِفُوا عَلَيْهِ، وَلمْ يُحامُوا"],["84E74F95-6739-5D35-875A-B6127190C27B","أقُولُ لمُطْعِمٍ لمّا التَقَيْنَا،","وَقَدْ وَلَّى وَفي يَدِيَ الحُسَامُ"],["1D083DA3-B748-5B7F-BA9C-13454B17AB6E","أتجعلُ بيننا عشرينَ كعباً","وَتَهْرُبُ! سَوْءَةً لكَ يا غُلامُ!"],["06F3B6E0-2F1A-560E-9928-C224FC44937A","أحَلّكُمُ بِدَارِ الضّيْمِ، قَسْراً،","هُمَامٌ لا يُضَامُ، وَلا يُرَامُ!"]]},"7D715A21-9358-5A15-880E-8BB38801DACA":{"t":"وللهِ عندي في الإسارِ وغيرهِ","p":126,"s":"ولله عندي في الإسار وغيره","r":"451659","v":[["D3430F6A-1C06-59AE-A154-27C7A4DD721C","وللهِ عندي في الإسارِ وغيرهِ","مَوَاهِبُ، لَمْ يُخصَصْ بها أحدٌ قَبلي!"],["E511D9E6-8595-54A8-A6C7-C2353FF50C49","حللتُ عقوداً، أعجزَ الناسَ حلها،","وَما زَالَ عَقدي لا يُذَمّ وَلا حَلِّي"],["479C0C76-3ECA-534B-9137-99B3482A30B5","إذَا عَايَنَتْني الرّومُ كَفّرَ صِيدُهَا،","كأنّهُمُ أسرَى لَدَيّ وَفي كَبْلي"],["F4673D8A-ECFD-5FB3-ABA7-D88FAA1DEC70","وَأُوسَعُ، أيّاً مَا حَلَلْتُ، كَرَامَةً،","كأنني منْ أهلي نقلتُ إلى أهلي"],["FF31798D-C82C-5E8C-AFDE-62806158508C","فقلْ لبني عمي، وأبلغْ بني أبي:","بِأنيَ في نَعْمَاءَ يَشْكُرُهَا مِثْلي"],["57EAFA0C-F970-57D8-9926-322BC2D12077","وَمَا شَاءَ رَبي غَيرَ نَشْرِ مَحَاسِني،","وأن يعرفوا ما قد عرفتُ منَ الفضلِ"]]},"CA2F4670-4947-531E-AE05-8309BBCC9822":{"t":"ولي مِنّةٌ في رِقَابِ الضبَاب","p":126,"s":"ولي منة في رقاب الضباب","r":"451575","v":[["C7DE3B66-8C93-51C2-842D-4F04CE8C108D","ولي مِنّةٌ في رِقَابِ الضبَاب،","وأُخْرى تَخص بَني جَعْفَرِ"],["BCA4AD64-E2D0-5AD6-9742-6BFD5E921B2E","عشيةَ روَّحنَ من \" عرقةٍ \"","وَأصْبَحْنَ فَوْضَى، عَلى شَيْزَرِ"],["9BF14402-A371-554C-BD41-B33545A33104","وقد طالَ ما وردتْ \" بالجباة \"","وَعَاوَدَتِ المَاءَ في تَدْمُرِ"],["CA817C10-96F5-524D-A2E2-B7DA5F203F4F","قَدَدْنَ البَقِيعَةَ، قَدّ الأدِيـ","ـمِ، وَالغَرْبُ في شَبَهِ الأشْقَرِ"],["4E9007FE-437E-5EF4-ADB0-62BB92C85344","و جاوزنَ \" حمصَ \"؛ فلمْ ينتظرْ","نَ على موردٍ أو على مصدرِ"],["C9959717-1479-530C-AB05-8E2114236AF3","وَبِالرَّسْتَنِ اسْتَلَبَتْ مَوْرِداً،","كَوِرْدِ الحَمَامَةِ أوْ أنْزَرِ"],["80894074-2A5A-5DD7-A90A-38489A4CC817","وَجُزْنَ المُرُوجَ، وَقَرْنَيْ حَمَاةَ","و \"شيزرَ \"، والفجرُ لمْ يسفرِ"],["3413080B-7BDE-5EC1-B056-6CE9EB2B61EF","و غامضتِ الشمسً إشراقها","فَلَفّتْ كَفَرْطَابَ بِالعَسْكَرِ"],["32F296D2-C9D1-5477-A737-4755ECAF2106","ولاقتْ بها عصبَ الدارعيــ","ـنَ بكلِّ منيعِ الحمى مسعرِ"],["79BF36E2-7A0E-54B6-A513-04D00883DFAF","عَلى كُلّ سَابِقَةٍ بِالرّدِيفِ،","وكلِّ شبيهٍ بها مجفرِ"],["BD67738F-1FF0-5BE1-83AA-D5AC5B885BC7","و لما اعتفرنَ ولما عرقنَ","خَرَجْنَ، سِرَاعاً، مِنَ العِثْيَرِ"],["04B1A486-CB77-5C4E-8CA1-3F02168AFAEA","نُنَكِّبُ عَنْهُنّ فُرْسَانَهُنّ،","ونبدأُ بالأخيرِ الأخيَرِ"],["B0EA4AB5-6991-54F0-B0C9-D6CFA4A5C499","فلما سمعتُ ضجيجَ النسا","ءِ ناديتُ: \" حارِ\"، ألا فاقصر!"],["1D9CF5ED-D83C-5CF4-8EA0-CA48E55BEECB","أ \"حارثُ \" منْ صافحَ، غافرٌ","لهنَّ، إذا أنتَ لمْ تغفرِ؟!"],["819FD75C-1404-52D2-AD5A-0DD585167739","رَأى ابنُ عُلَيّانَ مَا سَرّهُ","فَقُلْتَ: رُوَيْدَكَ لا تُسْرَرِ!"],["08FE73E4-4722-56E2-ABF7-17C3C0453F1B","فإني أقومُ بحقِِّ الجوا","رِ ثُمّ أعُودُ إلى العُنْصُرِ"]]},"8EB737E6-00D9-5A16-8151-1046CAC885CA":{"t":"وواللهِ ما أضمرتُ في الحبِّ سلوةً","p":126,"s":"ووالله ما أضمرت في الحب سلوة","r":"451577","v":[["1D079EA5-C300-524E-ABE0-0FE869966962","وواللهِ، ما أضمرتُ في الحبِّ سلوةً،","وواللهِ، ماحدثتُ نفسيَ بالصبرِ"],["CFA45482-E004-5D34-AFA3-08DAC8CD4B7D","و إنكَ في عيني، لأبهى منَ الغنى،","وإنكَ، في قلبي، لأحلى منًَ النصرِ"],["87BE4A3B-4D71-5B6A-AFAF-5D61D838CF51","فيا حكمي المأمولَ جرتَ معَ الهوى ‍!","وياثقتي المأمونَ، خنتَ معَ الدهرِ ‍!"]]},"1EA7D1BB-8B1D-5751-8F68-97389989194C":{"t":"ويقولُ فيَّ الحاسدونَ تكذباً","p":126,"s":"ويقول في الحاسدون تكذبا","r":"451637","v":[["A7A0D5B2-5DC2-548D-971B-93958F397C6B","ويقولُ فيَّ الحاسدونَ، تكذباً،","ويقالُ في المحسودِ ما لا يفعلُ"],["E0B86257-B6DE-5EAD-A435-A5E82AE03C58","يتطلبونَ إساءتي لا ذمتي،","إنَّ الحسودَ، بما يسوءُ، موكلُ"]]},"C2E75271-EB57-53E9-8485-E7C71B71A700":{"t":"وَإذَا يَئِسْتُ مِنَ الدّنُـ","p":126,"s":"وإذا يئست من الدنـ","r":"451531","v":[["138DFFE8-D1CA-5794-A4B5-3459688647FD","وَإذَا يَئِسْتُ مِنَ الدّنُـ","ـوّ رَغِبْتُ في فَرْطِ البِعَادِ"],["63B4BFF7-E01C-54E9-9A57-56FBDD01B91A","أرْجُو الشّهَادَةَ في هَوَا","كَ لأنّ قَلْبي في جِهَادِ"]]},"A8121EF6-3CBB-5109-B900-07954B572AB5":{"t":"وَإنّي لأنْوِي هَجْرَهُ فَيَرُدّني","p":126,"s":"وإني لأنوي هجره فيردني","r":"451696","v":[["F46C8D1E-768D-5DE0-A167-EA7BAA33306E","وَإنّي لأنْوِي هَجْرَهُ فَيَرُدّني","هوى، بينَ أثناءِ الضلوعِ، دفينُ"],["6FC01AEF-2D48-5D82-8A1E-AFAFFA645FF5","فيغلظُ قلبي، ساعةً ثمَّ ينثني","وأقسوْ عليهِ، تارةً، ويلينُ"],["923FFBB6-27D8-5129-9AC1-B3C713CF53D6","وَقَدْ كَانَ لي عن وُدّهِ كُلُّ مَذهَبٍ،","و لكنَّ مثلي بالإخاءِ ضنينُ"],["8C8EAE62-AAB4-5FCA-9798-32E6DC308178","و لاَ غروَ أنْ أعنو لهُ، بعدَ عزةٍ،","فقدريَ، في عزِّ الحبيبِ، يهونُ!"]]},"FA4F27AF-D792-5819-B92B-1C16DE0736CE":{"t":"وَجُلّنَارٍ مُشْرِقٍ","p":126,"s":"وجلنار مشرق","r":"451550","v":[["3CCBAFF8-169A-54A3-992B-0FE82C2790D2","وَجُلّنَارٍ مُشْرِقٍ،","عَلَى أعَالي شَجَرَهْ"],["BD8295C2-0DC9-5FAE-A660-436376C1FB67","كأنَّ في رؤوسهِ،","أصْفَرَهُ، وَأحْمَرَهْ"],["E25231DA-B8A9-5F3C-B030-7AF983804B5A","قُرَاضَةً مِنْ ذَهَبٍ","في خرقٍ معصفره"]]},"2333707D-86AC-57CC-A150-8319529E3D5D":{"t":"وَدّعُوا خِشْيَةَ الرّقِيبِ بإيمَا","p":126,"s":"ودعوا خشية الرقيب بإيما","r":"451681","v":[["56028066-521B-59F0-9D9C-9D0DBDA5B437","وَدّعُوا، خِشْيَةَ الرّقِيبِ، بإيمَا","ءٍ، فَوَدَّعْتُ، خَشْيَةَ اللُّوّامِ"],["2850E44A-2139-537F-8943-31BAD22342E3","لمْ أبحْ بالوداعِ، جهراً ولكنْ","كانَ جفني فمي، ودمعي كلامي!"]]},"C337BFE5-32EA-55AF-96E6-271FB29E3912":{"t":"وَزِيَارَةٍ مِنْ غَيرِ وَعْدِ","p":126,"s":"وزيارة من غير وعد","r":"451528","v":[["227836F6-DCF6-5CE4-B197-15506025D0D2","وَزِيَارَةٍ مِنْ غَيرِ وَعْدِ،","في لَيْلَةٍ طُرِقَتْ بِسَعْدِ"],["7BFA20FF-8F66-5F3D-BEA7-24ADE79FFC3D","بَاتَ الحَبِيبُ إلى الصّبَا","حِ معانقي خداً لخدِّ"],["0FF79791-44CC-5C4F-90AF-C9A05A71C670","يُمْتَارُ فيّ وَنَاظِري","ما شئتَ منْ خمرِ ووردِ"],["E22B2D4B-33E7-5573-BAEC-AFAED3D6BE27","قَدْ كَانَ مَولايَ الأجـ","ـلّ، فَصَيّرَتْهُ الرّاحُ عَبْدِي"],["22D0187A-BD2E-57F4-A2FB-013E855FC21A","لَيْسَتْ بِأوّل مِنّةٍ","مشكورةٍ للراحٍِ عندي"]]},"53D115C4-098B-5421-BF0B-12A4A8D23758":{"t":"وَشَادِنٍ قالَ لي لمّا رَأى سَقَمي","p":126,"s":"وشادن قال لي لما رأى سقمي","r":"451665","v":[["358AE1FB-D7F2-5E9D-B79C-39DEF0116228","وَشَادِنٍ قالَ لي، لمّا رَأى سَقَمي","وضعفَ جسمي والدمعَ الذي انسجما"],["9FFCFE8D-C742-53F8-A223-6103455CB531","أخذتَ دمعكَ منْ خدي، وجسمكَ من","خصرِي وَسُقمَك من طرْفي الذي سَقُما"]]},"CF2ECFF5-38E0-5005-ADA6-5D6848A20FCB":{"t":"وَشَادِنٍ من بَني كِسرَى شُغِفْتُ بهِ","p":126,"s":"وشادن من بني كسرى شغفت به","r":"451544","v":[["04F18504-75F3-5959-9E30-E60282DBAC92","وَشَادِنٍ، من بَني كِسرَى، شُغِفْتُ بهِ","لَوْ كانَ أنْصَفَني في الحُبّ مَا جَارَا"],["BA9EB998-00E3-543D-BD16-8B5E4CFFE9C4","إنْ زارَ قصَّر ليلي في زيارتهِ","وَإنْ جَفَاني أطَالَ اللّيْلَ أعْمَارَا"],["0A3D70B3-CA3E-5616-8B23-E5C3545867F4","كأنّما الشّمسُ بي في القَوْسِ نازِلَةٌ","إنْ لم يَزُرْني وَفي الجَوْزَاءِ إنْ زَارَ"]]},"39202B52-9EB0-55AA-934F-DA17139A2F6F":{"t":"وَعَطّافٍ عَلى الغَمَرَاتِ نَحْوِي","p":126,"s":"وعطاف على الغمرات نحوي","r":"451635","v":[["00DCFE05-7C1D-5761-A748-58276AE87058","وَعَطّافٍ عَلى الغَمَرَاتِ نَحْوِي،","تَحُفّ بهِ المُثَقَّفَةُ الطّوَالُ"],["F58B7865-9D1B-5040-B492-D22AEF92A024","تركتُ الرمحَ، يخطرُ في حشاهُ،","لَهُ، مَا بَينَ أضْلُعِهِ، مَجَالُ"],["6589E353-9F3E-5E9E-8D19-1CE25FCB5338","يَقُولُ، وَقَدْ تَعَدّلَ فيهِ، رُمْحي:","\" لأمرٍ ما تحاماكَ الرجالُ! \""]]},"6FF00013-F12B-5C55-B022-5956F4A888E2":{"t":"وَعِلّةٍ لَمْ تَدَعْ قَلْباً بِلا ألَمٍ","p":126,"s":"وعلة لم تدع قلبا بلا ألم","r":"451489","v":[["A33F7841-00AC-5BEA-AE20-857861918419","وَعِلّةٍ لَمْ تَدَعْ قَلْباً بِلا ألَمٍ","سَرَتْ إلى طَلَبِ العَلْيَا وَغَارِبِهَا"],["68D387B5-4EDA-5CCC-A98E-1C957C2CA57C","هَلْ تُقبَلُ النّفسُ عَن نَفسٍ فأفديَه؟","اللَّهُ يَعْلَمُ ما تَغْلُو عَلَيّ بِهَا"],["1AC094E5-B210-5766-94D6-7295FBAA4B0B","لئنْ وهبتكَ نفساً لا نظيرَ لها","فَمَا سَمَحْتُ بِهَا إلاّ لِوَاهِبِهَا"]]},"2DF7CEB5-1329-57BB-9F83-CEDB309815C7":{"t":"وَقَدْ أرُوحُ قَرِيرَ العَينِ مُغْتَبِطاً","p":126,"s":"وقد أروح قرير العين مغتبطا","r":"451505","v":[["47763036-917C-597E-B642-E9909F700F96","وَقَدْ أرُوحُ، قَرِيرَ العَينِ، مُغْتَبِطاً","بصَاحِبٍ مِثلِ نَصْلِ السّيفِ وَضّاحِ"],["144E7377-42E4-5A7B-8EA4-7E84256D2796","عذبِ الخلائقِ، محمودٍ طرائقهُ،","عَفّ المَسامعِ، حتى يَرْغَمَ اللاّحي"],["E37C41CE-91CC-5F3B-B0AD-46DB79314D17","لما رأى لحظاتي في عوارضهِ،","فيما أشاءَمنَ الريحانِ والراحِ"],["052BA6FC-1493-569E-9B58-1EF9DE29AE8E","لاثَ اللّثَامَ عَلى وَجْهٍ أسِرَّتُهُ","كَأنّها قَمَرٌ أوْ ضَوءُ مِصْبَاحِ"]]},"EBB299C2-CAEE-5B0C-871B-1733DD95A2D2":{"t":"وَقَفَتْني عَلى الأَسَى وَالنّحِيبِ","p":126,"s":"وقفتني على الأسى والنحيب","r":"451495","v":[["86D7C75A-51B7-5737-A019-DF582C348D42","وَقَفَتْني عَلى الأَسَى وَالنّحِيبِ","مُقْلَتَا ذَلِكَ الغَزَالِ الرّبِيب"],["F631FDEC-9EED-58CD-9FB2-18B77AA56715","كلما عادني السلوُّ؛ رماني","غنْجُ ألحاظِهِ بِسَهْمٍ مُصِيبِ"],["8F82EEE2-AF0B-5641-8DC1-B762909C2C04","فَاتِرَاتٍ قَوَاتِلٍ، فَاتِنَاتٍ،","فاتكاتٌ سهامها في القلوبِ"],["BE3580CF-0ABB-59A3-8DCB-F75E62ABBECB","هَلْ لِصَبٍّ مُتَيَّمٍ مِنْ مُعِينٍ؟","و لداءٍ مخامرٍ منْ طبيبِ؟"],["1DC9F91A-6EDD-5D19-8C7D-8F116D2186E0","أيّهَا المُذْنِبُ المُعَاتِبُ حَتى","خِلْتُ أنّ الذّنُوبَ كانَتْ ذُنوبي"],["65E45BD9-F9BB-57BF-A6D4-9EB7F81950C0","كنْ كما شئتَ منْ وصالٍ وهجرٍ","غِيَرُ قَلْبي عَلَيْكَ غَيرُ كَئِيبِ"],["B7074813-40BE-593A-8FB2-9A7ED2059641","لكَ جسمُ الهوى، وثغرُ الأقاحي،","و نسيمُ الصبا، وقدُّ القضيبِ"],["5F0BE3BC-E68E-5E14-9C74-391AEF0E7926","قَد جَحدتَ الهَوَى وَلكِنْ أقَرّتْ","سِيمِيَاءُ الهَوَى وَلَحظُ المُرِيبِ"],["EB25A4A4-7B85-5F4C-AF4E-9B21A0F822DE","أنا في حالتي وصالٍ وهجرٍ","من جوى الحبِّ في عذابٍ مذيبِ"],["CB9EA33C-5D86-5E06-ACBC-B4F879162808","بينَ قربٍ منغصٍ بصدودٍ","ووصالٍ منغصٍ برقيبِ"],["6FC3A403-600A-530E-A9EA-1A2DF517FE45","يَا خَلِيليَّ، خَلِّياني وَدَمْعي","إنّ في الدّمْعِ رَاحَةَ المَكْرُوبِ"],["815EE6C1-56F2-506E-8D91-FE9E3E421821","ما تقولانِ في جهادٍ محبٍ","وَقَفَ القَلْبَ في سَبِيلِ الحَبِيبِ؟"],["93ECE56D-2F12-5AE1-B7DB-80DEAF158572","هلْ منَْ الظاعنينَ مهدٍ سلامي","للفَتى المَاجِدِ الأرِيبِ الأدِيبِ؟"],["C3C56992-0015-59BF-BF07-C2C90F237B6E","ابنُ عَمّي الدّاني عَلى شَحطِ دارٍ","وَالقرِيبُ المَحَلّ غَيرُ قَرِيبِ"],["802ED721-F4E2-5206-86AE-450215720A57","خالصُ الودِّ، صادقُ الوعدِ، أنسي","في حُضُورِي مُحافظٌ في مَغِيبي"],["22520B15-CBA7-53F0-A587-94FEDD2829C2","كُلَّ يَوْمٍ يُهْدي إليّ رِيَاضاً","جادها فكرهُ بغيثٍ سكوبِ"],["BF5446E6-7AC0-59C7-91F7-881F568D2219","وارداتٍ بكلِ أنسٍ وبرٍّ","وَافِدَاتٍ بِكُلّ حُسْنٍ وَطِيبِ"],["CBF529F7-D360-5CA5-A6E0-3E767B208D8C","\" يابنَ نصرٍ \" وقيتَ بؤسَ الليالي","و صروفَ الردى، وكربَ الخطوبِ"],["02535B7E-8B61-5645-B69C-25BE466B4556","بَانَ صَبْرِي لمّا تَأمّلَ طَرْفي:","بَانَ صَبري ببَينِ ظَبيٍ رَبِيبِ"]]},"2DC630F4-F88C-5880-9809-74DC6E2741D1":{"t":"وَلي في كُلّ يَوْمٍ مِنْكَ عَتْبٌ وَلي في كُلّ يَوْمٍ مِنْكَ عَتْبٌ","p":126,"s":"ولي في كل يوم منك عتب ولي في كل يوم منك عتب","r":"451580","v":[["66F243CD-2CED-5F6F-895B-A8EC64990DA8","وَلي في كُلّ يَوْمٍ مِنْكَ عَتْبٌ وَلي في كُلّ يَوْمٍ مِنْكَ عَتْبٌ","أقُومُ بِهِ مَقَامَ الاعْتِذَارِ"],["ADF2CA12-7F53-562E-83AE-058930FB1169","حمَلْتُ جَفَاكَ، لا جَلَداً، وَلكِنْ","صبرتُ على اختياركَ واضطراري"]]},"AD77D46D-3BAC-5F81-A051-996E68F3F42F":{"t":"وَلَقَدْ عَلِمْتُ وَمَا عَلِمْـ","p":126,"s":"ولقد علمت وما علمـ","r":"451538","v":[["DBC43AD2-96AE-5E8D-A469-AF863A336D95","وَلَقَدْ عَلِمْتُ، وَمَا عَلِمْـ","ـتُ، وَإنْ أقمتُ على صُدودِهْ"],["ABB54361-42E0-5AFA-BF7B-FD765944706A","أنّ الغَزَالَةَ وَالغَزَا","لَ، لَفِي ثَنَايَاهُ وَجِيدِهْ"]]},"C6DE2359-80A4-5C1A-ABF8-050709972094":{"t":"وَلَمَّا تَخَيَّرْتُ الأخِلاَّءَ لَمْ أجِدْ","p":126,"s":"ولما تخيرت الأخلاء لم أجد","r":"451530","v":[["16D43D1B-D6CF-55DA-8AFF-789427AE19F8","وَلَمَّا تَخَيَّرْتُ الأخِلاَّءَ لَمْ أجِدْ","صبوراً على حفظِ المودةِ والعهدِ"],["4EE7A4BA-54DB-50CD-97AB-F70F6C51D148","سَلِيماً عَلى طَيّ الزّمَانِ وَنَشْرِهِ","أميناً على النجوى صحيحاً على البعدْ"],["8F774E47-7F52-57E5-89E7-3F0D4E6D0D0A","وَلَمّا أسَاءَ الظّنَّ بي مَنْ جَعَلْتُهُ","و إيايَ مثلَ الكفِّ نيطتْ إلى الزندِ"],["76419CDF-5651-5A6F-B949-3EC06E3429FB","حَمَلْتُ عَلى ضَنّي بِهِ سُوءَ ظَنّه","و أيقنتُ أني بالوفا أمةٌ وحدي"],["C6AB4658-2045-5090-A46A-53FCDDA525D2","و أني على الحالينِ في العتبِ والرضى","مقيمٌ على ما كان يعرفُ من ودي"]]},"BD2858F0-8271-54D8-9EB1-5E535CDECA13":{"t":"وَلَمّا أنْ جَعَلْتُ اللّـ","p":126,"s":"ولما أن جعلت اللـ","r":"451484","v":[["FF5306F1-7AD5-5818-840C-B4EE20037924","وَلَمّا أنْ جَعَلْتُ اللّـ","ـهَ لي ستراً منَ النوبِ"],["51702A49-AA09-57D7-91AF-E3C4522C9116","رَمَتْني كُلُّ حَادِثَةٍ","فأخطتني ولمْ تصبِ"]]},"B56AD372-96C7-5B19-97F1-FD2FAF5021A6":{"t":"وَمَا ليَ لا أُثْني عَلَيْكَ وَطَالَمَا","p":126,"s":"وما لي لا أثني عليك وطالما","r":"451632","v":[["E0BDC89A-358F-54DB-AAA1-27000C8F5437","وَمَا ليَ لا أُثْني عَلَيْكَ، وَطَالَمَا","وفيتَ بعهدي، والوفاءُ قليلُ؟"],["5C6071F9-C36A-5D92-81AF-93EB7842FAEA","و أوعدتني حتى إذا ما ملكتني","صَفَحْتَ، وَصَفْحُ المَالكِينَ جَميلُ!"]]},"D19D6446-D1C6-5FAF-8B20-32EC4993188D":{"t":"وَمَا نِعمَةٌ مَشكورَةٌ قَد صَنَعْتُها","p":126,"s":"وما نعمة مشكورة قد صنعتها","r":"451547","v":[["CFF00065-D27D-55C8-93EE-2372B8E65820","وَمَا نِعمَةٌ مَشكورَةٌ، قَد صَنَعْتُها","إلى غَيرِ ذي شُكْرٍ، بمَانِعَتي أُخرَى"],["AA3F718E-BC7E-5E0D-86F4-2F7F417F2642","سآتي جميلاً، ما حييت، فإنني","إذا لمْ أُفِدْ شكراً، أفَدْتُ بهِ أجْرَا"]]},"E4F9EDCB-715B-5C35-B858-30FAA456FD8A":{"t":"وَمُعَوَّدٍ للكَرّ في حَمَسِ الوَغَى","p":126,"s":"ومعود للكر في حمس الوغى","r":"451497","v":[["ECA33837-F41F-5888-B4F5-C925D1951980","وَمُعَوَّدٍ للكَرّ في حَمَسِ الوَغَى،","غادرتهُ؛ والفرُّ منْ عاداتهِ"],["A202B76A-3D14-55BE-8424-45EBE0CD689B","حَمَلَ القَنَاةَ عَلى أغَرَّ سَمَيْذَعٍ،","دَخّالِ مَا بَينَ الفَتى وَقَنَاتِهِ"],["7E169FB0-8E5A-54C2-AC34-B811EBB0506C","لا أطْلُبُ الرّزْقَ الذّلِيلَ مَنَالُهُ","فَوْتُ الهَوَانِ أذَلّ مِنْ مَقْنَاتِهِ"],["D488DD70-DE11-58E6-9515-BA33BCD58414","علقتْ بناتُ الدهرِ، تطرقُ ساحتي","لما فضلتُ بنيهِ في حالاتهِ"],["083031B8-16D4-5D6C-A73D-5FA8802EF9A1","فالحربُ ترميني ببيضِ رجالها","وَالدّهْرُ يَطرُقُني بِسُودِ بَنَاتِهِ"]]},"4F0D65B6-9A24-59E3-822D-B806A0E99255":{"t":"وَمُغْضٍ للمَهَابَةِ عَنْ جَوَابي!","p":126,"s":"ومغض للمهابة عن جوابي!","r":"451631","v":[["B79B3DE4-E6C1-5FEC-A8B8-0226DA49C44F","وَمُغْضٍ، للمَهَابَةِ، عَنْ جَوَابي!","وَإنّ لِسَانَهُ العَضْبُ الصّقِيلُ"],["AB8E3FC3-507A-59E0-BB8F-4EDB8E39BED0","أطلتُ عتابهُ، عنتاً وظلماً،","فجمجمَ، ثمَّ قالَ: \" كما تقول! \""]]},"5964B471-7FF2-5BB2-AE0F-D9CD25A365B2":{"t":"وَوَارِدٍ مُورِدٍ أُنْساً يُؤكّدُهُ","p":126,"s":"ووارد مورد أنسا يؤكده","r":"451574","v":[["AC6D7D28-07EB-55F5-B269-4C5DBCF3C56A","وَوَارِدٍ مُورِدٍ أُنْساً، يُؤكّدُهُ","صُدُوره عَنْ سَلِيمِ الوِرْدِ وَالصَّدَرِ"],["5C096919-445B-5578-BE08-2D73C9D32E78","شدتْ سحائبهُ منهُ على نزهٍ","تقسّمَ الحُسنُ بَينَ السّمعِ وَالَبَصَرِ"],["C31B5B1F-4FA3-5F41-9CBE-33A79DBDFF4E","عذوبةٌ، صدرتْ عنْ منطقٍ جددٍ؛","كالماءِ يخرجُ ينبوعاً منَ الحجرِ"],["54FACD90-9B6A-578E-898D-A6DACD106B2E","وروضةٌ منَ رياضِ الفكرِ، دبَّجها","صوبُ القرائحِ لا صوبٌ من المطرِ"],["386C8061-B715-5670-9E29-BD4D85EC89D7","كَأنّمَا نَشَرَتْ أيْدِي الرّبِيعِ بهَا","برداً من الوشيِ أو ثوباً من الحبرِ"]]},"CEC8CF12-53ED-5196-A211-8E17B52F947E":{"t":"وَيَدٍ يَرَاهَا الدّهْرُ غَيْرَ ذَمِيمَةٍ","p":126,"s":"ويد يراها الدهر غير ذميمة","r":"451552","v":[["608CE841-7330-5F78-9503-2FCE59353C49","وَيَدٍ يَرَاهَا الدّهْرُ غَيْرَ ذَمِيمَةٍ،","تمحو إساءتهُ إليَّ وتغفرُ"],["609A405B-FB4B-52AC-9710-4B516453C0EC","أهدتْ إليَّ مودةً منْ صاحبٍ","تزكو المودةُ في ثراهُ، وتثمرُ"],["8BA74F1C-8CB5-585A-8F91-30B7D30BD800","علقتْ يدي منهُ بعلقِ مضنةٍ","مِمّا يُصَانُ عَلى الزّمَانِ وَيُدْخَرُ"],["CDDAEAE8-8516-596E-98A4-5F78F76DA331","إني عليكَ \" أبا حصينٍ \"، عاتبٌ","و الحرُّ يحتملُ الصديقَ، ويصبرُ"],["6F943ED7-BF8A-559D-B536-7079658F1CC2","وَإذا وَجَدْتُ عَلى الصّدِيقِ شكَوْتُهُ","سِرَّاً إلَيْهِ وَفي المَحَافِلِ أشْكُرُ"],["34AAFF03-5037-5460-9C74-BC22FAF2CAF2","مَا بَالُ شِعْرِي لا تَرُدّ جَوَابَهُ؟","سَحْبَانُ عِنْدَكَ بَاقِلٌ، لا أعذُرُ"]]},"5B36725B-1275-5FA8-9DB4-4862BD51B1B6":{"t":"وَيَغْتَابُني مَنْ لَوْ كَفَاني غَيْبَهُ","p":126,"s":"ويغتابني من لو كفاني غيبه","r":"451689","v":[["E414B82A-07B7-59C4-92DE-F4881AEF499C","وَيَغْتَابُني مَنْ لَوْ كَفَاني غَيْبَهُ","لكنتُ لهُ العينَ البصيرةَ والأذنا"],["795D82A8-CAF4-5851-81A8-46FCA59B2266","و عندي منَ الأخبارِ ما لوْ ذكرتهُ","إذاً قرعَ المغتابُ منْ ندمٍ سنا"]]},"4D3F80B3-62A0-57A1-B6AB-91F22FE320BF":{"t":"يا أخي قدْ وهبتُ ذنبَ زمانٍ","p":126,"s":"يا أخي قد وهبت ذنب زمان","r":"451611","v":[["EF5C9E0A-82F9-50AD-9860-2BB086660990","يا أخي قدْ وهبتُ ذنبَ زمانٍ","طَرَقَتْني صُرُوفُهُ بِالمَهَالِكْ"],["1B64435D-C47E-53A1-9C2F-8EAEF2AECF69","لمْ يهبْ لي صبابةً منْ رقادٍ","لمْ يَجُدْ لي فيهَا بِطَيْفِ خَيَالِكْ"],["CEA46051-8272-5528-97F0-F100D5B8E02D","قَدْ قَنِعْنَا بِذَلِكَ النّزْرِ مِنْهُ،","وَغَفَرْنَا لَهُ الذّنُوبَ لِذَلِكْ"]]},"D931864D-E8BE-5FD1-9452-6A56F1A30491":{"t":"يا ضَارِبَ الجَيشِ بي في وَسْطِ مَفرِقهِ","p":126,"s":"يا ضارب الجيش بي في وسط مفرقه","r":"451496","v":[["A3265E71-21A9-51EC-BB84-D72C6654CDE0","يا ضَارِبَ الجَيشِ بي في وَسْطِ مَفرِقهِ","لقدْ ضربتَ بنفسِ الصارمِ الغضبِ"],["F0AF45F1-A96D-555E-9EDF-33FDCB1D1279","لا تَحرُزُ الدّرْعُ عَني نَفسَ صَاحبِها","وَلا أُجِيرُ ذِمَامَ البِيضِ وَاليَلَبِ"],["90308AC6-8FF2-5483-B32F-13761372ECA5","و لا أعودُ برمحي غيرَ منحطمٍ","و لا أروحُ بسيفي غيرَ مختضبِ"],["5847CEAC-BE29-5D66-80FC-CFED4A53AD7E","حَتى تَقُولَ لَكَ الأعْداءُ رَاغِمَةً","\" أضحى ابنُ عمكَ هذا فارسَ العربِ \""],["4D83B151-955F-5460-B8ED-68A468B881FD","هيهاتَ لا أجحدُ النعماءَ منعمها","خلفتَ \" يابنَ أبي الهيجاءِ \" فيَّ أبي؟"],["D6A869EE-EF71-54F6-81A2-1BA29DE22445","يَا مَنْ يُحاذِرُ أنْ تَمضِي عَليّ يَدٌ","مَا لي أرَاكَ لبِيضِ الهِندِ تسمحُ بي؟"],["517767C0-6BEF-5D88-ABD8-D3F675E26CD1","و أنتَ بي منْ أضنِّ الناسِ كلهمِ","فكيفَ تبذلني للسمرِ والقضبِ؟"],["048BB273-D7E4-56F2-9514-013FC572DDDF","ما زلتُ أَجهلُهُ فضلاً وأُنكره","نعمى، وأوسعُ منْ عجبٍ ومنْ عجبِ"],["2A1ECB21-ABEC-5D1B-8347-CEA19ED82528","حتى رأيتكَ بينَ الناسِ مجتنباً","تُثْني عَليّ بِوَجْهٍ غَيرِ مُتّئِبِ"],["9FB46DF3-1688-5C24-AA1C-3E62CF0F3B73","فعندها، وعيونُ الناسِ ترمقني","عَلِمْتُ أنّكَ لم تُخطىء ولَم أصِبِ"]]},"0D67B394-D72A-5BE7-B18D-BDB2BBEDD5DC":{"t":"يا طولَ شَوْقيَ إن قالوا: الرّحِيلُ غدا","p":126,"s":"يا طول شوقي إن قالوا: الرحيل غدا","r":"451515","v":[["20BEF03D-B86B-5D48-82F7-D63717B97485","يا طولَ شَوْقيَ إن قالوا: الرّحِيلُ غدا،","لا فَرّقَ اللَّهُ فِيمَا بَيْنَنَا أبَدَا"],["0DDFD441-4906-5736-A3C4-BF1F1FEDD2BE","يا منْ أصافيهِ في قربٍ وفي بعدِ","وَمَنْ أُخَالِصُهُ إنْ غَابَ أوْ شَهِدَا"],["977E676A-7EEF-5ACB-A186-2B357F53C316","راعَ الفراقُ فؤاداً كنتَ تؤنسهُ","وَذَرّ بَينَ الجُفُونِ الدّمعَ والسُّهُدا"],["1C853760-E298-5F50-A065-7DED6884BE10","لا يُبْعِدِ اللَّهُ شَخْصاً لا أرَى أنَساً","وَلا تَطِيبُ ليَ الدّنْيَا إذا بَعُدا"],["82F9802A-6AEC-538C-B5B2-AB801884B5B9","أضحى وأضحيتُ في سرٍ وفي علنٍ","أعدهُ والداً إذْ عدني ولدا"],["E50CA898-EEFF-59EA-96EE-39CE4602AEBB","ما زالَ ينظمُ فيَّ الشعرَ مجتهداً","فضلاً وأنظمُ فيهِ الشعرَ مجتهدا"],["68A2E292-322B-549C-BFC3-D7649BC3AF3B","حَتى اعْتَرَفْتُ وَعَزّتْني فَضَائِلُهُ،","و فاتَ سبقاً وحازَ الفضلَ منفردا"],["C990F6C4-98C0-5616-8F4E-848CC173D3F2","إنْ قَصّرَ الجُهْدَ عَنْ إدْرَاكِ غايَته","فأعذرُ الناسِ منْ أعطاكَ ما وجدا"],["D2CD4F68-866D-53BF-9CCB-7091AA4C9AD1","أبقى لنا اللهُ مولانا؛ ولا برحتْ","أيّامُنَا، أبَداً، في ظِلّهِ جُدُدَا"],["8A13CD69-83E9-507A-9B38-4518EF4D6FF6","لا يطرقِ النازلُ المحذورُ ساحتهُ","وَلا تَمُدّ إلَيْهِ الحَادِثَاتُ يَدَا"],["681A6D35-A1C7-5962-8E01-B832EC0BE8AD","الحَمْدُ للَّهِ حَمْداً دَائِماً أبَدا","أعطانيَ الدهرُ ما لمْ يعطهِ أحدا"]]},"E23E2B3E-8D60-5395-AA07-2157226A9CD0":{"t":"يا طِيبَ لَيْلَةِ مِيلادٍ لَهَوْتُ بِهَا","p":126,"s":"يا طيب ليلة ميلاد لهوت بها","r":"451579","v":[["564C046D-1CF3-5452-BD04-F56E4F1BDE0F","يا طِيبَ لَيْلَةِ مِيلادٍ، لَهَوْتُ بِهَا","بأحورٍ، ساحرِ العينينِ، ممكورِ"],["C00AF072-D2B3-561A-A8E3-5AA75B5CF71B","وَالجَوُّ يَنْشُرُ دُرَّاً، غَيرَ مُنْتَظِمٍ،","والأرْضُ بَارِزَةٌ في ثَوْبِ كَافُورِ"],["560639F7-F231-59B2-8A35-A9710CF51063","وَالنّرْجسُ الغضّ يحكي حسنُ منظرِهِ","صَفْرَاءَ صَافِيَةً في كَأسِ بَلّورِ"]]},"3ECABCC4-32CD-58F7-97A6-268EBA001D09":{"t":"يا غُلاَمي بَلْ سَيّدي لَنْ أمَلّكْ","p":126,"s":"يا غلامي بل سيدي لن أملك","r":"451612","v":[["97FE055C-AE06-5029-B6A6-2360BBA0B633","يا غُلاَمي، بَلْ سَيّدي، لَنْ أمَلّكْ،","هَبْ لمَولاكَ، لا عَدمتُكَ، عَدلَكْ"],["F9D1C5FB-F8CD-5958-8FA7-A001D6D839E4","خوفَ أنْ يصطفيكَ غيري بعدي","لا أرى أنْ أقولَ قدمتُ قبلكْ"]]},"A133F5AC-31AF-5692-9245-532A214FE28F":{"t":"يا ليلةً لستُ أنسى طيبها أبداً","p":126,"s":"يا ليلة لست أنسى طيبها أبدا","r":"451711","v":[["BAEEA432-943A-5E5D-A2B0-F511B326A5D7","يا ليلةً، لستُ أنسى طيبها أبداً،","كَأنّ كُلّ سُرُورٍ حَاضِرٌ فِيهَا"],["A6C3F9A3-256B-5DB1-8B88-31C464F91432","بَاتَتْ، وَبِتُّ، وَبَاتَ الزّقُّ ثَالِثَنَا","حَتى الصّبَاحِ تُسَقِّيني وَأسْقِيهَا"],["DC0D03D6-68E4-5CC8-BD25-C0051276C887","كَأنّ سُودَ عَنَاقِيدٍ بِلِمّتِهَا،","أهدتْ سلافتها صرفاً، إلى فيها"]]},"70C04150-E62A-5741-B7E8-213933427B43":{"t":"يا معجباً بنجومهِ","p":126,"s":"يا معجبا بنجومه","r":"451518","v":[["10CDFE78-3470-5997-852C-B6575A435FAA","يا معجباً بنجومهِ","لا النحسُ منكَ ولاَ السعاده"],["EC721478-CD97-5A51-A49A-D587167AC222","اللَّهُ يُنْقِصُ مَا يَشَا","ءُ وَفي يَدِ اللَّهِ الزّيَادَة"],["1C9551FD-A485-566C-9699-FD52C79AE15E","دَعْ مَا أُرِيدُ وَمَا تُرِيـ","ـدُ، فَإنّ للَّهِ الإِرَادَة"]]},"3C75BFC5-DDBD-508B-B6A6-85A7E5555BA9":{"t":"يا منْ أتانا بظهرِ الغيبِ قولهمٌ","p":126,"s":"يا من أتانا بظهر الغيب قولهم","r":"451626","v":[["9145FB71-0457-51FF-A910-D7D6528F7718","يا منْ أتانا بظهرِ الغيبِ، قولهمٌ","لوْ شئتُ، غاظتكمُ منا الأقاويلُ"],["6ADB080D-803A-5236-8227-24CF82C6A54E","لكنْ أرى أنَّ في الأقوالِ منقصةً","مَا لَمْ تَسُدَّ الأقَاوِيلَ الأفَاعِيلُ"]]},"35F4AEF5-10C9-596E-8AC2-4F2ACCA6B46D":{"t":"يا مَنْ رَجَعتُ على كُرْهٍ لطاعَتِهِ","p":126,"s":"يا من رجعت على كره لطاعته","r":"451695","v":[["150C3E91-DC47-5758-A399-E4692E9DF83B","يا مَنْ رَجَعتُ، على كُرْهٍ، لطاعَتِهِ،","قدْ خالفَ القلبُ لمَّـا طاوعَ البدنُ"],["44460E89-B7D8-52D1-BD8B-52AEDA7587C6","وَكُلّ ما شِئْتَ من أمْرٍ رَضِيتُ بِهِ،","وَكلّ ما اختَرْتَهُ، عِندي هوَ الحسنُ"],["21998AAE-38B0-5452-97E1-4BA63BCB3BC8","وَكُلّمَا سَرّني أوْ سَاءَني سَبَبٌ","فأنتَ فِيهِ عَليّ، الدّهرَ، مُؤتَمَنُ"]]},"7D6A667F-6929-5E34-A93F-ADCDEBE52311":{"t":"ياليلُ ما أغفلَ عما بي","p":126,"s":"ياليل ما أغفل عما بي","r":"451493","v":[["E8E43C12-A123-57C7-9393-3EB2442AD95A","ياليلُ؛ ما أغفلَ، عما بي،","حبائبي فيكًَ وأحبابي"],["1CC80954-72A3-5618-B041-A340FB504C17","يا ليلُ، نامَ الناسُ عنْ موضعٍ","ناءٍ، عَلى مَضْجَعِهِ نَابي"],["67ECAF14-79D6-56EB-A030-98C1F3267A1C","هبتْ لهُ ريحٌ شاميةٌ","مَتّتْ إلى القَلْبِ بِأسْبَابِ"],["2D000647-5B13-5A0C-8A99-BB2C87A893CD","أدتْ رسالاتِ حبيبٍ لنا","فَهِمْتُهَا مِنْ بَيْنَ أصْحَابي"]]},"84024338-9B13-5F29-9CBF-512B9DC72BEB":{"t":"يعزُّ على الأحبةِ بـ \" الشامِ \"","p":126,"s":"يعز على الأحبة بـ \" الشام \"","r":"451679","v":[["6C0D5E5B-F99E-5EC7-9DCE-7AC24C843EE0","يعزُّ على الأحبةِ، بـ \" الشامِ \"،","حَبيبٌ، بَاتَ مَمْنُوعَ المَنَامِ"],["26315FE6-B331-5708-A0A5-CFC7085195D3","وَإني لَلصّبُورُ عَلى الرّزَايَا،","وَلَكِنّ الكِلامَ عَلى الكِلامِ"],["5691BA8C-0829-5F6C-889D-61598B1BB5CD","جُرُوحٌ لا يَزَلْنَ يَرِدْنَ مِنّي","على جرحٍ قريبِ العهدِ، دامِ"],["25A8128D-B13F-55B0-81F2-682F34A68F35","تاملني \" الدمستقُ \" إذ رآني،","فَأبْصَرَ صِيغَةَ اللّيْثِ، الهُمَامِ"],["5987CC7D-C29D-5B04-8DB0-41FB552BD2AD","أتُنكِرُني كَأنّكَ لَسْتَ تَدْري","بِأني ذَلِكَ البَطَلُ، المُحَامي"],["118614CB-35E3-5608-BDF8-51FB7EDA6943","وَأني إذْ نَزَلْتُ عَلى دُلُوكٍ،","تَرَكْتُكَ غَيْرَ مُتّصِلِ النّظَامِ"],["B403A2C0-3F8A-52CE-B1EC-51494E2F7CC3","وَلَمّا أنْ عَدَدْتُ صَلِيبَ رَأيِي","تَحَلّلَ عِقْدُ رَأيِكَ في المَقَامِ"],["A477CDF4-46E2-504B-8F5C-EE87177136EF","وَكُنْتَ تَرَى الأنَاةَ، وَتَدّعِيها،","فأعجلكَ الطعانُ عنِ الكلامِ"],["5DA9D364-4E2B-5EF6-B0CD-2423931023A1","و بتَّ مؤرقاً، منْ غيرِ سهدٍ،","حمى جفنيكَ طيبَ النومِ حامِ"],["A92A5B1A-4C07-5283-B3C1-B1E5A7BFCD24","و لا أرضى الفتى ما لمْ يكملْ،","برأيِ الكهلِ، إقدامَ الغلامِ"],["2618A189-FC17-5EE5-BB8E-F531557228D2","فَلا هُنّئْتَهَا نُعْمَى بِأسْرِي،","وَلا وُصِلَتْ سُعُودُكَ بِالتّمَامِ"],["F37A4FED-28AD-5873-8F7A-7176DF263E86","أمَا مِنْ أعْجَبِ الأشْيَاءِ عِلْجٌ،","يُعَرّفُني الحَلالَ مِنَ الحَرَامِ"],["669A5A47-BB74-5666-A022-38EB8F0BA530","و تكنفهُ بطارقةٌ تيوسُ،","تباري بالعثانينِ الضخامِ"],["9A0EEECC-1DEC-5846-86F2-F61C0589D0A5","لهمْ خلقُ الحميرِ فلستَ تلقى","فتىً منهمْ يسيرُ بلاَ حزامِ"],["7F29846D-6F1B-5556-A708-F48B542E5730","يُرِيغُونَ العُيُوبَ، وَأعجَزَتْهُمْ،","وأيُّ العيبِ يوجدُ في الحسامِ!؟"],["7872ABD0-7186-593B-9FCF-D19FDC8D455E","و أصعبُ خطةٍ، وأجلُّ أمرٍ","مُجَالَسَةُ اللّئَامِ عَلى الكِرَامِ"],["A0237F08-E3E2-5438-AC19-9B624EFC669B","أبِيتُ مُبَرّأ من كُلّ عَيبٍ،","و أصبحُ، سالماً منْ كلِّ ذامِ"],["C7321A9A-E2B1-54CA-B290-E92A110BC9C0","وَمَنْ لَقيَ الّذي لاقَيْتُ هَانَتْ","عَلَيْهِ مَوَارِدُ المَوْتِ الزّؤامِ"],["F9995479-B090-5189-80A6-7BE17D42C085","ثناءٌ طيبٌ، لا خلفَ فيهِ،","وَآثَارٌ كَآثَارِ الغَمَامِ"],["88D78756-5A4D-577A-8107-5753E2F00ACD","و علمُ فوارسِ الحيينِ أني","قَلِيلٌ مَنْ يَقُومُ لَهُمْ مَقَامي"],["EF386E7E-E9BA-5B75-9D0B-46EFA48E790A","وَفي طَلَبِ الثّنَاءِ مَضَى بُجَيْرٌ","وَجَادَ بِنَفْسِهِ كَعبُ بنُ مَامِ"],["A2F04C6E-0B55-5726-894E-3D1B7C0DD1B1","أُلامُ عَلى التّعَرّضِ للمَنَايَا،","وَلي سَمَعٌ أصَمُّ عَنِ المَلامِ"],["6AA634E2-5A87-539F-BFC9-81C48A95DEF7","بنو الدنيا إذا ماتوا سواءٌ","وَلَوْ عَمَرَ المُعَمّرُ ألْفَ عَامِ"],["D67DD5B6-A207-530E-B05B-8C0359663737","إذَا مَا لاَحَ لي لَمَعَانُ بَرْقٍ","بَعَثْتُ إلى الأحِبّةِ بِالسّلامِ"]]},"FD963F28-05D6-5B4D-9C67-97E835FC9DDA":{"t":"يعيبُ عليَّ أنْ سميتُ نفسي","p":126,"s":"يعيب علي أن سميت نفسي","r":"451691","v":[["47D887A3-5ED3-572D-88BA-2632E208EFA0","يعيبُ عليَّ أنْ سميتُ نفسي","وَقَدْ أخَذَ القَنَا مِنْهُمْ وَمِنّا"],["9540D3E4-CC1F-586F-97F5-A02E2E9DF022","فَقُلْ لِلعِلْجِ: لَوْ لمْ أُسْمِ نَفْسِي","لَسَمّاني السّنَانُ لَهُمْ وَكَنّى"]]},"34DFC6BD-463C-5CA5-8491-67159B852043":{"t":"يقولونَ لا تخرقْ بحلمكَ هيبةً","p":126,"s":"يقولون لا تخرق بحلمك هيبة","r":"451668","v":[["456484F5-FDA5-5FDA-B06D-A431EC3A7017","يقولونَ لا تخرقْ بحلمكَ هيبةً","وأحسنُ شيءٍ زينَ الهيبةَ الحلمُ"],["99B24E28-E775-5483-8733-3306E1A5D23A","فلا تتركنَّ العفوَ عنْ كلِّ زلةٍ","فما العَفُو مَذمُومٌ، وَإن عظُمَ الجُرْمُ"]]},"3E599C89-6506-598F-B52F-38F5019BA990":{"t":"يَا جَاحِداً فَرْطَ غَرَامي بِهِ","p":126,"s":"يا جاحدا فرط غرامي به","r":"451532","v":[["0CC66BF5-672A-52D3-945C-C5A5FCA8EDA0","يَا جَاحِداً فَرْطَ غَرَامي بِهِ،","وَلَسْتُ بِالنّاسِي وَلا الجَاحِدِ"],["039129E2-AADF-53EC-9F43-76F44022A97C","أقْرَرْتُ في الحُبّ بِمَا تَدّعِي،","فَلَسْتُ مُحْتَاجاً إلى شَاهِدِ"]]},"8B7647B8-27C7-56D2-88C6-797F3C92CEAA":{"t":"يَا حَسْرَةً مَا أكَادُ أحْمِلُهَا","p":126,"s":"يا حسرة ما أكاد أحملها","r":"451642","v":[["B5E3BD2A-4D00-5795-AD90-33CE908134C9","يا حَسرَةً ما أَكادُ أَحمِلُها","آخِرُها مُزعِجٌ وَأَوَّلُها"],["9DC8CFBC-12AB-54B4-8B95-EA1BDE08F7C3","عَليلَةٌ بِالشَآمِ مُفرَدَةٌ","باتَ بِأَيدي العِدى مُعَلِّلُها"],["2945EB04-8588-5DFB-BC4B-1226AE46C6B4","تُمسِكُ أَحشاءَها عَلى حُرَقٍ","تُطفِئُها وَالهُمومُ تُشعِلُها"],["096B103C-25F3-52BB-81A0-C8C750440952","إِذا اِطمَأَنَّت وَأَينَ أَو هَدَأَت","عَنَّت لَها ذُكرَةٌ تُقَلقِلُها"],["B781CCE4-8359-5F21-88D4-7CB0945CF585","تَسأَلُ عَنّا الرُكبانَ جاهِدَةً","بِأَدمُعٍ ماتَكادُ تُمهِلُها"],["172DCFEB-7B72-578A-88DC-986D081696A4","يامَن رَأى لي بِحِصنِ خِرشَنَةٍ","أُسدَ شَرىً في القُيودِ أَرجُلُها"],["431527FA-09E9-5C1A-A0A8-E8F3AB348086","يامَن رَأى لي الدُروبَ شامِخَةً","دونَ لِقاءِ الحَبيبِ أَطوَلُها"],["0289CCD9-3DFE-565B-BF7E-B4F6403DAA64","يامَن رَأى لي القُيودَ موثَقَةٌ","عَلى حَبيبِ الفُؤادِ أَثقَلُها"],["696AE2B5-A8F1-5FA3-9404-5AF15EB9328C","يا أَيُّها الراكِبانِ هَل لَكُما","في حَملِ نَجوى يَخِفُّ مَحمَلُها"],["D861E8D5-297C-5667-9632-BABB49B2E423","قولا لَها إِن وَعَت مَقالَكُما","وَإِنَّ ذِكري لَها لَيُذهِلُها"],["3990C3C3-1795-5421-AD74-3B9FA37E0CEE","يا أُمَّتا هَذِهِ مَنازِلُنا","نَترِكُها تارَةً وَنَنزِلُها"],["49EC023D-E934-5149-84A7-BB70F1D80A11","يا أُمَّتا هَذِهِ مَوارِدُنا","نَعُلُّها تارَةً وَنُنهَلُها"],["4F67CD78-834E-5262-BD3F-8615D3B195FE","أَسلَمَنا قَومُنا إِلى نُوَبٍ","أَيسَرُها في القُلوبِ أَقتَلُها"],["57F49045-3CF8-56D5-9E8D-37F85BA9EF66","وَاِستَبدَلوا بَعدَنا رِجالَ وَغىً","يَوَدُّ أَدنى عُلايَ أَمثَلُها"],["F312F985-9DCB-531A-90EF-6C06005A9486","لَيسَت تَنالُ القُيودُ مِن قَدَمي","وَفي اِتِّباعي رِضاكَ أَحمِلُها"],["5AC17BED-E0CF-5936-A5C8-CCA18BB3EB3A","ياسَيِّداً ماتُعَدُّ مَكرُمَةٌ","إِلّا وَفي راحَتَيهِ أَكمَلُها"],["36411F40-58B8-5B04-AD0D-3B3263C27774","لاتَتَيَمَّم وَالماءُ تُدرِكُهُ","غَيرُكَ يَرضى الصُغرى وَيَقبَلُها"],["824BAE0D-845F-5721-871E-4FDF37D3A517","إِنَّ بَني العَمِّ لَستَ تَخلُفُهُم","إِن عادَتِ الأُسدُ عادَ أَشبُلُها"],["217F4274-BB0E-5843-9FC6-91B776359CA7","أَنتَ سَماءٌ وَنَحنُ أَنجُمُها","أَنتَ بِلادٌ وَنَحنُ أَجبُلُها"],["302AFDBE-40B8-50E8-BE7E-503190B3F20A","أَنتَ سَحابٌ وَنَحنُ وابِلُهُ","أَنتَ يَمينٌ وَنَحنُ أَنمُلُها"],["0DD2528C-DDE4-5601-8789-484B0484DA8A","بِأَيِّ عُذرٍ رَدَدتَ والِهَةً","عَلَيكَ دونَ الوَرى مُعَوَّلُها"],["E309EE7A-19F0-51EF-9AEB-027FE41122A6","جاءَتكَ تَمتاحُ رَدَّ واحِدِها","يَنتَظِرُ الناسُ كَيفَ تُقفِلُها"],["B8CC1EFF-3DC8-5882-B2BE-4583D450DF6E","سَمَحتَ مِنّي بِمُهجَةٍ كَرُمَت","أَنتَ عَلى يَأسِها مُؤَمَّلُها"],["93A38AE4-08B3-5780-B457-A3D1B890680F","إِن كُنتَ لَم تَبذِلِ الفِداءَ لَها","فَلَم أَزَل في رِضاكَ أَبذِلُها"],["7A48361F-8ECA-56F4-85D9-5190352DFA88","تِلكَ المَوَدّاتُ كَيفَ تُهمِلُها","تِلكَ المَواعيدُ كَيفَ تُغفِلُها"],["CC99B59F-22AE-5A60-A5CE-AD4F38F7044F","تِلكَ العُقودُ الَّتي عَقَدتَ لَنا","كَيفَ وَقَد أُحكِمَت تُحَلِّلُها"],["F81BCDD9-6D69-56DA-AB14-E6E316661657","أَرحامُنا مِنكَ لِم تُقَطِّعُها","وَلَم تَزَل دائِباً تُوَصِّلُها"],["830FDFC6-C48D-5447-985A-4C6ED627C703","أَينَ المَعالي الَّتي عُرِفتَ بِها","تَقولُها دائِماً وَتَفعَلُها"],["EADAF3BD-DE40-5168-9C82-BFFEC5370111","ياواسِعَ الدارِ كَيفَ توسِعُها","وَنَحنُ في صَخرَةٍ نُزَلزِلُها"],["7E57BE59-CC4F-5907-A245-331E930E7478","ياناعِمَ الثَوبِ كَيفَ تُبدِلُهُ","ثِيابُنا الصوفُ مانُبَدِّلُها"],["5105BD2E-52F5-55D5-96E5-F3870B579C4F","ياراكِبَ الخَيلِ لَو بَصُرتَ بِنا","نَحمِلُ أَقيادُنا وَنَنقُلُها"],["B27545FB-627B-5A74-8D64-181AA2EDD39F","رَأَيتَ في الضُرِّ أَوجُهاً كَرُمَت","فارَقَ فيكَ الجَمالَ أَجمَلُها"],["2A37E6DF-2204-5910-BD68-84F0941B3595","قَد أَثَّرَ الدَهرُ في مَحاسِنِها","تَعرِفُها تارَةً وَتَجهَلُها"],["F0C21694-FEAD-5E62-9A06-F443A35C0EF9","فَلا تَكِلنا فيها إِلى أَحَدٍ","مُعِلُّها مُحسِناً يُعَلِّلُها"],["BD2C6C2E-28FD-5E46-9331-5BCAAD27ED5B","لايَفتَحُ الناسُ بابَ مَكرُمَةٍ","صاحِبُها المُستَغاثُ يُقفِلُها"],["AAF785DB-004D-5BEE-9B81-D64833613678","أَيَنبَري دونَكَ الكِرامُ لَها","وَأَنتَ قَمقامُها وَأَحمَلُها"],["D621A601-225C-538F-BA9B-F0BD575AF1B2","وَأَنتَ إِن عَنَّ حادِثٌ جَلَلٌ","قُلَّبُها المُرتَجى وَحُوَّلُها"],["571D4171-9B89-5BDD-85B9-F02C587D42BC","مِنكَ تَرَدّى بِالفَضلِ أَفضَلُها","مِنكَ أَفادَ النَوالَ أَنوَلُها"],["CD5CC10C-95E6-5F1A-A9EE-4536259A650F","فَإِن سَأَلنا سِواكَ عارِفَةً","فَبَعدَ قَطعِ الرَجاءِ نَسأَلُها"],["87650AD1-1366-5DC8-8B7D-12CF1E8B074C","إِذا رَأَينا أولى الكِرامِ بِها","يُضيعُها جاهِداً وَيُهمِلُها"],["FA636838-241F-50C7-934F-2703F42C748F","لَم يَبقَ في الناسِ أُمَّةٌ عُرِفَت","إِلّا وَفَضلُ الأَميرِ يَشمَلُها"],["FCEBE5FA-948F-5B0F-95C8-1674214236F4","نَحنُ أَحَقُّ الوَرى بِرَأفَتِهِ","فَأَينَ عَنّا وَأَينَ مَعدِلُها"],["AFE5884C-EE2A-513C-A79F-A05C3CEE1304","يامُنفِقَ المالِ لايُريدُ بِهِ","إِلّا المَعالي الَّتي يُؤَثِّلُها"],["E610084E-321E-5EFD-9323-F37DC954DA3D","أَصبَحتَ تَشري مَكارِماً فُضُلاً","فِداؤُنا قَد عَلِمَت أَفضَلُها"],["F4E84DCD-3F73-5391-B0DA-AE6B94DDF12E","لايَقبَلُ اللَهُ قَبلَ فَرضِكَ ذا","نافِلَةً عِندَهُ تُنَفِّلُها"]]},"E073B1A2-F0E8-53ED-B847-F2A9E4E5AFE4":{"t":"يَا سَيّديّ! أرَاكُمَا","p":126,"s":"يا سيدي! أراكما","r":"451664","v":[["52E6122A-3558-5CEF-947E-26E8D8883E8A","يَا سَيّديّ! أرَاكُمَا","لاَ تذكرانِ أخاكما!"],["A4CBE629-0A15-573C-9E9A-530FE30E8AF1","أوجدتما بدلاً بهِ،","يَبْني سَمَاءَ عُلاكُمَا؟"],["695C0783-C272-5237-AEB6-12B83BC46562","أوجدتما بدلاً بهِ،","يفري نحورَ عداكما!؟"],["96C7FCDE-EE7F-5A7E-AE70-116ED9144A2C","ما كانَ بالفعلِ الجميـ","ـلِ، بمثلهِ، أولاكما!"],["46F3D3FC-1A86-5F67-96AB-CD63748AB201","مَنْ ذَا يُعَابُ، بِمَا لَقِيـ","ـتُ منَ الورى، إلاَّ كما؟"],["9F1B8107-6447-5CB2-80FC-D5EEF806A339","لا تقعدا بي، بعدها،","وسلاَ \" الأميرَ \"، أباكما!"],["1B21F99A-90B0-5456-A263-060B34CF67E4","وخذا فدايَ، جعلتُ منْ","رَيْبِ الزّمَانِ فِدَاكُمَا!"]]},"F0198C9D-D371-5904-B563-6B0BA3C2ADC6":{"t":"يَا عيِدُ! مَا عُدْتَ بِمَحْبُوبِ","p":126,"s":"يا عيد! ما عدت بمحبوب","r":"451487","v":[["E455CB48-1778-524B-8890-441F9C43BEA1","يَا عيِدُ! مَا عُدْتَ بِمَحْبُوبِ","على معنى القلبِ، مكروبِ"],["7A1F4E21-D74F-5848-84CF-D7AC04BFBE1B","يَا عيِدُ! قَد عُدْتَ علَى ناظِرٍ،","عن كلٍ حسنٍ فيكَ، محجوبِ"],["817BFAC1-5EB0-58FB-805F-BCCE9A0C9CC0","يَا وَحْشَةَ الدّارِ التي رَبُّهَا","أصْبَحَ في أثْوَابِ مَرْبُوبِ"],["54F0981B-743A-54D3-A5F2-1E696C23B291","قَدْ طَلَعَ العِيدُ عَلى أهْلِهِ","بِوَجْهِ لا حُسْنٍ وَلا طِيبِ"],["D8B33901-ABFD-582C-A4DA-2FFF0FB912D3","ما لي وللدهرِ وأحداثهِ","لقدْ رماني بالأعاجيبِ"]]},"19ECEB67-6EFE-5DFB-934D-3BAB50930335":{"t":"يَا عَمّرَ الله سَيْفَ الدّينِ مُغْتَبِطاً","p":126,"s":"يا عمر الله سيف الدين مغتبطا","r":"451623","v":[["AC6E78A7-120B-576A-9285-E4A5949E2A00","يَا عَمّرَ الله سَيْفَ الدّينِ مُغْتَبِطاً،","فكلُّ حادثةٍ يرمى بها جللُ"],["C10CE2D3-492F-58FB-946B-04D7B391AABA","مَنْ كانَ مِن كلّ مَفقُودٍ لَنا بدلاً","فَلَيْسَ مِنْهُ عَلى حَالاتِهِ بَدَلُ"],["ABE2D637-9352-5B1E-B130-BB14637A787D","يبكي الرجالُ، و\"سيفُ الدينِ\" مبتسمٌ،","حتى عنْ ابنكَ تعطى الصبرَ، يا جبلُ"],["199AE495-91AD-5533-B3FD-21F30E1698BB","لمْ يَجهَلِ القَوْمُ منهُ فَضْلَ ما عرَفوا","لكِنْ عَرَفتَ من التّسليمِ ما جهِلُوا"],["39FE7AA1-8DEB-53B9-BB46-DDFE812E7339","هلْ تبلغُ القمرَ المدفونَ رائعةٌ","منَ المقالِ، عليها للأسى حلل؟"],["198A6755-CC97-5041-A3B1-772593B9F0FD","ما بَعدَ فَقدِكَ، في أهلٍ، وَلا وَلَدٍ،","و لا حياةٍ، ولا دنيا، لنا، أملُ"],["5FC33CC9-8780-5406-92E3-FD6BF235B085","يا منْ أتتهُ المنايا، غيرَ حافلةٍ!","أينَ العَبيدُ وَأينَ الخَيلُ وَالخَوَلُ؟"],["1760BB08-C906-535D-96F8-CC0F14E91C25","أينَ الليوثُ، التي حوليكَ، رابضةً؟","أينَ الصّنائعُ؟ أينَ الأهلُ؟ ما فَعَلوا؟"],["2B6003F3-6BB0-550A-8BF2-AE2D6A10114D","أينَ السّيُوفُ التي يَحمِيكَ أقْطَعُهَا؟","أينَ السّوَابقُ؟ أينَ البِيضُ وَالأسَلُ؟"],["2999D429-9B99-5A9B-AB9F-7E6D724EA31F","ياويحَ خالكَ ‍! بلْ يا ويحَ كلِّ فتىً ‍!","أكُلَّ هذا تخَطَّى، نحوَك، الأجلُ؟"]]},"23EBBA45-3B1C-5FB6-B57C-60EE6B21930A":{"t":"يَا قَرْحُ لمْ يَنْدَمِلِ الأوّلُ!","p":126,"s":"يا قرح لم يندمل الأول!","r":"451624","v":[["E17533B9-8CA0-547B-8258-907018C05F78","يَا قَرْحُ، لمْ يَنْدَمِلِ الأوّلُ!","فهلْ بقلبي لكما محملُ؟"],["47AD4361-95CB-5DD7-90C1-36D0D47E6A36","جُرْحانِ، في جَسْمٍ ضَعيفِ القوَى،","حَيْثُ أصَابَا فَهُوَ المَقْتَلُ!"],["B4DE4BD4-AFDD-5617-A77D-23AA1EE369AD","تقاسمُ الأيامُ أحبابنا،","وَقِسْمُهَا الأفْضَلُ وَالأجْمَلُ"],["962FB4A0-FBDE-5A50-930B-AFBDAC78FB0D","وَلَيْتَهَا، إذْ أخَذَتْ قِسْمَهَا،","عَنْ قِسْمِنَا تُغْمِضُ أوْ تَغفَلُ"],["C642F073-6C51-570F-8C5F-A79E63D1285A","وقيتَ في الآخرِ منْ صرفها الـ","ـجَائِرِ، مَا جَرّعَكَ الأوّلُ"],["DF2CAE5F-B36E-5C4E-AC7B-9113DB9D33D5","فَفِدْيَةُ المَأسُورِ مَقْبُولَةٌ،","وَفِدْيَةُ المَيّتِ لا تُقْبَلُ"],["B199F19C-3489-5B70-8291-AFBFC69E740C","لا تَعْدَمَنّ الصّبْرَ في حَالَةٍ،","فَإنّهُ لَلْخُلُقُ الأجْمَلُ"],["DF2F1640-B148-55B2-97E4-F21F0A608C49","وَعِشْتَ في عِزٍّ وَفي نِعْمَةٍ،","وجدكَ المقتبلُ المقبلُ"]]},"1F190BAF-8A9E-5EFA-90A8-C63F64963DE0":{"t":"يَا مَعْشَرَ النّاسِ! هَلْ لي","p":126,"s":"يا معشر الناس! هل لي","r":"451561","v":[["9DCF29BA-615D-5A85-9E55-A3B8BAC98EEC","يَا مَعْشَرَ النّاسِ! هَلْ لي","ممَّـا لقيتُ مجيرُ؟"],["267E82CB-A951-5E84-B194-F7AAEDF193B1","أصابَ غرَّةَ قلبي","هَذَا الغَزَالُ الغَرِيرُ"],["AC2B9FCA-2460-505B-9472-26F0075B92C2","فَعُمْرُ لَيْلي طَوِيلٌ،","وَعُمْرُ نَوْمِي قَصِيرُ"],["0CC1C4C7-AB19-51AE-B8B3-ECF08E152144","أسرتَ مني فؤادي،","يَفْدِيكَ ذَاكَ الأسِيرُ"]]},"FB4C97C0-9E6D-51F0-8AA9-F38BF9A04D12":{"t":"يَا مَنْ رَضِيتُ بِفَرْطِ ظُلمِهْ","p":126,"s":"يا من رضيت بفرط ظلمه","r":"451685","v":[["176BB818-BA4A-5D49-8EBF-E6FDFC0167B9","يَا مَنْ رَضِيتُ بِفَرْطِ ظُلمِهْ","ودخلتُ، طوعاً، تحتَ حكمهْ"],["5661F0A5-870C-5700-BF6B-215FBE604CB2","أللهُ يعلمُ ما لقيـ","ـتُ منَ الهوى، وكفى بعلمهْ!"],["0F955B7D-F5F2-56A3-82C9-21EDABDC6BF8","هَبْ لِلْمُقِر بِذَنْبِهِ!","وَاصْفَحْ لَهُ عن عُظمِ جُرْمِهْ"],["841625BE-C43B-5800-9B0D-D9C61BE164BB","إني أعيذكَ أنْ تبو","ءَ بقتلهَ، وبحملِ إثمهْ"]]},"D5B20EA1-6540-5BE1-8202-B20817C107AE":{"t":"يَلُوحُ بِسِيماهُ الفَتى من بَني أبي","p":126,"s":"يلوح بسيماه الفتى من بني أبي","r":"451654","v":[["64A5FD09-1AF9-58CD-9E62-F92F0F747998","يَلُوحُ بِسِيماهُ الفَتى من بَني أبي،","وَتَعْرِفُهُ مِنْ غَيْرِهِ بِالشّمَائِلِ"],["BBF293E6-C185-5578-85F0-341AED8A2335","مفدى، مردى؛ يكثرُ الناسُ حولهُ","طَوِيلُ نِجادِ السّيفِ، سَبطُ الأنامِل"]]},"C48A4A4A-54C7-59EF-B02D-F6B695E62E66":{"t":"يَهْني الأمِيرَ بِشَارَةٌ","p":126,"s":"يهني الأمير بشارة","r":"451661","v":[["E478993D-F10C-5246-8932-A34093FC461A","يَهْني الأمِيرَ بِشَارَةٌ،","قرَّتْ بها عينُ المكارمْ"],["CECB4100-0D09-55B8-94CF-A902712E90D6","أعْلَى الوَرَى شَرَفاً، وَمَنْ","قَدْ بَشّرُوهُ بِخَيْرِ قَادِمْ"],["B53006EF-6D94-5157-B107-828475D8377F","إنّي، وَإنْ كُنْتُ المُشَا","رِكَ في الأبُوّةِ، وَالمُسَاهِمْ"],["AD52784C-5A37-51FB-8D03-FE63C621D6FD","لأقُولُ قَوْلاً لا يُرَدّ،","ولا يرى لي فيهِ لاثمْ:"],["FD5F9FDA-936F-5392-865B-F20C123ED3C9","لأبي المَعَالي، في العُلا،","و \" أبي المكارمِ \" في المكارمْ"],["E53BBA5A-31C3-5B84-8B51-D72909BB092E","بيتٌ، رفيعٌ سمكهُ،","عَالي الذّرَى، ثَبْتُ الدّعَائِمْ"]]}}}