{"v":1,"poems":{"385BD819-33A3-5CA7-9768-558628ACCAAC":{"t":"ألثام شف","p":183,"s":"ألثام شف","r":"438932","v":[["76154955-3B0E-5550-9761-679F948B1274","أَلثـامٌ شَـفَّ عـن ورد نــد","أم غمـام ضحكـت عن بَـرَدِ"],["75E98631-9D6E-51A9-ABB4-2AE880095DE5","أم علـى الأزرار مـن حُلَّتهـا","بـدرُ تـمَّ في قضيـب أَملَـدِ"],["EE575E74-2E32-53C5-9282-877AB695BC46","بـأبـي ليـن لـه لـو أنـه","نـقلـت عطفتـه للـخلــد"],["19D7554C-2EEC-5776-A4A9-822A0077C7D7","لا وألحـاظ لـهـا سـاحـرة","نفثـت في القلـب لا في العقـد"],["3BC7E260-3C69-5D57-88AA-1775E2309888","لا طلبـت الثـأر منهـا ظالمـا","وأنـا القاتـل نفسـي بيـدي"],["C7702252-61D9-56BB-B391-3EC9557CEFCB","نظـرت عينـي لحينـي نظـرة","أخذت روحي وخلت جسـدي"],["1CDA3847-BA9D-59E0-B26E-B09DC68D0F94","هـاتـها بالله فـي مرضـاتـها","قهـوة فيهـا شفـاء الـكمـد"],["5AF3B88F-4A65-5862-9222-77C75F5EF1A7","عصرت باللطف في عصر الصبـا","فرمـت بالـمسـك لا بالزبـد"],["49B96152-85AA-56BC-A9A6-D3665DDF107D","ما درى مديرهـا فـي كأسهـا","وهـي مثـل البـارق الـمتقـد"],["F307E690-8177-5BDC-98FC-619EDCB742CE","درة ضمـت علـى يـاقـوتـة","أم لجيـن فيه ثـوب عسجـدي"],["9DF67B4E-33C8-5DC6-902B-67ACFC768EC0","سقنـي غيـر مليـم إننـــي","حنفـي الـرأي والـمعتقــد"],["45357D08-726B-50D0-8077-850899E42965","لا أرى بالسكـر إلاّ من هـوى","أو هبـات الـملك الـمؤيـد"],["D745AB58-096A-5DFD-BEF7-8F4880143551","مـلك الـعليـا ولـو أنصفتـه","فـفتحـت اللام لـم أفـنـد"]]},"62069969-98F2-5001-A38A-951637FC9C15":{"t":"لكل شيء إذا ما تم نقصان","p":183,"s":"لكل شيء إذا ما تم نقصان","r":"432687","v":[["CE908890-1F43-5B62-83F4-1DA01650EBC0","لِكُلِّ شَيْءٍ إِذَا مَا تَمَّ نُقْصَانُ","فَلَا يُغَرَّ بِطِيبِ العَيْشِ إنْسَانُ"],["46FF8908-4242-5A05-9DF6-C8AE3D5E5395","هِيَ الأمُورُ كَمَا شَاهَدْتُهَا دُوَلٌ","مَنْ سَرَّهُ زَمَنٌ سَاءتْهُ أزْمَانُ"],["DEB8635F-17C8-5DBE-AC48-B6F6A7AAD2AC","وهذهِ الدارُ لا تُبْقي على أحدٍ","ولا يدومُ على حالٍ لها شانُ"],["3C4D9F49-021B-55D7-A633-A3B02C7DD3D6","يُمَزق الدهرُ حتمًا كلَّ سابغةٍ","إذا نَبَتْ مَشرَفِيات وخَرصانُ"],["DEBD1F49-D3D6-59E8-965E-F98532BF55CD","ويَنتَضي كلَّ سيفٍ للفناءِ ولو","كانَ ابنَ ذي يَزَنٍ والغِمدَ غِمدانُ"],["BD4BC4B3-19A3-5D9D-B3DB-441931FDC4BF","أينَ المُلوكُ ذوو التيجانِ من يَمنٍ","وأينَ مِنْهُمْ أكَالِيلٌ وتِيجانُ"],["5C507476-1E8F-54E6-A3D1-A3763D347765","وأينَ ما شَادَهُ شَدَّادُ في إرمٍ","وأين ما سَاسَه في الفرس ساسانُ"],["161AE0E3-B052-5311-8916-0ECD0DE1A4CD","وأينَ ما حازَهُ قَارُونُ من ذَهَبٍ","وأين عادٌ وشدادٌ وقحطانُ"],["7F064893-A6D0-5E64-9641-E732BF8FD5C8","أتى على الكلِّ أمرٌ لا مَرَدَّ له","حتى قضوا فكأنَّ القومَ ما كانوا"],["A825402F-5B2E-5845-97B9-CB8EECFD6CAE","وَصَارَ مَا كَانَ مِنْ مُلكٍ ومنْ مَلكٍ","كما حَكَى عَنْ خيالِ الطيفِ وَسْنانُ"],["FDD702C5-BFCF-57CC-A0BB-A918B3FBAFA6","دارَ الزمانُ على دارا وقاتله","وأمَّ كسرى فما آواهُ إيوانُ"],["69EFC998-1348-5A87-BBAF-F54BC99FA00A","كأنَّمَا الصَّعْبُ لَم يَسهُل لهُ سببُ","يومًا وَلا مَلَكَ الدنيا سليمانُ"],["E5866154-E977-5A90-AAEA-34F393BB4CDC","فجائعُ الدهرِ أنواعٌ منوعةٌ","وللزمانِ مَسَرَّاتٌ وأحزانُ"],["7655AA86-AF55-5D7F-8649-D381FEDBE34B","وللحوادثِ سُلوانٌ يُسَهِّلُهَا","وَمَا لِمَا حلَّ بالإسلامِ سُلوانُ"],["C8A1D6B6-5E6D-5BC2-A69A-3DCDC41659DD","دَهَى الجزيرةَ أمْرٌ لا عزاءَ لهُ","هوى لهُ أُحدٌ وانهدَّ ثَهلانُ"],["E2E80FF7-E13B-528A-9086-ECB743CFD3D2","أصابَها العينُ في الإسلامِ فارتزأتْ","حتّى خلتْ منهُ أقطارٌ وبلدانُ"],["E8D00C7F-E217-5710-9D83-1BDD9DC8836A","فاسألْ بَلَنْسِيَةَ ما شأنُ مُرسيةٍ","وأينَ شاطبةٌ أمْ أينَ جيَّانُ"],["C83FF9CC-E8E0-5AD0-A292-59BAC698927A","وأينَ قرطبةٌ دارُ العلومِ فكَمْ","مِنْ عالمٍ قَدْ سما فيها لهُ شانُ"],["0BE9BF37-5D1F-53BC-8661-99A45C8010DC","وأين حِمصُ وما تحويهِ مِنْ نُزَهٍ","ونهرُها العذبُ فيّاضٌ وملآنُ"],["41FD07B0-4597-51FD-9728-0F1A67A1B07B","قواعدٌ كُنَّ أركانَ البلادِ فما","عسى البقاءُ إذا لمْ تبقَ أركانُ"],["21DB11D1-A73C-53AD-88DC-D47088E6A660","تبكي الحنيفيةُ البيضاءُ مِن أسفٍ","كما بكى لفراقِ الإلفِ هَيمانُ"],["C99FAD6A-07E4-52BC-AD72-2BD4D1DD5525","عَـلى دِيـارٍ مِـنَ الإِسلامِ خالِيَةٍ","قَـد أَقـفَرَتْ وَلَها بالكُفرِ عُمرانُ"],["32F8DB9E-B567-5993-93F2-BB3DE9082D77","حيثُ المساجدُ قدْ صارتْ كنائسُ ما","فيهنَّ إلّا نواقيسٌ وصُلبانُ"],["D5D01D98-9A9E-5B1E-AC6F-17DB5303FC4A","حتى المحاريبُ تبكي وَهْيَ جامدةٌ","حتى المنابرُ تَرثي وهْيَ عِيدانُ"],["C742BB64-8005-56F5-BFA6-949CD5E81394","يا غافلاً ولهُ في الدهرِ موعظةٌ","إنْ كنتَ في سِنَةٍ فالدهرُ يقظانُ"],["60AE1AA1-4FC8-565F-BE8C-0B283714FA16","وماشيًا مرحًا يُلهيهِ موطنُهُ","أبَعْدَ حمصٍ تَغرُّ المرءَ أوطانُ"],["24E5CC35-333B-500A-9FE4-4BCD85EBCAA7","تلك المصيبةُ أنْسَتْ ما تقدَّمها","وما لها معَ طولِ الدهرِ نِسيانُ"],["6509A430-E481-5AFC-8E41-3C1168A9A553","يا أيها الملكُ البيضاءُ رايتُهُ","أدركْ بسيفِكَ أهلَ الكُفرِ لا كانوا"],["B6C0102D-CA1A-5A62-AA17-E78419F57A55","يا راكبينَ عِتاقَ الخيلِ ضامرةً","كأنها في مجالِ السَّبقِ عُقبانُ"],["3EEA14B3-9DE7-55AC-B596-6D36BDB95704","وحاملينَ سيوفَ الهندِ مُرهفةُ","كأنها في ظلامِ النَّقع نِيرانُ"],["DB41A2FA-68B3-55FC-87C5-FEF107E4AA9B","وراتعينَ وراءَ البحرِ في دَعةٍ","لهمْ بأوطانهمْ عِزٌّ وسُلطانُ"],["9CDD81CF-6586-534E-AE85-AAE508B47671","أعندكم نبأٌ منْ أهلِ أندلسٍ","فقدْ سرى بحديثِ القومِ ركُبانُ"],["E3D542F0-DEE0-57A2-A536-A2AA4904932B","كمْ يستغيثُ بنا المستضعفونَ وهُمْ","قتلى وأسرى فما يهتزُّ إنسانُ"],["7623C1F3-CFEB-5FE9-BDB8-CB01092E7045","ما ذا التقاطعُ في الإسلامِ بينكمُ","وأنتمُ يا عبادَ الله إخوانُ"],["59737E56-069F-5A34-9C15-557401C0E45E","ألا نفوسٌ أبيَّاتٌ لها هممٌ","أما على الخيرِ أنصارٌ وأعوانُ"],["9F02634B-D694-5D64-87AA-EC87F6213F68","يا مَنْ لذلةِ قومٍ بعدَ عزَّتِهِم","أحالَ حالهُمُ كفرٌ وطُغيانُ"],["97F8B233-72F8-5147-844B-0D9CE17CAD1C","بالأمسِ كانوا ملوكًا في منازِلِهِم","واليومَ همْ في بلادِ الكفرِ عُبدانُ"],["5D33C3A6-C1C4-576D-90C4-55464BDC5E82","فلو تراهمْ حيارى لا دليلَ لهمْ","عليهِمُ منْ ثيابِ الذلِّ ألوانُ"],["362455F2-CF45-5BA1-982F-88232410A410","ولو رأيتَ بكاهُم عندَ بيعِهِمُ","لهالَكَ الأمرُ واستهوتْكَ أحزانُ"],["D01929F8-41FF-5B5A-9BAA-41F1C69C04D2","يا رُبَّ أمٍّ وطفلٍ حِيلََ بينهمَا","كما تُفرَّقُ أرواحٌ وأبدانُ"],["99AA40ED-5162-5F59-AF21-BA1C64FBDBAB","وطفلةٍ مثلَ حسنِ الشمسِ إذْ طلعتْ","كأنما هي ياقوتٌ ومَرجانُ"],["9261B9F0-622B-54EB-A5EA-BBBDE983B352","يقودُها العلجُ للمكروهِ مُكرهةً","والعينُ باكيةُ والقلبُ حَيرانُ"],["985239A8-0BD9-5C53-ADB0-659D3D0F5298","لمِثلِ هذا يذوبُ القلبُ من كمدٍ","إنْ كانَ في القلبِ إسلامٌ وإيمانُ"]],"n":"نونية أبي البقاء الرّندي من مراثي الأندلس نظمها بعد سقوط آخر أراضي المسلمين في الأندلس."},"0D4229EC-57E8-59D6-BC4C-C3011ECCA868":{"t":"ياسالبَ القلبِ","p":183,"s":"يا سالب القلب","r":"438934","v":[["B97825F3-4FEF-5756-A510-2165A986AA2C","يا سالبَ القلبِ مِنـّي عندما رَمَقـا","لم يُبقِ حُبـُّكَ لي صبـرًا ولا رَمَقـا"],["432B8153-9607-50FF-8B76-55EAD6B91630","لا تسألِ اليومَ عمَّا كابَدَتْ كَبـِدي","ليتَ الفِراقَ وليتَ الحُـبَّ ما خُلِقـا"],["C971C237-71DB-5203-B6CD-448591CD09F6","ما باختيـاري ذُقتُ الحُـبَّ ثانيـةً","وإنَّمـا جـارتِ الأقـدارُ فـاتفقـا"],["13CB1C24-D2D9-5A28-A02B-0C79A9D1ABD0","وكنتُ في كَلَفي الداعـي إلى تَلَفـي","مِثلَ الفراشِ أحَـبَّ النـارَ فاحترقـا"],["BFCCA098-4C40-5998-930B-793C742DFD57","يا مـَن تَجلَّـى إلى سِـري فصيَّرَنـي","دكًا وهَـزَّ فـؤادي عنـدما صُعِقـا"],["6076A1D5-4A39-58C2-819F-E63E9DD0FC64","انظـرْ إليَّ فـإنَّ النفـسَ قد تَلفـت","رِفـقًا علـى الـروحِ إنَّ الروحَ قـد زَهقـا"]]}}}