{"v":1,"poems":{"75E72494-DFB8-5035-90DC-0A23C4E84130":{"t":"أَأهجوا تَميماً إن تَعرَّضَ مُلصَقٌ","p":110,"s":"أأهجوا تميما إن تعرض ملصق","r":"477762","v":[["7C9CDF24-A924-542F-A5BD-9578F8B0D5C7","أَأهجوا تَميماً إن تَعرَّضَ مُلصَقٌ","إليها دَعي قد نفتهُ قرونُها"],["2B0229A4-5063-51EF-B98E-09587CC5CD9D","فآخذُها طراً بذنبِ دَعيها","فأينَ نُهى قومي وأَينَ حُلومُها"],["1B6057B4-3D0C-5164-881D-44CB324E495A","وما في دَعِيِّ القومِ ثأرٌ لثائرٍ","ولم تَقترف ذَنباً فيهدى صميمها"],["B8268EBB-4FFA-5DD5-8AEC-D668D28AFE3E","أعافيَ إنَّ اللومَ منك سجيّةٌ","وشرُّ حِلال الأدعياءِ قَديمُها"]]},"0D55C65A-7D45-5219-95B0-A6A3E25B66A4":{"t":"إذا وضعناكَ رفعناكا","p":110,"s":"إذا وضعناك رفعناكا","r":"477760","v":[["680E5F24-A65E-53DD-B281-1329AF77C176","إذا وضعناكَ رفعناكا","وإن هجوناكَ مدحناكا"],["C86A1A83-8F82-5FD2-9DC8-646FDAD52A59","وكيف يُهجَى رجلٌ قَدرُهُ","أَعاننا اللَهُ وإيّاكا"]]},"0BB97C72-EE69-5DE8-9C3B-F4317B44D10E":{"t":"إذهب فأنتَ طليقُ عِرضِكَ","p":110,"s":"إذهب فأنت طليق عرضك","r":"477759","v":[["52CE872B-CB85-5E0B-AF55-5700B4E458B6","إذهب فأنتَ طليقُ عِر","ضِكَ ذَلَّ حتّى قد حَماكا"],["625CA591-4389-5A18-B265-2DD0A7823CB8","إنَّ المُضيّعَ شعرَهُ","عين المضيّعِ مَن هجاكا"],["1AAC4855-AA5A-53D0-9C26-DC96155950B4","إنّي سأصرفُ صائناً","عنك الهجِاَء إلى سِواكا"],["19F4141F-984A-5AC0-99FF-5502C2AA9CF9","أَسَلُ الذي خلق البريّة","أَن يََراكَ كما أراكا"]]},"BC82DF35-B53A-5C26-B98C-9E05005D1EA1":{"t":"إنَّ فقد النومِ أعدمَني","p":110,"s":"إن فقد النوم أعدمني","r":"477763","v":[["AADEA427-647F-5D6C-81C7-EF9AED31BBAB","إنَّ فقد النومِ أعدمَني","رُؤيةَ الأحبابِ في الحلمِ"]]},"0029D4A3-7829-5EA2-8748-841D056BCED6":{"t":"بأبي واللَهِ مَن طَرَقا","p":110,"s":"بأبي والله من طرقا","r":"477757","v":[["BEF57923-5003-5887-BF77-5E28850FE050","بأبي واللَهِ مَن طَرَقا","كأبتسامِ البَرقِ إذ خَفَقا"],["0240B2E3-3CA2-5679-A37F-F05A64CBA7E8","زادَني شوقاً بزَورتهِ","وملا قلبي به حُرَقا"],["3314DF24-335B-511E-B2EC-2A1473285075","مَن لقلبٍ هائمٍ دَنِفِ","كلمّا سلّيتُه قَلقا"],["E428DE6E-D51E-55C9-9572-5C146E7B74C2","زارني طيفُ الحبيبِ فما","زادَ أَن أَغرى بيَ الأرقا"]]},"1551EDE8-EBFF-5D69-8293-E02333BC439C":{"t":"بَدا لابساً بُردَ النبّيِ محمّد","p":110,"s":"بدا لابسا برد النبي محمد","r":"477754","v":[["5D433ECD-F5B7-5ABC-AAA5-7E3F7AD9AF9D","بَدا لابساً بُردَ النبّيِ محمّد","بأحسنَ مِمّا أَقبلَ البَدرُ طالعا"],["4A77CE08-CAB7-5B2B-A158-5BE449829066","سَمِيُّ النبيِّ وآبنُ وارثهِ الذي","بهِ استشفعوا أَكرِم بذلكَ شافعا"],["79744025-E148-5B4C-90B4-8AD3AE405356","فَلمّا عَلا الأعوادَ قامَ بخطبةٍ","تَزيدُ هُدى مَن كانَ للحقِّ تابعا"],["EA654EC0-B12C-5B9D-8A2B-51F39EF7D6DD","وكلُّ عَزيزٍ خَشيةً منهُ خاشعٌ","وأَنتَ تَراهُ خَشيةَ اللَهِ خاشعا"]]},"9F620610-1E3B-5DEF-A2F7-4ECD84C050A3":{"t":"جزاؤهُ كلّماناه","p":110,"s":"جزاؤه كلماناه","r":"477749","v":[["14428CDB-26E1-5FF3-A375-1C30E01FF005","جزاؤهُ كلّمانا","ه أَن يهانَ بصّدهِ"],["01F3EFFF-2955-59F5-96A6-9247B8502D33","يا ربِّ فامنن علينا","قبلَ الممات بفقدهِ"]]},"4DB262DA-778C-5D51-AB67-DE5B79EA654D":{"t":"جفاني أبو أيوب نفسِي فداؤهُ","p":110,"s":"جفاني أبو أيوب نفسي فداؤه","r":"477746","v":[["5470DCBE-B17A-5FDD-8852-B87F3799DB73","جفاني أبو أيوب نفسِي فداؤهُ","فعابتُهُ كيما يريعَ ويعتبا"],["0C489179-4FB3-5F52-8534-C8CAC62B7346","فوَ اللَهِ لولا الضَنُّ منّي بودّهِ","لكانَ سهيلٌ من عِتابيهِ أَقربا"]]},"2A6A2FAC-BB54-588D-AC80-DE9ED221D78D":{"t":"سأختارُ من حُرِّ الكلام قصيدةً","p":110,"s":"سأختار من حر الكلام قصيدة","r":"477747","v":[["C9196B25-B982-5FB3-B73E-179403B040F6","سأختارُ من حُرِّ الكلام قصيدةً","لِفتحِ بن خاقانٍ تفوقُ القصائدا"],["7078A3ED-BA5B-5C10-B7C1-A3320C9388ED","يَلَذُّ بأفواهِ الرُّواهِ نَشيدُها","وَيُشنا بها من كانَ للِفتحِ حاسدا"],["9E1B43D2-590B-5A53-ABF7-FDCC37654DD8","لَعَمرُك إنَّ الفتحَ مُذ كانَ يافعاً","ليَسمو إلى أَعلى ذُرى المجدِ صاعدا"],["752A4959-C882-5A71-819C-2495B10553BF","قريعُ المَوالي سادَ في خمس عشرة","موالي بني العبّاسِ لم يُبقِ واحدا"],["A10AC2EB-0CC6-5C88-877B-60B19EA67880","وبذّهم طُرّاً ندىً وشجاعةً","فألقَوا إليهِ مُذعنينَ المقالدا"]]},"A5C85769-0ED6-535E-822B-8F41FC9BB26C":{"t":"سَيعلمُ دَهرِي إذ تَنكّرَ أَنّني","p":110,"s":"سيعلم دهري إذ تنكر أنني","r":"477755","v":[["B17849EF-55E2-5C89-B129-62DE28BC0FCE","سَيعلمُ دَهرِي إذ تَنكّرَ أَنّني","صَبورٌ على نُكرانِهِ غيرُ جازِعِ"],["5AF37D14-4DE8-5D08-8243-AFE6B84D1427","وأَنّي أَسوسُ النَفسَ في حالِ عُسرِها","سِياسةَ راضٍ بالمعيشةِ قانعِ"],["340E5920-6FA1-5E45-8955-3F571C6577E0","كما كنتُ في حالِ اليَسار أَسوسُها","سِياسةَ عَفٍّ في الغَنى مُتواضعِ"],["BB9ECE70-7016-5CAC-9BF5-BE957B7239DD","وأَمنعُها الوِردَ الذي لا يَليقُ بي","وإن كنتُ ظمآناً بَعيدَ الشّرائعِ"]]},"71D9DD53-4283-59AE-9A9C-2CC81F69AE91":{"t":"طيفٌ أَلم بذي سَلَم","p":110,"s":"طيف ألم بذي سلم","r":"477761","v":[["B7C2B2D8-0F12-56F0-BD52-E7691DC65CD6","طيفٌ أَلم بذي سَلَم","بعدَ العَتَم يَطوي الأكَم"],["9A29771F-5194-5447-88A7-B9430F8C9D95","جادَ بفّم ومُلتزَم","فيهِ هَضَم إذا يُضم"]]},"C9BD8C1F-53B4-5BDF-B077-AF085AA2A4AC":{"t":"عليُّ بن يحيى جامعٌ لِمَحاسنٍ","p":110,"s":"علي بن يحيى جامع لمحاسن","r":"477748","v":[["2919D194-ED84-5399-BA39-894597B5D6A8","عليُّ بن يحيى جامعٌ لِمَحاسنٍ","من العلمِ مَشغوفٌ بِكَسبِ المَحامدِ"],["DB7EB53A-E6BE-5FFE-A56A-968774A7087A","فلو قِيلَ هاتُوا فيكمُ مثلَهُ","لَعَزَّ عليكم أَن تجيئُوا بواحدِ"]]},"2EDA1E99-5086-531B-8D46-85749B253DD5":{"t":"قطائفٌ قد حُشيت باللّوز","p":110,"s":"قطائف قد حشيت باللوز","r":"477752","v":[["52E7B6C0-AEDC-5041-80FD-14380A68943A","قطائفٌ قد حُشيت باللّوز","والسُّكّرِ الماذيّ حَشوَ المَوزِ"],["F99AA917-61A4-58A5-B2FA-8120F4D4D549","تسبحُ في آذيّ دُهنِ الجَوزِ","سُرُرتُ لمّا وقعت في حوزي"]]},"DF47865F-1205-5E7D-8DEB-56599B1B1361":{"t":"لقد فَتنت نَبتٌ في الظرف والندَّى","p":110,"s":"لقد فتنت نبت في الظرف والندى","r":"477750","v":[["4BF31FFD-A7F5-59BB-8775-7E37EC60128A","لقد فَتنت نَبتٌ في الظرف والندَّى","بمقلةِ رِيمٍ فاترِ الطرفِ أحورِ"],["6B4FD11B-708A-5B7A-9360-54A25C27C3FD","وشدوٍ يَروقُ السامعينَ ويملأ ال","قلوبَ سروراً مُونقٍ مُتخيرِ"],["E76DE49B-1EF3-5B21-A162-F862B76E0B5C","فأصبحَ في فخّ الهوَى متقنّصاً","عزيزٌ على إخوانه ابنُ المُدبّرِ"],["ECE0DF00-1FF8-5BF0-907D-1E6EF6934D6A","ولم تَدرِ ما يلقَى بها ولو انّها","دَرت روَّحت من حَرّهِ المُتَسعّرِ"],["1C9F4BA4-655B-5B94-B3C6-212CCC25ACC2","وذا بها صَبٌّ ونبتٌ خليّةٌ","ومشغولةٌ عنه بوجهِ مُظفّرِ"],["9914DE18-9AB6-5788-B23A-B4BE2104B69C","ولو أَنصفت نَبتٌ لما عدَلت بهِ","سواهُ وحازت حسنَ مرأى ومَخبرِ"]]},"CC27EED3-223E-55CC-89B3-46497AA1DE50":{"t":"لم يَرضَ إلا بالكريمة مَركباً","p":110,"s":"لم يرض إلا بالكريمة مركبا","r":"477765","v":[["31FDC5CC-3039-5EC7-8034-4D1AAE57667F","لم يَرضَ إلا بالكريمة مَركباً","ولربما امتنعت عليه أتانُ"]]},"668D4640-8567-5F02-99EB-CA5D86185E1D":{"t":"ليتَ شعري مَهرَجتَ يا دهقانُ","p":110,"s":"ليت شعري مهرجت يا دهقان","r":"477764","v":[["311ABA56-51EB-5DA5-BF6C-0AC1053ED377","ليتَ شعري مَهرَجتَ يا دهقانُ","وقديماً ما مَهرَجَ الفتيانُ"],["3B261C4A-EA21-5354-BF5D-28C96F714A2E","لم أزل أُعمِلُ الزجاجة حتّى","كان منّي ما يَعملُ السكرانَ"]]},"B72AC5C8-2184-52A7-9EE9-97E88515FE34":{"t":"لَعمري لقد أَحسنتَ يا ابن المُدبّرِ","p":110,"s":"لعمري لقد أحسنت يا ابن المدبر","r":"477751","v":[["8259C165-8A16-51A9-92F1-F89386691084","لَعمري لقد أَحسنتَ يا ابن المُدبّرِ","وما زلتَ في الإحسانِ عينَ المُشهّرِ"],["C1712E27-05DB-5D23-9B22-A700D40FEE10","ظَرفَتَ ومَن يجمع من العلمِ مثلَ ما","جمعتَ أَبا إسحاقَ يَظرُف وَيُشهَرِ"],["6DFD8702-D8E7-5BA4-9117-25FFBD2BAD4F","أسالت على الخدَّينِ دَمعاً لو انّهُ","من الدُّرِّ عَقدٌ كانَ ذُخراً من الذُّخرِ"]]},"B0289616-7488-5388-9098-65CEA03B6B8D":{"t":"مَن ذا على الدّهرِ يُعديني فقد كَثُرت","p":110,"s":"من ذا على الدهر يعديني فقد كثرت","r":"477753","v":[["07DE770B-E4AD-562F-B04A-E63A686DFB10","مَن ذا على الدّهرِ يُعديني فقد كَثُرت","عِندي جنايتُهُ يا مَعشَر الناسِ"],["599666D7-9E3D-5BF4-9768-E0D2DB0D1132","أخنى على المَلكِ المأمونِ كلكلُهُ","فَصارَ رَهناً لأحجارٍ وأَرماسٍ"],["E87A8565-7811-54AB-9F56-FF71D41B77C2","قد كاد ينهدُّ رُكنُ الدّينِ حين ثَوَى","وَيَتركُ الناسُ كالفَوضَى بلا راسِ"],["D4301441-7576-5AB5-B16A-D5ADE797901F","حتّى تَداركَهُم باللَهِ مُعتصِمٌ","خَيرُ الخلائفِ من أَولادِ عبّاسِ"]]},"CC1B211E-ACBE-5DBB-9475-2F3485C94E44":{"t":"وجهٌ كأنَّ البدرَ ليلةَ تمّهِ","p":110,"s":"وجه كأن البدر ليلة تمه","r":"477758","v":[["4B070D81-7848-5C0B-83CA-AB33680B100D","وجهٌ كأنَّ البدرَ ليلةَ تمّهِ","منهُ استعارَ النُّورَ والإشراقا"],["22EA2C6B-2842-5B9D-BC80-2C146493FDF7","وأَرى عليه حَديقةَ أَضحى لها","حَدقي وأَحداقُ الأنام نطاقا"]]},"A1291DD5-E3D1-5369-AA2B-4EAD36E939EB":{"t":"ومِن طاعتي إيّاهُ أَمطرَ ناظرِي","p":110,"s":"ومِن طاعتي إيّاهُ أَمطرَ ناظرِي","r":"477756","v":[["D4F467D6-80B0-5555-9AB0-1891AF24C67D","ومِن طاعتي إيّاهُ أَمطرَ ناظرِي","إذا هوَ أَبدى من ثَناياهُ لي بَرقا"],["037ADE2B-F72E-52C9-9583-1E1CDF78382F","كأنَّ جفوني تُبصرُ الوَصلَ هارِباً","فَمِن أَجلِ ذا تَجرِي لتُدركهُ سَبقا"]]}}}