{"v":1,"poems":{"1210182E-494E-5B50-BB42-51FD3CCF5162":{"t":"أتُرَانِي أرَى مِنَ الدَّهْرِ يَوْماً","p":94,"s":"أتراني أرى من الدهر يوما","r":"438104","v":[["78FBEDB0-4E6D-5DA1-B28B-F530B5F706D5","أتُرَانِي أرَى مِنَ الدَّهْرِ يَوْماً","لِيَ فيه مَطِيَّةٌ غيرُ رِجْلِي"],["41744251-AF30-5F1C-87B3-90D171C550CC","كُلَّما كُنْتُ في جَمِيعٍ فقالوا","قَرِّبُوا للرَّحِيلِ قَرَّبْتُ نَعْلِي"],["C7647175-B584-57E7-893D-C96C1289F19D","حيثما كنتُ لاأخلفُ رحلاً","منْ رآني فقد رآني ورحلي"]]},"C705E027-F914-5C79-8DD6-635187595135":{"t":"أسْمَجُ النّاسِ جميعاً كُلِّهِمْ","p":94,"s":"أسمج الناس جميعا كلهم","r":"438099","v":[["60B8F52B-EAD8-5831-968C-D06B97AAB169","أسْمَجُ النّاسِ جميعاً كُلِّهِمْ","كذبابٍ ساقطٍ في مرقهْ"]]},"43936C72-FA3D-51D6-953A-A51258777E5A":{"t":"ألا قولا لسرانِ المخازي","p":94,"s":"ألا قولا لسران المخازي","r":"438093","v":[["F174B191-08C2-5ACF-9491-324E3F2A2289","ألا قولا لسرانِ المخازي","ووجهِ الكلبِ والتيسِ الضروطِ"],["417EE117-5E09-59B7-82C8-9C56BBBA99C3","لهُ بطنٌ يضلُّ الفيلُ فيه","وَدُبْرٌ مثلُ رَاقود النَّشُوطِ"],["A3B56146-0D31-5346-AFED-2F23FE7C3DFB","ولحيةُ حائكٍ من بابِ قلبٍ","موصلةِ الجوانبِ بالخيوطِ"],["7876EE3F-A2B9-507C-BBF6-C3A130C58030","له وجهٌ عليه الفقرُ بادٍ","مُرَقَّعَةٌ جَوَانِبُهُ بِفُوطِ"],["442D3D92-22E9-5451-A522-9243512B8575","إذا نهضَ الكرامُ إلى المعالي","ترى سرانَ يسفلُ في هبوطِ"]]},"20B0DB91-5C26-5FAF-9087-B0F4CB1F4CAA":{"t":"أنا بالأهوازِ جارٌ لعمرْ","p":94,"s":"أنا بالأهواز جار لعمر","r":"438088","v":[["034F19C5-3FEA-53BA-9478-342DF8196BD4","أنا بالأهوازِ جارٌ لعمرْ","لعظيمٍ زعموا ضخمِ الخطرْ"],["D7468732-E34B-57BD-8E25-A363AB1257B2","لا يُرَى منه علينا أثَرٌ","لايكون الجودُ إلاّ بأثرْ"],["8E29EC9D-BD63-5DA8-A998-8768D1FF82E7","إن تكن وُرْقُكَ عنّا عَجَزَتْ","يا أبا حفَصٍ فَجُدْ لي بِحَجَرْ"],["38E67F0C-5ACD-511A-B60C-924633C64FC0","يَكْسُرُ الجوزَ بهِ صبيانُنَا","وإذا ما حَضَرَ اللَّوزُ كُسِرْ"]]},"3E1DF3E1-FC05-590F-9254-A3CD7C621223":{"t":"أنا بالأهوازِ محزونٌ","p":94,"s":"أنا بالأهواز محزون","r":"438075","v":[["9BA4B4B0-62AE-5178-BAF7-14408CA7B29D","أنا بالأهوازِ محزونٌ","وبالبصرةِ داري"],["472469D6-482E-54ED-A650-B5AAE0337F9D","في بني سعدٍ وسعد","حيثُ أهلي وقراري"],["27E3269C-4481-5E23-B059-B7DC7285B8AA","صرتُ كالخفاشِ لا","أبصرُ في ضوءِ النهارِ"]]},"82AF7DC1-EA42-5916-8B9B-C30A10DDBFA8":{"t":"أنا في حالٍ تعالى","p":94,"s":"أنا في حال تعالى","r":"438101","v":[["3026197F-B2B9-5EA2-AD1F-10A9E6F0DB16","أنا في حالٍ تعالى","اللّهُ ربِّي أيّ حالِ"],["B9BBB49A-132D-5517-847D-E8B3D603F640","ولقد أهزلتُ حتى","مَحَتِ الشَّمْسُ خَيالي"],["868F3ADA-12AC-505F-ACDC-D4255B724D24","من رَأَى شَيْئاً مُحالا","فأنَا عَيْنُ المُحالِ"],["E5A88932-8FFF-56FB-961A-34050A2986C1","لَيْس لي شَيْءٌ إذا قِيـ","ـلَ لمنْ ذَا قلتُ ذَا لِي"],["5AEAFEB7-DD1C-52C1-8FCF-CC86E7BE8131","ولقد أفْلَسْتُ حتى","حلَّ أكلي لعيالي"],["72729EF6-E648-5901-9E30-B5C8FD12598C","في حِرِ کمِّ النَّاسِ طُرّاً","منْ نساءٍ ورجالِ"],["94E81635-B638-50E3-8854-9D240BCEFDEC","لو أرى في الناسِ حراً","لَمْ أكنْ في ذَا المِثَالِ"]]},"5FD23DFD-CEF5-5D0D-A837-E663D52B7CD0":{"t":"أنتمْ خشارُ خشارٍ","p":94,"s":"أنتم خشار خشار","r":"438092","v":[["B153F659-5F28-521C-96FE-926C73A412EC","أنتمْ خشارُ خشارٍ","وليسَ خَزٌّ كَخَيْشِ"],["DFE93D3C-A048-50A6-9A8F-0C27D238B447","تَزَوَّجُوا في قُرَيْشِ","إن كنتمُ منْ قريشِ"]]},"417E9E16-0283-56F4-A37E-15FA7105A4AB":{"t":"أهلُ جودٍ ونائلٍ وفعالٍ","p":94,"s":"أهل جود ونائل وفعال","r":"438119","v":[["A82DC349-6885-51EA-97D5-9C85E90B9B1F","أهلُ جودٍ ونائلٍ وفعالٍ","غلبوا الناسَ بالندى والعطيهْ"],["49DEFAF3-DCA3-511A-866B-41978D60D3B0","جئتهُ زائراً فأدنى مكاني","وَتَلَقَّى بِمَرْحَبٍ وَتَحِيَّهْ"],["79D3A08A-DB5F-5216-9055-A712213FC415","لاكمثلِ الأصمِّ حارثةِ اللؤمِ","مِ شَبِيهِ الكُلَيْبَةِ القَلَطِيَّهْ"],["8F12C88A-A02A-558A-83FA-98D47190C942","جئتهُ زائراً فأعرضَ عني","مثلَ إعراضِ قَحْبَةٍ سُوسِيَّهْ"]]},"851A0546-C0AA-59A2-A156-19C825830D61":{"t":"أَخَذَ الفَأْرُ بِرِجْلِي","p":94,"s":"أخذ الفأر برجلي","r":"438094","v":[["3BBC88C6-30B7-5253-B085-E539AC5B8081","أَخَذَ الفَأْرُ بِرِجْلِي","جَفَلُوا منها خِفَافِي"],["4BCC5B89-CAB3-5B9E-B71B-4F1DECA1F08C","وسراويلاتِ سوءٍ","وتبابينَ ضِعافِ"],["2872F280-C4B7-50B1-A599-2086B6540C64","دَرَجُوا حولي بِزَفْنِ","وبضربٍ بالدفافِ"],["AC09BA3D-31B9-5668-8926-1E321B38A41A","قلتُ: ما هذا؟ فقالوا:","أنت من أهلِ الزِّفافِ"],["8AB3118C-E7C9-584B-93DC-168DEFD36BB9","ساعةً ثُمَّتَ جازوا","عنْ هوايَ في خلافِ"],["D2FA4A04-41C7-5861-ABFB-B334A28F5DB7","نقروا إستي وباتوا","دون أهلي في لحافِ"],["96A788DE-EECB-540A-B391-761FBF1B921B","لَعَقُوا إسْتِي وقالوا","ريحُ مسكٍ بسلافِ"],["0C8C7619-D750-5A36-B5DA-05B56E4925E1","صَفَعُوا نازُويَه حتى","إستهلت بالرعافِ"]]},"0B84DBAE-14F3-53CE-88B8-88BC07292DBF":{"t":"أَلا رُبَّ برغوثٍ تركتُ مُجَدَّلاً","p":94,"s":"ألا رب برغوث تركت مجدلا","r":"438103","v":[["912F26AD-9B79-54EA-BD71-957ECBF3ED46","أَلا رُبَّ برغوثٍ تركتُ مُجَدَّلاً","بأبيضَ ماضِي الشَّفْرَتَيْنِ صَقِيلِ"]]},"0C7AE064-5408-56AB-AFFA-DB521BDF0FD0":{"t":"إذا حججتَ بمالٍ أصلهُ دنسٌ","p":94,"s":"إذا حججت بمال أصله دنس","r":"438086","v":[["769FD917-39FF-5DF6-9E37-95B5F9C5C3DF","إذا حججتَ بمالٍ أصلهُ دنسٌ","فما حججتَ ولكنْ حَجَّتِ العِيرُ"],["C612CB81-75D0-5A5A-B049-E9610416AE0D","لا يقبلُ الله إلاّ كلَّ طَيِّبَةٍ","ما كلُّ مَنْ حَجَّ بيتَ الله مَبْرُورُ"]]},"D6BB2F88-A181-5680-9CFB-603917E6B5D4":{"t":"إنَّ رياحَ اللؤمِ منْ شحه","p":94,"s":"إن رياح اللؤم من شحه","r":"438069","v":[["57132E34-A60D-50F5-9D4C-C50F0F04EC3C","إنَّ رياحَ اللؤمِ منْ شحه","لا يَطمَعُ الخنزيرُ في سَلْحِهِ"],["8754CD7C-CA22-5543-A380-C9121B0171E5","كفاهُ قفلٌ ضلَّ مفتاحهُ","قد يَئِسَ الحَدَّادُ مِنْ فَتْحِهِ"]]},"CB30AFF7-A648-5333-BB52-BE17C9EA1690":{"t":"الجودُ أفلسهمْ واذهبَ مالهم","p":94,"s":"الجود أفلسهم واذهب مالهم","r":"438106","v":[["AE45E71A-C2E2-57E3-84E4-4C51D57599E2","الجودُ أفلسهمْ واذهبَ مالهم","فاليومَ إنْ راموا السماحةَ يبخلوا"]]},"999CCEBD-DB35-54D6-9FEE-5BA3B91F126D":{"t":"الحمدُ لله شكراً","p":94,"s":"الحمدُ لله شكراً","r":"438079","v":[["12FA158C-E301-5FC1-87FF-517B48B94455","الحمدُ لله شكراً","أمْشِي ويركبُ غَيْرِي"],["28CEDBEA-F49A-5209-B166-570083D7A63F","قد كنتُ آمل طِرْفاً","فَصِرْتُ أرْضَى بِعَيْرِ"],["B9B5C7B9-4056-5561-9D0B-4F0DE8282022","ليت الأيُو.. دوابٌ","فكنتُ أركبُ أيـ"],["FDFA89FC-4625-53B2-AE5E-1A9D76219698","لم ترضَ نَفْسِي بهذا","ياربِّ منكَ لخيرِ"]]},"721E1A02-2FDD-5928-9C1C-EEB921CE2367":{"t":"الصِّدْقُ في أفْوَاهِهِمْ عَلْقَمٌ","p":94,"s":"الصدق في أفواههم علقم","r":"438074","v":[["6BDB2AD6-2829-55E3-B9ED-5CFDA0AEBB74","الصِّدْقُ في أفْوَاهِهِمْ عَلْقَمٌ","والإفكُ مثلُ العسلِ الماذي"],["27239F84-A6BD-5B6D-8357-FE0FF9A0734E","وكلهمْ في بخلهمْ صادقٌ","وفي النَّدَى لَيْسَ بأُسْتَاذِ"]]},"786927B8-BD88-52E7-8897-41FC8FEA8FA9":{"t":"الطريقَ الطريقَ جاءكمُ الأحمقُ","p":94,"s":"الطريق الطريق جاءكم الأحمق","r":"438082","v":[["FD26136A-BC68-5EAF-B844-12FE36D895A9","الطريقَ الطريقَ جاءكمُ الأحمقُ","رأس الأنتانِ والقذره"],["614488D7-0723-5515-B424-77710E444A17","وکبْنُ عَمِّ الحمارِ في صورةِ الفـ","ـيلِ وخالُ الجاموسِ والبَقَرَه"],["604A1E5B-7417-5607-BD34-BE27BA81AF9A","يمشي رويداً يريدُ حلقتكم","كمشي خِنْزيرةٍ إلى عَذِرَه"]]},"60CA3C9B-B1D5-52BA-A145-5D8D46492028":{"t":"بَرَزْتُ منَ المنازِلِ والقِبَابِ","p":94,"s":"برزت من المنازل والقباب","r":"438062","v":[["E2DD18C2-B598-5BBE-AD5D-2C32C640F00D","بَرَزْتُ منَ المنازِلِ والقِبَابِ","فلم يَعْسُرْ على أَحَدٍ حِجَابِي"],["08E2DA78-DC2E-51BE-A69C-D333A12F7561","فمنزليَ الفضاءُ وسقفُ بيتي","سماءُ اللهِ أوْ قطعُ السحابِ"],["AAE693D9-01A6-5C74-AF12-E7F1EABE2A65","فأنتَ إذا أردتَ دخلتَ بيتي","عليَّ مُسَلِّماً من غَيْرِ بابِ"],["4A3F8B15-61C6-59DA-9B73-5F5A1D89710A","لأني لم أجدْ مصراعَ بابٍ","يكونُ مِنَ السَّحَابِ إلى التُّرَابِ"],["2C7A35BE-D991-5A53-A434-096857015741","ولا أنشقَّ الثرى عن عودِ تختٍ","أؤمل أنْ أشدَّ بهِ ثيابي"],["3797A8DD-F418-51DB-8BF7-F07C54CEBAAD","ولا خِفْتُ الإبَاقَ على عَبِيدي","ولا خِفْتُ الهلاكَ على دَوَابي"],["09F0F5F7-32E0-5AD8-9FC9-3F4A9D0D6F1F","ولاحاسبتُ يوماً قهرماناً","مُحاسبةً فأغْلَظُ في حِسَابِي"],["3A6C8648-E889-5C93-B908-901E89F7F24B","وفي ذا راحةٌ وَفَراغُ بالٍ","فدابُ الدهرِ ذا أبداً ودابي"]]},"82026A0A-BCE3-5EDF-813C-2C3A5D38CE3A":{"t":"خُبْزُ المُعَلِّمِ والبَقَّالِ مُتَّفِقٌ","p":94,"s":"خبز المعلم والبقال متفق","r":"438087","v":[["3EA1D89D-63B2-527C-BBF9-B5EEF622616B","خُبْزُ المُعَلِّمِ والبَقَّالِ مُتَّفِقٌ","واللَّوْنُ مختلِفٌ والطَّعْمُ والصُّوَرُ"]]},"88F296DE-B4E9-5B32-B4BE-D598E6BB19EB":{"t":"ذهبَ الموالِ فلاموا","p":94,"s":"ذهب الموال فلاموا","r":"438064","v":[["B7E05F79-3999-51D7-B9B9-431F2F89D8FA","ذهبَ الموالِ فلاموا","لِ وقد فجعنا بالعربْ"],["1178DF1C-D791-55ED-9BB0-12B851FC4529","إلا بقايا أصبحوا","بالمِصْرِ من قِشْرِ القَصَبْ"],["FA350252-8902-557F-8568-D7AC90FFF4D7","بالقولِ بَذُّوا حاتماً","والعقلُ ريحٌ في القِرَبْ"]]},"DCA79BAA-72AA-58ED-9B5C-18C476A8FCA0":{"t":"رَحَلَ المَطِيَّ إليكَ طُلاَّبُ النَّدَى","p":94,"s":"رحل المطي إليك طلاب الندى","r":"438116","v":[["2B9439E8-D9FA-51EC-99CC-71DB99F4FB5C","رَحَلَ المَطِيَّ إليكَ طُلاَّبُ النَّدَى","ورحلتُ نحوك ناقةً نعليهْ"],["6FB327C6-F9F7-565F-ABCB-6DF30B98E896","إنْ لم تكنْ لي يا يزيدُ مطيةٌ","فَجَعَلْتُها ليَ في السِّفَارِ مَطِيَّهْ"],["348E36BC-662A-5A22-A528-32B2E6DCE33B","تخدي أمامَ اليعملاتِ وتغتلي","في السَّيْرِ تَتْرُكُ خَلْفَها المَهْرِيَّهْ"],["0DEB846A-3A83-5BB8-B15F-9E14E4816479","وإذا ركبتُ بها طريقاً عامراً","تنسابُ تحتي كانسيابِ الحيهْ"],["1AC87851-542F-522D-B48D-119E30BA7A0D","لَوْلا الشّراك لقد خشيتُ جماحَها","وزمامَها ما أن تمسَّ يَدَيَّهْ"],["68E7A205-01C1-5088-BC3F-3A727A8C4A36","تنتابُ أكرمَ وائلٍ في بيتها","حسباً وقبةُ مجدها مبنيهْ"],["A04BF937-AB7F-54A5-9D85-586CFE7A43F3","أعني يزيداً سيفَ آلِ محمّدٍ","فراجَ كلِّ شديدةٍ مخشيهْ"],["DA73A9F9-7D68-5AAC-A418-4C495E4C049F","يوماهُ يومٌ للمواهبِ والجدا","خَضِلٌ ويومُ دمٍ وَخَطْفِ مَنِيَّهْ"],["04780495-8E20-5A20-AE1A-B0C75625671F","وقد أتيتكَ واثقاً بكَ عالماً","أنْ لستَ تَسْمَعُ مِدْحَةً بِنَسِيَّهْ"]]},"AADFE785-2900-5DD9-8336-27FF0F49C6E7":{"t":"رِجْلُ زيدِ بْنِ عُمَارَهْ","p":94,"s":"رجل زيد بن عماره","r":"438085","v":[["B01BDA09-F793-56FF-851C-37478787F0C9","رِجْلُ زيدِ بْنِ عُمَارَهْ","مثلُ مِفْتاحِ مَنَارَهْ"]]},"1674A44E-27CF-57D5-8498-21D97F93F3F3":{"t":"سبعَ جوزاتٍ وتينهْ","p":94,"s":"سبع جوزات وتينه","r":"438113","v":[["2581010F-CD1F-5CEC-96AC-9E6FD2A9F2CA","سبعَ جوزاتٍ وتينهْ","فَتَحُوا بَابَ المدينَهْ"],["5486BECC-BB8D-5E3B-9A60-43E4252D3243","إنَّ بشارَ بنَ بردٍ","تيسٌ أعمى في سفينهْ"]]},"C8046324-0B6C-50E0-8619-67252F3A44AC":{"t":"شفِيعي إل مُوسَى سَمَاحُ يَمِينِهِ","p":94,"s":"شفيعي إل موسى سماح يمينه","r":"438068","v":[["F2937821-4DC6-5CF7-884A-7408AC5D7AA4","شفِيعي إل مُوسَى سَمَاحُ يَمِينِهِ","وَحَسْبُ إمرِئٍ مِنْ شَافِعٍ بِسَمَاحِ"],["68AC4600-1A60-53CA-B771-88DEE1C65E34","وشعريَ شعرٌ يشتهي الناسُ أكلهُ","كما يشتهى زبدٌ بزبِّ رباحِ"]]},"6ACC87AC-E826-5F90-BF0F-3615BD3447AE":{"t":"صلابةُ الوَجْهِ سلاحُ الفَتَى","p":94,"s":"صلابة الوجه سلاح الفتى","r":"438095","v":[["D5C3F808-41A7-5857-8932-8F28FB5D2CD1","صلابةُ الوَجْهِ سلاحُ الفَتَى","ورقةُ الوجهِ منَ الحرفةِ"],["0012DE65-5469-52D9-8638-C3E7F91DFCCC","من كان صُلْباً وَجْهُهُ مُحْكَماً","فأنتَ منهُ الدهرَ في طرفةِ"]]},"928BDCD6-FC13-53AE-9325-F4C0B318767D":{"t":"ضيعَ ماورثهُ راشدٌ","p":94,"s":"ضيع ماورثه راشد","r":"438096","v":[["071F3ECE-4716-5FB9-A456-18221645409A","ضيعَ ماورثهُ راشدٌ","مِنْ كِيلَةِ الأكداسِ في صفِّهِ"],["38A33F0F-5DF6-5F11-94CB-873C3A5D6F9C","فربَّ كَدْسٍ قد علا رمسَه","كالديك إذ يعلوعلى رفهِ"]]},"515095AF-091D-52EC-B9AB-5ED5F993DC0C":{"t":"عاد الشمقمقُ في الخسارهْ","p":94,"s":"عاد الشمقمق في الخساره","r":"438083","v":[["F11D5E3D-5BC6-5FF3-B3A4-F0AE9E626394","عاد الشمقمقُ في الخسارهْ","وَصَبَا وَحَنَّ إلى زُرَارَهْ"],["9009A7E8-FC66-55DF-B62F-C791D1786D18","من بعدِ ماقيلَ أرعوى","وَصَحَا لأبوابِ الشَّطارَهْ"],["A361B938-DA78-5325-8639-ECEED325C050","مِنْ قهوةٍ مِسْكيَّةٍ","واللّونُ مثلُ الجُلَّناره"],["A6E93854-9CE7-5046-95C3-1E760EE9935B","تدعُ الحليمَ بلا نهى","حيرانَ ليسَ به إحارَه"],["60E46C36-E0B1-5293-A551-8224F0021262","ولربّما غَنَّى بِها","يا جارتا ما كنتِ جاره"],["557DC67D-97A3-518E-8977-114A5F676989","ياأيها الملكُ الذي","جَمَعَ الجَلاَلَةَ والوَقارهْ"],["82CA535E-B0B3-58D8-876A-DED4F20F9548","وَرِثَ المكارمَ صالحاً","والجودَ منه والعِمارَهْ"],["DA1FB153-8DB0-5080-8BD9-C44A1EB58A82","إني رأيتكَ في المنامِ","وعدتني منكَ الزيارهْ"],["8E88BEAA-C202-59A7-B2DA-3BD433F99710","فغدوتُ نحوكَ قاصداً","وعليكَ تَصْديقُ العِبَارَهْ"],["6B7B0093-FFC8-577C-A363-27FA092022BB","أنِّي أتاني بالنّدى","والجودِ منك إلى البِشارهْ"],["DBA8FA36-3BB7-54DB-881C-97A6A81D6BE2","إنَّ العِيَالَ تركتُهُمْ","بالمِصْرِ خبزُهُمُ العُصارهْ"],["707DFB65-0DE9-5F1D-B743-80F569511FC9","وشرابهمْ بولُ الحمارِ","رِ مِزَاجُهُ بَوْلُ الحِمارهْ"],["F6F5FAC1-F93F-573B-AF3D-733A2A23DE22","ضجوا فقلتُ تصبروا","فالنجعُ يقرن بالصبارهْ"],["09764AE4-8881-5295-AD1A-C42895B08328","حتى أزورَ الهاشمـ","أخا الغضارة والنضارهْ"],["A79F86DE-76F1-5E5C-B182-C4E1D9AACB3A","ولقد غدوتُ وليسَ لي","إلا مديحكَ منْ تجارهْ"]]},"2BEA2997-00AB-528D-9C2F-7979D954A92E":{"t":"قافية الزّايما جَمَعَ النّاسُ لِدُنْيَاهُمُ","p":94,"s":"قافية الزايما جمع الناس لدنياهم","r":"438089","v":[["83652B92-FA64-5CB1-AAE7-AE1A1088B119","قافية الزّايما جَمَعَ النّاسُ لِدُنْيَاهُمُ","أنفعَ في البيتِ من الخبزِ"],["F44EE12D-9939-5F9C-9933-E85772259F83","والخبزُ باللَّحمِ إذا نِلْتَهُ","فأنتَ في أمْنٍ مِنَ التَّرْزِ"],["5CBC712E-9760-5C6C-B2FD-13DB1ADD6D30","والقلزُ من بعدُ على إثرهِ","فإنَّما اللَّذاتُ في القَلْزِ"],["8BBEFA2C-B919-54D8-968E-DA9B126B5FA1","وقد دنا الفِطْرُ وصبيانُنَا","ليسوا بذي تَمْرٍ ولا أرْزِ"],["0E4E36E1-0E4D-54EE-998C-5557F724BF07","وذاكَ أنذّ الدهرَ عاداهمُ","عداوةَ الشاهينِ للوزِّ"],["EF0996C6-99E1-50E4-A422-F3AC108E1804","كانتْ لهم عنزٌ فأودي بها","وأجدبوا منْ لبنِ العنزِ"],["52C92C50-BEB4-5688-BA2B-BEC9DB873601","فلو رأوا خبزاً على شاهقٍ","لأسرعوا للخبزِ بالجمزِ"],["9F0B56A8-91C5-551F-92BE-215C0EE09B1D","ولو أطاقوا القفزَ ما فاتهمْ","وكيفَ للجَائِعِ بالقَفْزِ"]]},"A3A91D7C-3623-5511-8C63-72A3675D7552":{"t":"قالَ لي الناسُ زرْ سعيدَ بنَ سلمٍ","p":94,"s":"قال لي الناس زر سعيد بن سلم","r":"438071","v":[["A84098E7-5510-5762-9319-961FADC60A5C","قالَ لي الناسُ زرْ سعيدَ بنَ سلمٍ","قلتُ للناسِ: لاأزورُ سعيدا"],["F28FE086-3937-5BBB-82A4-FD37F164F21C","وأميري فتى خزاعةَ بالصرةِ","قد عمها سماحاً وجودا"],["FAF015B2-44E0-5F7A-820C-6DE0FD63685A","ولنعمَ الفتى سعيدٌ ولكنْ","مالكٌ أكرمُ البريةِ عودا"]]},"E8415063-E544-569D-9070-779C36FB98B3":{"t":"قد مَرَرْنا بمالكٍ فَوَجَدْنا","p":94,"s":"قد مررنا بمالك فوجدنا","r":"438110","v":[["47CDD127-6387-5E1F-9188-AF36F41752EF","قد مَرَرْنا بمالكٍ فَوَجَدْنا","جواداً إلى المكارمِ ينمي"],["05A4A3C9-CE33-5750-AAC6-BD4E014A3C97","مايبالي أتاهُ ضيفٌ مخفٌّ","أمْ أتَتْهُ يَأْجُوجُ مِنْ خَلْفِ رَدْمِ"],["54D33351-63E8-5904-B86E-1C2491178505","فَانْتَهَيْنَا إلى سَعيد بن سَلْمٍ","فإذا ضيفهُ من الجوعِ يرمي"],["2E887E3C-D993-561E-AF85-1AA6425F77E0","وإذا خبزهُ عليهِ سيكفيكهمُ","اللهُ ما بدا ضوءُ نجمِ"],["0B647CC3-DFC6-5BFA-ACF4-EC39D37473C6","وإذا خاتمُ النبيِّ سليمانَ","بن داوودَ قد علاهُ بختمِ"],["5B01A573-AAD9-5681-BE63-4930EDC4FBA9","فارْتَحَلْنَا مِنْ عندِ هذا بِحَمْدٍ","وارْتَحَلْنَا مِنْ عندِ هذا بِذَمِّ"]]},"6F4D7BF7-197C-5EE1-87E4-C4BC43243EDC":{"t":"كنتَ الممزقَ مرةً","p":94,"s":"كنت الممزق مرة","r":"438097","v":[["0091B585-72A5-59B7-950D-B687D7B2936A","كنتَ الممزقَ مرةً","فاليوم قد صرتَ الممزقْ"],["8987FB75-0165-541A-BF5C-1633144DC37B","لمّا جَرَيْتَ مع الضِّلالِ","غرقتَ في بحرِ الشمقمقْ"]]},"AECAFB6C-5B0B-5D9E-BD34-04286AEA59A5":{"t":"لشتانَ مابينَ اليزيدينِ في الندى","p":94,"s":"لشتان مابين اليزيدين في الندى","r":"438073","v":[["A3915DDD-0FB2-5B0F-80AF-23288688056A","لشتانَ مابينَ اليزيدينِ في الندى","إذا عدَّ في الناسِ المكارمُ والمجدُ"],["41830B6D-A447-5FC5-852A-168021A3DAF7","يزيدُ بني شَيْبَانَ لأَكْرَمُ مِنْهُما","وإنْ غضبتْ قيسُ بنُ عيلانَ والأزدُ"],["CD662CE4-6B02-513A-9363-88390E092580","فتى لم تلدهُ من رعينٍ قبيلةٌ","ولا لخمُ تنميهِ ولم تنمهِ نهدُ"],["2F2DE092-3BEA-52D2-BDAC-853247EEB2A0","ولكنْ نَمَتْهُ الغُرُّ من آلِ وائلٍ","وَبَرَّةُ تَنْمِيهِ وَمِنْ بَعْدِها هِنْدُ"]]},"76E2550F-BADA-5EB0-801F-C9D8BC3FF95C":{"t":"لما سألْتُكَ شَيْئاً","p":94,"s":"لما سألتك شيئا","r":"438115","v":[["FD0C1C76-01E9-525D-AB63-E65BDD649E99","لما سألْتُكَ شَيْئاً","أبدلتَ رُشْداً بِغَيِّ"],["6E99E59D-D8A8-56B1-B7F1-4DD2D493EF9F","مِمَّنْ تَعَلَّمْتَ هذا","أنْ لاتجودَ بشيِّ"],["73785070-53E3-5364-AEF2-5367B2E10C26","أمَا مَرَرْتَ بِعَبْدٍ","لِعَبْدِ حاتِمِ طَيِّ"]]},"90884187-838B-53B6-A690-F4FD9528F225":{"t":"لو ركبت البحار","p":94,"s":"لو ركبت البحار","r":"438067","v":[["381A7901-988A-54E0-9112-050F67E47C84","لو ركبت البحار صارت فجاجا","لا ترى في متونها أمواجا"],["33811C05-1C0E-51C5-BC23-A2A99F5F5C41","ولو أني وضعتُ ياقوتةً","حمراءَ في راحتي لصارتْ زجاجا"],["D2216975-8130-546C-BD66-F94083F27327","ولو أني وردتُ عذباً فراتاً","عادَ لا شكَّ فيه مِلْحاً أُجاجَا"],["40E64A5C-D786-5B96-AC78-1EC3C979B15E","فإلى الله أشْتكي وإلى الفَضْـ","ـلِ فقد أَصْبَحَتْ بُزَاتِي دَجاجَا"]]},"C744A486-398F-557A-9648-997512AEF8EA":{"t":"لو قد رأيتَ سريري كنتَ ترحمني","p":94,"s":"لو قد رأيت سريري كنت ترحمني","r":"438091","v":[["8A074E39-94C9-58DB-A980-AAD921F23882","لو قد رأيتَ سريري كنتَ ترحمني","اللَّهُ يَعْلم ما لِي فيه تَلْبِيسُ"],["B523E3F6-0C5C-55D1-BD95-7778FAD59E31","واللّه يَعلم ما لِي فيه شابكةٌ","إلاّ الحَصيرة والأطْمار والدِّيسُ"]]},"85B95B83-D28C-5725-9C3C-6F1F01EC58B7":{"t":"لولا ابنُ مَنْصُورٍ وإفضالُهُ","p":94,"s":"لولا ابن منصور وإفضاله","r":"438077","v":[["4049EF25-42EE-570F-88F7-ED12C1CC5D09","لولا ابنُ مَنْصُورٍ وإفضالُهُ","سلحتُ في لحيةِ منصورِ"]]},"A54DDCB6-FED6-5E89-B8CA-2E194335CAE1":{"t":"ليسَ فيها مروءةٌ لشريفٍ","p":94,"s":"ليس فيها مروءة لشريف","r":"438111","v":[["644478F8-EC82-579F-B8BA-AE2FE30B0D4A","ليسَ فيها مروءةٌ لشريفٍ","غيرَ هذا القناعِ بالطيلسانِ"],["29D77BB2-77CA-597F-B049-F27A5DB17807","وبقينا في عصبةٍ منْ قريشٍ","يشتهونَ المديحَ بالمجانِ"]]},"4300D25E-E604-5134-8D12-2BD0DD70ED6F":{"t":"لِحْيَةُ مروانَ تَقِي عَنْبَرا","p":94,"s":"لحية مروان تقي عنبرا","r":"438081","v":[["B59E1097-ADBB-5B44-91C6-856FA7E3A47D","لِحْيَةُ مروانَ تَقِي عَنْبَرا","خالطَ مسكاً خالصاً أذفرا"],["A3453F7E-999A-50DE-AA9F-AED43F384064","فما يُقيمانِ بها ساعةً","إلاَّ يعودانِ جميعاً خرا"]]},"1E0E3782-DF0F-5B22-8EDF-CD6AC2F26AE4":{"t":"ما كانَ مندقُّ اللّواءِ لِرِيبَةٍ","p":94,"s":"ما كان مندق اللواء لريبة","r":"438105","v":[["AA9373CF-C9AE-5A22-B3ED-F7BD5F4A3141","ما كانَ مندقُّ اللّواءِ لِرِيبَةٍ","تُخْشَى ولا سوءٍ يكونُ مُعَجَّلا"],["484B533C-3F02-50C4-9C60-59FB4E17224E","لكنَّ هذا الرمحَ أضعفَ متنهُ","صِغَرُ الوِلاَيَةِ فاستقلَّ المُوصِلا"]]},"31B51A23-AA2C-5A0D-B450-6A923F12C097":{"t":"ما كنتُ أحسبُ أنَّ الخبزَ فاكهةٌ","p":94,"s":"ما كنت أحسب أن الخبز فاكهة","r":"438078","v":[["95F2BAE4-2180-5F9C-A651-D3840F310F61","ما كنتُ أحسبُ أنَّ الخبزَ فاكهةٌ","حتى نَزَلْتُ على أرضِ بن منصورِ"],["0726D9F8-2E8B-55EC-9B06-C4F1D53BD0E5","الحابسِ الروث في أعفاجِ بغلتهِ","خوفاً على الحبِّ من لقطِ العصافيرِ"],["68E696DC-7048-57F5-AF20-E0E49F82C113","يبسُ اليدينِ فما يستطعُ بسطهما","كأنَّ كفيهِ شدا بالمساميرِ"],["27615BC9-DCF1-5173-8B5E-AE0E0C9A5C9E","عَهْدِي بهِ آنِفا في مَرْبَطٍ لَهُمُ","يُكَسْكِسُ الرَّوْثَ عن نَقْرِ العصافيرِ"]]},"23589E73-7ACC-5552-92ED-0B37F64C5292":{"t":"ماأراني إلا سأتركُ بغدادَ","p":94,"s":"ماأراني إلا سأترك بغداد","r":"438090","v":[["B3841866-C040-5A24-AD2A-F4ECAD55D1E3","ماأراني إلا سأتركُ بغدادَ","وأهوي لكورةِ الأهوازِ"],["704F94C6-1CD6-5096-B257-6CE907F06F6E","حيثُ لاتنكرُ المعازفُ واللهوُ","وشربُ الفتى من التقمازِ"],["FBCE1DD0-717F-5ECB-B1BF-0A3E6EDC2D44","وجوارٍ كأنهنَّ نجومُ اللّـ","ـيلِ زهرٌ مثلُ الظِّبَاءِ الجَوَازِي"],["6148C456-C381-57C2-80C7-0DC35258800A","واضحاتُ الخدودِ أدمٌ وَبِيضٌ","فاتناتٌ ميلٌ منَ الأعجازِ"],["3A696537-ABEE-5909-9497-BB3F00CEC07B","بينَ عوادةٍ وأخرى بصنجٍ","في بساتينها وفي الأحوازِ"],["80A5F739-B94E-5740-8384-8B5E843B172C","ذاكَ خيرٌ منَ الترددِ في بغدادَ","تنزو بي البغالُ النوازي"],["5F876D66-C1D5-5191-B792-3B3F10B1DC24","كلَّ يومٍ في كمةٍ وقميصٍ","وَرِدَاءٍ من الغُبَارِ طرازِي"],["90923EEE-A168-5AB1-B2E4-8BF8432A5397","لم يحكمهُ النساجُ يوماً لبيعٍ","لا ولا يُشترَى من البَزَّازِ"],["54F46FE5-2E2E-5A22-94B1-050C8610059C","أَخَذَتْ أهلَها الشياطينُ","بالركضِ لطولِ الشقاءِ والإعوازِ"],["7B7BA7E4-B7FC-5260-9CC8-4834FC2DC7D6","كلُّ شيخ تخاله حين يبدو","فوق بِرْذَوْنِهِ كشخصٍ حجازي"],["9FA717DD-9D04-59F7-9D29-9D1A66619412","وجميلُ الفُسَيْلِ أعْنِي ابنَ مَحْفُو","عدوُّ الندى وسلمُ المخازي"],["A4B68F85-1666-505C-94B9-DE5FDFBA2179","ألِفَتْ إستُهُ الفَيَاشِلَ حتى","ما تشكى للطعنِ بالعكازِ"],["252F66DA-B1DE-554A-974C-0F7D6D04CDDC","يأخذ الأسْوَدَ الذي يفرق الحـ","منهُ كدستجِ المنخازِ"],["7C322824-9339-583E-893B-A7353CE41B78","ليثُ غابٍ بِدُبْرِهِ حين يَلْقَى","وَجَبَانٌ في الحربِ يومَ البرازِ"],["F92BDE40-D8E7-51C0-B67C-82995F5B3671","بعدتْ دارهُ فلا ردهُ اللهُ","ولا زالَ نائيَ الدارِ شازي"],["B244F192-77CD-5E4E-B124-470046F33C5C","ذاكَ شخصٌ به عليَّ هوانٌ","كهوانِ الخصى على الخبازِ"]]},"66B715F2-B469-517D-9B2B-46E002C915C4":{"t":"منايَ من دنيايَ هاتي التي","p":94,"s":"مناي من دنياي هاتي التي","r":"438080","v":[["BC1BAFEC-36F3-53CF-9E96-EC086D9A88A3","منايَ من دنيايَ هاتي التي","تسلحُ بالرزقِ على غيري"],["D9135890-6F0A-5A64-94B6-F7538BCAA6B5","الجَرْدقُ الحاضِرُ مع بُضْعَةٍ","من ماعزٍ رخيصٍ ومن طيرِ"],["7C4105BC-356D-5082-9AF4-4D7CDC1129F8","وجرةٌ تهدرُ ملآنةً","تحكي قراة القسِّ في الديرِ"],["C9D24F56-0B75-509C-A136-7EDB657D43A5","وَجُبَّةٌ دَكْنَاءُ فَضْفَاضَةٌ","وَطيلسانٌ حَسَنُ النَّيْرِ"],["CAA68525-9820-5E1B-860C-5D9DB17C97A6","وبغلةٌ شهباءُ طيارةٌ","تطوي ليَ البلدانَ في السيرِ"],["0A5252EA-10F9-565E-B387-C4F4180E9B03","وَبَدْرَةٌ مملوءَةٌ عَسْجَداً","ما بالذي أذْكُرُ من ضَيْرِ"],["EF30AD6C-18D7-5324-9B0F-87B2BEE0F096","ومنزلٌ في خيرِ ماجيرةٍ","قد عرفوا بالخيرِ والميرِ"],["799330CD-08B6-5F05-90E3-1E056ED2CED5","وصاحبٌ يلزمني دهرهُ","مثلَ لُزومِ الكيسِ للسَّيْرِ"],["FAEE41FF-451C-5063-A7B6-C1FB8D211604","مساعدٌ يقعجبني فهمهُ","مرتفعُ الهمةِ في الخيرِ"],["1AD1BEE9-F0C1-57FC-B95E-F347B6D92083","كم منْ فتى تبصرُ ذا هيئةٍ","أبلدُ في المجلسِ منْ عيرِ"]]},"6AF2853E-B1E5-52D0-82A0-F411EAB2D506":{"t":"نزلَ الفأرُ بيتي","p":94,"s":"نزل الفأر بيتي","r":"438098","v":[["1F37FCCB-7ED9-5090-B164-9CFDB2FF18D3","نزلَ الفأرُ بيتي","رفقةً منْ بعد رفقهْ"],["157BA2A8-E8F0-57B2-811F-B0E48FB58EF9","حلقاً بعد قطارٍ","نزلوا بالبيتِ صفقهْ"],["725CA101-083D-5599-8F93-25DA71CD5BB2","ابن عرس رأس بيتي","صاعداً في رأس نَبْقَهْ"],["5AD37462-55B3-56E2-8A6D-99CD9DE3C051","سيفهُ سيفٌ حديدٌ","شقهُ من ضلعِ سلقهْ"],["A3DB3566-50E7-5F74-B1B2-876C10D8934B","جاءنا يطرقُ بالليلِ","فدقَّ البابَ دقهْ"],["E18E7956-CE63-503B-8845-29D76FFB81BF","دخل البيتَ جِهَاراً","لم يدعْ في البيت فلقهْ"],["6ED30237-AA6B-5900-9AC3-968DF3C1571E","وتترسْ برغيفٍ","وصفقْ نازويه صفقهْ"],["C25210FD-FE76-5C3B-A157-C0E7D1D0B843","صفقة أبصرتُ منها","في سوادِ العينِ زرقهْ"],["ACC3C82F-319B-5FF1-927D-DDFB964A7E03","زرقةً مثلَ ابنِ عِرْسٍ","أغبشٌ تَعْلُوهُ بُلْقَهْ"]]},"023EEB8A-0C85-555F-A6D4-6E1A9B8F2A93":{"t":"هللينهْ هللينهْ","p":94,"s":"هللينه هللينه","r":"438114","v":[["618BB71E-63B7-5496-8C6E-0E2EE64B4661","هللينهْ هللينهْ","طَعْنَ قِثَّاةٍ لِتِينَهْ"],["98456608-B1A1-53F9-ABE2-08399BF1A62F","إنَّ بشارَ بنَ بردٍ","تيسٌ أعمى في سفينهْ"]]},"576E3F0C-9CE0-5BA4-BA4E-87244357DD76":{"t":"هيهاتَ تَضْرِبُ في حديدٍ باردٍ","p":94,"s":"هيهات تضرب في حديد بارد","r":"438070","v":[["8D63C34A-B061-5BD7-9B68-63CB859450DE","هيهاتَ تَضْرِبُ في حديدٍ باردٍ","إنْ كنتَ تطمعُ في نوالِ سعيدِ"],["8AD24DF1-95E2-5B39-9079-B663E2A5110C","والله لو مَلَكَ البِحَارَ بِأَسْرِها","وأتاهُ سلمٌ في زمانِ مدودِ"],["DB8C2396-6A42-5214-AC1A-6796C4A05244","يَبْغِيهِ منها شَرْبَةً لطَهُورِهِ","لأبى وقالَ تيممنْ بصعيدِ"]]},"EA86E036-6914-5784-809F-1A1B07BEDBB3":{"t":"وأحببتُ من حبها الباخلينَ","p":94,"s":"وأحببت من حبها الباخلين","r":"438072","v":[["6CD54C91-E706-5DEC-B165-F313CD7B37D9","وأحببتُ من حبها الباخلينَ","حتى وَمِقْتُ کبنَ سلمٍ سَعِيدا"],["CBA491A4-0EEA-5995-A669-646B25F73EAB","إذا سيلَ عرفاً كسا وجههُ","ثياباً من اللُّؤمِ صُفْراً وَسُودا"]]},"75DD137A-3D7D-5CD4-BB28-8961BA80028F":{"t":"وإبطكَ قابضُ الأرواحِ يرمي","p":94,"s":"وإبطك قابض الأرواح يرمي","r":"438063","v":[["2F5CBB58-79BA-54EC-BE5A-2019ACB1F1C2","وإبطكَ قابضُ الأرواحِ يرمي","بسمِ الموتِ من تحتِ الثيابِ"],["85A6D6C4-2B4D-5E55-BD9C-67311A35CF6A","شرابكَ في السرابِ إذا عطشنا","وَخُبْزُكَ عند مُنْقَطَعِ التُّرابِ"],["885DF1FC-9223-5469-8737-8B57EF2B3689","رأيتُ الخبزَ عزَّ لديكَ حتى","حسبتُ الخبزَ في جوِّ السحابِ"],["0233713F-E287-51DE-9355-3DEAF1A0EBF4","وما رَوَّحْتَنَا لِتَذُبَّ عَنَّا","ولكنْ خفتَ مرزئةَ الذبابِ"]]},"3F8CF619-FC26-53C2-9447-1A28C9408A4E":{"t":"وإذا تجننَ شاعرٌ أو مفحمٌ","p":94,"s":"وإذا تجنن شاعر أو مفحم","r":"438112","v":[["A5D08677-D156-57EE-803A-F86E6335FA42","وإذا تجننَ شاعرٌ أو مفحمٌ","أسعطتهُ بمرارةِ الشيطانِ"]]},"8131F06B-F1CF-5EB6-A284-E08B4C02BB08":{"t":"ولقد قلتُ حين أجْحَرَني البَرْ","p":94,"s":"ولقد قلت حين أجحرني البر","r":"438109","v":[["D6561890-0D82-51F8-9486-92D65633BBB8","ولقد قلتُ حين أجْحَرَني البَرْ","كما تجحرُ الكلابُ ثعالهْ"],["B6990EA7-8760-59D7-B6FC-01E52B8CDD93","في بُيَيْتٍ من الغَضَارَةِ قَفْرٍ","ليسَ فيه إلاّ النوى والثخالهْ"],["BC142E70-69E6-5B44-B958-C57A7F74B2FE","عطلتهُ الجرذانُ منْ قلةِ الخيرِ","وطارَ الذُّبَابُ نحو زُبَالَهْ"],["50C6325E-BFC2-5F9C-AAC8-05E15037012E","هارباتٍ منهُ إلى كلِّ خصبٍ","جيدة لمْ يرتجينَ منهُ بلالهْ"],["72F34A73-AFC3-5801-961C-5FD9EF4333AA","وأقامَ السِّنَّوْرُ فيه بِشَرٍّ","يَسْألْ اللَّهَ ذا العُلا والجَلالَهْ"],["9896BE14-B666-59DB-AC97-A629939A9407","أنْ يرى فأرةً فلم يَرَ شَيْئاً","ناكساً رأسهُ لطولِ الملالهْ"],["323A07A4-DCA5-5BDC-A21F-4D3703D0E7B9","قلتُ لما رأيتهُ ناكسَ الرأسِ","كئيباً يمشي على شرِّ حالهْ"],["424F4BDA-5B12-5142-B294-BA20A27D8CDC","قلتُ صبراً يانازُ رأسَ السنانيرِ","نِيرِ، وعلّلْتُهُ بِحُسْنِ مَقَالَهْ"],["5711D182-E7BF-57C2-9039-AC4903B7EE14","قال: لا صبرَ لي وكيفَ مقامي","في قِفَارٍ كمثلِ بِيدِ تَبَالَهْ"],["FCB95BB8-A7EB-5C4D-B1F6-0F780F26B8D8","لاأرى فيه فأرةً أنغضُ الرأسَ","ومشيي في البيتِ مشيَ خيالهْ"],["B514E2FB-48EF-5904-B9DB-3A7EAF49B505","قلتُ: سرْ راشداً فخارَ لك اللهُ","ولاتعدُ كربجَ البقالهْ"],["26B47661-4D5B-50D9-BE62-D5777319C902","فإذا ماسمعتَ أنا بخيرٍ","في نعيمٍ منْ عيشةٍ ومنالهْ"],["D4C59FBB-A573-5BAF-9651-640535E578B5","فَائِتْنَا راشداً ولا تَعْدُوَنَّا","إنَّ مَنْ جَازَ رَحْلَنَا في ضَلالَهْ"],["E21F3A02-880A-5FBD-8466-C909D14FC262","قال لي قولةً عليكَ سلامٌ","غيرَ لعبٍ منه ولابطالهْ"],["7A6808B8-D887-5A2F-BAD6-C562ABD895AA","ثمَّ ولَّى كأنَّهُ شيخُ سَوءٍ","أخرجوه من محبسٍ بكفالهْ"]]},"24DA1871-4E81-585E-9C7B-C0DEED0BF89A":{"t":"ولقد قلتُ حينَ أقْفَرَ بَيْتِي","p":94,"s":"ولقد قلت حين أقفر بيتي","r":"438084","v":[["EC857186-F06F-5460-A00C-E3F754EF7456","ولقد قلتُ حينَ أقْفَرَ بَيْتِي","من جِرَابِ الدَّقِيقِ والفَخَّارَه"],["2A64912B-F9B2-5A51-8D21-FF7BE07C2490","ولقد كان آهِلاً غَيرَ قَفْرٍ","مُخْصباً خَيْرُه كثيرَ العِمَارَهْ"],["0DB4DFE0-E87D-5582-9B39-9086ECA986C1","فأرى الفأرَ قد تجنبنَ بيتي","عائذاتٍ منهُ بدارِ الإمارَه"],["29AA7B9B-0C98-59FE-BB8F-098CA982AF1B","ودعا بالرحيلِ ذبان بيتي","بينَ مَقْصُوصَةٍ إلى طيَّاره"],["DBE8AFC4-0185-589B-A1A0-92E259691F93","وأقامَ السِّنَّوْرُ في البيتِ حَوْلا","ما يَرَى في جوانبِ البَيْتِ فارَه"],["15B0F98C-0D63-5306-86BC-D111332B3232","يُنغِضُ الرَّأْسَ منه من شِدَّةِ الجُو","وعيشٍ فيه أذى ومراره"],["743B683B-48B1-5BE0-9AFB-F78D342A3595","قلتُ لما رأيته ناكسَ الرأسِ","كئيباً في الجوفِ منه حراره"],["7A3CC486-4DF4-5226-9BDB-60D47F7CA0C9","ويكَ صبراً فأنتَ من خير سنورٍ","ـورٍ رأتْهُ عينايَ قَطُّ بِحَارِه"],["BD5ECA7B-BAAA-5801-9D6A-121FF78D91EB","قال: لاصبرَ لي وكيفَ مقامي","ببيوتٍ قفرٍ كجوفِ الحماره"],["37102080-EC73-5591-A56E-FD0DE007554C","قلتُ: سرْ راشداً إلى بيت جارٍ","مُخْصِبٍ رَحْلُهُ عظيمِ التِّجاره"],["30B810BB-CE39-5037-A653-CCDF8635C243","وإذا العنكبوتُ تَغْزِلُ في دَنِّي","وحُبِّي والكوزِ والقَرْقَارَه"],["1B9B5832-36FC-5B4F-98C5-E158E4858903","وأصابَ الجُحَامُ كلبي فأضْحى","بين كلبٍ وكلبةٍ عياره"]]},"B5545495-A4F4-5B42-A944-8C6D59DFE41C":{"t":"وله لحيةُ تيسٍ","p":94,"s":"وله لحية تيس","r":"438076","v":[["00EED71A-D75F-539E-AB9C-4FE83C6982D5","وَلَهُ لحيَةُ تَيسٍ","وَلَهُ مِنقارُ نَسرِ"],["30CD5B8F-FE8B-5666-A9A2-7596BEF3A46E","وَلَهُ نَكهَةُ لَيثٍ","خالَطَت نَكهَةَ صَقرِ"]]},"C33102E9-2697-5840-BB2F-233E34ACC146":{"t":"وليس على بابِ بن ادريسَ حاجبٌ","p":94,"s":"وليس على باب بن ادريس حاجب","r":"438100","v":[["886F5C6A-869F-5F5E-B963-0031E86B927C","وليس على بابِ بن ادريسَ حاجبٌ","وليس على باب بن إدريسَ من قفلِ"],["2282FAA5-962C-5745-B565-83C76BCEBFBA","طربتُ إلى معروفهِ فطلبتهُ","كما طَرِبَتْ زَنْجُ الحجازِ إلى الطَّبْلِ"]]},"69E77CF3-0D86-5678-89E3-13630308CB41":{"t":"ومحتجبٍ والناسُ لا يقربونه","p":94,"s":"ومحتجب والناس لا يقربونه","r":"438065","v":[["E8C01FE7-0F78-53D6-8CFB-7A423BDBC2F4","ومحتجبٍ والناسُ لا يقربونه","وقد ماتَ هزلاً منْ ورا البابِ حاجبهْ"],["F859F34F-0279-5C16-8464-C142478E86C5","إذا قيلَ: منْ ذا مقبلاً؟ قيل: لا حدٌ","و إن قيلَ: منْ ذا خلفهُ؟ قيلَ؛ كاتبهْ"]]},"2A8FA2CB-D6D7-51F4-A13B-D780D07F7843":{"t":"وهذا جميلٌ على بغلهِ","p":94,"s":"وهذا جميل على بغله","r":"438107","v":[["46568230-74A7-53B6-86B9-BAED7F159FC1","وهذا جميلٌ على بغلهِ","وقد كان يعدو على رجلهِ"],["87F88784-BA85-5CF4-B1FA-A79A8F97B3B3","يروحُ ويغدو كأيْ الحمارِ","ويرجِعُ صِفراً إلى أهلِهِ"],["C71DD74E-40B0-5792-BD09-82E579C17808","وقد زعموا أنهُ كافرٌ","وأنَّ التَّزَنْدُقَ من شَكْلِهِ"],["CDD402BB-72CD-5EC5-8CEA-5D7FD7016E31","كأني بهِ دعاهُ الأمامُ","وآذنَ ربُّكَ في قَتْلِهِ"]]},"528A0602-F765-50A8-BFC9-65125D7AD24C":{"t":"يا رازقَ الكلبِ والخَنزيرِ في سَعَةٍ","p":94,"s":"يا رازق الكلب والخنزير في سعة","r":"438117","v":[["5E14E073-3275-5B0E-969E-4A6E82FE70B3","يا رازقَ الكلبِ والخَنزيرِ في سَعَةٍ","والطَّيْرِ والوَحْشِ في يهماءَ دوِّيَّهْ"],["9AE7F940-99FC-5738-A82E-41DBE07F532C","لوشئتَ صيرتهُ في حالِ فاقته","حتى تُقِرَّ بِتِلْكَ الحالِ عَيْنَيَّهْ"]]},"903613FF-468D-5E87-8932-1170BC903BDE":{"t":"يا طولَ يومي وطول لَيْلَتِيَهْ","p":94,"s":"يا طول يومي وطول ليلتيه","r":"438118","v":[["5F037043-40E4-5F94-A736-AE206EB048A3","يا طولَ يومي وطول لَيْلَتِيَهْ","إنّ البراغيثَ قد عبثنَ بيهْ"],["5DC05F0F-2013-5653-9235-CF80C83C6A1C","فيهنَّ بُرْغُوثَةٌ مُجَوَّعَةٌ","قد عقدَتْ بَنْدَها بِفَقْحَتِيَهْ"]]},"8503A5F7-1746-50DB-90E6-859CD79B0C35":{"t":"يا طولَ يومي وطولَ لَيْلَتِهِ","p":94,"s":"يا طول يومي وطول ليلته","r":"438066","v":[["629B20AB-AD88-51E7-83AD-55C679B93F6C","يا طولَ يومي وطولَ لَيْلَتِهِ","فَلْيَهْنَ بُرْغوثُهُ بِجَذْلَتِهِ"],["3476BC68-9693-5DAC-9D95-079C8BD39E7B","قد عَقَدتْ بَنْدَها عَلى جَسَدِي","واجتهدتْ في اقتسامِ جملتهِ"]]},"A65F83EC-2B83-5C4E-BF8C-375EB4C30DD4":{"t":"يا قومُ إنِّي رأيتُ الفِيلَ بَعْدَكُمُ","p":94,"s":"يا قوم إني رأيت الفيل بعدكم","r":"438102","v":[["A419309A-3569-595B-B663-7E12A5C5E692","يا قومُ إنِّي رأيتُ الفِيلَ بَعْدَكُمُ","فباركَ اللهُ لي رؤيةِ الفيلِ"],["1C98B8E1-631A-5BA4-822E-473A11BC4C77","رأيت بيتاً له شيءٌ يحركهُ","فكدتُ أصْنَعُ شَيْئاً في السَّرَاوِيلِ"]]},"98585883-1FFA-5978-B7D5-EC47B5E5B000":{"t":"يوسفُ الشّاعرُ فَرْخٌ","p":94,"s":"يوسف الشاعر فرخ","r":"438108","v":[["E1AB3ABB-6877-5DC7-8CEC-5CFAF88C3EC6","يوسفُ الشّاعرُ فَرْخٌ","وَجَدُوهُ بالأبُلَّهْ"],["164E7EF5-1FB8-5867-8215-F92B92535C33","حلقيٌّ قد تلقي","كامناً في جوفِ جلهْ"],["4FC00EAD-F941-55A0-805F-9524300D0D62","خَيَّطُوها خشْيَةَ الكَلْـ","عليهِ بمثلهْ"]]}}}