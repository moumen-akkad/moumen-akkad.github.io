{"v":1,"poems":{"1AEE1C60-6AB2-5CA4-932C-ED45EF1BBCFB":{"t":"يا مصر ما درت في وهمي ولا خلدي","p":173,"s":"يا مصر ما درت في وهمي ولا خلدي","r":"451986","v":[["71424681-2CD9-5DD4-A5EE-ADF98A93E13B","يا مصر ما درت في وهمي ولا خلدي","ولا أجَالَتْك خَلْواتِي بأفكاري"],["71B4F06D-F824-53E3-9290-8BE673FC5BA5","ما أنتِ أوّل أرضٍ مسَّ تُربتها","جسمي، ولا فِيكِ أوطاني وأوطارِي"],["743C3A5C-A174-5A6E-8DA3-33D478AB18EC","لكن إذا حمت الأقدار كان لها","قوىً تؤلف بين الماء والنار"]]},"D28987D3-8201-53E3-A6D4-00E2D51A7F9B":{"t":"يا ملولاً قلما ير","p":173,"s":"يا ملولا قلما ير","r":"451863","v":[["8F96F884-DBD9-5BB1-88ED-3DD6BBBB83E3","يا ملولاً قلما ير","عى لمن يهواه عهدا"],["8F0DAC3E-98F9-5359-8B79-82095A10618E","يا ظلوماً كلما اسـ","ـطَفْتُه تَاه وصَدَّا"],["4BF03EBE-FE6D-5027-A3B7-35FEA073203C","لم جعلت الهجر يا مو","لاي، قَبل البُعدُ بعدَا"],["BE0FFF8F-9841-52CD-BACB-082F56A609A3","ما أرى لي منك في حا","ل الرِّضا والسُّخِط بُدَّا"]]},"70340F1B-1107-5CA5-ABFB-F420A70AD4BA":{"t":"يا من مودته سحاب زائل","p":173,"s":"يا من مودته سحاب زائل","r":"451886","v":[["0A19A26C-8B21-5A0C-BAC0-55D05E4EAC67","يا من مودته سحاب زائل","وعُهودُه في الحُبِّ ظل قَالِصُ"],["4746DB9F-5C7F-54D6-9279-CC52B5533992","هل في القضية أن حبك زائد","أبداً وحظي كل يوم ناقص"],["975E82A7-A5AE-5063-AE37-51C8EC8BF7B1","وتشوبُ وُدَّكَ بالقطيعةِ والقِلَى","وهواكَ من كلِّ الشِّوائِبِ خَالصُ"]]},"C11F8DF9-1A9E-5A98-947A-6BE1833CAB66":{"t":"يا من هواه على التنا","p":173,"s":"يا من هواه على التنا","r":"452067","v":[["BF1A10DD-1959-54CD-B444-8C5696C4BA88","يا من هواه على التنا","ئي والتداني في ازدياد"],["19B9BDF4-AEEC-5CEA-AA59-25FA43C55917","أصبحت مغترباً لبعـ","ـدك، بين أهلي في بِلاَدِي"],["B4E05397-55B0-56D5-9169-C9E685E21E6C","مستوحشاً معَ كثرةِ الـ","ـخُلاَّنِ وحْشَةَ ذِي انْفراد"],["94687EDE-246B-5DA9-8303-E4AB03F600EA","وأقل ما لاقيت بعـ","ـدك من تباريح البعاد"],["96CCCFAE-334E-5ACA-B80B-15188C881018","شوق إليك أباح فيـ","ـض مدامعي وحمى رقادي"]]},"3ECD93B0-7757-5F1B-A292-355290874466":{"t":"يا من يهين المال في كسب العلا","p":173,"s":"يا من يهين المال في كسب العلا","r":"452139","v":[["83433EED-7C69-5D62-AF0C-123519C4297D","يا من يهين المال في كسب العلا","ويرى الثناء أجل ذخر يذخر"],["C0EA0E76-24A2-594A-BD6F-785434C7C71A","أغربت في بذل النوال وخاطب الـ","ـلياءِ ليسَ بضائعٍ ما يُمهِرُ"],["4949CD9E-DCA0-54AF-9FBB-B5649FA7F8A1","وسعيت للمجد الذي في مثله","إلاَّ عليكَ حُزونةٌ وَتوغُّرُ"],["2D17A377-5699-5B3F-9281-B04CD79368C1","وبذلتَ جودَك للعُفاةِ، فما لهم","وِردٌ سواه، وليس عنه مَصدَرُ"],["7025FD49-0EF4-5851-BA21-0C800FC929A2","كم من يد أوليتنيها أثمرت","عِندي، وما كلُّ الأَيادي تُثمرُ"],["D0D7C27D-2DCF-5D4F-BD2E-117341F5E9F1","وكرامة أبداً أبوح بشكرها","إن الكريم على الكرامة يشكر"],["83133342-1AF3-5477-98BE-A0B0D09A3947","والشكرُ من مثلي يَزينُ، وإنّما","بِثَناءِ من يُثَنى عليه يُفْخَرُ"],["4BBD6B4A-40B8-5770-BD5C-B22A8CF621C5","وصنائِعُ المعروفِ كالوسمِيِّ: ذَا","مَن قَطره نبتٌ، وهذا جوهَرُ"]]},"0C276AE6-58A5-5329-9C9A-54CDF94015D0":{"t":"يا منتهى الأمل امتدت مطارحه","p":173,"s":"يا منتهى الأمل امتدت مطارحه","r":"452133","v":[["C001DD47-1C2F-5EBA-B1F6-A25DF9501C05","يا منتهى الأمل امتدت مطارحه","ويا حمى من إليه في الخطوب لجا"],["CB763CE8-FB76-571B-B270-9CF1959C5511","هَذي نتيجةُ فِكرٍ كان في الزَّمنِ الـ","ـماضي عقيماً ولولا أنت ما نتجا"],["3538F982-F39D-5DAE-8478-091CAB679ECB","أَتَتْكَ تَحمِلُ شكراً لوقرنتَ به","لَطِيمَةً لاكتَسَتْ من نَشرِه أَرَجَا"]]},"2A08D133-CAF2-570B-ADCA-EA1501B095F3":{"t":"يا موعدي بالوصل وعداً لا يرى","p":173,"s":"يا موعدي بالوصل وعدا لا يرى","r":"451892","v":[["4558F0FA-2898-54A6-A47B-3D9A1607870B","يا موعدي بالوصل وعداً لا يرى","فيه المَؤمِّلُ للَّتقاضِى مَوضِعَا"],["1C468D74-CE8E-5766-89F7-342C33328463","أصبحتُ في حُبِّيْكَ كالدَّاعِى الصَّدى","ما إنْ لَهُ حظٌّ سِوى أن يَسمَعَا"],["F15CA618-0DE6-58B2-A64E-B1DA2FAC4B32","لكن حظ هواك من جسمي ضنىً","بَادٍ، نَفَى نَومِى، وأَفْنَى الأدْمُعَا"]]},"2EEFBBE3-EFDE-58D6-AC07-B10F03204361":{"t":"يا مَن به سَلْوَتِي عن كلّ مفْتَقَدٍ","p":173,"s":"يا من به سلوتي عن كل مفتقد","r":"452058","v":[["D6B30984-5E95-5204-AA7A-66869C83F292","يا مَن به سَلْوَتِي عن كلّ مفْتَقَدٍ","ومَن مودَّتُه أدنَى من النَّسبِ"],["5F969D94-0C74-50CF-8A2C-4D7C26044862","شَكوتَ همَّك بي لما اشتكيت، فَلا","زلت الموقى من الآلام والنوب"],["5BFDE21B-D5FD-5FEC-856A-5D15AED148A5","أبل جسمي من أوصابه وأرى","قَلبِي مِن الهِمّ لا ينفَكُّ ذَا وَصبِ"],["520DD2BE-E2EF-5D91-9F6F-D72F08F2CEE1","وداؤه باطن لا طب يبلغه","إن لَمْ يُداركْه لطفُ غيرُ مُحتَسَبِ"],["42C61FE6-20D6-57DF-91D1-CBDA20F80193","وما الَّذي نَالَه من دائِه عَجبٌ","لكن سلامته من أعجب العجب"]]},"0BB69D9E-BD93-511D-B45D-7CDD48020BB4":{"t":"يا مُعرضاً راضياً وغَضبانَا","p":173,"s":"يا معرضا راضيا وغضبانا","r":"451942","v":[["D6E20945-0B52-5766-98CD-9F42D6206E1A","يا مُعرضاً، راضياً وغَضبانَا","وهاجِرِي هاجعاً ويقْظانَا"],["33E53516-20E2-56FD-9CA8-3F89088D32C2","صددت إما لهفوة فرطت","مِنّي، وإمّا ظُلماً وعُدوانَا"],["E283533D-CAA1-5DD2-817D-7137BFC29A59","طيفُك، ما بالُه يُهاجرني","مَنْ أَعلَم الطيفَ بالذّي كَانَا"]]},"66552462-B24D-5A08-942F-5849CA652624":{"t":"يا مُعِملَ الآمالِ دَعْ خُدَعَ المنى","p":173,"s":"يا معمل الآمال دع خدع المنى","r":"451855","v":[["A26C272B-3189-5745-BF3A-52F48F152A66","يا مُعِملَ الآمالِ، دَعْ خُدَعَ المنى","فاليأسُ ينقضُ كلَّ ما أبرَمنَه"],["501CD872-C798-5CB1-92AD-5367A80F2188","مرّض فؤادك بالسّلّو لعلّه","مُتَيَسرُ بَعدَ النَّوى إن رُمتَه"],["FE57A7DF-E68E-5EF6-800C-DED8266AD136","فمن الجهالة أن تُؤَمِّل وصلَهم","بَعد البِعاد، وفي الدُّنُوِّ حُرِمتَه"]]},"8D0078FC-35EF-57FE-9EB7-DA9738488E16":{"t":"يا مُنعِماً مَوْردُ إحسانِه","p":173,"s":"يا منعما مورد إحسانه","r":"452161","v":[["E3ABBFB3-C0F1-500E-A145-1B63269942FB","يا مُنعِماً، مَوْردُ إحسانِه","سهل فما في منه من"],["1E863C12-52F4-5815-9852-3E8F309A2A39","قد اقتدى بالمزن في جوده","بل بِنداهُ يَقتدي المزنُ"],["EE0A1503-DB12-5133-9F0A-C2E69C0255A2","بسطت كفاً في الندى والوغى","ما كفها بخل ولا جبن"],["597A0C37-DDE1-5A39-89B4-8C7C753C932F","فاسلَم من الدّهرِ، ففِيه على","كل كريم ماجد ضغن"]]},"B1E66259-05C1-5664-806B-39F17327EE4D":{"t":"يا مُنقِذي ويدُ الزّمان تَنُوشُني","p":173,"s":"يا منقذي ويد الزمان تنوشني","r":"452136","v":[["6671C77B-BC20-5E13-A919-6E91CF57C637","يا مُنقِذي، ويدُ الزّمان تَنُوشُني","ومقيل جدي وهو كاب عاثر"],["A6B38B95-863E-5E37-8033-4F98D5601A84","حتَّامَ أَنتَ لثِقلِ هَمِّي حَاملٌ","ولما يهيض الدهر مني جابر"],["457CAD79-A939-5CD3-9871-2277401E2090","ومقارع دوني الزمان وأهله","مستلئمين وأنت فذ حاسر"],["CE445C19-C841-5458-8049-755DDA5BE5EC","مهلاً، فِدًى لك مهجةٌ دافعتَ عن","حَوْبائِها، إذ ليسَ غيرَكَ نَاصرُ"],["13D252DF-349C-5483-AA7E-F2F877324F29","خفض عليك فللأمور نهاية","وإلى النهاية كل شيء صائر"]]},"9AAA8AF0-E408-583B-9178-CEFB80B3E725":{"t":"يا ناصرَ الدِّين يا بنَ الأكرمينَ ومَن","p":173,"s":"يا ناصر الدين يا بن الأكرمين ومن","r":"452105","v":[["23518071-C367-50BB-8A56-A4091C799F8D","يا ناصرَ الدِّين، يا بنَ الأكرمينَ، ومَن","يُغنى نَدى كفِّه عن وابلِ الدِّيم"],["C665AD51-9125-5437-A97B-9BFACFD4ED05","ومن حوى السبق في فضل وفي روع","وفي عفاف وفي دين وفي كرم"],["F325308D-52FF-511A-8B69-460FFD840417","أنت العيي على ما فيك من لسن","عن لا وأفصح خلق الله في نعم"],["E03886E5-F2B4-573E-9BFE-FC3F9D877EFF","تولى الجميل بلا من تكدره","لا كدر الله ما أولاك من نعم"],["21D047CA-FF81-54F7-A0C2-78ECAFDF6C20","هذا ابن عمك في أسر الفرنج له","حولٌ تجرَّم، في الأغَلاَلِ والظُّلَمِ"],["06B92053-9B6F-5856-B14C-00E1A531A0FF","يدعوك لا بل أنا الداعي نداك له","يا خير من علقته كف معتصم"],["3760D87C-001A-5529-9699-A293383D7222","وأنت أكرمُ مَن تَثنِيه عاطفةُ القُـ","ـربَى، ويرجوه للجُلَّى ذوو الرَّحمِ"],["6F403AF7-EB79-5504-84D8-445602481130","ومَن تكْن أنتَ مولاهُ وناصرَهُ","فكيف تسطو عليه كفُّ مهتضِمِ"],["FCD2BB86-8BF9-58DF-82D8-018384D169FD","لا تُحوِجَنِّي إلى منِّ الرجالِ، فما","حمل الأيادي وإن أعسرت من شيمي"],["B367977E-58B4-50AD-AAE4-0B47279332CA","ولا تظنَّنِي أدعو سِواك، ولا","يفوه مجتدياً إلا إليك فمي"],["81120CD6-40D2-5B03-A6F7-9375BB34D36F","علامَ أرتشف الرَّنْقَ الأُجَاجَ، وقد","رويت كل صد من بحرك الشبم"],["C6E1CE3B-CCCE-59EA-A0F1-AB58CCEFCB64","أنا ابن عمك فاجعلني بفك أخي","من أسره لك عبداً ما مشت قدمي"],["D5828A48-64A0-5038-9B96-258A979EF863","فملك مثلي لا يغلو بما بذل الـ","ـتَاعُ فيه، ولا يُستام بالقِيَمِ"]]},"24B931B2-9EFE-52E3-815A-B70C173D950F":{"t":"يا ناق شطت دراهم فحني","p":173,"s":"يا ناق شطت دراهم فحني","r":"452040","v":[["B115E698-7AAE-5C7E-B8AF-2C5DD90C1CED","يا ناق شطت دراهم فحني","وأعلني الوجد الذي تجني"],["E6A0047C-D811-5E48-83EC-93CA7D25E763","ما أرزمت وهناً لفقد إلفها","إلاَّ رَمتْ جَوارِحى بوَهْن"],["9E8018C5-C792-59F4-9456-C0C4789921E8","تذكَّرتْ أُلاَّفَها، فَهَيَّجَتْ","لاَعِجَ شَوقِي، وذَكَرْتُ خِدْنِي"],["93E170C3-F31C-5ACB-966E-29417BA40E2D","أبِكي اشتياقاً، وتَحِنُّ وحشةً","فَقد شَجانِي حُزنُها وحُزنِي"],["E5DC0776-A78A-5FE8-95E5-E41E11F4B2B1","حَسْبُكَ قَد طالَ الحنينُ والأَسَى","وما رأى طول الحنين يغني"],["D5EACF67-1E41-507E-8F60-2A66B2CA28DC","ولا تَملِّى مِنْ مَسيرٍ وَسُرىً","في مَهْمَهٍ سَهلٍ ووعْرٍ حَزْنِ"],["3AD206EB-F8F6-558E-8E6B-3EA01F8D7BCE","حتى تناخي تحت بانات الحمى","سقى الحمى والبان صوب المزن"],["4DD2F6FC-1EF3-5F0F-AB30-ED1AE0D784FD","أهوى الحمى وأهله وبانه","وإن نأيت وتناءوا عني"],["96C67D6F-E8C2-5EFC-880B-AC6610990CAC","شطوا وشطت بي داري عنهم","وهُم إلى قَلبَي أدنَى منِّي"],["F272C5BF-B7A1-5593-ABB2-2E0596700321","لم يذكروا لي قط إلا امتلات","بالدَّمعِ أجفانِي، وقَالتْ: قَطْنِي"],["D652DC20-0344-5B26-94EA-005C364D07C9","وهم أعز إن نأوا وإن دنوا","مما حوى خلبي وضم جفني"],["6FAF5F03-84DD-568E-A15E-1CA4B0713690","نَفسي فِداءُ من أَوَرِّى بالحِمَى","والبَانِ عن أسْمَائِهمْ وأَكْنِي"],["C9892435-AAEF-5D59-80A1-139DC7B39E62","هُمُ، إذا قُلتُ: سقَى أرضَ الحِمَى","وبَانَه صوبُ الحَيا، مَن أَعني"],["5382C591-8C09-530D-9BA0-C9F09FA00F1A","ضَنًّا بِهم عن أَن يطور ذكْرهُم","بمَسْمَعٍ، وَهُمْ مكانُ الضَّنِّ"],["4DE57A24-8A7A-5C9E-BE9E-F0D36876404F","أحببتهم من قبل ينجاب دجى","فودي عن الصبح ويذوي غصني"],["C1ACEC93-D1C3-5945-9AF4-77C19E29789C","حبًّا جَرَى مَجرى الحياةِ من دَمى","أصَمَّ عن كلِّ نَصيحٍ أُذنِى"],["5196D88F-1EB4-5EA0-931E-0A065808CD76","فلو تَعَّوّضتُ بهم عَصْرَ الصِّبَا","لبان في صفقة بيعي غبني"],["9F8B7BFC-B4FC-56FD-B51B-9E054B07AE7A","فَارقتُهم أشْغَفَ ما كنتُ بِهِم","وعدت قد أدمت بناني سني"],["C2D5BDC5-5E62-59AD-B0D8-ADE955B22F80","ألزم كفي فؤاداًً ماله","من بَعدِهم رَوْحٌ سوَى التمنّي"],["584C7266-92DC-5551-BF61-9BCEE5708519","لكنَّني أَدعُو لجمِع شَمْلِنا","مُسيِّرَ الشُّهبِ، ومُجرى السُّفْن"]]},"CF4629D2-E4BF-5996-9D52-BF17061725AC":{"t":"يا نفسُ أينَ جميلُ صبـ","p":173,"s":"يا نفس أين جميل صبـ","r":"452342","v":[["29406E46-D1E9-592F-938A-C13FC439ADE5","يا نفسُ، أينَ جميلُ صبـ","ـرِكِ حينَ تَطرقُكِ الخُطوبُ"],["CCFAC44F-38E3-57BB-9109-412D2E82AFD2","أين احتمالك ما تكا","د الراسيات له تذوب"],["88942345-97F5-5F75-9092-7231C32FDDEF","وثَباتُ جَأشِكِ حين تَضـ","ـطربُ الجَوانحُ والقُلُوبُ"],["22530FF8-E9CE-5C26-B926-2DD323B65F52","ماذا دَهَاكِ، إلى متى","هذا التّأسُّفُ والنَّحِيبُ"],["B66B1174-4003-5C5F-A222-6A276E4F0F85","كيف استَنزَلَّكِ بَعد صد","ق يقينك الأمل الكذوب"],["A6FFB505-59B2-522B-A96C-9D89E5707EB4","أرَجَوتِ أن سَيَرُدُّ من","غال الرّدى دَمعُ سَكُوبُ"],["51D303F8-5859-564F-A5AB-998BE8ADBBB3","أم خلت أن نوائب الد","نيا لغيرِكِ لا تَنوبُ"],["E5FCB2DB-FD0E-53F2-87DE-598224E8D086","هيهات كل الخلق من","نكباتِها لهمُ نَصيبُ"],["EA57BB99-682C-5D2D-9EC8-0ABE94192A4E","وبكلِّ قَلبٍ من حَوا","دثها وأسهمها ندوب"],["EE034265-EB2E-5133-AE08-DE875ECA0D8F","من ذا الذي ييقى على","مر الزمان له حبيب"],["0EC5C872-9C10-5E33-9493-3D302C40A9F5","لكن يُسلّى النَّفسَ أنّ","لَحَاقَنا بهمُ قَريبُ"],["94A1E6B6-CEC0-5516-94BA-9A3EE3954D4C","وإليهم من بعد غيـ","ـبتهم وإن طالت نئوب"]]},"F5922DA9-09C2-5CA4-B1DB-B0ED6F8DCC6C":{"t":"يا نَاسياً عشرةَ التَّصافِي","p":173,"s":"يا ناسيا عشرة التصافي","r":"451927","v":[["7D36075D-63D0-5A11-9276-A30C4EFFC669","يا نَاسياً عشرةَ التَّصافِي","وخَافراً حُرمةَ الذِّمَامِ"],["5AEA19AA-A71F-54B4-8E99-CA754FE3AE76","إلام أغتر بالأماني","فيك كمستمطر الجهام"],["F8EAC680-7B1C-54B5-B6BF-803CDD304BA8","كأنَّني، في الذَّي أُرجِّى","بلوغه منك في المنام"],["834EF9FB-6550-5259-9CBF-3AEBC3D83073","وطالبُ الوصلِ من مَلُولٍ","كَطالِب الماءِ في الضِّرام"]]},"407B1956-20BB-5688-A18F-ECE14C9536EB":{"t":"يا هلالاً إذا تبدى يراه الـ","p":173,"s":"يا هلالا إذا تبدى يراه الـ","r":"451945","v":[["7A79020C-24A3-5EE4-857A-8BB079CCF0CC","يا هلالاً إذا تبدى يراه الـ","وَرى لا يَملُّ رَاءُوهَ منْهُ"],["8D591F8D-F500-5AF1-803D-643BE238E760","وتَرانِي الهلالِ في كلِّ شهرٍ","ليلةً، ثُمَّ تُعرضُ العينُ عَنهُ"],["43BF2558-8CC9-54F8-A621-C5D7DF4E93F4","لم يَخُن عهدَكَ الذي لم يُطع فِيـ","ـكَ نَصيحاً، فلِمْ، فَداك، تَخُنْه"],["AF229AAD-F32F-534A-9831-DA09762208DF","كل حُسنٍ في الخَلقِ مُجتمِعُ فِيـ","ـك فبالله لا تشنه وصنه"],["D488ECBB-8594-5984-B691-BB09BBA97E91","إن تكُن ما رَأيْت من جمَعَ الإحـ","ـسانَ والحُسنَ في الملاحِ فكُنْهُ"]]},"1E2F74BF-CD3C-58CC-9B34-A14D68713194":{"t":"يابن الأُلَى جمعَ الفخارَ لِبيتهمْ","p":173,"s":"يابن الألى جمع الفخار لبيتهم","r":"452085","v":[["7E77F9C5-7C0E-5C63-8E8E-3BED06A6CEFA","يابن الأُلَى جمعَ الفخارَ لِبيتهمْ","ما شَتَّتُوهُ من العَطاءِ، وفرَّقُوا"],["672BA913-4217-5422-BB1A-6A4767227F97","وتملكوا رق الأكارم بالذي","فكوا به رق العناة وأطلقوا"],["4630AF2B-E3FB-5701-B769-8D05B0E262C7","أشكُو إلى عَلياك هَمًّا ضَاقَ عَن","كتمانه صدري وما هو ضيق"],["EB7429D7-F083-54E1-864D-BCE506C2E727","وطوارقاً للهم أقريها الكرى","وَتُلِظُّ بي صُبحاً، فما تَتفَرَّقُ"],["1BDACDDD-9E71-55FC-9AE7-BFA09760DB06","لو لم أُمَنّ النَّفسَ أنَّك كاشِفٌ","كُرباتِها عَنْها لكادتْ تَزهَقُ"],["11F55F9F-3F22-5323-80D7-F4BBFA048388","أَنا عائذٌ بك من عُقوقٍ مُحبطٍ","عملي فعصياني لأمرك موبق"],["3DBED7CD-2BD5-5472-990B-7CC536BB9811","لا تُلزِمَنّي بالهَوانِ وحَملهِ","إن احتمال الهون ثقل مرهق"],["F78D6321-9805-5C94-817D-163CBB35494F","دعني وقطع الأرض دون معاشر","كل علي لغير جرم محنق"],["E6BEEA55-2F53-5CA3-B197-B47F0E5970CE","تغلي علي صدورهم من غيظهم","فتكاد من غيظ علي تحرق"],["B0EAB020-5798-551B-A77D-FC9A3B4CCEF5","تَعشَى إذا نَظرُوا إلَّى عُيونُهم","حتى كأَنَّ الشَّمسَ دوني تُشرِقُ"],["3B875BDB-CC8A-5DFD-81CB-8129D58B3BB0","كَسَدَت علىَّ بَضائِعي فيهم، فَلاَ","أدبي ولا نسبي عليهم ينفق"],["25F9D313-4341-5DE1-A7B4-3F72C4F13534","أعيا علي رضاهم فيئست من","إدراكه ما النجم شيء يلحق"],["B132D899-8265-57B2-A81B-9FE9001B90DE","إن أغشهم قالوا خلوب ماذق","أَو أَجْفُهُم، قالُوا: عدوُّ أزرقُ"],["4AD066B8-61BD-50E2-8E83-92E20752AEFD","قد أَفسدُوا عَيشِي علّي، وعيشَهُم","فأنا الشقي بهم وبي أيضاً شقوا"],["E61468E6-AD6D-56D3-AAEF-71C4A2DFEC99","ألاَّ يُكدَّرَ بالهُمومِ، ويُمذَقُ","وعَسَى قلوبٌ أعضَلَتْ أدواؤُها"],["E6EB6156-FC87-53FB-9CFA-FDA2C3B24A83","فى قُربِنَا بعد التَّفرق تُفرِقُ","فضلُ الأقارِب بِرُّهُم وحُنُّوهُم"],["AE13FCA3-5D50-56C2-B0C5-E5BA5636DC39","فإذا جفوني فالأباعد أرفق","أتظنني أرجو عواطف ودهم"],["2CCD3148-AE47-55F6-8B73-DD2BAA76A72E","إنِّى إذاً عبدُ المطامعِ، أخْرقُ","بيني وبينهم هنات في الحشا"],["2195E4C6-8F54-55CF-B7B7-D6B27133D507","منها ندُوبٌ، ما بقيتُ وما بَقُوا","لا تغترر برجائهم أن يحسنوا"],["BB926208-08E3-5270-9FB6-C7530786686B","كم قد رأَينَا من رجاء يُخفقُ","خذ ما تراه ودع أحاديث المنى"],["A66B5242-0FAE-56F3-A28E-6631286FC958","إنَّ الأمانِي فيهمُ لا تُصدقُ","وأغث فإن السيل قد بلغ الزبى"],["1EFE81EC-1DFF-5777-AFCA-902FF9B29FA7","حقًّا، وأَدرِكْنىِ قُبيلَ أُمزَّقُ",""]]},"81814453-2BFB-5AE0-B72D-CEC970277C4D":{"t":"يقر بالذنب يجنيه فأحسبه","p":173,"s":"يقر بالذنب يجنيه فأحسبه","r":"451890","v":[["9F5D18A5-9B9E-5D84-AD2B-6F28E28B995D","يقر بالذنب يجنيه فأحسبه","قَد جاء مُستدرِكاً بالعُذر ما فَرَطَا"],["D7E3A4B3-5DF4-57CC-BE1D-40A56A8FCC5C","ولَيس يَقصِدُ إلاَّ أن يُعَرِّفَنى","أنّ الإساءةَ عَمدُ لم تكن غَلَطَا"]]},"1084CB76-7510-5166-B529-4592B7F1F87E":{"t":"يقولون: جارَ عليك المشيبُ","p":173,"s":"يقولون: جار عليك المشيب","r":"452288","v":[["F72758BB-A355-584D-951D-989BBEE0F075","يقولون: جارَ عليك المشيبُ","ومن ذا يجير إذا الشيب جارا"],["7BAF3188-76AB-5354-9972-FC991066CA0D","وما كنتُ مغتبطاً بالشَّباب","وهل كان إلا رداءً مُعارَا"],["430D22BB-15E8-5C58-9BBA-37DDB064E248","ولكنَّني ساءَني فَقدُه","فواهاً له، أيَّ همٍّ أثَارَا"],["13501120-1618-5510-B7E6-D4DD05781757","وما ساءني أن أحال الزمان","ليلي نهاراً وجهلي وقارا"],["B4871C90-8957-546A-88FD-DC17531B5718","ولكن يقولون: عصر الشباب","يكونُ لكلِّ سرورٍ قَرارَا"],["851A9821-B1B9-55C1-B758-FF520152A86D","وما زلتُ مُنذ تردّيتُهُ","كخابط ليل أعاني العثارا"],["170A0B4C-5BAA-50BF-A277-7626FB8EDFC4","أكابد دهراً يشيب الوليد","وهما يَشُبُّ بأحشايَ نَارَا"],["59B10E50-9F06-5211-BD86-E128745D28E6","فوجْدىَ أنِّيَ فارقتُه","ولم أَبْلُ ما يزعمون اختِبارَا"]]},"4D14B347-1E4B-5AED-A01E-B6843DD17F03":{"t":"يقُولُون لي: أفنيتَ كلَّ ذخيرةٍ","p":173,"s":"يقولون لي: أفنيت كل ذخيرة","r":"452203","v":[["4689F11B-7DDF-5D92-9645-C60E2A67647C","يقُولُون لي: أفنيتَ كلَّ ذخيرةٍ","وأنفقْتَ مالاً لا تجودُ به النَّفسُ"],["1464B79C-36A5-5B23-A36B-83613B8CB827","فقلت: نعم فرقت ما جمعت يدي","وأرجو غداً يأتي بما أذهب الأمس"]]},"3DB1A0D2-D473-59AD-A885-066A1603A40B":{"t":"يكاثر ماء الرزم عند ادكاركم","p":173,"s":"يكاثر ماء الرزم عند ادكاركم","r":"452074","v":[["EC79917D-03B4-5DC5-BBDA-DF9286806768","يكاثر ماء الرزم عند ادكاركم","دُمُوعي، ولكنْ ذَا بَرودُ، وذى قطرُ"],["2DE4C905-885C-55E3-89A0-761567C79853","ولَو لَم أُعرْها بَعدَكم كلَّ من بَكَى","لأعظمها عن أن يكاثرها القطر"]]},"FE95AA35-BF22-5E24-86B4-2CCBE98D5D63":{"t":"يلط بالدين من مولاه مسلمه","p":173,"s":"يلط بالدين من مولاه مسلمه","r":"452103","v":[["F19C58EF-1824-58C1-9614-A054B749C847","يلط بالدين من مولاه مسلمه","حتى يخلصه السلطان والحكم"],["BB20394B-90C8-5660-9991-52B9220996CB","لكن مولاي يقضي ما استدنت ولا","يَلْقَى سُؤالِيَ منهُ الصّدُّ والسّأمُ"],["A258B294-7C6E-536B-B7AD-269920D314E9","فكفُّه البحرُ، لكن موجُهُ بِدَرٌ","وجوده الغيث لكن وبله نعم"]]},"DCAF10C8-7679-5C43-846C-C6079695D1E7":{"t":"يلومونني في حب ليلى وإنني","p":173,"s":"يلومونني في حب ليلى وإنني","r":"451915","v":[["43D851D2-894B-57AB-81CD-25BBC616C291","يلومونني في حب ليلى وإنني","لأُكْرِمُها عن عُرضَةِ اللَّوْمِ والعَذْلِ"],["602C2C58-8679-5ACA-AEB5-34D2F71B0A35","وقالوا: هواها خابل لك فاسلها","ومن لومِهم، لا مِن هَواي لها، خَبلِى"],["F0160E9F-838D-5F50-97EE-FF2EDFEB64E3","هي الشمسُ، تَبدو في رداءٍ من الدُّجَى","على خوط بان في كثيب من الرمل"],["0D8BC5BC-887C-5A9C-B5BE-B9EF320CC753","تَهادَى تهادِى الظِّلِّ هَوناً، كأنَّما","تخاف عثار الحزن في الدهس السهل"],["D3F12060-9643-578A-8952-B82E2EF6B51F","وتنظُر من عَيْنَىْ مَهاةٍ، كفَاهُما","وأغناهما كحل الملاحة عن كحل"]]},"C35F538E-B620-5647-904A-D6A4D3F56F69":{"t":"يَا ثَانياً للنَّفِس وهْـ","p":173,"s":"يا ثانيا للنفس وهـ","r":"452066","v":[["D8BCE811-FAA0-5937-8686-16A3AA26E6C3","يَا ثَانياً للنَّفِس، وهْـ","ـو لناظري أعز ثالث"],["55A64BC4-85D3-54FD-8B0B-4CD9954D7FD0","ونجي فكري دون سا","ئر من أناجي أو أحادث"],["0EF15C0E-6552-5B5F-9369-2014C7F1AD0F","أشكو فراقك فهو أو","جع ما لقيت من الحوادث"],["98A8D8BF-273E-5815-BA75-8D4D1F6D7602","شَكوَى مَشُوقٍ يستريـ","ـحُ إليك، والمصدورُ نَافِثُ"],["40A01841-490F-5870-B261-49E148F7C65E","وألوم دهراً جد في","تشتيت شملي وهو عابث"],["55AC0DEC-A07F-5BF3-8410-31AE369C0D16","إنِّي علِقتُ من اصْطبا","ري عنكَ أسباباً رثَائِثْ"],["EDB92C16-478B-5BAD-90BC-755AD1A4E689","عاهدته ألا تضعـ","ـضعه النوى وأراه ناكث"],["7DB8F143-82BD-5F23-B336-FD9C74AD0001","وكأنَّ قلبِي حينَ يَخـ","ـطرُ ذِكرُكم في كَفّ ضَابِث"],["12A68B2F-2A9D-549D-9B36-33259676E4B0","وبَقَاي بعدَ فراقكُم","خطبُ، لعمرُ أبيكَ، كارثْ"]]},"FEBE1B94-BC38-5454-B67C-176745715148":{"t":"يَا ساكنى جنَّةٍ رِضوانُ خَازنُها","p":173,"s":"يا ساكنى جنة رضوان خازنها","r":"452129","v":[["E768BC1A-6223-5C34-BC7A-A09B5E01E723","يَا ساكنى جنَّةٍ، رِضوانُ خَازنُها","هنيتم العيش في روح وريحان"],["F62CC340-EE61-5CE7-A80D-FE5C786A75A6","مروا النسيم إذا ما الفجر أيقظه","بحمله طيب نشر منه أحياني"],["DF71790A-FD7E-542B-815A-8970565D7003","أو فابعثوا نغمةً منه يعيش بها","قلبي فقد مات مذ حين وأزمان"],["A0AF7AD8-500E-5C12-87DC-9F5DE21C5CE4","ظبي أغن تردى بالدجى وجلا","شمس النهار على غصن من البان"],["5A0ADAB3-3A1D-5963-92F0-F3EA734B50B7","في فيه ما في جنان الخلد من درر","ومن رَحِيقٍ، ومن مسْكٍ، ومَرْجَانِ"],["EEECD244-9121-54E6-BECF-BD12CA955CCF","إذا بدا وشدا في مجلس ظفروا","بمُنية النَّفِس من حُسنٍ وإحسَان"],["EF10EA15-AC40-5537-94B7-AB28DFC06B8F","لا تَنْسَني يا أبا نَصرٍ، إذا حَضَرتْ","قُلوبُكم بين مَزمُومٍ وطَرخَانِي"],["5A5791CC-C63D-5E40-95C2-A5ADA2028B12","كن لي وكيلاً على الرؤيا ووكل لي","سواك يسمع عني شدو رضوان"],["8F7B6C28-757D-5A79-A230-BD2428FC0B5D","وقُل له: يَتَغَنَّى من قلائِده","صوتاً يُجدِّدُ لي شَجْوى، وأشْجَانِي"],["6A105757-709C-5E8D-803A-D21D57E48685","نسيمه يتقلقاني بزورته","مبشراً لي به من قبل يلقاني"]]},"07FFDF28-0FFA-5A4A-8016-D509A9993807":{"t":"يَا نَازِحينَ واصطِبَارَي والأسَى","p":173,"s":"يا نازحين واصطباري والأسى","r":"451963","v":[["79D9CA7C-4BBF-5568-AD6A-2808D174947E","يَا نَازِحينَ واصطِبَارَي والأسَى","يجم ذا دمعي وهذا ينزح"],["64543D45-5FB1-57EB-A06E-30533F62E23D","لا أسأل الأيام تعويضاً بكم","لأنها بمثلكُم لا تَسمحُ"],["F38A1384-8328-52D7-9D20-599CFE5FFFDB","غبتُم، وأشباحكمُ بِنَاظِري","كأنها إنسانه لا تبرح"],["EA206AC3-C02F-5DBE-A0F4-4F6C5CA07DC6","ولائم يلوم فيكُم، والهَوى","يصحبه طوراً وطوراً يجمح"],["4CCD6E7C-2828-5A79-8BF8-0581708B9632","يلجُّ في نُصحي، وما أشْغَلني","بالبين والهجران عمن ينصح"]]},"F4B29F1C-52D1-5CC7-82F3-AFC0F652D04E":{"t":"يَريبنِي ما أرى منكُم ويَعطِفُنِى","p":173,"s":"يريبني ما أرى منكم ويعطفنى","r":"451928","v":[["EE58E0FE-D947-5DF7-9157-3F9C86D7EBB8","يَريبنِي ما أرى منكُم، ويَعطِفُنِى","إلى هواكُم وفاءُ لستُ أسأمُهُ"],["40B3C4F2-3307-582B-8288-A8BB4166197C","كأنَّنِي أمُّ بَوٍّ تَستريبُ بما","تراه منْهُ، ولا تنفكُّ تَرأَمُهُ"]]},"D2713FA8-E595-50F0-B0E1-4ACFF97C1CD6":{"t":"يَغالطني فيكم هَواي فأنْثَني","p":173,"s":"يغالطني فيكم هواي فأنثني","r":"451949","v":[["FADD1210-0124-5292-90B3-DE67514DAE0A","يَغالطني فيكم هَواي، فأنْثَني","إليكم على إنكار ما قد بدا ليا"],["A142FF11-5D57-5789-BE37-DA474531C4FC","كَعَطْفَة أُمِّ البَوِّ تَرأَمُ شِلْوَهُ","وقد رابها منه الذي ليس خافيا"]]},"09350322-205B-5559-855F-641BD30A4DCD":{"t":"يُجهِّلُ في الإقدَامِ رأْيِي مَعَاشِرٌ","p":173,"s":"يجهل في الإقدام رأيي معاشر","r":"452177","v":[["C1C2ED1F-E68D-55AA-A571-ED82239B03C7","يُجهِّلُ في الإقدَامِ رأْيِي مَعَاشِرٌ","أراهُم إذا فَرُّوا من الموتِ أجهلاَ"],["E7098F08-500E-57BF-800A-094EF53528EB","أيرجُو الفتَى عند انقضاءِ حَياتِه","وإن فر عن ورد المنية مزحلا"],["7D1DA2B2-5D19-585E-B139-8354A7AB8695","إذا أنا هبت الموت في حومة الوغى","فلا وجدت نفسي من الموت موئلا"],["D7967BA6-0311-54DC-828F-71A3EC3B01FF","وإني إذا نازلت كبش كتيبة","فلستُ أُباليِ أيُّنا ماتَ أوَّلاَ"]]}}}