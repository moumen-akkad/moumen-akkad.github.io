{"v":1,"poems":{"B63515E7-4C42-5E20-ABBD-ABB9EA19C540":{"t":"ألاَ فَامْلَ لِي كَاسَاتِ خَمْـرٍ وَغَنِّنِـي","p":59,"s":"ألا فامل لي كاسات خمـر وغننـي","r":"437464","v":[["8658F12A-284F-5A99-A275-6DBA06F1FF75","ألاَ فَامْلَ لِي كَاسَاتِ خَمْـرٍ وَغَنِّنِـي","بِذِكْـرِ سُلَيْمَـى وَالرَّبَـابِ وَتَنَعّمِ"],["CF6C6D79-88BC-5C2B-9F60-DF51B959F259","وَإيَّـاكَ ذِكْـرَ العَـامِـرِيَّـةِ إِنَّنِـي","أَغَـارُ عَلَيْـهَا مِـنْ فَـمِ المُتَكَلِّـمِ"],["BD972362-F5DE-558D-B022-624E7FA326A3","أَغَـارُ عَلَـى أَعْطَافِهَـا مِنْ ثِيَابِهَـا","ِإذَا لَبَسَتْـهَا فَـوقَ جِسْـمٍ مَنَعَّـمِ"],["392849C8-CEAF-51F1-A7BA-A8DED063EAB7","وَأَحْسُـدُ كَاسَـاتٍ تُقَبِّـلُ ثَغْرَهَـا","إِذَا وَضَعَتْهَا مَوْضِعَ اللَّثْـمِ فِي الفَـمِ"]]},"39CC1C5A-DC93-591A-88C3-E70BDC100561":{"t":"إِذَا بَرَزَتْ لَيلَى مِنَ الخِدْرِ","p":59,"s":"إذا برزت ليلى من الخدر","r":"437466","v":[["981BDCFC-85B0-5D49-9E8F-D7516D9E9917","إِذَا بَرَزَتْ لَيلَى مِنَ الخِدْرِ أَبْـرَزَتْ","لَنَا مَبْسَماً عَذْبـاً وَجِيـداً مُطَوَّقَـا"],["DDA5C1EB-42C4-5853-80D6-E7FA3903A75C","كَـأَنَّ غُلامـاً كَاتِبـاً ذَا بَرَاعَـةٍ","تَعَمَّـدَ نُونَـي حَاجِبَيْـهَا فَعَرَّقَـا"],["A5D76D49-7AE9-5CF4-BE43-B91697A4BD4B","وَأَحقَافُ رَمْـلٍ جَاذَبَتْـهَا وَهَـزَّةٌ","عَرَتْهَا كَمَا هَزَّ الصَّبَا غُصْـن النَّقَـا"],["5E09A302-89D0-5FDE-9051-E7A5504E4C7B","أَتَتْ تَتَهَادَى كَالقَضِيـبِ فَقَبَّلَـتْ","يَدِي غَلَطاً مِنْـهَا فَقَبَّلْـتُ مَفْرقَـا"],["77F4DCCB-FB35-53E7-96A4-BD47340D355B","وَبَاتَتْ يَدِي طَوقاً لَهَـا وابْتِسَامُهَـا","يُرينِي شعَاعاً آخِـرَ اللَّيـلِ مُشْرِقَـا"],["830F59D2-6291-58CB-9381-D31E791DB455","فَلَمْ أَرَ بَدْراً طَالِعـاً قَبْـلَ وَجْهِهَـا","وَلاَ مَيِّتاً قَبْلِـي مِنَ البَيْـنِ أَشْفَقَـا"]]},"71275D4F-4291-5F5F-B4A4-FB61AD8B674E":{"t":"جَاءَ البَرِيـدُ بِقرطـاسٍ","p":59,"s":"جاء البريـد بقرطـاس","r":"437470","v":[["7030B4DA-7CDF-5DD2-A056-205A2C9FB86E","جَاءَ البَرِيـدُ بِقرطـاسٍ يَخـبُّ بِـهِ","فَأَوجسَ القَلبُ مِنْ قِرطَاسـهِ فَزعَـا"],["A5B6235C-4B56-5451-9B4F-FAF18121C341","قُلنَا: لَكَ الوَيلُ، مَاذَا فِي صَحِيفَتكُم؟","قَالُوا: الخَلِيفةُ أَمسَـى مُثْبَتـاً وَجِعَـا"],["0F346A44-7850-551B-AFCD-6C217BA89A3A","مَادَتْ بِنَا الأَرض أَوْ كَادَتْ تَمِيدُ بِنَـا","كَأَنَّ مَـا عَـزَّ مِنْ أَركَانِهَـا انْقَلَعَـا"],["5C3B075B-A0AC-5FC8-AA1D-C4324C2BA0F8","ثُمَّ انْبَعَثنَـا إلـى خـوصٍ مُضَمَّـرَةٍ","نَرمِي الفِجَاجَ بِهَا مَا نَأتَلِـي سرعَـا"],["5B9EC3BD-22F0-552C-9243-5D3EAC8F7795","فَمَـا نُبَـالِـي إِذْ بَلَّغـنَ أَرجلنَـا","مَا مَاتَ مِنهـنَّ بالمَرمَـاتِ أَوْ طَلعَـا"],["55F24702-6565-5A74-987E-CAF01997325C","مَنْ لَمْ تَزلْ نَفسُه تُوفِي عَلَى شَـرفٍ","توشِكْ مَقَادِيرُ تِلكَ النَّفسِ أَنْ تَقَعَـا"],["E433E82C-8E42-5541-A436-CA23003DF598","لَمَّا وَرَدْتُ وَبَـاب القَصْـرِ مُنْطَبـقٌ","لِصَوْتِ رَمْلَةَ هُدَّ القَّلـبُ فَانصَدَعَـا"],["530995B1-9679-5C45-8398-7E0012C3FCAF","ثُمَّ ارْعَوى القَلبُ شَيْئاً بَعـدَ طِيرَتِـهِ","والنَّفْسُ تَعْلَمُ أَنْ قَـدْ أثْبَتَـتْ جَزَعَـا"],["5B01C40E-6ECB-578A-B65D-DB2CAEF0AB0B","أَودَى ابنُ هِندٍ وَأَودَى المَجـدُ يَتبَعُـهُ","كَانَا جَمِيعاً خَلِيـطاً سَالِميـنَ مَعـاً"],["F61A008F-225B-5F97-A5C9-9B46B0AC94BD","أَغَرُّ أَبلَـجُ يُستَسْقَـى الغَمَـامُ بِـهِ","لَوْ قَارعَ النَّاسَ عَنْ أَحْلامهـمْ قَرَعَـا"],["CDBF9D4A-122E-5B7C-A48F-8BFC370AE6E0","لاَ يَرقَعُ النَّاسُ مَا أَوهَى وإِنْ جَهَـدُوا","أَنْ يَرقعُـوه وَلاَ يوهـونَ مَـا رَقَعَـا"]]},"48B0F14F-2E71-5EB6-8205-6BD0376A7BCA":{"t":"جَاءَتْ بِوَجْـهٍ كَأَنَّ البَـدْرَ بَرْقَعَـهُ","p":59,"s":"جاءت بوجـه كأن البـدر برقعـه","r":"437465","v":[["9E7C08D4-6980-50CC-9122-F589FB1D8460","جَاءَتْ بِوَجْـهٍ كَأَنَّ البَـدْرَ بَرْقَعَـهُ","نُوراً عَلَى مَائِسٍ كالغُصْـنِ مُعْتـدِلِ"],["0B9CAF0F-7735-526B-811D-B24946E96E6A","إحْدى يَدَيْها تُعاطينِـي مْشَعْشَعـةً","كَخَدِّها عَصْفَرَتْهُ صبْغَـةُ الخَجَـلِ"],["C4CA4388-6FB1-558C-8E5F-C73B38DBEFFC","ثُمَّ اسْتَبَدَّتْ وقالَتْ وهْـيَ عالِمَـة","بِمَا تَقُولُ وشَمْـسُ الرَّاحِ لَمْ تَفِـلِ"],["F41F10A9-499B-5F0C-B1ED-9154C8876828","لاَ تَرْحَلَنَّ فَمَا أَبْقَيْـتَ مِنْ جَلَـدِي","مَا أَستَطِيـعُ بِـهِ تَودِيـعَ مُرْتَحِـلِ"],["72D942D0-D817-5C38-ACE2-4F07014DED6E","وَلاَ مِنَ النَّومِ مَا أَلقَـى الخَيَـالَ بِـهِ","وَلاَ مِنَ الدَّمْعِ مَا أَبْكِـي عَلَى الطَّلَـلِ"]]},"D8C1BDF3-9775-5015-8BAB-CA8F549FAFBD":{"t":"خذوا بدمي ذات الوشاح فإنني","p":59,"s":"خذوا بدمي ذات الوشاح فإنني","r":"437471","v":[["41C7D228-49C8-5F7B-BFA6-CBB72716043D","خذوا بدمي ذات الوشاح فإنني","رأيتُ بعيني في أناملها دمي"],["2AD93FF1-268A-5014-A40B-C31C8F79795D","أغار عليها من أبيها وأمها","ومن خطوة المسواك إن دار في الفمِ"],["3F4D6891-436E-5935-9013-50B7AED74024","أغار على أعطافها من ثيابها","إذا ألبستها فوق جسم منعمِ"],["B9D5FC55-2501-56D1-8E91-68AB6B9166D2","وأحسدأقداحا تقبلُ ثغرها","إذا أوضعتها موضع المزجِفي الفمِ"],["1D5C248B-C601-5E8D-B2FD-69B300F4B897","خذوا بدمي منها فإني قتيلها","فلا مقصدي ألا تقوتو تنعمي"],["B150FF4E-EF04-511A-A49A-DC8A35519EBD","ولا تقتلوها إن ظفرتم بقتلها","ولكن سلوها كيف حل لها دمي"],["96EF2BED-BC72-5178-8819-CFD8347605EC","وقولوا لها يا منية النفس إنني","قتيل الهوى والعشق لو كنتِ تعلمي"],["AFC0F002-C221-5246-9DBC-48CFD4B24538","ولا تحسبوا أني قتلت بصارم","ولكن رمتني من رباهابأسهمِ"],["A9886776-7602-5C96-9585-DA1F20A9292B","لها حكم لقمـان وصـورة يوسـف","ونغـمـه داود وعـفـه مـريـمِ"],["86E54306-837B-562F-A87E-780ED19DD78C","ولي حزن يعقوب ووحشـه يونـس","وآلام أيـــوب وحـســرة آدمِ"],["52C2FB85-4ECF-55AC-B438-C3AD824B8AC2","ولو قبـل مبكاهـا بكيـت صبابـة","لكنت شفيت النفـس قبـل التنـدمِ"],["3AB54757-DDF5-5867-A75B-5752B41D1492","ولكن بكت قبلي فهيج لـي البكـاء","بكاهـا فكـان الفضـل للمتـقـدمِ"],["8E6B0762-C82C-5D74-8CB0-A4D52D6E2670","بكيت على من زين الحسن وجههـا","وليس لها مثـل بعـرب وأعجمـي"],["0DACED8E-AFBC-5A94-8991-11390EDF8877","مدنيـة الألحـاظ مكيـة الحشـى","هلاليـة العينيـن طائيـة الـفـمِ"],["4A593159-8B8A-5B1D-A8B6-3A322122209D","وممشوطة بالمسك قد فاح نشرهـا","بثغـر كـأن الـدر فيـه منـظـمِ"],["34323B24-8059-53DA-B007-F99FF202F2B4","أشارت بطرف العين خيفـة أهلهـا","إشـارة محـزونٍِ ولــم تتكـلـمِ"],["DA6BF7A6-377B-5E96-9ABD-DD06D7DD614A","فأيقنت أن الطرف قد قـال مرحبـا","وأهـلا وسهـلا بالحبيـب المتيـمِ"],["FD2379AE-ADCD-526C-9F9F-3DA8CEDA512D","فوالله لـولا الله والخـوف والرجـا","لعانقتهـا بيـن الحطيـمِ وزمـزمِ"],["E570B28F-6076-5159-87F0-92A28C678A08","وقبلتهـا تسعـا وتسعيـن قبـلـةً","براقـةًبالكـفِوالـخـدِ والـفـمِ"],["61521B2A-1DED-53FD-97F5-6A7CCA7D20D3","ووسدتهـا زنـدي وقبلـت ثغرهـا","وكانت حلالا لي ولو كنـت محـرمِ"],["3AD8A61E-78FF-5F6C-B3D9-97719CF4E9EE","ولمـا تلاقينـا وجــدت بنانـهـا","مخضبـه تحكـي عصـارة عنـدمِ"],["A799E586-6233-5FF4-BAC7-3C174D7F07A4","فقلت خضبت الكف بعـدي ,هكـذا","يكـون جـزاء المستهـامِ المتيـمِ"],["6871D607-EE5C-5A3F-9F52-FD8D5A03347D","فقالت وأبدت في الحشى حر الجوى","مقاله من فـي القـول لـم يتبـرمِ"],["84AC39FE-9273-532E-B641-2DBF1A8708A9","وعيشـك ما هـذا خضـاباً عرفتـهُ","فلا تكُ بالبهتانِ والـزور ظالمي"],["A0B3E50A-C29E-5132-829A-B7568BEF52B1","ولكننـي لمـا رأيـتـك نائياً","وقد كنت كفي في الحياة ومعصمـي"],["E8044E2A-EE17-57B1-9378-F92601A2FD13","بكيت دما يـوم النـوى , فمسحتـهُ","بكفي فاحمرت بناني من دمي"]]},"E774A4CB-D998-5C52-AF39-A7934C1AE6A8":{"t":"طرقْتكَ زينَبُ","p":59,"s":"طرقتك زينب","r":"437468","v":[["5D8B86EF-E50D-5E6F-B780-D1EA297E2511","طرقْتكَ زينَبُ والرِّكَـابُ مُناخَـةٌ","بِجنوبِ خَبٍت والنَّـدى يَتَصَبَّـبُ"],["41651F61-B54A-5231-AEEA-2E631CE86D8A","بثنيّـة العَلَمَيْـنِ وهْنـاً بَعـدَمـا","خَفَقَ السِّماكُ وجَاوزَتْـهُ العَقـرَبُ"],["A6415248-78EC-5379-9095-150E84420E2A","فَتَحيَّـةٌ وسَـلامَـةٌ لِخَـيـالِهَـا","ومَعَ التَّحِيَّـةِ والسَّلامـةِ مَرْحَـبُ"],["BE64B5BD-6CBF-59A0-8703-1EC981D8C507","أَنَّى اهتَدَيْتِ، وَمَنْ هَـدَاكِ وَبَيْنَنـا","فَلْـجٌ فَقُلَّـةُ مَنْعِـجٍ فالـمَرْقَـبُ"],["815CFB09-91EA-5EC9-8C0D-2FB0CA136736","وزَعَمْتِ أَهلكِ يَمنَعُـونكِ رَغبَـةً","عَنِّي، وأَهلِي بِي أَضَـنُّ وَأَرغَـبُ"],["C30D792C-5DA3-5064-A047-5C71897FD7C4","أَوَليـسَ لِي قُرَنَـاءُ إِنْ أَقْصَيْتنِـي","حَدِبُوا عَلَـيَّ وفِيهـمُ مُسْتَعْتِـبُ"],["14B1189F-7E22-54A1-A4CC-E24948A615C0","يَأبَـى وجَـدِّك أَنْ أَلِيـنَ لِلَوعَـةٍ","عَقلٌ أَعيـشُ بِـهِ وَقَلـبٌ قُلَّـبُ"],["0F8A5197-63AC-5A6B-81DC-703770C0D37D","وأَنَا ابنُ زَمزَمَ والحَطِيـمِ ومَولِـدِي","بَطحَـاءُ مَكَّـةَ والمَحلَّـةُ يَثـرِبُ"],["957052B8-2698-5484-B3D8-6CE88E0D988C","وإلى أَبِي سُفيَانَ يُعْـزَى مَولِـدِي","فَمَنِ المُشاكِـلُ لِي إِذَا مَا أُنْسَـبُ"],["8FA3D86D-BC7D-513F-947C-2767B82023DB","وَلَـوَ انَّ حيًّـا لارتفَـاعِ قَبِيلَـةٍ","ولجَ السَّمَاءَ ولَجْتُهَـا لاَ أُحْجَـبُ"]]},"1BF81EB9-E196-5700-BCF0-1246B6A626C3":{"t":"وأمطرت لؤلؤًا","p":59,"s":"وأمطرت لؤلؤا","r":"437472","v":[["6F587675-B549-5EF9-ADAE-E8164DA29490","نالت على يدها مالم تنله يدي","نقشاً على معصمٍ أوهت به جلدي"],["06ECEDC0-711D-5A92-8FE2-8BBD0326BD7D","كأنهُ طُرْقُ نملٍ في أناملها","أو روضةٌ رصعتها السُحْبُ بالبردِ"],["4F73DE9B-27A8-53D3-8491-9E1FD595B33B","وقوسُ حاجبها مِنْ كُلِّ ناحيةٍ","وَنَبْلُ مُقْلَتِها ترمي به"],["36C54E8B-C2DC-508B-BD3C-18426A544FCD","مدتْ مَوَاشِطها في كفها شَرَكاً","تَصِيدُ قلبي بها مِنْ داخل"],["358BA1B9-3AAA-58C7-8877-2592D5D00580","إنسيةٌ لو رأتها الشمسُ ما طلعتْ","من بعدِ رُؤيَتها يوماً على أحدِ"],["EA757079-1CCB-54F1-B691-B063457BE03F","سَألْتُها الوصل قالتْ:لا تَغُرَّ بِنا","من رام مِنا وِصالاً مَاتَ"],["DF15C3F1-9234-590E-AC09-607D0E85D597","فَكَم قَتِيلٍ لَنا بالحبِ ماتَ جَوَىً","من الغرامِ، ولم يُبْدِئ"],["A73A726B-2272-540B-9633-968F606F1385","فقلتُ: استغفرُ الرحمنَ مِنْ زَلَلٍ","إن المحبَّ قليل الصبر"],["835AB29D-FFD2-5CFB-9416-3A874D913BBE","قد خَلفتني طرِيحاً وهي قائلةٌ","تَأملوا كيف فِعْلُ الظبيِ"],["4EB769AD-3A46-5F16-93E9-0453334AEB6B","قالتْ:لطيف خيالٍ زارني ومضى","بالله صِفهُ ولا تنقص ولا تَزِدِ"],["4F3C6DDB-B247-5914-BB77-15C124AA8A78","فقال:خَلَّفتُهُ لو مات مِنْ ظمَأٍ","وقلتُ:قف عن ورود الماء لم"],["B27F1BC1-2DCD-51F7-B440-3D74FD9CBC68","قالتْ:صَدَقْتَ الوفا في الحبِّ شِيمتُهُ","يا بَردَ ذاكَ الذي قالتْ على"],["16284509-53F2-5347-B6CB-1F6CDD813073","واسترجعتْ سألتْ عَني، فقيل لها","ما فيه من رمقٍ.. و دقتْ يداً"],["39345015-F3D2-5B9D-A523-AC70B8EC324D","وأمطرتْ لُؤلؤاً من نرجسٍ وسقتْ","ورداً، وعضتْ على العِنابِ بِالبردِ"],["8B417BD6-5CB5-5FD5-A232-2AC37ADBFAC6","وأنشدتْ بِلِسان الحالِ قائلةً","مِنْ غيرِ كُرْهٍ ولا مَطْلٍ ولا"],["A99FD2E2-23C7-57A6-85B1-206DD916028A","واللهِ ما حزنتْ أختٌ لِفقدِ أخٍ","حُزني عليه ولا أمٌ على ولدِ"],["51E03094-40D4-56CE-853F-B92344472A15","إن يحسدوني على موتي، فَوَا أسفي","حتى على الموتِ لا أخلو مِنَ الحسدِ"]]},"63957594-66DD-5C8B-8D0B-93FD35FD04AD":{"t":"وسيارة ضلت","p":59,"s":"وسيارة ضلت","r":"437467","v":[["E9EA0AB4-9A28-5A12-BD59-C5FAAC3FE8A9","وسيّارة ضلَّتْ عن القصْـدِ بعدمـا","ترادَفَهَمُ جُنْـحٌ من الليـل مُظْلِـمُ"],["231244A5-983C-51CC-9FA9-EA991A998BCE","فأصغوا إلى صوتٍ ونَحن عصابـةٌ","وفينا فتًـى مـن سكـره يترنّـمُ"],["7D4CB72F-119C-5C23-A9CF-37A1CE94FA65","أضاءتْ لَهم منّا على النأي قهْـوةٌ","كانَّ سناهـا ضـوء نـارٍ تضـرّمُ"],["B1F00947-D5C0-50F4-B9A1-71886053BA6E","إذا ما حَسَوناها أضـاؤوا بظلمـةٍ","وإن قُرِعَتْ بالمزجِ ساروا وعُمِّمُـوا"],["8DF3A7D6-E4B4-5817-8278-9140E975DEC9","أقول لرَكبٍ ضمّت الكأسُ شَملهم","وداعي صبابـاتِ الـهوى يترنّـمُ"],["6406A5A4-9544-5FA4-A24D-340873371E14","خذوا بنصيـبٍ من نعيـمٍ ولـذّةٍ","فكُلٌّ وإن طـال الـمدى يتصـرَّمُ"],["2F385E3E-1B12-5868-AB6B-070758E9A382","ولا تُرْجِ أيّام السـرور إلـى غـدٍ","فرُبَّ غدٍ يأتِـي بِمَا ليـس تعلَـمُ"],["7547E5BF-7767-5BB7-8848-4501856035F5","لقد كادت الدنيـا تقـول لإبنهـا","خـذوا لذّتِـي لـو أنّهـا تتكَلَّـمُ"],["373E88A5-53DF-5097-B9AE-FF37129AA40B","ألا إن أهنا العيش ما سَمحَـتْ بـهِ","صروفُ الليالِـي والحَـوادثُ نُـوَّمُ"],["720E5677-0C5B-5D23-86E6-2C6FA04CF7B4","أناخوا قبيل الصبح عيسَهم وكانـوا","قبل ذلك - كذا - فرادى وتـوءَمُ"]]},"03F2C52E-67B0-5DBD-B95F-1DE97F0864B9":{"t":"وسِرْبٍ كَعَيْنِ الدِّيكِ","p":59,"s":"وسرب كعين الديك","r":"437469","v":[["543371C7-54C0-537C-AEE1-B5C2AC2B5944","وسِرْبٍ كَعَيْنِ الدِّيكِ مَيلٍ إلى الصّبـا","رواعف بالجـاديِّ سـودِ المَدَامـعِ"],["3B537B2C-E4E7-5A5F-84C6-E5137823C6C9","سَمِعْنَ غنَاءً بَعْدمَـا نُمْـنَ نَومَـةً","مِنَ اللَّيلِ فاقْلَوْلَيـن فَوقَ المضَاجـعِ"],["621FE1BD-7ED0-5BF6-9189-4DD7F241787F","أَيَا دَهْرُ هَلْ شَرْخ الشَّبيبَـةِ رَاجـعٌ","مَعَ الخفراتِ البيض أَمْ غَير راجـعِ؟"],["74F885C2-AEDB-5134-A41D-16B57E76819A","قَنعْتُ بـزورٍ مِـنْ خَيـالٍ بعثْنَـهُ","وكنْتُ بِوَصْلٍ مِنْهُـمُ غَيـر قانِـعِ"],["AD4C91C3-BBC1-5C9B-B62F-6439DDCE6F3C","إِذَا رُمْتُ مِنْ لَيلَى عَلَى البُعدِ نَظـرةً","تُطفِّي جَوىً بين الحَشَـا والأضالـعِ"],["4355E3AD-EFD6-5648-BBA0-279EA00F6121","تَقُول نساء الحـيِّ: تَطمعُ أَنْ تَـرَى","مَحَاسِنَ لَيلَى؟ مُتْ بِـداءِ المطَامـعِ"],["EAE62179-45E7-56BF-82C5-4FB1CCE1C718","وكَيفَ تَرَى لَيلَى بِعيـنٍ تَرَى بِهَـا","سِوَاهَـا؟ وَمَا طَهَّرْتَهَـا بالمَدَامـعِ"],["58DE56D6-8458-517E-AC83-463621247B35","وتلتذُّ مِنهَا بالحَديثِ وَقَـدْ جَـرَى","حَديثُ سِوَاهَا فِي خروقِ المَسَامِـعِ"],["F5E8E586-A28D-5393-B1F5-230D9297334E","أُجِلُّكِ يَا لَيلَـى عَنْ العَيـنِ، إِنَّمَـا","أَرَاكِ بِقَلـبٍ خَاشِـعٍ لَكِ خَاضِـعِ"],["E3DCD494-F538-5042-9EB1-807B95854E92","وَمَا سِرُّ لَيلَى، مَا حَيِيـتُ، بِذَائِـعِ","وَمَا عَهْدُ لَيلَى إِنْ تَنَـاءَتْ بِضَائِـعِ"]]}}}