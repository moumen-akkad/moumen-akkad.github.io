{"v":1,"poems":{"F664F87E-0F39-5F9F-86DC-F97424F42D31":{"t":"أرى جارتي خَفّتْ وخفّ نَصيحُها","p":11,"s":"أرى جارتي خفت وخف نصيحها","r":"436889","v":[["AE1B7744-1B4F-5792-9BE9-E4AFAE2151E1","أرى جارتي خَفّتْ، وخفّ نَصيحُها","وحبّ بها، لولا النّوى، وطُمُوحها"],["CDB76A6D-663F-5A8F-B3D7-C3A127ED7FB2","فَبِينيِ عَلَى نَجْمٍ شَخِيسٍ نُحُوسُهُ؛","وَأَشْأَمُ طَيْرِ الزَّاجِرِينَ سَنِيحُهَا"],["1792A009-423E-5BB1-8608-697EB411C34C","فَإنْ تَشْغَيِ فَالشَّغْبُ مِنِّي سَجِبَّةٌ","إذا شِيمتي لم يُؤتَ منها سَجِيحُها"],["E7949BD4-A7EA-54BE-B1F0-6F61A9FA5FFA","أُقَارِضُ أَقْوَاماً، فَأُوْفِي قُرُوضَهُمْ","وعَفٌّ إذَا أَرْدَى النُّفُوسَ شَحِيحُهَا"],["55101412-B0C0-5B54-9813-D446EAAA9B71","على أنّ قومي أَشْقذوني فأصبحت","دياري بأرض غيرِ دانٍ نُبُوحُها"],["8CF47C05-9780-56CC-BAFB-42E99F5F2A36","تَنفَّذَ مِنْهُمْ نافِذَاتٌ فَسُؤْنَنِي","واَضْمَرَ أَضْغاناً عَلَىَّ كُشُوحُهَا"],["8CA9EE01-3A26-5635-8DED-3AD652BD1B12","فقلت: فراقُ الدارِ أجملُ بينِنا","وقضدْ يَنْتَئِ عن دَارِ سَوْءٍ نَزِيحُهَا"],["5DABC346-7A27-5707-801A-DC0B8AE00D79","على أنني قد أدّعي بأبيهم","إذا عَمّتِ الدّعوى وثابَ صَريحُها"],["3E5AD14F-B1E2-5BC8-AC9B-ED16F84590D4","وأني أرى دِيني يُوافق دِينَهُم","إذا نسكوا أفراعُها وذَبيحُها"],["4B06D938-C3EE-5FA8-B26F-7D904D070B06","بِوُدِّكِ ما قَوْمِي علَى أَنْ تَركْتِهِمْ","سُلَيُمَي إذَل هَبَّتْ شَمَالٌ وريِحُهَا"],["62FF6911-8C29-587B-8F1F-24EA35996F8C","وغَابَ شُعَاعُ الشَّمْسِ في غيْرِ جُلْبَةٍ","ولا غَمْرَةٍ إلاَّ وَشِيكاً مُصُوحُهَا"],["29B20B62-659E-552C-97A5-18AD4796C53A","وَهاجَ عَماءٌ مُقشَعِرٌ كَأَنَّهُ","نَقِيلةُ نَعلٍ بانَ منها سَريحُها"],["259D312E-3E58-52A6-A14F-D0B0057AD90A","إذا عُدم المحلوبُ عادت عليهمُ","قدورٌ كثيرٌ في القِصاع قَدِيحها"],["0446CFA4-2E38-5287-A89F-727C6E920F10","يثوبُ عليهم كلُّ ضيفٍ وجانبٍ","كما ردَّ دَهداه القلاص نضيحُهَا"],["9B5D7398-2FA7-59D9-9FEA-DBBC8FBE0961","بأيديهم مقرومةٌ ومغالقٌ","يعود بأرزاق العِيال مَنيحها"],["678C8387-998E-5072-A790-A8277A8B9EFF","وملومةٍ لا يخرقُ الطرفُ عرضها","لها كوكبٌ فخمٌ شديدٌ وُضوحُها"],["BB71A00D-62C4-589B-B6E8-3A6BB98A89E9","تسيرُ وتُزجي السّمَ تحت نُحورها","كريهٌ إلى مَنْ فاجأته صَبوحُها"],["B1E345E5-831B-57AF-84E8-F278347C2C03","على مُقذحِرَّاتٍ وهنَّ عوابسٌ","ضبائرُ موتٍ لا يُراح مُريحا"],["FE1A9851-9D8D-564B-8BAB-DF0D3E7D3392","نَبذنا إليهم دعوةً يالَ مالك","لها إربةٌ إن لم تجد مَنْ يُريحُهَا"],["B5EE4268-AF35-533B-9E1D-9B0990D23782","فسُرنا عليهم سَورَةً ثعلبيَّةً","وأسيافنا يجري عليهم نضوُحُهَا"],["AF0A0065-E3A5-57AE-9F57-4BBD5D3D8896","وأرماحُنَا ينهزنهُمْ نَهْزَ جُمَّةٍ","يعود عليهم وِرْدُنا فَنَميحُها"],["5B5AD8AC-47DD-5D85-A9E2-D6F640A56649","فَدَارَتْ رحَانَا ساعةً ورحاهُمُ","ودرّت طِباقاً بعد بكءٍ لُقُوحُها"],["6625B494-4D72-533E-A0A6-7FAB9738EA32","فَمَا أتلفتْ أيديهمُ من نُفوسنا","وإنْ كرُمتْ فإنَّنا لا ننوُحها"],["7897A1A0-9499-5773-B318-543397B7292C","فَقُلنا هِيَ النُهبى وَحَلَّ حَرامُها","وكانت حمىً ما قَبْلنا فنُبيحُها"],["5EA7073C-088A-547C-AF77-5796DFFFAA9E","فَأُبْنا وآبوا كلّنا بمَضيضةٍ","مُهملَةٍ أجراحُنا وجُرُوحُهَا"],["BED79ED3-F492-5A83-8583-119FA0A5AADD","وَكُنّا إِذا أَحلامُ قَومٍ تَغَيَّبَت","نَشِحُّ عَلى أَحلامِنا فَنُريحُها"]]},"CE4B1063-DF2D-5792-B2D4-DB067361AB54":{"t":"أمِنْ طَلَل قَفْرٍ ومن منزلٍ عافِ","p":11,"s":"أمن طلل قفر ومن منزل عاف","r":"436719","v":[["53BDBA2C-7C77-5564-B1B8-AF4DD700D8B2","أمِنْ طَلَل قَفْرٍ ومن منزلٍ عافِ","عفتهُ رياحٌ مِنْ مشاتٍ وأصيافِ"],["6A66291A-CAB2-52BB-AD8C-4EC7ED840533","ومبروكِ أذوادٍ، ومربطِ عانةٍ","مِنَ الخيل يحرُثْنَ الديارَ بتطوافِ"],["F19C2EFE-2BD1-54D4-A219-17F63B8050A6","ومجمعِ أحْطابٍ ومَلقى أَياصرٍ","إذا هَزْهَزته الرّيحُ قامَ له نافٍ"],["D1FEC415-A2A6-5FA5-A8BD-A90FB87CE7CE","بكيتَ وأنت ـ اليومَ ـ شيخ مُجرَّبٌ","على رأسهِ شرخانِ من لونِ أصنافِ؟"],["5A91EFE4-8825-55A9-9C5F-B531FF201ECC","سوادٌ وشيبٌ كلُّ ذلك شاملٌ","إذا ما صبا شيخٌ فليس له شافِ"],["CC92F35B-F812-5900-B66C-9249BD5B910D","وحيِّ مِنَ الأحياءِ عودٍ عرمرمٍ","مُدِّلٍ فلا يَخْشونَ من غَيْبِ أَخيافِ"],["828AEFCB-83F1-5612-A705-1C64970718D9","سَمونا لهم من أرضنا وسمائنا","نُغاورهم من بَعد أرضٍ بإيجافِ"],["C7E23BB7-7B19-5A3B-9D53-D2F830BFD6D7","على كلِّ معرونٍ وذات خزامةٍ","مصاعيب لم يذلن قبلي بتوقاف"],["206872CB-6DA7-5EE8-BA7E-112FFC2C8C87","أولئك قومي آلُ سعدِ بنِ مالكٍ","فمالوا على ضِغن عليّ وإِلغافِ"],["445E972D-BB8F-5154-B6CC-543A5999D75E","أكنّوا خُطوباً قد بدتْ صَفَحاتُها","وأفئدةً ليستْ علىَّ بأرْآفِ"],["C6C35F61-DAA2-553E-88EB-5A089BB04BC5","وكلُّ أناسٍ أقربُ ـ اليومَ ـ منهمُ","الى وإن كانو عُمان أولى الغافِ"]]},"0A7C34CC-BE5E-5FAD-831C-15448154899C":{"t":"إنيِّ مِنَ القومِ الذين إذا","p":11,"s":"إني من القوم الذين إذا","r":"436738","v":[["91419213-31E3-55DD-90E3-FA75C8EB7051","إنيِّ مِنَ القومِ الذين إذا","أزِمَ الشتاءُ ودُوخلت حُجَرُهْ"],["0F4A5BD4-6793-5790-90AF-3F428B7AB973","ودنا ودُونيتِ البُيوتُ له","وثنى فثنَّى ربيعه قدرهُ"],["18D60B61-AA37-5654-AE13-BA7AFCCAA3F3","وضعَ المنيح وكان حظّهُمُ","في المنقيات يقيمها يُسُرُهُ"]]},"8DA61E25-41B7-5A0E-A362-32ED18167EE2":{"t":"إنْ أكُ قد أقْصرْتُ عن طولِ رحلةٍ","p":11,"s":"إن أك قد أقصرت عن طول رحلة","r":"436715","v":[["57EF92D0-CC0D-542B-B8B7-D5634C50ED5F","إنْ أكُ قد أقْصرْتُ عن طولِ رحلةٍ","فيا ربَّ أصحابٍ كِرَامِ"],["3D3D16F5-803D-5639-A906-FFE024D5084F","فقلت لهم: سيروا فِدى خالتي لكم","أما تَجدونَ الرِّيحَ ذاتَ سَهامِ"],["805CBBE0-3AAB-5070-87B5-F700172FBA62","فقاموا إلى عِيْسٍ قد انضمَّ لحمُها","مُوقَّفةٍ أرساغُها بخدامِ"],["9AA9BAB7-7BE9-5313-AEDC-83979C3E57C5","وقمتُ إلى وجناءَ كالفَحل جَبْلةٍ","تُجاوبُ شَدّي نِسعَها بِبُغام"],["8D32EC24-1A90-5F9F-B175-D4C98228C3C5","فأُدلِجُ حتى تطلُعَ الشمسُ قاصداً","ولو خُلطت ظَلماؤها بقَتام"],["C4489DE7-3210-572A-A294-C280B0A338A5","فأوردتُهُم ماءً على حينِ وردهِ","عليه خليطٌ مِنْ قطاً وحَمامِ"],["05084E32-EB79-5F4D-BDFB-DB8E543C36F5","وأهونُ كفٍّ لا تضيرك ضيرةً","يدٌ بين أيدٍ في إناءِ طعامِ"],["8DBA4D59-6B10-5629-B2EE-F00856B0D270","يدٌ من بعيدٍ أو قريبٍ أتت به","شآميةٌ غبراءُ ذاتُ قَتامِ"],["A02636E3-30BE-53EC-9048-710A415C0DFB","كأني وقد جاوَزْتُ تسعين حِجَّةً","خلَعْتُ بها يوماً عِذَارَ لِجامِي"],["C7EAA6D0-3E96-5001-B62E-12E3B0859ABD","على الراحتين مرةً وعلى العصا","أنوءُ ثلاثاً بعدهنَّ قِيامي"],["7DC25237-9992-5B75-B596-79EC470F7CB9","رمتني بناتُ الدهر من حيث لا أَرى","فكيف بمن يُرمى وليس يِرامِ"],["3FE99CF1-B8A0-5888-BCC8-885090EE6D60","فلو أنها نبلٌ إذاً لاتَّقيتُها","ولكنني أُرمى بغير سِهامِ"],["E3C4E5ED-72A7-57FA-9FC3-718287FFE280","إذا ما رآني الناسُ قالوا: ألمْ تكنْ","حديثاً جديد البزِّ غير كَهَامِ"],["A192FDD6-CA98-54D4-8F6D-89AC6AA7A906","وأفنى، وما أُفني من الدهرِ ليلةً","لوم يُغنِ ما أًفنيتُ سلك نِظامِ"],["7541C970-BED4-55B1-8D70-0F01AA8CC529","وأهلكني تأميلُ يومٍ وليلةٍ","وتأميلُ عامٍ بعدَ ذاكَ وعامِ"]]},"0103FE2F-78FB-5C42-BEA9-ED5AE776A201":{"t":"إِنّ قلبي عن تُكْتمٍ غيرُ سالي","p":11,"s":"إن قلبي عن تكتم غير سالي","r":"436718","v":[["863AE3DD-C906-5A5E-99C8-951E2574B7D5","إِنّ قلبي عن تُكْتمٍ غيرُ سالي","تيمتني، وما أرَادَتْ وصالِي"],["DEDDD7A0-CDF8-5E27-9551-0C7BBCD4FDE8","هل ترى عِيرَها تُجيزُ سِراعاً","كلاعدَوْلِيِّ رائحاً من أَوالِ"],["5AFB7B9C-2B6C-5997-8FAD-818EC4E90D31","نزلوا من سويقةِ الماءِ ظُهراً","ثم راحوا للنَّعفِ نعْفِ مَطالِ"],["1D6EFD07-FF9B-5830-9A5C-560A67185F22","ثم أضحوا على الدثينة لا يأ","لون أنْ يرفعوا صُدُورَ الجِمالِ"],["52A51EBB-AFFD-5468-90B7-27CAE08D9B47","ثم كان الحِساءُ منهمْ مَصيفاً","ضارباتِ الخُدورَ تحت الهَدالِ"],["AAA3FCC2-5FBA-576F-B0D5-FC3614A96CCD","فزِعت تُكتَمٌ وقالتْ عجيباً","أن رأتبني تغيَّر اليوم حالي"],["206EE381-A3E7-5C8B-965F-524D4817ACB9","ياابنة الخير! إنما نحن رهنٌ","لصُرُوفِ الأيَّامِ بعدَ اللَّيالي"],["4AE73E1A-4C71-5D22-9B36-20844D9F598F","جَلَّح الدَّهرُ وانتحى لي، وقِدْماً","كان يُنحي القُوى على أمثالي"],["C8B736FB-181F-5DD6-8191-D47C3CE52235","أَقْصدتني سِهامُهُ إِذْ رمتني","وتَولَّتْ عنه سُليمى نِبالي"],["3E606157-DC93-54E9-9092-C06780E1BC31","لا عجيبٌ فيما رأيتِ، ولكن","عَجَبٌ من تَفَرُّطِ الآجالِ"],["9091BC47-3271-541E-928B-91AD6B886CA6","تدرك التمسح المولَّعَ في اللُّجَّـ","ـةِ، والعُصْمَ في رؤوسِ الجِبال"],["D9155A46-7666-59EC-81C2-8D7F22C4BA49","والفريدَ المُسفّعَ الوجه ذا الجدّ","ة يختارُ آمناتِ الرِّمال"],["BA036E3F-F894-5750-B30B-F9DF1A4CEB4D","وتصدَّى لتصرع البطل الأر","وَعَ بين العلهاءِ والسِّربالِ"]]},"9DB0FA30-56EC-5BA8-9EEF-CCAAD7C38FB1":{"t":"تحنُّ حنينا إلى مالكٍ","p":11,"s":"تحن حنينا إلى مالك","r":"436717","v":[["389E6D64-0A05-5AC9-8355-55930A056F71","تحنُّ حنينا إلى مالكٍ","فحِنّي حنينك إني مُعالي"],["479AE2AE-CFBA-5397-ADEB-0A36F667D855","إلى دار قومٍ حسانِ الوجوهِ","عظامِ القِباب طِوالِ العوالي"],["9E807F95-3862-5D0D-AC4B-359D421B04FA","فَوَجهتُهنَّ على مَهْمهِ","قليل الوغى غير صوتِ الرِّئالِ"],["3B8E4274-4A10-570D-9803-2038C71CE802","سراعاً دوائب ما ينثنيـ","حتى احتللن بحَيّ حِلال"],["B4029778-8AF5-5AC7-A886-D276C165A6CA","بسعد بن ثعلبةَ الأكرميـ","ـن، أهلِ الفضالِ وأهلِ النَّوالِ"],["06AC2C4F-D30E-5D26-A27B-70D46FE92644","ليالِي يحبوُنَني ودَّهُم","ويحبون قدركَ غرُّ المَحالِ"],["C2F07BCD-3191-55DB-83AF-245C6A05C6FE","فتصبحُ في المحلِ محورَّةً","لفيءِ إهالتها كالظِّلالِ"],["6FB8538E-F5D4-53FB-A4E7-883CDAAD8BFF","فإنْ كنتِ ساقيةً معشراً","كرامَ الضَّرائب في كل حالِ"],["C90F704D-4DF6-522E-9321-B86D6E0D79A8","على كرمٍ، وعلى نجدةٍ","رحيقاً بماء نِطاقٍ زُلالِ"],["2FB1810A-EF1C-5478-8535-96F5C10D37F2","فكوني أولئكَ تسقينهَا","فدًى لأولئك عَميّ وخَالي"],["10F6C120-E3E8-502F-AF08-9A743C4378CC","أليسوا الفوارسَ يومَ الفرَا","ت، والخيلُ بالقومِ مثلُ السَّعَالي"],["490851CE-FB78-5DBE-864F-5521F94908BF","وهُمْ ما هُمُ عندَ تلكَ الهَنَاتِ","إذا زعْزعَ الطَّلْحَ ريحُ الشَّمال"],["8E721647-EE3A-5324-ADD0-28E32FD915E7","بدُهْمٍ ضوامنَ للمُعُتْفيـ","ـنَ أنْ يمنحوهُنَّ قبلَ العيالِ"]]},"1494ECA8-8644-5316-A25F-86116CD5597A":{"t":"خليليَّ لا تستعجلا أَنْ تَزوّدا","p":11,"s":"خليلي لا تستعجلا أن تزودا","r":"436713","v":[["4ED2C429-3AE6-573B-AB01-7467463E03B8","خليليَّ لا تستعجلا أَنْ تَزوّدا","وأَمْ تَجْمَعَا شَمْلِي وتَنْتظِراً غَدَاً"],["4DC1D125-D4CB-55FB-B1C6-F6B1CF67F90C","فما لَبَثٌ يَوْماً بِسَابِقِ مَغْنَمٍ","ولا سُرْعَتِي يَوْماً بِسَابِقَةِ الرَّدَى"],["999F1382-E836-5887-8B4F-540E4B472D21","وإنْ تُنْظِرَانِي الْيَوْمَ أَقْضِ لُبَانَةً","وتَسْتَوْجِباَ مَنّاً عَلَىَّ وتُحْمَدَا"],["A8BE783F-1975-5103-821A-81EB34C441CA","لعمركَ ما نفسٌ بجِدٍّ رشيدةٌ","تُؤَامِرُنِي سِرّاً لإِصْرِمَ مَرْثَدَا"],["121545AD-BDFC-5CED-B267-E9309ED4780A","وإنْ ظَهَرَتْ مِنْهُ قَوَارصُ جَمَّةٌ","وأفرعَ في لومي مِراراً وأَصعدا"],["C2F930BD-342E-5EB2-95A7-33C7A4FC3EFF","عَلَى غَيْرِ ذَنْبٍ أَنْ أَكُونَ جَنَيْتُهُ","سوى قول باغٍ كادني فَتَجَهَّدا"],["E6FCA6C3-F8E6-50A9-A8E7-FCB7ABC97B54","لَعَمْرِي لَنِعْمَ المْرَءْ تَدْعُو بِحَبْلِهِ","إذا ما المنادي في المَقامةِ نَدّدا"],["F19276F2-5F9D-5271-B850-83662ACE1659","عَظِيمُ رَمَادِ القِدْرِ لا مُتَعَبِّسُ","ولا مُؤْيسٌ منها إذا هو أَوْقدا"],["1B8C53A1-E720-519B-9870-2B620FF2664C","وإنْ صَرَّحْت تَحْلٌ وهَبَّتْ عَرِيَّةٌ","من الرِّيح لم تتركْ لذِي المالِ مِرْفدا"],["6A27F4CC-372C-5E60-89D0-3EF8072FD476","صَبَرْتُ عَلَى وَطْءِ المَوَاليِ وحَطْمِهِمْ","إذا ضنّ ذو القُربى عليهم وأُخمدا"],["24BF3AFD-BE22-5D5B-8D2C-76276D410391","ولم يحمِ فَرْجَ الحيِّ إلا مُحافِظٌ","كريمُ المحيا ماجدٌ غيرُ أَحْردا"]]},"57C82226-7E2F-5DF6-8BF7-FC0C5F4B8662":{"t":"شكوت إليه أنني ذو خَلالةٍ","p":11,"s":"شكوت إليه أنني ذو خلالة","r":"436726","v":[["C257FCE6-12D4-56F9-AC6A-5D0AA8FBCEBC","شكوت إليه أنني ذو خَلالةٍ","وأني كبيرٌ ذو عيال مُجنّبُ"],["61875856-205A-5816-A48E-6B5F065C7F5A","فقال لنا: أهلاً وسهلاً ومرحباً","إذا سرّكم لحمٌ من الوحش فاركبوا"]]},"5062114D-CE82-5A4A-A3A4-E78763F3B037":{"t":"غشيت منازلاً من آل هندٍ","p":11,"s":"غشيت منازلا من آل هند","r":"436725","v":[["DB61C50E-8B83-5694-8F8F-DC97254A7EF7","غشيت منازلاً من آل هندٍ","قِفاراً بُدّلت بعدي عُفيّا"],["47E72E02-D364-5723-A18D-72A2A8BB7E1A","تبين رمادها ومخَطَّ نؤىٍ","وأشعث ماثلاً فيها ثويَّا"],["0F06A812-C9FA-5872-BB37-C46382028064","فكادت من معارفها دموعي","تهمُّ الشأن ثم ذكرت حيَّا"],["69199DBD-0242-5BB4-BEE9-5977A1B92511","وكان الجهلُ لو أبكاك رسمٌ","ولست أحب أن أدعى سفيَّا"],["0D2251FD-722A-5D89-92D4-F1362256D293","وندمانٍ كريم الجدِّ سمحٍ","صبحت بسحرةٍ كأساً سبياً"],["EBAF3D8D-8B43-5A69-A5BE-D7EAFFD974D8","يُحاذر أن تباكرَ عاذلاتٌ","فيُنبأ أنّه أضحى غويّا"],["3561DCF0-F79A-55E9-9FB8-21CD97130BB3","فقالَ لنَا: ألاَ هَلْ مِنْ شواءٍ؟","بتعريضٍ، ولمْ يكميهِ عيَّا"],["1094B3AA-0172-56A5-BAB3-AF91B4AEB9E8","فأرسلتُ الغُلامَ ولم أُلبّثْ","إلى خيرِ البوائك تَوْهَرِيّا"],["80BE845F-E65D-57EE-88EE-EC9535A92067","فناءَتْ للقيامِ لغيرِ سوقٍ","وأتبعُهَا جرازاً مشرفيَّا"],["452662ED-30C9-5EDE-8120-307E8499A018","فظلَّ بنعمةٍ يُسعى عليه","وراح بها كريماً أجفليّا"],["D9BFCC00-FB3E-552E-A48C-66057D496DA0","وكنتُ إذا الهمومُ تضيَّفتني","قريتُ الهمَّ أهوج دوسريَّا"],["D7A5F31D-8E8B-5CFF-BB80-F66AFE589477","بُويزل عامِهِ مِردى قذَافٍ","على التأويبِ لا يشكو الوُنيَّا"],["FB6AFD68-8F84-5A7A-AD4B-62F38B35D4A7","يُشيحُ على الفلاةِ فيعتليها؛","وأذرعُ ما صَدَعتُ به المطيّا"],["31FF6C06-6B12-54F3-8238-038361BFEBBE","كأَنّي حين أزجُرُهُ بصوتي","زجرت به مدلاً أخدريَّا"],["5FC80F02-CE5A-556C-BF36-001BB9DE272A","تمهل عانةً قد ذب عنها","يكون مَصامُه منها قَصيّا"],["484671E7-A35A-53DB-BDD2-72FFB973D1A4","أطال الشَّدَّ والتقريب حتى","ذكرتَ به مُمَرّاً أندريّا"],["F8856819-61ED-550A-A1BE-A34220C96A0E","بها في روضة شهري ربيعٍ","فساف لها أديماً أدلصيا"],["AE8A8613-1394-58DB-970D-E25E07428B68","مشيحاً هل يرى شبحاً قريباً","ويوفى دونها العلم العليَّا"],["4F796E04-7383-5F8F-8515-FB02E9CD657C","إذا لاقى بظاهرةٍ دَحيقاً","أمرَّ عليهما يوماً قَسِيّا"],["40BD473D-BB5A-58AF-8366-6B7609CAABDB","فلما قلّصت عنه البقايا","وأعوزَ من مراتعه اللّويا"],["AA16FC38-D016-5465-8DE3-21B35A5A912F","أرن فصكها صخبٌ دمولٌ","يعبُّ على مناكبها الصّبيَّا"],["F0E7C00A-1727-5A48-B5BE-D2E051524E3A","فأوردها على طملٍ يمانٍ","يهل إذا رأى لحماً طريَّا"],["43E8E407-5F99-5088-9359-F3E67192300F","له شريانةٌ شَغَلت يديه","وكان على تقلدها قويَّا"],["3822FD2D-5D04-583E-AFAF-FD511D0640AC","وزرقٌ قد تنخلها لقضبٍ","يَشُدُّ على مناصبها النَّضيّا"],["7240B4B0-1E70-5DEE-9CFF-F7576B618630","تردَّى برأة لما بناها","تبوأ مقعداً منها خفياً"],["332D5DBD-516F-5AE8-860D-AE4413B99DF8","فلما لم يَريْنَ كثيرَ ذُعْرٍ","وردن صوادياً ورداً كميَّا"],["EE63888D-2F0F-5C25-AA54-7019B406F398","فأرسلَ والمَقاتِلُ مُعْوِراتٌ","لما لاقتْ ذُعافاً يثربيّا"],["322F42CA-05AE-5637-A1BF-6ADA7197FA64","فخرَّ النّصلُ مُنعقضاً رَثيماً","وطارَ القِدْح أشتاتاً شَظيّا"],["9B2E6507-A658-50CB-BB33-651EB6E44EF3","وعضّ على أنامله لهفياً","ولاقى يومه أَسَفاً وغيّا"],["C82B9ADB-5603-51B7-AE52-EA0FE9D6C90A","وراح بحِرّةٍ لَهِفاً مُصاباً","يُنَبِّىءُ عِرسه أمراً جليّا"],["452A62FE-DED3-53A0-A263-4530010A14C1","فلو لطمت هناك بذات خمسٍ","لكانا عندها حِتْنَيْنِ سِيّا"],["2DE7A79D-F2EE-5AE0-B165-D4F60A111D68","وكانوا واثقينَ إذا أتاهم","بلحمٍ إن صباحاً أو مسيَّا"]]},"D064A6F4-21A4-5469-BC15-2DB535625B1D":{"t":"فلوا أن شيئاً فائت الموت أحرزت","p":11,"s":"فلوا أن شيئا فائت الموت أحرزت","r":"436741","v":[["6D4ADC54-CF4F-527B-9027-F869A8119459","فلوا أن شيئاً فائت الموت أحرزت","عمايةُ إِذ راح الأرّح الموقفُ"],["3396EAD7-91E0-5B4A-90F7-481A48E1FDE3","سما طرفه وابّيضَّ حتى كأنه","خصىٌ جفت عندَ الرحائلِ أكافُ"]]},"A52B8ACB-0669-5E23-8A9B-D249459F96D7":{"t":"قد كن من غَسّان قبلك","p":11,"s":"قد كن من غسان قبلك","r":"436729","v":[["15E77217-1F09-5F20-A80A-6AF527277010","قد كن من غَسّان قبلك","أملاكٌ ومن نَصر ذوو هِمم"],["E2B3CF06-666F-5117-9B9F-D77AD83B805F","فتتوّجوا مُلكاً لهم هممٌ","ففنوا فناء أوائل الامم"],["16BDD57A-058B-538E-A619-7B3A13E1D85E","لا تحسبنَّ الدهرَ مُخلدكم","أو دائماً لكمُ، ولمْ يدمِ"],["73A07B7E-6639-5327-B8DC-9FF73827DABC","لو دام لتبعٍ وذوي الـ","الأصناعِ من عادٍ ومن إِرمِ"]]},"0F3BF9F2-154B-55C9-AD07-A95F74321A25":{"t":"كأن ابن مزنتها جانحاً","p":11,"s":"كأن ابن مزنتها جانحا","r":"436730","v":[["FA176010-878A-53B5-8E4F-6C075CA7E43D","كأن ابن مزنتها جانحاً","فسيط لدى الأفق من خِنصرٍ"]]},"C2F5BB4B-DA88-5003-A988-BE8035C8928E":{"t":"كانت قناتي لا تلين لغامزٍ","p":11,"s":"كانت قناتي لا تلين لغامز","r":"436739","v":[["BE24D21A-6B65-558D-ACAD-842415253777","كانت قناتي لا تلين لغامزٍ","فألانها الإصباح والإمساء"],["1E351421-13AB-59EF-B3F3-72C627DED6C9","ودعوت ربي في السلامة جاهدا","ليُصحّني فإذا السلامةُ داءُ"]]},"575161EC-7E80-5C76-B67F-D852F8721D8A":{"t":"كبرتُ وفارقني الأقربونَ","p":11,"s":"كبرت وفارقني الأقربون","r":"436728","v":[["5E021EE0-63B9-5C68-95CF-D48B27ED6261","كبرتُ وفارقني الأقربونَ","وايقنتِ النَّفسُ أنْلا خلودا"],["3A5F076B-927F-541C-AA94-39D9805E67C6","وبانَ الأحبةُ حتى فنوا","ولم يترك الدهرُ منهمْ عميدَا"],["735AABA0-28F4-570B-9BC8-119E0B660F9C","فيا دهرُ قَدْك فأَسجِح بنا","فلسنا بصخرٍ، ولسنا حديدَا"]]},"8B4001CC-8950-5B04-A898-6F5BBDD533F9":{"t":"ليس طُعمي طُعْمَ الأنامل إِذ","p":11,"s":"ليس طعمي طعم الأنامل إذ","r":"436734","v":[["A43479E3-68CC-58E0-9A2E-769D7D17D1C3","ليس طُعمي طُعْمَ الأنامل إِذ","قلَّص درُّ اللِّقاح في الصِّنبرِ"],["B62C12FB-1A5B-59D8-8463-FEE17D2D3A07","ورأيتَ الإماء كالجعثنِ البا","لي عكوفاً على قرارة قدرِ"],["CC4BE543-E690-55C8-B3D4-AC66C043FCE8","ورأيت الدُّخان كالرَّدَغِ الأصـ","جن ينباع من وراء السِّتر"],["35742339-E235-5798-B194-DB50C98E9421","حاضرٌ شركم وخيركم دَ","رٌّ خَروسٍ من الأرانب بِكْرِ"]]},"E2E5D5C6-DD32-5127-B486-1AED3A8B26AB":{"t":"نأتك أمامة إلا سُؤالاً","p":11,"s":"نأتك أمامة إلا سؤالا","r":"436886","v":[["2CFC0FC1-42CD-5D6D-B59B-8C1A989020BF","ننَأَتكَ أُمامَةُ إِلّا سُؤالاً","وَإِلّا خَيالاً يُوافي خَيالا"],["25FC31B4-5E29-5943-AD08-D7538654C215","يُوافي مَع اللَيلِ ميعادُها","وَيَأبى مَعَ الصُبحِ إِلّا زِيالا"],["857FFC82-99AC-58FE-A5EC-D1DA434AA47E","فَذَلِكَ تَبذُلُ مِن وُدِّها","وَلَو شَهِدَت لَم تُواتِ النَوالا"],["38D459C9-4A14-5CA7-8387-E372A8A2CB76","وَقَد ريعَ قَلبي إِذ أَعلَنوا","وَقيلَ أَجَدَّ الخَليطُ اِحتِمالا"],["93009ED5-65B4-5BBE-BBA3-3C9901147191","وَحَثَّ بِها الحادِيانِ النَجاءَ","مَعَ الصُبحِ لَمّا اِستَشاروا الجِمالا"],["0C4EC2D1-4013-5F96-A9E9-3A7DE4242915","بَوازِلَ تُحدى بِأَحداجِها","وَيُحذَينَ بَعدَ نِعالٍ نِعالا"],["CFDA24D9-395F-54D7-B2C9-951045711350","فَلَمّا نَأَوا سَبَقَت عَبرَتي","وَأَذرَت لَها بَعدَ سَجلٍ سِجالا"],["524743C3-51C7-56C5-9114-8DD784AE9D4C","تَراها إِذا اِحتَثَّها الحادِيا","نِ بِالخَبتِ يُرقِلنَ سَيراً عِجالا"],["BA683E44-D56F-5C80-BC1E-7D16DA2E6580","فَبِالظِلِّ بُدِّلنَ بَعدَ الهَجيرِ","وَبَعدَ الحِجالِ أَلِفنَ الرِحالا"],["289FC2C9-6BEF-571D-BBD4-4BD2C3729BD0","وَفيهِنَّ خَولَةُ زَينُ النِسا","ءِ زادَت عَلى الناسِ طُرّاً جَمالا"],["23B6802A-66B2-5B1F-A119-623C6B44C4A9","لَها عَينُ حَوراءَ في رَوضَةٍ","وَتَقرو مَعَ النَبتِ أَرطىً طِوالا"],["A521C950-0FDB-58FD-ADBD-554A8CCA22DB","وَتُجري السِواكَ عَلى بارِدٍ","يُخالُ السَيالَ وَلَيسَ السَيالا"],["A827D190-E4F3-51D6-AC62-4AC75686758F","كَأَنَّ المُدامَ بُعَيدَ المَنامِ","عَلَيها وَتَسقيكَ عَذباً زُلالا"],["7D9B65C9-EFC1-51C2-A5A1-449FC5746A71","كَأَنَّ الذَوائِبَ في فَرعِها","حِبالٌ تُوَصِّلُ فيها حِبالا"],["D6D442FE-4B79-5E41-AFCE-6D69D116D2EF","وَوَجهٌ يَحارُ لَهُ الناظِرونَ","يَخالونَهُم قَد أَهَلّوا هِلالا."],["84C81B4E-A1EF-5DB6-8593-CCB93F69332B","إِلى كَفَلٍ مِثلِ دِعصِ النَقا","وَكَفٍّ تُقَلِّبُ بيضاً طِفالا"],["F1B04293-A12E-5D4B-B230-34CEE5FD2BB1","فَبانَت وَما نِلتُ مِن وُدِّها","قِبالاً وَلا ما يُساوي قِبالا"],["9BD3C80E-A4D8-5791-9359-ABD9CB45BDAE","وَكَيفَ تَبُتّينَ حَبلَ الصَفا","ءِ مِن ماجِدٍ لا يُريدُ اِعتِزالا"],["EBA90D20-CD38-5AC0-877F-AF51507AEB67","أَرادَ النَوالَ فَمَنَّيتِهِ","وَأَضحى الَّذي قُلتِ فيهِ ضَلالا"],["CD74C9E8-77A4-578C-AFFC-81E10932C003","فَتىً يَبتَني المَجدَ مِثلُ الحُسا","مِ أَخلَصَهُ القَينُ يَوماً صِقالاً"],["9268125B-1F6B-54DB-BC54-782310BC9EEB","يَقودُ الكُماةَ لِيَلقى الكُماةَ","يُنازِلُ ما إِن أَرادوا النِزالا"],["5FACFE97-BA82-5F95-9110-B41D17C9DB3C","تُشَبِّهُ فُرسانَهُم في اللِقاءِ","إِذا ما رَحى المَوتِ دارَت حِيالا"],["F9105C19-D4A4-53F3-8381-FE1638CE1FE6","وَتَمشي رِجالاً إِلى الدارِعينَ","كَأَعناقِ خَورٍ تُزجّي فِصالا"],["38C87135-2889-5F2C-8533-A234487BEB1F","وَتَكسو القَواطِعَ هامَ الرِجا","لِ وَتَحمي الفَوارِسُ مِنّا الرِجالا"],["BF5C544B-2EE8-5E07-9A9F-2AD07E8A2F27","وَيَأبى لِيَ الضَيمَ ما قَد مَضى","وَعِندَ الخِصامِ فَنَعلو جِدالا"],["9952606E-D190-59E2-B4DF-96CD3DEFB5E3","بِقَولٍ يَذَلُّ لَهُ الرائِضو","نَ وَيَفضُلُهُم إِن أَرادوا فِضالا"],["4665B077-4581-56A6-B3BE-29C335D2CA93","وَهاجِرَةٍ كَأُوارِ الجَحي","مِ قَطَعتُ إِذا الجُندُبُ الجَونُ قالا"],["2EA74F98-D5F9-5263-BFF0-51ED28D762FB","وَلَيلٍ تَعَسَّفتُ دَيجورَهُ","يَخافُ بِهِ المُدلِجونَ الخَبالا"]]},"E803321F-DA86-54FE-BDD5-1702728AE0F2":{"t":"نَأَتكَ أُمامَةُ إِلّا سُؤالا","p":11,"s":"نأتك أمامة إلا سؤالا 2","r":"436887","v":[["132FC1D0-A267-580D-A435-BFF59E4C2CB7","نَأَتكَ أُمامَةُ إِلّا سُؤالا","وَأَعقَبَكَ الهَجرُ مِنها الوِصالا"],["E82EF896-2D2A-57EC-8342-2EEC9B3C1376","وَحادَت بِها نِيَّةٌ غَربَةٌ","تُبَدِّلُ أَهلَ الصَفاءِ الزِيالا"],["5168B33E-0F1A-5311-8975-53A5FEB8C027","وَنادى أَميرُهُمُ بِالفِرا","قِ ثُمَّ اِستَقَلّوا لِبَينٍ عِجالا"],["7A4304A9-F98F-543A-B2EF-0C8867ABA12E","فَقَرَّبنَ كُلَّ مُنيفِ القَرا","عَريضِ الحَصيرِ يَغولُ الحِبالا"],["1656AF72-BCED-5B2A-A7B9-8DF7F04BA5D7","إِذا ما تَسَربَلنَ مَجهولَةً","وَراجَعنَ بَعدَ الرَسيمِ النِقالا"],["D958A681-779E-503F-9477-38D73690A413","هَداهُنَّ مُشتَمِراً لاحِقاً","شَديدَ المَطا أَرحَبِياً جُلالا"],["2B3DFE31-8577-535E-9671-E4B9BD57050F","تَخالُ حُمولَهُمُ في السَرا","بِ لَما تَواهَقنَ سُحقاً طِوالا"],["D6081ADE-0ED3-599C-9EC5-0C0524832167","كَوارِعَ في حائِرٍ مُفعَمٍ","تَغَمَّرَ حَتّى أَتا وَاِستَطالا"],["C24E7F5E-E67D-5619-816E-4E7627CBC81A","كَسَونَ هَوادِجَهُنَّ السُدو","لَ مُنهَدِلاً فَوقَهُنَّ اِنهِدالا"],["FF4D8BBC-7028-5448-881C-1560C218B1A8","وَفيهِنَّ حورٌ كَمِثلِ الظِبا","ءِ تَقرو بِأَعلى السَليلِ الهَدالا"],["980DAEB7-0A14-5588-BD2A-6C0392833612","جَعَلنَ قُدَيساً وَأَعناءَهُ","يَميناً وَبُرقَةَ رَعمٍ شِمالا"],["C308A50C-A959-5B04-A9A1-25FE8A3F35B5","نَوازِعُ لِلخالِ إِذ شِمنَهُ","عَلى الفُرُداتِ يَحُلُّ السِجالا"],["CC87137C-4853-5461-AABF-2131FC078D16","فَلَمّا هَبَطنَ مَصابَ الرَبيعِ","بُدِّلنَ بَعدَ الرِحالِ الحِجالا"],["AFE684AF-8027-55DF-A341-6CD2AB396E21","وَبَيداءَ يَلعَبُ فيها السَرا","بُ يَخشى بِها المُدلِجونَ الضَلالا"],["55094BC4-FC91-5014-B5B7-BEE33C8A331F","تَجاوَزتُها راغِباً راهِباً","إِذا ما الظِباءُ اِعتَنَقنَ الظِلالا"],["09F73A4A-2ED7-54A4-A443-D4ECE963CB98","بِضامِزَةٍ كَأَتانٍ الثَمي","لِ عَيرانَةٍ ما تَشَكّى الكَلالا"],["38B9A29E-2C2F-53DB-9511-3CE8B26E219C","إِلى اِبنِ الشَقيقَةِ أَعمَلتُها","أَخافُ العِقابَ وَأَرجو النَوالا"],["64D44E35-FB89-59CB-AEF4-BCCD110E0C7D","إِلى اِبنِ الشَقيقَة خَيرِ المُلوكِ","أَوفاهُمُ عِندَ عَقدٍ حِبالا"],["96269589-1DDC-55F3-A7D4-074F9B021EF0","أَلَستَ أَبَرَّهُمُ ذِمَّةً","وَأَفضَلَهُم إِن أَرادوا فِضالا"],["90108234-967F-57BF-B90C-9807F3EC8DED","فَأَهلي فِداؤُكَ مُستَعتِباً","عَتَبتَ فَصَدَّقتَ في المَقالا"],["34033651-B55A-5527-B06C-BD68A384A406","أَتاكَ عَدُوٌّ فَصَدَّقتَهُ","فَهَلّا نَظَرتَ هُديتَ السُؤالا"],["CC1EFC21-218D-5228-85A8-159CF7E244C9","فَما قُلتُ ما نَطَقوا باطِلاً","وَلا كُنتُ أَرهَبُهُ أَن يُقالا"],["A48EBC8B-6647-5000-99B0-3E99E4FE6492","فَإِن كانَ حَقاً كَما خَبَّروا","فَلا وَصَلَت لي يَمينٌ شِمالا"],["8EBBC056-1BD7-5458-B6AC-96A81245895B","تَصَدَّق عَلَيَّ فَإِني اِمرِؤٌ","أَخافُ عَلى غَيرِ جُرمِ نَكالا"],["FBC0F292-D94F-549C-ADA4-CE54A8996193","وَيَومٍ تَطَلَّعُ فيهِ النُفو","سُ تُطَرِّفَ بِالطَعنِ فيهِ الرِجالا"],["8D63F35E-A91C-5777-80B4-C9D622CFE569","شَهِدتَ فَأَطفَأتَ نيرانَهُ","وَأَصدَرتَ مِنهُ ظِماءً نِهالا"],["3F53594F-0D9C-594C-AD92-8446618374F0","وَذي لَجَبٍ يُبرِقُ الناظِر","ينَ كَاللَيلِ أُلبِسَ مِنهُ ظِلالا"],["21A9C241-7E94-5B99-BFD7-6103EC4C29CE","كَأَنَّ سَنا البَيضِ فَوقَ الكُما","ةِ فيهِ المَصابيحُ تُخبي الذُبالا"],["4EB1F7C3-5C68-516F-9805-A26DBCF1022C","صَبَحتُ العَدُوَّ عَلى نَأيِهِ","تَريشُ رِجالاً وَتَبري رِجالا"]]},"5920BEB4-E303-5186-BFB3-A353C3EF7DFA":{"t":"هل عرفتَ الدّيار عن أَحْقابِ","p":11,"s":"هل عرفت الديار عن أحقاب","r":"436721","v":[["BBDDBF23-9E62-5FD1-93E3-99C17C574126","هل عرفتَ الدّيار عن أَحْقابِ","دارساً آيُها كخطّ الكتابِ"],["B1C4FB5C-C7CD-5CF3-B8FF-2DBF512E818E","وكأني لمّا عرفتُ ديار الـ","ـحيِّ بالسَّفْح عن يمين الحُباب"],["A29FA5AD-D577-5E77-809C-F262B2C19030","يَسَرٌ حارض الرِّبابةَ حتى","راحَ قَصْراً، وضِيمَ في الأَنداب"],["C84B838F-F3D0-560D-973E-982F8D2E5A81","جزعاً منك يا بن سعدٍ وقد أخـ","ـلقَ منك المشيبُ ثوبَ الشَّبابِ"]]},"1729900D-C2C5-5306-868E-ABDD33E9BDF6":{"t":"هل لا يُهيّج شوقك الطَّللُ","p":11,"s":"هل لا يهيج شوقك الطلل","r":"436722","v":[["CDB461D0-44A8-5EDC-996C-8A13D152F2F1","هل لا يُهيّج شوقك الطَّللُ","أم لا يفرطُ شيخكَ الغزلُ"],["FFA1B219-EBA3-578F-9DD1-60F333DF0140","أمْ ذا القَطِين أصاب مقتله","منه وخانوه إذا احتملوا"],["2FEA6FF2-7899-5A2E-934F-E6BDE1C9FAC7","ورأيت ظعهُمُ مقفيةً","تعلو المخارم سيرها رملُ"],["3AF73527-81F7-5505-81B2-C020E1F36F29","قَنأَ العُهُون على حواملها","وعلى الرُّهَاوِياتِ، والكللُ"],["03713F61-BF00-5E4D-A7C7-E84A8DBD71AE","وكأنَّ غِزلان الصَّريمِ بها","تحتَ الخدورِ يظلهاَ الظُّلَلُ"],["DE0820DC-2B16-5258-B11F-6433565D3CC5","تامت فؤادك يوم بينهمِ","عند التفرق ظبية عُطُل"],["1B129110-2A09-5A52-A426-ED3082929D81","شَنِفتْ إلى رشأ تُربّبهُ","وَلَهَا بذاتِ الحاذِ معْتَزَلُ"],["488D5B73-6121-59CC-83A0-31E80ECF9CFD","ظلٌّ إذا ضحِيت ومرتَقَبٌ","كيلا يكون لليلها دَغَلُ"],["EDB94920-3591-5155-A41E-21CD014A98F3","فسقى منازلها وحلتها","قردُ الرَّبَابِ لِصَوتِهِ زجلُ"],["6CB3616A-3B2F-57FB-AFEE-4DF9B2B2971C","أبدى محاسنهُ لناظرهِ","ذاتَ العِشاء مُهَلّب خَضِلُ"],["38DB07A4-480F-52CB-B183-064EECCCEECF","مُتحلّب تهوي الجَنوبُ به","فتكادُ تعدلُهُ وينجَفِلُ"],["2824B162-68E0-5073-9E4F-A9A974DF1667","وَضَعت لدى الأصناعِ ضاحيةً","فَوَهى السُّيوب، وحُطّتِ العِجَلُ"],["598BB489-FD53-5042-BE8A-86946965B3BD","فسقى امرأ القيس بن....","م الأكرَمينَ لذكرهِمْ نَبَلُ"],["27B6845D-2EB9-5B7D-8C9C-F5E91D233570","كم طعنةٍ لكَ غير طائشةٍ","ما أن يكونُ لجُرحها خَلَلُ"],["AB58007A-22EA-5CC8-B16F-AC283D61C1F0","فطعتها، وضربت ثانيةً","أخرى، وتنزلُ إنْ هُمُ نزلوا"],["1D821F03-5F6E-54AB-99EF-1F59F2EE1671","يَهَبُ المخاضَ على غواربها","زَبَدُ الفحول مَعَانُهَا بقلُ"],["FA76B0F9-D3E4-50E0-B9D9-8A0FB6AFF63A","وعِشارها بعد المخاض وقد","صافتْ وعمَّ رِباعها النَّفَل"],["05747F87-ED6D-591E-A604-63EEB85B4717","وإذا المُجزى حان مشربةُ","عند المصيفِ وسَرّهُ النَّهَلُ"],["D866D8CB-4C8F-5515-8C14-3F4C1D1BCB0F","رَشْفُ الذّناب على جَمَاجمها","ما إِن يكونُ لحوضها سَمَلُ"]]},"06FF8AA4-29CA-5F9D-95B4-48C3F5D0799A":{"t":"وإذا العذارى بالدخان تقنعت","p":11,"s":"وإذا العذارى بالدخان تقنعت","r":"436733","v":[["2AE213A3-35D8-532C-99BF-DFF25040000A","وإذا العذارى بالدخان تقنعت","واستعجلت نَصبَ القدور فملّتِ"],["CFC629B3-E8E0-50F2-AFA2-867BBA0D4C67","درّتْ بأرزاقِ العيال مغالق","بيدي مِنْ قمعِ العشارِ الجلةِ"]]},"3D6CF05B-ECC8-5F7B-85E7-51E4B5935961":{"t":"وحمال أثقالٍ إذا هي أعرضَتْ","p":11,"s":"وحمال أثقال إذا هي أعرضت","r":"436735","v":[["F7506F20-56A0-5FA2-90C0-0FA7460637A4","وحمال أثقالٍ إذا هي أعرضَتْ","عن الأصل لا يَسطيعها المُتكلّف"]]},"65607BF0-2A2D-5233-8D63-857818CC9C5C":{"t":"وشاعر قوم أُولي بِغضة","p":11,"s":"وشاعر قوم أولي بغضة","r":"436740","v":[["49058AA4-65DF-567E-BEFA-2D167FA8DEE2","وشاعر قوم أُولي بِغضة","قمعتُ فصارُوا لئاماً ذلالاَ"]]},"B96ADA32-6CD7-572F-A2AD-87BF107D3527":{"t":"وقد برز عنه الرجل ظلماً ورملوا","p":11,"s":"وقد برز عنه الرجل ظلما ورملوا","r":"436731","v":[["B088E897-2CCF-50E1-9DA7-64D861B4934B","وقد برز عنه الرجل ظلماً ورملوا","علاوته يوم العروبة بالدم"]]},"2C0BC3DD-432C-5ED2-B53E-692E03F849F2":{"t":"ومَوْلَى ضعيفِ النّصرِ ناءٍ مَحَلُّهُ","p":11,"s":"ومولى ضعيف النصر ناء محله","r":"436720","v":[["415B77FA-19C5-57FA-AB45-0D26DEB055FA","ومَوْلَى ضعيفِ النّصرِ ناءٍ مَحَلُّهُ","جَشِمْتُ له ما ليس مني جاشِمُه"],["BBB910E5-306E-5B5D-9CBC-1BC7407859D9","إذا ما رآبي مقبلاً شدَّ صوتُهُ","على القِرن واعلولى على مَنْ يُخاصمه"],["08425D8F-F546-57A3-9430-7B9007A59C56","وأجردَ ميّاحٍ وهبتُ بسرجهِ","لمُختبطٍ أو ذي دلال أُكارمُه"],["FF44176E-0339-500F-A0C3-8F92B1362F86","على أنَّ قومي أسلموني وعُرّتي","وقومُ الفتى أظفارُه ودعائمُه"]]},"6BCB20A9-EE2D-51C1-8F3B-C70B8D7F6E2C":{"t":"يا رب من أسفاهُ أحلامه","p":11,"s":"يا رب من أسفاه أحلامه","r":"436724","v":[["8C7C66B8-B4D3-5A5A-9400-B5C434E06210","يا رب من أسفاهُ أحلامه","أن قيل يوماً إن عمراً سكور"],["8BBA23FD-853D-5544-AFAB-8012DD75581D","إن أك مسكيراً فلا أسرب","وَغْلاً ولا يسلم مني البعيرْ"],["13DB187E-6071-5E75-9149-85D842371AFF","والزِّق مُلْك لمن كان له","والملك فيه طويلُ و قصيرْ"],["CEDBB0CF-400F-5759-8B8C-133E473B027D","فيه الصَّبوحُ الذي يجعلني","ليثَ عِفرين والمال كثيرْ"],["13F049CC-B02C-569A-9995-1F2544FFE337","فأوّلَ الليل فتًى ماجدٌ","وآخر الليل ضبعانٌ عثور"],["FE670E50-B379-59AE-8540-6965688A9540","قاتلك الله من مشروبةٍ","لو أن ذا مرةٍ عنك صبورْ"]]},"FC02382F-B6AF-585B-AC85-8D60973244BB":{"t":"يا لهفَ نفسي على الشباب ولم","p":11,"s":"يا لهف نفسي على الشباب ولم","r":"436716","v":[["ACCE0461-76C9-5873-A344-3741A6971D4D","يا لهفَ نفسي على الشباب ولم","أفقد به إذ فقدتُهُ أَمَمَا!"],["0B0F8586-9EE8-55A2-8948-BE8FC6257B53","قد كنت في مَيْعةٍ أُسرُّ بها","أمنعُ ضَيْمي وأُهبِط العُصُما"],["9ED3565A-991E-55B6-BF04-CCBD88150CCE","وأسحب الرّيط والبرود إلى","أدنى تجاري وأَنفُض اللِّمما"],["B6576CCF-53DC-5481-9562-FC136CD6EE06","لا تغبطِ المرءَ أم يُقالَ لهُ","أمسى فلانٌ لعمرِهِ حكمَا"],["24B31ACC-387F-57D8-849A-9161A1F18A8B","إنْ سرَّه طولُ عيشهِ، فلقد","أضحى على الوجهِ طولُ ما سَلِما"],["EBFE5F02-013C-523B-AFAB-FD419EDD415F","إِنَّ من القوم مَنْ يُعاشُ به","ومنهمُ مَنْ تَرى به دَسَما"]]}}}