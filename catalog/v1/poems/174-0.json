{"v":1,"poems":{"AB6D2230-FA8F-5C8D-AD5F-C5C4E76AAFB6":{"t":"آيات نبوَة الهَوى بي ظَهَرَت","p":174,"s":"آيات نبوة الهوى بي ظهرت","r":"473976","v":[["E80C2E49-DA2D-598D-A028-93CD0D2FE4E4","آيات نبوَة الهَوى بي ظَهَرَت","قَلبي كَتَمت وَفي زَماني اِشتَهرت"],["02C44A0F-C64C-5759-BE25-473B8FB4C53C","هَذي كَبدي إِذا السَماء اِنفَطَرَت","شَوقاً وَكَواكِب الدُموع اِنتَثَرَت"]]},"D70302CD-E32C-5955-9219-F1A70B83A547":{"t":"أَبداً تَحنُّ إِلَيكُمُ الأَرواحُ","p":174,"s":"أبدا تحن إليكم الأرواح","r":"473980","v":[["4E3F705F-0301-5219-A432-1B604E091BD5","أَبداً تَحنُّ إِلَيكُمُ الأَرواحُ","وَوِصالُكُم رَيحانُها وَالراحُ"],["3E1BDCBB-8FD4-51EA-85DE-25DC313265D7","وَقُلوبُ أَهلِ وِدادكم تَشتاقُكُم","وَإِلى لَذيذ لقائكم تَرتاحُ"],["697D4997-96CD-5179-A668-4C74A267B9B5","وَا رَحمةً للعاشِقينَ تَكلّفوا","ستر المَحبّةِ وَالهَوى فَضّاحُ"],["1D9D52BA-DD86-5581-8109-8F39211127AF","بِالسرِّ إِن باحوا تُباحُ دِماؤُهم","وَكَذا دِماءُ العاشِقينَ تُباحُ"],["AAB68A93-A9A7-5680-968A-92F1269DD90D","وَإِذا هُم كَتَموا تَحَدّث عَنهُم","عِندَ الوشاةِ المَدمعُ السَفّاحُ"],["7937271A-28C6-5F22-B00C-2A249E280987","أَحبابنا ماذا الَّذي أَفسدتمُ","بِجفائكم غَير الفَسادِ صَلاحُ"],["F175352C-1001-5AEA-AB57-3A2843A54F1F","خَفضَ الجَناح لَكُم وَلَيسَ عَلَيكُم","لِلصَبّ في خَفضِ الجَناح جُناحُ"],["6841E415-B2AB-5E15-AFC1-FFA4BA208111","وَبَدَت شَواهِدُ للسّقامِ عَلَيهمُ","فيها لِمُشكل أمّهم إِيضاحُ"],["A9977775-6F64-5BE0-AB7C-3590C4F350F2","فَإِلى لِقاكم نَفسهُ مُرتاحةٌ","وَإِلى رِضاكُم طَرفه طَمّاحُ"],["7AD97E5D-F85E-5BFA-894F-79A2556A8B3A","عودوا بِنورِ الوَصلِ مِن غَسَق الدُّجى","فَالهَجرُ لَيلٌ وَالوصالُ صَباحُ"],["03DE193A-0786-5069-ADAA-22DDE59B5715","صافاهُمُ فَصَفوا لَهُ فَقُلوبهم","في نُورِها المِشكاةُ وَالمِصباحُ"],["5F8BBEC9-68F5-5445-8249-4160EFC7221B","وَتَمَتّعوا فَالوَقتُ طابَ لِقُربِكُم","راقَ الشّراب وَرَقّتِ الأَقداحُ"],["9106B1AE-8401-51DA-8594-2688E325C56E","يا صاحِ لَيسَ عَلى المُحبِّ مَلامَةٌ","إِن لاحَ في أُفق الوِصالِ صَباحُ"],["88B2C1A6-B388-5E66-BB19-6838A8E16337","لا ذَنبَ لِلعُشّاقِ إِن غَلَبَ الهَوى","كِتمانَهُم فَنما الغَرامُ فَباحوا"],["6829FB8F-5957-5081-9D0E-B0B9376FF390","سَمَحوا بِأَنفُسِهم وَما بَخِلوا بِها","لَمّا دَروا أَنّ السَّماح رَباحُ"],["C7388ACA-9F09-5383-AB01-7B6A52CD5783","وَدعاهُمُ داعي الحَقائقِ دَعوة","فَغَدوا بِها مُستَأنسين وَراحوا"],["C01F860B-CD3F-555D-86D5-6A3863A35E09","رَكِبوا عَلى سنَنِ الوَفا وَدُموعهُم","بَحرٌ وَشِدّة شَوقهم مَلّاحُ"],["FEDE6162-4340-5F1B-AB95-A51626CDA473","وَاللَّهِ ما طَلَبوا الوُقوفَ بِبابِهِ","حَتّى دعوا فَأَتاهُم المفتاحُ"],["826611D4-DAFE-5C6D-B334-D702FF98D803","لا يَطربونَ بِغَيرِ ذِكر حَبيبِهم","أَبَداً فَكُلُّ زَمانِهم أَفراحُ"],["8B29BF9E-FAC4-51F9-9502-11AD8AAAB189","حَضَروا وَقَد غابَت شَواهِدُ ذاتِهم","فَتَهَتّكوا لَمّا رَأوه وَصاحوا"],["5E7C8303-AEDB-58C4-9AFE-55203FDFE814","أَفناهُم عَنهُم وَقَد كشفَت لَهُم","حجبُ البقا فَتَلاشتِ الأَرواحُ"],["905E0AF7-8257-52F5-92E6-D2EA0F0B079A","فَتَشَبّهوا إِن لَم تَكُونوا مِثلَهُم","إِنَّ التَّشَبّه بِالكِرامِ فَلاحُ"],["659A277C-CFF4-5F8D-B72D-53A330A5399F","قُم يا نَديم إِلى المدامِ فَهاتها","في كَأسِها قَد دارَتِ الأَقداحُ"],["C639E394-AC61-5EC4-AAD1-4EFA07302917","مِن كَرمِ أَكرام بدنّ ديانَةٍ","لا خَمرَة قَد داسَها الفَلّاحُ"],["D9BA660D-AD3E-50B5-BA22-A2B8E75D050E","هيَ خَمرةُ الحُبِّ القَديمِ وَمُنتَهى","غَرض النَديم فَنعم ذاكَ الراحُ"],["5A46FEAA-06B4-5F83-A45F-569A61D7AFC2","وَكَذاكَ نوحٌ في السَّفينة أَسكَرَت","وَلَهُ بِذَلِكَ رَنَّةً وَنِياحُ"],["1168482A-5451-5924-93F9-DFA6CDCE563E","وَصَبَت إِلى مَلَكوتِهِ الأَرواحُ","وَإِلى لِقاءِ سِواه ما يَرتاحُ"],["B2780107-CD69-584B-BA0A-0B62F53C2138","وَكَأَنَّما أَجسامهُم وَقُلوبهُم","في ضَوئِها المِشكاةُ وَالمِصباحُ"],["80F70D8C-E1A6-5605-980E-F304528EA9DB","مَن باحَ بَينَهُم بِذِكرِ حَبيبِهِ","دَمهُ حلالٌ لِلسّيوفِ مُباحُ"]]},"C978BCBE-AC9B-56E4-B925-5692A25B3A2B":{"t":"أَتيهُ فَلا أَدري مِن التيهِ مَن أَنا","p":174,"s":"أتيه فلا أدري من التيه من أنا","r":"473998","v":[["2C04DADC-0A42-5324-A609-CFD24CCE5FDF","أَتيهُ فَلا أَدري مِن التيهِ مَن أَنا","سِوى ما يَقولُ النّاسُ فيّ وَفي جِنسي"]]},"D019717A-4AA1-5933-ACFB-CA9BC809907B":{"t":"أَحنّ إِلى أَرضِ الحِجازِ وَحاجَتي","p":174,"s":"أَحنّ إِلى أَرضِ الحِجازِ وَحاجَتي","r":"473996","v":[["1A8C322D-ECBF-5B04-B6A8-66F6A184E689","أَحنّ إِلى أَرضِ الحِجازِ وَحاجَتي","خِيامٌ بِنَجدٍ دونَها الطّرف يَقصرُ"],["2C1EC7DB-C0B6-50E0-BE9A-3E147FBA5EEC","وَما نَظَري نَحوَ الحِجاز بِنافعي","أَجل وَلَكِنّي عَلى ذَاكَ أَنظرُ"],["2899DEB3-D006-55B9-9483-6F862CCF5FC1","أَفي كُلِّ يَومٍ نَظرَةٌ ثُمّ عَبرةٌ","لِعَينيك يَجري ماؤُها يَتَحدّرُ"],["7471FEA7-625A-5DB9-AEE0-DF22071D62F3","مَتى يَستريحُ القَلبُ إِمّا مُجاور","حَزين وَإِمّا نازِحٌ يَتَذَكّرُ"]]},"AB9CD1D9-796C-5579-939B-4F0B90CBEDF0":{"t":"أَرى قدمي أَراقَ دَمي","p":174,"s":"أرى قدمي أراق دمي","r":"474045","v":[["A2752337-22D7-54D8-8F3C-FD52BCBC063D","أَرى قدمي أَراقَ دَمي","وَهانَ دَمي فَها نَدَمي"]]},"130F3221-C0DF-5053-9880-2474832ECC82":{"t":"أَقسَمتُ بِصَفو حُبِّكُم في القدم","p":174,"s":"أقسمت بصفو حبكم في القدم","r":"474043","v":[["70384F0F-6D78-5135-85C9-86824D20F0C0","أَقسَمتُ بِصَفو حُبِّكُم في القدم","ما زَلَّ إلى غَيرِ هَواكُم قَدَمي"],["19D652DB-6C10-5FBA-BFC4-46ED687BCDC9","قَد أَمزج حُبّكُم بِلَحمي وَدَمي","قَطعي صلتي وَفي وُجودي عَدَمي"]]},"19229A1A-BD3C-5CB5-B0FA-4256FD29D48D":{"t":"أَقول لِجارَتي وَالدَّمعُ جارٍ","p":174,"s":"أقول لجارتي والدمع جار","r":"473986","v":[["80D9AC35-58E7-520D-8ED7-5A6134D5F4A7","أَقول لِجارَتي وَالدَّمعُ جارٍ","وَلي عَزم الرَّحيل إِلى الدِيارِ"],["DA9F337A-8DAA-5895-AFB9-999D51750D2D","ذَريني أَن أَسيرَ وَلا تَنوحي","فَإِنَ الشّهبَ أَشرَفها السّواري"],["DB2F8897-8FA3-538A-A19A-04A829561BFA","فَسَيرُ السائرينَ إِلى نَجاحٍ","وَحالُ المترَفينَ إِلى بوارِ"],["0CE258FB-0714-574C-A686-BAF3DF7EBF47","وَأَنّي في الظَّلامِ رَأَيت ضوءاً","كَأَنّ اللَيل بدّلَ بِالنَهارِ"],["8F3BE464-7881-5CF2-8126-DDB605C35010","فَيَأتيني مِنَ الصَّنعاءِ بَرقٌ","فَذكّرني بِهِ قُرب الدّيارِ"],["3B62C54C-C815-5DCE-B185-3E1538374485","وَكَيفَ يَكونُ للدّيدانِ طَعمٌ","وَفَوقَ الفَرقَدينِ عَرفتُ داري"],["601729A2-A412-5ACE-B4F3-333DD1F6476C","أَأَرضي بِالإِقامةِ في فَلاةٍ","وَأَربَعة العَناصِر في جواري"],["E653D901-324C-572B-B89D-88EC7474DFE0","إِلى كَم آخذ الحَيّات صحبي","إِلى كَم أَجعل التنّين جاري"],["0EF7162D-647D-57EA-BF37-79EC64A7C46D","إِذا لاقيت ذاكَ الضّوء أَفنى","فَلا أَدري يَميني مِن يَساري"],["B22E227A-45B7-580E-9CB2-328D093E6E15","وَلي سِرٌّ عَظيمٌ أَنكَروهُ","يَدقّونَ الرّؤوسَ عَلى الجدارِ"]]},"47DF15A3-16F8-54C2-9C13-9445F82993C9":{"t":"أَيُّها السائِقُ يَبغي دارَ مي","p":174,"s":"أيها السائق يبغي دار مي","r":"474065","v":[["96AC7D9D-F0E7-5AD1-BDC1-E97A7F3578F7","أَيُّها السائِقُ يَبغي دارَ مي","وَعريباً دونَ ذيّاك اللّوي"],["6051D44F-B596-5E63-922C-F3B45A48F9BE","هَذِهِ الباناتُ باناتُ الحِمى","حَيّها يا مَيّت الأَشواقِ حي"],["CC7C9B76-0CDE-5FDA-B446-7ACD67675834","وَاِطوِ ذِكرَ البانِ في ظلِّ النّقا","بَينَ سَفحِ السَّفحِ مِن سلعٍ وَطي"],["268696A6-CCF4-55F3-8887-D3A8709407AF","وَإِذا الحُسن بَدا فَاِسجُد لَهُ","فَسُجودُ الشُّكرِ فَرضٌ يا أَخي"],["8F678577-8ABB-568E-9DEC-2D13647A38D2","هَذِهِ أَنوارُ لَيلى قَد بَدَت","فَلِسَلبِ العَقلِ يا صاحي نهي"],["667015C8-F13E-5A56-AE32-52743D739989","فَالفَتى ما سَلبته جُملة","لا الَّذي تَسلبه شَيئاً فتي"],["3EE833CC-C6EF-5DF5-A9D5-7A464DFE3DBC","كُلُّ حَيٍّ في هَواها مَيّت","إِنَّما ميتُ هَواها ذاكَ حي"]]},"77C988F3-5F14-59A1-8FD4-3D19BD885B77":{"t":"إِذا المَرء لَم يَحتل وَقَد جَدّ جَدّه","p":174,"s":"إِذا المَرء لَم يَحتل وَقَد جَدّ جَدّه","r":"473992","v":[["5695C190-ED96-5939-9252-F71C15AE473C","إِذا المَرء لَم يَحتل وَقَد جَدّ جَدّه","أَضاعَ وَقاسى أَمره وَهوَ مدبرُ"],["3C66140B-84D8-5B8F-A3B9-1EFB863E20F1","وَلَكِن أَخو الحَزم الَّذي لَيسَ نازلا","بِهِ الأَمرُ إِلا وَهوَ لِلقَصد مبصرُ"],["F4C7D4C4-B20A-518C-B244-935035E1A2C3","فَذاكَ قَريعُ الدَّهرِ ما عاشَ حَولَهُ","إِذا سدّ مِنهُ منخرٌ جاشَ منخرُ"]]},"A27C682A-0F01-56EE-82FF-6A5DD214DC6C":{"t":"إِذا النَّفسُ لَم تَشره إِلى طَلبِ العُلا","p":174,"s":"إذا النفس لم تشره إلى طلب العلا","r":"474055","v":[["BC94193D-6AE6-5B75-9CDD-A4161B6D7125","إِذا النَّفسُ لَم تَشره إِلى طَلبِ العُلا","فَتلكَ مَعَ الأَمواتِ في الحَيوانِ"]]},"B533549E-8513-5188-A37A-49016CDE7D71":{"t":"إِذا ما أَتَتنا الرّيحُ مِن نَحوِ أَرضِهِ","p":174,"s":"إذا ما أتتنا الريح من نحو أرضه","r":"473973","v":[["6F6CB81C-10AE-507E-A765-61CB6789ADCA","إِذا ما أَتَتنا الرّيحُ مِن نَحوِ أَرضِهِ","أَتَتناه بِريّاه مطاب فَطابَ هبوبُها"],["21135CCB-3874-5689-AC38-10703C904F9E","أَتَتنا بِعَرفٍ خالِد المِسك عَنبرٍ","وَريحِ خُزامى باكَرتهُ جنوبُها"],["85318889-637D-5B5E-9A96-985AAEE48F3F","أَحنّ لِذكراهُ إِذا ما ذَكَرتُهُ","وَتَنهل عَبراتٌ تَفيض غُروبها"],["B4D77A2A-B52A-566E-BB4A-6C08EA1FD3EC","حَنينُ أَسيرٍ نازحٍ شدّ قَيدهُ","وَأَعوال نَفسٍ غابَ عَنها حَبيبها"]]},"EC77EA0C-D0B7-5826-8C7F-34C5A2BA477B":{"t":"اليَوم أَيقَنتُ أَن الحُبَّ مُتلِفةٌ","p":174,"s":"اليوم أيقنت أن الحب متلفة","r":"473989","v":[["C952FDB3-8C9F-5ECA-B576-AFFC84DF98D0","اليَوم أَيقَنتُ أَن الحُبَّ مُتلِفةٌ","وَأَنّ صاحِبهُ منّي عَلى خَطرِ"],["423BA245-8B1B-5FA6-AB2F-561D28DA789B","كَيفَ الحَياة لِمَن أَمسى عَلى شَرَفٍ","مِنَ المَنيّةِ بَينَ الخَوفِ وَالحَذَرِ"],["581A97C4-4C51-5DE4-B635-A86359CA05DC","يَلومُ عَينَيهِ أَحياناً بِذَنبِهُما","وَيَحملُ الذَّنبَ أَحياناً عَلى القدرِ"]]},"E13625E7-1E5A-595C-9329-24DAE6DA83EB":{"t":"بانوا وَأَضحى الجِسمُ مِن بعدِهِم","p":174,"s":"بانوا وأضحى الجسم من بعدهم","r":"474067","v":[["E1F8A812-B043-5ACF-A1E9-830C903F0BDB","بانوا وَأَضحى الجِسمُ مِن بعدِهِم","ما تُبصِرُ العَينُ لَهُ فيّا"],["5AC7DD67-033F-58DF-8C15-58349F7F44A0","يا أَسَفي مِنهُم وَمِن قَولِهُم","ما ضَرَّكَ الفَقدُ لَنا شيّا"],["91BC9DB7-4D5C-5580-A9F6-B11998E24E15","بِأَيّ وَجهٍ أَتَلَقّاهُم","إِن وَجَدوني بَعدَهُم حَيّا"]]},"ED5FAB63-9DA6-5259-9A0F-CF82B6ED76EA":{"t":"بَلاءٌ لَيسَ يُشبِههُ بَلاء","p":174,"s":"بلاء ليس يشبهه بلاء","r":"474063","v":[["5D1A6959-5900-53AD-B61E-DD27DEC9D11C","بَلاءٌ لَيسَ يُشبِههُ بَلاء","عَداوَة غَير ذي حَسَب وَدينِ"],["6A135888-86F1-5AA3-82DF-DB76157500CD","يُبيحك مِنهَ عرضاً لَم يَصنهُ","وَيَرتَع مِنكَ في عرض مَصونِ"]]},"1C4A2634-3F59-5DD8-A640-D7763AABDCA5":{"t":"بَيني وَبَينَكَ في المَوَدّةِ نِسبَةٌ","p":174,"s":"بيني وبينك في المودة نسبة","r":"474035","v":[["53699984-471A-5417-A501-4465F730F744","بَيني وَبَينَكَ في المَوَدّةِ نِسبَةٌ","مَكتومَة عَن سرّ هَذا العالَمِ"],["9616D61D-ADC6-5C75-A7EA-94A7D9D1DCD9","نَحنُ اللّذان تعارَفَت أَرواحُنا","مِن قَبلِ خَلق اللَّه طينَةَ آدمِ"]]},"6DEB5949-FFC0-55B4-8FAA-070E3917962F":{"t":"بِكُلِّ صُبحٍ وَكُلِّ إِشراق","p":174,"s":"بكل صبح وكل إشراق","r":"474017","v":[["2D6F6C97-C86E-5367-B75A-06FFD900F465","بِكُلِّ صُبحٍ وَكُلِّ إِشراق","أَبكي عَلَيكُم بِدَمع مُشتاقِ"],["19487FFC-CAF4-5D64-A6C5-D2817F576648","قَد لَسَعت حيّة الهَوى كَبدي","فَلا طَبيب لَها وَلا راقي"],["00AE28D4-FB62-52ED-9EAA-0DB579A030B2","إِلّا الحَبيب الَّذي شغفت بِهِ","فَإِنَّهُ رقيَتي وَترياقي"]]},"46881550-8A3E-5B81-9B33-3B5414AB8C8F":{"t":"تَوَلَّت بِهجَةُ الدُّنيا","p":174,"s":"تولت بهجة الدنيا","r":"474013","v":[["00413B26-69C4-5201-9432-F1517076B407","تَوَلَّت بِهجَةُ الدُّنيا","فَكُلُّ جَديدها خَلقُ"],["471715D2-462E-5A49-987C-46BF9BB518BF","وَخانَ النّاسَ كُلَّهُم","فَما أَدري بِمَن أَثقُ"],["FF199E3C-CBC9-5CBF-9410-69BEA08D1C97","رَأَيتُ مَعالِمَ الخَيرا","تِ سدَّت دونَها الطُّرقُ"],["469FD103-F10E-5784-B8D5-128D6E3B1694","فَلا حَسبٌ وَلا نَسَب","وَلا دين وَلا خلقُ"],["A00EC8A3-A990-5470-BF20-C71461CB0B4C","فَلَست مُصَدّق الأَقوا","مِ في شَيءٍ وَلَو صَدَقوا"]]},"642B5236-808B-5C5D-A75C-74514C44B4A6":{"t":"خلقَت هَياكِلُها بِجَرعاءِ الحِمى","p":174,"s":"خلقت هياكلها بجرعاء الحمى","r":"474009","v":[["47E3C0F4-2908-504C-A7A0-21B9CD09CA7F","خلقَت هَياكِلُها بِجَرعاءِ الحِمى","وَصَبت لِمَغناها القَديم تَشَوّقا"],["1EACEB04-CCB9-5FB7-9B46-A05086BC1D28","مَحجوبَة سَفرت وَأَسفَر صُبحها","وَتَجَرَّدت عَمّا أَجدّ وَأَخلقا"],["0E662457-24F5-5841-8525-777ED5C42600","وَتَلَفّتت نَحوَ الدِّيارِ فَشاقَها","رَبع عَفَت أَطلالُهُ فتَمَزَّقا"],["6FF70001-334F-597D-AAE5-E49C7BDD9D9F","وَغَدَت تردّدُ في الفَضاءِ حَبيبها","فَيَروم مُرتَبِعاً يَروق المُرتقى"],["3FB02113-218C-5824-8ADD-524D9FB1C8AF","وَقَفَت تُسائِلُه فَرَدَّ جَوابَها","رَجعَ الصَّدى أن لا سَبيلَ إِلى اللّقا"],["9582C1BB-76C8-5233-A27D-5ECBE35A490B","فَشَكَت بِعَينِ الحالِ مَعهَد عَهدِها","أَسَفاً عَلى شَملٍ مَضى وَتَفَرَّقا"],["F49E570A-24FC-5273-A211-261D05CC3EA1","فَكَأَنَّما بَرقٌ تَأَلّق بِالحِمى","ثُمَّ اِنطَوى فَكَأَنَّهُ ما أَبرَقا"]]},"50EE4C25-2C49-570C-8859-91F0C65BFB27":{"t":"خَطرت في القَلب مِنها خَطره","p":174,"s":"خطرت في القلب منها خطره","r":"474021","v":[["7583BE0E-197F-5DF2-A606-EA8C8C101F78","خَطرت في القَلب مِنها خَطره","حَضرة القَلب بَدا ثمَّ اِضمَحَل"]]},"121D97F7-8AB1-5F26-A719-0EEAB1C1F77C":{"t":"رَأَيتُ خَيالَ الظلِّ أَكبرَ عبرَة","p":174,"s":"رَأَيتُ خَيالَ الظلِّ أَكبرَ عبرَة","r":"474015","v":[["C4B28AEF-C57B-5CED-A4B5-2635A79BE6F8","رَأَيتُ خَيالَ الظلِّ أَكبرَ عبرَة","لِمَن كانَ في عِلمِ الحَقيقَةِ راقي"],["B244BEDF-9B83-5C78-AD50-CAB37B6857B4","شخوصٌ وَأَشباحٌ تَمُرُّ وَتَنقَضي","سَريعاً وَأَشكالاً بِغَيرِ وِفاقِ"],["B401B59D-B356-5F8A-91B9-9FF99CFD44B9","تَجيئ وَتَمضي تارَةً بَعدَ تارَة","وَتَغنى جَميعاً وَالمحرّك باقي"]]},"1D73C5B0-62DA-5D0A-AD7C-79EAC67E7EC3":{"t":"رَقّ الزُّجاجُ وَرَقَّت الخَمرُ","p":174,"s":"رق الزجاج ورقت الخمر","r":"473984","v":[["CEF967CF-12F2-563E-91DF-45EFC79ABDEE","رَقّ الزُّجاجُ وَرَقَّت الخَمرُ","فَتشابَها فَتَشاكل الأَمرُ"],["4E6B1BE3-C55B-5D3A-9B81-A5712F3C7017","فَكَأَنَّها خَمرٌ وَلا قَدح","وَكَأَنَّها قَدحٌ وَلا خَمرُ"]]},"8E595850-D00F-5DF0-ABBA-FF179FA70471":{"t":"سَرى بَرقُ المَعرّةِ بَعدَ وَهنٍ","p":174,"s":"سرى برق المعرة بعد وهن","r":"474025","v":[["945E6465-E94B-53F9-A810-E118FB296E41","سَرى بَرقُ المَعرّةِ بَعدَ وَهنٍ","فَباتَ بِرامة يَصِفُ الكلالا"],["CC811DA9-B89A-5308-8FEC-D600C6E021EA","شِجار كباً وَأَفراساً وَإِبلا","وَزادَ فَكادَ أَن يَشجو الرِحالا"]]},"65FE01C0-CD38-5268-8136-99A40DA6C741":{"t":"شَرّد نومي دنِفا","p":174,"s":"شرد نومي دنفا","r":"474005","v":[["83A98145-A3EE-56C6-8D51-EF8566BC1BE4","شَرّد نومي دنِفا","يرقّ عَلى الغور نَفا"],["49265D49-BA26-57E5-93AB-A54ABD2223E4","ذَكَّرَني وَميضه","طيبَ لَيالٍ سَلَفا"],["EBE74AA1-F95D-5099-8F23-43E7E8F28C0A","وَا أَسفي عَلى الحِمى","وَأَهلِه وَا أَسَفا"],["EE3BAF3A-4EDE-57B9-9DEB-8C27E37E2B94","يا لَيتَ حادي عيسِهِم","لَمّا سَرى تَوقَّفا"],["C26F70B5-ADD9-5E17-BCEA-3518A2703115","هيَّجني لَمّا حَدا","وَمَرّ عَنّي معسفاً"],["537BF3D6-7921-59D6-A329-EB3382DB6C60","وَالعِيسُ مِن أَشواقِها","قَد رَقَصَت تَلَطّفا"]]},"C14A2188-B76B-5B73-9B41-0D5BBFAE1E0D":{"t":"شَوقي يَجلُّ عَنِ الوَسائل","p":174,"s":"شوقي يجل عن الوسائل","r":"474031","v":[["131430A9-FEDF-58BD-B3D9-68992F7B7D1C","شَوقي يَجلُّ عَنِ الوَسائل","وَهوَى ينزّه عَن مُماثِل"],["E45A722B-C15F-56B4-B317-7AA5B5FFAA20","شَوقي يُجدّدهُ الزَّمان","إِلَيكَ لا نَحوَ المَنازل"],["6FD2DA93-19C8-50CB-9557-5DFA6D46EC28","بُشّرتُ أَنّك قاتِلي","يا حَبَّذا إِن كُنتَ قاتل"],["08C7DC19-B853-5E89-A46C-78B725A72E9A","زَوّد فُؤادي نَظرَة","مِن حُسنِ وَجهِكَ فَهوَ راحِل"],["149F9FFF-9E98-57E0-B7BA-3C918B5983F4","روحي فِداء مُبَشِّري","إِن صَحَّ أَنَّكَ لي مُواصِل"],["16C81B39-02D1-501A-A184-E0136CF49020","مُستَشفِعٌ بِوَسائلٍ","وَأَلَذّ مِن إِحدى الوَسائل"],["8CF0DFD7-A074-5A24-AD1E-EEA7F5702DF6","سَهَري لِغَيركَ ضائِعٌ","وَتَيمّمي بِسِواكَ باطِل"]]},"D7ADC09E-5D31-54B8-A3E6-54B2A69194E7":{"t":"طَرَقَ السَمع يا أهيلَ المصلّى","p":174,"s":"طرق السمع يا أهيل المصلى","r":"474007","v":[["13338A26-400F-5740-9C68-B3BBFE50CB57","طَرَقَ السَمع يا أهيلَ المصلّى","خَبَراً مِنكُم فَزادَ اِشتِياقي"],["79BC8FD3-0319-5F07-BA87-7D534A91A260","مُحكَمُ النَّقلِ قَد رَوته ثِقاةٌ","مُسنَدٌ بِالرّواةِ وَالاتفاقِ"],["15290136-05E0-5F6C-A765-0401C1D12EA1","أَن سَأَفنى بِكُم وَتَفنى عِظامي","وَرَسيس الغَرامِ في القَلب باقي"]]},"919010D6-3BE6-5CF1-B8D8-7DCC7C67D25B":{"t":"عَلى العَقيق اِجتَمَعنا","p":174,"s":"على العقيق اجتمعنا","r":"474053","v":[["CFB7ACA3-61C4-5022-80E8-A133F6793094","عَلى العَقيق اِجتَمَعنا","نَحنُ وَسودُ العيونِ"],["2D935C78-2BB5-515E-A066-6B7FE78F9357","أَظنّ مَجنونَ لَيلى","ما جنّ بَعضَ جُنوني"],["4A4EEBCD-ABEA-5A38-881D-99D9D91F1D82","إِن مُتّ وَجداً عَلَيهم","بِأَدمُعي غَسَلوني"],["02965867-82B8-5756-87E2-AD1E20104EC9","نوحوا عَلَيَّ وَقُولوا","هَذا قَتيل العُيونِ"],["94B5413D-6377-5771-BB8A-AD0F1DECC99D","أَيا عُيوني عيوني","وَيا جُفوني جَفوني"],["7F671D45-4928-5C6E-BF80-0BF8D6A03F45","فَيا فُؤادي تَصبّر","عَلى الَّذي فارَقوني"]]},"090F2207-4B5E-5D85-9B38-5C9C08344A90":{"t":"فَخَفيتُ حتّى قُلتُ لَست بِظاهرٍ","p":174,"s":"فخفيت حتى قلت لست بظاهر","r":"474051","v":[["4193C90E-2B41-59A0-AA02-2A7EF64FC3C4","فَخَفيتُ حتّى قُلتُ لَست بِظاهرٍ","وظَهرتُ مِن سَعيي على الأَوطانِ"]]},"E5EE0B48-1E5F-5459-96FB-59CF9C0EDBA2":{"t":"فُز بِالنَّعيمِ فَإِنَّ عُمرَكَ يَنفذ","p":174,"s":"فز بالنعيم فإن عمرك ينفذ","r":"473982","v":[["BA105C39-B246-5D8A-B4C7-AE9CD3675F38","فُز بِالنَّعيمِ فَإِنَّ عُمرَكَ يَنفذ","وَتَغنَّم الدُّنيا فَلَيسَ مُخَلّدُ"],["0A1D62E2-EED1-5040-9EB9-02BAB8EF22C4","وَإِذا ظَفرت بِلذّة فَاِنهَض بِها","لا يَمنَعنّك عَن هَواكَ مَفنّدُ"],["9536ABFB-CC34-5699-A513-1A3D2D5B7885","وَصَل الصّبوح مَع الغَبوق فَإِنَّما","دُنياكَ يَوم واحد يَتَرَدّدُ"],["076F14D6-1DC9-5C39-8210-A20ADEAFC4CF","وَعَدُوكَ تَشرب في الجِنانِ مَدامةً","وَلتندَمَنَّ إِذا أَتاكَ المَوعدُ"],["C5FE204F-59C6-5D2F-B5E0-FCE0A673BCC7","كَم أُمّة هَلَكَت وَدارٌ عطّلت","وَمَساجد خربَت وَعمّرَ مَعهدُ"],["C08D26CF-4CB4-50DE-B3C1-975652524C55","وَلَكم نَبيّ قَد أَتى بِشريعةٍ","قدماً وَكَم صَلّوا لَها وَتَعَبّدوا"]]},"684BB928-AE4D-56DD-AABA-FFE4D617E008":{"t":"قَد بَقينا مُذَبذبينَ حَيارى","p":174,"s":"قد بقينا مذبذبين حيارى","r":"474029","v":[["43825E20-3C45-5D01-A7EA-63FD1D200341","قَد بَقينا مُذَبذبينَ حَيارى","نَطلُبُ الوَصلَ ما إِلَيهِ سَبيلُ"],["D13FF2BC-BD0C-5359-AFFE-4FF56FD4C404","فَدعاوى الهَوى تَخفّ عَلَينا","وَخِلاف الهَوى عَلَينا ثَقيلُ"]]},"D513CC9F-0FC8-533C-8D91-C09DE0AEA324":{"t":"قَد كنتُ أَحذَر أَن أَشقى بِفُرقَتِكم","p":174,"s":"قد كنت أحذر أن أشقى بفرقتكم","r":"473985","v":[["284F3083-5993-5FDD-967D-50A67E041D42","قَد كنتُ أَحذَر أَن أَشقى بِفُرقَتِكم","فَقَد شَقيتُ بِها لَم يَنفَعِ الحَذَرِ"],["F8ADD8C4-6E2A-5FD9-AE48-DE171F6A088B","المَرءُ في كُلّ يَومٍ يَرتَجي غَده","وَدونَ ذَلِكَ مَخبوء لَهُ القَدرُ"],["DB474051-15E9-59A1-BE46-96E0B5E78FD6","القَلبُ يَأملُ وَالآمالُ كاذِبة","وَالمَغشي يَلهو وَفي الأَيّامِ مُعتبرُ"]]},"C45FA48E-05FA-5DF5-9BB6-8F74D902F790":{"t":"قُل لِأَصحابٍ رأَوني مَيتا","p":174,"s":"قل لأصحاب رأوني ميتا","r":"474059","v":[["4BAE67E1-A4AE-5E6A-94D6-B0DB2D80F150","قُل لِأَصحابٍ رأَوني مَيتا","فَبَكوني إِذ رأوني حزنا"],["83377163-D620-5C9B-BFB6-5019FEDCF42A","لا تَظُنّوني بِأَنّي مَيّتٌ","لَيسَ ذا المَيت وَاللَه أَنا"],["46C85326-3BE3-5AED-95F3-2F8314A875EF","أَنا عصفورٌ وَهَذا قَفَصي","طِرت مِنهُ فَتَخلى رَهنا"],["2C6924FA-8B3B-5DC1-83BE-1DF15AFA01D9","وَأَنا اليومَ أُناجي مَلأ","وَأَرى اللَه عَياناً بِهنا"],["A80D1FE7-FC9A-539E-9819-8C85B538068A","فَاِخلَعوا الأَنفُس عَن أَجسادِها","لِترونَ الحَقّ حَقّاً بَيّنا"],["B89D7A6F-E006-5923-8733-AF520CB8F10D","لا تَرعكُم سَكرة المَوتِ فَما","هِيَ إِلّا اِنتِقالٌ مِن هُنا"],["FA66BD49-0ED9-5906-A3A8-FD3BF884D85A","عُنصرُ الأَرواحِ فينا واحدٌ","وَكَذا الأَجسامُ جِسم عَمَّنا"],["AE626971-B2B8-5F30-928F-B957A4976E28","ما أَرى نَفسي إِلّا أَنتُم","وَاِعتِقادي أَنَّكُم أَنتُم أَنا"],["BB1A92AD-2969-5280-9620-D2E4FA8DB5F5","فَمَتى ما كانَ خَيراً فَلَنا","وَمَتى كانَ شَرّاً فَبِنا"],["4FFD9DC4-AC6C-5FD3-BD6C-0E7C93A2E8F7","فَاِرحَموني تَرحموا أَنفسَكُم","وَاِعلَموا أَنَّكُم في إِثرِنا"],["21A644B3-70F9-5AB8-BB2C-1EF31866E115","مَن رآني فَليقوّ نَفسهُ","إِنَّما الدُنيا عَلى قرن الفَنا"],["FD33A46B-86C3-5730-979E-5FB4897A99C8","وَعَلَيكُم مِن كَلامي جملةٌ","فَسلامُ اللَهِ مَدحٌ وَثَنا"]]},"F9350B8E-2C16-5FEB-9B6C-D7A9FA120555":{"t":"قِف بِنا يا سَعد نَنزل ها هُنا","p":174,"s":"قف بنا يا سعد ننزل ها هنا","r":"474061","v":[["CDC8CFFE-4748-55F0-851D-0681960D06C0","قِف بِنا يا سَعد نَنزل ها هُنا","فَأثيلات النَّقا ميعادُنا"],["8C0A2779-4173-5547-92B1-A33D1B549636","وَاِبتغِ لي عبرةً أَبكي بِها","فَدُموعي نَفَذَت بِالمُنحَنى"],["9A05BFFF-65B6-562B-B7A0-978006C1A503","هَذِهِ الخيفُ وَهاتيكَ مُنى","فَتَرفَّق أَيُّها الحادي بِنا"],["B229E87E-4B71-59A4-90DA-5483B5153082","وَاِحبِس التَّدليجَ عَنّا ساعَةً","نَندُب الحَيَّ وَنَبكي الوَطَنا"],["EE6F9FAE-1085-571F-B98F-78EAAE44E150","أَهلُ مَكّةَ هَكَذا مكّتكم","كلّ مَن حَجَّ إِلَيها فُتِنا"],["C8719F21-F0C0-5019-A9B8-107B887E2FC3","قَتَلت سُمركمُ سادَتنا","لَستُ أَعني بِكُم سُمرَ القَنا"],["D956D180-900B-51A9-9348-752FEC7F3384","كُلُّ مَن آمل شَيئاً نالَهُ","يَومَ عيدٍ في مُنى إِلا أَنا"],["57A7D23F-0043-56C7-845A-5743405C4B05","قُلتُ يا صَيّاد قَلبي حلّهُ","حرمَ الصّيد عَلى مَن في منى"],["0C0AB8CA-3D43-50DA-A608-A3852A9386D4","قال مَن تَعني وَقَد أَبرَزَ لي","مِن خبا البُرقعِ وَجهاً حَسَنا"],["DE83BE0C-8C74-5EF6-B5A1-9E008ECB0AC5","قُلتُ إِيّاكَ فأَوما خَجَلا","قالَ وَالصَّياد مَن قُلت أَنا"]]},"1D1A741F-4224-5235-8949-7E4A78A6026F":{"t":"قِف عَلى المَنزل وَاِسأَل طَلَلَه","p":174,"s":"قف على المنزل واسأل طلله","r":"474033","v":[["B4491CD4-87BC-56CF-B9CD-2A0A0531FD2F","قِف عَلى المَنزل وَاِسأَل طَلَلَه","مَن بِهِ بَعدَهُم قَد نَزَله"],["034D9372-DD33-5692-96D1-FC895405A0F6","وَلِماذا رَحَل السُكّان عَن","سَكَنٍ كانوا بِهِ عَن عَجَله"],["C1640F86-8F6F-522A-8C4D-26A4B789EBD7","طالَ شَوقي فَاِبكِ إِن شِئتَ مَعي","وَاِندُبِ الرّبعَ وَكَلّم طَلله"],["51D29F75-1F8E-5657-9696-CFECB5239E5B","خَلِّني يا صاحِ عَن عَذلِكَ لي","قَد عَصى قَلبي عَلى مَن عَذَلَه"],["EE2D907A-211D-5853-824F-27D3D8D3C51A","لا تَزده فَوقَ ما حَلَّ بِهِ","فَبِقَلبي شاغلٌ قَد شَغَلَه"],["B968C74D-BD03-53B2-B73A-986651125507","لَستُ أَنسى ساعَة البَينِ وَقَد","ثوّر المَحبوبُ فيها جُملَه"],["850A0BE1-E3E2-5D7E-AD84-53E27A5C09DE","أَودَع القَلب وَقَد وَدَّعني","نارَ وَجدٍ لَم تَزَل مُشتَعِلَه"],["4E81EB33-8FA6-58C1-896B-FAE8BD82772C","حَرّمَ الوَصلَ عَلى عاشِقِهِ","فَهوَ يَدري أَنَّهُ قَد قَتَلَه"],["80875060-76EB-50E0-91C0-86A8971F6801","أَيُّها القَلبُ المُعنّى هَكَذا","تطلب الحُبَّ وَتَهوى مَلَلَه"]]},"1B05A102-221E-56E0-AD49-4D792420F370":{"t":"كُلّ يَومٍ يَروعُني مِنكَ عَتب","p":174,"s":"كل يوم يروعني منك عتب","r":"473972","v":[["012270B5-2F17-5647-9262-53FA48F2E57A","كُلّ يَومٍ يَروعُني مِنكَ عَتب","أَيّ ذَنبٍ جَناهُ فيكَ المُحبُّ"],["C8050171-C78E-56A0-BC84-60760F838E11","إِن تَكُن أَحدَثت وشاتي حَديث","بِسلوّي هَواك حَشاي كذبُ"],["36640B62-9980-5D24-AA1A-49589B9D96BE","وَضُلوعي لَها هَواك ضُلوعا","بَل وَقَلبي لَها المَحبّة قَلبُ"],["68561FB9-2BD0-5A4F-A3BE-B0F4991A471A","مُتّ مِن جَورِ سادَة قَد أَحَلّوا","قَتلَ مَن لا لهُ سِوى العشقِ ذَنبُ"],["89CB2AAB-4718-568A-AC41-A6FC851707B8","صارَ لي في هَواهُ رُتبة ما","حازَها في هَواهم قَطُّ صَبُّ"],["4BDC91AA-C9A7-5ACE-B2FA-23E53D55C02B","عَبراتٌ تَهمي وَجِسمٌ نَحيلٌ","وَفُؤادٌ عَلى التَّقاطعِ يَصبو"],["EB80EA38-2082-524A-A2D2-D0AB31D4D6CE","وَضُلوعٌ مِنَ الجَوى واهِيات","وَدُموعٌ بِذائِبِ القَلبِ سكبُ"],["7E6776DA-E7C9-5816-9EE8-88C3D4D65260","يا سَميري وَلَم أَقُل يا سَميري","قَط إِلّا أَجابَ عِشق وَحُبُّ"],["65DF58D6-62E3-5168-B3E8-ECC9F16F033B","هَل لِداء الهَوى سَمعت دَواء","هَل لِمَيت الغَرام في الحُبّ طبُّ"],["6CD04C69-D7F2-50E0-99EE-CE3FD7444275","بَينَ جِسمي وَالسَّقم سلم وَبَينَ ال","جفنِ وَالنَّوم عِندَما صَدّ حَربُ"],["AE9CA335-873D-5BF8-A18E-A37C5FF74272","مَن مُجيري مِن ظالِم وَلي القَل","ب لَهُ اليَوم فيهِ قَتلٌ وَنَهبُ"],["5E85DC56-1084-5D00-8D27-9C95E3521A6F","جاءَ لِلنّاسِ فتنة بِخدودٍ","نارها في قُلوبنا لَيسَ تَخبوا"],["19C270BA-D7E6-5EE2-A709-5A3ABDE73553","إِنَّ عَيني لِشمس وَجهِكَ شَرق","ما لِدَمعي سِوى الجفن غَربُ"]]},"257FD347-B35B-50E7-AB57-CA82008441C5":{"t":"لا تَأمَنِ المَوتَ الخَؤون","p":174,"s":"لا تأمن الموت الخؤون","r":"473978","v":[["00E8B059-CFEB-5F40-A177-03352FAE54F0","لا تَأمَنِ المَوتَ الخَؤو","نَ وَخَف بَوادِرَ آفته"],["15F32163-767D-5AA2-9F49-A8717CD1BEAB","المَوت سَهمٌ مُرسَلٌ","وَالعُمرُ قَدر مَسافَته"]]},"286014BD-8452-583E-8C08-17E7E3F95567":{"t":"لا يَمنَعنّك خَفض العَيشِ في دِعةٍ","p":174,"s":"لا يمنعنك خفض العيش في دعة","r":"474057","v":[["8EBAEC0F-25B7-5153-BF88-CEF63EC81E10","لا يَمنَعنّك خَفض العَيشِ في دِعةٍ","مِن أَن تَبَدّل أَوطاناً بِأَوطانِ"],["4CBAF43F-5592-542C-9934-ED1921517B7E","تَلَقى بِكُلّ بِلادٍ إِن حَللتَ بِها","أَهلاً بِأَهلٍ وَإِخواناً بِإِخوانِ"]]},"F6EFD26D-7C60-5A9F-B6ED-230362FC42CC":{"t":"لا يَمنَعنّكَ مِن بِغاء","p":174,"s":"لا يمنعنك من بغاء","r":"474039","v":[["DDD8ED18-FF16-5A0B-8AB4-9D8A62E64A21","لا يَمنَعنّكَ مِن بِغا","ءِ الخَيرِ تِعقاد التَّمائم"],["1202D5F6-0EFA-54C5-A11C-8ED37D8DF2D2","لا وَالتَّشاؤم بِالعطا","سِ وَلا التَّيامن بِالمَقاسم"],["ACA48D38-2825-59DE-B741-156E188648B4","فَلَقَد غَدَوت وَكُنتُ لا","أَغدو عَلى واقٍ وَحاتم"],["E2AE991B-1B0C-596F-8AA1-A0E545914168","فَإِذا الأَشائِمُ كَالأَيا","مِن وَالأَيامن كَالمَشائِم"],["445E8074-629C-5AA7-99A4-8DD83B4B3D25","وَكَذاكَ لا خَيرَ وَلا","شرّ عَلى أَحدٍ بِدائم"],["57C3F03F-AAAB-5FE0-AE51-16EEAEBD675B","قَد خَطَّ ذَلِكَ في الزّبو","رِ الأَوليّاتِ القَدائِم"]]},"E59CE3D9-2922-59F2-8096-C893E47D8252":{"t":"لَو عَلِمنا أَنَّنا ما نَلتَقي","p":174,"s":"لو علمنا أننا ما نلتقي","r":"473994","v":[["F2BBCDA3-017F-5E2E-AC92-92693621EBE5","لَو عَلِمنا أَنَّنا ما نَلتَقي","لَقضَينا مِن سُلَيمى وَطرا"]]},"3902C1AE-241D-5B04-9C53-72FF889E19D8":{"t":"لِأَنوارِ نورِ اللَه في القَلب أَنوارُ","p":174,"s":"لأنوار نور الله في القلب أنوار","r":"473983","v":[["A7BA5C5A-87C7-559B-8753-9C7F49A59A50","لِأَنوارِ نورِ اللَه في القَلب أَنوارُ","وَللسرّ في سرّ المُحبّين أَسرارُ"],["F3A6997C-16CD-5C76-BA13-75EBE5EC79A6","وَلمّا حَضَرنا للشّرابِ بِمجلسٍ","وَخفّ مِن عالم الغَيب أَسرارُ"],["73304153-0BA6-5AC4-BE4A-7BAB2555808E","وَدارَت عَلَينا لِلمَعارف قَهوة","يَطوفُ بِها مِن جَوهرِ العَقلِ خمارُ"],["ADE75A34-8797-5A58-A74E-7473D2F52E6E","فَلَمّا شَرِبناها بإِقراه فمها","أَضاءَ لَنا مِنها شُموس وَأَقمارُ"],["81EDCBD7-6089-51A0-9006-F1C3F71409E6","وَكاشَفنا حَتّى رَأَيناهُ جَهرَةً","بِأَبصار صِدقٍ لا يُواريهِ أَستارُ"],["0EDE9B31-85C1-59B0-8714-1A54B893622A","وَخالَفنا في سكرِنا عِندَ نَحونا","قَديمٌ عَليمٌ دائمُ العَفوِ جَبّارُ"],["F49688F0-3B49-5260-A4CC-9DB9248EB40D","سَجَدنا سُجوداً حينَ قالَ تَمَتّعوا","بِرُؤيَتنا إِنّي أَنا لَكُم جارُ"]]},"6D8E0816-1544-54A4-8FF7-934506262518":{"t":"ما عَلى مَن باحَ مِن حَرَجٍ","p":174,"s":"ما على من باح من حرج","r":"474049","v":[["A6204293-DC99-50A1-BB96-15058F93D2D3","ما عَلى مَن باحَ مِن حَرَجٍ","مِثل ما بي لَيسَ يَنكتِمُ"],["78B7F5E9-3F9E-5F5A-917A-99A5747280A1","زَعَموا أَنَّني أُحِبّكُم","وَغَرامي فَوقَ ما زَعَموا"]]},"85A7C3D4-1631-50ED-B174-CBB92F9840AF":{"t":"هَبَّت عَلي صَبا تَكاد تَقول","p":174,"s":"هبت علي صبا تكاد تقول","r":"474027","v":[["ED8514DB-D7B1-5E9B-877E-F8BA30DAA281","هَبَّت عَلي صَبا تَكاد تَقول","إنّي إِلَيكَ مِن الحَبيبِ رَسولُ"],["9189FD8D-E262-5DB1-9353-2D907A2C16FB","صَرَّفت أَخباري فَقُلت أحبّها","في قِصَّتي طول وَأَنتَ مُلوكُ"]]},"A7157324-4D4A-57BC-A1D7-51CBED0C2429":{"t":"وَالمَرءُ يَفرَحُ بِالأَيّام يَقطَعها","p":174,"s":"والمرء يفرح بالأيام يقطعها","r":"474023","v":[["F61F9E04-49DB-53D2-894B-BCEB2D5B9681","وَالمَرءُ يَفرَحُ بِالأَيّام يَقطَعها","وَكُلّ يَومٍ مَضى يَدنو مِن الأَجلِ"]]},"2BC90F1D-243A-5B79-B787-FA4F5297A0A0":{"t":"وَبي أَملٌ أَنّي أَسودُ وَكَيفَ لا","p":174,"s":"وبي أمل أني أسود وكيف لا","r":"473981","v":[["B0B46CD2-13C8-5CF5-8CA1-22366E2C0591","وَبي أَملٌ أَنّي أَسودُ وَكَيفَ لا","وَآل بُويهٍ بَعدَ فَقرِهم سادوا"],["2DC9537A-D32D-5B77-89DA-FD5232886262","وَأَحكمُ في أَهلِ الزَّمانِ كَما أَشا","وَأَملِكُ ما صانوا وأَهدِمُ ما شادوا"],["B5409D48-CE22-55A8-8D84-C26F764E47B6","وَأَفعلُ ما أَختار في كلِّ فاسِق","مِنَ الصّيد حَتّى لا تَراهُم وَقَد بادوا"]]},"0C8733FF-0E7B-51CB-B4E0-62798ED15F7D":{"t":"وَلمّا وَرَدنا ماءَ مَدينَ يَستقي","p":174,"s":"ولما وردنا ماء مدين يستقي","r":"473971","v":[["4FE1B746-4074-56C7-BB0C-CDB0290EA676","وَلمّا وَرَدنا ماءَ مَدينَ يَستقي","عَلى ظَمأ بِتنا إِلى موقف النَجوى"],["6B176C01-3C54-5BEA-AEE7-7F4314B5D06A","نَزَلنا عَلى حيٍّ كرامٍ بيوتهم","مُقَدّسة لا هِندَ فيها وَلا عَلوى"],["E4647196-5125-57F6-AEE0-B92D71D56C74","وَلاحَت لَنا نارٌ عَلى البُعد أضرمَت","وَجَدنا عَلَيها مِن تحبُّ وَمَن تَهوى"],["9DD37EE4-64F0-543B-AD55-1AC5A43C7F19","سَقانا وَحيّانا فَأَحيا نُفوسَنا","وَأَسكَرَنا مَن راح إِجلاله التَقوى"]]},"02AE56D9-A398-564F-A79B-7F2376E3E875":{"t":"وَلَو أنّ ليلى العامريَّة سلَّمت","p":174,"s":"ولو أن ليلى العامرية سلمت","r":"473987","v":[["25520D5B-102B-54BD-ACFA-6C66FDDE6773","وَلَو أنّ ليلى العامريَّة سلَّمت","عَليَّ وَدوني تربَة وَصفَائح"],["9859858E-8A25-5C33-859F-85576B4819DC","لَسلّمت تَسليمَ البشاشَة أَو زَقا","إِلَيها صَدى مِن جانِبِ القَبر صالح"]]},"D249626E-CDF2-5043-80A7-DC562D4586BA":{"t":"وَلَولاكُم ما عَرَفنا الهَوى","p":174,"s":"ولولاكم ما عرفنا الهوى","r":"474041","v":[["FCBBE64E-A208-5B56-A68A-63CE5254987F","وَلَولاكُم ما عَرَفنا الهَوى","وَلَولا الهَوى ما عَرفناكُم"]]},"9DFAA60D-8C3D-516E-B9F8-7E6F924006AF":{"t":"وَما أمّ خشفٍ طولَ يَومٍ وَليلةٍ","p":174,"s":"وما أم خشف طول يوم وليلة","r":"474066","v":[["B6267892-E27E-5F39-9BB2-6AB108558C83","وَما أمّ خشفٍ طولَ يَومٍ وَليلةٍ","بِبلقعةٍ بَيداء ظَمآن صادِيا"],["04186E58-A83E-5184-AE76-80208342C999","تَهيم وَلا تَدري إِلى أَين تَبتَغي","مولّهة حُزناً تَجوزُ الفَيافِيا"],["91A9C459-A1C0-58C6-BAEC-F5E1579340F0","أَضرّ بِها لِفتحِ الهَجير فَلَم تَجِد","لعلّتِها مِن بارِدِ الماءِ شافياً"],["838D8B26-0B79-5E93-A754-20ADDA017E9A","إِذا اِنقَلَبَت عَن خَشفها اِنقَطَعَت لَهُ","فَأَلفتهُ مَلهوفَ الجَوانِح طاوِيا"],["62008487-8D30-5F1C-9221-9D7CADD5A0B3","بأَوجع مِنّي يَوم شَدّوا حُمولهم","وَنادى مُنادي البَين أَن لا تَلاقيا"]]},"942758CB-40CE-5C86-9B05-AA4DB4C57989":{"t":"وَمَن مَنَحَ الجهّالَ علماً أَضاعَهُ","p":174,"s":"ومن منح الجهال علما أضاعه","r":"474037","v":[["AF5AFDC9-ACB8-56CD-871C-5A2A99E456CD","وَمَن مَنَحَ الجهّالَ علماً أَضاعَهُ","وَمَن مَنَع المَستَوجِبينَ فَقَد ظَلم"]]},"1E0C9320-6650-54E7-943B-001A2F47C3E4":{"t":"وَمِمّا شَجاني أَنَّها يَومَ وَدّعت","p":174,"s":"وَمِمّا شَجاني أَنَّها يَومَ وَدّعت","r":"473988","v":[["EB6C6D3F-EB7A-58BF-A17A-543EFF91EE09","وَمِمّا شَجاني أَنَّها يَومَ وَدّعت","تَوَلَّت وَماءُ العَينِ في العَينِ حائرُ"],["3AD9C75E-D6C4-51AF-89FC-3ECAFF676221","فَلَمّا أَعادَت مِن بَعيدٍ بِنَظرَةٍ","إِلَيّ اِلتفاتاً أَسلَمَته المَحاجرُ"]]},"5B9B2FF1-C247-5E78-9DD3-593673A0E684":{"t":"يا أَيُّها البَرق الَّذي تَلمعُ","p":174,"s":"يا أيها البرق الذي تلمع","r":"474003","v":[["9DF0202B-6CD2-527A-A2B9-63930AA9E889","يا أَيُّها البَرق الَّذي تَلمعُ","مِن أَيّ أَكنافِ الحِمى تَسطعُ"]]},"BB3DE17B-97ED-5967-BA36-DE5E62D49678":{"t":"يا صاح أَما رَأيت شُهباً ظَهَرَت","p":174,"s":"يا صاح أما رأيت شهبا ظهرت","r":"473974","v":[["AC5F27D1-CFF4-58DB-BB82-599334D76FB4","يا صاح أَما رَأيت شُهباً ظَهَرَت","قَد أَحرَقَت القُلوب ثُم اِستَتَرَت"],["01C9F2C4-B2DF-574A-8328-329311B667C5","طِرنا طَرَباً لضوئها حينَ طَرَت","بانَت وَتَوالَت وَأَثارَت وَسَرَت"]]},"3D500AEC-D1B1-583B-AF8F-F7AB2D0FF887":{"t":"يا مَليحاً قَد تَجلّى","p":174,"s":"يا مليحا قد تجلى","r":"474047","v":[["0D9EE942-D47F-559F-8320-92A1E6BD8C9F","يا مَليحاً قَد تَجلّى","فيهِ أَهلُ الحَيّ هاموا"],["F70E0850-7FD6-5FCB-AB81-1171B252E48C","سِيَما لَمّا تَحلّى","وَحَلا فيهِ الغَرامُ"],["CFFBC62F-F63A-5098-8282-9A2437375006","قُلت لَمّا لاحَ يجلى","وَاِنجلى عَنّي الظَلامُ"],["E88912B9-CD9A-56FB-9B3B-7D5AE8DD4E31","هَكَذا العَيشُ وَإِلّا","فَعَلى العَيش السَلامُ"],["71D23AAE-173A-5126-964B-7039EAC82FEA","حَبَّذا لَمّا سَقاني","صَفوَ كَأسِ الحُبِّ صِرفا"],["45AE1D2C-E98F-522E-ACCC-97C0DF897BF2","وَحَباني بِالتَداني","وَاِنثَنَى جيداً وَعطفا"],["C44918B9-6700-5AD7-B1FD-55B2717A527C","مُبعدٌ في القَلبِ حَلا","وَجَلى عَنّي الظَلام"],["BE531F70-1920-52F6-8770-0ADF29F80F6E","هَكَذا العَيش وَإِلا","فَعَلى العَيشِ السَلام"],["72B0571F-0557-52A7-9895-9A7F96C9C23E","يا خَليّ البالِ هَلّا","تَدخل الحان وَتَعشق"],["29F9160A-D6C6-56FE-B5D8-55AA3BB19DB9","إِنّ لَيل الصَدّ وَلّى","وَصَباحُ الوَصلِ أَشرَق"],["EE556892-1A95-5311-8AFF-677DE81D3511","وَمقامُ الحَبِّ جَلّ","لا يُضاهيهِ مَقامُ"],["BB49F245-05E0-5FAF-AC05-6DF37ACE84A1","هَكَذا العَيشُ وَإِلّا","فَعَلى العَيشِ السَلامُ"]]},"18E557EC-9281-5823-9DB6-F28936D88CB3":{"t":"يا نَسيمَ القُربِ ما أَطيَبكا","p":174,"s":"يا نسيم القرب ما أطيبكا","r":"474019","v":[["3BDCDB1C-0C94-5C91-B334-D92D6D311015","يا نَسيمَ القُربِ ما أَطيَبكا","ذاقَ طَعم الأُنس من حلّ بِكا"],["883DEA8C-51F2-5818-B83B-7C11570912F4","أَيّ عَيشٍ لأُناسٍ قربوا","قَد سقوا بِالقُدسِ مِن مَشرَبكا"]]}}}