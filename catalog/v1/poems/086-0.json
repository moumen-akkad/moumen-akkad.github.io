{"v":1,"poems":{"06BDCA75-3A95-548E-849C-E076826FDDFA":{"t":"آلى يَميناً أَبو الهنديِّ كاذِبَةً","p":86,"s":"آلى يمينا أبو الهندي كاذبة","r":"474212","v":[["4FF319A7-D97E-5618-9087-684D9C2F24B5","آلى يَميناً أَبو الهنديِّ كاذِبَةً","ليعطين زواني لست ما شينا"],["6C824F5B-A11D-507E-A193-93C4C5134DF6","وَغَرَّهُنَّ فَلَمّا أَن قَضى وَطراً","قالَ ارتَحَلنَ فَأَخزَى اللَهُ ذا دينا"]]},"3EAF81A9-F3DD-5EFD-97B9-9253C2E0E17F":{"t":"أعاذل لو شربت الراح حتى","p":86,"s":"أعاذل لو شربت الراح حتى","r":"474220","v":[["2CF2C6D5-F93A-5314-A5B3-C2E61033475A","أعاذل لو شربت الراح حتى","يكون لكل أنملة دبيبُ"],["0F318DED-E348-58CB-9C0B-39646C8805A7","إذن لعذرتني وعلمت أني","لما أنفقت من مالي مصيبُ"]]},"DD02ABF0-B50D-5E6A-8FC6-1AB13B75DB2E":{"t":"أَبا منذِرٍ رُمتَ الامورَ فَقِستَها","p":86,"s":"أبا منذر رمت الامور فقستها","r":"474206","v":[["A8BFD80F-40D2-5F06-97D7-4C25D8DFF187","أَبا منذِرٍ رُمتَ الامورَ فَقِستَها","وَساءلت عَنها كالحَريصِ المُساوِمِ"],["B26B4650-2B91-5CA5-A0C1-E5CA1B4D9D68","فَما كانَ ذو رأيٍ مِنَ الناسِ قِستَهُ","بِرأيِكَ الأمثلَ رأيَ البَهائِمِ"],["7F93FCAD-7DB0-5F31-A58B-946A685111E2","أَبا منذرٍ لَولا مَسيرُكَ لَم يَكُن","عراقٌ وَلا اِنقادَت مُلوكُ الأعاجِمِ"],["619EB52F-F751-57B0-BF36-92234D876854","وَلا حَجَّ بَيتَ اللَهِ مُذ حَجَّ راكِبٌ","وَلا عَمَرَ البَطحاَء بَعدَ المَواسِمِ"],["F84DDA49-CC76-5985-8985-4123A01CE43B","فَكَم مِن قَتيلٍ بَينَ سانٍ وَجزَّةٍ","كَثيرِ الأَيادي مِن مُلوكٍ قَماقِمِ"],["33AFE884-89F3-5AF3-9832-3B890AB77F20","تَرَكتُ بأرضِ الجوزَجانَ تَزورُهُ","سِباعٌ وَعِقبانٌ لحزِّ الغَلاصِمِ"],["55DF7345-1201-5074-88CB-89F12C75EAFD","ذَوي سوَقةٍ فيهِ مِن السَيفِ خطةٌ","بِهِ رَمَقٌ حامَت عَلَيهِ الحوائم"],["E8E5377F-8380-5DD3-B558-418269741BFF","فمن هارِبٍ مِنّا وَمن دائِنٍ لنا","أسيرٍ يُقاسي مُبهماتِ الأداهِمِ"],["362DA2F4-563D-5ECE-91FE-C91FDF6CAD3C","فَدَتكَ نُفوسٌ مِن تَميمٍ وَعامِرٍ","ومِن مُضَرِ الحَمراءِ عندَ المآزمِ"],["9E30C2A0-2B8F-5878-8C4D-C3405438C858","هُمُ أَطمَعوا خاقانَ فينا فَأَصبَحَت","جَلائِبُهُ تَرجو اِحتَواَء المَغانِمِ"]]},"2E0BAC21-1E61-58BA-9AE9-699EFA1720A6":{"t":"أَكَلتُ الضِبابَ فَما عِفتُها","p":86,"s":"أكلت الضباب فما عفتها","r":"474207","v":[["29496315-BE60-59BA-A153-6173768A3AC6","أَكَلتُ الضِبابَ فَما عِفتُها","وانّي لأَهوى قَديد الغَنَمْ"],["686EC11B-FB24-5D74-AE5F-065C078C7D73","وَرَكَّبتُ زُبداً عَلى تَمرَةٍ","فَنِعمَ الطَعامُ وَنِعمَ الأدَمْ"],["B8103BC0-A8C5-5402-9D1B-B63CA7FEDC55","وَسمنَ السِلاءِ وَكمَء القَصيص","وَزينُ السَديفِ كبودُ النَعَمْ"],["091140C6-AC7B-5E86-AE19-D6FCBF6B8A26","وَلَحمَ الخَروفِ حَنيذاً وَقَد","أَتيتُ بِهِ فائِراً في الشَبَمْ"],["4E25F6A9-F90C-59FB-859F-7F1D6ABAD6B7","فَأَمّا البَهَطّ وَحيتانُكُم","فَما زِلتُ مِنها كَثيرَ السَقَمْ"],["93002A63-29BB-5EB9-AF4E-D258502CD124","وَقَد نِلتُ ذاكَ كَما نِلتُمُ","فَلَم أَرَ فيها كَضَّبٍ هَرِمْ"],["248DCA27-01C2-5A0D-8368-468F332B348D","وَما في البُيوض كَبَيضِ الدَجاج","وَبَيضُ الجَرادِ شِفاءُ القَرَمْ"],["B9A2A125-7B42-5409-9628-3BD21C860E46","وَمكن الضِباب طَعامُ العُرَيبِ","وَلا تَشتَهيهِ نُفوسُ العَجَمْ"]]},"AAF082E1-6338-5970-A4B8-C7304BAC4899":{"t":"أُصببْ عَلى قَلبِكَ مِن بَردِها","p":86,"s":"أصبب على قلبك من بردها","r":"474216","v":[["BDB4986E-8720-5836-8D65-BF0C456D50C8","أُصببْ عَلى قَلبِكَ مِن بَردِها","إِنّي أَرى الناسَ يَموتونا"],["C749181E-BF00-597E-8741-D3A6FC16EE79","وَدَع أُناساً كَرِهوا شُربَها","لَيسوا بِما في الخَمر يَدرونا"],["EFC7AD80-BD13-598E-82C3-86FCF33F42E5","لَو شَرِبوها فَأنتَشوا مَرَّةً","لأَصبَحوا بِالخَمرِ يَهذونا"],["2EC178AF-5C89-5C31-86E1-07E845D16D55","وَقَد عَهِدتُ النَّاسَ إِذ دهرُهُم","دَهرٌ يَلوطونَ وَيَزنونا"]]},"27FC4282-E413-53C4-B6B6-41C200B14FED":{"t":"إِذا حانَت وَفاتي فادفنوني","p":86,"s":"إذا حانت وفاتي فادفنوني","r":"474163","v":[["D3BBF2FE-AF85-520F-B8CB-48D3B45B594E","إِذا حانَت وَفاتي فادفنوني","بكرمٍ واِجعَلوا زِقّاً وِسادي"],["471BC079-C0C8-5BE2-A4E2-67845DA1B02A","وابريقاً إِلى جَنبي وَطاساً","يروّي هامَتي وَيَكونُ زادي"]]},"33747F4B-25AD-5EAE-9633-ECD4987FF98B":{"t":"إِذا صَلَّيتُ خَمساً كُلَّ يَومٍ","p":86,"s":"إِذا صَلَّيتُ خَمساً كُلَّ يَومٍ","r":"474199","v":[["447D5338-0364-5C3B-8EFA-2B8F3E449180","إِذا صَلَّيتُ خَمساً كُلَّ يَومٍ","فَإِنَّ اللَهَ يَغفِرُ لي فُسوقي"],["CB7A88FC-96F8-5B38-B94D-52E5AFC9E770","وَلَم أُشرِك بِرَبِّ الناسِ شَيئاً","فَقَد أَمسَكتُ بالدينِ الوَثيقِ"],["E50039F3-D290-56EA-BCFB-4D2FDF549233","وَجاهدتُ العَدوَّ وَنلتُ مالاً","يُبَلِّغُني إِلى البَيت العَتيقِ"],["3EE3EE05-5F68-54B7-87B1-90B9202FA372","فَهَذا الدينُ لَيسَ بِهِ خَفاءٌ","دَعوني في بُنَيّاتِ الطَريقِ"]]},"4A7718CB-5EE1-5B03-944A-8D51931BC92C":{"t":"إِذا ما أَلَحَّ البَردُ فاِجعَل دِثارَهُ","p":86,"s":"إذا ما ألح البرد فاجعل دثاره","r":"474197","v":[["9C52488A-59D2-5A50-8F82-0989B6DFE3A6","إِذا ما أَلَحَّ البَردُ فاِجعَل دِثارَهُ","إِذا التَحَفَ الأَقوامُ رُكنَ المَطارِفِ"],["420EB1CF-86DD-5D77-952A-F8AD199982E4","ثَلاثةُ أَرطالٍ نَبيذاً مُعَسّلاً","تَكُن آمِناً مِنهُ لَهُ غَيرَ جائِفِ"],["C7B9B513-1854-502D-BEDE-D535E31DD82B","فَإِنَّ التِحافَ المَرءِ في جَوفِ بَطنِهِ","أَشَدُّ وأدفا مِن جيادِ المَلاحِفِ"]]},"26E10B66-A3A4-5F1E-AC18-CF598899F582":{"t":"إِذا ما بِعتَني كوزاً بخطِّ","p":86,"s":"إذا ما بعتني كوزا بخط","r":"474191","v":[["EFC0100E-CA28-524B-AE0E-8863A118BB48","إِذا ما بِعتَني كوزاً بخطِّ","فَخَطي ما بَدا لكِ أَن تَخطي"],["2EE54E60-7D66-5294-B28C-FAA2917F162B","وَزيدي ثُمَّ زيدي ثُمَّ زيدي","عَليَّ وَغَلِّظي بِاللَهِ شَرطي"],["7BA46A0A-F7B7-5AD3-8F5D-C5991E66ABFA","وَصُبِّي في أُبيريقٍ صَغيرٍ","كَأَنَّ الأذنَ مِنهُ رجعُ حُطّي"]]},"F8C1AC27-2B34-505C-B2DD-346064770503":{"t":"إِمزجاها واِسقياني واِشرَبا","p":86,"s":"إمزجاها واسقياني واشربا","r":"474187","v":[["234B224D-659B-569B-B6AE-F5F3D91D9237","إِمزجاها واِسقياني واِشرَبا","وَدَعا العاذِلَ يَهذي كَيفَ شا"],["7E6EC7DC-0476-5306-AF39-BF6E49842842","وَافشيا السِرَّ فَما يَهنأُ لي","شُربُها إِلاّ اذا السِرُّ فَشا"],["386E7B05-0B2A-56FB-A0EB-0F32ABEA68F3","وَإِذا مُتُّ اِضجِعاني وافرشا","مِن عَصيرِ الكرم تَحتي فُرُشا"],["B1EB18CA-9A94-528A-896C-2F2B18A9E846","واِقطعا لي كَفناً مِن زقِّها","واطرحا مِنها عَلَيهِ واِرشُشا"],["104AE9DC-CE4D-5426-A921-13F7A8646673","وادفناني يا نَديميَّ إِلى","جنبِ كرمٍ فرعُهُ قَد عَرَّشا"],["BE1E8B9D-CB83-52DE-98DC-59FED3425088","لِيَظَلَّ الفرعُ مِنّي ظاهِراً","وَيَروِّي الأَصلَ مِنّي العَطَشا"],["F3657795-9AD5-5A21-9AA6-71E4DBB749E9","وكِلاني بَعدَ هاتيك إِلى","راحِمٍ يَفعَل فينا ما يَشا"]]},"9B1C2522-1C4C-57E4-AF7D-89AFF2B5127C":{"t":"إِن كُنتَ نَدماني أَبا مالِك","p":86,"s":"إن كنت ندماني أبا مالك","r":"474184","v":[["26F8D108-32F3-5223-A7D9-4B1B7D3B88F2","إِن كُنتَ نَدماني أَبا مالِك","فاسقِ أَبا الهِنديِّ بِالكُندَرَهْ"],["D8494696-41D2-5ACE-8BCC-8CD65E1E9A34","مِن قَهوةٍ صَهباَء كَرخيَّةً","تأخُذُ بِالرأسِ وَبالحَنجَرَةْ"],["D242CC06-9AD7-5CC1-8E5A-844C85AE83D6","تُسكبُ مِن زقٍّ لَنا مُسنَدٍ","اسحَم رشاش لَهُ قَرقَرهْ"],["C3AE8C54-5A6B-5905-B285-5255DEBF7B9F","كَأَنَّما أَكرُعُه إِذ بَدَت","أَيدي لصوص قُطِعت مُنكرَهْ"]]},"CBC4127D-447F-5D7A-81E1-EC9CC2452F6B":{"t":"الآن تمَّ ليَ السرورُ بقُرْبكمْ","p":86,"s":"الآن تم لي السرور بقربكم","r":"474228","v":[["637E31B6-0394-5906-809A-9AEDD7883770","الآن تمَّ ليَ السرورُ بقُرْبكمْ","وعلمتُ أنَّ الدهرَ قد واتاني"],["2A6688A5-58EF-50B7-B874-D49FC0E8879C","حانَ الرحيلُ وحال دون لقائكم","صَرْفُ الزمان وطارقُ الحدثانِ"],["9BA2F7B4-E5A7-5FA2-B489-8FC3E9FA2F54","فعليكمُ منِّي السلام مُضاعفاً","توديع ذي شَغَفٍ بكم حَيْرانِ"]]},"13BBF0BE-DE54-521A-B8FD-2246682251E9":{"t":"اِجعَلوا إِن مُتُّ يَوماً كَفَني","p":86,"s":"اجعلوا إن مت يوما كفني","r":"474175","v":[["236965A2-1582-53D9-ACF3-914745C7428E","اِجعَلوا إِن مُتُّ يَوماً كَفَني","وَرَقَ الكَرمِ وَقَبري مَعصَرَهْ"],["18E27E60-718F-5237-A30B-981C3A6133C8","وادفِنوني وَادفنوا الراح مَعي","وَاِجعَلوا الاقداحَ حَولَ المَقبرَهْ"],["08212151-568A-5696-9C2D-863115C58EE8","إِنَّني أَرجو مِنَ اللَهِ غَداً","بَعدَ شُربِ الراحِ حُسن المَغفِرهْ"]]},"B410B255-928C-5405-BE9A-7CBCE664FCBC":{"t":"تصبَّح بِوجهِ الراحِ وَالطائِر السَعدِ","p":86,"s":"تصبح بوجه الراح والطائر السعد","r":"474169","v":[["59DE957D-F8F4-5B5E-9EF3-DCAFEA20D61F","تصبَّح بِوجهِ الراحِ وَالطائِر السَعدِ","كميتاً وبعد المزجِ في صفةِ الوردِ"],["9F5BCC0A-2C60-5A3B-90D7-C9612FFB0469","تَضمَّنها زِقٌ أَزبُّ كَأَنَّهُ","صَريعٌ مِن السودانِ ذو شَعرٍ جَعدِ"],["4A2C0015-2803-51EF-B7C0-3741C6CD843E","وَلَمّا حَلَلنا رأسَهُ مِن رباطِهِ","وَفاضَ دماً كالمِسكِ أَو عنبرِ الهندِ"],["3A64A32C-12D0-514D-B39C-9E29911F5615","وَجَدناهُ في بعضِ الزَوايا كَأَنَّهُ","أَخو قِرَّةٍ يَهتَزُّ مِن شِدَّةِ البَردِ"],["256B9F34-AA5D-5EFC-A095-9D6EC5E58088","أَخو قِرَّةٍ يُبدي لَنا وجهَ صفحةٍ","كَلَونِ رَقيقِ الجِلدِ مِن وَلَدِ السَندِ"],["FC83A8C3-23B5-5236-9740-68C682A71B3B","سَيغني أَبا الهنديّ عَن وَطبِ سالِمٍ","أَباريقَ لَم يعلق بِها وَضرَ الزبدِ"],["2473F3DE-4CC4-5F2F-9764-2951C6AB1602","مُفدَّمةً قَزّاً كأنَّ رِقابَها","رِقابَ بَناتِ الماءِ أُفزِعنَ بِالرَعدِ"],["321048CC-D98D-5A56-8EAA-7985D66D0495","جلتها الجَوالي حينَ طابَ مِزاجُها","وَطَيَّبنَها بالمسكِ وَالعَنبَرِ الوَردي"],["4F12B01A-5E09-534A-8932-7A61D0860BA5","إِذا أَنفَذوا ما فيهِ جاؤا بِمِثلِهِ","غَطارفةً أَهل السَماحَةِ وَالمَجدِ"],["48AE550A-2C36-5533-ADFB-D6AFF93A6AA7","تمجُّ سُلافاً مِن قَواريرَ صُفِّفَت","وَطاسات صفر كلّها حَسَنُ القَدِّ"],["23468986-281D-5835-8B54-778E7E576F21","كميتاً ثوت في الدنِّ تِسعين حجَّةً","مُشعشعةً في شربِها واجِبُ الحَدِّ"],["59B44D66-CEA9-54B3-BDBC-B49D3E09DF20","عَقار إِذا ما ذاقَها الشَيخُ أَرعَشَت","مَفاصلُهُ وازدادَ وَجداً إِلى وَجدِ"],["2994D523-F0C3-5ADC-89A5-500B467E3677","وَيَبكي عَلى ما فاتَهُ مِن شَبابِهِ","بُكاَء أَسيرٍ في الصِفادِ وَفي القيدِ"],["8D615CA2-B9DE-5F6C-B89A-F6C1CBFF23EC","فَيَومانِ يَومٌ للأَميرِ أزورهُ","وَيَومٌ لقرعِ الصَنجِ وَالرّاحِ وَالنّردِ"],["A14435BA-FD4E-5483-87A1-078994B17E12","يَقولُ أَبو الهِنديِّ إِذ طابَ لَيلُهُ","وَحلَّقتِ الجَوزاءُ بِالكَوكَبِ الفَردِ"],["5CE9AB76-E89D-530D-B9E3-3D41731B0203","شَهِدتُ بِفِتيانٍ تَميمٌ أَبوهُم","حِسانُ وُجوهٍ مِن رَبابٍ وَمِن سَعدِ"]]},"7E072273-3117-50D4-9061-7C5F1CA2F0D8":{"t":"تَرَكتُ الخُمورَ لأَربابِها","p":86,"s":"تركت الخمور لأربابها","r":"474157","v":[["28D6C07B-CAEA-59D5-8742-5362E0DB1271","تَرَكتُ الخُمورَ لأَربابِها","وَاقبلتُ أَشرَبُ ماءً قُراحا"],["ACFAA28B-6F1B-510A-B058-679AD3E576C4","وَقَد كُنتُ حيناً بِها مُغرَماً","كحبّ الغلامِ الفَتاةَ الرَداحا"],["20E3C823-BEB6-5A6E-8A78-04F646A29FF2","فَلَم يَبقَ في الصَدرِ مِن حبّها","سِوى أَن إِذا ذُكِرت قُلتُ آحا"],["F7CA26CA-8051-57E7-86FC-010689CB8944","وَما كانَ تَركي لَها أَنَّني","يَخافُ نَديمي عَليَّ اِفتِضاحا"],["122F769B-67A2-5453-B234-ECDCFB81B73C","وَلَكِنَّ قَولي لَهُ مَرحَباً","وَأَهلاً مَع السَهلِ واِنعِم صَباحا"]]},"C8741F95-7FED-506B-B50D-660352BD096D":{"t":"ثَبَتَ الناسُ عَلى راياتِهم","p":86,"s":"ثبت الناس على راياتهم","r":"474214","v":[["AE2C466B-F64A-5AE7-9FF0-9BE03D85FEDF","ثَبَتَ الناسُ عَلى راياتِهم","وَأَبو الهِنديِّ في كَويِ زِيانِ"],["9F43055E-2AD6-5C0C-85BC-156749B522E4","مَنزِلٌ يَزري بِمَن حَلَّ بِهِ","تُستحلُّ الخَمرُ فيهِ وَالزَواني"],["F2B4712A-B924-5F59-B679-364DA9D3325C","إِنَّما العَيشُ فَتاةٌ غادَةٌ","وَقُعودي عاكِفاً في بَيتِ حانِ"],["FB7746AC-E8AC-52F3-A9B2-23A4101DE4C4","أشربُ الخمرَ وَأَعصي مَن نَهى","عَن طِلابِ الراحِ وَالبِيضِ الحِسانِ"],["D908FE92-8CCC-5B98-B675-B7CAE34EBC07","في حَياتي لَذةً أَلهو بِها","فَإِذا مِتُّ فَقَد أَودى زَماني"]]},"FC3703A4-824D-50D4-B9CE-E8060C60DA8D":{"t":"رَضيعُ المُدامِ فارقَ الراحَ روحُهُ","p":86,"s":"رضيع المدام فارق الراح روحه","r":"474195","v":[["83DB5B8D-149B-5BE4-B829-C799B2F00A7B","رَضيعُ المُدامِ فارقَ الراحَ روحُهُ","فَظَلَّ عَلَيها مُستَهِلَّ المَدامِعِ"],["6FA9F214-11B4-5A01-8A82-32EC7CE284E1","أَديرا عَليَّ الكأسَ إِنّي فَقَدتُها","كَما فَقَدَ المَفطومُ دَرَّ المَراضِعِ"]]},"79C5F62C-F30D-504A-83FB-4672EE951158":{"t":"سَألناهُ الجَزيلَ فَما تَأنّى","p":86,"s":"سألناه الجزيل فما تأنى","r":"474172","v":[["F1D641A0-5681-5F27-8004-5CC3C03D539C","سَألناهُ الجَزيلَ فَما تَأنّى","وَأَعطى فَوقَ مُنيَتِنا وَزادا"],["5512A9D9-E022-5C0B-B824-0A4273323781","وَأَحسَنَ ثُمَّ أَحسَنَ ثُمَّ عُدنا","فَأَحسَنَ ثُمَّ عُدتُ لَهُ فَعادا"],["07DB81F4-A402-51C9-9B7C-6BE26EB15AE6","مِراراً ما قَصَدتُ إِليه الاّ","تَبَسَّم ضاحِكاً وَثَنى الوِسادا"]]},"329BC345-F1B7-55C2-BBDC-AF1FE48D01C9":{"t":"سَقيتُ أَبا المُطَرّحِ إِذ أَتاني","p":86,"s":"سقيت أبا المطرح إذ أتاني","r":"474156","v":[["7A79432A-E9CC-5017-8463-B228174A5CCB","سَقيتُ أَبا المُطَرّحِ إِذ أَتاني","وَذو الرَعَثاتِ مُنتَصِبٌ يَصيحُ"],["D52EFCBB-5310-5B5A-82E2-BC7C927075EA","شَراباً يَهربُ الذِبّانُ عنهُ","وَيَلثَغُ حينَ يَشربُهُ الفَصيحُ"]]},"A51BDAF6-B443-5D7A-8278-ACB3395333D6":{"t":"شبَتٌ جَدّي وَجَدّي مُؤثرٌ","p":86,"s":"شبت جدي وجدي مؤثر","r":"474149","v":[["605F2AB0-F171-5FFA-ABCB-B58C45229B59","شبَتٌ جَدّي وَجَدّي مُؤثرٌ","لَم يُنازِعني عروقَ المؤتَشِبْ"],["34312B04-F1D0-5360-AD84-450FF49D3DB5","مِن بَني شيبانَ أَصلي ثابِتٌ","وَبَني يَربوعَ فرسانُ العَرَبْ"],["BF69C0A7-B08E-56B6-B463-94652C25CC44","أجمعُ المالَ وَما أَجمعُهُ","أَطلبُ اللَذَةَ في ماءِ العِنبْ"],["129CCE1A-8846-51B9-AE29-B37CA2FEC8C9","وَاِستبائي الزِّقَّ مِن حانوتِهِ","شائلَ الرجلينِ مَعضوبَ الذَنبْ"],["4A2696FD-D916-50BE-AACA-DF18084F4148","وَإِذا صُبَّت لِشِربٍ خلتَها","حَبَشِيّاً قطعَت منه الرُّكَبْ"],["34FBF791-C87E-5D5D-8A65-96DE2C0D53AF","يا خَليليَّ اسقياني عفوَها","بِالبَواطي البيضِ لَيسَت بالعُلَبْ"],["9FE20A39-4051-5D94-93AD-F865256296EE","من شَرابٍ خُسروانيٍّ إِذا","ذاقَهُ الشَيخُ تَغَنّى وَطربْ"],["2805C815-FBE2-5565-9387-5F34701244F6","يَترُك القَومَ إِذا ما طَرِبوا","في صياحٍ وَمِراءٍ وَصخَبْ"],["02742466-22AE-50DE-8B59-B713652DF006","وَإِذا ما مُنتشٍ قامَت بِهِ","رَفعَوا الأَوصالَ منهُ بِالخَشَبْ"],["A94DC3AE-D2CD-52F1-9E4A-F27107C65FF1","ثُمَّ ناحوا نوحَةً ثُمَّ بَكَوا","ثُمَّ ضَجّوا ضَحِكاً يا للَّعِبْ"],["C46E94D8-A1F1-5160-B7F9-5603B0F75DCE","وَهوَ مُنكَبٌّ عَلى جبهَتِهِ","مُزبِدَ الشدقين مُستَرخي العَصَبْ"],["0CAA1003-3272-5B9F-85A0-7E96665BF077","رفعَ الشَربُ لَهُ يا فَوخَهُ","بَعدَ لأيٍ ما تَوَلّى وَاِنقلَبْ"],["C2EA4D48-CCD4-59A9-9362-71D192911F7C","ساعَةً ثُمَّ دَعوهُ باسمهِ","فَأَجابَ المَرَء صَوتاً وَوثبْ"],["B10AC468-C50F-53B8-A1A5-DAB35C682213","يَنفضُ الرأسَ عَلَيهِ غبرةً","مِن تُرابٍ وَرَمادٍ وَقشَبْ"],["F44CFE4D-E16D-5B16-BC65-B21E2D8C8E33","وَأَتَوهُ بطهورٍ طَيِّبٍ","ليُصَلّي فَتَلَكّا وَقَطَبْ"],["F23AAAEC-BEFB-5395-9223-B197ED72D74B","أَيُّ رِجلٍ وكزَتهُ وَكزَةً","يَتَوَسَّدها وَطَنبور طَربْ"],["AB6C36C8-3EE9-57B3-AFAA-E0B4632A37E7","وَسَراويلٌ لَهُ مَرفوعَةٌ","حَلَق النَيفَق منها قَد ذهَبْ"]]},"E91F0051-7059-5F66-A495-6150DCD61FC0":{"t":"شَرِبتُ الخَمرَ في رَمَضانَ حَتّى","p":86,"s":"شربت الخمر في رمضان حتى","r":"474203","v":[["CD0F8456-72EC-5D95-ADFC-76EE40304958","شَرِبتُ الخَمرَ في رَمَضانَ حَتّى","رَأَيتُ البَدرَ لِلشِعرَى شَريكا"],["E4B2570C-FFFD-5DA3-BC92-2565B6EDB1D7","فَقالَ أَخي الدَيوكُ مُنادياتٌ","فَقُلتُ لَهُ وَما يُدري الدَيوكا"]]},"5F7805ED-B7C7-5B67-B249-6C0CA0985707":{"t":"شَرِبنا شَربَةً مِن ذاتِ عِرقِ","p":86,"s":"شربنا شربة من ذات عرق","r":"474193","v":[["56F9470E-E5EE-5064-A2B5-225FE9B6A1E4","شَرِبنا شَربَةً مِن ذاتِ عِرقِ","بِأَطرافِ الزّجاجِ مِنَ العَصيرِ"]]},"AC863421-0C8A-5E8F-A2D9-10376DEAB04B":{"t":"صيرت نفسيَ بالإحسان مُحسّدة","p":86,"s":"صيرت نفسي بالإحسان محسدة","r":"474224","v":[["A643C14A-D723-5600-8B0C-2D4CC7D157E6","صيرت نفسيَ بالإحسان مُحسّدة","لولا عطاياك لم يحسدني الناس"],["09D2159E-2B1D-50E2-9BCB-FBA5CFB8CE3F","تردد الشعراء المادحوك بما","أبدعته فيك والمداح أجناس"],["90F98A41-919B-5D69-BDAC-2D1072AA55AB","ما سار مدحك في الآفاق مشتهرا","إلا كما سار غيث منك رجاس"],["CABA9615-71F9-5A83-8F8C-52F782086D8B","في كل يوم بإقبال خُصصت به","لمن يعاديك إرغام وإتعاس"]]},"8F863117-A3FE-57C9-9CBF-35B53EC5454D":{"t":"طال عتب الزمان ظلماً علينا","p":86,"s":"طال عتب الزمان ظلما علينا","r":"474218","v":[["AB4FF215-E4EE-5368-8372-1FA9DEFD3D9E","طال عتب الزمان ظلماً علينا","وجفانا فما له إعتابُ"],["163E6173-E219-5A88-A0A6-3FA7ED132507","فأجرنا من عتبه وأذاه","أنت ترجى لمثله وتهابُ"],["457D19C3-6704-5953-AB94-138584861F20","ما لنا منصف سواك فيشكى","أنت كالنصل والملوك قرابُ"]]},"B651503F-0382-536F-BAFB-8D30FF8F1780":{"t":"فان تُسقَ مِن أَعنابِ وَجٍّ فإِنَّنا","p":86,"s":"فان تسق من أعناب وج فإننا","r":"474181","v":[["F6B919FB-DD8A-5A0A-8EB6-1B2C003F379B","فان تُسقَ مِن أَعنابِ وَجٍّ فإِنَّنا","لَنا العَينُ تَجري مِن كَسيسٍ وَمن خَمرِ"]]},"6F147208-387C-5A8C-9858-1B183EB269F9":{"t":"فَإِنَّ هَذا الوَطبَ لي ضائِرٌ","p":86,"s":"فإن هذا الوطب لي ضائر","r":"474190","v":[["4831F73E-C48C-5F8D-B984-AFB27145F527","فَإِنَّ هَذا الوَطبَ لي ضائِرٌ","في ظاهِرِ الأَمرِ وَفي الغامِضِ"],["00C775CE-9DA4-5327-B492-E8A716768397","إِن كُنتَ تَسقيني فَمِن قهوةٍ","صَفراَء مثلِ المُهرَةِ الناهِضِ"],["5A7C37AC-6B90-5219-8B40-A07BB70F9CD7","تَنزو الفَقاقيعُ إِذا شُعشِعَت","نَزوَ جَرادِ البلَد الرامِضِ"]]},"1989BB42-532B-5CC9-8BDE-005D5881D655":{"t":"فَما حَرَّمَ الرَحمَنُ مِن تمرِ عجوةٍ","p":86,"s":"فما حرم الرحمن من تمر عجوة","r":"474165","v":[["695C6FD9-EFCE-5802-A23C-A56DEF5C210A","فَما حَرَّمَ الرَحمَنُ مِن تمرِ عجوةٍ","وَلا ما سَقانا من ركيَّتِهِ سَعدُ"],["779B283E-E294-51CE-BE4C-002A7CC188F4","إِذا طرحا في الدَنِّ أخرجَ مِنهُما","شَرابٌ يَروقُ العينَ منظرهُ وَردُ"],["A2C675A6-EEEB-5338-99EC-F458AF9C98E1","نباكِر أخذ الكأسِ حَتّى كَأَنَّنا","نَرى في الضُحى أَطنابَ خيمتنا تَعدو"]]},"7422BF70-BEA4-5062-AD51-ACFD0FAF3267":{"t":"قُل للسريّ أَبي قَيسٍ أَتوعِدُنا","p":86,"s":"قل للسري أبي قيس أتوعدنا","r":"474168","v":[["5BC84F6E-B769-5730-8366-2C735FF2AAA7","قُل للسريّ أَبي قَيسٍ أَتوعِدُنا","وَدارُنا اصبحت مِن دارِكُم صَدَدا"],["9502157F-C4B4-534F-B609-82109ACFCB2D","أَبا الوَليد أمَا وَاللَهِ لَو عَمِلَت","فيكَ الشَمولُ لما حَرَّمتَها أَبَدا"],["1906A00C-003E-5B94-8259-F40A7B5B8942","وَلا نَسيتَ حُميّاها ولذَّتِها","وَلا عَدلتَ بِها مالاً وَلا وَلَدا"],["21C3BB88-3D42-51EE-A587-C8579EBD64A5","أَما رأيتَ أَخا الإِجمالِ مُنجدِلاً","اذا تَعلّى عَلى كُرسِّيهِ سَجَدا"]]},"27CCB034-6204-5A0D-97FD-725EB8BC6580":{"t":"كَأَنَّ أَباريقَ المَدامِ لديهمُ","p":86,"s":"كأن أباريق المدام لديهم","r":"474210","v":[["9403BB16-46F0-5647-8676-47F4F97A991E","كَأَنَّ أَباريقَ المَدامِ لديهمُ","ظِباءٌ بِأَعلى الرَقمتينِ قيامُ"],["BEC47DEF-109C-5F83-94C2-E0F819A88FF5","وَقَد شَرِبوا حَتّى كأَنَّ رِقابَهُم","مِنَ اللينِ لَم يَخلق لَهُنَّ عِظامُ"]]},"7A812870-A9E5-5CED-9D8A-6BB073DAC490":{"t":"لا تغبطن ذليلاً في معيشته","p":86,"s":"لا تغبطن ذليلا في معيشته","r":"474226","v":[["DF8F8C25-41FF-5A48-9EC3-B11D98B5A5B6","لا تغبطن ذليلاً في معيشته","فالموت أهون من عيش على مضض"],["0BD1CDD7-24A5-5310-8DE6-CDD86D74BDF7","لا يوجع الصخر نحتُ المرء جانبه","ولا من الذل ذو لبٍّ بممتعض"]]},"E15C61FE-F12E-5217-AC6C-E4ADF78FBB69":{"t":"لَمَّا سَمِعتُ الديكَ صاحَ بسحرةٍ","p":86,"s":"لما سمعت الديك صاح بسحرة","r":"474145","v":[["558B2AAB-1B45-541E-AA78-088E42323ED0","لَمَّا سَمِعتُ الديكَ صاحَ بسحرةٍ","وَتَوَسَّطَ النَسران بَطنَ العَقرَبِ"],["2425EA8C-5230-59F1-A5D4-976603CB9E19","وَتَتابعت عُصَب النُجومِ كَأَنَّها","عُفرُ الظِّباءِ عَلى فُروعِ المرقَبِ"],["E7BFB210-BD46-58F5-A97D-6D6FF73F5A9A","وَبَدا سهيلٌ في السَماءِ كَأَنَّهُ","ثورٌ وَعارضَه هِجانُ الرَبرَبِ"],["F95B93E3-9C1D-59A1-9196-EF6DF332C243","نَبَّهتُ نَدماني فَقُلتُ لَهُ اِصطَبِح","يا ابنَ الكرامِ مِنَ الشَرابِ الاصهَبِ"],["FE0622A3-9A74-5F63-82A6-D431E5D41070","صَفراَء تَنزو في الإِناءِ كَأَنَّها","عَين الجَرادَةِ أَو لُعابُ الجُندَبِ"],["5F6E2BFE-B6CC-5E7D-8E92-8B91D1347BDE","نَزوَ الدَبا مِن حَرِّ كلِّ ظَهيرةٍ","وَقّادَةٍ حرباؤُها يَتَقَلَّب"]]},"B8EB2967-A588-5B3D-B465-69188377020D":{"t":"مِن قهوةٍ تَنزو جَناديعها","p":86,"s":"من قهوة تنزو جناديعها","r":"474185","v":[["DC955F5D-40F4-57B8-AFBC-8D931212C448","مِن قهوةٍ تَنزو جَناديعها","بين لَها الحُلقومُ وَالحَنجرُ"]]},"AC579AAA-30D5-5DA3-8668-2671C0F5C7A2":{"t":"نَزَلتُ عَلى آلِ المُهَلَّب شاتياً","p":86,"s":"نزلت على آل المهلب شاتيا","r":"474201","v":[["05DC8E90-D087-5229-8F23-A292D3DBCD6E","نَزَلتُ عَلى آلِ المُهَلَّب شاتياً","غَريباً عَنِ الأَوطانِ في زَمَنِ المحلِ"],["D6453868-DF36-572B-8B14-2DE21E23FEBC","فَما زالَ بي إِحسانُهم وافتِقادُهم","وَبِرَّهُمو حَتّى حَسِبتهمُ أَهلي"]]},"8668B14F-7EB4-53F3-A14C-87185C76293D":{"t":"وقهوة كالعقيق صافية","p":86,"s":"وقهوة كالعقيق صافية","r":"474222","v":[["DD188AFA-070F-512F-BEF0-D7C2ED134ABB","وقهوة كالعقيق صافية","يطير في كأسها لها شرر"],["395E3647-7602-5AE9-A2CD-C27386C2A241","زوجتها الماء كي تذلَّ له","فامتعضت حين مسَّها الذكر"],["7CD4E503-7B3D-5CC4-8C47-1F0340E444ED","كذلك البكر عند خلوتها","يظهر منها الحياء والخفر"]]},"9C9AA189-A54C-5FBE-A4AF-B719962E5EF0":{"t":"وَصاحب حانوت عَشَوتُ لِنارِهِ","p":86,"s":"وصاحب حانوت عشوت لناره","r":"474147","v":[["31C4983E-B6D9-5108-906F-AB6CB22A5D0B","وَصاحب حانوت عَشَوتُ لِنارِهِ","وَقَد مالَت الجَوزاءُ نَحوَ المَغارِبِ"],["82992D5D-0E3E-54BC-BAC4-9B8BC09C4B1B","فَقالَ أَلا عَجِّل لَنا النَقد إِنَّنا","أُناسٌ أَخَذنا بِالكَرا وَالضَرائِبِ"],["37A2316B-48B9-524D-B517-E07391E62A83","نثرت لَهُ عِشرينَ بيضاً كَأَنَّها","عَلى كَفَّةِ الميزانِ زهرَ الكَواكِبِ"],["2FE58C6B-A720-51C2-9B1C-0768E6E177D7","فصبَّ لَنا حَمراَء يَنزو حبابها","إِذا شَعشَعَت بالدَّنِّ نَزوَ الجَنادِبِ"]]},"3E207EB3-C9AF-5F0F-AB8F-09C0819FDAFE":{"t":"وَفارَةِ مِسكٍ من عذارٍ شَممتَها","p":86,"s":"وفارة مسك من عذار شممتها","r":"474177","v":[["5436F09E-1755-5DC8-A483-42A1841C2D4D","وَفارَةِ مِسكٍ من عذارٍ شَممتَها","يَفوحُ عَلَينا مِسكها وَعَبيرُها"],["753E49AE-DAD2-501E-8586-029DE4BECFDC","سَموتُ إِلَيها بَعدَ أن نامَ أَهلُها","غُدوّاً وَلَمّا تُلقَ عَنها سُتورُها"],["714A3D1D-B8CC-5E66-ACE4-981630F985F8","سَيُغني أَبا الهِنديِّ عَن وَطبِ سالِمٍ","أَباريقَ كالغُزلانِ بيضٌ نُحورُها"],["C780A8C5-C39F-5D4F-92C1-27EE18B13E19","مفدَّمةً قَزّاً كأنَّ رِقابَها","رِقابُ الكَراكي افزَعتها صُقورها"],["6467D8DC-BB8F-5E10-A99A-04C0B6E1F5D8","مصبَّغةَ الأَعلى كأَنَّ سَراتَها","ذَبائحُ أَنصابٍ توافت شُهورُها"],["990F0567-ADA9-5DD5-BF08-A2662E1A6247","تَلالأُ في أَيدي السُّقاة كَأَنَّها","نُجومُ الثرَّيا زَّيَنَتها عبُورُها"],["F8D999F6-BE00-5C36-9A8C-DBC1824D7BE8","تَمُجُّ سُلافاً مِن زِقاقٍ كَأَنَّها","شُيوخ بَني حام تَحَنَّت ظهورُها"],["4AFD680C-D8CE-5858-84A8-D602A98AAE9B","أُقَبِّلُها فَوقَ الفِراشِ كَأَنَّها","صَلايةُ عَطّارٍ يَفوحُ زَريرُها"],["5C4CB1BB-01BD-5E13-B779-43DA5572CC40","إِذا ذاقها مَن ذاقَ جادَ بِمالِهِ","وَقَد قامَ ساقي القَومِ وَهناً يُديرُها"],["14E3E21E-1A96-5C95-AA13-31FC5B019EA4","خَفيفا مَليحاً في قَميصٍ مُقَلِّصٍ","وُجبَّةُ خَزٍّ لَم تُشَدُّ زُرورُها"],["8A44B653-C3D1-5B96-A748-51FAA12B6D3A","وَجاريَةٍ في كَفِّها عودُ بربَطٍ","يجاوِبُها عِندَ الترَنُّمِ زِيرُها"],["643A7E1E-7FE7-565B-9838-D028C69027F9","إِذا حَرَّكَتهُ الكَفُّ قُلتُ حَمامة","تُجيبُ عَلى أَغصانِ أَيكٍ تَصورها"],["A0ED477A-5CE7-54BC-879C-9A036E6C67EE","تُجاوِب قُمْريّاً أَغَنَّ مطوَّقاً","شَقائِقُهُ مَنشورَةٌ وَشَكيرُها"],["181B5B22-58F0-5D9C-9914-6D11927C340E","إِذا غَرَّدَت عند الضَحاء حَسِبتَها","نَوائحُ ثَكلى أَوجَعتها قُبورُها"],["71A9158E-306C-5026-A8CC-0F0F24C8F835","وَكأسٍ كعينِ الديكِ قَبلَ صِياحِهِ","شَرِبتُ بِزهر لَم يَضرني ضَريرُها"],["3879D507-61A4-501B-9254-960ABA4849BD","فَما ذَرَّ قرنُ الشَمسِ حَتّى كَأَنَّها","أَرى قَريةً حَولي تَزَلزَلُ دُورُها"]]},"58BDF8AD-C195-599C-BC49-C57C7686191C":{"t":"وَفِتيانِ صِدقٍ مِن تَميمٍ وُجوهُهم","p":86,"s":"وفتيان صدق من تميم وجوههم","r":"474159","v":[["7C6E3B11-3026-5F82-BB34-2F88FE7F776D","وَفِتيانِ صِدقٍ مِن تَميمٍ وُجوهُهم","وإِن سفعتهنَّ الهَواجِرُ وَضَّحُ"],["58E54141-C384-5B67-ABEB-CB3014B7085C","رَفَعتُ لَهُم يَوما خِباءً ممدَّداً","بستة أَرماحٍ تَسُفُّ وَتَطمَحُ"],["E15A486C-2F60-5746-A23E-42736D2B0A0A","تُخفِّضُهُ أَيديهِمُ فَكأَنَّهُ","ظَليمٌ عَلى هاماتِهِم يَتَرَجَّحُ"],["A78A9F1A-96EE-5DB9-B536-D28C5E757EB5","كَأَنّا رَبطنا بِالخباءِ مُشَهَّراً","مِنَ الخَيلِ مِلواحاً يَسيرُ وَيرمَحُ"]]},"8D9A46BB-8039-5C59-948A-0F69860C736C":{"t":"وَلَها دَبيبٌ في العِظامِ كَأَنَّهُ","p":86,"s":"ولها دبيب في العظام كأنه","r":"474205","v":[["16232B3E-E7AA-55AF-A933-A680A6AAA1EE","وَلَها دَبيبٌ في العِظامِ كَأَنَّهُ","فيضُ النعاسِ وَأَخذهِ في المفصلِ"]]},"5C8C1972-B812-58D8-91A5-9E04BF83D277":{"t":"وَلَو أَنَّ لي داراً يَحِلُّ دخولُها","p":86,"s":"ولو أن لي دارا يحل دخولها","r":"474174","v":[["D8A675BB-7519-5FC6-913C-FB99B8A49F4D","وَلَو أَنَّ لي داراً يَحِلُّ دخولُها","لَمَتَّعتكم بِالعزفِ فيها وَبِالخَمرِ"],["98337079-EFD8-5997-B221-BF0AAD23F2D4","وَلَكِنَّني في دار سَوءٍ كَأَنَّها","بَقيَّةِ ناووسٍ عَلى ساحِلِ البَحرِ"],["2C39D8DB-450A-57DB-80B4-B48F19760046","أؤدي إِلى مَن عَجَّل اللَهُ مَوتَهُ","لأدفِنَهُ فيها ثَلاثينَ في الشَهرِ"]]},"4C2BA909-ECA8-5198-9D46-5A4BFEADB5E2":{"t":"يا ابنَ مَن يَكتُبُ في","p":86,"s":"يا ابن من يكتب في","r":"474152","v":[["6639D48B-F8F8-50AD-BFC7-2E1474C3D711","يا ابنَ مَن يَكتُبُ في الأَر","قاب مِن غَيرِ دواةِ"],["D208E67E-2A91-583A-9A77-E92144E4CDA9","لَم يَكُن يَكتُبُ فيها","غَيرَ خَطِّ الألِفاتِ"]]},"5121A1AC-D311-5D0D-9BCD-CBA13B1B35B9":{"t":"يا لِقَومي فَتَنَتني جارَتي","p":86,"s":"يا لقومي فتنتني جارتي","r":"474179","v":[["53CAFC20-43B9-59F8-818E-E67F864B6C99","يا لِقَومي فَتَنَتني جارَتي","بَعدَ ما شِبتُ وَأَبلاني الكِبَرْ"],["FB5B2DB1-6A89-5060-8C7F-3CFC6B82D52E","وَأتَتْ لي سَنواتٌ أَربَعٌ","بَعدَ ستين تَقضَّت لي أُخَرْ"],["9BD5BE4D-3075-5012-BD06-4A45E4F81644","بَعدَ ما كُنتُ فَتىً ذا مِرَّةٍ","بَين غِزلانٍ أَثارَتها البَطَرْ"],["C485684D-7AEB-57B2-AC78-4FBA09D664F5","شيبة أَنكرن حيناً شأنَها","وَأَنا القَرمُ اذا عُدَّت مُضَرْ"],["04E3B999-98E2-5363-BF01-A0E058FB832E","حَبَّذا الشربُ بدارين إِذا","بِتُّ أُسقاها وَقَد غابَ القَمَرْ"],["0C3C6B91-4E83-5BFB-A39C-285399AEE229","عندنا صنّاجَةٌ رَقّاصَةٌ","وَغُلامٌ كُلَّما شِئنا زَمَرْ"],["B5EA0A19-7FAE-5A5A-BB3A-43A41F4C1925","حَسَنُ العرنين ذو قَصّابةٍ","زانَهُ شَذرٌ وَياقوتٌ وَدُرّْ"],["3769A37C-E257-57A3-81D4-AF151A637057","وَإِذا قُلتُ لَهُ قم فاسقنا","قامَ يَمشي مشيَةَ اللَيثِ الهَصِرْ"],["DC8E5CF7-D38A-57EC-A27A-7CDB0B2E3E97","وَأَتانا بِشَمولٍ قَهوَةٍ","نَتَعاطاها بِكاساتِ الصُّفُرْ"],["DDA8A50D-2EF3-5531-96B2-C9850CBF4A63","وَأَباريقَ تَناهَت سَعَةً","وَالَّذي في الكَفِّ مَلثومٌ أَغَرّْ"],["5ABCC507-A28D-55A6-B880-A90244A7BCF7","مِثل فَرخٍ هَبَّ في غيطلةٍ","حَذَرَ الصَقرِ فأقعى وَنَظَرْ"],["16BF4EAA-15FC-5115-811D-3DF77B98F235","أَو كَظَبيِ اللصبِ وافى مَرقباً","حَذرَ القانِص صُبحاً فَنَفرْ"],["EDB5077A-DF11-5C67-9FC1-F30F40C4C490","فعلا ثُمَّ اِستَوى مُرتَئباً","قُلَّةَ الطَورِ عَلى رأسِ الحَجَرْ"]]},"C5D50FB9-B2FF-5EC0-8A9B-F9BE97301D09":{"t":"يَدي لا تَعافُ الكأسَ أُنساً بشربِها","p":86,"s":"يدي لا تعاف الكأس أنسا بشربها","r":"474161","v":[["C64B5D7A-50F9-529F-A2B7-26056AD8A270","يَدي لا تَعافُ الكأسَ أُنساً بشربِها","وَلَكِن تعافُ الكأسَ مَع دنِسٍ وغدِ"],["A146AB45-8E2C-5BD1-BAC6-186274E3D517","عَلى مثلِها مِثلي يَكون مُنادِمي","فإِن لَم أَجِد مِثلي خَلوتُ بِها وَحدي"]]},"F30DAB0C-675F-5A45-9B20-1D3234EF0D55":{"t":"َدامى بَعدَ ثالِثَةٍ تَلاقوا","p":86,"s":"دامى بعد ثالثة تلاقوا","r":"474153","v":[["ED5138C6-3415-57DC-A812-5A2B8D145CA3","نَدامى بَعدَ ثالِثَةٍ تَلاقوا","يَضمُّهُم بِكوهْ زَيّانَ راحُ"],["F3A9E4FB-28A3-5415-8581-5827B9EA1DEF","وَقَد باكَرتُها فَتَرَكتُ مِنها","قَتيلاً ما أَصابَتني جِراحُ"],["5475A9F6-622E-5956-84F6-220CB69DD55D","وَقالوا أَيُّها الخَمّارُ مَن ذا","فَقالَ أَخٌ تخوَّنهُ اصطِباحُ"],["02A37ABF-72DB-533F-B056-90AD99319E44","ادارَ الراحَ حَتّى أَقعَصَتهُ","فَخَرَّ كَأَنَّهُ عودٌ شناحُ"],["14C0BB44-FC3D-5819-887A-9D14541D5AD7","فَقالَ هاتِ أَلحِقنا بِراحٍ","بِهِ وَتَعللوا ثُمَّ اِستَراحوا"],["96CCCB3E-1F17-5390-A96A-25A7D707B9DA","فَلَم يَتَمَهَّلوا حَتّى رَمَتهُم","بِحَدِّ سلاحِها وَلَها سِلاحُ"],["BE069497-6B52-56BF-A043-5EB6B431D0CA","وَحانَ تَنضبُّهي فَسألتُ عَنهُم","فَقالَ أَتاحهم قَدرٌ مُتاحُ"],["3EB5145C-20FA-5CCE-89BE-67A91A7ECF10","رأوكَ مُجدَّلاً فآستَخبروني","فَحَرّكَهُم إِلى الشّربِ اِرتياحُ"],["90E7BC03-3144-56EF-8EB2-05151E55F11A","فَقُلتُ لَهُ فَسرَّحَني إِليهم","حَثيثاً وَالسراحُ هُوَ النَجاحُ"],["77723407-0042-5CC9-9BAC-97F2D39F9F21","فَقالَ نَعَم فَقالوا اَلحِقَنَّا","بِهِ قَد لاحَ لِلرائي صَباحُ"],["D2B60551-452E-56E8-8887-0B41F9238893","فَما أَن زالَ ذاكَ الدأبُ مِنّا","ثَلاثاً يَستَغِبُّ وَيُستَباحُ"],["C3B062F2-EB2D-5118-924C-DED57EF889A1","نَبيتُ مَعاً وَلَيسَ لَنا اِلتِقاءٌ","بِبَيتٍ مالَنا مِنهُ بَراحُ"]]}}}