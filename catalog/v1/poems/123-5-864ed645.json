{"v":1,"poems":{"E5FCF535-4C2D-5568-A465-F8066B19ACC9":{"t":"يا أخت خير أخ يا بنت خير أب","p":123,"s":"يا أخت خير أخ يا بنت خير أب","r":"441509","v":[["114641D0-7448-5098-AA79-FB183C419127","يا أُخْتَ خَيرِ أخٍ يا بِنْتَ خَيرِ أبِ","كِنَايَةً بهِمَا عَنْ أشرَفِ النّسَبِ"],["68E489C8-A895-5A2B-902E-CDA0B057B77E","أُجِلُّ قَدْرَكِ أنْ تُسْمَيْ مُؤبَّنَةً","وَمَنْ يَصِفْكِ فَقد سَمّاكِ للعَرَبِ"],["45049E5E-A198-5ED8-B749-6FB853B644B5","لا يَمْلِكُ الطّرِبُ المَحزُونُ مَنطِقَه","وَدَمْعَهُ وَهُمَا في قَبضَةِ الطّرَبِ"],["4308884B-B303-5B2A-9CB6-63EEF4283426","غدَرْتَ يا مَوْتُ كم أفنَيتَ من عدَدٍ","بمَنْ أصَبْتَ وكم أسكَتَّ من لجَبِ"],["7A2D5D2E-3538-560B-96CE-E5A7FDA852F8","وكم صَحِبْتَ أخَاهَا في مُنَازَلَةٍ","وكم سألتَ فلَمْ يَبخَلْ وَلم تَخِبِ"],["5F5C673E-9C09-5665-A181-92CAD6D9DAB6","طَوَى الجَزِيرَةَ حتى جاءَني خَبَرٌ","فَزِعْتُ فيهِ بآمالي إلى الكَذِبِ"],["BDED049A-3971-587A-B83A-83A47646A83C","حتى إذا لم يَدَعْ لي صِدْقُهُ أمَلاً","شَرِقْتُ بالدّمعِ حتى كادَ يشرَقُ بي"],["E6F68BF2-3CA2-575D-B0D4-4736683DC85E","تَعَثّرَتْ بهِ في الأفْوَاهِ ألْسُنُهَا","وَالبُرْدُ في الطُّرْقِ وَالأقلامُ في الكتبِ"],["148D7237-B174-5265-B243-F245A4BB64FC","كأنّ فَعْلَةَ لم تَمْلأ مَوَاكِبُهَا","دِيَارَ بَكْرٍ وَلم تَخْلَعْ ولم تَهَبِ"],["EA8BD85F-A3B2-5429-8168-8DE5F20B96EC","وَلم تَرُدّ حَيَاةً بَعْدَ تَوْلِيَةٍ","وَلم تُغِثْ داعِياً بالوَيلِ وَالحَرَبِ"],["2AF698FE-6AE3-5065-B3CA-05D24C9BD917","أرَى العرَاقَ طوِيلَ اللّيْلِ مُذ نُعِيَتْ","فكَيفَ لَيلُ فتى الفِتيانِ في حَلَبِ"],["A8B8CF79-21F2-51A5-8630-52EFF8C2FDF6","يَظُنّ أنّ فُؤادي غَيرُ مُلْتَهِبٍ","وَأنّ دَمْعَ جُفُوني غَيرُ مُنسكِبِ"],["80D8D171-3676-582E-B2A1-58D65864758D","بَلى وَحُرْمَةِ مَنْ كانَتْ مُرَاعِيَةً","لحُرْمَةِ المَجْدِ وَالقُصّادِ وَالأدَبِ"],["8894AD09-B914-58F5-8619-E22283F0EB69","وَمَن مَضَتْ غيرَ مَوْرُوثٍ خَلائِقُها","وَإنْ مَضَتْ يدُها موْرُوثَةَ النّشبِ"],["6EF6EC43-337D-5D3B-A814-EB04691EF94A","وَهَمُّهَا في العُلَى وَالمَجْدِ نَاشِئَةً","وَهَمُّ أتْرابِها في اللّهْوِ وَاللّعِبِ"],["62DDF961-DA77-5384-B33C-3456CAF09287","يَعلَمْنَ حينَ تُحَيّا حُسنَ مَبسِمِها","وَلَيسَ يَعلَمُ إلاّ الله بالشَّنَبِ"],["D8A919BC-370B-5053-87D6-2BB03CE14608","مَسَرّةٌ في قُلُوبِ الطّيبِ مَفِرقُهَا","وَحَسرَةٌ في قُلوبِ البَيضِ وَاليَلَبِ"],["F39B56C1-60FD-5D78-AB0C-4853EAE69B68","إذا رَأى وَرَآهَا رَأسَ لابِسِهِ","رَأى المَقانِعَ أعلى منهُ في الرُّتَبِ"],["9358638B-229C-511E-A094-45632DF11691","وَإنْ تكنْ خُلقتْ أُنثى لقد خُلِقتْ","كَرِيمَةً غَيرَ أُنثى العَقلِ وَالحَسبِ"],["067EED92-A540-5FAE-B5F0-0722FCD343E3","وَإنْ تكنْ تَغلِبُ الغَلباءُ عُنصُرَهَا","فإنّ في الخَمرِ معنًى لَيسَ في العِنَبِ"],["312AE36D-694A-54FC-9777-FB9FF9F90964","فَلَيْتَ طالِعَةَ الشّمْسَينِ غَائِبَةٌ","وَلَيتَ غائِبَةَ الشّمْسَينِ لم تَغِبِ"],["F0F15156-E57B-5B5F-98AC-03CCCB14E816","وَلَيْتَ عَينَ التي آبَ النّهارُ بهَا","فِداء عَينِ التي زَالَتْ وَلم تَؤبِ"],["B45C6769-4300-5545-AA16-D40F9F4B0A5B","فَمَا تَقَلّدَ بالياقُوتِ مُشْبِهُهَا","وَلا تَقَلّدَ بالهِنْدِيّةِ القُضُبِ"],["C3A43E57-55EA-56EB-AB1F-6D096ABA499C","وَلا ذكَرْتُ جَميلاً مِنْ صَنائِعِهَا","إلاّ بَكَيْتُ وَلا وُدٌّ بلا سَبَبِ"],["2E6C340C-3269-559A-BF72-FB3D7C8CBFC8","قَد كانَ كلّ حِجابٍ دونَ رُؤيَتها","فَمَا قَنِعتِ لها يا أرْضُ بالحُجُبِ"],["8AFEDE5A-669D-5C3C-B163-A10FC53319A7","وَلا رَأيْتِ عُيُونَ الإنْسِ تُدْرِكُها","فَهَلْ حَسَدْتِ عَلَيها أعينَ الشُّهبِ"],["5C45E58D-D5EB-5C83-9757-6C2A19D2D319","وَهَلْ سَمِعتِ سَلاماً لي ألمّ بهَا","فقَدْ أطَلْتُ وَما سَلّمتُ من كَثَبِ"],["F05C0F28-6D7F-5089-8B28-0B3113FA56F0","وَكَيْفَ يَبْلُغُ مَوْتَانَا التي دُفِنَتْ","وَقد يُقَصِّرُ عَنْ أحيائِنَا الغَيَبِ"],["11980127-A602-5EC8-8374-471BD8A515B3","يا أحسَنَ الصّبرِ زُرْ أوْلى القُلُوبِ بِهَا","وَقُلْ لصاحِبِهِ يا أنْفَعَ السُّحُبِ"],["80B70B8A-5343-5086-BBB4-415ACCFF1A6C","وَأكْرَمَ النّاسِ لا مُسْتَثْنِياً أحَداً","منَ الكِرامِ سوَى آبَائِكَ النُّجُبِ"],["BE0438E1-ADE8-57FF-B5B1-944CF2205A9A","قد كانَ قاسَمَكَ الشخصَينِ دهرُهُما","وَعاشَ دُرُّهُما المَفديُّ بالذّهَبِ"],["03862BEE-2E5C-54B8-B2A2-B34CEFD42201","وَعادَ في طَلَبِ المَترُوكِ تارِكُهُ","إنّا لَنغْفُلُ وَالأيّامُ في الطّلَبِ"],["B2C153EE-4255-5783-8A25-3E953384E40E","مَا كانَ أقصرَ وَقتاً كانَ بَيْنَهُمَا","كأنّهُ الوَقْتُ بَينَ الوِرْدِ وَالقَرَبِ"],["A1EE51CE-ECC0-593F-BEE1-DBD54F6C93FE","جَزَاكَ رَبُّكَ بالأحزانِ مَغْفِرَةً","فحزْنُ كلّ أخي حزْنٍ أخو الغضَبِ"],["81883B6C-7943-5D2D-9D3F-4067C3B56421","وَأنْتُمُ نَفَرٌ تَسْخُو نُفُوسُكُمُ","بِمَا يَهَبْنَ وَلا يَسخُونَ بالسَّلَبِ"],["F2C747C9-38C5-5DAF-9F78-4B523CD4727D","حَلَلْتُمُ من مُلُوكِ الأرْضِ كلّهِمِ","مَحَلَّ سُمرِ القَنَا من سائِرِ القَصَبِ"],["DF4623BC-D1BA-54F0-A570-455B7C314DF8","فَلا تَنَلْكَ اللّيالي، إنّ أيْدِيَهَا","إذا ضَرَبنَ كَسَرْنَ النَّبْعَ بالغَرَبِ"],["8167CD76-4D2A-56AE-BF88-13C3072319DA","وَلا يُعِنّ عَدُوّاً أنْتَ قاهِرُهُ","فإنّهُنّ يَصِدْنَ الصّقرَ بالخَرَبِ"],["D4E7B7B9-D114-5E2A-9DCA-7023804E8C9E","وَإنْ سَرَرْنَ بمَحْبُوبٍ فجَعْنَ بهِ","وَقَد أتَيْنَكَ في الحَالَينِ بالعَجَبِ"],["92E7B6C5-FC94-5D77-B4A7-BBE4FB793BB1","وَرُبّمَا احتَسَبَ الإنْسانُ غايَتَهَا","وَفاجَأتْهُ بأمْرٍ غَيرِ مُحْتَسَبِ"],["CDB7889A-9D36-52EE-80A5-EDE6800F0532","وَمَا قَضَى أحَدٌ مِنْهَا لُبَانَتَهُ","وَلا انْتَهَى أرَبٌ إلاّ إلى أرَبِ"],["F2BF67EC-D44C-580B-9B6A-6DD574B8B5DE","تَخالَفَ النّاسُ حتى لا اتّفاقَ لَهُمْ","إلاّ على شَجَبٍ وَالخُلفُ في الشجبِ"],["FFEB4E12-5124-5B78-84C5-CCBED993EDFD","فقِيلَ تَخلُصُ نَفْسُ المَرْءِ سَالمَةً","وَقيلَ تَشرَكُ جسْمَ المَرْءِ في العَطَبِ"],["4CDCD2D4-862F-5507-A345-D2350FEA61A9","وَمَنْ تَفَكّرَ في الدّنْيَا وَمُهْجَتهِ","أقامَهُ الفِكْرُ بَينَ العَجزِ وَالتّعَبِ"]]},"EC80AF40-5866-5361-AA5B-BD3587EA1DA2":{"t":"يا أكرم الناس في الفعال","p":123,"s":"يا أكرم الناس في الفعال","r":"447605","v":[["F177AB8A-D331-55E3-8DDC-DADCA4B53C8D","يا أكرَمَ النّاسِ في الفَعالِ","وأفْصَحَ النّاسِ في المَقَالِ"],["9E6E522F-2685-5F7A-8DEC-061703E514F3","إنْ قُلتَ في ذا البَخُورِ سَوْقاً","فهَكَذا قُلتَ في النّوالِ"]]},"14DF2341-A140-5A71-8824-73C77B3673AB":{"t":"يا أيها الملك الذي ندماؤه","p":123,"s":"يا أيها الملك الذي ندماؤه","r":"447563","v":[["8C7CE4CA-9475-5FF7-8582-AAD963D9BBA0","يا أيّها المَلِكُ الذي نُدَماؤهُ","شُرَكاؤهُ في مِلْكِهِ لا مُلكِهِ"],["9EBA7CB1-868D-562E-BD61-6B002C3701C2","في كلّ يَوْمٍ بَيْنَنا دَمُ كَرْمَةٍ","لكَ تَوْبَةٌ من تَوْبَةٍ من سَفكِهِ"],["E88C030C-9854-5B91-A6BD-BD27D9696DD4","والصّدقُ من شيَمِ الكرام فقلْ لنا","أمنَ الشّرابِ تَتوبُ أم من تركِهِ؟"]]},"C204D0AD-5050-51C4-A9FA-872F3D35769D":{"t":"يا بدر إنك والحديث شجون","p":123,"s":"يا بدر إنك والحديث شجون","r":"447664","v":[["3B7FF112-999C-5085-BCDD-EDD673E9FCE5","يا بَدْرُ إنّكَ والحَديثُ شُجُونُ","مَنْ لمْ يَكُنْ لِمثَالِهِ تَكْوِينُ"],["C5EFCBAA-36EB-535A-AABD-D0BA7DA3C215","لَعَظُمْتَ حتى لوْ تَكُونُ أمَانَةً","ما كانَ مُؤتَمَناً بها جِبْرِينُ"],["E44F206C-233C-5EFE-866B-C4EE8B0BD01A","بَعْضُ البريّةِ فَوْقَ بَعْضٍ خالِياً","فإذا حضَرْتَ فكُلُّ فَوْقٍ دُونُ"]]},"676B2F98-D377-5BFB-A208-019FA29C54CB":{"t":"يا ذا المعالي ومعدن الأدب","p":123,"s":"يا ذا المعالي ومعدن الأدب","r":"441518","v":[["0084B481-BF38-5FCC-A4A3-2EF6D1348A3D","يا ذا المَعالي ومَعْدِنَ الأدَبِ","سَيّدَنا وابنَ سَيّدِ العَرَبِ"],["2BA65523-E962-5C5A-B5E5-7D905E165FE9","أنْتَ عَليمٌ بكُلّ مُعْجِزَةٍ","ولَوْ سألْنا سِواكَ لمْ يُجِبِ"],["A96C574E-4A60-517F-BCCD-F954FC64C2C8","أهذِهِ قابَلَتْكَ راقِصَةً","أمْ رَفَعَتْ رِجْلَها منَ التّعَبِ"]]},"95CC5CAA-070D-533B-AAEE-9A0098102720":{"t":"يا من رأيت الحليم وغدا","p":123,"s":"يا من رأيت الحليم وغدا","r":"441561","v":[["4DE788E7-7245-5CD3-8314-27BCFF2C3177","يا مَنْ رَأيْتُ الحَليمَ وَغْدَا","بِهِ وحُرَّ المُلُوكِ عَبْدَا"],["837F140B-9600-5725-9C38-241EBC5C1BF3","مالَ عَليّ الشّرابُ جِدّا","وأنْتَ للمَكْرُماتِ أهْدَى"],["1B53BDFD-83F5-5C5F-BC6B-0A40C2421257","فإنْ تَفَضّلْتَ بانْصِرافي","عَدَدْتُهُ مِنْ لَدُنْكَ رِفْدَا"]]},"2117A954-E396-5474-940A-FAC13A6E2591":{"t":"يذكرني فاتكا حلمه","p":123,"s":"يذكرني فاتكا حلمه","r":"447651","v":[["B1BA792E-D6DF-5C06-9613-EF1E31AF8B80","يُذكّرُني فاتِكاً حِلْمُهُ","وَشَيْءٌ مِنَ النّدّ فيهِ اسمُهُ"],["A0FA527C-5B2B-5DFD-A026-B32A97E98FE5","وَلَسْتُ بِنَاسٍ وَلَكِنّني","يُجَدّدُ لي رِيحَهُ شَمُّهُ"],["3614659F-DA97-539B-A6B9-04585334DE8E","وَأيَّ فَتىً سَلَبَتْني المَنُو","نُ لم تَدْرِ ما وَلَدَتْ أُمُّهُ"],["1D26E76B-1AFB-5323-9944-A52038AE7DBB","وَلا مَا تَضُمّ إلى صَدْرِهَا","وَلَوْ عَلِمَتْ هالَهَا ضَمُّهُ"],["EF386FD1-07C6-5BF7-98D8-77554BDE624A","بمِصْرَ مُلُوكٌ لَهُمْ مَالُهُ","وَلَكِنّهُمْ مَا لَهُمْ هَمُّهُ"],["253E796E-4442-565B-A7BB-F01857AB56BF","فأجْوَدُ منْ جُودِهِمْ بُخلُهُ","وَأحْمَدُ مِنْ حَمْدِهِمْ ذَمُّهُ"],["092F0B59-7BA8-5D4F-8AE9-FD3E45909BF2","وَأشرَفُ مِنْ عَيْشِهِمْ مَوْتُهُ","وَأنْفَعُ مِنْ وَجْدِهِمْ عُدْمُهُ"],["B02A14EC-2401-55AD-8B32-17D57315BFF1","وَإنّ مَنِيّتَهُ عِنْدَهُ","لَكالخَمْرِ سُقّيَهُ كَرْمُهُ"],["351061AB-5594-5146-B10F-C44931D0B631","فذاكَ الذي عَبَّهُ مَاؤهُ","وَذاكَ الذي ذاقَهُ طَعْمُهُ"],["17BB4B8F-0BCB-5A8A-992A-5A7C1A809049","وَمَن ضاقَتِ الأرْضُ عَنْ نَفسه","حَرًى أن يَضِيقَ بها جِسمُهُ"]]},"12914D63-3AF6-545D-B6DD-DDF1634AE6B9":{"t":"يستعظمون أبياتا نأمت بها","p":123,"s":"يستعظمون أبياتا نأمت بها","r":"441556","v":[["6C1F299D-736A-5020-A9B5-D723178E7E1F","يَسْتَعْظِمُونَ أُبَيّاتاً نَأمْتُ بهَا","لا تَحْسُدُنّ على أنْ يَنْأمَ الأسَدَا"],["603BEF8E-2CCC-5C1C-B9C7-EB1B81D24936","لَوْ أنّ ثَمّ قُلُوباً يَعْقِلُونَ بهَا","أنْساهُمُ الذّعْرُ ممّا تحتَها الحَسَدَا"]]},"F991F0A7-BF35-5B64-AF30-B299DC4AB9BF":{"t":"يقاتلني عليك الليل جدا","p":123,"s":"يقاتلني عليك الليل جدا","r":"441540","v":[["349A5641-8108-526E-A81A-284E7D47FD10","يُقاتِلُني عَلَيْكَ اللّيْلُ جِدّاً","ومُنصَرَفي لَهُ أمضَى السّلاحِ"],["2153B565-7E26-5231-889C-984D829BF16A","لأنّي كُلّما فارَقْتَ طَرْفي","بَعيدٌ بَينَ جَفْني والصّباحِ"]]},"E14C8AA0-3520-5343-9644-BA8257CB3887":{"t":"يقل له القيام على الرؤوس","p":123,"s":"يقل له القيام على الرؤوس","r":"447523","v":[["017E91F2-CEAC-5554-A6A2-7DEAE61F429C","يَقِلّ لَهُ القِيامُ على الرّؤوسِ","وَبَذْلُ المُكْرَماتِ منَ النّفوسِ"],["915660C6-22D2-5298-B372-E5CB2DDC14AB","إذا خانَتْهُ في يَوْمٍ ضَحُوكٍ","فكَيفَ تكُونُ في يوْمٍ عَبُوسِ"]]}}}