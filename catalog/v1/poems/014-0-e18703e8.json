{"v":1,"poems":{"8FF4B6F8-D317-50DE-AD7E-6D30AB36428A":{"t":"معلقة عبيد بن الأبرص","p":14,"s":"معلقة عبيد بن الأبرص","r":"532030","v":[["5E3AD641-F7C9-5FA4-9462-669DDED6DA25","أَقفَرَ مِن أَهلِهِ مَلْحوبُ","فالقُطبيَّات فالذَّنوبُ"],["2B5A5775-05AD-5372-8032-265F3BCCBE67","فَراكِسٌ فثُعَيلٍباتٌ","فَذاتَ فَرقَينِ فالقَلِيبُ"],["B980B32A-DEDF-5E58-A6B1-66F0664A5E73","فَعَرْدةٌ، فَقَفا حِبِرٍّ","لَيسَ بِها مِنهُمُ عَريبُ"],["F6FE4A13-F2D2-53BD-A9FD-37CBE663B659","إن بُدِّلَتْ أهْلِها وُحوشًا","وغًيَّرتْ حالَها الخُطُوبُ"],["90AA2897-1C46-535D-B00F-EAFE9173E08E","أرضٌ تَوارَثَها الجُدوبُ","فَكُلُّ من حَلَّها مَحْروبُ"],["3E0DA58D-E6C2-58F6-9E90-4FDCD983A72E","إمَّا قَتيلاً وإمَّا هَلْكًا","والشَّيْبُ شَيْنٌ لِمَنْ يَشِيبُ"],["B445D52B-0D33-5ECC-B36B-77A426B1C269","عَيناكَ دَمْعُهما سَروبٌ","كأنَّ شَأنَيهِما شَعِيبُ"],["7796C34E-FEA6-5457-B50B-F1BCE9CD7B41","واهِيةٌ أو مَعينُ مَمعْنٍ","مِنْ هَضْبةٍ دونَها لَهوبُ"],["3D819C0B-131C-56A1-BB7C-975763169979","أو فَلْجُ وادٍ بِبَطْنِ وادٍ","لِلماءِ مِنْ تَحتِها سَكوبُ"],["6759BFEA-FCEB-596E-B79E-E34CBCA1FB11","أوْ جَدولٌ في ظِلالِ نَخْلٍ","لِلماءِ مِنْ تَحْتِها قَسيبُ"],["C6396ADA-C7D7-5D5E-8A87-6DBB51E27BCA","تَصْبو وأنَّى لكَ التَّصابي؟","أنَّي وقَد راعَكَ المَشيبُ؟"],["C0BB29EB-411B-5C33-8992-8050064B92E2","فإنْ يَكُنْ حالَ أجْمَعِها","فلا بَدِيٌّء ولا عَجيبُ"],["93B16164-D422-5B13-8AFA-44CF90CBF887","أوْ يكُ أقْفَرَ مِنها جَوُّها","وعادَها المَحْلُ والجُدوبُ"],["DD7FE64A-3031-50B0-A1E1-62A619FEF194","وكُلُّ ذي نِعْمةٍ مَخلوسٌ","وكُلُّ ذي أمَلٍ مَكذوبُ"],["405BAF87-A85B-5E8F-9AB7-E404C3345BD5","وكُلُّ ذي إبِلٍ مَوْروثٌ","وكُلُّ ذي سَلْبٍ مَسْلوبُ"],["314B3E83-2361-54C2-8EAA-F77BD7B922C8","وكُلُّ ذي غَيْبةٍ يَؤوبُ","وغائِبُ المَوْتِ لا يَؤوبُ"],["90628CA8-87D5-580B-939D-BFCE56315FBB","أعاقِرٌ مِثْلُ ذاتِ رَحْمٍ؟","أم غانِمٌ مِثْلُ مَنْ يَخيبُ؟"],["06A31756-1A6F-5F8D-AB3E-9B336413E2E5","مَنْ يَسْألِ النَّاسَ يَحْرِمُوهُ","وسائِلُ اللهِ لا يَخيبُ"],["FBE739FA-A78D-59F1-86D0-FE7383F067C4","أفْلِحْ بِما شِئْتَ قدْ يَبلُغُ بال","ضَّعْفِ وقَدْ يُخْدَعُ الأرِيبُ"],["AF8D16A0-F8F8-52BB-8F8C-F7E9D74D5297","لا يَعِظُ النَّاسُ مَنْ لا يَعِظُ الدْ","دَهْرُ ولا يَنْفَعُ التَّلْبِيبُ"],["57D7B657-9786-56C7-8357-9347B8BBA42D","إلاَّ سَجِيَّاتُ ما القُلُوبُ","وكم يُصَيِّرْنَ شانئاً حَبِيبُ"],["32A131D4-A92E-5591-B558-16A0D29521F0","ساعِدْ بِأرضٍ إنْ كُنتَ فيها","ولا تَقُلْ إنَّني غَريبُ"],["274E50D4-4EA5-50FF-A741-49C578B813B9","قدْ يُوصَلُ النَّازِحُ النَّائي وقد","يُقْطَعُ ذو السُّهْمَةِ القَريبُ"],["7C028890-2CF0-5E88-A286-1A50013474E3","والمَرْءُ ما عاشَ في تَكْذيبٍ","طُولُ الحَياةِ لهُ تَعْذيبُ"],["AEDF3594-6F3D-5062-984D-846523DEC613","بل رُبَّ ماءٍ وَرَدتُّ آجِنٍ","سَبيلُهُ خائفٌ جَدِيبُ"],["8E033432-C5BE-5FA5-BB6E-6FFC2E3AFCA0","رِيشُ الحَمامِ على أرْجائِهِ","لِلقَلبِ مِنْ خَوْفِهِ وَجِيبُ"],["4D2AC7B6-2204-5B4F-A417-10A684858BAB","قَطَعتهُ غُدْوة مُشِيحاً","وصاحِبي بادِنٌ خَبوبُ"],["579A4A28-1621-5D3D-9D48-C3768CEAAB42","غَيْرانةٌ مُوجَدٌ فَقارُها","كأنَّ حارِكَها كَثِيبُ"],["0B75B927-22C7-5D1B-838A-4C1E5D31CA5D","أَخلَفَ ما باذلاً سَديسُها","لا حِقَّةٌ هِيَ ولا نَيُوبُ"],["041C43B0-4474-5AD4-A98B-29F3529A2F8E","كَأنَّها مِن حَميرِ غابٍ","جَوْنٌ بِصَفْحَتِهِ نُدوبُ"],["2AED4E8B-3BD1-5DD5-9308-7E9FBB24A6E4","أَو شَبَبٌ يَحفِرُ الرُخامى","تَلُفُّهُ شَمألٌ هُبوبُ"],["2B4AB80C-0B05-5A93-B79D-FF746C7A091D","فذاكَ عَصْرٌ، وقدْ أراني","تَحمِلُني نَهدَةٌ سُرحوبُ"],["3B3E92BC-84C3-55F0-AAFA-5DB6611E931D","مُضَبَّرٌ خَلقُها تَضبيراً","يَنْشَقُّ عَنْ وَجْهِها السَّبيبُ"],["374798A9-4574-58A2-922D-025D983EBAEE","زَيتِيَّةٌ ناعِمٌ عُروقُها","وَلَيِّنٌ أَسرُها رَطيبُ"],["503F1883-E006-52C3-B976-31FD686039FE","كَأَنَّها لِقوةٌ طَلوبُ","تُخزَنُ في وَكرِها القُلوبُ"],["C0EFCDA7-0C6A-5B66-974B-390147D069AF","بانَت عَلى إِرَمٍ عَذوباً","كَأَنَّها شَيخَةٌ رَقوبُ"],["BF353A6C-7031-5221-ABB8-BDEE25BCB9BC","فَأَصبَحَت في غَداةِ قِرَّةٍ","يَسْقُطُ عَنْ رِيشِها الضَّريبُ"],["DC4824D2-91E0-544A-BCF0-F8BB1985A236","فَأَبصَرَت ثَعلَباً مِن ساعَةٍ","وَدونَهُ سَبسَبٌ جَديبُ"],["A4DB9C18-C034-57FA-AA43-140232145A7D","فَنَفَضَت ريشَها وَاِنتَفَضَت","وَهيَ مِن نَهضَةٍ قَريبُ"],["A343F72F-916C-51CC-87F3-068B5DB53E79","فَاِشتالَ وَاِرتاعَ مِن حَسيسِها","وَفِعلَهُ يَفعَلُ المَذؤوبُ"],["B89C624E-C8CC-564F-AC9C-1A94D88E68D5","فَنَهَضَت نَحوَهُ حَثيثَةً","وَحَرَدَت حَردَةً تَسيبُ"],["49563DA4-24A0-5CC5-BB31-BACD21641DE2","يَدِبُّ مِن حِسِّها دَبيباً","وَالعَينُ حِملاقُها مَقلوبُ"],["BFC45CA6-74FE-511C-819E-BB5B507C6C4A","فَأَدرَكَتهُ فَطَرَّحَتهُ","والصَّيْدُ مِنْ تَحْتِها مَكْروبُ"],["7417360A-49D4-54F3-8B29-D7BA5DEA6F13","فَجَدَّلَتهُ فَطَرَّحَتهُ","فكَدَّحَتْ وَجْهَهُ الجَبوبُ"],["4BAE7768-C46A-57EB-A803-FA3635757E5B","فعاوَدَتْهُ فَرَفَّعَتْهُ","فأرْسَلَتْهُ وهُوَ مَكْروبُ"],["9F6A4519-A1FB-55C1-9465-EC783D1D48A2","يَضغو وَمِخلَبُها في دَفِّهِ","لا بُدَّ حَيْزومُهُ مَنقُوبُ"]]}}}