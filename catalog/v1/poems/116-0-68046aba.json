{"v":1,"poems":{"52237E5C-BA19-56FF-BFF7-90AD7BA5E41F":{"t":"أحنّ بأطراف النهار صبابةً","p":116,"s":"أحن بأطراف النهار صبابة","r":"473938","v":[["8457EFEC-27B6-58B9-B710-ED3D13B7F940","أحنّ بأطراف النهار صبابةً","وبالليل يدعوني الهوى فأجيبُ"],["4068D1F7-B06C-5080-ADE8-7F0B38392A6F","وأيامُنا تفنى وشوقي زائد","كأنّ زمان الشوق ليس يغيب"]]},"32298F8E-720D-51FB-B197-D4C1BFBC80AD":{"t":"أفديكَ بل قلّ أن يفديك ذو دنفٍ","p":116,"s":"أفديك بل قل أن يفديك ذو دنف","r":"473947","v":[["825D4A5F-B705-5B1C-B6E8-12F575D8614B","أفديكَ بل قلّ أن يفديك ذو دنفٍ","هل في المذلّة للمشتاق من عار"],["5239D438-55FD-570F-88A2-31BDB7DBFF7B","بي منك شوقٌ لو أن الصخر يحمله","تفطّر الصخر عن مستوقد النار"],["9077DD74-4349-576A-A981-7C58E2EED5DE","قد دبّ حبّك في الأعضاء من جسدي","دبيب لفظى من روحي وإضماري"],["CE7E532C-05B2-5F37-8E3B-104D60EEA5E9","ولا تنفّست إلا كنت مع نفسي","وكل جارحة من خاطري جاري"]]},"AC9848D2-4321-5998-BECE-ADB849EC231F":{"t":"أمسى بخدي للدموع رسوم","p":116,"s":"أمسى بخدي للدموع رسوم","r":"473965","v":[["489EE39C-CEC6-5328-9695-690C1D4EF31E","أمسى بخدي للدموع رسوم","أسفا عليك وفي الفؤاد كلوم"],["1EFB9803-3442-5F08-9078-16152E416CD9","والصبر يحسن في المواطن كلها","إلا عليك فإنه مذموم"]]},"233F71C4-987A-5948-843D-F52219011125":{"t":"أنا راض بطول صدك عني","p":116,"s":"أنا راض بطول صدك عني","r":"473962","v":[["2D865C38-0D8E-54BF-8628-C5D4178FEEAD","أنا راض بطول صدك عني","ليس إلا لأن ذاك هواكا"],["6E8E4D23-55EB-55A0-A5E6-2B7125FD761F","فامتحن بالجفا صبري على","الود ودعني معلقا برجاكا"]]},"DD6ABA64-B689-5B5D-B202-2BBDD9DF54C3":{"t":"أنت الحبيب الذي لاشك في خلد","p":116,"s":"أنت الحبيب الذي لاشك في خلد","r":"473951","v":[["58B4567F-3CF3-5320-B328-E553ED74A461","أنت الحبيب الذي لاشك في خلد","منه فإن فقدتك النفس لم تعش"],["1D3510C3-630F-5D3F-9321-D5275A80EDCD","يا معطشى بوصال أنت واهبه","هل فيك لي راحة إن صحت واعطشى"]]},"66D13F18-6CF1-5EAD-8E9A-6936EEF6E6CE":{"t":"بكيتُ ودمع العين للنفس راحة","p":116,"s":"بكيت ودمع العين للنفس راحة","r":"473934","v":[["3AD3ECB3-C27A-5F6C-95ED-D84CAEC4D08C","بكيتُ ودمع العين للنفس راحة","ولكن دمع الشوق ينكى به القلبُ"],["45E1A48B-CF49-558D-B46A-C28A82420458","وذكرى لما ألقاه ليس بنافعي","ولكنه شيء يهيج به الكرب"],["BA6636BA-B5EE-53B0-8288-51DF0C5289DE","فلو قيل لي من أنت قلت معذب","بنار مواجيد يضرمها العتب"],["1123D036-8998-5EA5-80F8-27A5EF0B338C","بليت بمن لا أستطيع عتابه","ويعتبنى حتى يُقال لي الذنب"]]},"7694A7F0-20C1-5B33-ADC1-C251DC179E68":{"t":"تجرّعت من حاليه نعمى وأبؤسا","p":116,"s":"تجرعت من حاليه نعمى وأبؤسا","r":"473949","v":[["02AB6D19-9811-5B43-AFBD-FD56BBCB3CBE","تجرّعت من حاليه نعمى وأبؤسا","زمان إذا أمضى عزاليه أُحتسى"],["D7C198C9-1266-5551-AD4B-D68950B8EC8E","فكم غمرة قد جرعتني كؤوسها","فجرعتها من بحر صبري أكؤسا"],["28ED7D94-19FE-5543-901E-5C420F7FE210","تدرعت صبري والتحفت صروفه","وقلت لنفسي الصبر أو فاهلكي أسى"],["3F2E8E86-6874-5F68-B91F-2E76FA167634","خطوب لو أن الشم زاحمن خطبها","لساخت ولم تدرك لها الكف ملمسا"]]},"1E1C4219-30FC-51A2-A686-4D4D99DF3862":{"t":"تركت الفؤادَ عليلاً يعاد","p":116,"s":"تركت الفؤاد عليلا يعاد","r":"473944","v":[["E45EC467-244E-543C-86B3-2E4BC2E03D67","تركت الفؤادَ عليلاً يعاد","وشرّدتُ نومى فمالي رقادُ"]]},"74F3687B-8116-55E6-84CE-130C641A0957":{"t":"شغلت قلبي عن الدنيا ولذتها","p":116,"s":"شغلت قلبي عن الدنيا ولذتها","r":"473960","v":[["43CD6B56-74E8-5984-B2E5-A73F82F3D86E","شغلت قلبي عن الدنيا ولذتها","فأنت والقلب شيء غير مفترق"],["14BD1C7C-DAC3-5B46-942A-339E2E8FC597","وما تطابقت الأحداق من سنة","إلا وجدتك بين الجفن والحدق"]]},"0C97AC26-704C-50D2-A69E-15D8C238FCF4":{"t":"ضاعف علي بجهدك البلوى","p":116,"s":"ضاعف علي بجهدك البلوى","r":"473969","v":[["3E714942-1486-5FF1-B035-AE44680EF7B6","ضاعف علي بجهدك البلوى","وابلغ بجهدك غاية الشكوى"],["6F3CA60A-2A3A-58C3-877E-7CE40C02836F","واجهد وبالغ في مهاجرتي","واجهر بها في السر والنجوى"],["078A6DE3-03D1-56BC-B9D6-C08392F1C40E","فإذا بلغت الجهد في قلم","تترك لنفسك غاية قصوى"],["5573D557-360E-51CB-867A-E4C390F5C0AF","فانظر فهل حال بي انتقلت","عما تحب بحالة أخرى"]]},"CC5084DE-78E1-5947-8B09-9E1FCE8551E4":{"t":"كان لي قلبٌ أعيش به","p":116,"s":"كان لي قلب أعيش به","r":"473936","v":[["778F56E1-6FB1-576B-9591-59D8BFD6B2DD","كان لي قلبٌ أعيش به","ضاع منّي في تقلبِه"],["8A38151C-5C2C-5A43-8E92-B58CD57F66D5","رب فاردده عليّ فقد","ضاق صدري في تطلبه"],["FD390874-D3EE-576D-880E-0FCBBB368848","وأغث ما دام بي رمقٌ","يا غياثَ المستغيثِ به"]]},"A9B85631-7E76-5EDA-A6D9-E2628FC9C8EF":{"t":"هَبهنى وجدتُكَ بالعلوم وَوجدِها","p":116,"s":"هبهنى وجدتك بالعلوم ووجدها","r":"473948","v":[["D47A48F9-7241-5C9F-92DF-64ECE32ECB10","هَبهنى وجدتُكَ بالعلوم وَوجدِها","مَن ذا بَجِدكَ وجودٍ يظهرُ"]]},"79C82092-D11D-5778-839A-4C5C9EC380F1":{"t":"وكان قلبي خالياً قبل حبكم","p":116,"s":"وكان قلبي خاليا قبل حبكم","r":"473940","v":[["EB67026A-9FA7-58CE-BFA1-53A3A33A0116","وكان قلبي خالياً قبل حبكم","وكان بذكر الخلق يلهو ويمزحُ"],["162529B4-5F09-56E6-84A5-562E2DB7A2A7","فلما دعا قلبي هواك أجابه","فلستُ أراه عن فنانك يبرحُ"],["D423242A-877C-519E-A6DB-1CCDE812E0BC","رُميت ببين منك إن كنت كاذباً","إذا كنت في الدنيا بغيرك أفرح"],["04AEEB04-C6F3-57A2-98CC-5486E9FC3A96","وإن كان شيءٌ في البلاد بأسرها","إذا غبت عن عيني بعيني يلمحُ"],["029EFCF4-CF37-5881-B703-F7829EA83E27","فإن شئت واصلني وإن شئت لا تصل","فلستُ أرى قلبي لغيرك يصلحُ"]]},"567C0E0A-1092-5A6A-9151-A0E00476C6EB":{"t":"ولا خير في شكوى إلى غير مشتكى","p":116,"s":"ولا خير في شكوى إلى غير مشتكى","r":"473946","v":[["3600162C-4EA5-5F80-BAF6-1B2678DB2505","ولا خير في شكوى إلى غير مشتكى","ولابد من سلوى إذا لم يكن صبرُ"]]},"82151F3F-C21D-554B-979B-E50A7E769B61":{"t":"ولو قيل طأ في النار أعلم أنّه","p":116,"s":"ولو قيل طأ في النار أعلم أنه","r":"473964","v":[["46132567-00AD-5343-B7A5-4E97F22826B6","ولو قيل طأ في النار أعلم أنّه","رضىً لك أو مدن لنا من وصالكا"],["7CE11EDA-A045-5E7E-8289-9956435EF97F","لقدّمتُ رجلي نحوها فوطئتُها","سروراً لأني قد خطرتُ ببالكا"]]},"11E5B219-DAF2-55DB-B9BE-860C96FD0E82":{"t":"وليس لي في سواك حظ","p":116,"s":"وليس لي في سواك حظ","r":"473968","v":[["99242B53-8D5F-5E21-806B-DEFADE9B637D","وليس لي في سواك حظ","فكيفما شئت فامتحنّي"],["FE025474-2950-527D-9D18-0BDDB8B501E0","إن كان يرجو سواك قلبي","لا نلتُ سؤلي ولا التمني"]]},"0A138374-8DF0-582B-8682-5A2CA29C1AD4":{"t":"يعاتبني فينبسط انقباضي","p":116,"s":"يعاتبني فينبسط انقباضي","r":"473933","v":[["E383E12F-C954-5CAA-B563-AC7ECBC48DC7","يعاتبني فينبسط انقباضي","وتسكن روعتي عند العتاب"],["E4ED76B1-E076-5DD4-B04B-136D3864019D","جرى في الهوى مذ كنت طفلا","فمالي قد كبرت على التصابي"]]}}}