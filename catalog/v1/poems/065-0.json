{"v":1,"poems":{"71EF8E48-BD6C-51F6-A265-FCD6240A24ED":{"t":"أحجاج إن الله أعطاك غاية","p":65,"s":"أحجاج إن الله أعطاك غاية","r":"441025","v":[["A6A4F1F1-FBDB-55A7-9F3B-AB16EA9ED955","أحجاج إن الله أعطاك غاية","يُقصّر عَنْها مَن أَرَادَ مَداهَا"],["3FC36151-117C-5B82-86C9-6370589FEC7A","أحجاج لا يفلل سلاحك إنما ال","منايا بكف الله حيث تراهَا"],["8C88CA4B-93D9-5E46-9AC8-DDE7A8C76E14","إذا هَبَطَ الحَجَّاجُ أرْضاً مَريضَةً","تَتبعَ أقصَى دائها فَشفَاهَا"],["90FFBEE9-54D0-576B-BA31-1A7054CA83BB","شَفَاها من الدّاءِ العُضالِ الّذي بِها","غلام إذا هز القناة سقاهَا"],["A756A58A-385A-539D-89AA-41AE95721D00","سَقَاها دمَاءَ المارقينَ وعَلّها","غذا جمحت يوماً وخيف أذاهَا"],["CD00B421-CEE8-5D17-BB91-98128ADD3AD1","إذا سمع الحجاج رز كتيبة","أعد لها قبل النزول قراهَا"],["3D99146A-ECBE-5C99-90F9-E05EF044CD76","أعد لها مصقولة فارسية","بأيدي رِجالٍ يحلبُون صراهَا"],["E8434D68-26DE-52B9-8EE9-F4C6CF8FF11F","فما ولد الأبكار والعون مثله","بنجدٍ ولا أرضٍ يجف تراهَا"],["60A1D1A7-213F-5F5A-93ED-AB3B6B9B56D3","أحجاج لا تعط العصاة مناهم","ولا اللُّه يُعطي لِلْعُصَاةِ مُناهَا"],["41874058-83A0-5089-8080-86124075C5E8","ولا كل حلاف تقلد بيعة","فأعظمَ عهدَ اللّه ثُمّ شَراهَا"]]},"4912352D-6598-5054-92D5-35B2F4A21623":{"t":"أقسمت أرثي بعد توبة هالكاً","p":65,"s":"أقسمت أرثي بعد توبة هالكا","r":"440996","v":[["885EF317-0777-5521-A758-10909CB49A99","أقسمت أرثي بعد توبة هالكاً","وأحفل من دارت عليه الدوائرُ"],["FC9BEA40-B5DA-5514-A0E2-4C8EDE22B3C2","لَعَمْرُكَ مَابِالمَوْتِ عارٌ عَلَى الفَتَى","إذا لم تصبه في الحياة المعايرُ"],["7BA434E3-75FD-50B7-90ED-86473327861D","وَمَا أَحَدٌ حَيٌّ وإِن عاشَ سالِما","بأخلد ممن غيبته المقابرُ"],["164C49E8-0B26-5682-A4A7-C206AB22B8BC","ومَنْ كانَ مِّما يُحدِثُ الدَّهْرُ جَازعا","فلا بُدَّ يَوْمَاً أن يُرى وهو صابرُ"],["23D3C348-2B91-54E0-8ACC-37BB7372DFFA","وليس لذي عيش عن الموت مقصر","وليس على الأيام والدهر غابرُ"],["A07874F7-F29E-505C-9BF4-3D1F8D3E3751","ولا الحَيُّ مِمّا يُحدِثُ الدَّهْر مُعتَبٌ","وَلا المَيْتُ إِنْ لَمْ يَصْبِرِ الحيُّ ناشِرُ"],["3EFA0C29-8279-5392-92EA-A6A5D55AFAA6","وكل شباب أو جديد غلى بلى","وكل امرىء يوماً إلى الله صائرُ"],["E0DF82B4-8268-5B83-A01B-084FC41B182C","وكل قريني إلفة لتفرق","شتاتاً وإن ضنا وطال التعاشرُ"],["D765AB14-D912-5AAF-B701-D633B959B173","ولكنَّما أَخْثَى عَلَيْه قَبِيلةٍ","أخا الحرب إن دارت عليك الدوائرُ"],["8A2B376A-6EA9-5E7A-82B3-F2717593CEDF","فَآليْتُ لا أَنْفَكُّ أَبْكِيكَ ما دَعَتْ","على فنن ورقاء أو طار طائرث"],["7C0608FB-78B0-5D29-96F7-B90550C51495","لَهَا بِدُروبِ الرّومِ بَادٍ وحَاضِرُ",""]]},"8C0D14D5-C702-5907-AFF4-4536AD8D6115":{"t":"ألا كُلُّ ماقالَ الرُوَاةُ وأنْشدُوا","p":65,"s":"ألا كل ماقال الرواة وأنشدوا","r":"440991","v":[["BC88AA97-A468-5540-BD5C-BA05A61582BB","ألا كُلُّ ماقالَ الرُوَاةُ وأنْشدُوا","بها غير ماقالَ السّلوليّ بهْرَجُ"]]},"2C1F32B8-2DC2-5388-B6BA-790AA23F1F5A":{"t":"أنابغ لم تنبغ ولم تك أولا","p":65,"s":"أنابغ لم تنبغ ولم تك أولا","r":"441013","v":[["5CF38E02-816E-5D37-9DC0-65E07330E9D2","أنابغ لم تنبغ ولم تك أولا","وكنت صنياً بين صدين مجهلاَ"],["D54B5457-5D8F-573D-B21D-418BE173D938","أنابغ إن تنبغ بلؤمك لا تجد","لِلُؤمك إلاوَسَسْطَ جَعْدَةَ مَجْعَلا"],["9824783B-5913-5058-B455-5112DD0B31B2","أعيرتني داء بأمك مثله","وأي جواد لا يقال له: هلا"],["C62B65B0-ABE8-536B-9650-BCCB6F6B059F","وما كنت وقاذفت جل عشيرتي","لأذكرَ قَعْبي حَارزٍ قد تثمّلا"]]},"9793EDDD-2D32-5094-BBD0-7CFFCF4237FB":{"t":"أنيخت لدى باب ابن مروان ناقتي","p":65,"s":"أنيخت لدى باب ابن مروان ناقتي","r":"441007","v":[["6EDB0E84-A4C6-5741-BFFD-D6D5775B8A2F","أنيخت لدى باب ابن مروان ناقتي","ثلاثاً لها عند النتاج صريفُ"],["241D58B6-D3F1-5EAD-9BA0-08EC694EE2E0","يُطيفُ بِهَا فِتْيَانَه كُلَّ لَيْلَةٍ","بِنيرَيْنِ مِئْرانِ الجِبالُ وريفُ"],["524884AB-4F3D-5B21-94FD-601E7A851099","غلام تلقى سؤددا وهو ناشىء","فآتت به رحب الذراع أليفُ"],["7BFA5562-2FC7-5106-9182-528436F130AC","بقيل كتَحْبير اليَمَاني ونَائِلٍ","إذا قلبت دون العطاء كفوفُ"],["A91B8727-902F-5C04-B7D1-CF81CBD12FCA","ورحنا كأنا نمتطي اخدرية","حليٌّ بجَنْبى ثادق وجَفيفُ"],["C3E9A440-925A-5FBF-AD7E-862B1E34807F","أرن عليها قارباً وانتحت له","مبرة ارساغ اليدين زروفُ"],["7361F573-5ADA-502C-81F4-30ACB0398BAF","تُهادي خجوجا خَدّدَ الجَرْيُ لَحْمَهُ","فلا جحشها بالصيف فهي خروفُ"]]},"608A090A-2507-5035-B3DB-35221300BCEF":{"t":"أياعين بكي توبة ابن حمير","p":65,"s":"أياعين بكي توبة ابن حمير","r":"440994","v":[["F6BDD9CC-7E7A-5257-BF0D-105EB91058CF","أياعين بكي توبة ابن حمير","بسح كفيض الجدول المتفجرِ"],["3261709B-8F0B-5F7B-9FA3-28043A2F6CCF","لتبك عليه من خفاجة نسوة","بمَاء شؤونِ العَبْرة المُتَحَدِّرِ"],["19A577C5-1A7E-56E0-A44D-0FCF44ECB15D","سَمِعْنَ بَهْيجَا أرهقَتْ فذكَرْنَه","ولا يَبْعَثُ الأحزانَ مِثلُ التَّذَكُّرِ"],["54222189-848E-5EC1-BEEA-FBB8D021EAD9","كأن فتى الفتيان توبة لم يسر","بنَجْدٍ ولم يَطْلُعْ مع المُتَغوِّرِ"],["3428D2A0-F1E4-5E2B-9B2F-6C6FA0923DFC","ولم يَرِدِ المَاء السِّدامَ إذا بَدَا","سنا الصبح في بادي الحواشي منورِ"],["1352FD42-84F8-5C78-9C26-7A9EE8A57F27","ولم يَغْلِبِ الخَصْمَ الضِّجاجَ ويَمْلأال","جفان سديفاً يوم نكباء صرصرِ"],["E84D128F-9069-5CBD-97FF-0DBED188BDA6","ولم يَعْلُ بالجُرْدِ الجِيادِ يَقُودُها","بسرة بين الأشمسات فايصرِ"],["65E07F20-DC84-54DC-8408-EFBCFDD3A902","وصَحْراءَ مَوْماةٍ يَحارُ بها القَطَا","قطعت على هول الجنان بمنسرِ"],["0CCF5B95-D8DB-5448-9701-8366A0F7D870","يقودون قبا كالسراحين لاحها","سُرَاهُمْ وسَيْرُ الراكبِ المُتَهَجِّرِ"],["C2E54D9F-0128-5FC6-8F05-A5EBE67A27BE","فلما بدت أرض العدو سقيتها","مجاج بقيات المزاد المقيرِ"],["3B3ADE68-628A-5020-A79A-AC534844A57F","ولما أهابوا بالنهاب حويتها","بخاظِى البَضيعِ كَرُّه غيرُ أعْسَرِ"],["656B8BE9-4DDC-5115-B7E3-3DB0DEE6E70D","ممر ككر الأندري مثابر","إذا ما وَنَيْنَ مُهْلِبِ الشَّد مُحْضِرِ"],["6C41EB8C-9902-5C57-B798-55C9DA6DDDDC","فألوت باعناق طوار وراعها","صلاصل بيض سابغ وسنورِ"],["8B2DC5E2-6492-5A71-9F7F-32B09076A77D","ألم تر أن العبد يقتل ربه","فيظهر جد العبد من غير مظهرِ"],["4980535E-BCED-529D-91D2-EB61586F4BFD","قَتَلْتُمْ فتى لا يُسْقِطُ الرَّوع رُمْحَه","إذا الخيلُ جالَتْ في قَناً متكسِّرِ"],["5E516C61-5922-5C10-B1C2-194DD8673F1D","فيا توب للهيجا وياتوب للندى","ويا توب للمستنبح المتنورِ"],["C2DD27D3-2DB9-53EC-8841-3C0BBD1EEED1","ألا رب مكروب أجبت ونائل","بذلت ومعروف لديك ومنكرِ"]]},"D38F92E1-1A16-5FFC-8CB1-9072A4BD5CD8":{"t":"أَبَعْدَ عُثْمانَ تَرْجُو الخَيْرَ أُمَّتُهُ","p":65,"s":"أبعد عثمان ترجو الخير أمته","r":"441009","v":[["3C6B70E3-9D35-5872-94D4-7C4436E43F40","أَبَعْدَ عُثْمانَ تَرْجُو الخَيْرَ أُمَّتُهُ","وكان آمن من يمشي على ساقِ"],["DA6E667D-2D24-5E26-AFBF-6EA04D0E749D","خَليفَةُ اللِه أعْطاهُم وخَوَّلَهُم","ماكانَ من ذَهَب جَمَّ وَأورَاقِ"],["920BC93F-CAB2-5952-A197-0CF52A1D53E0","فلا تَكْذِبْ بِوَعْدِ اللِه وارْضَ به","قد قدر الله ما كل امرىء لاقِ"]]},"833F041E-F538-5F46-BBAC-48310DA290E4":{"t":"أَتاني مِنَ الأَنْباءِ أَنّ عَشِيرةً","p":65,"s":"أتاني من الأنباء أن عشيرة","r":"441012","v":[["3A0B41C3-1A29-5DC7-B766-D1BD69927A79","أَتاني مِنَ الأَنْباءِ أَنّ عَشِيرةً","بشوران يزجون المطي المنعلاَ"],["16A043B1-19B3-5907-8260-45855D0BABE8","يروح ويغدو وفدهم بصحيفة","لِيَسْتَجْلِدُوا لِي، سَاءَ ذلك مَعْمَلاَ"],["CBC576BA-7B80-53BD-BF2D-36BF7A4A80EF","على غير جرم غير أن قلت: عنهم","يعيش أبوهم في ذراه مغفلاَ"],["5A8B9F4E-3597-5613-983D-24ABFD41CDBD","وأعمى أتاه باحجاز نثاهم","وكان بأطراف الجبال فأسهلاَ"],["F8158468-1FBB-51EA-AF21-89FAA3F742A3","فجَاءَبهِ أصْحابُهُ يَحْمِلُونَهُ","غلى خير حي آخرين وأولاَ"],["4698C7D4-6A01-5AA7-899F-39DD91A5F197","إذا صَدَرَتْ ورّادهُم عن حِياضِهِم","تغادر نهباً للزكاة معقلاَ"],["B9E8382C-44AA-5BBC-9214-BB5A76E4389C","تنافر سواراً إلى المجد والعلى","وأقسم حقاً غن فعلت ليفعلاَ"],["5CFAFBF5-9618-5605-BE1D-7758C97F4E66","بمجد إذا المرء اللئيم أراده","هوى دونه في مثبل ثم عضلاَ"],["610E6AE0-9C07-5BC8-96F6-95C7DE87F64A","وهل أنْت إنْ كانَ الهِجَاءُ مُحَرَّما","وفي غيره فضل لمن كان فصلاَ"],["56530D85-600A-507A-A2A2-A6E56FDE2445","لنا تامك دون السماء وأصله","مقيم طوال الدهر لن يتحلحلاَ"],["B6B6A464-BB52-56FC-9CEE-6E6B83B6E6C5","وماكانَ مَجْدٌ في أُناسٍ عَلِمْتُهُ","من الناس غلا مجدنا كان أولاَ"]]},"9D09DBC8-4A2B-5454-80FE-B0FE9BF7BDD2":{"t":"أُريقَت جفانُ ابنِ الخَليع فأصبحَتْ","p":65,"s":"أريقت جفان ابن الخليع فأصبحت","r":"440987","v":[["07E0112C-7EB0-5838-9890-1AB4C9E9DF2F","أُريقَت جفانُ ابنِ الخَليع فأصبحَتْ","حياض الندى زالت بهن المراتبُ"],["73A9393E-A53B-55E4-BEEC-6E97EFA0E93E","فعفاته لهفى يطوفون حوله","كما انقضَّ عرشُ البئرِ، والوِردُ عاصِبُ"]]},"A01F9D38-064B-5CED-A685-5DEF79C71833":{"t":"إن كنت تبغي أبا بكر فإنهم","p":65,"s":"إن كنت تبغي أبا بكر فإنهم","r":"440997","v":[["1A368ADD-81D8-5E0D-BC06-39ADDD78DCBE","إن كنت تبغي أبا بكر فإنهم","بكل ساحة قوم منهم أثرُ"],["5033F473-47DE-5589-B38F-1AF02F8E9911","نعمى وبؤسى بآفاق البلاد فما","أَعْداؤُهُمْ مِنْهُم، ولا قَدَرُوا"],["7362276C-9736-571E-AA0C-8C9726BE30AC","والعالمون إذا ما الأمر ضاقهم","أنّى يُحَاولُ فيه الوِردُ والصَدَرُ"],["4F2C3021-6D1A-55C7-9263-8F609E98A77B","وَکختَرْتُ آلَ أبي بَكْرٍ لِحَاجَتِنا","وكان فيهم لمن يختارهم خيرُ"],["A09CA1DF-1F98-5359-8A80-654FFAAE0744","وَما اتهَمْتُ بَني جزءٍ بِظنّتِهِ","وما أساءوا وما ضاع الذي خطروا"]]},"44282B28-BA6C-5450-8F13-7A71F7D0B2E4":{"t":"بعيدُ الثَّرَى لا يَبْلُغُ القَوْمُ قَعْرَهُ","p":65,"s":"بعيد الثرى لا يبلغ القوم قعره","r":"441015","v":[["865AEE8E-5D4D-555A-95EF-8E2CED1DE0A4","بعيدُ الثَّرَى لا يَبْلُغُ القَوْمُ قَعْرَهُ","الد ملد يغلب الحق باطلهُ"],["6755A242-C276-555F-B1D7-BD4A3DE33695","غذا حل ركب في ذراه وظله","ليمنعهم مما تخاف نوازلهُ"],["CF396A2E-31A0-526A-B282-E7968AAB32EF","حماهم بنصل السيف من كل فادح","يخافونه حتى تموت خصائلهُ"],["58151953-4201-5236-AE19-7DDBF73BCFA0","معاذ غلهي كان والله سيداً","جواداً على العلات جمأ نوافلهُ"],["703099C9-86FD-5152-BFEC-63234674F07C","أغر خفاجياً يرى البخل سبة","تَحَلَّبُ كَفَّاه النَّدى وأنامِلُه"],["41935DE0-FCE1-59F6-A378-024911EA7323","عفيفاً بعيد الهم صلباً قناته","جميلاً محياه قليلاً غوائلهُ"],["386CDFF2-A57F-5F5D-B159-4B21F4EAEE70","وكان إذا ما الضيف أرغى بعيره","لَدَيْه أتاهُ نَيلُه وفواضلُهْ"],["61D48AFF-DE77-57D4-832F-273532F5D4A5","وقدعلمَ الجُوعُ الذي بات سَارياً","على الضّيفِ والجيرانِ أنك قاتِلُهْ"],["5716BCE1-EC25-593C-9098-1AA3A0077899","وانك رحب الباع ياتوب بالقرى","إذا مالئيمُ القَوْمِ ضاقتْ مَنَازِلُهْ"],["E33924EE-9439-50A7-9F46-82757FFEB389","يبيت قرير العين من بات جاره","ويُضْحي بِخَيْر ضيفُه ومنازِلُهْ"],["2C20F6E2-3CF7-5F01-90B4-650C9D4ECA11","أَتَتْه المَنايا حينَ تمَّ تَمَامُه","وأقصَرع عنْهُ كلُّ قِرْنٍ يُطاوِلُه"],["9C2C9399-EA17-51A3-A1E2-0DDF4A2EA1A1","وكانَ كليثِ الغَاب يَحْمِي عَرينَه","وتَرْضَى بهِ أشْبالُهُ وحَلائِلُهْ"],["E9C9233D-DA0D-5669-A21C-DD26FDAE454C","غضوب حليم حين يطلب حلمه","وسِمٌّ زُعَافٌ لا تُصابُ مَقَاتِلُهْ"]]},"75E77234-EAA1-5D08-8D7E-9ADC4E1F2730":{"t":"تحوط العشيرة أفعاله","p":65,"s":"تحوط العشيرة أفعاله","r":"441026","v":[["098E9370-E050-580E-927B-BD719E4D8E25","تحوط العشيرة أفعاله","وتحمل عنه الذي آدها"]]},"2044DF1D-3786-5701-9F5E-6FD5D5153F9C":{"t":"تَخَلّى عَنْ أَبي حَرْبٍ فَوَلّى","p":65,"s":"تخلى عن أبي حرب فولى","r":"441010","v":[["5B550FF0-7536-59C2-BA03-520C56F35463","تَخَلّى عَنْ أَبي حَرْبٍ فَوَلّى","بهيدة قابض قبل القتالِ"],["861B3711-F467-52EB-8785-8ECBC2721D9A","ونجى قابض ورد سبوح","يَمْرُّ كأنهُ مريخُ غالِ"],["632FA764-00E5-5230-86E6-CA887E499B38","نَفَخْتَ بهِ اليَمينَ فَظَلَّ يَهْوي","هويَّ الصَّقْرِ في يَوْمِ الظّلالِ"],["6909F5F3-602E-5279-8B3E-1F993BD0B9ED","فجاء كأنما يهوي لنحب","طويل المتن مرتفع القذالِ"],["69105220-F728-57A3-B309-1DEB548610FB","ألما أن رايت الخيل تردى","تباري بالخدود شبا العوالي"],["8ED4AEF1-F034-5E42-A253-D1F7433584C8","على زَبَدِ القَوَائِمِ أعوجيٍّ","حثيث الركض منكفت القوالي"],["B9278DDB-141C-5256-ACCD-12072B7BE1E6","حباك بهِ ولمْ يجدْ بكَ لمّا","راك محارفاً صمن الشمالِ"],["1D5ABEA6-7810-574E-A63E-20C2F605F8F8","فإنّك لو ركضتَ ـ خلاكَ ذَمُ ـ","وفارقَكَ ابنُ عمّك غيرَ قالِ"],["548FA5FE-520C-5D0C-829A-D92D622C30D5","ألمْ تعْلمْ جَزاك الله شرا","بأن الموت منهاة الرجالِ"],["1362D745-6E25-54A4-AF8F-56DCE7F25EA6","فتضربَ ضَرْبةً يسْمُو إليها","حديث القوم في الرفق العجالِ"],["1596B5DF-D4F0-5717-BD87-1D50EF59CC9E","فلا وأبيك يا ابن ابي عقيل","يبلُّك بعدها عندي بلال"]]},"66499015-EB26-51F1-BEB8-E0CDB130B166":{"t":"تُشَافي رَوَاياهُمْ هُبالَةُ بَعْدَما","p":65,"s":"تشافي رواياهم هبالة بعدما","r":"441021","v":[["6661600F-5ACF-5470-9DDB-BBB954A47FB7","تُشَافي رَوَاياهُمْ هُبالَةُ بَعْدَما","وردن وحول الماء بالجم يرتمي"]]},"EC8A7776-8AD2-52E1-9E67-F3C65F75F245":{"t":"جَزَى اللُه خَيْراً وَالجزاءُ بكفِه","p":65,"s":"جزى الله خيرا والجزاء بكفه","r":"441006","v":[["B782E449-E225-5AED-BFDA-D15E5415D81B","جَزَى اللُه خَيْراً وَالجزاءُ بكفِه","فتى من عقيل ساد غير مكلفِ"],["C0F23188-0ACB-5C63-8DDE-2DF7A4F8A78F","فَتًى كانَتِ الدُّنْيَا تَهُونُ بأسْرِها","عليه ولا ينفك جم التصرفِ"],["38BC95D0-4960-5B40-A2F6-749A98708139","يَنَالُ عَلّياتِ الأُمورِ بِهَوْنةٍ","إذا هِيَ أَعيَت كُلَّ خرْق مُشَّرفِ"],["E80AE897-EF31-5D59-AC18-C57554E3C397","هُوَ الذَّوبُ بلْ أريُ الخَلايا شَبيهُه","بدِرياقةٍ من خَمْرِ بَيْسانَ قَرْقَفِ"],["1CEBA479-E360-5938-998F-D78F03B7CABA","فيا تَوبُ مافي العَيْشِ خَيرٌ ولاندًى","يعد وقد أمسيت في ترب نفنفِ"],["A02AFC1D-A533-5404-9C16-8513E3EB7325","ومانِلْتُ منْكَ النَّصفَ حتى ارتَمَتْ بِكَ","المَنَايا بسهمٍ صائبِ الوَقْعِ أعْجَفِ"],["BA72D334-5F74-58A2-A081-2644B92DF083","فياالف ألف كنت حيا مسلماً","لألقاك مثل القسور المتطرفِ"],["5A31B1A8-D61D-5A9D-9260-B4E897280D90","كما كنت إذ كنت المنحى من الردى","غذا الخيل جالت بالقنا المتقصفِ"],["462D3A54-D67B-5697-8B9C-CA1C427FDCF7","وكَمْ من لَهيفٍ مُحجَر قدأجبتَه","بأبيضَ قطّاعِ الضريبَةِ مُرْهفِ"],["37640DC7-41F3-5E47-B8C2-1CD3011D4B9F","فأنقذتَه والموْتُ يَحرقُ نابَهُ","عليه ولم يطعن ولم يتسيفِ"]]},"B0FBBBCA-26DC-5FB8-AFF4-9894E5879D90":{"t":"جَزَى اللُّه شَرّا قابِضاً بصنيعه","p":65,"s":"جزى الله شرا قابضا بصنيعه","r":"441027","v":[["94FBE2E6-357C-5D23-A92E-5C1ECF5CCA30","جَزَى اللُّه شَرّا قابِضاً بصنيعه","وكل امرىء يجزى بما كان ساعيا"],["F5D2BF8B-1996-55B6-A8AF-15992345F40D","دعا قابضاً والمرهفات يردنه","فقُبحْتَ مدعّوا، ولبّيك داعيَا"],["3F244CAD-D1B2-50FB-B011-01A88B113AEA","فَليْتَ عُبيدَ اللِّه كانَ مكانَه","صَرِيعا؛ولم أسمَعْ لتوبةَ ناعِيَا"]]},"9AC62D85-4A56-5DBC-8D97-2DFD772A968E":{"t":"حداك الحين أن عالبت ملكاً","p":65,"s":"حداك الحين أن عالبت ملكا","r":"441018","v":[["E956B2C1-9A85-54B9-8C51-6AE476E3FE95","حداك الحين أن عالبت ملكاً","أريبا ذا مُخاتلَةٍ وحَزْمِ"],["CF42E891-449B-5423-89D3-7388CD6F2D6B","ومصنوعاً له فِيماأتَاه","إلى الأملاك من وتر وغمِّ"],["DD2FE1C8-230C-53AA-AB4B-A481FDADD85C","فدونَكَها فَذُقْ كأسا قَتُولاً","على طعمين: ممقور وسمِّ"]]},"C1B648FB-C00E-52E8-A0D1-1B4957D2F464":{"t":"دعا قابضأ والموت يخفق ظله","p":65,"s":"دعا قابضأ والموت يخفق ظله","r":"440989","v":[["B6DC5883-D8C3-5413-B6D7-B4F1E2C05DBE","دعا قابضأ والموت يخفق ظله","وما قابض إذ لم يجب بنجيبِ"],["C1B683EA-E6DA-558C-96B8-31B88091BE3E","وآسى عُبيدُ الله ثَمَّ ابنَ أُمّهِ","ولو شَاءَ نجّى يومَ ذاك حَبيبي"]]},"416297A7-2861-5C68-AD74-4DCA280E3FCD":{"t":"دعاكَ فلا مِنْ أَنْفَسِ القَوْمِ أنتمُ","p":65,"s":"دعاك فلا من أنفس القوم أنتم","r":"441008","v":[["A7ECD223-3DEA-5FC3-A01F-15CD45AE7969","دعاكَ فلا مِنْ أَنْفَسِ القَوْمِ أنتمُ","ولا نسب من قيس عيلان يعرفُ"]]},"80C79E14-C378-5335-B8AB-01E4C22F1487":{"t":"رَمَوْها بأَثوَابٍ خِفَافٍ فلا تَرَى","p":65,"s":"رموها بأثواب خفاف فلا ترى","r":"441003","v":[["048F9ED1-42C8-5BC2-9BD2-34318A97386E","رَمَوْها بأَثوَابٍ خِفَافٍ فلا تَرَى","لها شبهاً إلا النعام المنفرا"]]},"84934566-5477-5F8E-B6F7-CD941B8FA4EC":{"t":"ستحملني ورحلي ذات وخد","p":65,"s":"ستحملني ورحلي ذات وخد","r":"441016","v":[["B6C5277A-E2A0-58A8-B70C-644B91694ECB","ستحملني ورحلي ذات وخد","عَلَيْها بِنْتُ آباءٍ كِرامِ"],["A1C92F7D-01A6-5047-9481-FCB9C1EDACD0","إذا جعلت سواد الشأم جنباً","وغُلَّق دونَها باب اللَّئامِ"],["AB756EE8-81AF-50B9-9CF4-1D86FDAB3837","فليسَ بعَائدٍ أبدا إلَيهِم","ذوُو الحَاجاتِ في غَلَسِ الظَلاَمِ"],["0DAA87B5-2B7E-5ED3-A084-D2899DD4D957","أعاتِكَ لَوْ رَأَيْتِ غَدَاة بِنا","عَزاءَ النّفْسِ عنكُمُ واعْتِزامِي"],["8463921A-E049-5C30-BB7D-2D83B5515946","إذاً لعَلِمْتِ واسْتَيْقَنْتِ أنّي","مْشَيَّعةٌ، ولم تَرْعَيْ ذِمامي"],["3CC9A210-8927-5978-BAD2-0685B3F36C16","أأجعلُ مثلَ توبةَ في نداه","أبا الذبان فوه الدهر دامي"],["FB4C4D8A-62DC-55A3-985F-1307AE242B5F","معاذ الله عسفت برحلي","تُغذُّ السَّيرَ لِلبَلدِ التّهامِي"],["19C9128A-C260-56EA-99DF-6B38A0D96587","أقلتِ:خَلِيفةٌ فَسِواه أحْجَى","بِامْرَتهِ وأولى باللَّئامِ"],["9FE6F940-EE9C-51F0-A373-89C535B7711F","لِثامِ الملك حينَ تُعَدُّ كعبٌ","ذوو الأخْطارِ والخُطَطِ الجسامِ"]]},"98BD7CD5-02BC-5BB0-B925-EF156C5812E8":{"t":"شمُّ العَرانين أَسْمَاطٌ نِعالِهِمُ","p":65,"s":"شم العرانين أسماط نعالهم","r":"440999","v":[["596EBF00-7163-5488-9430-6D3061879373","شمُّ العَرانين أَسْمَاطٌ نِعالِهِمُ","بيض السراويل لم يعلق بها الغمرُ"]]},"3E204366-2F2C-5643-95EA-847D0105FB70":{"t":"طربت وما هذا بساعة مطرب","p":65,"s":"طربت وما هذا بساعة مطرب","r":"440984","v":[["C667B9AF-E4FE-5520-AF6A-E889DD46CEAD","طربت وما هذا بساعة مطرب","إلى الَحيّ حَلّوا بين عَاذٍ فجُبْجُبِ"],["E60CD4C3-E6B4-577A-97BC-8C282EE4ED20","قَدِيمافأمْسَتْ دارُهُم قد تلعبتْ","بها خرقات الريح من كل ملعبِ"],["6414C9B6-7F81-5E3C-8B4B-0A8E2AA17701","وكَمْ قَدْ رَأى رائيهِم ورَأْيتُه","بِها لِي مِنْ عمِّ كريم ومن أَبِ"],["FB2D39F8-B95D-5593-BDED-73205C237414","فوارس من آل النفاضة سادة","ومن آل كَعْبِ سؤددٌ غيرُ مُعْقَبِ"],["454253C4-4580-576A-B50E-A9639CC32149","وحيِّ حريدٍ قد صبحْنا بغارةِ","فلم يمس بيت منهم تحت كوكبِ"],["2B6367EE-D683-5836-8824-C64A98CF2386","سننا عليهم، كل جرداء شطبة","لجوج تباري كل أجرد شرجبِ"],["717A8AD4-B21C-5821-84BD-DC62251D1B3B","أجشُّ هزيمٌ في الخَبارِإذا انتحى","هَوادي عِطفَيْه العِنان مُقرّبِ"],["F02EFA81-0DC5-548B-9332-186B4AEFB354","لوحشِيها من جانبَي زَفيَانِها","حفيف كخذروف الوليد المنقبِ"],["0403FA95-EA50-5B45-836A-1E2619192E86","إذا جاشَ بالماءِ الحَميمِ سِجالُها","نَضَخْنَ به نَضْحَ البمزادِ المسرَّبِ"],["AEB0AEF1-4927-5898-A8CB-902A76116A7D","فذر ذا، ولكن تمنيت راكباً","إذا قالَ قوْلاً صادِقاً لم يكذّبِ"],["813874F3-EFC6-5270-980B-2E271AE3D245","له ناقة عندي وساع وكورها","كلا مرفقيها عن رحاها بمجذبِ"],["8C5C21F3-4B87-543B-95A7-0B071363B11F","إذا حركتها رحلة جنحت به","جنوح القطاة تنتحي كل سبسبِ"],["9A89309C-BD11-563D-85C6-09A16AA51307","جنوح قطاة الورد في عصب القطا","قَربْنَ مِياهَ النَّهْي منْ كلّ مَقرَبِ"],["2EFB810C-733E-5DC7-90A4-038B35591B5D","فغادين بالأجزاع فوق صوائق","ومدفع ذات العين أعذب مشربِ"],["FE35012D-5543-5F33-ABEB-119B380F5A65","فَظَلْنَ نَشَاوى بالعُيونِ كأَنَّها","شَروبٌ بَدَتْ عنْ مرزُبان مُحجَبِ"],["A8F88BC4-804C-59E4-B245-F25D73AC8612","فنالَتْ قَلِيلاً شَافيا وتعجَّلَتْ","لنادلها بين الشباك وتنضبِ"],["51228ECD-8896-537A-816E-3820A04C8C2A","تبيت بمَوماةٍ وتصْبحُ ثَاويا","بها في أفاحيص الغوي المعصبِ"],["29728C9A-D86C-5111-927F-4DCF56838F12","وضمت إلى جوف جناحاً وجؤجؤاً","وناطَتْ قَلِيلاً في سِقاءٍ مُجبَبِ"],["E2DB9580-1A3A-5307-9B51-F07971D6329D","إذا فترت ضرب الجناحين عاقبت","عَلَى شُزنيها مَنْكبا بعد مَنكبِ"],["C4B1D081-8F69-5CDC-8A55-D5E5D3FFC0E5","فلما أحسا جرسها وتضورا","وأوبتَها من ذلك المُتأوّبِ"],["CC0C1419-FF4B-55A2-A2FD-602B826A9F13","تدلّتْ إلى حُص الرؤوسِ كأنَّها","كرات غلام من كساء مرنبِ"],["DE051F8A-70D1-5F1A-9516-6753A1D07164","فلما انجلت عنْها الدُّجىَ وسقتْهما","صبيب سقاء نيط لما يخربِ"],["BFCFECA4-7FE2-5000-BD50-DF29A568FCB1","غدَت كنواةِ القَسبِ عنْها واصبَحَتْ","تراطنها دوية لم تعربِ"],["CA5AC2A7-E97B-555F-B46D-8F6097735E64","ولي في المُنى أَلا يعرّجَ راكِبي","ويحبس عنها كل شيء متربِ"],["91F486B1-D9B8-581A-9E3E-B37410C64400","ويفرج بوّابٌ لها عَنْ مُناخها","بقليدهِ بابَ الرتاج المُضبّبِ"],["6128C18F-5F25-5B9B-9DB1-B22EA0BA00B5","إذا ما أنيهت بابن مروان ناقتي","فليسَ عليها لِلهَبانيقِ مَرْكَبي"],["4D6CEC12-38E9-54C1-B054-1678F788B201","أدلت بقربي عنده وقضى لها","قضاءً فلم ينقض ولم يتعقبِ"],["6A4580E1-7C45-5279-A07C-318893FE0673","فإنك بعد الله أنت أميرها","وقنعانها من كل خوف ومرعبِ"],["99B8B83D-0176-5DA0-AAB3-189457539886","فتقضى فلولا أنه كل ريبة","وكل قليل من وعيدك مزهبي"],["4FA6AB93-8104-5B11-968D-EAC4B77C07EF","إذا ما ابتغى العادي الظلوم ظلامة","لديَّ، وما استجلبَت للمتجلبِ"],["A945F6B4-52AC-523D-A6DF-7777DF93B1F5","تُبادرُ أبناءَ الوَشاةِ وتبتَغي","لها طلبات الحق من كل مطلبِ"],["02E61C04-5CB5-5C85-AD30-86D96EA8C9F8","إذا أدلجت حتى ترى الصبح واصلت","أديم نهار الشمس مالم تغيبِ"],["5048639B-DFD7-55F2-8253-827976DD8181","فلما رَأتْ دَارَ الأميرِ تحاوصَتْ","وصوت المنادي بالأذان المثوبِ"],["908E12D2-A9F0-5740-A27A-368EA5C6B07C","وترجيعَ أصواتِ الخُصوم يردُّها","سقوفُ بيُوتٍ في طِمارٍ مُبوَّبِ"],["2B0BFB29-3489-50E0-A26B-8BB714AAFDC2","يظل لأعلاها دوي كأنه","تَرَنُّمُ قارِي بيتِ نحّال مُجَوَّبِ"]]},"14DD9B5C-1CF5-5623-B4D3-DA247D146E3B":{"t":"عقرت على أنصاب توبة مقرما","p":65,"s":"عقرت على أنصاب توبة مقرما","r":"440986","v":[["DB9D45D9-AECF-54BB-8693-225F50856D23","عقرت على أنصاب توبة مقرما","بهيدة إذا لم تختفره أقاربه"]]},"A0614A5D-5ABD-5D12-ABDB-B0B9C2470571":{"t":"علي تقاهادائماً وفجورها","p":65,"s":"علي تقاهادائما وفجورها","r":"441002","v":[["0145EB24-CCCB-52E2-A92A-AE412D340D15","علي تقاهادائماً وفجورها","ائما وفُجُورُها"]]},"02475A20-181E-5506-9424-4E90A3973A6F":{"t":"غَضُوبٌ للمَهَامهِ ذاتُ لَوْثٍ","p":65,"s":"غضوب للمهامه ذات لوث","r":"440990","v":[["8417AB55-18E0-523E-9287-41A92FD4666E","غَضُوبٌ للمَهَامهِ ذاتُ لَوْثٍ","أمون الخلق سيرتها غلابُ"]]},"1169869B-584B-523B-A49A-CDD04EC5A589":{"t":"فتى لم يزل يزداد خيراً لدن نشا","p":65,"s":"فتى لم يزل يزداد خيرا لدن نشا","r":"440992","v":[["9E560968-A4A2-5F72-914D-898A64692B1C","فتى لم يزل يزداد خيراً لدن نشا","إلى أن علاه الشيب فوق المسايحِ"],["8EF99921-8564-52F8-A9AC-74D0073C3C7F","تراه إذا ما الموت حل بورده","ضَروبا على أقرانهِ بالصّفائحِ"],["E4D158A9-1D72-53E7-834D-CCB1151C4DDF","شُجاعٌ لدى الهَيْجاء ثَبْتٌ مشايحٌ","إذا انحازَ عن أقرانه كلُّ سابحِ"],["EA5F2598-569A-52B9-AAC4-76E9A7420DAA","فعاشَ حميدا لا ذميماً فِعالُهُ","وصولاً لقرباه يرى غير كالحِ"]]},"141DC0B4-CEDB-57EF-96A6-A59E6D54AFB2":{"t":"قتل ابن عفان الإما","p":65,"s":"قتل ابن عفان الإما","r":"441024","v":[["46B51226-80FC-5E40-A570-08B53528F5D2","قتل ابن عفان الإما","مَ فضاعَ أمرُ المسلمينا"],["538DCA19-6C4E-5465-8216-759D7C16E384","وتشتت سبل الرشا","دِ بصادِرين وواردينا"],["593BF4D7-BE3C-5744-B83C-A340150BA7AE","فانهض معاوي نهضة","تُشفي بها الداء الدفينا"],["A668B667-75F9-50A5-9D2A-59FC7A72CA71","أنت الذي من بعده","ندعو أمير المؤمنينا"]]},"BBE2BEF8-18E9-5358-8DD3-4786602F01D5":{"t":"كأن فتى الفتيان توبة لم يرض","p":65,"s":"كأن فتى الفتيان توبة لم يرض","r":"440988","v":[["9DF05681-304E-587E-8944-585A692406A5","كأن فتى الفتيان توبة لم يرض","قَضيبا؛ ولَمْ يَمْسَحْ بِنُقْبَةِ مُجْربِ"]]},"C32367D6-33FF-5505-B370-2C7DB4FE0D52":{"t":"كم هاتف بك من باك وباكية","p":65,"s":"كم هاتف بك من باك وباكية","r":"440995","v":[["274BC647-BF03-5569-B58F-0267B12B9C2C","كم هاتف بك من باك وباكية","يا توبُ للضَّفِ إذْ تُدْعَى وللجّارِ"],["FA4061F2-867C-5A94-A5EE-6F9F15A8B9D9","وتوب للخصم إن جاروا وإن عدلوا","وبدلوا الأمر تقضاَ بعد إمرارِ"],["DD7BD10B-DA45-5CCA-A01A-32A5DA31E9E9","إنْ يُصِدرُوا الأمْرَ تُطلِعهُ مَوَاردُهِ","أو يُورِدُوا الأمرَ تُحلله بإصدَارِ"]]},"9B06DA51-A7A9-5145-8D18-938EBFCAAE22":{"t":"لتبك العذارى من خفاجة كلها","p":65,"s":"لتبك العذارى من خفاجة كلها","r":"441005","v":[["5BDC55C3-127F-58DC-8875-47E47618DBF8","لتبك العذارى من خفاجة كلها","شتاء وصيفاً دائبات ومربعَا"],["8B2A6E76-F54B-515B-A8E9-5FA95912A3AE","على ناشىء نال المكارم كلها","فما انفك حتى أحرز المجد أجمعَا"]]},"E5321E69-4CDD-54A5-96CE-D99BAE9C1233":{"t":"لزاز حروب يكره القوم درأه","p":65,"s":"لزاز حروب يكره القوم درأه","r":"441000","v":[["6D65F88E-B78D-590F-93F4-5A05EA30234E","لزاز حروب يكره القوم درأه","ويمشي غلى الأقران بالسيف يخطرُ"],["C4E4FE14-D3F5-50C4-8796-F22C8DA793C3","مطل على أعدائه يحذرونه","كما يحذر اليث الهزيل الغضنفرُ"]]},"087D96A5-6619-51A1-AE5C-DB104DF1C9C8":{"t":"لما تَخَايلت الحُمُول حَسِبْتَها","p":65,"s":"لما تخايلت الحمول حسبتها","r":"441022","v":[["1CFB3086-2F02-55F3-84AA-5D27E9F81FF2","لما تَخَايلت الحُمُول حَسِبْتَها","دُوماً بأيلةَ ناعِماً مَكْمُومَا"],["304E555B-C86D-5103-9363-DC6BB8561C90","يا أيها السَّدمُ المُلَوي رأسَهُ","ليَقُودَ مِنْ أَهْلِ الحِجَازِ بريمَا"],["54894FD7-4214-5D51-AB7D-405476DB436E","أترِيدُ عمرو بنَ الخَليعِ ودونَه","كعب غذا لوجدته مرؤومَا"],["4B3CA75A-8FB6-5C1E-B4C4-2FECE47E9655","أنَّ الخَليعَ وَرَهْطَهُ في عامِرِ","كالقلب البس جؤجؤا وحزيمَا"],["2EF03128-4E66-5D1D-B809-A320B7CD1367","لاتُسْرِعَنّ إلى رَبيعةَ إنَّهُمْ","جَمَعُوا سَوادا للعدوّ عَظِيمَا"],["CE7A5FF5-AE54-5F88-8494-E046FF0EE362","شَعْبا تَفَرَّقَ من جِماعٍ واحدٍ","عدلت معداً تابعاً وصميمَا"],["AF7CE85A-D1F8-513E-BBCD-EB567AEDC1A6","لا تغزون الدهر آل مطرف","لاظالِماً أبَداً ولامظلومَا"],["E0756C02-C31E-5537-815E-31EA8C02E42B","فَاقصِد بِذرْعكَ لو وَطِئتَ بلادَهم","لاقت بكارتك الحقاق قرومَا"],["9A542E2A-3B33-540C-999A-5A32FD0B57E7","وتَعاقَبَتْكَ كَتَائِبٌابن مطرف","فأرتك في وضح الصباح نجومَا"],["E12023B5-E6A5-51B9-A67D-FFAAE42E9A15","قوم رباط الخيل وسط بيوتهم","وأَسنةٌ زُرْقٌ تُخَالُ نُجومَا"],["47D5E4FB-1B34-5CD2-9F10-431346FEADED","ومخرق عنه القميص تخاله","وسْط البُيوتِ من الحياءِ سَقِيمَا"],["0DF87588-D292-5AFC-B88C-D7D9C2BAD058","حتّى إذا رَفَعَ اللواءَ رأيتَهُ","تَحْتَ اللواءِ على الخَميسِ زَعِيمَا"],["DE07C9F8-9362-537B-B10D-3BE3F28CBA6C","وإذا تشاء وجدت منهم مانعاً","فلجاً على سَخَط العدو مُقيمَا"],["474E4712-2C9A-5B60-BEF2-1AC21724C3AF","أو ناشئاً حَدَثاً تحكم مثلَهُ","صلع الرجال توارث التحكيمَا"],["6B60F31E-90D4-51C1-8CA7-F3C857172607","لن تستطيع بأن تحول عزهم","حتى تحول ذا الهضاب يسومَا"],["3D1C773B-A676-5242-BDFC-EDBF13F87963","إن سالموكَ فدَغهم من هَذِه","وارقد كفى لك بالرقاد نعيمَا"]]},"DB9236A5-A5E9-5390-B010-8A7D925991F3":{"t":"لَعَمْرُكَ ما الهِجْرانُ أنْ تَشْحَطَ النَّوى","p":65,"s":"لعمرك ما الهجران أن تشحط النوى","r":"440998","v":[["7808957E-0091-56A3-8163-E7C282343266","لَعَمْرُكَ ما الهِجْرانُ أنْ تَشْحَطَ النَّوى","ولكنَّما الهِجْرانُ ما غيّبَ القبرُ"]]},"D4048603-9A49-5920-A115-93786C6448FC":{"t":"لَعَمْرُكَ ما بِالموتِ عَارٌ على الفتى","p":65,"s":"لعمرك ما بالموت عار على الفتى","r":"441023","v":[["45FD465D-B762-5C53-88E0-31C18C85A7AE","لَعَمْرُكَ ما بِالموتِ عَارٌ على الفتى","إذا ما الفَتَى لاقَى الحِمامِ كَريما"]]},"FC78B227-B560-52C1-9F6D-31D4D8A170E7":{"t":"مُعَاويَ لمْ أكَدْ آتيك تَهْوي","p":65,"s":"معاوي لم أكد آتيك تهوي","r":"440985","v":[["9FE96C88-3ED2-54B8-9D53-33F882A91BDD","مُعَاويَ لمْ أكَدْ آتيك تَهْوي","برَحْلِي رَادةُ الأصلاب نابُ"],["BC940665-8521-5DE0-9B32-0E45C9C47EDA","قريح الظهر يفرح أن يراها","إذا وضعتة ليتها الغرابُ"],["64F728A9-D41A-5DEC-96EF-D7A115EA129B","تَجُوبُ الأَرْضَ نَحْوك ما تَأنّى","إذا ما الأكمُ قنّعها السَّرابُ"],["EF424D0D-5E04-5277-930D-D82D9B457ADD","وكنتَ المُرْتَجى وَبِكَ استغاثَتْ","لتُنعِشَها؛إِذا بَخُلَ السَّحابُ"]]},"50D8592C-DB4C-5539-BDCC-D07A8B60F9A1":{"t":"مُهَفْهَفُ الكَشْحِ والسَّربالُ مُنخرقٌ","p":65,"s":"مهفهف الكشح والسربال منخرق","r":"441001","v":[["C51F03E0-AF5A-53E8-8F9C-44413BABED79","مُهَفْهَفُ الكَشْحِ والسَّربالُ مُنخرقٌ","عنْه القميصُ لسير الليل مُحْتقَرُ"],["A0627023-78E4-5850-9DAF-9232887E271D","لا يأمن الناس ممساه ومصبحه","في كل فج وإن لم يغز ينتظرُ"]]},"57993CCD-79D4-5AFE-90EA-860C9EEC0198":{"t":"نحن الأخايل ما يزال غلامنا","p":65,"s":"نحن الأخايل ما يزال غلامنا","r":"441004","v":[["954AA8E0-813C-5F26-9981-9733C3BF3EFA","نحن الأخايل ما يزال غلامنا","حتى يدب على العصا مذكورا"]]},"EFE46634-2F0A-5EEB-B5F0-E227349E7C42":{"t":"نطرت وركن من ذقانين دونه","p":65,"s":"نطرت وركن من ذقانين دونه","r":"440993","v":[["9605DDC7-59A0-5901-9CF2-FD7BD8A951D8","نطرت وركن من ذقانين دونه","مَفَاوِزُ حَوْضَى، أَيّ نَظْرةِ نَاظِرِ"],["43FA7344-517C-5E86-9E3A-E2A426BAC92E","لأونسَ إنْ لم يَقْصُرِ الطِّرْفُ عنهمُ","فلم تقصر الأخبار والطرف قاصري"],["ABFD6C54-2895-5D4E-ABDA-E3A14284A4E5","فوارس أجلى شاؤها عن عقيرة","لعاقرها فيها عقيرة عاقرِ"],["D08D0EB6-748A-5C4D-B684-CFB0CC9240E1","سوابقها مثل القطا المتواترِ","قَتِيلُ بني عَوْفٍ وأَيصُرُ دونَه"],["9A5C854D-ABE9-5584-98AC-8129E19EF94B","قتيلُ بني عَوْفٍ قتيلُ يُحَايرِ","تَوَاردَه أسيافُهم فكأنّما"],["1E626B46-8182-538B-BEB3-3F607D5185DB","تصادرون عن أقطاع أبيض باترِ","من الهندوانيات في كل قطعة"],["F16A8708-AAE7-528F-8A6A-6CF0609FB62D","دَمٌ زلّ عن أَثْرٍ من السَّيف ظاهرِ","أتتْه المنايَا دون زَغْفٍ حصينةٍ"],["47181CB2-621F-5B6F-94E4-EAD3B2AEC144","وأسمر خطي وخوصاء ضامرِ","على كل جرداء السراة وسابح"],["60971A9B-6DF5-5F7B-A652-7F6FDF1CE0B2","درأن بشباك الحديد زوافرِ","عوابس بعدو الثعلبية ضمراً"],["7BA62B6D-7528-52D9-A404-4C238EE2315A","وهُنّ شَوَاحٍ بالشَّكيم الشّواجرِ","فلا يُبْعدَنكَ اللُه ياتَوْبُ إنّما"],["203B23EE-3ABA-551A-82FF-6538E36FF00C","لِقاءُ المَنايا دارِعَا مثلُ حَاسرِ","فإلاّ تَكُ القَتْلَى بَوَاءً فإنّكم"],["62DD6D5E-0F51-5CAF-932A-6EF29AF90920","ستلقون يوماً ورده غير صادرِ","وإن السليل إذ يباوى قتيلكم"],["F24D8FC2-A132-585A-833D-A8D794749CF5","كمرحومةٍ من عَرْكِا غيرِ طاهرِ","فإن تكن القتلى بواء فإنكم"],["20F0FDBC-2890-5029-9BC2-AE777A93FFFE","فتى ما قتلتم آل عوف بن عامرِ","فَتًى لا تَخَطَّاه الرَّفاقُ ولا يرى"],["8A0C8A25-EBBC-5D59-B817-5F6C6EFEAB69","لقدر عيالاً دون جار مجاروِ","ولا تأخذُ الكُومُ الجِلادُ رِماحَها"],["E832F215-3EFC-57BD-BEBA-9858F583FC8A","لتوبةَ في نَحْسِ الشِّتاء الصَّنَابِرِ","إذا ما رأته قائماً بسلاحه"],["447D1C53-2B1D-5CC5-B5F6-B5FB9BEDA336","تَقَتْه الخِفْافُ بالثِّقال البَهَازِرِ","إذا لم يَجُدْ منها برسْلٍ فقَصْرُه"],["E2A19EAE-0AD2-5B92-B2DA-A86E81B94734","ذُرَى المُرْهَفاتِ والقِلاَصِ التَّواجِرِ","قَرَى سيفَه منها مُشَاشاً وضَيْفَه"],["C964EA5B-F62F-5CE1-A26C-A1735504A4CF","سنام المهاريس السباط المشافرِ","وتوبة أخيا من فتاة حيية"],["B940D178-631C-54A9-84A0-91E40E1114DC","وأجرأُ من لَيْث بخَفْانَ خادرِ","ونعم الفتى إن كان توبة فاجراً"],["29E3E83D-6DCC-5487-BA69-80AC7642BDDA","وفَوْقَ الفَتَى إنْ كانَ ليْسَ بفَاجِرِ","فتى يُنْهِلُ الحاجاتِ ثُمَّ يُعلُّها"],["7B24DE5E-145C-5F7A-8404-75C237D06A75","فيطلعها عنه ثنايا المصادرِ","كأن فتى الفتيان توبة لم ينخ"],["40D0038C-6341-544C-866D-F490F9BF7994","قَلائصَ يَفْحَصْنَ الحَصَا بالكَرَاكرِ","ولم يبن أبراداً عتاقاً لفتية"],["DE58FFB9-FF02-5E4D-B872-78CF1D1D64E7","كِرَامٍ ويَرْحَلْ قبل فَيْء الهَوَاجِرِ","ولم يتجل الصبح عنه وبطنه"],["D2D54BA2-806D-5C61-8847-E62340E90B40","لَطِيفٌ كطَيِّ السِّبِّ ليس بِحَادرِ","فتًى كان للمَوْلى سنَاءً ورفعةً"],["43432523-78CA-540E-A8F2-AB819327830D","وللطارق الساري قرى غير باسرِ","ولم يدع يوماً للحفاظ وللندا"],["E7C9F470-137E-59B9-97C0-39579C1B8B44","وللحرب يرمى نارها بالشرائرِ","وللبازِل الكَوْماءِ يرْغو حُوَارُها"],["30B763DA-5074-5217-862C-3A1A0137A748","وللخيل تعدو بالماة المساعرِ","كأنّكَ لم تَقْطَعْ فلاةً ولم تُنِخْ"],["AA6E00C4-7580-53AE-8468-7180ADE18948","قِلاصا لدى فأوٍ من الأَرض غائرِ","وتُصْبِحْ بمَوْماةٍ كأنّ صَرِيفَها"],["D62AB00E-1A58-5B69-ACA5-1BF04CC71793","صَريفُ خَطَاطِيفِ الصَّرَى في المَحَاوِرِ","طوت نفها عنا كلاب وى سدت"],["0ED486E4-48F0-55D6-AEE2-DAB4EAAF34BF","بنا أجهليها بين غاو وشاعرِ","وقد كان أن تقول سراتهم"],["B66DDE92-BF1D-5ED9-9E12-6E65192DC101","لعا لأخينا عالياً غير عائرِ","ودوية قفر يحار بها القطا"],["2A73B9BF-1564-50B2-8A0B-50364D5C9AFB","تخطيتها بالناعجات الضوامرِ","فتَاللَّهِ تَبنِي بيتَها أُمُّ عاصمٍ"],["228A830E-2B74-5455-A433-393AE273408E","على مثله أُخْرَى الليالي الغوابرِ","فليس شِهَابُ الحربِ تَوْبةُ بعدَها"],["5E47595F-0191-5481-9B40-C874BE1A3C72","بغازٍ ولاغادٍ برَكْبِ مُسَافرِ","وقد كان طَلاّعَ النّجادِ وبَيِّنَ اللـ"],["6F56E361-3949-5916-8A6E-FB6D0ED14B64","فآنستُ خيلاً بالرُّقيِّ مُغيرةً","وقد كان قبل الحادثاتِ إذا انتحَى"],["CA471FAE-5707-578C-A9A4-316F35C7B662","وسائق أو مغبُوطةً لم يُغَادِرِ","وكنت إذا مولاك خاف ظلامة"],["2CE5B994-C799-59FD-91D7-13F64FE5531D","دَعَاك ولم يَهْتِف سواك بناصرِ","فإنْ يَكُ عبدُالله آسَى ابنَ أُمِّه"],["C0463B29-3FB1-5A9D-A36C-0AF48DB59FD8","وآب بأسلاب الكمي المغاورِ","وكان كذات البَوِّ تَضْرِب عنده"],["8D97738A-D9B9-59C6-8FD8-9F0FE278D495","سِباعا وقد ألقَيْنَه في الجَرَاجِرِ","££££ فإنك قد فارقْتَه لك عاذرا"],["033C3286-7B85-504C-950E-1672C50AF5A4","وأنى لحي عذر من في المقابرِ","فأقسمت أبكي بعد توبة هالكاً"],["9D0978FE-0D9D-5704-A53F-0F2667839862","واحفل من نالت صروف المقادرِ","على مثلِ هَمَّاٍم ولابنِ مُطَرِّفٍ"],["0591C00E-A67A-57B6-AB4C-DBBF2E6C10F1","لتبك البواكي أو لبشر بن عامرٍ","غلامان كانا استوردا كل سورة"],["7D634BA2-A62E-5E93-A306-9DD6F9097D89","من المَجْدِ ثم استوثقا في المَصَادِرِ","رَبِيعَيْ حَيا كانَا يَفِيضُ نَدَاهُما"],["85E0A6AB-62E4-527D-AAAB-2F29455006A6","على كل مغمور نداه وغامرِ","كأن سنا ناريهما كل شتوة"],["9F3A7F2F-536C-59A2-A428-0CA9152571FA","سنا البرق يبدو للعيون النواظرِ",""]]},"5EC1297C-D1EF-5005-BC87-3A1200B66DA4":{"t":"نْحْنُ مَنَعنَا بَيْنَ أَسْفَلِ ناعِت","p":65,"s":"نحن منعنا بين أسفل ناعت","r":"441019","v":[["8D8B3066-ADD5-5E2E-9D90-9F34C627814C","نْحْنُ مَنَعنَا بَيْنَ أَسْفَلِ ناعِت","إلى وارداتٍ بالخَمِيس العَرَمْرمِ"],["E499D08C-FAB7-5CC4-9B58-69A5FE9043F9","بِحَيٍّ إذا قيلَ اظعَنُوا قد أَتَيْتُمُ","أقاموا على هول الجنان الرجمِ"],["E7706314-D329-5E68-B2BF-5E7082DFE611","تحمل أولاهم من الدار غدوة","وتُمْسي بها أخْراهم لَمْ تَصْرمِ"]]},"491644DC-9EDC-52DF-B69F-E419B6A20248":{"t":"وذي حاجةٍ قلنا له لاتبح بها","p":65,"s":"وذي حاجة قلنا له لاتبح بها","r":"441014","v":[["3D499DCB-6168-5EEB-8B7B-668130CF38CA","وذي حاجةٍ قلنا له لاتبح بها","فليس إليها ما حييتَ سبيلُ"],["66052AC8-1DE4-5C81-983B-8476C8D83129","لنا صَاحِبٌ لا يَنْبغي أنْ نَخْونَهُ","وانت لأخرى فارغ وحليلُ"],["C1FF8692-EE79-527E-AC2E-C65E8DFE52F2","تخالك تهوى غيرها فأنها","لَهَا مِنْ تَظَنّيها عَلَيْكَ دَليلُ"]]},"A0459E25-08B8-596B-B344-7E193A5FBCB3":{"t":"ولنعم الفتى ياتوب كنت إذا التقت","p":65,"s":"ولنعم الفتى ياتوب كنت إذا التقت","r":"441011","v":[["BD060910-5608-5C35-A965-AFE23EB91A93","ولنعم الفتى ياتوب كنت إذا التقت","صدور العالي واستشال الأسافلُ"],["E8E083A2-6360-54A9-A6AC-01757825CEC6","ونعم الفتى ياتوب كنت ولم تكن","لتسبق يوماً كنت فيه تحاولُ"],["16AFFB4D-31F4-591A-B4C8-118CA0F8A0D9","ونعم التفى ياتوب كنت لخائف","أتاك لكي يحمي ونعم الجاملُ"],["F336B0B1-F68D-51AA-BE63-0D06BCF19120","ونعم الفتى ياتوب جاراً وصاحباً","ونعم الفتى ياتوب حين تفاضلُ"],["D9DA4609-B282-5F4A-A19E-B33CBBF190D0","لعمري لأنت المرء ابكي لفقده","بجد ولو لامت عليه العواذلُ"],["0A281FC1-3CAB-5C4A-AB44-4D7B9B350150","لعمري لنت المرء أبكي لفقده","ويكثر تسهيدي له لا أوائلُ"],["799EEC0E-2542-526F-AE24-ACB92B124727","لعمري لأنت المرء أبكي لفقده","ولو لام فيه ناقص الرأي جاهلُ"],["442E6A39-59D8-5864-8F30-AEEF52446B09","لعمري لأنت المرء أبكي لفقده","إذا كَثُرتْ بالمُلحمينَ التلاتلُ"],["F3C00E4B-D9FA-53D0-864B-3A65A1C0C261","أبى لك ذمَّ الناسِ ياتوبَ كلّما","ذُكرتَ أمورٌ مُحكماتٌ كواملُ"],["431065A6-A698-58BB-9998-B7015A9663C0","أبى لك ذمَّ الناسِ يا توبِ كلّما","ذكرت سماح حين تأوي الأراملُ"],["E27EE5B8-D7E2-566C-9D10-1767BD81B7B6","فلا يُبعدنكَ اللُه ياتوبَ إنما","لقيت حمام الموت والموت عاجلُ"],["372825A4-A704-5D14-BD1E-176FD9203C88","ولايُبعدنكَ اللُه ياتوبَ إنها","كذاكَ المنايا عاجِلاتٌ وآجلُ"],["C96DAE25-973E-57DE-A233-873D1CC4EECA","ولايُبعدنَك اللُه ياتوب والتقت","عليك الغوادي المدجنات الهواطلُ"]]},"DF1301C2-2C46-590F-9B18-1F5414BFE294":{"t":"ياعينُ بَكّي بدَمْعٍ دائِمِ السَّجمِ","p":65,"s":"ياعين بكي بدمع دائم السجم","r":"441017","v":[["3E3D5B67-6AB3-57E2-BC81-A1825FC1BB96","ياعينُ بَكّي بدَمْعٍ دائِمِ السَّجمِ","وابكي لتوبة عند الروع والبهمِ"],["B197CDBF-260C-549C-8BB9-D9B31170EE19","على فتًى من بَني سَعْدٍ فُجعتُ بهِ","ماذا أجنَّ به في الحُفْرَةِ الرَّجْمِ"],["6D5FDF6D-6EA1-5C75-97C8-F94F0EF65136","منكلّ صَافيةٍ صرْفٍ وقافيةٍ","مثل السِّنان وأمر غير مُقتَسمِ"],["8638164F-38FE-5F59-8EB5-B69AA72DBFC5","ومصدر حين يعيي القوم مصدرهم","وحَفنة عند نحسِ الكوكبِ الشبمِ"]]},"8C9A45F4-8710-5536-9269-249996602602":{"t":"يشبهون ملوكاً في تجلتهم","p":65,"s":"يشبهون ملوكا في تجلتهم","r":"441020","v":[["3148FF9D-35A6-54C0-BD71-013DDF8FDC68","يشبهون ملوكاً في تجلتهم","وطول انصية الأعناق واللممِ"]]}}}