779B-5DBC-93B1-79C9069A6185","فبذلت أفضلَ ما يضيق ببذله","وسعُ النفوسِ من الفعال البارع"],["E9C1115C-0A1E-5D07-B360-9E877C69659E","وعفوتَ عمن لم يكن عن مثله","عفوٌ ولم يشفع إليك بشافع"],["A14445A6-A3C4-52EF-AAEF-C2F6764A969C","إلا العلوُّ عن العقوبة بعدما","ظفرت يداك بمستكين خاضع"],["A119772C-F1CC-5C25-A6EE-A4A31A5185AF","فرحمت أطفالاً كأفراخ القطا","وعويل عانسةٍ كقوس النازع"],["2B7175F6-5CB6-5031-8A42-390ED9D7BA9F","وعطفت آصرةً عليَّ كما وعى","بعد انهياض الوثي عظمُ الظالع"],["81F96682-8A10-5889-AB1A-308F422F5883","الله يعلم ما أقول فإنها","جهد الأليةِ من حنيفٍ راكعِ"],["68FAF32A-D784-5952-9E72-990FD8CFAA1A","قسماً فما أدلي إليك بحجةٍ","إلا التضرع من مقرٍّ خاشع"],["3EA2ED0D-DBC1-5B5A-8E6C-D4608D4341C1","ما إن عصيتك والغواةُ تقودني","أسبابها إلا بنيةِ طائع"],["9F4C14DE-6118-5680-9CEA-A9B5FFE2DB18","حتى إذا علقت حبائل شقوتي","بردى إلى حفر المهالك هائع"],["64CAF30F-97B2-5C74-991A-5EC7CC16C223","لم أدرِ أن لمثل جرمي غافراً","فوقفت أنظرُ أي حتف صارعي"],["A85D8A90-B898-5952-8DB1-C0514E7DDE26","رد الحياةَ عليَّ بعد ذهابها","ورعُ الإمام القادرِ المتواضع"],["62342517-1D58-5821-9E93-ECB0244C3A99","أحياكَ من ولاكَ أطولَ مدةٍ","ورمى عدوكَ في الوتين بقاطع"],["A7152AB5-84C2-5B8F-A471-2FF24D563177","كم من يدٍ لك لم تحدثني بها","نفسي إذا آلت إلي مطامعي"],["4F920400-92E1-59F7-BED4-2AFAEABE9D26","أسديتها عفواً إليَّ هنيئةً","فشكرتُ مصطنعاً لأكرم صانع"],["4E199A52-49B3-5403-870A-110671B9A598","إلا يسيراً عندما أوليتني","وهو الكثير لدي غير الضائع"],["EA80F0A8-1FE5-5A5C-9831-D6980B274A09","إن أنت جدتَ بها عليَّ تكن لها","أهلاً وإن تمنع فأعدلُ مانعِ"],["FCEDFAD1-8B11-5CCE-A9EF-0395F6BB158D","إن الذي قسم الخلافة حازها","في صلبِ إدمٍ للإمامِ السابع"],["4BA14DD9-D1D5-5B85-8C40-11679520FA0C","جمعَ القلوبَ عليك جامعُ أمرها","وحوى رداؤكَ كل خيرٍ جامعِ"]]},"CF23767C-DE1D-578D-B6BA-CAD3BD1D51C6":{"t":"ذنبي إليكَ عظيمٌ","p":101,"s":"ذنبي إليك عظيم","r":"477605","v":[["6E009851-CBD7-5689-B5E5-5345AD44300E","ذنبي إليكَ عظيمٌ","وأنت أعظمُ منهُ"],["7C0EFD57-5DC2-51A9-A4B8-5CFD6D070FBF","فخذ بحقك أو لا","فاصفح بفضلك عنهُ"],["4939D522-AC79-547F-806E-3D05521176AE","إن لم أكن في فعالي","من الكرام فكنهُ"]]},"43FCC066-CB52-57FB-9B9F-D6A881FDB061":{"t":"ذهبتُ من الدنيا وقد ذهبت مني","p":101,"s":"ذهبت من الدنيا وقد ذهبت مني","r":"477613","v":[["49DFC174-F427-50BF-BAEF-1CE9667753B1","ذهبتُ من الدنيا وقد ذهبت مني","هوى الدهر بي عنها وولى بها عني"],["BCEC1EE2-1F7B-5308-9880-02D9E8AE9BF5","فإن أبكِ نفسي أبكِ نفساً نفيسةً","وإن أحتسبها أحتسبها على ضن"],["BE0318B0-61FA-52D9-80DF-00474EF29587","وأفلتني عيسى وكانت خديعةً","حللتُ بها ملكي وفلت بها سني"]]},"F8B3A5F3-DABB-5B58-964D-EC7E0852FFDF":{"t":"ربَّ ركبٍ قد أناخوا حولنا","p":101,"s":"رب ركب قد أناخوا حولنا","r":"477588","v":[["B7CB15D7-AA09-5C88-B704-B31CCCD0C0F2","ربَّ ركبٍ قد أناخوا حولنا","يشربون الخمر بالماءِ الزلالِ"],["3050C57A-E80A-57AE-93CD-0CE6A2CEF8B4","ثم أضحوا لعبَ الدهرُ بهم","وكذاك الدهرُ حالٌ بعد حال"],["088340DD-85C9-52E2-974D-52789B039927","من رآنا فليوطن نفسه","إنه منها على قربِ زوالِ"]]},"8D7944D8-C4DA-5AB2-9BE9-6D1968EFC600":{"t":"سلافة كرمٍ تظل النبيط","p":101,"s":"سلافة كرم تظل النبيط","r":"477572","v":[["DD956F89-CF40-57D1-9AD1-1EBFC426B092","سلافة كرمٍ تظل النبيط","ترفع منه عريشاً عريشا"],["FD99B4B0-6A8D-5341-A4C7-8B680B2E0D51","إذا أنت قابلته خلته","مطارفَ خضراً كسين النقوشا"]]},"BFAECB05-0A0B-5785-ABA9-C93DE3481A10":{"t":"صد عن توبةٍ وعن إخبات","p":101,"s":"صد عن توبة وعن إخبات","r":"477552","v":[["B05528B7-2D54-5683-93A9-11003C5C441D","صد عن توبةٍ وعن إخبات","ولها بالمجونِ والقينات"],["1109F7CD-AD27-555B-A45C-9ADEFA78A7F0","ليس ينفك مازجاً في يديهِ","خمرَ قطربلٍ بماءِ الفراتِ"],["361E012F-0509-55DD-86D5-28A65102FF28","ما يبالي إذا خلا بأبي عيسى","وشربٍ من بدنٍ عطراتِ"],["7FEF4259-EDBC-56DC-83D0-D443F01D9AE6","إن يغص المظلومُ في حومةِ الجو","رِ بداءٍ بينَ الحشات واللهاةِ"]]},"EA8EF297-B15E-57C7-8B41-B26C45DEA1AB":{"t":"طرقتك زائرةً فحي خيالها","p":101,"s":"طرقتك زائرة فحي خيالها","r":"477585","v":[["190904F8-04FA-5B04-98ED-39B6FF7CF31B","طرقتك زائرةً فحي خيالها","بيضاءُ تخلطُ بالحياءِ دلالَها"],["B8C352D4-1FA5-520F-BDD7-52D55DF82F4D","هل تطمسونَ من السماءِ نجومها","بأكفكم أو تسترون هلالها"]]},"1FC2A4CC-0B93-5447-A8E5-9DF407200997":{"t":"عجباً عجبتُ لغفلةِ الإنسانِ","p":101,"s":"عجبا عجبت لغفلة الإنسان","r":"477609","v":[["55E91711-52D6-559C-B31D-AB38693C77E3","عجباً عجبتُ لغفلةِ الإنسانِ","قطعَ الحياةَ بغرةٍ وتواني"],["C64176BC-147D-5D82-8D7F-7905CC9859DD","فكرتُ في الدنيا فكانت منزلاً","عندي كبعضِ منازلِ الركبانِ"],["00A466EC-D43C-5CC5-860E-B4643B1ECBE1","مجرى جميعِ الخلقِ فيها واحدٌ","وكثيرُها وقليلُها سيانِ"],["44F2C703-80BE-520B-8775-EB0D46A94B9C","أبغي الكثيرَ إلى الكثير مضاعفاً","ولو اقتصرتُ على القليل كفاني"],["877027CC-CA8D-5C81-9B72-19F185757565","لله در الوارثين كأنني","بأخصهم متبرماً بمكاني"],["D1D295CB-F8C6-50FB-BBE1-73979371D6ED","قلقاً لتجهيزي إلى دارِ البلا","متحرياً لكرامتي بهواني"],["FB2E1844-9974-55CE-A460-47EC20481296","متبرماً مني إذا نشر الثرى","فوقي طوى كشحاً على هجراني"]]},"DA9734B3-A901-5170-B0F2-A52E6DE7846F":{"t":"عفوتَ وكان العفوُ منكَ سجيةً","p":101,"s":"عفوت وكان العفو منك سجية","r":"477579","v":[["3B79CAD2-0A69-5B14-8FF5-0E97EFCFB955","عفوتَ وكان العفوُ منكَ سجيةً","كما كان معقوداً بمفرقك الملكُ"],["FE03D61F-2244-591A-B720-AC20BA806BA2","فإن أنت أتممتَ الرضى فهو المنى","وإن أنت جازيتَ المسيَء فذا الهلكُ"]]},"0FA6F083-013B-511E-9C08-098D57A96613":{"t":"عوجا بمغنى الطلل الدائرِ","p":101,"s":"عوجا بمغنى الطلل الدائر","r":"477568","v":[["B6CBD189-2434-514F-99F2-C7FC49E3B70C","عوجا بمغنى الطلل الدائرِ","بالخلدِ ذات الصخرِ والآجرِ"],["75E5B713-DA24-56E5-8062-A1511E699C55","والمرمرِ المنسوب يطلى به","والبابُ بابُ الذهبِ الناضرِ"],["0B97C21F-984C-5EAF-914E-0830C5C1F61C","عُوجا بها فاستيقنا عندها","على يقين قدرةِ القادرِ"],["39FF9C38-B0FD-5ECE-8D13-AF61535D9297","وأبلغا عنى مقالاً إلى","المولى على المأمورِ والآمرِ"],["6113F1A1-387D-541C-A4F2-9BEBB481A388","قولا له يا ابن أبي الناصرِ","طهر بلادَ الله من طاهرِ"],["3BA00F89-7B1B-59F7-A177-D0F32712A3AC","لم يكفه أن حز أوداجهُ","ذبحَ الهدايا بمدى الجازر"],["72FF3941-27A2-5ED9-8A79-2AAC43528073","حتى أتى يسحب أوداجه","في شطنٍ هذا مدى السائر"],["FC5BE560-AC1E-5E07-BF4C-425D6D219048","قد برد الموتُ على جنبه","فطرفه منكسرُ الناظرِ"]]},"5DCB7646-BD92-5158-B12C-BC8B44C23936":{"t":"فلا حيي الوجه الذي جئتنا به","p":101,"s":"فلا حيي الوجه الذي جئتنا به","r":"477570","v":[["62754858-044E-5DD1-B419-A667B83DFE45","فلا حيي الوجه الذي جئتنا به","إذا حيت الوجه الكريم المجالسُ"],["F32591B9-4F53-58E5-BFFB-C532412EEE8C","يشيم بني كعبٍ وما أنت منهم","كما شامت الغبراءُ قيساً وداحسُ"]]},"1CA013DE-F333-5E85-9A01-33466D49D11B":{"t":"فللهِ نفي إن في لعبرةً","p":101,"s":"فلله نفي إن في لعبرة","r":"477600","v":[["4D793FC8-9188-552D-A712-C7DAC3A6F9EE","فللهِ نفي إن في لعبرةً","وللدهرِ نقضٌ للقوى بعد إبرامِ"],["44B894E8-FBE8-5A5A-B24A-6BBC67F5F7D7","غدوتُ على الدنيا مليكاً مسلطاً","ورحتُ وما أحوي بها قبسَ إبهامِ"],["8B84C801-0EB5-5596-ACF1-61A45FCE9825","وهل ليلةٌ في الدهرِ إلا أرى بها","قد اثبتَّ أقداماً وزل بأقدامِ"],["643CCCE6-88B9-5CC7-89AC-AD02CB71D467","كذاك رأينا الدهرَ يقدمُ صرفه","على كل نفسٍ بين بؤسٍ وإنعام"],["CB32CC45-AC65-522A-8709-B16F09FB8E21","فيرفعُ أقواماً وكانوا أذلةً","ويهوي من الصيد الكرام بأقوامِ"],["5A8B6488-85EF-516D-8D5B-2DC49496379E","فيسقيهم شربين سخناً وبارداً","بكأسين شتى من هوانٍ وإكرامِ"],["7D90C15F-45D4-51B7-AAD1-7743534A1082","وكائن ترى من معدمٍ بعد ثروةٍ","وآخرَ يؤتى ثروةً بعد إعدامِ"]]},"56EB04C1-496C-50A2-9AA9-5EAABFFD7F41":{"t":"فلو أن خداً كان من فيض عبرةٍ","p":101,"s":"فلو أن خدا كان من فيض عبرة","r":"477537","v":[["AA7F5209-CC9A-57FD-946F-74AF25E1448D","فلو أن خداً كان من فيض عبرةٍ","يرى معشباً لاخضر خدي وأعشبا"]]},"F80114B5-70D9-551B-B18B-27E50A326D88":{"t":"فما مزةٌ قهوةٌ قرقفٌ","p":101,"s":"فما مزة قهوة قرقف","r":"477578","v":[["D07F9881-60F2-5750-B7A6-751CB5E7B0FC","فما مزةٌ قهوةٌ قرقفٌ","شمولٌ تروقُ براووقها"]]},"7A613C36-A54B-53A4-B662-40EEA45FABD4":{"t":"قالت نظرتَ إلى غيري فقلتُ لها","p":101,"s":"قالت نظرت إلى غيري فقلت لها","r":"477567","v":[["93209141-2F68-5551-BDE1-D2F2DD9C4BD6","قالت نظرتَ إلى غيري فقلتُ لها","وماء الدمعِ من عيني محدورُ"],["BC5CCBAC-11B6-5FD6-B6E3-11D8E5A2F8CF","نفسي فداؤك طرفُ العين مشتركٌ","والقلبُ مني عليك الدهرَ مقصورُ"],["84416743-43CB-51A3-9B4C-2A01185F85A8","العينُ تنظرُ أحياناً وباطنهُ","مما يقاسي يظهرِ الغيبِ مستورُ"]]},"8976AE3E-A17C-57BF-94E0-2028ABBCFA02":{"t":"قد تغدى الملك المأ","p":101,"s":"قد تغدى الملك المأ","r":"477595","v":[["9B9DD233-BDFD-5459-B515-DBE6E51C067E","قد تغدى الملك المأ","مون من قبلِ الزوالِ"],["806E4587-533C-54D5-8563-9DFAFB0C651C","ودعا بالراح إذ صح","له فقد الهلالِ"],["C57605D1-5C76-53B7-A827-F744EF79A8CC","وعليَّ لك خمسٌ","من مصابيح الضلالِ"],["C2B7BA68-A953-5152-994E-20C2A2EA653A","فاسعَ باللهِ إلى","عمكَ من غيرِ مطالِ"]]},"932BED3F-B2B8-5D35-BC2F-01D8D8813752":{"t":"قد شابَ رأسي ورأسُ الحرص لم يشب","p":101,"s":"قد شاب رأسي ورأس الحرص لم يشب","r":"477545","v":[["4DC1D5E6-5C03-56AF-9139-D71E23E8F609","قد شابَ رأسي ورأسُ الحرص لم يشب","إن الحريص على الدنيا لفي تعب"],["50E5C7B3-8271-5D78-8921-CF40B5190833","ما لي أراني إذا طالبت مرتبةً","فنلتها طمحت عيني إلى رتب"],["A1D6FCA2-D7EB-5295-A475-5247BA2768FC","قد ينبغي لي مع ما حزت من أدبٍ","أن لا أخوضَ في أمرٍ ينقص بي"],["6477E86A-6607-5C80-BC0D-57FF2C77FADA","لو كان يصدقني دهري بفكرته","ما اشتد غمي على الدنيا ولا نصبي"],["838E97D7-AA23-5F90-9CAD-6AE38FDB1B72","أسعى وأجهدُ فيما لست أدركهُ","والموتُ يكدحُ في زندي وفي عصبي"],["21E79D1D-0E14-59FE-A90A-6A06413968B1","بالله ربك كم بيتٍ مررت به","قد كان يغمرُ باللذات والطربِ"],["4ACD6CC1-5A23-5508-AC59-B6896500B1D4","طارت عبابُ المنايا في جوانبه","فصارَ من بعدها للويل والحربِ"],["36202C8C-0D22-5D6F-A4F6-45D107630429","فامسك عنانكَ لا تجمع به طلعٌ","فلا وعينكَ ما الأرزاقُ بالطلبِ"],["99525938-6986-5279-92F1-BB7144C43F61","قد يرزقُ العبدُ لم يتعب رواحلهُ","ويحرم الرزقَ من لم يوفَ من طلبِ"],["29D47B1D-6E6D-5890-99BF-B6935D30CB93","مع أنني واجدٌ في الناس واحدةً","الرزقُ والنولُ مقرونانِ في سببِ"],["0F1431EE-D819-596F-92C2-646E1E4C0249","وخطةً ليسَ فيها من بيانِ غنىً","الرزقُ أروعُ شيءٍ عن ذوي الأدبِ"],["2A4543EF-942E-5F6C-A4F5-1498745C3338","يا ثاقبَ الفهمِ كم أبصرتَ ذا حمقٍ","الرزقُ أعرى به من لازمِ الجربِ"]]},"00C664F5-5000-59AA-A935-A8032EF8F309":{"t":"قليتُ الصبى وهجرتُ الغواني","p":101,"s":"قليت الصبى وهجرت الغواني","r":"477610","v":[["B3DD5B69-C666-5948-A449-82AE77E298D8","قليتُ الصبى وهجرتُ الغواني","وسلمتُ معترفاً للزمانِ"],["1817D6F8-BE1B-582F-BB5C-D5CF9E7E38D4","وأعنقتُ منطلقاً في القيا","دِ بعدَ الجماح وجذب العنان"],["109EF945-B02A-5B26-B3C6-EC0B0EE5B2B8","كذاك الفتى وصروفُ الزما","نِ يحدثنَ شأناً له بعدَ شانِ"],["9DA103C6-3F02-53AB-A249-72A6E5AC80D7","رأيت الحياةَ ولذاتها","معلقةً بليالٍ فوانِ"],["BEDFDC4C-7035-5469-98DF-E975A49DD6D5","وإني صبورٌ لما نابني","سريعٌ إلى كل حق عراني"],["4A161206-036A-5780-9048-5C3288905E0E","وليس يُرى خائفاً من أجر","ت ولا خائباً سعيهُ من دعاني"],["FF27890D-6D14-5435-AFEC-72F83D7D35EC","ن","داني يمدحني مادحي"],["4E075176-2F31-5EEA-9706-629BBECD2F19","أحب الوفاَء إذا ما وعد","تُ وألا يعابَ بمطلٍ ضماني"],["DDA65321-335D-567E-ABEA-2C3E2688229B","كذلك عودني والداي","فعودت نفسي الذي عوداني"]]},"DCB9FC5D-3376-520F-A895-36F9F0FC7A0C":{"t":"كأسٌ كأن شعاعها","p":101,"s":"كأس كأن شعاعها","r":"477591","v":[["F003BA67-D6E3-50BD-A918-FB2505CCD141","كأسٌ كأن شعاعها","قبسٌ على شرفٍ مطل"],["41D270E6-575D-53C3-8684-234B04825F2E","ولقد ذعرت بها الظلا","مَ فبت في شمسِ وظل"]]},"3A9FABD8-E12B-5816-B4B2-54D9DB40391B":{"t":"كفناني إن مت في درع أروى","p":101,"s":"كفناني إن مت في درع أروى","r":"477534","v":[["519CD44D-BA5B-5991-804D-2B2210C2A33A","كفناني إن مت في درع أروى","واسقياني من بئر عروةَ مائي"]]},"866918AB-6290-5D6B-BBFE-D03346A0C1F2":{"t":"لا والذي تسجد الجباهُ له","p":101,"s":"لا والذي تسجد الجباه له","r":"477563","v":[["6E02FC8D-FA89-5BA8-85D2-1C197D8BC9D3","لا والذي تسجد الجباهُ له","ما لي بما دون ثوبها خبرُ"],["32C96357-E991-5AF1-9606-563F8D108EB9","ولا بغيها ولا هممت بها","ما كان إلا الحديث والنظرُ"]]},"7DE45D1A-2FEC-5980-B493-F01F27D8CA7F":{"t":"لم ألقَ بعدهمُ قوماً فأخبرهم","p":101,"s":"لم ألق بعدهم قوما فأخبرهم","r":"477598","v":[["543BD563-8558-5803-A839-D08D03706CA5","لم ألقَ بعد