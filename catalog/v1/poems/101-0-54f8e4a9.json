40C4F-6AE5-50AD-BB95-37BC1F88AC73":{"t":"ما درى الحاملونَ يوم استقلوا","p":101,"s":"ما درى الحاملون يوم استقلوا","r":"477535","v":[["6F715255-8688-58D6-8AD4-F0615D0E67DD","ما درى الحاملونَ يوم استقلوا","نعشةً للثواء أم للقاء"],["AB77BCFB-48E8-566B-90ED-86D69AA35377","فلتقل فيك باكياتٌ كما شئن","صباحاً وعند كل مساءِ"]]},"028ACBFA-6472-59EE-B670-55F29C3949B4":{"t":"ما زلتُ في سكراتِ الموتِ مطرحاً","p":101,"s":"ما زلت في سكرات الموت مطرحا","r":"477590","v":[["DFFA3370-64A6-5838-B2ED-BF7FAD35E41D","ما زلتُ في سكراتِ الموتِ مطرحاً","ضاقت علي وجوه الأرض من حيلي"],["5A0D332F-7F7B-59C6-8FE9-4029F9CA280C","فلم تزل دائباً تسعى لتنقذني","حتى اختلست حياتي من يدي أجلي"]]},"4D75B103-5E78-57B1-AEAE-784F6E91CDE0":{"t":"ما للمنازل لا تجيب حزينا","p":101,"s":"ما للمنازل لا تجيب حزينا","r":"477606","v":[["4254186D-8C4A-521B-8E1D-3C27C359B9F6","ما للمنازل لا تجيب حزينا","أصممن أم قدمَ البلى فبلينا"],["9C0E0C59-1CB3-54C1-A871-7BBA5F8E1B34","لا بل بلين فهجن داءً ساكناً","لمتيمٍ وأثرنَ منه دفينا"],["7608B02B-CBE4-5BCE-B011-0F4374BE2B6E","راحوا العشيةَ روحةً مذكورةً","إن متن متنا أو حيينَ حيينا"]]},"1B702B09-9C92-5335-B778-B0837A684709":{"t":"مضى الليل إلا أن ليلي لا يمضي","p":101,"s":"مضى الليل إلا أن ليلي لا يمضي","r":"477573","v":[["EB9B0602-D127-55DC-AF62-D1C7D154CB83","مضى الليل إلا أن ليلي لا يمضي","وأن جفوني لم ترو من الغمض"],["7BC8B909-C4C9-5160-93EC-DFADB0F23E03","إذا صد عنك الدهرُ يوماً بوجهه","تقاضاك من إحسانه سالف القرض"]]},"C642B5D1-EE1E-5CFC-B98A-2DB26FFE7961":{"t":"من تحلى شيمةً ليست له","p":101,"s":"من تحلى شيمة ليست له","r":"477551","v":[["A4C808A3-5F31-5A00-8D6D-9D21231CB01C","من تحلى شيمةً ليست له","فارقتهُ وأقامت شيمته"]]},"7E01A729-02D6-540C-9302-86A36784EECB":{"t":"من قال في الناس قالوا فيه ما فيه","p":101,"s":"من قال في الناس قالوا فيه ما فيه","r":"477619","v":[["BFBAF96A-5671-5BB7-BBD1-FA2E25D0543D","من قال في الناس قالوا فيه ما فيه","وحسبه ذاك من خزي ويكفيه"],["7B1E6AEA-DA89-5425-8452-FF42882B22BD","من نم في الناس لم تؤمن عقاربه","عن الصديق ولم تؤمن أفاعيه"],["D321CEDC-15C0-55A9-93EF-9819C73B206A","كالسيل يجري ولا يدري به أحدٌ","من أين ولا من أين يأتيه"],["88ACA011-777B-5337-A381-C1769595A5CA","لو فر من رزقه عبدٌ إلى جبلٍ","دون السماءِ لألفى رزقهُ فيه"]]},"E6C97B0C-045C-55CF-825C-B38BCC5840EE":{"t":"من لم يؤدبه والداه","p":101,"s":"من لم يؤدبه والداه","r":"477562","v":[["2CAC13FE-BC48-5C6B-B840-4B857ECA1945","من لم يؤدبه والداه","أدبه الليل والنهارُ"],["FF42AAEA-B061-5E5B-A998-DD82CE8B6158","كم قد أذلا كريمَ قومٍ","ليس له منهما انتصار"],["753B6E73-BF5B-5BE9-AC43-80AB88220D1A","من ذا يد الدهر لم تنلهُ","أو اطمأنت به الديارُ"],["1CDD09F7-C231-56AD-9C22-5B3C2F3DBDF1","كل عن الحادثات مغضٍ","وعنده للزمان ثارُ"]]},"A349C4CD-EA25-5C8E-8F0D-AE703857F3D0":{"t":"نأى آخر الأيام عنك حبيبُ","p":101,"s":"نأى آخر الأيام عنك حبيب","r":"477542","v":[["C5125DB5-D910-5E42-82FA-D149CAD342F5","نأى آخر الأيام عنك حبيبُ","فللعين سحٌ دائمٌ وغروبُ"],["35D6BCEB-AD9A-5BAA-BFE4-9BA95C4A20F9","دعته نوى لا يرتجى أوبةٌ لها","فقلبكَ مسلوبٌ وأنتَ كئيبُ"],["82A00466-22AD-5B46-82B0-409757B0983E","يؤوب إلى أوطانه كل غائبٍ","وأحمدُ في الغيابِ ليس يؤوبُ"],["F961B03D-2C09-5AF3-85E2-E47CE8137CBF","تبدل داراً غير داري وحيرةً","سواي وأحداثُ الزمان تنوبُ"],["9DE9C9E5-3EB0-5AB8-9842-0D2485C3E752","أقام بها مستوطناً غير أنه","على طول أيام المقام غريبُ"],["764C2412-BB36-583B-93E0-A4647E5CD687","وكان نصيب العين في كل لذةٍ","فأمسي وما للعين فيه نصيبُ"],["5747827D-9606-58D4-9707-963161348279","كأن لم يكن كالغصن في ميعةِ الضحى","سقاه الندى فاهتز وهو رطيبُ"],["B26E1FEF-9E5C-57F5-AF74-2347966F1C6A","كأن لم يكن كالصقر أوفى بشامخ","الذرى وهو يقظان الفؤاد طلوبُ"],["6FAF7D6E-1BFE-5CC9-8DAC-406B793A91B3","كأن لم يكن كالرمح يعدل صدره","غداة الطعان لهدمٌ وكعوبُ"],["ACEF0421-B0F3-5408-81FF-E119A83BF468","يغض الحديدَ المحكمَ النسج حده","ويبدو وراء القرن وهو خضيبُ"],["DD7BB464-525E-5A79-ADDF-F4FB787DFBC9","كأن لم يكن كالدر يلمع نورهُ","بأصدافه لما تشنه ثقوبُ"],["CE980130-64A2-5C31-9831-C5C3F586D532","كأن لم يكن زين الغناء ومعقلَ","النساء إذا يومٌ يكونُ عصيبُ"],["EA9BFDEC-B588-5354-AF6F-33C781083655","وريحان صدري كان حين أشمه","ومؤنس قصري كان حين أغيبُ"],["9A53D843-4E64-5072-AA83-ED9A047DB234","كأني منه كنت في نوم حالم","نفى لذة الأحلام عنه هبوبُ"],["115A9AFA-F475-5185-A825-CE750A24DCEA","وكانت يدي ملأى به ثم أصبحت","بحمدٍ إلهي وهي منه سليبُ"],["62472E7F-ADC9-5D53-B250-979CCF139548","قليلاً من الأيام لم يرو ناظري","بها منه حتى أعلقته شعوبُ"],["FE79F7DB-D892-54E9-9E5F-7526CD946193","كظل سحابٍ لم يقم غير ساعةٍ","إلى أن أطاحته فطاح جنوبُ"],["215D8AEF-2E5C-5C4E-A6A2-EC969E778A4E","أو الشمس لما من غمامٍ تحسرت","مساءً وقد ولت وحان غروبُ"],["A3CB81DD-E86C-5EE1-902E-811359E69861","سأبكيك ما أبقت دموعي والبكى","بعيني ماءً يا بني يجيبُ"],["AAF0237D-06A5-519B-ADEC-1510CEB305AA","وما غار نجمٌ أو تغنت حمامةٌ","أو اخضر في فرع الأراك قضيبُ"],["51AE6521-93D1-5174-8272-C8FE99CCEEB3","حياتي ما دامت حياتي فإن أمت","ثويتُ وفي قلبي عليك ندوبُ"],["9C82D0E8-FA27-5D33-9BA4-358DBA5E3826","وأضمر إن أنغدت دمعي لوعةً","عليك لها تحتَ الضلوعِ وجيبُ"],["060726A3-AF87-5F9A-9647-1D2C3707EC14","دعوت أطباء العراق فلم يصب","دواءك منهم في البلاد طبيبُ"],["6F720270-047B-5E21-8B40-1F4CAEF11138","ولم يملك الآسونَ دفعاً لمهجةٍ","عليها لإشراك المنون رقيبُ"],["8EDFF2DE-4C68-50F5-B668-C07E43FF6F55","قصمت جناحي بعدما هد منكبي","أخوك فرأسي قد علاه مشيبُ"],["BE95759E-51E2-52C6-9FB1-92E774F191F4","فأصبحتُ في الهلاكِ إلا حشاشةً","تذابُ بنارِ الحزنِ فهيَ تذوبُ"],["BBD8D87C-81FA-59EA-B9B5-80896921B44E","توليتما في حقبةٍ فتركتما","صدى يتولى تارةً ويثوبُ"],["960BE34C-919A-5A0B-A35B-13F3A8928CC7","فلا ميت إلا دون رزئك رزؤه","ولو فتتت حزناً عليه قلوبُ"],["1627CA3F-3660-55B5-A205-7D256BBCD4AF","وإني وإن قدمت قبلي لعالمٌ","بأني وإن أبطأت منك قريبُ"],["D330BD3B-F658-595B-A853-6A52FD093398","وإن صباحاً نلتقي في مسائه","صباحٌ إلى قلبي الغداةَ حبيبُ"],["A232F241-3B57-5317-A277-57AD5E47E9D0","وعسى الذي أهدى ليوسف أهله","وأعزه في السجن وهو غريبُ"],["55167E62-9842-54A5-AD63-57D9C4F92C65","أن يستجيب لنا فيجمع شملنا","فالله رب العالمين قريبُ"]]},"C0A8A9CA-1925-5A23-8C6D-705FA4124F1E":{"t":"هتكت الضمير برد اللطف","p":101,"s":"هتكت الضمير برد اللطف","r":"477575","v":[["14358C49-7697-5A30-BD98-1AE53E38E567","هتكت الضمير برد اللطف","وكشفت هجرك لي فانكشف"],["87FD43CC-915C-55FD-91DE-B72A8C2942F2","وإن كنت تنكرُ شيئاً جرى","فهب للخلافة ما قد سلف"],["23F06146-C814-5EC4-918A-BDBC80BE5279","وجد لي بصفحك عن زلتي","فبالفضل يأخذ أهل الشرف"]]},"D977E985-8248-5615-A633-CC4CD523DBC4":{"t":"هديتي تقصرُ عن همتي","p":101,"s":"هديتي تقصر عن همتي","r":"477593","v":[["97582616-E437-5AA7-B2C1-ED09FDBE228E","هديتي تقصرُ عن همتي","وهمتي تعلو على مالي"],["8787922E-373A-52C7-99B7-712957821B66","وخالصُ الود ومحضُ الهوى","أحسنُ ما يهديه أمثالي"]]},"D3B99F2A-71D7-5941-9978-5F8AC8625498":{"t":"هذا محبك مطويٌّ على كمده","p":101,"s":"هذا محبك مطوي على كمده","r":"477558","v":[["2F592697-0CF1-5645-8121-8A20EF2DB700","هذا محبك مطويٌّ على كمده","وجداً مدامعهُ تجري على جسده"],["7D7B7DDD-E709-5AE0-B0E8-4560C53A4625","له يدٌ تسأل الرحمنَ رحمتهُ","بما به ويدٌ أخرى على كبده"],["C3EEB847-A69F-53CF-AF06-32EE93EE65E1","يا من رأى كلفاً مستعبداً دنفاً","كانت منيتهُ في عينه ويده"]]},"BA9CAD8B-C3CF-5D2B-909F-69E97E81C2B6":{"t":"هم هيجوا الحرب واسم الحرب قد علموا","p":101,"s":"هم هيجوا الحرب واسم الحرب قد علموا","r":"477544","v":[["3CDD01AF-BF41-5F73-92AD-67DB6435C2EE","هم هيجوا الحرب واسم الحرب قد علموا","لو ينفع العلم مشتقٌ من الحربِ"]]},"4C8B87F0-88FC-5E6C-8B16-0F3B8382E355":{"t":"هو الحر أخلاقاً وبراً وشيمةً","p":101,"s":"هو الحر أخلاقا وبرا وشيمة","r":"477582","v":[["F71C5443-5AE3-5F3A-A6A6-BF464CE00222","هو الحر أخلاقاً وبراً وشيمةً","وعقلاً وخيرُ القومِ من أوتيَ العقلا"],["2FF7054B-4A08-5514-8E7E-9FD9C2994BF6","تراه طليقاً وجههُ متهللاً","كأن صقيلاً من عوارضهِ يجلى"]]},"FA058089-1424-5D0F-B2F9-C81BB226A457":{"t":"هي المقادير تجري في أعنتها","p":101,"s":"هي المقادير تجري في أعنتها","r":"477587","v":[["A24B7210-7A76-571C-9306-1552017C6BD6","هي المقادير تجري في أعنتها","فاصبر فليس لها صبرٌ على حال"],["9E324B52-A7EA-5380-B5DB-21A8B3404E40","يوماً تُريكَ خسيس الأصلِ ترفعُهُ","إلى العلاءِ ويوماً تخفضُ العالي"]]},"72C26FD0-4B34-531E-B151-7C3B71BBB2CA":{"t":"هيف الخصورِ قواصدُ النبلِ","p":101,"s":"هيف الخصور قواصد النبل","r":"477589","v":[["AEAEF085-69C2-51EA-A836-30FE6DD98D7B","هيف الخصورِ قواصدُ النبلِ","قتلننا بنواظرٍ نجلِ"],["EDE88CF9-539F-5F6C-B07C-2576ADB214CB","كحل الجمال جفونَ أعينها","فغنين عن كحلٍ بلا كحلِ"]]},"BC5533E2-EE2F-5EA6-A278-F4E7946DC604":{"t":"وإني وواهي ملككم مثل سائقٍ","p":101,"s":"وإني وواهي ملككم مثل سائق","r":"477538","v":[["FC1735F6-DE4F-5884-B799-8B6492C6D7BD","وإني وواهي ملككم مثل سائقٍ","طليحاً يزجيها على الأين راكبُ"],["E863AE3F-68D7-500A-A35D-C476DD4804D5","إذا صدقتني النفس عنكم تقول لي","أتدري هداك الله من ذا تعاتبُ"],["41CEE0F3-9648-5A89-A56E-14FCB602C9BB","فوالله ما أدري إذا ما ذكرتكم","أأعفو لكم عن ذنبكم أم أعاقب"],["D02E21E5-DC98-5A7D-A61B-CAF58ED09BF4","بلى ليس لي إلا تغمد ذنبكم","وإن لم يكن فيكم من الذنب تائبُ"],["19FD735E-4138-5091-9C34-9127FC284707","وإني وأمي أمكم وأبي لكم","أب عنكم لي لو أردت مذاهبُ"]]},"E3AD0049-6CA0-55C6-B63F-FB8C00F87BB2":{"t":"وتخبرني عن قلبها فكأنها","p":101,"s":"وتخبرني عن قلبها فكأنها","r":"477543","v":[["50914B99-9B17-5DD0-B437-5A33574D4525","وتخبرني عن قلبها فكأنها","إذا صدقت عنه تحدث عن قلبي"]]},"9EF723D6-78EC-514E-BCEF-552D973CD70E":{"t":"وراَء مضيقِ الخوفِ متسعُ الأمنِ","p":101,"s":"وراء مضيق الخوف متسع الأمن","r":"477612","v":[["9347A4A7-7720-58C3-8459-C96B3D56A1F1","وراَء مضيقِ الخوفِ متسعُ الأمنِ","وأولُ مفروحٍ به آخرُ الحزنِ"],["0AA12926-B71E-5AE7-BABB-1A658951D330","فلا تيأسن فاللهُ ملكَ يوسفاً","خزائنهُ بعد الخلاصِ من السجنِ"]]},"101E3F64-C666-54A4-841E-F41421EE6D97":{"t":"وقائل لست بالمحب ولو","p":101,"s":"وقائل لست بالمحب ولو","r":"477611","v":[["69F5205E-B70D-5B54-9B80-6EB8BB2A3843","وقائل لست بالمحب ولو","كنتَ محباً لذبتَ من زمنِ"],["02BA93A5-F035-5E99-944B-EA2FC7251640","يحب قلبي وما درى بدني","ولو درى لم يقم على السمن"]]},"76720495-5DBB-5F98-86D1-442F8DFF4809":{"t":"وقد يصدق السيفُ يوم الوغى","p":101,"s":"وقد يصدق السيف يوم الوغى","r":"477536","v":[["41BC793F-A5D2-5AAB-8E20-F78C3B84EE41","وقد يصدق السيفُ يوم الوغى","أخاه وإن كان رث القراب"],["C1BD5968-B1D7-50B6-B798-F8D1A80777D0","كأن سنا بارقٍ مستطيرٍ","بين ذؤابته والذباب"],["DB355530-9430-5A9F-8DCA-7F948053E9D0","كذاك الرجال يكون الفتى","صليباً وذو الشيب صلب النصاب"]]},"7C89462D-D5A4-5083-B99A-7D939BE73AF4":{"t":"وقد يلينُ ببعض القولِ يبذلهُ","p":101,"s":"وقد يلين ببعض القول يبذله","r":"477620","v":[["3D2CCBAB-56FF-5342-A7FC-EFF0AE6400FC","وقد يلينُ ببعض القولِ يبذلهُ","والوصلُ في وزرٍ صعبٌ مراقيه"],["FE5DBC80-5E53-5AB3-A36D-E4208A4346A7","فالخيزرانُ منيعٌ منك مكسرهُ","وقد يرى ليناً في كف لاويه"],["96CAF777-DD1F-517C-A516-576CCBB8D6B5","فتلك هم فؤادٍ أنت صاحبهُ","لو أنها مرةً كانت تجازيه"],["0534A523-0678-5E89-A053-974B7207FAC2","وإن في طول ما ضنت عليه لما","يسليه لو أن شيئاً كان يسليه"]]},"1B8ACE3E-169F-5082-870F-24175F2790EC":{"t":"ولستُ بواصفٍ أبداً حبيباً","p":101,"s":"ولست بواصف أبدا حبيبا","r":"477594","v":[["01A1C661-205A-5643-A205-8CA03459A86C","ولستُ بواصفٍ أبداً حبيباً","أعرضهُ لأهواءِ الرجالِ"],["86A2E70F-CF54-5C33-8EDD-B318EF52D2A5","وما بالي أشوقُ قلبَ غيري","إليه ودونه سترُ الحجالِ"],["79F0DCDE-E307-5CF1-85AD-3A8424BEE1DA","كأني أشتهي الشركاَء فيه","وآمنُ فيه إحداثَ الليالي"]]},"56443EB8-CD93-55F2-9976-08D05CBD4230":{"t":"وليس بتزويقِ اللسانِ وصوغه","p":101,"s":"وليس بتزويق اللسان وصوغه","r":"477596","v":[["850E7DAD-18D2-5696-B267-C9EBC1407BA5","وليس بتزويقِ اللسانِ وصوغه","ولكنه قد خالط اللحمَ والدما"]]},"A9AA8486-8C01-5E71-99DC-124C271BD535":{"t":"وما المرءُ في ذنياهُ إلا كهاجع","p":101,"s":"وما المرء في ذنياه إلا كهاجع","r":"477601","v":[["B856063B-5CBA-50CB-ABC7-F4C33E64F1FC","وما المرءُ في ذنياهُ إلا كهاجع","رأى في غرار النومِ أضغاثَ أحلامِ"]]},"C91BBC11-74E0-5C02-9EEC-7FD907CC464D":{"t":"ونهيتَ نومي عن جفوني فانتهى","p":101,"s":"ونهيت نومي عن جفوني فانتهى","r":"477581","v":[["110EF2B2-76AC-51A7-A5B1-D32025158F57","ونهيتَ نومي عن جفوني فانتهى","وأمرتَ ليلي أن يطولا فطالا"],["F0D55F43-D64E-5740-A123-51CD413AD79D","نظرُ العيونِ على العيونِ هو الذي","جعلَ العيونَ على العيونِ وبالا"]]},"6451020C-D9DA-585D-B9DA-6AC5B7FEC974":{"t":"يا أمير المؤمنين","p":101,"s":"يا أمير المؤمنين","r":"477561","v":[["6B14F8D9-8D8B-5EE6-BDDC-851E1B056C52","يا أمير المؤمنين","الحمد لله كثيرا"],["0CD233AC-E1CA-563D-9366-C4D48F1F30FA","هكذا النصر فلا زا","ل لك الله نصيرا"],["970CBDD2-03E1-59BD-B390-4F08A9F95AF1","وعلى الأعداء أعط","يت من الله ظهيرا"],["57BCEDA4-BB56-5F5A-8137-0CA1F0336FF4","وهنيئاً هيأ الله","لك الفتح الخطيرا"],["BCBB8F17-627E-588B-ABB9-EC9B99BE4A3F","وهو فتحٌ لم ير النا","س له فتحاً نظيرا"],["3754CA1B-3108-5C8B-85BF-66CCE40E4E2D","وجزى الأفشين عبداً","لله خيراً وحبورا"],["121C0B1A-D457-54B1-9566-8661C0A30BAB","فلقد لاقى به با","بك يوماً قمطريرا"],["FCEC243E-DE37-5330-ADA0-FFD0AD9484DF","ذاك مولاك الذي أل","فيته جلداً صبورا"],["24165F32-D554-5B44-BACC-9FD5ED523B7C","لك حتى ضرج السي","ف له خداً نضيرا"],["DFAC260D-C19E-5F23-AE76-5401717E1634","ضربةً أبقت على الد","هرِ له في الوجه نورا"],["F2438968-45E8-571B-ACE0-FBB740B6C014","جدد الحب بلايا","أمرها ليس عسيرا"],["76C4DABB-E62E-5CF8-BDEA-0DB6439A444D","كبر الحب وقدماً","كان إذ حل صغيرا"],["9F451D94-1E1C-5B76-A971-AC3D88D29105","ذلل الحب رقاباً","كان أدناها عسيرا"],["2DF299F1-3D4B-594F-B831-37DD185119EE","ليس لي من حب إلفي","غير حرماني السرورا"]]},"9F2AC488-0AF8-59D4-BF3F-A5FD430B029D":{"t":"يا أيها المتشاوس المتغاضب","p":101,"s":"يا أيها المتشاوس المتغاضب","r":"477539","v":[["A17C4A6F-B54F-5142-B2B6-396B6843D4CC","يا أيها المتشاوس المتغاضب","المعرض الجاني العبوسُ القاطِبُ"],["2B1DEFC4-4FA5-5884-B39B-5F8E809178AB","لا أنت لي سلمٌ فتنصرني ولا","حربٌ إذا نصب العدو مناصبُ"],["B6955647-50D0-59F3-B322-C0D144666B43","قلب الزمان هواك عن منهاجه","إن الزمان لكل حالٍ قالبُ"]]},"32955C69-3E0B-50D0-944C-CCB4106B4FBB":{"t":"يا بؤسَ يومٍ كاسفٍ","p":101,"s":"يا بؤس يوم كاسف","r":"477559","v":[["1BD2DFCA-E3BF-58F7-A964-F4EA5D1C12DC","يا بؤسَ يومٍ كاسفٍ","إن لم يغير في غده"],["3C33440F-1544-5690-BC22-8491A33DDCDB","لأمةٍ وزيرها","عاصرُ زيتٍ بيده"],["19198A85-E6D1-5266-B955-318F14AE2B89","يظهرُ نصحاً وجههُ","وغشهُ في كبده"]]},"41028426-2D3B-5B68-B0D4-1E5BE1CFD379":{"t":"يا طولَ علةِ قلبي المعتادِ","p":101,"s":"يا طول علة قلبي المعتاد","r":"477557","v":[["29BC4A4E-1BAF-51C8-855D-7BE693E85CF0","يا طولَ علةِ قلبي المعتادِ","إلف الكرامِ وصحبةَ الأمجادِ"],["595BE3C2-710F-5E19-B9BD-D1D2E97D888D","ما زلتُ ألفَ كل قرمٍ ماجدٍ","متقدمِ الآباء والأجداد"]]},"392C784B-3088-5F8E-A516-56347F820604":{"t":"يا عائبي عند أعدائي ليرضيهم","p":101,"s":"يا عائبي عند أعدائي ليرضيهم","r":"477564","v":[["4C65C420-2611-52E4-9767-B6264DD6F0A9","يا عائبي عند أعدائي ليرضيهم","وبائعي بيسيرٍ ماله خطرُ"],["4455FC71-5B31-5528-95FB-653CC9667FBC","أظهرتَ أنكَ لا أنتَ العدو ولا","أنت الولي الذي يصفى ويدخرُ"],["3ADCB139-8A14-5B4A-AE7D-441DDB7C02C4","فما تحولُ من سلمى ولا أجأ","ركنٌ ولا خسفت شمسٌ ولا قمر"]]},"4A56D2C4-A502-56A0-A67E-2CC957C335BA":{"t":"يا غزالاً لي إليه","p":101,"s":"يا غزالا لي إليه","r":"477618","v":[["C269BA0C-1F1F-56B6-9A17-2F03BD034EA9","يا غزالاً لي إليه","شافعٌ من مقلتيه"],["E218A749-1E13-5270-8E61-26EE9D371BE2","بأبي من أنا مأسور","بلا أسرٍ لديه"],["5EC192EE-0FFC-5A48-9E38-7979E433374D","والذي أجللت خد","يه فقبلت يديه"],["7F655E7A-A03D-58F9-8000-47B94D13FF57","والذي يقتلني ظل","ماً ولا يعدى عليه"],["5B34DD95-5126-5ECC-AF8B-87A47A6F6A84","بأبي وجهكَ ما أك","ثر حسادي عليه"],["A4C668CF-1096-53CC-A4F2-5EB1E64153CB","أنا ضيفٌ وجزاءُ","الضيف إحسانٌ إليهِ"]]},"9ADFE686-A6BB-5DAA-877C-CEE4B5573B99":{"t":"يا غيرةَ الله قد عاينت فانتقمي","p":101,"s":"يا غيرة الله قد عاينت فانتقمي","r":"477540","v":[["2BF7F163-0AF0-50D6-9C77-27391AEE0EA5","يا غيرةَ الله قد عاينت فانتقمي","تلك النساءُ وما منهن يرتكبُ"],["F45CDF23-EEBB-5110-9110-B8854FC62A39","هب الرجالَ على أجرامها قتلت","ما بال أطفالها بالذبح تنتهب"]]},"F48F7A40-A1F9-50A5-A74B-BBCBA17EF91A":{"t":"يا من لقلبٍ صيغَ من صخرةٍ","p":101,"s":"يا من لقلب صيغ من صخرة","r":"477546","v":[["0EAF3154-68D0-5C29-9754-60A21891C345","يا من لقلبٍ صيغَ من صخرةٍ","في جسدٍ من لؤلؤٍ رطبِ"],["D3EDBAEF-3DCD-582B-80D4-39DABBA793F0","جرحتُ خديهِ بلحظي فما","برحتُ حتى اقتص من قلبي"],["BDF0BA9D-FDB4-5FD6-A05D-2574BD4DB7D2","إن كنت عبداً فنفسي حرة كرماً","أو أسود اللون إني أبيض الخلقِ"]]},"5600EDA9-D7F0-5336-9202-9760D30CBBD7":{"t":"يا منزلاً لم تبل أطلاله","p":101,"s":"يا منزلا لم تبل أطلاله","r":"477583","v":[["4021FB88-4D87-58DB-9628-09EFD5F1D01F","يا منزلاً لم تبل أطلاله","حاشا لأطلالك أن تبلى"],["CA85C674-BAC4-517D-837B-6F1748311945","لم أبك أطلالك لكنني","بكيت عيشي فيك إذ ولى"],["F5E77556-3A1E-547E-B4C1-4BBEC37A5777","والعيشُ أولى ما بكاهُ الفتى","لا بد للمحزون أن يسلى"]]}}}