{"v":1,"poems":{"123601F7-574E-5EBA-86C4-E5EB9737CBD8":{"t":"أبا قاسمٍ إني أراكَ ضبابةً","p":101,"s":"أبا قاسم إني أراك ضبابة","r":"477603","v":[["6AB14F3C-87CC-56B4-8F23-1A9DA0D8BFC2","أبا قاسمٍ إني أراكَ ضبابةً","كأنكَ من لحمي خلقتَ ومن دمي"],["1ACEC866-9794-5FEC-9602-91A0B2491E61","وإني لأهوى أن أرب صنيعةً","إليك بآلاءِ كرامٍ وأنعمِ"],["C5B4FBBC-C24F-584A-B5A8-72C8C0AC4CAA","أيادي كريمٍ طيبِ النفسِ بعدها","إذا ما الأيادي أتبعت بالتندم"]]},"8ABE4E9C-2727-574D-9D00-4B7B9D2571A6":{"t":"أتيتُ ذنباً عظيماً","p":101,"s":"أتيت ذنبا عظيما","r":"477586","v":[["C01C3490-869E-566B-8E3D-0DB9415EF1B6","أتيتُ ذنباً عظيماً","وأنتَ للعفوِ أهلُ"],["D8039129-1EFB-5053-BB67-543870038631","فإن عفوتَ فمنٌّ","وإن جزيتَ فعدلُ"]]},"523AAFF8-B0EF-578A-AA0D-EEEECADBEECD":{"t":"أراه في فعله عدواً","p":101,"s":"أراه في فعله عدوا","r":"477577","v":[["77734BA9-2F07-5181-93AD-5BB1FB6B111B","أراه في فعله عدواً","وكنتُ أعتدهُ صديقا"],["84D17035-80C9-549F-B7CC-EFD655A4F450","صيرَ عذبَ الشرابِ مراً","وزادَ ضيقَ الحياةِ ضيقا"]]},"3280159D-6D93-5B28-A015-0E8D238EA5C2":{"t":"أرى الحر عبداً للذي سيبُ كفهِ","p":101,"s":"أرى الحر عبدا للذي سيب كفه","r":"477556","v":[["74BB42B1-8D74-5BD3-B631-F255E4F58DBC","أرى الحر عبداً للذي سيبُ كفهِ","شراهُ بما قد غاظهُ غايةَ الحمدِ"],["BD408996-4F94-5247-BBDF-850B3682CBE7","على أن ملكَ الحر أسنى ذريعةً","إلى المجد من مالٍ يصانُ ومن عبدِ"],["598AC733-E0C8-5CB4-B09D-7B7F25598C47","وإن خص بيعُ ملكِ حر بنعمةٍ","إذا قوبلت بالشكر قارنها المجدُ"]]},"8BCD85B9-2B66-544A-B334-3B50462CE54A":{"t":"أضَن على ليلي وليلى سخيةٌ","p":101,"s":"أضن على ليلي وليلى سخية","r":"477555","v":[["25503622-22E7-5A8C-B80D-263AE5C1388E","أضَن على ليلي وليلى سخيةٌ","وتبخل عني بالهوى وأجود"],["AB5A78C7-9944-5835-9589-A67E7E9D1443","وأنهى فلا ألوي على لوم لائم","وأعلمُ أني مخطئٌ فأعودُ"]]},"4D58E680-35FE-5ED2-9F11-7F29D8F47A4F":{"t":"أطعتَ الهوى وعصيتَ الرشد","p":101,"s":"أطعت الهوى وعصيت الرشد","r":"477554","v":[["AB3BF7BF-146E-5145-8807-BD01A2EAAC92","أطعتَ الهوى وعصيتَ الرشد","ولم تملكِ الصبرَ عمن تود"],["9A53BAEC-9822-58B7-91E8-99A3DCE31B87","إذا الليل أسبل سرباله","على الأرض واسود وجه البلد"],["D4598822-CB33-534D-9358-91647E3D0DCB","رعيت الكواكبَ حتى الصباح","ودمعي كاللؤلؤ المنسرد"],["2D734C0A-337C-552E-9588-67558F32B06A","فمن ظالعات ومن غائراتٍ","وآخرَ في حيرةٍ قد رقد"],["E0FF46AB-42FC-5895-964A-4FC2E285E259","ومن ضاجعاتٍ بأفقِ المغيب","يراقبها كارتقابِ الرصد"],["10B697D7-8D69-5505-A67C-0B482FDB6836","وما الناسُ إلا عدوُّ الشقي","وإلا صديقُ امرئٍ قد سعد"],["7A2FF52D-6779-5C75-838E-F3CBC36D9144","إذا ما الزمانُ بأخلافه","طواكَ كطيِّ الثيابِ الجدُد"],["4C5D920A-4D05-5A51-93C6-9CDCEDB4A625","يفيضُ عليكَ قداحَ الردى","لتأخذَ منها بقدح نكد"],["303A1521-8550-5124-A6E1-9EB097964ED3","فما أنت إلا أسير له","وإن أمكن الحيد عنه فحد"],["124173D0-134A-530C-B56A-70A01F28F0F8","هب الدهر لم يتحامل على","سواك فهل لك منه القود"],["90D10515-471F-5995-9AD2-C23C6E5FA1B0","وإن يسقك اليوم من آجنٍ","صرى لا يذاقُ ولا يزدرد"],["B54F92F9-D1A6-50E8-91C2-8228582F6567","فقد كان يسقيك من صفوه","نطافَ الغوادي بذوبِ الشهد"],["2F7650CF-02C7-54E8-BEA2-1B5A034A5F16","كذاك تجيء صروفُ الزمان","على ما أردت وما لم ترد"],["85A417B2-F4AA-5ED1-BA5F-A920DEDF161D","وقد يسبقُ الفوتُ وشكَ العجولِ","ويدركُ حاجتهُ المتئد"],["240F823D-AA58-5DE3-AB4C-6E55434C79A6","وإن خلط الدهرُ فاصبر على","تلونهِ فمع اليوم غد"],["1B75DC03-ACCB-50A2-B858-5F31078A8721","عذاري الغداةَ من الأطيبين","أهل القباب الطوال العمد"],["DAD95457-BA1B-513D-90A2-62ADB16EB567","من آل أبي الفضل عم النبيِّ","وجدي فأكرم بعم وجد"]]},"2030F968-3197-5367-B8F5-E6A53383BF87":{"t":"أعنيكَ يا خيرَ من تعنى بمؤتلفِ","p":101,"s":"أعنيك يا خير من تعنى بمؤتلف","r":"477604","v":[["B34E1DEF-1E0A-5A23-800B-122AF4D1E4C4","أعنيكَ يا خيرَ من تعنى بمؤتلفِ","من الثناءِ ائتلافَ الدر في النظمِ"],["92071943-BC25-5936-9368-193488A10BBA","أثني عليكَ بما جددتَ من نعم","وما شكرتك إن لم أثنِ بالنعمِ"],["7939DDAE-75CE-5484-9F8D-6DEE6F112F29","البر بي منك وطا العذرَ عندك لي","دون اعتذاري فلم تعذل ولم تلم"],["E87B43C2-366D-5024-A610-BC24C3F0F9F7","وقام علمك بي فاحتج عنك لي","مقام شاهدِ عدلٍ غير متهمِ"],["A0FB252F-5288-5C22-9934-E9AD9FD023B5","رددت مالي ولم تمنن علي به","وقبل ردك ما لي قد حقنت دمي"],["2150CBB1-44BF-5463-9DA6-E98AACD27B9D","تعفو بعدلٍ وتسطو إن سطوتَ به","فلا عدمناك من عافٍ ومنتقم"],["E414DF26-B826-54C5-8EF3-FB3174562A43","فبؤت منك وقد كافأتها بيدٍ","هي الحياتان من موتٍ ومن عدم"],["49E4C4D1-881E-5A27-8361-FE43DC7CE2B5","لئن جحدتك معروفاً مننت به","إني لفي اللؤم أحظى منك في الكرمِ"],["EA578FE1-3876-5D7D-A209-592A5BCD29A4","فلو بذلتُ دمي أبغي رضاك به","والمالَ حتى أسلَّ النعلَ من قدمي"],["4AE4BC91-D1CE-550F-A3D4-BD9B15765F0C","ما كان ذاك سوى عاريةٍ رجعت","إليكَ لو لم تهبها كنتَ لم تلمِ"]]},"154EC92E-D879-585C-BF68-9CA07E6B5BDA":{"t":"أفي العدلِ أن نمسي ولا تذكرينني","p":101,"s":"أفي العدل أن نمسي ولا تذكرينني","r":"477597","v":[["00433703-7BC1-5ECF-BD4B-A5B2F9EF7AE0","أفي العدلِ أن نمسي ولا تذكرينني","وقد سفحت عيناي في ذكرك الدما"],["4C62C406-9F2D-5313-A004-A5A2A2897249","إلى الله أشكو بخلها وسماحتي","لها عسلٌ مني وتبذلُ علقما"],["416690AF-B7C0-55EA-9ED9-7D4AD5440D8E","فردي مصابَ القلبِ أنتِ سلبتهِ","ولا تتركيهِ ذاهلَ القلبِ مغرَما"],["84B97DE0-C022-5E04-A39A-14F54A096F87","إلى اللَه أشكو أنها أجنبيةٌ","وإني لها ماعشتُ وداً محرما"]]},"46BF54E4-8932-5039-A030-D6B5F868A631":{"t":"ألم تعلمي يا آل فهرِ بن مالكِ","p":101,"s":"ألم تعلمي يا آل فهر بن مالك","r":"477580","v":[["1A4FE62A-04B4-506A-B6F0-F6705BAF31C8","ألم تعلمي يا آل فهرِ بن مالكِ","رميتُ بنفسي دونكم في المهالك"],["FF87BBB7-DC63-54F1-84F4-640E3897DC74","بلى فاعلمي يا آل فهر بأنني","أخوكِ الذي أعطاكِ حقَّ إخائك"],["DB7E97FB-10AF-5BF9-8EF9-6CEE05AB8D4C","أخوك الذي يقري عدوك صارماً","حساماً ويقري درهُ في شفائك"],["2AA22972-6291-5D5A-91F7-CED2E440573F","أجودُ بمالي دونَ مالكِ تارةً","وطوراً أقيمُ الغرَّ تحتَ لوائك"]]},"911B538F-C57B-5BBA-9F91-1430848382DB":{"t":"أنا أفدي على الهجران زينا","p":101,"s":"أنا أفدي على الهجران زينا","r":"477607","v":[["08F1C6B9-8A37-585A-9899-002C17789297","أنا أفدي على الهجران زينا","وإن كنا على عمدٍ كنينا"],["D5A1751E-E7CB-5170-A519-2BBA162663BD","وما زيناً بتغذيةٍ أردنا","ولكنا عنينا من عنينا"],["3504C6A8-B46B-5C57-9605-77FE840C752C","أقول وقد رأيتُ لها سماءً","من الهجرانِ مقبلةً إلينا"],["B7192111-6FC7-5E8B-AB58-37E7DA3C4A4D","وقد سحت عزاليها بصدٍّ","حوالينا الصدودُ ولا علينا"]]},"F41EE500-269B-5E98-9F82-1224728AC6C6":{"t":"أنتَ امرؤٌ متجن","p":101,"s":"أنت امرؤ متجن","r":"477614","v":[["33397245-D86D-5C85-BBB3-6E4E88474574","أنتَ امرؤٌ متجن","ولست بالغضبان"],["4D3797A9-5117-53D4-AB8E-82145C2D4271","هبني أسأتُ فهلا","مننت بالغفران"]]},"2CB6F71A-92F4-57CA-B35F-EA318993CE7A":{"t":"أيا منعماً لم تزل مفضلاً","p":101,"s":"أيا منعما لم تزل مفضلا","r":"477599","v":[["6ECAF375-68AB-513D-9E7B-F85EEBCB71AA","أيا منعماً لم تزل مفضلاً","إدامَ الضنى سخطك الدائمُ"],["F07024D9-5387-5329-921B-BFE55A4CB553","ظلمتُ فإن قلتَ لا بل ظلمتَ","فإني أنا الكاذب الآثمُ"],["D7B7B3EE-D232-5892-B9DB-D043EA430460","وأستغفر الله من زلتي","فإني من جرمها واجمُ"],["DDCC6E52-8144-5E64-A668-23770119C7F9","يفز الحليمُ ويكبو الجوادُ","وينبو لدى الضربة الصارم"],["3D5A8F00-701A-5FDF-9E23-1B9F044ECEE7","فها أناذا العائذ المستجير","فاحكم بما شئت يا حاكم"],["FE2020C6-0973-57B7-911E-6A808724F446","عصيت وتبت كما قد عصى","وتاب إلى ربه آدم"],["1D4D0433-09AF-53D2-B3C8-771973B56E87","فقل قولَ يوسفَ لا تثربن","فقد يغفرُ الغافرُ الراحمُ"],["9241B3D6-DE6A-5097-A6DD-B8C5BB6D4504","فلستُ إلى زلةٍ عائداً","يد الدهرِ ما قعدَ القائمُ"]]},"50DB7758-61E7-5BA2-AA56-DE6640BD7763":{"t":"إذا الحادثات بلغن النهى","p":101,"s":"إذا الحادثات بلغن النهى","r":"477553","v":[["86B39F7D-E4D7-52B9-BC25-ECE2D520BAF1","إذا الحادثات بلغن النهى","وكادت لهن تذوبُ المهج"],["0BD0E22D-19BB-5594-B99D-73C90005F0F5","وحل البلاء وقل العزاءُ","فعند التناهي يكونُ الفرج"]]},"5242BC73-C19A-52E9-A4F2-ABEF89DCDDD8":{"t":"إذا سالَ وادي الشيب في مفرقِ الفتى","p":101,"s":"إذا سال وادي الشيب في مفرق الفتى","r":"477602","v":[["04F25B33-998C-5D40-BCFD-D596375DCEE0","إذا سالَ وادي الشيب في مفرقِ الفتى","وقنعَ منهُ عمةَ المتلثمِ"],["0E09DEA2-DF0C-5D8A-8B0D-3706467B386D","فيا قبح ما تحكي المراةُ لعينه","ويا بعدهُ من كل عيشٍ ومنعم"]]},"28C67870-8991-5272-8533-672CA1F0A9FA":{"t":"إذا كلمتني بالعيون الفواتر","p":101,"s":"إذا كلمتني بالعيون الفواتر","r":"477569","v":[["CD032059-3DE2-5DB9-87FD-2E2813B9860E","إذا كلمتني بالعيون الفواتر","رددت عليها بالدموع البوادر"],["51739FE5-3DC6-54B1-9894-16A178D44504","فلا يعلم الواشون ما دار بيننا","وقد قضيت حاجاتنا في الضمائر"],["79B6ABE9-223D-59A9-BF41-7ECA09AF1817","أقاتلتي ظلماً بأسهم لحظها","أما حكم يعدي على طرفِ جائرِ"],["AB13CF75-1B9C-5542-878F-5D141EFCD388","فلو كان للعشاقِ قاضٍ من الهوى","إذاً لقضى بين الفؤاد وناظري"]]},"3A75F555-9843-545C-A6CA-8619F8D2B949":{"t":"إن أكن مذنباً فحظيَ أخطأتُ","p":101,"s":"إن أكن مذنبا فحظي أخطأت","r":"477548","v":[["326C0D45-A010-562D-9662-7776BF8E6B1B","إن أكن مذنباً فحظيَ أخطأتُ","فدع عنكَ كثرةَ التأنيب"],["A24317DD-80A0-58D3-8274-941FB154DAE5","قل كما قال يوسفٌ لبني","يعقوبَ لما رأوه لا تثريب"]]},"94B41C8D-8773-51F1-9B50-460CB5C3C4B7":{"t":"إن الذي عقد الذي انعقدت به","p":101,"s":"إن الذي عقد الذي انعقدت به","r":"477584","v":[["93D10592-A814-53DC-94EA-957B7F2CCD2A","إن الذي عقد الذي انعقدت به","عقدُ المكارهِ فهو يملكُ حلها"],["D64E4732-E286-55A1-9BB6-B077243EDC04","فاصبر فإن الله يعقبُ راحةً","فلعلها أن تنجلي فلعلها"]]},"0B272853-CC79-5080-A892-E6D4FA05750D":{"t":"إن المنيةِ أمهلتك عتاهي","p":101,"s":"إن المنية أمهلتك عتاهي","r":"477616","v":[["753A5795-86E5-51B2-A82A-EBD335775825","إن المنيةِ أمهلتك عتاهي","والموتُ لا يسهو وقلبكَ ساهي"],["A693E41A-0631-52FC-8E5C-013BE872F6E3","يا ويح ذا البشر الضعيف أما له","عن غيه قبل الممات تناهي"],["093F088F-735B-5338-85C1-A727FFA9560C","وكلت بالدنيا تبكيها وتن","دبها وأنت عن القيامةِ لاهي"],["E8EE134C-16F4-509F-ADC3-4E6A7D813087","العيشُ حلوٌ والمنونُ مريرةٌ","والدارُ دارُ تفاخرٍ وتباه"],["E019CA40-930F-5DDE-87CF-0D111B231423","فاجعل لنفسك دونها شغلاً ولا","تتجاهلنَّ لها فإنكَ داهي"],["C389DC30-775D-5A99-B186-96B6E6F6257D","لا يعجبنكَ أن يقالَ مفوهٌ","حسنُ البلاغةِ أو عريضُ الجاهِ"],["58501E79-F0BD-5D9E-A0E4-121CDC2DFFD0","أصلح فساداً من س