{"v":1,"poems":{"2F8FB9DA-E2EB-582F-A409-1C8F0D5C5E3E":{"t":"كأنَّ يديها بعدَ ما انضمَّ بدنها","p":68,"s":"كأن يديها بعد ما انضم بدنها","r":"438872","v":[["6E5403F0-C4DB-5507-A307-9B3D8BB49EA8","كأنَّ يديها بعدَ ما انضمَّ بدنها","وصوّبَ حادٍ بالرّكابِ يسوقُ"],["B637F810-DAEA-5039-895B-196CD1DBE6EB","يَدَا مَاتِحٍ عَجْلاَنَ رِخْوٌ مِلاَطُهُ","لهُ بكرةٌ تحتَ الرّشاءِ فلوقُ"],["4AC4D4C2-3471-5E51-835F-66833C8E4B03","مِنَ الأَثْلِ أمَّا طَلُّهَا فَهْوَ بَارِزٌ","أثيثٌ وأمّا نبتها فأنيقُ"],["25E61D34-66FE-5A28-BD10-DA8C6F99C7CA","لَهَا هَذَبَاتٌ فَوْقَ مَيْثَاءَ سَهْلَةٍ","نَوَاعِمُ مَا فِي ظِلِّهِنَّ فُتُوقُ"]]},"17E3D17D-C81E-5AC4-8FBC-89641A7EEA60":{"t":"كريمٌ يغضُّ الطّرْف فَضْل حيائه","p":68,"s":"كريم يغض الطرف فضل حيائه","r":"438875","v":[["42C553C5-8524-5F6A-93BA-45947064CB73","كريمٌ يغضُّ الطّرْف فَضْل حيائه","ويدنو وأطْراف الرماح دَوانِ"]]},"393291E4-E44C-55B0-A4CC-4E60404B547F":{"t":"كَأنَّ لَهَا بِرَحْلِ الْقَوْمِ بَوّاً","p":68,"s":"كأن لها برحل القوم بوا","r":"438809","v":[["7A619690-2CAD-5372-BF57-C8AF7C679B12","كَأنَّ لَهَا بِرَحْلِ الْقَوْمِ بَوّاً","وَمَا إِنْ طِبُّهَا إلاَّ اللَّغُوبُ"]]},"B8493351-0D5C-5C7B-B706-D6AFE15754CB":{"t":"كَأنَّهَا حِينَ فَاضَ الْمَاءُ وَاحْتَفَلَتْ","p":68,"s":"كأنها حين فاض الماء واحتفلت","r":"438799","v":[["2D239E5C-0A9B-5C1A-8D4C-68D8DE66228B","كَأنَّهَا حِينَ فَاضَ الْمَاءُ وَاحْتَفَلَتْ","صَقْعَاءُ لاَحَ لَهَا بِالسَّرْحَةِ الذِّيبُ"]]},"CEF6BDB7-4483-5A55-98F4-B158E3E9BE77":{"t":"كَمْ مِنْ أبٍ لي يا جَرِيرُ كَأنّهُ","p":68,"s":"كم من أب لي يا جرير كأنه","r":"438840","v":[["D3581206-2B51-52BE-B6ED-CC638E77D0A9","كَمْ مِنْ أبٍ لي، يا جَرِيرُ، كَأنّهُ","قَمَرُ المَجَرّةِ، أوْ سِرَاجُ نَهَارِ"],["2000D2EC-018A-5521-84D6-D9D79AB678AC","لن تدركوا كرمي بلؤمِ أبيكمُ","وَأوَابِدي بِتَنَحّلِ الأشْعَارِ"],["DDE97227-44F4-5550-B31D-B2ED26C33C65","شَغّارَةٍ تَقِذُ الفَصِيلَ بِرِجْلِهَا","قطّارةٌ لقوادمِ الأبكارِ"]]},"7CE7AEE4-EC3F-58D7-9EFB-57171FD61360":{"t":"لمزاحمٌ منْ خلفهِ وورائهِ","p":68,"s":"لمزاحم من خلفه وورائه","r":"438791","v":[["FE0B40B8-41F6-5E65-990C-FEE8C80DFC92","...........","لمزاحمٌ منْ خلفهِ وورائهِ"],["7CF550C6-8659-5450-B6B6-543EEA7F7281","ومفيدهُ نصري وإنْ كانَ امرأً","مُتَزَحْزِحاً فِي أرْضِهِ وَسَمَائِهِ"],["AA545787-4E38-5E22-BA77-86A020C59934","وأكونُ واليَ سرّهِ فأصونهُ","حتّى يحينَ عليَّ وقتُ أدائهِ"],["F6882749-3EEE-59AA-95DF-257A9754BE05","وإذا دعا باسمي ليركبَ مركبًا","صَعْباً قَعَدْتُ لَهُ عَلَى سِيسَائِهِ"],["A185DEEA-BE6D-5573-8F40-0A36DAAB36B5","وَإذَا اسْتَجَاشَ رَفَدْتُهُ وَنَصَرْتُهُ","وإذا تصعلكَ كنتُ منْ قرنائهِ"],["DD8EFB55-7AA0-5C28-800A-2AF32FFE9FA0","وإذا الحوادثُ أجحفتْ بسوامهِ","قرنتْ صحيحتنا إلى جربائهِ"],["BC710D42-8CA1-5529-9DC2-5E1EC1189E9E","وَإذَا أَتَى مِنْ وَجْهِهِ لِطَرِيقِهِ","لَمْ أطَّلِعْ مِمَّا وَرَاءَ خِبَائِهِ"],["448E1EBB-5F0B-5106-8322-EC80046020B4","وَإذَا رَأْيَتُ علَيْهِ ثَوْباً نَاعِماً","لمْ يلفني متمنّيًا لردائهِ"],["AF3E8B48-16A1-56CF-829C-561B3A702F77","وَإذَا ارْتَدَى ثَوْباً جَميِلاً لَمْ أقُلْ","يَا لَيْتَ أنَّ عَلَيَّ حُسْنَ رِدَائِهِ"],["B737E419-F45E-577A-85A2-DBC2E057A7BB","وَمَتَى أجِئْهُ فِي الشَّدَائِدِ مُرْمِلاً","أُلْقِي الَّذِي فِي مِزْوَدي لِوِعَائِهِ"],["FB8467AE-DEDE-52CA-A0CD-773AF580119D","وَإذَا جَنَى غُرْماً سَعَيْتُ لِنَصْرِهِ","حتّى أهينَ كرائمي لفدائهِ"]]},"87F8A5AD-21EE-5086-9308-127ACF21AEF2":{"t":"لِتَهْجَعَ واسْتَبْقَيْتُهَا ثُمَّ قلَّصَتْ","p":68,"s":"لتهجع واستبقيتها ثم قلصت","r":"438820","v":[["0280CB76-EF08-5CC6-B1D8-F0D5803E4B65","لِتَهْجَعَ واسْتَبْقَيْتُهَا ثُمَّ قلَّصَتْ","بسمرٍ خفافِ الوطءِ واريةِ المخِّ"]]},"27BAB6D6-7E94-57E1-87DC-6D576097812E":{"t":"ما لقيَ البيضُ منَ الجرقوصِ","p":68,"s":"ما لقي البيض من الجرقوص","r":"438844","v":[["B9849A2F-DD8F-537D-9B31-03800CAA1E28","ما لقيَ البيضُ منَ الجرقوصِ","منْ ماردٍ لصٍّ منَ اللّصوصِ"],["E0481119-143F-5C6B-AE02-A2F1997FAE8B","يدخلُ تحتَ الغلقِ المرصوصِ","بِمَهْرِ لاَ غَالٍ وَلاَ رَخِيصِ"]]},"BE709A79-8177-58E4-B38A-F54C612612FC":{"t":"مَا بَالُ دَفِّكَ بالْفِرَاشِ مَذِيلاَ","p":68,"s":"ما بال دفك بالفراش مذيلا","r":"438887","v":[["BAD16311-0675-5A25-A54F-B9D2ADAAED94","مَا بَالُ دَفِّكَ بالْفِرَاشِ مَذِيلاَ","أَقَذًى بِعَيْنِكَ أَمْ أَرَدْتَ رَحِيلاَ؟"],["AA40BCDB-BBAD-59CA-BA39-AA6B8ADA8E46","لَمَّا رَأَتْ أَرَقِي وَطُولَ تَقَلُّبِي","ذَاتَ الْعِشَاءِ وَلَيْلِيَ الْمَوْصُولاَ"],["9501989B-5C11-5DC3-9908-4F363B998889","قالتْ خليدةُ ما عراكَ ولمْ تكنْ","قَبْلَ الرُّقادِ عَنِ الشُّؤُونِ سَؤُولاَ"],["715BF1C7-629D-5E81-A9F7-BB97148E85E4","أَخُلَيْدَ إنَّ أبَاكِ ضَافَ وِسَادَهُ","هَمَّانِ بَاتَا جَنْبَةً وَدَخِيلاَ"],["AF0DCD46-3D1F-5CBD-8F45-D170573C84A1","طرقا فتلكَ هماهمي أقريهما","قلصًا لواقحَ كالقسيِّ وحولا"],["F4E67192-A42F-5C6A-A466-D364375D0196","شُمَّ الْكَوَاهِلِ جُنَّحَاً أعْضَادُهَا","صُهْباً تُنَاسِبُ شَدْقَماً وَجَدِيلاَ"],["736B72F7-D0C0-5C31-8942-71C776FB3012","كَانَتْ نَجَائِبَ مُنْذِرٍ وَمُحَرِّقٍ","أماتهنَّ وطرقهنَّ فحيلا"],["81D49D33-E3FC-54D6-BA2C-A603CF4760C2","وكأنَّ ريّضها إذا باشرتها","كَانَتْ مُعَاوِدَةَ الرَّحِيلِ ذَلُولاَ"],["7DDFE9B5-80AB-53EA-A324-2A10815FD58C","حوزيّةً طويتْ على زفراتها","طَيَّ الْقَنَاطِرِ قَدْ نَزَلْنَ نُزُولاَ"],["56BF01F7-9548-57D8-9932-178065D6E69C","وكأنّما انتطحتْ على أثباجها","فدرٌ بشابةَ قدْ تممنَ وعولا"],["5DAF71CD-F7C4-5ACC-ADFD-88B9D344ADE7","قذفَ الغدوِّ إذا غدونَ لحاجةٍ","دلفَ الرّواحِ إذا أردنَ قفولا"],["882175F2-372C-5BE6-A279-1C4AA6F36C27","لاَ يَتَّخِذْنَ إذَا عَلَوْنَ مَفَازَةً","إلاَّ بَيَاضَ الْفَرْقَديْنِ دَلِيلاَ"],["4B15B938-AD0B-5350-BE1D-828F7EDAA084","قُوداً تَذَارَعُ غَوْلَ كُلِّ تَنُوفَةٍ","ذرعَ النّواسجِ مبرمًا وسحيلا"],["D0122C8C-FB13-5C64-8478-E90D7786D896","وإذا ترقّصتِ المفازةُ غادرتْ","ربذًا يبغّلُ خلفها تبغيلا"],["5A99C965-68FB-53C7-BE83-83D4D84F7BCD","زَجِلَ الْحُدَاءِ كَأنَّ فِي حَيْزُومِهِ","قصبًا ومقنعةَ الحنينِ عجولا"],["4217029F-00EC-5C69-9AD4-E18EF34A51CD","وإذا ترجّلتِ الضّحى قذفتْ بهِ","فشأونَ عقبتهُ فظلَّ ذميلا"],["38378527-C5EB-557F-9FDA-E10B3E37F8E9","حَتَّى إذَا حَسَرَ الظَّلاَمُ وَأَسْفَرَتْ","فَرَأَتْ أَوَابِدَ يَرْتَعينَ هُجُولاَ"],["9767EE7D-1E25-5222-920B-98F4A3226DB8","حدتِ السّرابَ وألحقتْ أعجازها","روحٌ يكونُ وقوعها تحليلا"],["7A1B0C46-EFF3-5117-8229-9BF924F3BFDA","وَجَرَى عَلَى حَدَبِ الصُّوَى فَطَرَدْنَهُ","طَرْدَ الوَسِيقَةِ في السَّمَاوَةِ طُولاَ"],["7B9BFCF1-B906-5E98-94EB-2D14F2EFA8D0","فِي مَهْمَةٍ قَلِقَتْ بِهِ هَامَاتُهَا","قَلَقَ الْفُؤُوسِ إذَا أرَدْنَ نُصُولاَ"],["09A5F0DA-71F1-5EE2-BA6D-3346E9ACBBC9","حَتَّى وَرَدْنَ لِتِمِّ خِمْسٍ بَائِصٍ","جدًّا تعاورهُ الرّياحُ وبيلا"],["06177655-4803-528A-B668-82AA49624E3D","سدمًا إذا التمسَ الدّلاءُ نطافهُ","صَادَفْنَ مُشْرِفَةَ الْمَثَابِ دَحُولاَ"],["D5B837C1-3440-56DC-A5B6-C636D78CAC9B","جَمَعُوا قُوًى مِمَّا تَضُمُّ رِحَالُهُمْ","شَتَّى النِّجَارِ تَرَى بِهِنَّ وُصُولاَ"],["7B0354EB-29DC-5AA1-AD22-29B368DAF973","فَسَقَوْا صَوَادِيَ يَسْمَعُونَ عَشِيَّةً","للماءِ في أجوافهنَّ صليلا"],["2EF7ADD9-445B-5D04-B23C-FF063D7D6061","حتّى إذا بردَ السّجالُ لهاثها","وَجَعَلْنَ خَلْفَ غُرُوضِهِنَّ ثَمِيلا"],["66ED3D0C-F1A1-5CEE-9792-1E41EC10D0C5","وأفضنَ بعدَ كظومهنَّ بجرّةٍ","منْ ذي الأبارقِ إذْ رعينَ حقيلا"],["7F1A139C-F61E-563F-99A7-0CEEE593B37B","قَعَدُوا عَلَى أكْوَارِهَا فَتَرَدَّفَتْ","صخبَ الصّدى جذعَ الرّعانِ رجيلا"],["DEFC6637-FD7D-5555-AF68-92ED2EFFF105","مُلْسَ الْحَصَى بَاتَتْ تَوَجَّسُ فَوْقَهُ","لغطَ القطا بالجهلتينِ نزولا"],["940F41FC-78C5-500C-9706-D68CE1F55C66","يتبعن مائرةَ اليدينِ شملّةً","القتْ بمخترقِ الرّياحِ سليلا"],["29BC3366-F630-502D-BB5B-0370E0D8136C","جاءتْ بذي رمقٍ لستّةِ أشهرٍ","قدْ ماتَ أوْ جرضَ الحياةَ قليلا"],["1523F514-C982-5C9C-B6D1-4696EC5D7616","نَفَضَتْ بِأَصْهَبَ لِلْمَرَاحِ شَلِيلَهَا","نَفْضَ النَّعَامَةِ زِفَّهَا الْمَبْلُولاَ"],["C9041DD4-BA4F-54A7-9FA1-FC841B3C7842","أبلغْ أميرَ المؤمنينَ رسالةً","شَكْوَى إلَيْكَ مُظِلَّةً وَعَوِيلاَ"],["0D509906-EA7C-57FF-9BDA-B5EF3D67B8F9","مِنْ نَازِحٍ كَثُرَتْ إلَيْكَ هُمُومُهُ","لوْ يستطيعُ إلى اللّقاءِ سبيلا"],["DCE171BD-3F4C-594E-8B33-74193FA01227","طالَ التّقلّبُ والزّمانُ، ورابهُ","كسلٌ، ويكرهُ أنْ يكونُ كسولا"],["0D0B2368-AB72-5A88-BA25-A12B2808192B","وعلا المشيبُ لداتهِ، ومضتْ لهُ","حِقَبٌ نَقَضْنَ مَرِيرَهُ الْمَجْدُولاَ"],["E437F665-8891-5A25-8D14-00BD2B112CAD","فكأنَّ أعظمهُ محاجنُ نبعةٍ","عوجٌ قدمنَ فقدْ أردنَ نحولا"],["6CC5A932-08D1-5FDE-8DAD-02E877E60554","كَبَقِيَّةِ الْهِنْدِيِّ أمْسَى جَفْنُهُ","خَلَقاً وَلَمْ يَكُ فِي الْعِظَامِ نَكُولاَ"],["DD2B9EE6-B4CF-5CC0-95DA-1B6649192E51","تغلى حديدتهُ، وتنكرُ لونهُ","عينٌ رأتهُ في الشّبابِ صقيلا"],["4E5DF0F4-877B-5733-BC0C-6DBBED3DDB81","ألِفَ الْهُمُومُ وِسَادَهُ، وَتَجَنَّبَتْ","ريّانَ يصبحُ في المنامِ ثقيلا"],["D4A250C6-9A68-5784-89EE-8BE9A148D671","وطوى الفؤادَ على قضاءِ صريمةٍ","حَذَّاءَ واتَّخَذَ الزَّمَاعَ خَلِيلاَ"],["8A62EDB0-1229-5364-88AF-B91CCAD9A956","أوَليَّ أمْرِ الله إنَّ عَشِيرَتِي","أمْسَى سَوَامُهُمُ عِزِينَ فُلُولاَ"],["EF113158-4C1F-58D5-A116-BB92FF4F41D8","قَطَعُوا الْيَمَامَةَ يَطْرُدُونَ كَأنَّهُمْ","قومٌ أصابوا ظالمينَ قتيلا"],["013B61B9-58BA-5064-8259-BC8B47DC26AA","يحدونَ حدبًا مائلاً أشرافها","فِي كُلِّ مَنْزِلَةٍ يَدَعْنَ رَعِيلاَ"],["435B5493-733A-5174-ABB3-4CDBF0C40455","شهريْ ربيعٍ ما تذوقُ لبونهمْ","إلاَّ حُمُوضاً وَخْمَةً وَدَوِيلاَ"],["F5D3EE1F-E645-5ED3-BDC3-89365FE4AA47","حتّى إذا جمعتْ تخيّرَ طرقها","وَثَنَى الرِّعَاءُ شَكِيرَهَا الْمَنْخُولاَ"],["7564F0C1-BF05-5D3E-8B62-319A8EBE9FB5","وَأَتَوْا نِسَاءَهُمُ بِنِيبٍ لَمْ يَدَعْ","سُوءُ الْمَحَابِسِ تَحْتَهُنَّ فَصِيلاَ"],["90B53E96-55B1-56D6-BE52-C829EDCCB912","أَوَلِيَّ أمْرِ الله إنَّا مَعْشَرٌ","حنقاءُ نسجدُ بكرةً وأصيلا"],["9ABAB6C2-417F-5B9B-8187-A178B44ACA01","عربٌ نرى للهِ في أموالنا","حَقَّ الزَّكَاةِ مُنَزَّلاَ تَنْزِيلاَ"],["1BDB75F9-D5BC-51D7-A88A-4A9CE19FF7F8","قومٌ على الإسلامِ لمّا يمنعوا","ماعونهمْ ويضيّعوا التّهليلا"],["2DBAA733-FBA0-56BF-B072-73FF749A7043","فَادْفَعْ مَظَالِمَ عَيَّلَتْ أبْنَاءَنَا","عنّا وأنقذْ شلونا المأكولا"],["4CB25062-3C22-523A-B5E0-459B79CFC5A5","فَنَرَى عَطِيَّةَ ذَاكَ إنْ أعْطَيْتَهُ","مِنْ رَبِّنَا فَضْلاً وَمِنْكَ جَزِيلاَ"],["48F9C1F5-6A29-5A7B-A6B1-D85DAB672079","أنْتَ الْخَلِيفَةُ حِلْمُهُ وَفَعَالُهُ","وإذا أردتَ لظالمٍ تنكيلا"],["6D96D0AF-4986-5C97-8C43-164C6DDF7916","وأبوكَ ضاربَ بالمدينةِ وحدهُ","قَوْماً هُمُ جَعَلُوا الْجَمِيعَ شُكُولاَ"],["3A3F321A-F11A-594F-9323-BEF168CB022F","قتلوا ابنَ عفّانَ الخليفةَ محرمًا","ودعا فلمْ أرَ مثلهُ مخذولا"],["D74742C3-BB24-51D5-A245-98E551E29F2A","فَتَصدَّعَتْ مِنْ بَعْدِ ذَاكَ عَصَاهُمُ","شققًا وأصبحَ سيفهمْ مسلولا"],["7871E536-451C-5439-9EB3-DB9FDFC19DBD","حتّى إذا استعرتْ عجاجةُ فتنةٍ","عمياءَ كانَ كتابها مفعولا"],["08559DAF-5FC5-5472-8FF4-2EC948973BD6","وزنتْ أميّةُ أمرها فدعتْ لهُ","مَنْ لَمْ يَكُنْ غُمْراً وَلاَ مَجْهُولاَ"],["D8743414-5D56-552F-9997-B8E0B3A8315B","مروانُ أحزمها إذا نزلتْ بهِ","حدبُ الأمورِ، وخيرها مسؤولا"],["78556D63-7AAF-53AF-A298-33FC4607C3CA","أزْمَانَ رَفَّعَ بِالْمَدِينَةِ ذَيْلَهُ","وَلَقَدْ رَأَى زَرْعاً بِهَا وَنَخِيلاَ"],["3C93AD46-20D7-556D-B1C6-8304DB441709","وديارَ ملكٍ خرّبتها فتنةٌ","ومشيّدًا فيهِ الحمامُ ظليلا"],["EA03CAF1-E6B1-5FB6-A333-EC3B5374AE10","إنِّيَ حَلَفْتُ عَلَى يَمِينٍ بَرَّةٍ","لا أكذبُ اليومَ الخليفةَ قيلا"],["5EE90033-D875-5272-AE40-46FBB0084C0A","ما زرتُ آلَ أبي خبيبٍ وافدًا","يومًا أريدُ لبيعتي تبديلا"],["2883FE71-6350-503D-8C3F-3956840A99C3","وَلاَ أتَيْتُ نُجَيْدَةَ بْنَ عُوَيْمِرٍ","أَبْغِي الْهُدَى فَيَزِيدَنِي تَضْلِيلاَ"],["58FC54EA-A3B2-5179-89EC-93279F2DBA5A","منْ نعمةِ الرّحمانِ لا منْ حيلتي","إنّي أعدُّ لهُ عليَّ فضولا"],["D08C26B2-035F-53C4-9E88-3F3828A25C05","أَزْمَانَ قَوْمِي والْجَمَاعَةَ كالَّذِي","لَزِمَ الرِّحَالَة أنْ تَمِيلَ مَمِيلاَ"],["70725CF7-BB1E-5ADF-A004-243BA2B9B343","وَتَرَكْتُ كُلَّ مُنَافِقٍ مُتَقَلِّبٍ","وجدَ التّلاتلَ دينهُ مدخولا"],["0F1C2C8B-AE94-57E0-BDE8-55678D9DD381","ذَخِرِ الْحَقِيبَةِ مَا تَزَالُ قَلُوصُهُ","بَيْنَ الْخَوَارِجِ هِزَّةً وَذَوِيلاَ"],["B64D574B-741D-5375-AC70-19565FB4B915","مِنْ كُلِّهِمْ أمْسَى ألَمَّ بِبَيْعَةٍ","مسحَ الأكفِّ تعاورُ المنديلا"],["5301F75F-7439-5124-BE8E-01E477B4C448","وَإذَا قُرَيْشٌ أَوْقَدَتْ نِيرَانَهَا","وَثَنَتْ ضَغَائِنَ بَيْنَهَا وَذُحُولاَ"],["32E98744-9371-54B6-B4EF-85233F34B4C8","فأبوكَ سيّدها، وأنتَ أميرها","وَأَشَدُهَا عِنْدَ الْعَزَائِمِ جُولاَ"],["50134E60-0100-5B49-B1C4-941AD33A42DF","إنَّ السُّعَاةَ عَصَوْكَ حِينَ بَعَثْتَهُمْ","وَأَتَوْا دَوَاعِيَ لَوْ عَلِمْتَ وَغُولاَ"],["F931C9B2-4D47-5353-BC96-07BEE7580306","إنَّ الَّذِينَ أمَرْتَهُمْ أنْ يَعْدِلُوا","لمْ يفعلوا ممّا أمرتَ فتيلا"],["01AD1A1F-9296-53B2-91E9-04A16929626E","أَخَذُوا الْعَرِيفَ فَقَطَّعُوا حَيْزُومَهُ","بالأَصْبَحِيَّةِ قَائِماً مَغْلُولاَ"],["15F7C46C-75CC-547B-8460-096DB7B373A7","حَتَّى إذَا لَمْ يَتْرُكُوا لِعِظَامِه","لحمًا ولا لفؤادهِ معقولا"],["16B7F20B-EF8E-59F9-9FF0-0EF6AB1F9A37","نسيَ الأمانةَ منْ مخافةِ لقّحٍ","شُمُسٍ تَرَكْنَ بِضَبْعِهِ مَجْزُولاَ"],["18AAC7FA-20F9-5C17-95D2-4538261F1DA3","كَتَبَ الدُّهَيْمُ وَمَا تَجَمَّعَ حَوْلَهَا","ظُلْماً فَجَاءَ بِعَدْلِهَا مَعْدُولاَ"],["A196E3A3-345F-5CF2-8185-692F706E02B3","وَغَدَوا بِصَكِّهِمُ وَأَحْدَبَ أَسْأَرَتْ","منهُ السّياطُ يراعةً إجفيلا"],["9E4A2DE3-D1CC-5ACA-A5CB-F8EBCCDE706E","مِنْ عَامِلٍ مِنْهُمْ إذَا غَيَّبْتَهُ","غالى يريدُ خيانةً وغلولا"],["E710E549-1AAA-5C7B-84E3-C3B08883140A","خربَ الأمانةِ لوْ أحطتَ بفعلهِ","لَتَرَكْتَ مِنْهُ طَابِقاً مَفْصُولاَ"],["AF75978C-FED3-50CC-8975-FDCDED3A2BF2","كُتُباً تَرَكْنَ غَنِيَّنَا ذَا خَلَّةٍ","بعدَ الغنى، وفقيرنا مهزولا"],["5D0CDC1B-6924-5042-BCE5-3ED2C7314CF2","أَخَذُوا حَمُولَتَهُ فَأَصْبَحَ قَاعِداً","لا يستطيعُ عنِ الدّيارِ حويلا"],["F0192C20-0624-5BA2-BAB0-5EB68F984600","يدعو أميرَ المؤمنينَ ودونهُ","خرقٌ تجرُّ بهِ الرّياحُ ذيولا"],["397C8A4F-3B3C-54C3-8621-49095CC8761B","كَهُدَاهِدٍ كَسَرَ الرُّمَاةُ جَنَاحَهُ","يدعو بقارعةِ الطّريقِ هديلا"],["1116CEC2-9DA4-564F-8E08-FA09371E1A9F","وقعَ الرّبيعُ وقدْ تقاربَ خطوهُ","وَرَأَى بِعَقُوَتِهِ أزَلَّ نَسُولاَ"],["FC8C268C-ABDD-544E-AC3E-BE875FB51A36","مُتَوَضِّحَ الأَقْرَابِ فِيهِ شُهْبَةٌ","نَهِشَ الْيَدَيْنِ تَخَالُهُ مَشْكُولاَ"],["764FAFEB-4306-5101-8C74-13701854AE84","كَدُخَانِ مُرْتَجِلٍ بِأَعْلَى تَلْعَةٍ","غَرْثَانَ ضَرَّمَ عَرْفَجاً مَبْلُولاَ"],["AD4D3141-E155-518E-9682-EFE19D2ABD85","وَلَئِنْ سَلِمْتُ لأَدْعُونَّ بِطَعْنَةٍ","تدعُ الفرائضَ بالشّريفِ قليلا"],["5397AEED-5544-5B46-B84C-9FBB9F6F98FC","وَأَرَى الَّذي يَدَعُ الْمَطَامِعَ لِلتُّقَى","منّا أتى خلقًا بذاكَ جميلا"],["4A43D49F-4DCC-559C-AB9A-3A0387B77F9D","بُنِيَتْ مَرَافِقُهُنَّ فَوْقَ مَزَلَّةٍ","لا يستطيعُ بها القرادُ مقيلا"],["01FB5CAF-7978-56B0-9CAB-979425FE48B5","وأتاهمُ يحيى فشدَّ عليهمُ","عَقْداً يَرَاهُ الْمُسْلِمُونِ ثَقِيلاَ"],["679945FD-F03D-51AB-8B41-F1F2470E33D4","وتركتُ قومي يقسمونَ أمورهمْ","أَإِلَيْكَ أَمْ يَتَلَبَّثُونَ قَلِيْلاَ"],["DD8ECC17-940D-5BF1-BF45-93D73AAA4A8E","أَخَذُوا الْمَخَاضَ مِنَ الْفَصِيلِ غُلُبَّةً","ظلمًا ويكتبُ للأميرِ أفيلا"]]},"B279C178-6254-59AB-8847-AC8BC97284DC":{"t":"مَاذَا ذَكَرْتُمْ مِنْ قَلُوصٍ عَقَرْتُهَا","p":68,"s":"ماذا ذكرتم من قلوص عقرتها","r":"438842","v":[["EDD18C3F-635E-5C3A-9EF6-2FEDD16DE949","مَاذَا ذَكَرْتُمْ مِنْ قَلُوصٍ عَقَرْتُهَا","بسيفي وضيفانُ الشّتاءِ شهودها"],["63388B2D-6275-56C6-BD2A-873FC3CF3758","فَقَدْ عَلِمُوا أنِّي وَفَيْتُ لِرَبِّهَا","فَرَاحَ عَلَى عَنْسٍ بِأُخْرَى يَقُودُهَا"],["9EAA2A88-0F18-5957-AE75-072972E18305","قريتُ الكلابيَّ الّذي يبتغي القرى","وأمّكَ إذْ تخدي إلينا قعودها"],["2E0AFECD-99EB-55D2-8D97-654BBF21096E","رَفَعْنَا لَهَا نَاراً تُثَقَّبُ لِلْقِرَى","ولقحةَ أضيافٍ طويلاً ركودها"],["F33DDF04-F01E-5363-B248-150C8ECF0CBC","إذا أخليتْ عودَ الهشيمةِ أرزمتْ","جَوَانِبُهَا حَتَّى نَبِيتَ نَذُودُهَا"],["67FF3633-08A6-57CB-8BE9-C21F18CCFDA0","إذَا نُصِبَتْ لِلطَّارِقِينَ حَسِبْتَهَا","نعامةَ حزباءٍ تقاصرَ جيدها"],["FD635A4F-CC95-5026-9954-A1FF388E3499","تَبِيتُ الْمَحَالُ الْغُرُّ فِي حَجَرَاتِهَا","شَكَارَى مَرَاهَا مَاؤُهَا وَحَدِيدُهَا"],["51A1F276-8E29-52F1-BF66-954045947916","بعثنا إليها المنزلينِ فحاولا","لِكَيْ يُنْزِلاَهَا وَهْيَ حَامٍ حُيُودُهَا"],["609687E0-D90C-5A1C-B4A6-CE7AB3AB7A55","فَبَاتَتْ تَعُدُّ النَّجْمَ فِي مُسْتَحِيرَةٍ","سَرِيعٍ بِأَيْدِي الآكِلِينَ جُمُودُهَا"],["FA00D906-AEAE-5157-80A0-FCEEA17995C9","فلمّا سقيناها العكيسَ تملأّتْ","مَذَاخِرُهَا وَازْدَادَ رَشْحاً وَرِيدُهَا"],["5AC4B2E5-94CF-52F5-973E-529C6432B0CB","فَلَمَّا قَضَتْ مِنْ ذِي الإِنَاءِ لُبَانَةً","أرَادَتْ إلَيْنَا حَاجَةً لاَ نُرِيدُهَا"],["0C23F742-B344-5E77-AFC2-C55ECD0ABEA5","فَلَمَّا عَرَفْنَا أنَّهَا أُمُّ خَنْزَرٍ","جفاها مواليها وغابَ مفيدها"],["66DE9A25-3B89-5D1A-BEED-9BF2727E3DEF","إذَا مَا اعْتَرَانا الْحَقُّ بِالسَّهْلِ أصْبَحَتْ","لَهَا مِثْلَ أسْرَابِ الضِّبَاعِ خُدُودُهَا"],["B1B5DEF0-A93C-5363-BDDA-7DE0CD8E4767","تَبِيتُ وَرِجْلاَهَا أَوَانَانِ لاِسْتِهَا","عَصَاهَا اسْتُهَا حَتَّى يَكِلَّ قَعُودُهَا"],["E9D8A379-F5DC-5857-AD1C-7248DAB99B28","مُجَسَّمَةُ الْعِرْنِينِ مَنْقُوبَةُ الْعَصَا","عدوسُ السّرى باقٍ على الخسفِ عودها"],["BAB2B3A0-9974-5B69-AC8A-A3F20E825478","فجاءتْ إلينا والدّجى مرجحنّةٌ","رغوثُ شتاءٍ قدْ تقوّبَ عودها"],["B2298CB8-C098-5526-A7C6-2D0C12151D8C","تَؤُمُّ وَصَحْرَاءُ المَشَافِرِ دُونَهَا","سنا نارنا أنّى يشبُّ وقودها"],["80919DD3-2A83-5937-95B9-A97F7F2AB675","ظَلِلْتُ بِيَوْمِ عِنْدَهُنَّ تَغَيَّبَتْ","نحوسُ جواريهِ ومرّتْ سعودها"],["2DADADAA-1B98-51A4-87C8-02A69DC85181","فَلاَ يَوْمُ دُنْيَا مِثْلُهُ غَيْرَ أنَّنَا","نرى هذه الدّنيا قليلاً خلودها"],["EA44F235-E1D4-52F5-935D-73702B1DE501","فأصبحَ يستافُ الفلاةَ كأنّهُ","مشرًّى بأطرافِ البيوتِ قديدها"]]},"09B2A7F5-3E69-558B-A365-80191FF4C32C":{"t":"مِنْ كُلِّ أشْمَطَ مَذْبُوحٍ بِلِحْيَتِهِ","p":68,"s":"من كل أشمط مذبوح بلحيته","r":"438885","v":[["4AC9F79E-7C9C-5923-AC31-59D61BC982B8","مِنْ كُلِّ أشْمَطَ مَذْبُوحٍ بِلِحْيَتِهِ","بَادِي الأَذَاةِ عَلَى مَرْكُوِّهِ الطَّحِلِ"],["7E4F27B7-500F-5A74-A78A-1E16F6D6B33F","وَقَيِّمٍ أمْدَرِ الْجَنْبَيْنِ مُنْخَرِقٍ","عَنْهُ الْعَبَاءَةُ قَوَّامٍ عَلَى الْهَمَلِ"],["CA61ECC4-E075-5CE2-8113-4F11F92B9F32","ذبَّ الغوالي حتّى ما يطفنَ بهِ","جَأْبُ الْمَفَارِقِ عَنْ ذِي بَنَّةٍ تَفِلِ"]]},"E36C1AD4-C1E4-5AA1-B052-584426CC16D3":{"t":"هممتَ الغداةَ همّةً أنْ تراجعا","p":68,"s":"هممت الغداة همة أن تراجعا","r":"438871","v":[["057A35D3-F14B-5C6C-87E3-99FB422DB359","هممتَ الغداةَ همّةً أنْ تراجعا","صِبَاكَ وَقَدْ أمْسَى بِكَ الشَّيْبُ شَائِعَا"],["16EEB6C8-484F-5FBB-8C3D-C30AC723A4B9","وشاقتكَ بالعبسينِ دارٌ تنكّرتْ","مَعَارِفُهَا إلاَّ الْبِلاَدَ الْبَلاَقِعَا"],["44A85E43-ADAC-581F-A1EF-DD6EF02FD2E4","بميثاءَ سالتْ منْ عسيبٍ فخالطتْ","بِبَطْنِ الرِّكَاءِ بُرْقَةً وَأجَارِعَا"],["8F6AEFCF-5D73-5779-B6C1-8826D4EDD43E","كما لاحَ وشمٌ في يديْ حارثيّةٍ","بنجرانَ أدمتْ للنّؤورِ الأشاجعا"],["6EBEE953-092E-5318-B1B3-0825E21718FD","تبصّرْ خليلي هلْ ترى منْ ظعائنٍ","تَجَاوَزْنَ مَلْحُوباً فَقِلْنَ مُتَالِعَا"],["4E225B5D-63EF-5754-8529-76355DB11942","جَوَاعِلُ أرْمَاماً يَمِيناً وَصَارَةً","شِمَالاً وَقَطَّعْنَ الْوِهَاطَ الدَّوَافِعَا"],["9610CE86-E30C-5C2B-A2AC-55DFB28F19EE","دَعَاهُنَّ دَاعٍ لِلْخَرِيفِ وَلَمْ تَكُنْ","لهنَّ بلادًا فانتجعنَ روافعا"],["260DFBA0-FCBB-5B73-8434-A0D2A0D1259C","تمهّدنَ ديباجًا وعالينَ عقمةً","وأنزلنَ رقمًا قدْ أجنَّ الأكارعا"],["AA428E19-43CE-572A-AACC-D8B7D9CD47B6","خدالَ الشّوى غيدَ السّوالفِ بالضّحى","عِرَاضَ الْقَطَا لا يَتَّخِذْنَ الرَّفَائِعَا"],["CFCA645C-4821-5DEE-9A76-830CD8339F37","تضيقُ الخدورُ والجمالُ مناخةٌ","بأعجازها حتّى يلحنَ خواضعا"],["7DD6D6BF-9311-55E8-BFBE-9DC670B72AA3","فَلَمَّا اسْتَقَلَّتْ فِي الْهَوَادِجِ أقْبَلَتْ","بأعينِ آرامٍ كسينَ البراقعا"],["4C7A25FC-F16E-54D5-BFAA-05313F23B6B2","كأنَّ دويَّ الحليِ تحتَ ثيابها","حَصَادُ السَّنَا لاَقَى الرِّيَاحَ الزَّعَازِعَا"],["0E422695-7044-5B08-BDEE-6779D34D355E","جُمَاناً وَيَاقُوتاً كَأنَّ فُصُوصَهُ","وَقُودُ الْغَضَا سَدَّ الْجُيُوبَ الرَّوَادِعَا"],["F282A3A2-4D57-53D3-9074-169351045D06","لهنَّ حديثٌ فاتنٌ يتركُ الفتى","خفيفَ الحشى مستهلكَ القلبِ طامعا"],["D55FE527-3B6E-5A37-B83B-3D762BE70EA5","وليسَ بأدنى منْ غمامٍ يضيئهُ","سنا البرقِ يجلو المشرفاتِ اللّوامعا"],["D08B7A32-632F-5312-B03C-94EFE891E875","بناتُ نقًا ينظرنَ منْ كلِّ كورةٍ","منَ الأرضِ محبوًّا كريمًا وتابعا"],["3A811E44-730E-56ED-B9B8-5E44DCC70839","وَلَيْسَ مِنَ اللاَّئِي يَبيعُ مُخَارِقٌ","بِحَجْرٍ وَلا اللاَّئِي خَضَرْنَ الْمَدَارِعَا"],["BAFE4B27-62BA-56AB-ABA3-7C1C4E8B2CF4","وَمَا زِلْنَ إلاَّ أنْ يَقِلْنَ مَقِيلَةً","يسامينَ أعداءً ويهدينَ تابعا"],["C078A5A1-A42F-566C-AF26-CE56B8F5557F","فَشَرَّدْنَ يَرْبُوعاً وَبَكْرَ بْنَ وَائِلٍ","وأَلْحَقْنَ عَبْساً بِالْمَلاَ وَمُجَاشِعَا"],["BA2C1213-5289-5227-AEC2-C743D7E9C86A","ولَوْ أنَّهَا أرْضُ ابْنِ كُوزٍ تَصَيَّفَتْ","بفيحانَ ما أحمى عليها المراتعا"],["F8B38244-244D-50E9-935E-4D1B4811D53E","وَلَكِنَّهَا لاَقَتْ رِجَالاً كَأنَّهُمْ","على قربهمْ لا يعلمونَ الجوامعا"],["4D63BD5D-FC25-51C0-A67F-F56E35DF6886","وَلاَقَيْنَ مِنْ أوْلاَدِ عُقْدَةَ عُصْبَةً","عَلَى الْمَاءِ يَنْثُونَ الذُّحُولَ الْمَوَانِع"],["E61B0486-F3F8-54ED-903E-C63A5F7BE49E","َا فَقُلْنَا لَهُمْ إنْ تَمْنَعُونَا بِلاَدَكُمْ","نَجِدْ مَذْهَباً في سَائِرِ الأَرْضِ وَاسِعَا"],["F546F5D4-BD64-5024-82BD-5A48A358FC9C","وَيَمْنَعُكُمْ مُسْتَنُّ كُلِّ سَحَابَةٍ","مُصَابَ الرَّبِيعِ يَتْرُكُ الْمَاءَ نَاقِعَا"],["72916B01-C050-578E-A82E-C2591FF66552","وَبَرْدَ النَّدَى والْجُزْءَ حَتَّى يُغِيرَكُمْ","خَرِيفٌ إذَا مَا النَّسْرُ أصْبَحَ وَاقِعَا"],["9D2EFBCD-3D3D-5204-A275-DBFA31B530EC","وَأمَّا مُصَابُ الْغَادِيَاتِ فَإنَّنَا","عَلى الْهَوْلِ نَرْعاهُ وَلَوْ أَنْ نُقَارِعَا"],["71632ABE-C4BD-5C04-920B-76EFF794EB96","بِحَيٍّ نُمَيْرِيٍّ عَلَيْهِ مَهَابَةٌ","جَمِيعٍ إذَا كَانَ اللِّئَامُ جَنَادِعَا"],["14E71277-8BD3-5F23-B3C3-666FDA7E5708","هممتُ بهمْ لولا الجلالةُ والتّقى","وَلَمْ تَرَ مِثْلَ الْحِلْمِ لِلْجَهْلِ وَازِعَا"],["41A2A956-42CD-5924-8DA0-53CA3A997FD1","وَكُنَّا أُنَاساً تَعْتَرِينَا حَفِيظَةٌ","فنحمي إذا ما أصبحَ الثّغرُ ضائعا"]]},"5484D0FC-33E4-5236-AD29-581E1447A6A8":{"t":"وحديثها كالقطرِ يسمعهُ","p":68,"s":"وحديثها كالقطر يسمعه","r":"438812","v":[["5686AE4C-2C1E-5240-AC9F-0A6E1CF89730","وحديثها كالقطرِ يسمعهُ","رَاعِي سِنِينَ تَتَابَعَتْ جَدْبا"],["2E4D7F0B-D04C-5A9F-87CB-3D7FB76C4E1D","فَأصَاخَ يَرْجُو أنْ يَكُونَ حَياً","ويقولُ منْ فرحٍ هيا ربّا"]]},"E4FB951F-A853-55A7-A007-DEEF145CCF79":{"t":"وديتَ ابنَ راعي الإبلِ إذ حانَ يومهُ","p":68,"s":"وديت ابن راعي الإبل إذ حان يومه","r":"438827","v":[["FCFBD3BC-EF20-5721-BF91-29FE4F4E32BB","وديتَ ابنَ راعي الإبلِ إذ حانَ يومهُ","وشقَّ لهُ قبرًا بأرضكَ لاحدُ"],["F3243A35-A401-5C9F-A6B5-C80E322B27F9","وقدْ كانَ ماتَ الجودُ حتّى نعشتهُ","وَذَكَّيْتَ نَارَ الْجُودِ والْجُودُ خَامِدُ"],["E0BA9000-BFCC-5DAF-B85C-2A4073C7B686","فَلاَ حَمَلَتْ أُنْثَى وَلاَ آبَ غَائِبٌ","وَلاَ وَلَدَتْ أُنْثَى إِذَا مَاتَ خَالِدُ"]]},"CD8E803B-AF06-578A-8615-832EE3FA512C":{"t":"وفي ناتقٍ كانَ اصطلامُ سراتهمْ","p":68,"s":"وفي ناتق كان اصطلام سراتهم","r":"438829","v":[["82F5EFDA-1529-56D2-8918-E87E13B67CD9","وفي ناتقٍ كانَ اصطلامُ سراتهمْ","لياليَ أفنى القرحُ جلَّ إيادِ"],["C6A8CA55-5633-5D17-AACC-55C3DC1F5FD4","نفوا إخوةً ما مثلهمْ كانَ إخوةٌ","لحيٍّ ولمْ يستوحشوا لفسادِ"]]},"2AAEC897-3FEA-510C-8F47-49B80316AE54":{"t":"وما مزنةٌ جادتْ فأسبلَ ودقها","p":68,"s":"وما مزنة جادت فأسبل ودقها","r":"438839","v":[["7B165130-9A78-5724-A29A-0F877B29D025","وما مزنةٌ جادتْ فأسبلَ ودقها","عَلَى رَوْضَةٍ رَيْحَانُهَا قَدْ تَخَضَّدَا"],["672B16BE-3E19-5F83-A7FF-F2934478CA87","كَأَنَّ تِجَارَ الْهِنْدِ حَلُّوَا رِحَالَهُمْ","عليها طروقًا ثمَّ أضحوا بها الغدا"],["7E7F1940-FF26-51AB-9B36-2A3658E5ED29","بِأَطْيَبَ مِنْ ثَوْبَيْنِ تَأْوي إلَيْهِمَا","سُعَادُ إذَا نَجْمُ السِّمَاكَيْنِ عَرَّدَا"],["0ED815BC-EFB6-599F-BF3A-5A9FCB8A6C34","كَأنَّ الْعُيُونَ الْمُرْسِلاَتِ عَشِيَّةً","شآبيبَ دمعٍ لمْ تجدْ متردّدا"],["45967E47-FF08-5C22-B9A2-464929D78BDA","مَزَائِدُ خَرْقَاءِ الْيَدَيْنِ مُسِيفَةٍ","أخبَّ بهنَّ المخلفانِ وأحفدا"],["B42541E2-16FC-5719-85CB-CC8B519577E1","وما بيضةٌ باتَ الظّليمُ يحفّها","بِوَعْسَاءَ أعْلَى تُرْبِهَا قَدْ تَلَبَّدَا"],["E4DB949E-BC5E-55B4-97EC-5A2B77ED1226","فَلَمَّا عَلَتْهُ الشَّمْسُ في يَوْمٍ طَلْقَةٍ","وَأشْرَفَ مُكَّاءُ الضُّحَى فَتغَرَّدَا"],["42EE3985-BA1A-5EC1-B742-989CC2AF8F8A","أرَادَ الْقِيَامَ فَازْبأرَّ عِفَاءُهُ","وَحَرَّكَ أَعْلَى رِجْلِهِ فَتَأَوَّدَا"],["66F3F9A8-7D0B-5C60-9A5B-DE2778C3CB68","وَهَزَّ جَنَاحَيْهِ فَسَاقَطَ نَفْضُهُ","فَرَاشَ النَّدَى عَنْ مَتْنِهِ فَتَبَدَّدَا"],["BE7AC785-1043-50DD-A902-DE462955DC45","فغادرَ في الأدحيِّ صفراءَ تركةً","هجانًا إذا ما الشّرقُ فيها توقّدا"],["D5F962E0-5231-5B09-A588-10E9FAE4B0B5","بِأَلْيَنَ مَسّاً مِنْ سُعَادَ لِلامِسٍ","وأحسنَ منها حينَ تبدو مجرّدا"],["78BB31F6-C049-5F8C-AC53-C3DA43461E1A","وإنّي لأحمي الأنفَ منْ دونِ ذمّتي","إذَا الدَّنِسُ الْوَاهِي الأمَانَةِ أهْمَدَا"],["5B8AD53F-BE4D-5079-8B4B-374456C9A208","بنينا بأعطانِ الوفاءِ بيوتنا","وَكَانَ لَنَا في أوَّلِ الدَّهْرِ مَوْرِدَا"],["FBA057CF-F640-5E3B-9E09-B86C4FF3DCB3","إذا ما ضمنّا لابنِ عمٍّ خفارةً","نجيءُ بها منْ قبلِ أنْ يتشدّدا"],["B1AB3874-392C-5F12-8F7C-054EC2637783","أناخوا بأشوالٍ إلى أهلِ خبّةٍ","طروقًا وقدْ أقعى سهيلٌ فعرّدا"],["9F2D5AD6-F38C-525A-A3B1-E4E8289E6B56","يَخُبَّانِ قَصْراً فِي شَمَالٍ عَرِيَّةٍ","أمَامَ رَوَايَا بَادَرَاهُنَّ قَرْدَدَا"],["04A9426B-CA90-522C-9E7C-321D7EAAB035","أمُرُّ وَأحْلَوْلي وَتَعْلَمُ أُسْرَتِي","عنائي إذا جمرٌ لجمرٍ توقّدا"],["7B953CD1-22DC-5F79-B058-D36723A4F716","إذا ما فزعنا أوْ دعينا لنجدةٍ","لبسنا عليهنَّ الحديدَ المسرّدا"],["BF4CA86C-8931-5733-A7B9-12E4531A86D3","بربِّ ابنةِ العمريِّ ما كانَ جارها","لَيُسْلِمُهَا مَا وَافَقَ الْقَائِمُ الْيَدَا"]]},"2735CE04-57E8-5F7B-A870-430B1EF46739":{"t":"ونحن تركنا بالفعاليِّ طعنةً","p":68,"s":"ونحن تركنا بالفعالي طعنة","r":"438883","v":[["05E186F5-00A5-5632-A178-AB0C82F421D2","ونحن تركنا بالفعاليِّ طعنةً","لها عاندٌ فوقَ الذّراعينِ مسبلُ"]]},"646F6704-75F0-570F-ADF9-1F4C4DB0D738":{"t":"وَرَدَ الْكَرِيُّ بِهِ بُعُورَ سَيُوفَةٍ","p":68,"s":"ورد الكري به بعور سيوفة","r":"438838","v":[["F2336E75-AAF9-5621-AE8F-C6F9F3C010A6","وَرَدَ الْكَرِيُّ بِهِ بُعُورَ سَيُوفَةٍ","دَنَفاً وَغَادَرَهُ عَلَى قَنُّورِ"]]},"B7F63144-19D4-5BE0-8FDC-D0B69B55AEC5":{"t":"وَقَدْ حَبَا خَلْفَهَا ثَهْلانُ فالنِّيرُ","p":68,"s":"وقد حبا خلفها ثهلان فالنير","r":"438843","v":[["27252F66-B672-588F-AF84-4903368DD155","..................","وَقَدْ حَبَا خَلْفَهَا ثَهْلانُ فالنِّيرُ"],["F5992A79-4976-5667-9BFD-B13E18976DA3","لَوْلاَ سَعِيدٌ أُرَجِّي أنْ أُلاقِيَهُ","ما ضمّني في سوادِ البصرةِ الدّورُ"],["A1242A8F-7F0B-56D1-B8CB-416C93CBF004","شجعاءُ يعملةٌ تدمى مناسمها","كَأنَّهَا حَرَجٌ بِالْقِدِّ مَأْسُورُ"],["A43A6401-E2A8-54B7-8A90-E838B7DFCAD0","إلى الأكارمِ أحسابًا ومأثرةً","تَبْرِي الإكَامَ وَيَبْرِي ظَهْرَهَا الْكُورُ"],["13A70221-F411-5F7A-BC38-A342086384D7","الواهبُ البختَ خضعًا في أزمّتها","والبيضَ فوقَ تراقيها الدّنانيرُ"],["CCBE4CFD-73BE-5A35-8CA2-280F8D167F7F","فَكَمْ تخَطَّتْ إلَيْكُمْ مِنْ ذَوِي تِرَةٍ","كأنَّ أبصارهمْ نحوي مساميرُ"],["16502E3D-55B3-5279-A294-DECD33B4C9B7","ما يدرأُ اللهُ عنّي منْ عدواتهمْ","فَإنَّ شَرَّهُمُ فِي الصَّدْرِ مَحْذُورُ"],["9BB474EF-E1DC-5251-AEFB-7918602AC372","إنْ يَعْرِفُونِي فَمَعْرُوفٌ لِذي بَصَرٍ","أوْ يَنْسُبُوني فَعالي الذِّكْرِ مَشْهُورُ"],["FDDB6C98-48C5-599A-852C-A23DD9C0FBF3","مَرَّتْ عَلَى أُمِّ أمْهَارٍ مُشَمِّرَةً","تهوي بها طرقٌ أوساطها زورُ"],["4E97A57A-B4D0-53A4-87CC-324515AAB333","في لاحبٍ برقاقِ الأرضِ محتفلٍ","هادٍ إذا عزّهُ الأكمُ الحدابيرُ"],["AE20EC7A-4A22-581B-9625-A99FB0EE9864","يَهْدي الضَّلُولَ وَيَنْقَادُ الدَّلِيلُ بِهِ","كأنّهُ مسحلٌ في النّيرِ منشورُ"],["E7A6D220-4C27-5D97-8B0C-79827F03F263","مَصْدَرُهُ فِي فَلاةٍ ثُمَّ مَوْرِدُهُ","جُدٌّ تَفَارَطَهُ الأَوْرَادُ مَجْهُورُ"],["790C758D-FD29-52AE-AF1D-69228F55BFB8","يُجَاوِبُ الْبُومَ تَهْوَادُ الْعَزِيفِ بِهِ","كما تحنُّ لغيثٍ جلّةٌ خورُ"],["B64910DA-04B6-59F7-AFFA-E6513EB0C74F","ما عرّستْ ليلةً إلاّ على وجلٍ","حتّى تلوحَ منَ الصّبحِ التّباشيرُ"],["654879BB-9E20-510B-A10E-E136A7908073","أرْمِي بِهَا كُلَّ مَوْمَاةٍ مُوَدِّيَةً","جدّاءَ غشيانها بالقومِ تغريرُ"],["90CFC838-1A5B-5825-AB96-71D5820BE2AC","حتّى أنيختْ على ما كانَ منْ وجلٍ","فِي الدَّارِ حَيْثُ تَلاَقَى الْمَجْدُ والْخِيرُ"],["D0BB136A-94E4-5921-836D-54A41D116049","يا خيرَ مأتى أخي همٍّ وناقتهِ","إذا التقى حقبٌ منها وتصديرُ"],["B328E7A6-BCB2-5647-B1F1-41EECAE666FB","زورٌ مغبٌّ ومسؤولٌ أخو ثقةٍ","وسائرٌ منْ ثناءِ الصّدرِ منشورُ"]]},"C1DCB193-C8F7-5C81-966F-E7DB2F6AA60C":{"t":"وَكَأنَّ نُمْرُقَتِي فُوَيْقَ مُوَلَّع","p":68,"s":"وكأن نمرقتي فويق مولع","r":"438877","v":[["842DAB14-109D-5E81-B064-4A1848E938C8","وَكَأنَّ نُمْرُقَتِي فُوَيْقَ مُوَلَّع","يرعى الدكادكَ منْ جنوبِ قطانا"]]},"6224F4F2-57E3-518F-8156-96C6D6EAD24D":{"t":"وَلَمْ أرَ مَعْقُوراً بِهِ وَسْطَ مَعْشَرٍ","p":68,"s":"ولم أر معقورا به وسط معشر","r":"438837","v":[["D18F94CA-7015-5B98-8BE2-415069255992","وَلَمْ أرَ مَعْقُوراً بِهِ وَسْطَ مَعْشَرٍ","أقلَّ انتصارًا باللّسانِ وباليدِ"],["F9D4EE8E-49D0-5AFD-9AE9-361C46699640","سوى نظرٍ ساجٍ بعينٍ مريضةٍ","جرتْ عبرةٌ منها ففاضتْ بإثمدِ"],["FCA6A040-9BCC-5E05-8A47-F5F94481FA60","بَكَتْ عَيْنُ مَنْ أذْرَى دُمُوعَكِ إنَّمَا","وَشَى بِكِ وَاشٍ مِنْ بَنِي أُخْتِ مِسْرَدِ"],["A2B342A3-7EE9-521A-A125-974441E0331B","فَلَوْ كُنْتُ مَعذُوراً بِنَصْرِكِ طَيَّرَتْ","صُقُورِيَ غِرْبَانَ الْبَعِيرِ الْمُقَيَّدِ"],["1878B533-D1B6-5467-826B-C48D38A2C99B","لَظَلَّ قُطَامِيٌّ وَتَحْتَ لَبَانِهِ","نواهضُ ربدٌ ذاتُ ريشٍ مسبّدِ"],["4B1060D9-D5F7-56C5-B5BC-DD3832DF022D","وللدّارِ فيها منْ حمولةِ أهلها","عَقِيرٌ وَلِلْبَاكِي بِهَا الْمُتَبَلِّدِ"],["E14A87BC-DEC4-5CA3-869D-17F5A5B472E5","إذا ما انجلتْ عنهُ غداةً ضبابةٌ","رَأَى وَهْوَ فِي بَلْدٍ خَرَانِقَ مُنْشِدِ"],["AFA46BAD-4BAD-56D2-9510-2A6E7D53A9CE","وَخُودٌ مِنَ اللاَّئِي يُسَمَّعْنَ بالضُّحَى","قريضَ الرّدافى بالغناءِ المهوّدِ"],["6FCF4724-3417-59E5-B487-0D813454D6FD","ضواربُ بالأذقانِ منْ ذي شكيمةٍ","إذَا مَا هَوَى كالنَّيْزَكِ الْمُتَوَقِّدِ"],["03DBDDDD-D85B-5D69-961A-AC4860628AC9","دعتنا فألوتْ بالنّصيفِ ودونها","جَناحٌ وَرُكْنٌ مِنْ أَهَاضِيبِ ثَهْمَدِ"],["2BB45585-9306-56FC-97C9-1CABD04F7394","مربّعُ أعلى حاجبِ العينِ أمّهُ","شقيقةُ عبدٍ منْ قطينٍ مولّدِ"]]},"FC756F7C-E891-5D88-95F9-5FB6FDBC6DB4":{"t":"وَلِلسِّرِّ حَالاَتٌ فَمِنْهُ جَمَاعَةٌ","p":68,"s":"وللسر حالات فمنه جماعة","r":"438821","v":[["1915A03D-BC64-537C-A4F1-76E0D217483D","وَلِلسِّرِّ حَالاَتٌ فَمِنْهُ جَمَاعَةٌ","وَمِنْهُ نَجِيَّانِ وَأَحْزَمُهَا الْفَرْدُ"],["C1F8CC2F-5D8B-5989-AB26-479E311F087C","وأفضلُ منها صونُ سرّكِ كاتمًا","إلى الفرصِ اللاّتي ينالُ بها الجدُّ"]]},"171552A5-AE49-535E-A383-089ECD54A7D3":{"t":"وَمَنْ يَكُ بَادِياً وَيَكُنْ أَخَاهُ","p":68,"s":"ومن يك باديا ويكن أخاه","r":"438888","v":[["B199F6BF-D4C6-5DA4-9B39-8B66BF06C1CF","وَمَنْ يَكُ بَادِياً وَيَكُنْ أَخَاهُ","أبا الضّحّاكِ ينتسجِ الشّمالا"],["8B66934F-0C75-5B22-8904-74E3476C6BF9","سَيَكْفِيكِ الْمُرَحَّلَ ذُو ثَمَانٍ","سَحِيلٌ تَغْزِلينَ لَهُ الْجُفَالاَ"],["E977D4CB-8CF5-5A8B-8DA4-1FE8DEDEDE6D","سَيَكْفِيكِ الإِله وَمُسْنَمَاتٌ","كجندلِ لبنَ تطّردُ الصّلالا"],["CFFE7729-8E6E-52AF-8DD8-4EC8D517F18F","بناتُ لبونهُ عثجٌ إليهِ","يسفنَ اللّيتَ منهُ والقذالا"],["0810C896-D72A-5399-B29E-90ADFD191FC6","لها سلفٌ يعوذُ بكلِّ ريعٍ","حمى الحوزاتِ واشتهرَ الإفالا"],["D1563F17-DEE7-51C8-9AC2-E37C5506CDD5","خراخرُ تحسبُ الصّقعيَّ حتّى","يظلَّ يقرُّ الرّاعي سجالا"],["29CC05D7-60D1-5640-AB20-466890CB26C4","إِذَا غُزْرُ الْمَحَالِبِ أَتْأَقَتْهُ","يمجُّ على مناكبهِ الثّمالا"],["9FEB300C-076D-5C51-8DCF-0CE30E5E4672","فَلَمَّا جَاوَزَ الرَّبَلاَتِ مِنْهَا","إلى الكاذاتِ باتَ بها وقالا"],["F7319BB2-4031-5187-8A46-DE216FAD1D54","تَرَعَّى مِنْ جُنُوبِ ثُعَالِبَاتٍ","أَسِرَّةَ عَازِبٍ نَحَرَ الْهِلاَلاَ"],["AAEE42F5-DB10-5AE8-BA67-E50DD7507F6C","إليكمْ لا نكونُ لكمْ خلاةً","ولا نكعَ النّقاوى إذْ أحالا"]]},"D0A4E286-12B6-58B1-94E7-C0A1A4B0445C":{"t":"وَيَبْتَذِلُ النَّفْسَ الْمَصُونَةَ نَفْسَهُ","p":68,"s":"ويبتذل النفس المصونة نفسه","r":"438860","v":[["BA4536D5-2738-5B62-9802-0CA7823C4B20","وَيَبْتَذِلُ النَّفْسَ الْمَصُونَةَ نَفْسَهُ","إذا ما رأى حقًّا عليهِ ابتذالها"]]},"04F48965-1CCE-5E19-8099-227FE9FCA03D":{"t":"وَيُدْنِي ذِرَاَعيْهِ إذَا مَا تَبَادَرَا","p":68,"s":"ويدني ذراعيه إذا ما تبادرا","r":"438868","v":[["7CAAF0E1-B989-5E42-8DB6-0D620C0826E8","وَيُدْنِي ذِرَاَعيْهِ إذَا مَا تَبَادَرَا","إلى رأسِ صلٍّ قائمِ العينِ أسفعِ"]]},"28FF6652-03C1-5588-80BE-3F055FFC576E":{"t":"يا أهلِ ما بالُ هذا اللّيلِ في صفرِ","p":68,"s":"يا أهل ما بال هذا الليل في صفر","r":"438855","v":[["645241AB-4CEA-5656-94CC-F5D0A1910AA3","يا أهلِ ما بالُ هذا اللّيلِ في صفرِ","يَزْدادُ طُولاً وَمَا يَزْدادُ مِنْ قِصَرِ"],["FF92BDB2-1257-58A3-84AA-F35EC2CB3BEB","فِي إثْرِ مَنْ قُطِّعَتْ مِنِّي قَرِينَتُهُ","يَوْمَ الْحَدَالَى بِأسْبَابٍ مِنَ الْقَدَرِ"],["3AC4DB3D-7CB8-5FEC-97E7-02D89D2FC86D","كَأنَّمَا شُقَّ قَلْبي يَوْمَ فَارقَهُمْ","قِسْمَيْنِ بَيْنَ أخِي نَجْدٍ وَمُنْحَدِرِ"],["EF23901C-9454-534D-8D59-7BA7BBF0DE57","همُ الأحبّةُ أبكي اليومَ إثرهمُ","قدْ كنتُ أطربُ إثرَ الجيرةِ الشّطرِ"],["8483AAA4-D924-51A2-80DB-F315C7F57A68","فَقُلْتُ والْحَرَّةُ الرَّجْلاَءُ دُونَهُمُ","وبطنُ لجّانَ لمّا اعتادني ذكري"],["DD3F5A2B-E7AF-5386-8CDB-6F56F046FAA3","صَلَّى عَلَى عَزَّةَ الرَّحْمنُ وَابْنَتِهَا","ليلى وصلّى على جاراتها الأخرِ"],["92D51316-BA7E-552F-8AD6-5F61629F2051","هنَّ الحرائرُ لا ربّاتُ أحمرةٍ","سودُ المحاجرِ لا يقرأنَ بالسّورِ"],["E716EEC6-E7E2-5F38-BE26-C61F64C0A493","وارينَ وحفًا رواءً في أكمّتهِ","مِنْ كَرْمِ دُومَةَ بَيْنَ السَّيْحِ وَالْجُدُرِ"],["C72F251F-78BE-5A2B-8827-0BF53305B0BC","تلقى نواطيرهُ في كلِّ مرقبةٍ","يَرْمُونَ عَنْ وَارِدِ الأفْنَانِ مُنْهَصِرِ"],["DD18F30F-F478-57BA-8699-CD388C29CD72","يَسْبِينَ قَلْبِي بِأَطْرَافٍ مُخَضَّبَةٍ","وبالعيونِ وما وارينَ بالخمرِ"],["1A8A93A8-CB88-57E2-920F-31403B796E13","عَلَى تَرَائِبِ غِزْلاَنٍ مُفَاجَأَةٍ","ريعتْ فأقبلنَ بالأعناقِ والعذرِ"],["A4F77AEE-1BB9-5E75-B127-C02EDEB660F4","لا تعمَ أعينُ أصحابٍ أقولُ لهمْ","بالأنبطِ الفردِ لمّا بذّهمْ بصري"],["CCE9AC1F-4306-57D1-914E-1784D689BEE0","هل تؤنسونَ بأعلى عاسمٍ ظعنًا","ورّكنَ فحلينِ واستقبلنَ ذا بقرِ"],["6E37BAC3-B456-5BD5-B8FC-3EF7935C47B4","بَيَّنَهُنَّ بِبَيْنٍ مَا يُبَيِّنُهُ","صحبي وما بعيونِ القومِ منْ عورِ"],["6B2AD83E-5A59-5A8F-882E-CE1D6FF401B6","يَبْدُونَ حِيناً وَأحْيَانَاً يُغَيِّبُهُمْ","مِنِّي مَكَامِنُ بَيْنَ الْجَرِّ والْحَفَرِ"],["C3652C4D-3860-5269-BDF8-3DD6C092CE96","تَحْدُو بِهِمْ نَبَطٌ صُهْبٌ سِبَالُهُمُ","منْ كلِّ أحمرَ منْ حورانَ مؤتجرِ"],["C672FCF1-A954-5665-B494-854A382E40AC","عومَ السّفينِ على بختٍ مخيّسةٍ","والْبُخْتُ كَاسِيَةُ الأَعْجَازِ وَالْقَصَرِ"],["562343D8-4C3F-5FD6-AAE5-F1367A821CAD","كَأنَّ رِزَّ حُدَاةٍ فِي طَوَائِفِهِمْ","نوحُ الحمامِ يغنّي غايةَ العشرِ"],["810890A6-ED87-5402-ADCA-AB87177DB47E","أتبعتُ آثارهمْ عينًا معوّدةً","سَبْقَ الْعُيُونِ إذَا اسْتُكْرِهْنَ بِالنَّظَرِ"],["1452883B-6A79-5E52-B06D-F4D815A4C39E","وبازلٍ كعلاةِ القينِ دوسرةٍ","لَمْ يُجْذِ مِرْفَقُهَا في الدِّفْءِ مِنْ زَوَرِ"],["AE43782D-8D2E-5242-88DF-6D4D53135922","كأنّها ناشطٌ حرٌّ مدامعهُ","منْ وحشِ حبرانَ بينَ القنعِ والضّفرِ"],["54561BD0-F9BA-5C3A-89D5-5DADF38325E4","بَاتَ إلَى هَدَفٍ فِي لَيْلِ سَارِيَةٍ","يَغْشَى الْعِضَاةَ بِرَوْقٍ غَيْرِ مُنْكَسِرِ"],["1C98A6E5-6E84-536C-A164-2B83E7396F46","يخاوشُ البركَ عنْ عرقٍ أضرَّ بهِ","تجافيًا كتجافي القرمِ ذي السّررِ"],["8C51A8C0-D63C-50FD-AE9E-6A572E5725BD","إذَا أَتَى جَانِباً مِنْهَا يُصَرِّفُهُ","تَصَفُّقُ الرِّيحِ تَحْتَ الدِّيمَةِ الدِّرَرِ"],["3D5FD3F3-C9C7-59B3-8333-853B8D365524","حتّى إذا ما انجلتْ عنهُ عمايتهُ","وقلّصَ اللّيلُ عنْ طيّانَ مضطمرِ"],["816DB973-7CE9-5F2F-9D40-C42015E65640","غدا كطالبِ تبلٍ لا يورّعهُ","دُعَاءُ دَاعٍ وَلاَ يَلْوِي عَلَى خَبَرِ"],["911B623E-63BF-5D97-878B-C3C6234B80E9","فَصَبَّحَتْهُ كِلاَبُ الْغَوْثِ يُؤْسِدُهَا","مستوضحونَ يرونَ العينَ كالأثرِ"],["31798DAA-ED87-5F4C-BC4E-8F90F4AC03C3","أوْجَسَ بِالأُذْنِ رِزّاً مِنْ سَوَابِقِهَا","فجالَ أزهرُ مذعورٌ منَ الخمرِ"],["6DA121A0-D234-5F7F-B282-7795909D1B0C","واجتازَ للعدوةِ القصوى وقدْ لحقتْ","غضفٌ تكشّفُ عنها بلجةُ السّحرِ"],["90A7A803-E7F6-52D8-A6BC-8232C5E61025","فكرَّ ذو حوزةٍ يحمي حقيقتهُ","كصاحبِ البزِّ منْ حورانَ منتصرِ"],["96CB0EB5-8D63-50BE-893E-6E64FDD997F2","فَظَلَّ سَابِقُهَا في الرَّوْقِ مُعْتَرِضاً","كَالشَّنِّ لاَقَى قَنَاةَ اللاَّعِبِ الأَشِرِ"],["106390E8-C261-53CA-BE51-548824F26A31","فردّها ظلعًا تدمى فرائضها","لمْ تدمَ فيهِ بأنيابٍ ولا ظفرِ"],["E46439CD-67A4-59E0-9FFA-4A801CC0BBC9","فَظَلَّ يَعْلُو لِوَى دِهْقَانَ مُعْتَرِضاً","يَرْدي وأظْلاَفُهُ صُفْرٌ مِنَ الزَّهَرِ"],["515269D1-C3DC-584C-89EB-9E3D0428A46B","أذَاكَ أمْ مِسْحَلٌ جَوْنٌ بِهِ جُلَبٌ","منَ الكدامِ فلا عنْ قرّحٍ نزرِ"],["61D6AB48-A57D-5664-B108-DC99374968F8","قُبِّ الْبُطُونِ نَفَى سِرْبَالَ شِقْوَتِهَا","سِرْبَالُ صَيْفٍ رَقِيقٍ لَيِّنُ الشَّعَرِ"],["9BC83004-F691-5BE8-9DB4-E491434D3CEF","لمْ يبرِ جبلتها حملٌ تتابعهُ","بَعْدَ اللِّطَامِ وَلمْ يَغْلُظْنَ مِنْ عُقُرِ"],["9073C977-C6C9-5149-8744-447BD36EA918","كَأنَّهَا مُقُطٌ ظَلَّتْ عَلَى قِيَمٍ","منْ ثكدَ واعتركتْ في مائهِ الكدرِ"],["97B54E6C-BC57-5A04-88C1-177F80D1A4CA","شُقْرٌ سَمَاوِيَّةٌ ظَلَّتْ مُحَلأَةً","بِرِجْلَةِ التَّيْسِ فَالرَّوْحَاءِ فالأَمَرِ"],["FEE0AAC0-31A9-5C71-B58B-CA4F51D8C55B","كانتْ بجزءٍ فملّتها مشاربهُ","وأخلفتها رياحُ الصّيفِ بالغدرِ"],["18BA49E7-C18A-52C0-A0EF-4695EDE5CEF0","فَرَاحَ قَبْلَ غُرُوبِ الشَّمْسِ يَصْفِقُهَا","صفقَ العنيفِ قلاصَ الخائفِ الحذرِ"],["72CA9732-F947-5EE9-A8DC-A945C1691898","يخرجنَ باللّيلِ منْ نقعٍ لهُ عرفٌ","بِقَاعِ أمْعَطَ بَيْنَ السَّهْلِ والصِّيَرِ"],["AD30846B-92EF-55EC-8257-2EC4B697516D","حتّى إذا ما أضاءَ الصّبحُ وانكشفتْ","عَنْهُ نَعَامَةُ ذي سِقْطَيْنِ مُعْتَكِرِ"],["7C4FFE9D-43C5-5767-84EB-18DE2A0B97E8","وصبّحتْ بركَ الرّيّانِ فاتّبعتْ","فيهِ الجحافلُ حتّى خضنَ بالسّررِ"],["817BB3C5-601E-545D-BB46-85150F7C2B3F","حتّى إذا قتلتْ أدنى الغليلِ ولمْ","تَمْلأَ مَذَاخِرَهَا لِلرِّيِّ والصَّدَرِ"],["8544C88D-162A-5C93-BF22-E57D56461A26","وَصَاحِبَا قُتْرَةٍ صُفْرٌ قِسِيُّهُمَا","عِنْدَ الْمَرَافِقِ كالسِّيدَيْنِ في الْحُجَرِ"],["C8AFAC41-C56A-5EEA-A07F-CFF407F479B0","تنافساالرّميةَ الأولى ففازَ بها","مُعَاوِدُ الرَّمْيِ قَتَّالٌ عَلَى فُقَرِ"],["3034D43B-2A24-5827-90FC-7DEB560A073E","حتّى إذا ملأَ الكفّينِ أدركهُ","جَدٌّ حَسُودٌ وَخَانَتْ قُوَّةُ الْوَتَرِ"],["9E3B4B71-2861-5468-BBA2-E58812E4181A","فَانْصَعْنَ أسْرَعَ مِنْ طَيْرٍ مُغَاوِلَةٍ","تَهْوي إلى لاَبَةٍ مِنْ كَاسِرٍ خَدِرِ"],["104D2BDA-0C24-54A2-A01B-C23F89BF5AAA","إذَا لَقِينَ عَرُوضاً دُونَ مَصْنَعةٍ","ورّكنَ منْ جنبها الأقصى لمحتضرِ"],["3AFD442D-FBC2-51AB-B43F-79AE73CEDD18","فَأطْلَعَتْ فُرْزَةَ الآجَامِ جَافِلَةً","لمْ تدرِ أنّى أتاها أوّلُ الذّعرِ"],["F31F0935-97ED-536F-BD60-0183D30AED1A","فأصبحتْ بينَ أعلامٍ بمرتقبٍ","مُقْوَرَّةً كَقِدَاحِ الْغَارِمِ الْيَسَرِ"],["D5B7A71A-43CA-5402-9D76-8A0B18B37C23","يَزُرُّ أكْفَالَهَا غَيْرَانُ مُبْتَرِكٌ","كاللَّوْحِ جُرِّدَ دَفَّاهُ مِنَ الزُّبُرِ"],["D0A238A3-DE39-50A6-974B-2208D4E82234","يجتابُ أذراها والتّربُ يركبهُ","ترسّمَ الفارطِ الظّمآنِ في الإثرِ"]]},"C9250792-472B-5FF7-A18B-3284A940A401":{"t":"يا صاحبيَّ دنا الأصيلُ فسيرا","p":68,"s":"يا صاحبي دنا الأصيل فسيرا","r":"438858","v":[["C3508539-36F6-5B04-9E25-9D7F4BD96FC4","يا صاحبيَّ دنا الأصيلُ فسيرا","غَلَبَ الْفَرَزْدَقُ في الهِجَاءِ جَرِيرَا"]]},"386651A0-D6F8-53CB-810C-1646D87C51E2":{"t":"يا عجباً للدّهرِ شتّى طرائقهْ","p":68,"s":"يا عجبا للدهر شتى طرائقه","r":"438880","v":[["B6185E5D-BAC3-5CA9-88EF-54A345A2938D","يا عجباً للدّهرِ شتّى طرائقهْ","وللمرءِ يبلوهُ بما شاءَ خالقهْ"],["9FDA67D3-38C9-5E68-BD4F-2A224D21E4A2","وللخلدِ يرجى والمنيّةُ دونهُ","وَلِلأَمَلِ الْمَبْسُوطِ والْمَوْتُ سَابِقُهْ"],["0816D338-0919-5907-B461-27E0CE941775","جَعَلْنَ أَرِيكاً بِالْيَمِينِ وَرَمْلَهُ","وزالَ لغاطٌ بالشّمالِ وحالقهْ"],["B8D7A790-125B-5D57-B5F2-0E8651DAFE05","وصبّحنَ بالصّقرينِ صوبَ غمامةٍ","تَضَمَّنَهَا لَحْيَا غَدِيرٍ وَخَانِقُهْ"],["9C4C530A-439E-5269-A974-1D2BC85ABF38","وَأمْسَتْ بأطْرَافِ الْجَمَادِ كَأنَّهَا","عَصَائِبُ جُنْدٍ رَائِحٍ وَخَرَانِقُهْ"],["6366D84E-3242-560D-AF83-109D31850FD7","وصبّحنَ منْ سمنانَ عيناً رويّةً","وهنَّ إذا صادفنَ شرباً صوادقهْ"],["2AD787B8-0539-55B6-8E98-8A49873EB254","وَأَسْحَمَ حَنَّانٍ مِنَ الْمُزْنِ سَاقَهُ","طروقاً إلى جنبيْ زبالةَ شائقهْ"],["92EC62CB-7A08-5404-A680-C310E0B7F57D","فَلَمَّا عَلاَ ذَاتَ التَّنَانِيرِ صَوْبُهُ","تكشّفَ عنْ برقٍ قليلٍ صواعقهْ"],["597CD5C2-D153-534F-B3D0-2AC3BE7326FF","كفاني عرفّانُ الكرى وكفتيهُ","كلوءَ النّجومِ والنّعاسُ معانقهْ"],["52AAB6CF-A697-5ED6-8EA9-4D2D51008224","فباتَ يريهِ عرسهُ وبناتهِ","وَبِتُّ أُرِيهِ النَّجْمَ أيْنَ مَخَافِقُهْ"],["E7640739-5575-502F-8223-60D81A18F1A7","وسربالِ كتّانٍ لبستُ جديدهُ","على الرّحلِ حتّى أسلمتهُ بنائقهْ"],["425E6A2D-E9C2-5534-ABE5-C8B8EF2F9C99","وَلَذٍّ كَطَعْمِ الصَّرْخَدِيِّ طَرَحْتُهُ","عَشِيَّةَ خِمْسِ الْقَوْمِ والْعَيْنُ عَاشِقُهْ"],["FCA7FBCA-632C-5C99-BFA0-5923C99909E5","وَعَيَّرَنِي الإبْلَ الْحَلاَلُ ولَمْ يَكُنْ","ليجعلها لابنِ الخبيثةِ خالقهْ"],["9EFA3371-97C3-5CAD-911A-8AA385F5646E","وَلكِنَّمَا أَجْدَى وَأَمْتَعَ جَدُّهُ","بفرقٍ يخشّيهِ بهجهجَ ناعقهْ"],["C7AC4308-5E5A-5408-ABF8-7036CB8179FF","وَقَال الَّذي يَرْجُو الْعُلاَلَةَ وَرِّعُوا","عَنِ الْمَاءِ لاَ يُطْرَقْ وَهُنَّ طَوَارِقُهْ"],["F357B06B-C0A3-5BF7-A3FE-BFC9C63B7EA7","فَمَا زِلْنَ حَتَّى عَادَ طَرْقاً وَشِبْنَهُ","بِأَصْفَرَ تَذْرِيهِ سِجَالاً أيَانِقُهْ"],["744B9C5B-0B0F-5B92-A836-13445888A880","خَرِيعٌ مَتَى يَمْشِي الْخَبِيثُ بِأرْضِهِ","فإنَّ الحلالَ لا محالةَ ذائقهْ"],["303D6338-6D2B-52D8-B3A0-5EBD7EC678B8","تَنَاوَلَ عِرْقَ الْغَيْثِ إذْ لا يَنَالُهُ","حِمارُ ابْنُ جَزْءٍ عَاصِمٌ وَأَفَارِقُهْ"],["CA90E579-7241-5BE8-86B8-56F064C0C20F","إذَا هَبَطَتْ بَطْنَ اللَّكِيكِ تَجَاوَبَتْ","بِهِ وَکطَّبَاهَا رَوْضُهُ وَأبَارِقُهْ"],["31301B94-8644-537E-94F1-88F9437DB0A6","فَأمْسَتْ بَوَادِي الرَّقْمَتَيْنِ وَأَصْبَحَتْ","بِجَوِّ رِئَالٍ حَيْثُ بَيَّنَ فَالِقُهْ"],["BC1C5540-C1BE-5185-9144-9AE4C7E7F785","فأصبحنَ قدْ خلّفنَ أودَ وأصبحتْ","فِرَاخُ الْكَثِيبِ ضُلَّعَاً وَخَرَانِقُهْ"],["98A046EC-D8E9-52BB-8DA3-50A00844C6C0","فلمّا هبطنَ المشفرَ العودَ عرّستْ","بحيثُ التقتْ أجزاعهُ ومشارقهْ"],["EBA40F67-72A5-50FC-8646-3FD981276BBB","وصبّحنَ للعذراءِ والشّمسُ حيّةٌ","وليَّ حديثِ العهدِ جمٍّ مرافقهْ"],["834E8668-CFD4-5DD3-879A-52396A202431","يهيبُ بأخراها بريمةُ بعدها","بدا رملُ جلاّلٍ لها وعواتقهْ"],["7962EDE2-3CA4-50A8-A1E0-7FF990F9E6DA","فغادرنَ مركوّاً أكسَّ عشيّةٍ","لدى نزحٍ ريّانَ بادٍ خلائقهْ"],["83B29E6D-FF2B-5B27-B6B8-E1DD5EA881A8","تُعَيِّرُنِي صُهْباً كَأنَّ رُؤُوسَهَا","ذُرَى الأُكْمِ فِيهَا غَضُّ نَيٍّ وَعَاتِقُهْ"],["2A8FF182-1700-5F62-90B8-14A348A096B7","لَهَا فَأْرَةٌ ذَفْرَاءُ كُلَّ عَشِيَّةٍ","كما فتقَ الكافورَ بالمسكِ فاتقهْ"],["799DD746-72FB-5F02-A45B-54D37258B492","وَكَانَ لَهَا فِي أَوَّلِ الدَّهْرِ فَارِسٌ","إذا ما رأى قيدَ المئينَ يعانقهْ"],["34975F11-B49B-56F5-93A2-0BE5BC0391A8","أجدّتْ مراغاً كالملاءِ وأرزمتْ","بِنَجْدَيْ ثُقَيْبٍ حَيْثُ لاَحَتْ طَرَائِقُهْ"],["21730765-980D-5DBE-B8FE-07EF764FF709","فما نهلتْ حتّى أجاءتْ جمامهُ","إلى خَرِبٍ لاَقَى الْخَسِيفَةَ خَارِقُهْ"],["810B91ED-7406-5755-A711-43D287D55043","وأزهرَ سخّى نفسهُ عنْ تلادهِ","حنايا حديدٍ مقفلٍ وسوارقهْ"],["25B2D31B-C698-522D-9BDD-6D009A4FC673","فَإنْ يُودِ رِبْعِيُّ الشَّبَابِ فَقَدْ أُرَى","ببطانهِ قدّامَ سربٍ أوافقهْ"],["55AD66F6-A586-53F4-93A7-875829300DAE","... فما تنفكُّ دلوٌ تواهقهْ","................"]]},"310C6911-2424-535F-B83A-D6EAF63257FA":{"t":"يا منْ توعّدني جهلاً بكثرتهِ","p":68,"s":"يا من توعدني جهلا بكثرته","r":"438833","v":[["7CD5BBB9-9D8E-57A7-9F8B-B8B923634109","يا منْ توعّدني جهلاً بكثرتهِ","متى تهدّدني بالعزِّ والعددِ"],["6AC446E1-08D4-5A83-B4B8-C8C82AE1D1A8","فَاقْدِرْ بِذَرْعِكَ إنِّي لَنْ يُقَوِّمَنِي","قولُ الضّجاجِ إذا ما كنتُ ذا أودِ"],["1CFA4AFB-81F6-5F04-80CB-55DBC1DFAD84","لاَ تَحْسِبَنِّيَ مَجْهُولاً بِمَخْبَأَةٍ","إنِّي أنَا الْبَدْرُ لاَ أخْفَى عَلى أحَدِ"],["B80E5CBB-1F44-5D16-9883-655389DF18BF","إنْ كنتَ ناقلَ عزّي عنْ مباءتهِ","فَانْقُلْ أبَانَاً بِمَا جَمَّعْتَ مِنْ عَدَدِ"],["A06810AC-F4A9-53C1-9B23-BDD1BA2D176C","والهضبَ هضبَ شرورى إنْ مررتَ بهِ","ورحرحانَ فأطلعهُ إلى أحدِ"],["3C4D2415-D64D-5FE8-B508-DDB57162B9D7","إنّي وَجدْتُكَ وَرَّاداً إذَا انْقَطَعَتْ","عُمْيُ الْمَوَارِدِ صَدَّاراً عَنِ الْوُرُدِ"],["58081D70-F040-5B33-9322-49708BD6486E","أنْتَ امْرُوٌّ نَالَ مِنْ عِرْضِي وَعِزَّتُهُ","كَعِزَّةِ الْعَيْرِ يَرْعَى تَلْعَةَ الأَسَدِ"],["2C12A691-C9A8-5E71-ABA2-F37283D3265B","جاءتْ بهِ منْ قرى بيسانَ تحملهُ","سَوْأى مُخَضَّرَةُ الآبَاطِ والْكَتِدِ"],["156B22E5-6C03-516E-AF64-A24EF7D8C6B1","لَوْ كُنْتَ مِنْ أَحَدٍ يُهْجَى هَجَوْتُكُمُ","يَاابْنَ الرِّقَاعِ وَلَكِنْ لَسْتَ مِنْ أَحَدِ"],["F55560EE-EF07-5F38-86F3-A492A182C66F","تأبى قضاعةُ انْ تعرفْ لكمْ نسبًا","وابْنَا نِزَارٍ فَأَنْتُمْ بَيْضَةُ الْبَلَدِ"],["19259B0B-BC40-5F74-9051-9746F534593C","بِيضُ الْوُجُوهِ مَطَاعِيمٌ إذَا يَسَرُوا","ردّوا المخاضَ على المقرومةِ العندِ"],["2F39E192-8EEB-5786-897E-A6B9DDDD1D50","وموقدِ النّارِ قدْ بادتْ حمامتهُ","مَا إنْ تَبَيَّنَهُ في جُدَّةِ الْبَلَدِ"],["8CF2B776-DC12-55C7-BC7C-7E113E2B1D52","كانتْ بها خرفًا وافٍ سنابكها","فطأطأتْ بؤرةً في رهوةٍ جددِ"]]},"7EBED5F4-2815-5CFA-8BCF-1A643A5FC8C4":{"t":"يبتنَ سجودًا منْ نهيتِ مصدّرٍ","p":68,"s":"يبتن سجودا من نهيت مصدر","r":"438884","v":[["439B025F-DBDD-56CC-9534-40C002A8A65E","يبتنَ سجودًا منْ نهيتِ مصدّرٍ","بِذَكْوَةَ إطْرَاقَ الظِّبَاءِ مِنَ الْوَبْلِ"],["7C5645E9-8958-5419-BD5F-72C2DDB3851B","فلا ردّها ربّي إلى مرجِ راهطٍ","وَلاَ أَصْبَحَتْ تَمْشِي بِسَكَّاءَ فِي وَحْلِ"],["D7B94653-025F-5DEB-90F1-1D7CCE89112C","سارتْ وأتلتها رفيدةُ ذمّةً","تَسِيرُ بِهَا بَيْنَ الأَقَاعِسِ فالرَّمْلِ"]]},"028623CA-BE6E-54D2-A6B6-FF696202C664":{"t":"يمسي ضجيعَ خريدةٍ ومضاجعي","p":68,"s":"يمسي ضجيع خريدة ومضاجعي","r":"438864","v":[["ECBB01F0-E602-5AFE-8EB6-619284276102","يمسي ضجيعَ خريدةٍ ومضاجعي","عضبٌ رقيقُ الشّفرتينِ حسامُ"],["3BE2E362-38DC-5911-B051-1E38D835E867","وَالْحَرْبُ حِرْفَتُنَا وَبِئْسَتْ حِرْفَةٌ","إلاَّ لِمَنْ هُوَ فِي الْوَغَى مِقْدَامُ"],["A436AD0D-AA6F-5FA1-8D75-E05F00FE6169","نُعْري السُّيُوفَ فَلاَ تَزَالُ عَوَارِياً","حَتَّى تَكُونَ جُفُونَهُنَّ الْهَامُ"],["904A77C1-B92B-5EDB-AF58-9FEF17CD4343","وَالْمَوْتُ يَسْبِقُنَا إلَى أَعْدائِنَا","تهفو بهِ الرّاياتُ والأعلامُ"]]},"89440BFD-123B-54F8-852B-BB5BA5C6DA8C":{"t":"يَا لَيْتَ أنِّي وَسُبَيْعاً في الْغَنَمْ","p":68,"s":"يا ليت أني وسبيعا في الغنم","r":"438861","v":[["490154EE-58CE-5C74-BD5D-EEA2C569802C","يَا لَيْتَ أنِّي وَسُبَيْعاً في الْغَنَمْ","وَالْخُرْجُ مِنْهَا فَوْقَ كَرَّازٍ أجَمْ"]]}}}