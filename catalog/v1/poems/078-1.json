{"v":1,"poems":{"E9D0CC31-0B88-5E88-BC3E-F3F6AE776974":{"t":"قلَّ في شطِّ نهروانَ اغتماضي","p":78,"s":"قل في شط نهروان اغتماضي","r":"439210","v":[["0BDA28AB-BEC4-5044-8610-396F41FF8DFC","قلَّ في شطِّ نهروانَ اغتماضي","ودَعَاني هَوَى العُيُونِ المِراضِ"],["FDC3910A-F644-5D20-BB7E-9CE98EA4A4EC","فَتَطَرَّبْتُ لِلْهَوَى، ثُمَّ أقْصَرْ","تُ رِضاً بالتُّقَى، وذُو البِرِّ راضي"],["7070B5FD-2ABD-536D-94C0-524754171A41","وأرَانِي المَليكُ رُشْدِي، وقَدْ كُنْـ","ـتُ أخَا عُنْجُهِيَّةٍ واعْتِراضِ"],["D3437277-FB90-5BCC-BD0F-9FC07362AA4C","غيرَ مَا ريبةٍ سوَى ريِّقِ الغرَّ","ة، ثمَّ ارعويتُ عندَ البياضِ"],["C7A8238F-1771-509B-B416-23D65F1BBD40","لاَتَ هَنَّا ذِكْرَى بُلَهْنِيَةِ الدَّهْـ","ـرِ، وأنَّى ذِكْرَى السِّنِينَ المَواضي"],["FD541764-152F-5114-91FF-71EBFE785E33","فاذهبوا ما إليكُمْ، خفضَ الحلـ","ـمُ عِناني، وعُرِّيَتْ أنْقاضي"],["FFC5536D-7176-536B-82CE-944FB4AAE161","وذَهَلْتُ الصِّبا، وأرْشَدَني اللَّـ","ـهُ بدهرٍ ذي مرَّةٍ وانتقاضِ"],["AB71DAF0-7702-5319-B11A-8A091A8FEC1B","وجرَى بالّذي أخافُ منَ البيـ","ـنِ لَعِينٌ يَنُوضُ كُلَّ مَنَاضِ"],["192C71E2-F563-5DA2-A71B-D339F123E91D","صَيْدَحِيُّ الضُّحَى، كَأنَّ نَسَاهُ","حينَ يجتثُّ رجلَهُ، في إباضِ"],["EE6C2FD6-CFEE-5F68-A785-51F2D0832C6C","فسوفَ تدنيكَ منْ لميسَ سبنْتَا","ةُ أمَارَتْ بالبَوْلِ ماءَ الكِرَاضِ"],["C77669DF-3811-50DD-9B61-338F81F0BA06","أضمرتْهُ عشرينَ يوماً، ونيلَتْ","حينَ نيلَتْ يعارةً في عراضِ"],["580EC967-560B-5C84-886C-ABF09BDE6211","فهْيَ قوداءُ، نفِّجتْ عضُداها","عنْ زحاليقِ صفصفٍ ذي دحاضٍ"],["2BC58863-1701-5DFB-8F5D-6A8D83CF5199","عَوْسَرَانِيَّةٌ إِذَا انْتَفَضَ الخِمْـ","ـسُ نطافَ الفظيظِ أيَّ انتفاضِ"],["78A6B1DA-5E25-51BD-A177-3A1069A9B4F3","وأوَتْ بِلَّةُ الكَظُومِ إلى الفَـ","ـظِّ، وجالَتْ معاقدُ الأرباضِ"],["21C3D7F3-DAC5-501A-9E5D-20EFB112E634","مِثْلُ عَيْرِ الفَلاةِ، شَاخَسَ فَاهُ","طُولُ كَدِمْ القَطَا وطُولُ العِضَاضِ"],["42EA926C-D604-5B44-9061-1A290F9A39CD","صنتُعُ الحاجبينِ، خرَّطةُ البقـ","ـلُ بديَّاً قبلَ استكاكِ الرِّياضِ"],["1839BFC5-71D9-5D42-AF52-4F784958B3AB","فهْوَ خلوُ الأعصالِ إلاَّ منَ الما","ءِ ومَلْهُودِ بَارِضٍ ذِي انْهيَاضِ"],["D3323C91-F9DB-5715-814B-A6123C214B5B","ويَظَلُّ المَليَّ يُوفي عَلَى القَرْ","نِ عَذُوباً كالحُرْضَةِ المُسْتَفاضِ"],["A7C41D59-F38A-5166-BEFF-43680D7474D4","يرعمُ الشَّمسَ أنْ تميلَ بمثلِ الـ","ـجبءِ، جأبٌ مقذَّفٌ بالنِّحاضِ"],["13144C0F-D59D-5528-84B6-87B68467BE30","وخَوِيٍّ سَهْلٍ، يُثِيرُ بِهِ القَوْ","مُ رباضاً للعينِ بعدَ رباضِ"],["2BF6A1E6-7F75-5DCC-8F54-6A7FB5D1E7AA","وقلاصاً لمْ يغذُهُنَّ غبوقٌ","دَائِماتِ النَّحِيمِ والإِنْقَاضِ"],["079864C6-B3F3-5E1A-ACDA-A46610615756","ومحاريجَ منْ سعارٍ وغينٍ","وغماليلِ مدجناتِ الغياضِ"],["D38AADEA-B685-5A2F-8D1C-4AA8FBB197D5","ملبساتِ القتامِ، يمسي عليهَا","مِثْلُ سَاجِي دَوَاجِنِ الحَرَّاضِ"],["BADCAFA5-E6D4-5CD6-8C75-13F32A7A4155","فَتَرَى الكُدْرَ في مَنَاكِبِها الغُبْـ","ـرِ رَذَايَا مِنْ طُولِ انْقِضَاضِ"],["F047CE10-DFD3-5DEB-B355-07DE8BE689D6","كَبَقَايَا الثُّوَى نُبِذْنَ مِنَ الصَّيْـ","ـفِ جنوحاً بالجرِّ ذي الرِّضراضِ"],["DC353635-A7BA-5A53-8AE9-6983ABB28586","أوْ كمحلوجِ جعثنِ بلَّهُ القطـ","ـر، فَأَضْحَى مُوَدِّسَ الأعْرَاضِ"],["AD95B49E-EDD1-53F1-B089-4E68E81D1601","قدْ تجاوزتُها بهضَّاءَ كالجنـَّ","ـةِ يُخْفُونَ بَعْضَ قَرْعِ الوِفَاضِ"],["1E2EE6B9-0F7B-5F0D-A120-EA773099EAA0","إنَّنا معشرٌ، شمائلُنا الصَّبـ","ـرُ إذا الخوفُ مالَ بالأحفاضِّ"],["4485721D-C0D4-5B32-929E-0C1E74BB154A","نُصُرٌ لِلذَّلِيلِ في نَدْوَةِ الحَيْـ","ـيِ، مَرائِيبُ لِلثَّأَى الُمنْهاضِ"],["CD41890B-534F-56FB-9B67-CC8FF6B2410E","لمْ يفتْنا بالوترِ قومٌ، وللضَّيـ","ـمِ رجالٌ يرضونَ بالإغماضِ"],["0AFA2F9F-1F4A-5171-A7AB-96298FBAB01E","فيهمُ سطوةٌ إذا الحلمُ لمْ يقْـ","ـبلْ، وفيهمْ تجاوزٌ وتغاضي"],["A55165E6-6DC9-5DD1-B320-A1B51FF7D76A","منْ يرمْ جمعهمْ يجدهُمْ مراجيـ","ـحَ حُمَاةً لِلْعُزَّلِ الأحْرَاضِ"],["F36A6F84-9F98-566A-A2A9-3E20920BBAEE","طيِّبي أنفسٍ، إذا رهبُوا الغا","رةَ نمشي إلى الحتوفِ القواضي"],["4226F20E-9B3D-5E4E-87C7-B82B4003679F","فسلِ النَّاسَ إنْ جهلتَ، وإنْ شئـْ","ـتَ قضَى بيننا وبينَكَ قاضي"],["F902F474-B680-5B0B-A8A4-F5B4B7A97778","هَلْ عَدَتْنا ظَعِينَةٌ تَطْلُبُ العِزَّ","مِنَ النَّاسِ في الخُطوبِ المَوَاضي"],["2631DA6E-A768-54F1-A102-28EB593F7A69","كمْ عدوٍّ لنَا قراسيةِ العزِّ","تركنا لحماً على أوفاضِ"],["05293879-439A-5B8A-9FC8-F45E3AE64C44","وجلبنْنا إليهمُ الخيلَ فاقتيـ","ـضَ حِمَاهُمْ، والحَرْبُ ذَاتُ اقْتِيَاضِ"],["0F3C5436-EADE-58D4-85E8-CA6B84A2E395","بِجِلادٍ يَفْرِي الشُّؤُونَ وطَعْنٍ","مِثْلِ إِيزَاغِ شَامِذَاتِ المَخاضِ"],["77E16998-AF32-5A73-8529-3F1CE56807A8","ذِي فُرُوغٍ، يَظَلُّ مِنْ زَبَدِ الجَوْ","فِ عَلَيْهِ كَثامِرِ الحُمَّاضِ"],["6D9FBB48-0C5F-592F-84E5-FAA37FB494CA","نَقَبَتْ عَنْهُمُ الحُرُوبُ، فَذاقُوا","بَأْسَ مُسْتَأْصِلِ العِدَى مُبْتَاضِ"],["B24C892A-65A8-5825-A900-7B9D773B7D85","كلُّ مستأنسٍ إلى الموتِ، قدْ خا","ضَ إليهِ بالسَّيفِ كلَّ مخاضِ"],["F80627DA-20B3-5C6A-9222-7CD638D3EF95","لاَ يَني يخمضُ العدوًّ، وذو الخلَّـ","ـةِ يُشْفَى صَداهُ بالإحْمَاضِ"],["D3FFF117-69A3-5243-9E02-31073489A6A8","حِينَ طَابَتْ شَرائِعُ المَوْتِ، والمَوْ","تُ مِرَاراً يَكُونُ عَذْبَ الحِيَاضِ"],["D23FAD7D-7209-59A3-883E-102C3C443294","باللَّواتي لمْ يتَّركنَ عقاقاً،","والمذاكي ينهضنَ أيَّ انتهاضِ"],["AD5F769C-0F74-594E-B1AC-0ED603939F7E","تلكَ أحسابُنا إذا احتتنَ الخصـ","ـلُ، ومُدَّ المَدَى مَدَى الأَغْرَاضِ"]]},"F541FB3C-53C4-527C-AFD7-B5BBCE14B356":{"t":"قُطِرَتْ وأَدْرَجَها الوَجِيفُ وضَمَّها","p":78,"s":"قطرت وأدرجها الوجيف وضمها","r":"439238","v":[["8A917A08-009E-5324-9DAD-4EAED8135D82","قُطِرَتْ، وأَدْرَجَها الوَجِيفُ وضَمَّها","شدُّ النُّسوعِ إلى شجورِ الأقتدِ"]]},"F4717DC3-4B58-53DE-89C0-6E2E750F6AEA":{"t":"كأنَّ بلادَ اللهِ وهيَ عريضةٌ","p":78,"s":"كأن بلاد الله وهي عريضة","r":"439250","v":[["CEEAED64-7FCC-5C7F-89B5-5BACB70E42DB","كأنَّ بلادَ اللهِ وهيَ عريضةٌ","على الخائفِ المذعورِ كفَّةُ حابلِ"],["17715304-A960-52A0-BCED-512CE195161A","يُؤدَّى إِلَيْهِ أَنَّ كُلَّ ثَنِيَّةٍ","تَيَمَّمَها تَرْمِي إِلَيْهِ بِقَاتِلِ"]]},"9230B52C-28BC-560A-8C3D-95E82117699A":{"t":"لاَ تسكننَّ إلى سكونٍ إنَّما","p":78,"s":"لا تسكنن إلى سكون إنما","r":"439223","v":[["E2F23255-D427-5A5C-9FB7-37F5DD03A533","لاَ تسكننَّ إلى سكونٍ، إنَّما","عُذْرُ الفَتَى ألاَّ يُرَى مُحرنَجِمَا"],["B3CE0795-A8A9-5BF2-8A60-D24EFAFC3EAF","مُسْتَأْنِسَاً بِالأَهْلِ كَيْما يُجْتَوَى","مُتَوَشِّحاً بِالفَقْرِ فِيهِمْ مُعْدِمَا"],["11BC66EB-3926-581D-AF96-C06E76FF3DA2","فتألَّفَ السُّهَّدَ في طلبِ العلَى","واستصحبِ السَّيفَ الحسامَ المخذما"],["92D51893-B57C-50E5-B8B6-FBF772BDDDB7","فَالطَّيْرُ لَوْلاَ أَنَّها جَوَّالَةٌ","لَمْ تُلْفِ في أَوْكَارِهِنَّ المَطْعَمَا"],["971BA0AB-9979-53CD-BC2C-5E59DEF9652E","قدْ جاءَ في الأمثالِ قولٌ سائرٌ","لِمُهَذَّبٍ وَزَنَ الكَلاَمَ وقَوَّمَا"],["14A0677E-5AFA-526D-8D17-8E0B4277CE3F","لاَ خَيْرَ في رَجُلٍ يُجَالِسُ عِرْسَهُ","ويَبِيعُ قُرْطَيْها إِذَا مَا أَعْدَمَا"]]},"EF862ADA-DE24-5F25-8CB5-8D9B9C695048":{"t":"لقدْ شقيتُ شقاءً لاَ انقطاعَ لهُ","p":78,"s":"لقد شقيت شقاء لا انقطاع له","r":"439207","v":[["49E9D291-7C49-5BC4-858C-7AC06849334B","لقدْ شقيتُ شقاءً لاَ انقطاعَ لهُ","إِنْ لَمْ أَفُزْ فَوْزَةً تُنْجِي مِنَ النَّارِ"],["7167BEC5-6B69-5C35-B4F9-BA97BCB2B15D","والنَّارُ لمْ ينجُ منْ روعاتِها أحدٌ","إِلاَّ المُنِيبُ بِقَلْبِ المُخْلِصِ الشَّارِي"],["A71BC678-6EBC-55CB-A7C1-BCC3C214D3BE","أوِ الَّذي سبقتْ منْ قبلِ مولدِهِ","لَهُ السَّعَادَةُ مِنْ حَلاَّقِها البَارِي"]]},"F65E919C-69D5-560F-BA27-DDEC0508110E":{"t":"لقدْ علمَ المعذَّلُ يومَ يدعُو","p":78,"s":"لقد علم المعذل يوم يدعو","r":"439230","v":[["22ACC7D7-5FFC-5BB1-B039-B2A47B7DD56C","لقدْ علمَ المعذَّلُ يومَ يدعُو","بِذِئْبةَ يَوْمَ ذِئْبَةَ إِذْ دَعَانَا"],["379907B9-B4FA-5B3E-BFFD-0F6CCD61D010","فوارسُ طيِّىءٍ منعُوهُ لمَّا","بَكَى جَزَعاً، ولَوْلاَهُمْ لَحَانَا"]]},"8FC5DABA-4E4A-5F46-B630-529E50BC036D":{"t":"لولاَ فوارسُ مذحجِ ابنةِ مذحجٍ","p":78,"s":"لولا فوارس مذحج ابنة مذحج","r":"439206","v":[["44CEC6DE-900C-51D6-993E-03EB99602DE9","لولاَ فوارسُ مذحجِ ابنةِ مذحجٍ","والأزدِ زعزعَ واستُبيحَ العسكرُ"],["7235732A-FD2F-5F3C-8706-2DCBFFC345AA","وتَقَطَّعَتْ بِهِمُ البِلادُ، ولَمْ يَؤُبْ","منهُمْ إلى أهلِ العراقِ مخبِّرُ"],["308E8315-ABBA-5E17-843A-1C92162F86BA","واستطلقتْ عُقدُ الجماعةِ، وازْدري","أمْرُ الخَلِيفَةِ، واسْتُحِلَّ المُنْكَرُ"],["D3720175-729A-5F26-8DB2-3AF69ECE25A3","قَوْمٌ هُمُ قَتَلُوا قُتَيْبَةَ عَنْوَةً","والخَيْلُ جانِحَةٌ، عَلَيْها العِثْيَرُ"],["D2CE25D1-2171-5F0A-9313-E6D0FFBD4954","بالمرجِ مرجِ الصِّينِ، حيثُ تبيَّنَتْ","مضرُ العراقِ منِ الأعزُّ الأكثرُ"],["96104B35-CD9A-5165-A738-140C7E4BAE1E","إذْ حالفَتْ جزعاً ربيعةَ كلَّها،","فَتَفَرَّقَتْ مُضَرٌ ومَنْ يَتَمَضَّرُ"],["1504ACFE-32F3-52BF-9CB2-E04D7E6F504D","وتَناقَلَتْ أزْدُ العِراقِ ومَذْحِجٌ","للموتِ، يجمعُها أبوها الأكْبرُ"],["EE5CE32D-7EC5-5017-A95A-8E7C31FEF70C","مِنْ مَذْحِجٍ والأزْدِ، حِينَ تَجَمَّعَتْ","لِلْحَرْبِ، زَمْزَمَةٌ تَغِطُّ وتَهْدِرُ"],["8898368D-FCAB-5217-8F8F-DD8ED046F7C7","كفتِ الذَّينَ تغيَّبوا منْ قومِهِمْ","منْ كانَ يُعرفُ منهمُ أوْ يُنكرُ"],["E45792F9-A398-50D0-B0E0-20B27FE25709","والأزدُ تعلمُ أنَّ تحتَ لوائهَا","مُلْكاً قُرَاسِيَةً، ومَوْتٌ أحْمَرُ"],["A1A6C3A8-C3E1-580D-9FB3-1B3D1AE88DE5","والأزدُ تعلمُ ما يقالُ ضحَى غدٍ","تَحْتَ اللِّواءِ، فَتَسْتَحِدُّ وتَصْبِرُ"],["AD042716-EAF9-53CD-8E36-A90499523AF1","قَحْطَانُ تَضْرِبُ رَأْسَ كُلِّ مُتَوَّجٍ","وعَلى بَصائِرِها، وإِذْ لا تُبْصِرُ"],["8079BF21-CDAE-5F91-BAFB-18F54DFB269C","في عِزِّنَا انْتَصَرَ النَّبيُّ مُحَمَّدٌ","وبِنا تَثَبَّتَ في دِمَشْقَ المِنْبَرُ"]]},"26D3CB05-06B7-51CC-95C6-08B13EF754C4":{"t":"لَحَى اللَّهُ قَوْماً أَسْلَمُوا يَوْمَ بَابِلٍ","p":78,"s":"لحى الله قوما أسلموا يوم بابل","r":"439215","v":[["565F8CA6-BACC-54FB-A0AC-3AEB8C1A225D","لَحَى اللَّهُ قَوْماً أَسْلَمُوا يَوْمَ بَابِلٍ","أَبَا خَالِدٍ تَحْتَ السُّيُوفِ البَوَارِقِ"],["79E1DBBB-AD72-51E8-AD7B-FEE063AC9FC6","فَتىً كَانَ عِنْدَ المَوْتِ أَكرَمَ مِنْهُمُ","حِفَاظاً وأعْطَى لِلْجِيَادِ السَّوَابِقِ"],["9DE682B9-333E-5F85-90FD-74A3FEFAB266","وأغيرَ عندَ المحصناتِ إذا بدَتْ","براهنَّ، واستعجلنَ شدَّ النَّطائقِ"],["BA7EB091-B519-564B-95AD-EC781115B803","فَقَائِلَةٌ تَنْعَى يَزِيدَ وقَائِلٌ","سقَى الله جزلَ السَّيبِ عفَّ الخلائقِ"],["D2A136CB-0326-56FC-B263-D3B66BC7EF10","فلمَّا نعَى النَّاعِي يزيدَ تزلزلَتْ","بِنَا الأرْضُ، وارْتَجَّتْ بِمِثْلِ الصَّوَاعِقِ"],["F2CF2710-0C84-5247-9162-10E8FE7C2C1E","فَلاَ حَمَلَتْ أزْدِيَّةٌ بَعْدَ مَوْتِهِ","جَنِيناً، ولاَ أَمَّلُنَ سَيْبَ الغَوَادِقِ"]]},"CA7AE7B6-1333-5C53-B2FD-CB4B8541B431":{"t":"لَمْ تُعَالِجْ دَمْحَقاً بَائِتاً","p":78,"s":"لم تعالج دمحقا بائتا","r":"439246","v":[["9D61CD37-EF4C-507F-A290-001D5146DFFF","لَمْ تُعَالِجْ دَمْحَقاً بَائِتاً","شُجَّ بالطَّخْفِ لِلَدْمِ الدَّعَاعْ"]]},"F783AE2F-7C2C-50FC-861D-6480B9BE1312":{"t":"لِلَّهِ دَرُّ الشُّرَاةِ إِنَّهُمُ","p":78,"s":"لله در الشراة إنهم","r":"439247","v":[["5E32CD95-2E33-5598-B535-83A8E6D05F46","لِلَّهِ دَرُّ الشُّرَاةِ، إِنَّهُمُ","إِذَا الكَرَى مَالَ بالطُّلَى أَرِقُوا"],["700C100A-44C9-5530-B246-29CD415A770E","يرجِّعونَ الحنينَ آونةً","وإِنْ عَلاَ سَاعَةً بِهِمْ شَهَقُوا"],["950FE630-EB18-5CA1-A775-D38D9DECDAE7","خوفاً تبيتُ القلوبُ واجفةً","تكادُ عنها الصُّدورُ تنفلقُ"],["B871C8BC-7807-53C5-AC9A-A63ED5B6103F","كيفَ أرجِّي الحياةَ بعدهُمُ","وقَدْ مَضَى مُؤْنِسيَّ فَانْطَلَقُوا"],["850C477A-07FA-5151-A0CE-1BCF2085C0D5","قومٌ شحاحٌ على اعتقادهمُ","بالفَوْزِ مِمَّا يُخَافُ قَدْ وَثِقُوا"]]},"9C8AE425-FDA1-513A-A309-47B76CAC1F6B":{"t":"لِمَنْ دِيَارٌ بهذا الجِزْعِ مِنْ رَبَبِ","p":78,"s":"لمن ديار بهذا الجزع من ربب","r":"439193","v":[["22DB17A2-EE00-5756-831C-DDBDDB9745C8","لِمَنْ دِيَارٌ بهذا الجِزْعِ مِنْ رَبَبِ","بينَ الأحزّةِ منْ هوبانَ فالكثبِ"],["C1CC270F-12C5-537D-88A8-129DD1C514A3","تِلْكَ الدِّيَارُ الَّتي أَبْكَتْكَ دمْنَتُها","فالدَّمْعُ مِنْكَ كَهَزْمِ الشَّنَّةِ السَّرِبِ"],["93B5F463-0795-5DE5-8B97-C201EE1BA25F","أطلالُ ليلَى، محتْها كلُّ رائحةٍ","وَطْفَاءَ، تَسْتَنُّ رُكْنَيْ عارِضٍ"],["EB67DC30-AD4D-51FB-9CED-04CBAB1E9AEA","أَكْنَافَهُ خَلَقٌ مِنْ دُونِهِ خَلَقٌ","كالرَّيْطِ نَشَّرْتَهُ ذِي الزِّبْرِجِ الهَدِبِ"],["8596E55C-F665-5FE8-821E-6133E6438FC1","لمّا أسّتْ بهِ ريحُ الصّبا، ومرتْ","لَبُونَهَا، وَجَدُوهَا ثَرَّةَ الشَّخَبِ"],["C3E6AB4B-D5D3-5E63-BE6A-CFD7A7DE6F88","لا يعلمُ النّاسُ منْ ليلَى وذكرتِها","مَا قَدْ تَجَرَّعْتُ مِنْ شَوْقٍ ومِنْ طَرَبِ"],["13E83241-2A82-568F-9654-9A8EFD908065","يا لَيْلَ إِنِّي، فكُفِّي بَعْضَ قِيلِكِ لي،","مِنْ طَيِّىءٍ ذُو مَنَادِيحٍ ومُضْطَرَبِ"],["5ADF8B56-52C1-5585-B63E-F2B4794F6155","أنَا الطِّرِمَّاحُ، فاسْأَلْ بي بَني ثُعَلٍ","قَوْمي إِذَا اخْتَلَطَ التَّصْدِيرُ بالحَقَبِ"],["F7D736F1-0B41-57BE-B7C7-A042A86F75EC","جَدِّي أبُو حَنْبَلٍ، فَاسْأَلْ بِمَنْصِبِهِ","أزْمَانَ أَسْنَى، ونَفْرُ بْنُ الأَغَرِّ أبِي"],["B75EE5FB-A359-5DD7-A257-8E128821E218","لأمهاتٍ جرَى في بضعهنَّ لنَا","ماءُ الكرامِ رشاداً غيرَ ذي ريبِ"],["ABEBFCCF-E849-501A-A9D7-D33D3E047235","شُمِّ العَرَانِينِ والأَحْسَابِ مِنْ ثُعَلٍ","ومنْ جديلةَ، لا يسجدنَ للصُّلُبِ"],["2AA87324-3961-58EC-86A2-0924753C8B4F","معالياتِ عنِ الخزيرِ، مسكنُها","أطرافُ نجدٍ منْ أهل الطّلحِ والكنبِ"],["860034EC-5BB1-5E96-8445-C17996A4E848","إذا السّماءُ لقومٍ غيرِنا صرمتْ","عنانَها في الرّضا منهمْ وفي الغضبِ"],["2CBE0488-F775-5161-87E9-FA8024162FCF","إِنْ نَأَخُذِ النَّاسَ لا تُدْرَكْ أِخِيذَتُنا","أوْ نَطَّلِبْ نَتَعَدَّ الحَقَّ في الطَّلَبِ"],["670C929B-119C-564E-8D12-00FC202F65B6","منّا الفوارسُ والأملاكُ، قدْ علمتْ","عُلْيَا مَعَدّ، ومِنّا كُلُّ ذي حَسَبِ"],["78AA718C-FE24-547E-BB0F-2B4B739A6763","كعامرِ بنِ جُوينٍ في مركّبهِ","أوْ مِثْلِ أَوْسِ بْنِ سُعْدَى سَيِّدِ العَرَبِ"],["B3E5D631-2172-55FC-9E2B-6667E74A79C2","المنعمِ النّعمَ اللاتي سمعتَ بها","في الجاهليّةِ والفكّاكِ للكُربِ"],["F1C84D69-E723-536D-AB12-FA431D16877B","أوْ كالفَتَى حِاتِمٍ إِذْ قَالَ: مَا مَلَكَتْ","كفّايَ للنّاسِ نهبَى يومَ ذي خشبِ"],["389A12E3-9F08-57A7-A2F9-4E5FF6CB4691","أوْ كابنِ حيةَ لمّا طرَّ شاربُهُ","أَزْمَانَ يَمْلِكُ أَهْلَ الرِّيفِ والقَتَبِ"],["7711612D-1123-507B-B51D-9896A2434A0E","سادَ العِراقَ وأَلْفَى فِيهِ والِدَهُ","مطلّباً بتراتٍ غيرَ مطّلبِ"],["5466B504-6D39-5DAA-9D1B-803A6FDF76E6","كَمْ مِنْ رَئِيسٍ عَظِيمِ الشَّأْنِ مِنْ مُضَرٍ","ومِنْ رَبِيعَةَ نَائي الدَّارِ والنَّسَبِ"],["664BCDBB-6DF2-5418-A9E3-0C7E05DCC563","قدْ باتَ زيدٌ إلى الهطّالِ قارنَهُ","مواشِكاَ للمطايا، طيّعَ الخببِ"],["4DE9875F-80EA-5520-AF2F-4BC9A6A0B229","ليسَ ابنُ يشكرَ معتدّاً بمثلِهِمْ","حتّى يرقّى إلى الجوزاءِ في سببِ"],["F97A3354-2096-50FA-BFAD-98159BA7832D","طَابَتْ رَبِيعَةُ أعْلاَهَا وأسْفَلَها","ويشكرُ اللؤمِ لمْ تكثرْ ولمْ تطبِ"],["46BB3E08-6CA4-572C-9DCC-89AAAA6B6551","نحنُ الرؤوسُ على منهاجِ أوّلِنا","مِنْ مَذْحِجٍ، مَنْ يُسَوِّي الرَّأْسَ بِالذَّنَبِ؟"]]},"7C3077EC-80F0-5327-9187-B4506A60A739":{"t":"نبيتُ تميماً تجتدي حربَ طيِّىءٍ","p":78,"s":"نبيت تميما تجتدي حرب طيىء","r":"439216","v":[["C5CF56B2-22FF-53CC-BFBC-11041DCB9F98","نبيتُ تميماً تجتدي حربَ طيِّىءٍ،","تَبَارَكْتَ يَا رَبَّ القُرُونِ الأَوَائِلِ!"],["6EB3FBEE-30C6-5BAF-B567-1B7FFC910732","ومَا خُلِقَتْ تَيْمٌ وزَيْدُ مَنَاتِهَا","وضَبَّةُ إلاَّ بَعْدَ خَلْقِ القَبَائِلِ"],["FA30C4A9-67DF-5E6B-8DAE-F900D58FD6BB","عراقيبُ ضمَّ الذُّلُّ واللُّؤمُ بينهُمْ","كَمَا انْضَمَّ شَخْصُ الخارِىءِ المُتَضَائِلِ"],["DC5091BA-7A31-5D28-8ABB-B54909D88861","لَهُمْ نَفَرٌ سُودُ الوجُوهِ، ونِسْوَةٌ","قِبَاحُ الأعالي، مُحْمَشَاتُ الأَسَافِلِ"],["1BFF124A-F778-5BFE-AD8E-4A54E41FF6B7","علَى عهدِ عادٍ سامتِ الذُّلِّ طيِّىءٌ","تَمِيماً، وعَادَتْ كُلَّ جِنّ وخَابِلِ"],["03350E39-3A52-5705-B91A-254BA33C153B","يدينونَهُمْ أنْ يستبُوا أمًّهاتِهمْ","وأنْ يمنعُوا منهُمْ خدامَ الحلائلِ"],["FD1BEC95-8E29-5A52-94A1-D8A0318CA1A3","إذا الجبلانِ استحقبا دينَ معشرٍ","مِنَ النَّاسِ صَارَ الدَّيْنُ أَحْلاَمَ بَاطِلِ"],["D19C89B2-571D-5635-B065-FA7B848723DF","ولاَ دَيْنَ لِلطَّائِيِّ يُلْوَى قَضَاؤُهُ","إذا طيِّىءٌ ألقَتْ جفونَ المناصلِ"],["050A5803-0C8D-5BFF-92E0-E950414FB027","ومنْ يلتمسْ منْ طيِّىءٍ ترةً لهُ","تكنْ كالثُّريَّا منْ يدِ المتناولِ"],["1F544E47-CA80-532C-85A2-DF5E9F4368C5","فإنْ يقتلُوا عدلَيْ تميمِ بغرَّةٍ","إهابةَ وابنَ الجونِ يومَ الأجاولِ"],["A4DF6799-0550-5648-9976-5BAAE8D37D20","فإنَّنا تركنا ابنيْ شهابِ بنِ جعفرٍ","وجَنَّاءَةَ الثَّاوِي بِصَحْرَاءِ عَاقِلِ"],["99F6F5AD-14D6-59FD-ABBB-7749E608FE4F","تَوَهَّنُ مِنْهُ المَضْرَحِيَّةُ بَعْدَمَا","مَضَتْ فِيهِ أُذْنَا بَلْقَعِيٍّ وعَامِلِ"],["C86B18B5-DA66-505F-8C64-4F18A14DA611","سَحَالِيطَ حَمْرِاءِ القَرَاحِينَ أُكْرِهَتْ","بِهِ، والعَوَالِي مُضْجَعَاتُ السَّوَافِلِ"],["17B6FABD-A5DE-5413-A60D-4632FD4D94A2","ويوعدني الأقيانُ منْ آلِ دارمٍ","وكلُّ لئيمٍ منْ معدّ وخاملِ"],["B16D6AA7-B5FF-538F-BBE8-20D8C48099FB","لِنَرْفَعَ مِنْهُمْ مَا أبَى اللَّهُ رَفْعَهُ","وقَدْ وُطِئُوا بِي وَطْأَةَ المُتَثَاقِلِ"],["B41D814D-1EEC-5E80-9293-6209A4716348","لقدْ زادن حبّاً لنفسيَ أنَّني","بِغِيضٌ إِلَى كُلِّ امْرِىءٍ غَيْرِ طائِلِ"],["98E56B99-862B-53B2-83CD-106E95D03F7F","إذا ما رآني قطَّعَ الطَّرفَ بينَهُ","وبينيَ فعلَ العارفِ المتجاهلِ"],["857EA068-8409-5B28-847A-2C49D6A0B501","ملأتُ عليهِ الأرضَ حتَّى كأنَّها،","مِنَ الضِّيقِ في عَيْنَيْهِ، كِفَّةُ حَابِلِ"],["09B28891-224B-53A4-916F-CB32F5047DC8","وأنِّي شَقِيٌّ باللِّئَامِ، ولاَ تَرَى","شقيّا بهمْ إلاَّ كريمَ الشِّمائلِ"],["91FD8F00-7507-5483-BFAE-9B14AB89B317","فدونَكَ، إنِّي منْ تعرَّفتَ، فانتحِ","بِعَيْنِكَ مِنْ عِطْفَ امْرِىءٍ غَيْرِ وَاصِلِ"],["C51FB3EB-51B4-5E6E-834D-4CA196B6AEC8","إذا ما رآهُ الكاشحونَ ترَّمزوا","حذاراً، وأوموا كلُّهُمْ بالأناملِ"],["4F646809-09B7-5D73-AA65-57109F943EF2","أكلُّ امرىءٍ ألفَى أباهُ مقصِّراً","معادٍ لأهلِ المكرماتِ الأوائلِ"],["C53319FF-AAEE-5880-A743-938CCEFF2653","إِذَا ذُكِرَتْ مَسْعَاةُ وَالِدِهِ اضْطَنَا","وما يضطّني منْ شتمِ أهلِ الفضائلِ"],["6FED28D8-6579-5A61-870D-8949C87B88D6","لَنَا العَضُدُ الشُّدَّى عَلَى النَّاسِ، والأُتَى","علَى كلِّ حافٍ منْ معدّ وناعلِ"],["E530239F-5A7A-5BE1-A728-1AC67328A839","عَلَى عَهْدِ ذِي القَرْنينْ، حَتَّى تَتَابَعَتْ","عَلَى سَنَنِ الإِسْلامِ صِيدُ المَقَاوِلِ"],["E1699BB5-165C-5302-AD05-1660AAB1BF94","ولَولاَ قُرَيْشٌ، والحُقُوقُ التي لَهَا","عَلَيْنَا، أقَمْنَا الدَّرْءَ مِنْ كُلِّ مَائِلِ"],["3D0BCA40-9AB4-5FEC-AEC4-9BEAE404FAE3","ودِنَّا مَعَدّاً مِثْلَ مَا كَانَ تُبَّعٌ","يدينهُمُ في كلِّ حقّ وباطلِ"],["AD1ADE1D-C868-51B1-9D8B-DFBCA83EF2F3","لنَا مــعقلٌ لمْ يدخلِ الذُّلُّ جوفهُ","إذا ذكرَ الأقوامُ عزَّ المعاقلِ"],["79C53995-E915-536D-8513-A5033F683FAE","ومَا مُنِعَتْ دَارٌ، ولاَ عَزَّ أَهْلُها","مِنَ النَّاسِ إلاَّ بالقَنَا والقَنَابِلِ"]]},"622D5FC5-D23D-5465-8463-CB3B63142C2F":{"t":"نزلتُ بأعلى تلعةٍ وفرزدقٌ","p":78,"s":"نزلت بأعلى تلعة وفرزدق","r":"439218","v":[["5CF51CD5-9F11-5B60-9D75-44D4B1C689E1","نزلتُ بأعلى تلعةٍ، وفرزدقٌ","بِأَسْفَلِهَا حَيْثُ اسْتَقَرَّ مَسِيلُها"],["B0DE7752-3EF6-501E-9D05-0D4940E03714","وما كثرتْ عليَا تميمٍ فتتَّقَى","ولاَ طَابَ مِنْ سُفلَى تَمِيمٍ قَلِيلُها"],["01B11EEE-8E69-5C91-950B-FDD6057AB85C","فَما لَكَ مِنْ نَجْدٍ ولاَ رَمْلِ عَالِجٍ","مَقِيلُ مَهَاةٍ، فَانْظُرَنْ مَا مَقِيلُها"],["2AE6E9E8-A2BE-5C48-8457-0EB826740F75","وقَدْ سُدَّ مَجْرَى البَوْلِ مِنْ بَطْنِ جِعْثِنٍ","بعقفاءَ تسقيها إذا اختلَّ ثيلُها"]]},"01089CAA-9244-55AD-85A5-AE9E366AB810":{"t":"هلْ يدنينَّكَ منْ أجارعِ واسطٍ","p":78,"s":"هل يدنينك من أجارع واسط","r":"439205","v":[["A58F0860-7C7E-599A-B295-B8BAC869D1DA","هلْ يدنينَّكَ منْ أجارعِ واسطٍ","أوْ باتُ يعملةِ اليدينِ حضارِ"],["C56D75C9-B3F2-5BAC-B1A0-4EBEE7B8455E","شدقاءُ تصبحُ تشتئي غبَّ السُّرَى","فِعْلَ المُضِلِّ صِيارَهُ البَرْبَارِ"],["402069D1-E622-5E8B-9736-CEFAE5049E9D","منْ وحشِ خبَّةَ، أودعتْهُ نيَّةٌ","لِلنَّاطِلِيَّةِ مِنْ لِوَى البَقَّارِ"],["5FC5237C-E9B1-579C-BF6D-73DD23AEBEE0","طَرِفُ التَّنائِفِ، مَا يُبِنُّ مَبَاءَةً","يومَينِ، طيِّبُ نيَّةِ الإنعارِ"],["B9243F3C-473E-5DF9-8164-4DC820CCBBBE","وحَدَاهُ مُقْتَنِصٌ، قَرَا آثَارَهُ","بعياسلٍ سجحِ الخدودِ ضوارِي"],["C0868177-AFA5-5BCB-8CDC-B5C3CC13531F","حَتَّى فَجِئْنَ بِهِ، فَأَجْفَلَ مِنْ مَدىً","كَثَبٍ، وهُنَّ دَوامِجُ الإحْضَارِ"],["D5D1CA4E-26AB-5028-8B38-33E791FCA0C9","شَأْواً تَقَاذَفَ جُلَّهُ، ثُمَّ ارْعَوَى","خمطاً، يهزُّ كحربةِ الأسوارِ"],["BC0453D6-C4D3-5C6D-BAA3-5CF0E8A21299","فنَحا لأوَّلهَا بطعنةِ محفظٍ","تمْكُو جَوَانِبُها مِنَ الإِنْهارِ"],["CCB6D546-1180-581B-920F-BBD52C774184","فصددْنَ، خوفاً، عنْ سنانيْ باسلٍ","بَطَلٍ، أشَاحَ عَلى الوَغَى، مِغْوارِ"],["D3438A58-BF90-5CF4-835A-27DFA438A29A","وأفاجَ محبوراً، يفنِّنُ شدَّهُ","بفجاجِ طامسَةِ الصُّوَى مقفارِ"],["F18FA407-19C0-517B-912C-4932FAFE2DE5","منْ خالدٍ، أهلِ السَّماحةِ والنَّدَى،","مَلِكِ العِراقِ إِلى رِمَالِ وَبَارِ"],["2C145195-91B2-5267-BAE2-CCA290936900","يا خالِ، ما وُجدُ امرىءٍ منْ عصبةٍ","يتضيَّفونَ قوادمَ الأكوارِ"],["E2205333-8DAD-5CC2-BFFF-4B1B4A1FA2A4","يعتدُّ مثلَ أبوَّةٍ لكَ تسعةٍ","بِيضِ الوُجُوهِ، أعِزَّةٍ أَخْيارِ"],["833F7FA7-C3BA-54A7-9834-8F58D3FECF76","شقٌّ وغمغمةُ الأغرُّ وعامرٌ","عُمَدَاءُ، أَهْلُ لُهاً، وأَهْلُ مَغار"],["4EE1A1EF-1552-5A87-81DF-065812FCF9F6","ومُعَوِّدُ الجَفْرَاءِ، رَهْنُ قِسِيِّهِمْ","بالجرجرادِ بكلِّ يومِ فخارِ"],["C359D85A-5B58-5ACF-A5F4-39451786D3E6","والمُنْتَضَى أَسَدٌ، وكُرْزُ قَبِيلَةٍ","فَنِجارُ ضِئْضِئِكُمْ كَخَيْرِ نِجارِ"],["30FDA4E6-35B6-5FF3-A0A1-0CBB4D8680F9","ويَزِيدُ وابْنُ يَزِيدَ نَالاَ مُهْلَةً","في المَجْدِ واقْتَدَحَا بِزَنْدٍ وَارِي"],["D4A33BE3-F25F-55FB-9163-D2190E813059","عزَّاً ومكرمةً، أباً فأباً لهُ","حيثُ استقرَّ بهِمْ مدَى الأعمارِ"],["5D7FA42C-4461-5D5D-BB87-11EAF229B6D7","وَصَلَ الحَديثُ لَهُمْ قَدِيمَ فَعَالِهِمْ","فجروْا علَى لقمٍ ودعسقِ أمارِ"],["2C433B82-5700-566D-A2C1-FE6D15BC9427","حسباً تواصلَ ليسَ يفرقُ بينَهُ","جدٌّ أغثُّ، ولاَ وشائقُ عارِ"],["16F9265D-ED52-5893-8433-082DD1238857","صدِّفُ النَّواظرِ عنْ مناجاراتهِمْ","حتَّى يبنًّ حواصنَ الأسرارِ"],["44F3C27D-AF6A-545E-B448-4A3518B3C8F3","الصَّابرونَ بكلِّ يومِ حفيظةٍ","والفائزونُ بكلِّ يومِ نفارِ"],["3EF29C50-6A24-544B-8941-5B286C2793EA","أُنُفُ الحَفَائِظِ، يَبْسُطُونَ أَكُفَّهُمْ","بِنَوَالِ لاَ نَزْرٍ ولاَ إِصْفارِ"],["6C9D7286-CD15-56E3-A06A-949B99BB27FD","يتضمَّنُونَ لمنْ يجاورُ فيهِمُ","رَيْبَ الزَّمَانِ وكَبَّةَ الإِقْتَارِ"],["460F6044-3AB3-5EBA-9743-8589981FF76B","والجَارُ وَسْطَهُمُ يَزِيدُ عَطَاؤُهُ","بتتابعِ الهلكاتِ والأحجارِ"],["3B9E5189-5E37-50CB-9BE3-114220B3AC39","ولأُحْدِثَنَّ لِخَالِدٍ ولِقَوْمِه","مَدْحاً يَغُورُ لَهُ بِكُلِّ مَغارِ"],["53F000F1-1BC4-54AE-BD59-E23695F82A49","ويفونَ إنْ عقدُوا، وإنْ أتلوْا حبَوا","دونَ التَّلاءِ بفخمةٍ مذكارِ"],["8DAC6991-F433-533D-B8E0-450B8A13162B","يا خالِ، ما وشحتْ بمثلكِ ناقةٌ","منْ صغْي ذي يمنٍ وجذمِ نزارِ"],["8D073026-D6D4-5095-A423-816FAB9C3D36","بعدَ ابنِ آمنةَ النَّبيِّ محمَّدٍ","خُضْراً إلى لَفَفٍ مِن الأَشْجَارِ"],["E3233C1D-B2C4-5E34-8E42-FB53CF80F173","أندَى يداً لعشيرةٍ منْ مالِهِ","في غيرِ تعتعةٍ ولاَ اقْذحرارِ"],["4D8EEF4F-4431-5DDB-9336-96E64B741246","وأسدَّ بعدَ ثأىً لوهْي عظيمةٍ،","وأفكَّ في قنعٍ لكلِّ إسارِ"],["34050794-F594-5638-AE60-E336EB106DEC","وأعمَّ منفعةً، وأعظمَ نائلاً","لأخٍ أسَافَ وصَاحِبٍ مُحْتَارٍ"],["D673EEEA-F5CF-5D5F-9F24-5270E5482B32","وأصدَّ عنْ خطلٍ، وأحلمَ قدرةً","عَنْ كَاشِحٍ يَسْتَنُّ بالأغْوَارِ"],["8E5F04AA-DA9B-5BA8-979B-E9F6D3896F1F","وأَشَدَّ مَحْمِيَةً، وأَبْلَغَ صَوْلَةً","لَكَ إِذْ تُحَطُّ عَوَاقِبُ الأَقْدَارِ"],["55BEE49B-292B-529B-9787-29F5D06A5B21","وأدَلَّ في عِظَةٍ عَلَى مَالَمْ يَكُنْ","أبداً ليذهنَهُ ذوو الأبصارِ"],["9445F1C4-C5CC-5510-9F8F-70F7322DF5D2","مَا نَالَهَا أَحَدٌ مَضَى، ومُرِيدُهُ","في الأَصْلِ، حِينَ تَغِيبُ، ذُو آصَارِ"],["B8034B1D-1A7E-5DEC-A79C-93FB48810F66","وأودَّ، بعدَ حذارِ، أنْ لاَ يرعوِي","حَتَّى يُميتَ وَرِيدَ كُلِّ حَذَارِ"],["F71F3322-6500-5CEB-B3D0-39F893802198","وأجدَّ في دعةٍ، وأبعدَ غايةً","في روحةٍ، وأعزَّ ذمَّةَ جارِ"],["E7928E2B-0D9A-5B34-B448-609AB5E69AFE","وأَشَدَّ، إِذْ زَنَأَ الزَّمَانُ، تَوَسُّعاً","في عِيصِ كُلِّ شَصِيبَةٍ ويَسَارِ"],["31E97503-CFE7-5CE4-8B32-5069179922E0","لَوْ لَمْ تَكُنْ رَجُلاً لَكُنْتَ بِمَا تَرَى","لحماً تدينُ لهُ الأجادلُ ضارِي"],["6FE99BF6-35DF-5898-812F-0AC50CD179A4","صَقْرٌ، يَصيدُ إِذَا غَدَا بِجَنَاحِهِ","وبخطْمِهِ، ويصيدُ بالأظفارِ"],["A7D47F7F-4A9F-584E-87D4-D203DD838DB7","يمضي الأمورَ، بلا وتيرةِ فترةٍ،","أَرِباً، يُقَوِّمُ أَسْهُمَ الأُسْوَارِ"],["FD40B52A-F824-5A4A-8587-B87C4AFADA75","كالسَّيفِ أخلصَهُ الجلاَءُ، وصانَهُ","تصميمُهُ بجماجمِ الكفَّارِ"],["F61C032D-80ED-5F0E-A47B-1ECD6546BC0D","يُمْسي ويُصْبِحُ جَوْفُهُ مِنْ قُوتِهِ","وبِهِ لِمُخْتَلِفِ الهُمُومِ مَجَارِي"],["2746A837-2A7F-577C-94BF-6621865BB604","وَسُمِيَّةٌ بَكَرَتْ، وكَانَ وَلِيُّها","وطبٌ يكونُ إناهُ بالأسحارٍ"]]},"482D14A3-898A-5103-B1A0-B4123F91F983":{"t":"وأَجْوِبَةٌ كالزَّاعِبِيَّةِ وَخْزُهَا","p":78,"s":"وأجوبة كالزاعبية وخزها","r":"439236","v":[["D9CAE12E-EF40-5D76-AF8E-709593E1F7A9","وأَجْوِبَةٌ كالزَّاعِبِيَّةِ وَخْزُهَا","يُبَادِهُهَا شَيْخُ العِرَاقَيْنِ أَمْرَدَا"]]},"587CF6E7-867F-5708-8398-883E65A7DCE5":{"t":"وإِنِّي لَمُقْتَادٌ جَوَادِي وقَاذِفٌ","p":78,"s":"وإني لمقتاد جوادي وقاذف","r":"439214","v":[["2C52F4DB-9775-54D2-B027-06919A5B9102","وإِنِّي لَمُقْتَادٌ جَوَادِي، وقَاذِفٌ","بِهِ وبِنَفْسي العَامَ إِحْدَى المَقَاذِفِ"],["738BA829-CB89-530E-8164-0A8D1FA0BA99","لأكسِبَ مَالاً، أَوْ أَؤُولَ إلى غِنىً","مِنَ اللَّهِ يَكْفِينِي عُدَاةَ الخَلاَئِفِ"],["2DDA518A-493B-53CC-9362-15E78A08D08F","مخافةَ دنيا رثَّةٍ أنْ تميلَني","كَمَا مَالَ فِيهَا الهَالِكُ المُتَجَانِفُ"],["2E03D430-CFEC-5D5B-A65D-C7D3CDF794BC","فياربِّ إنْ حانَتْ وفاتي فلاَ تكَنْ","على شرجعٍ يعلَى بدكنِ المطارفِ"],["B086FE4F-5226-5519-B293-49E65F29848C","وَلَكِنْ أَحِنْ يَوْمِي شَهِيداً وَعُقْبَةً","يُصَابُونَ في فَجٍّ مِنَ الأرْضِ خَائِفِ"],["41DD38FA-CCF1-569D-8491-5B4800439EFB","عَصَائِبُ مِنْ شَتَّى، يُؤَلِّفُ بَيْنَهُمْ","هُدَى اللهِ، نَزّالُونَ عِنْدَ المَوَاقِفِ"],["1EC69C51-3089-580A-8153-FD97862A2D76","إِذَا فَارَقُوا دُنْيَاهُمُ فَارَقُوا الأذَى","وصارُوا إلى موعودِ مَا في المصاحفِ"],["2F961511-DE21-5AAD-83C6-B5CDF170C1B4","فأقتلَ قعصاً، ثمَّ يُرمَى بأعظُمي","كَضِعْفِ الخَلَى بَيْنَ الرِّيَاحِ العَوَاصِفِ"],["359DF694-22FD-5F13-AF7E-680C3C188E9C","ويُصْبِحَ قَبْرِي بَطْنَ نَسْرٍ مَقِيلُهُ","بِجَوِّ السَّمَاءِ في نُسُورٍ عَوَائِفِ"]]},"CA78CC63-E27B-5CF4-8801-41B2015A560C":{"t":"وإِنْ قَالَ عَاوٍ مَنْ تَنُوخَ قَصِيدَةً","p":78,"s":"وإن قال عاو من تنوخ قصيدة","r":"439243","v":[["C956D8CF-3C6C-5986-985C-E528D1844652","وإِنْ قَالَ عَاوٍ مَنْ تَنُوخَ قَصِيدَةً","بهَا جربٌ عدَّتْ عليَّ بزوبرَا"]]},"D25C94F0-066A-5F10-AACF-A2C0A520C242":{"t":"ورأيتُ الشَّريفَ في أعينُ النَّا","p":78,"s":"ورأيت الشريف في أعين النا","r":"439255","v":[["D66C42A9-ED60-5C3D-B2BD-981ED7C417B3","ورأيتُ الشَّريفَ في أعينُ النَّا","سِ وضيعاً، وقلَّ منهُ احتشامي"]]},"BC2323E2-B95B-53A5-8C83-F7CE2B9486AE":{"t":"ورَوَّحَها في المَوْرِ مَوْرِ حَمَامَةٍ","p":78,"s":"وروحها في المور مور حمامة","r":"439245","v":[["77346D98-38B5-5906-9603-A73FCC2E6665","ورَوَّحَها في المَوْرِ مَوْرِ حَمَامَةٍ","على كلِّ إجريَّائها هوَ رائزُ"]]},"E6BDC79A-2D24-50B3-AB47-C8B025CAD688":{"t":"ولَوْ أَنَّ غَيْرَ المَوْتِ لاَقَى عَدَبَّساً","p":78,"s":"ولو أن غير الموت لاقى عدبسا","r":"439225","v":[["6F1B9296-81AC-5279-8298-117EBA3AA6DD","ولَوْ أَنَّ غَيْرَ المَوْتِ لاَقَى عَدَبَّساً","وجدِّكَ لمْ يسطعْ لهُ أبداً هضْما"],["5E6031DE-6F9C-5C9C-A9C8-CD5F2C7DFE24","فتىً لمْ يكَنْ فقرٌ يضعضعُ متنُهُ","ويُبْدِي الغِنَى مِنْهُ لَنَا خُلُقاً ضَخْمَا"],["0D9B2FC0-BE10-5856-8A6E-5124B87EF1BD","فتىً لوْ يصاغُ الموتُ صيغَ كمثلِهِ","إِذَا الخَيْلُ جَالَتْ فيمَسَاحِلِها قُدْمَا"],["DB64E3B0-2783-5C80-B96B-C53DE0779C27","ولوْ أنَّ موتاً كانَ سالمَ، رهبةً","مِنَ النَّاسِ إِنْسَاناً لَكَانَ لَهُ سَلْمَا"]]},"B0924EE4-9885-521D-A3B0-FD7533AA053D":{"t":"وما أروَى وإنْ كرمَتْ علينا","p":78,"s":"وما أروى وإن كرمت علينا","r":"439259","v":[["E79657D9-D504-502C-BDBF-BE6413923529","وما أروَى، وإنْ كرمَتْ علينا،","بأَدْنَى مِنْ مُوَقَّفَةٍ حَرُونِ"]]},"7CC356CB-010E-57F1-8522-A96D61599C44":{"t":"وَجَدْنا في كتابِ بَنِي تَميمٍ:","p":78,"s":"وجدنا في كتاب بني تميم:","r":"439241","v":[["C1A510E3-407E-5BB3-9C86-E07576C8B0E9","وَجَدْنا في كتابِ بَنِي تَميمٍ:","أحقُّ الخيلِ بالرَّكضِ المعارُ"]]},"6DD6FFF5-C5A9-5046-B0F6-ACC8993277E6":{"t":"وَرَدَ العُفَاةُ المُعْطِشُونَ وأَصْدَرُوا","p":78,"s":"ورد العفاة المعطشون وأصدروا","r":"439211","v":[["3DF52ABD-D453-5990-A061-0803CBF530E6","وَرَدَ العُفَاةُ المُعْطِشُونَ، وأَصْدَرُوا","رِيّاً، وطَابَ لَهُمْ لَدَيْكَ المَكْرَعُ"],["FD832AE2-5573-5943-8FEC-A1ED7CE892FD","ووَرَدْتُ حَوْضاً طامِياً حَافَاتُهُ","فرددتُ دلوي شنُّها يتقعقعُ"],["0AE293BE-D1D9-5BE1-B940-CA18F430C202","وأَرَاكَ تُمْطِرُ جَانِباً عَنْ جَانِبٍ","وجَنَابُ أَرْضي مِنْ سَمَائِكَ بَلْقَعُ"],["D3A80F58-D2D4-5B01-9F8E-9F564EC8B69D","أَلْحُسْنِ مَنْزِلَتي تُؤَخِّرُ حَاجَتِي","أمْ ليسَ عندكَ لي بخيرٍ مطمعُ"]]},"85838265-2ADD-5426-899C-C410CBE85557":{"t":"وَيَوْمُ النِّسارِ وَيَومُ الجِفا","p":78,"s":"ويوم النسار ويوم الجفا","r":"439253","v":[["E47D8894-B3F8-59B9-8C00-F4BAB331B419","وَيَوْمُ النِّسارِ، وَيَومُ الجِفا","رِ، كانا عَذَاباً وَكَانَا غَرَامَا"]]},"5A626DDD-7199-5C6D-8CD8-ECD6190C1E8F":{"t":"يا دارُ أقوَتْ بعدَ أصرامِها","p":78,"s":"يا دار أقوت بعد أصرامها","r":"439221","v":[["0E1544C9-6831-5DD7-B68A-591233F3D087","يا دارُ أقوَتْ بعدَ أصرامِها","عَاماً، ومَا يُبْكِيْكَ مِنْ عَامِها"],["FBD8CD49-DF91-585D-9C25-6D374C26CF90","هَلْ غَيْرُ دَارٍ بَكَرَتْ رِيحُها","تَسْتَنُّ في جَائِلِ رَمرَامها"],["1B8A8D1A-96EB-513C-880E-792B0ED84EE5","فيها لولدانِ الصِّبا ملعبٌ","كأنَّما آثارُ أقدامِها"],["7155C614-42B3-5D0E-B0B9-D2BC22AEB5A3","صَحِيفَةٌ رَقَّشَها كَاتِبٌ","لَمْ يَتَقَادَمْ عَهْدُ أقْلاَمِها"],["65072A0C-1687-537D-AA3E-306E90D43C6D","قِفْ صَاحِبِي أقْضِ بِهَا لَوْعَةً","...عناني بعضُ أسقامِها"],["E6B677D7-EEF9-54F8-A528-41C190430A28","أسْتَخْفِها إذْ نَحْنُ فِيها مَعاً","عَنْ بَعْضِ أيَّامِي وأيَّامِها"],["C8965685-A575-5C32-A4C6-3072CD27AD71","بَحْرِيَّةٌ إِنْ نَطَقَتْ دُمْيَةٌ","أوْ أفصحَتْ منْ بعدِ إعجامِها"],["DFC84873-7D19-5E9D-95EA-9D46600D45FD","عَيْنَاكَ غَرْبَا شَنَّةٍ أرْسَلَتْ","أرواقَها منْ كينِ أخصامِها"],["A4A25F72-E65F-52AD-9775-CEEE0356B3E1","أَفْضَى بِهَا الرَّاوِي إِلى خَبْرَةٍ","فَابْتَدَرَتْ أفْوَاهُ أهْزَامِها"],["B6D8A14D-8E2A-5FDF-ABC2-45269B103C78","إذْ نشأتْ، غيرَ فتىً مالكٍ،","لِنِيَّةٍ شَالَتْ بِأَجْذَامِها"],["539B60B6-E995-55C8-AD61-720B76F091DC","كَأَنَّها لَمَّا احْزَأَلَّتْ ضُحىً","وأَنْجَدَتْ مِنْ بَعْدِ إِتْهَامِها"],["6F68D685-3EF0-5101-9185-0F74031BCA48","نَخْلُ القُرَى شَالَتْ مَرَاجِيحُهُ","بالوقرِ فانزالتْ بأكمامِها"],["F47B5649-68A6-5BFC-B617-E8421E4B776D","لقَّحَها الأبَّارُ، فاستوسقتْ","قنوانُها منْ قبلِ إتمامِها"],["A5736236-7212-5221-8063-4F47CC583734","تظلُّ بالأكمامِ محفوفةً","تَرْمُقُها أعْيُنُ جُرَّامِها"],["C18739A0-8D5F-5B0B-961A-A40B770D5FCA","أضحتْ قلوصي بعدَ إهمالِها","في جزأةِ الضَّبلِ وتسوامِها"],["077C703D-5AC1-5C03-9F1C-BF16E918A533","أزْرَى بِهَا وِرْدُ مِيَاهِ الفَلاَ","عافي مطاميهَا وأسدامِها"],["24FB5D2E-CE8D-5F8A-AD88-D6E6070E10C5","يدْمَى أظلاَّهَا وقدْ أخلقَتْ","مِنْها شَرِيجاً بَعْدَ إِجْــذَامِها"],["B92F52DC-B1AA-53F7-AE73-8B4669B0F17F","إليكَ يابنَ القرمِ أطوي بهَا","مجهولَ أرضِ بعدَ إعلامِها"],["CB8AB3B6-C173-5FC5-B1E7-BE03C9511CF7","حتَّى انطوتْ طشيَّ رداءِ القتَى","واستبدلَتْ ضمراً بإجمامِها"],["3EA4ABC2-97ED-562D-A80D-54891109EE5B","تَؤُمُّ مِنْ قَحْطَانَ أنْقَى فَتىً","منْ عارِها قدماً ومنْ ذامِها"],["0B5BF7A0-45A4-5E9C-9E00-BBA24BCB3A8A","فرعاً نماهُ منْ عرانينها","أهلُ مساعيها وأحلامِها"],["4E8F0205-7EE4-57B8-AEE9-975D8E78BB30","يسعَى بمقراتكَ قومٌ حبَوْا","لَمْ يَتَنَاهَوْا دُونَ إِفْعامِها"],["476E248C-D6D1-5AB0-B1B3-679C9EF73D64","أصيدَ، محزومٍ على ظهرِهِ","غُلْبُ الحَمَالاَتِ وجُرَّامِها"],["51A2BFF4-0158-5D82-A1E9-58A247D7FFE2","مُشْتَرَكِ الكَسْبِ، طَوِيل الغِنَى","وصَّالِ أسبابٍ وجذَّامها"],["357768D0-E3F7-562E-80C9-30E55C46CA04","حَمَّالِ أشْنَاقِ دِيَاتِ الثَّأَى","عَنْ عِدَفِ الأَصْلِ وجُشَّامِها"],["1B05F84C-3534-5A93-BF9E-B44967FC53EE","كأنَّهُ في القومِ غبَّ الضُّرَى","بَعْدَ وَنَى الخَيْلِ وتَسْآمِها"],["E33CBA05-5D59-5240-8D51-BF51EB049337","بازٍ غدَا ينفضُ عنْ متنِهِ","نَضْحَ سَمَاءِ غِبَّ إِرْذَامِها"],["B406DAE9-D938-5CD2-82FE-6702FDAAEBDE","أقسمتُ لا أمدحُ حتَّى أرَى","في ذاتِ لحدٍ رهنَ أرجامِها"],["564446DD-3A92-5B37-89F3-B5DE3279137B","إلاَّ فَتىً لِلْحَمْدِ في مَالِهِ","قَسْمٌ إِذَا ضُنَّ بِأَقْسَامِها"],["A4CFFDF4-6DE4-56DD-AE8F-7E96BADD6DAF","يمنعُ ما شاءَ، ويعطي الَّتي","تَسْمُو إِلَيْهَا عَيْنُ مُسْتَامِها"],["EFDE2180-7010-56D5-9680-00DB89EFBC53","مَتَى يَعْدْ يُنْجِزْ، ولا يَكْتَبِلْ","مِنْهُ العَطَايَا طُولُ إعْتَامِها"],["1E39FCA6-024D-55E7-8408-143B0E8D0388","كفَّاهُ كفٌّ لا يرَى سيبُها","مقسَّطاً رهبةَ إعدامِها"],["A6176D76-7A31-5CDC-B6E5-4213A7B4DD29","مبسوطةٌ تستنُّ أرواقُها","عَلى مَوَالِيها ومُعْتَامِها"],["B3160A31-E044-580A-96E1-DB5FEBC2DCCE","وكفُّهُ الأخرَى بهَا يبتغي","نَقْضَ ثَأَى قَوْمٍ وأَوْذَامِها"],["F190310A-5977-5840-842D-A72795010AA6","إِنْ فَتَقَتْ لَمْ يَلْتَئِمْ فَتْقُها","أَوْ أَرْأَمَتْ عِيشَ بِإِرْ آمِها"],["7B93D3D0-16F2-5FA6-A645-6DB78C790365","فيها على الأعداء عرضيَّةٌ","في حَشِّها الحَرْبَ وإضْرامِها"],["F8FEEAFD-3CCB-5507-A082-220EA3CF0B4C","يفري الأمورَ الحدَّ ذا إربةٍ","في ليِّها شزراً وإبرامِها"],["B45C2DDB-6597-5751-99D6-3441BE38F095","ويجتلي غرَّةَ مجهولِها","بالرَّأيِ منهُ قبلَ إنجامِها"],["CD7D2D33-32B3-5986-B129-055A5E088856","ماضٍ إذا الأنكاسُ بعدَ الكرَى","تباعجَتْ أرواحُ أحلامِها"],["D70E912D-E6DB-5F4B-83C0-8C88051E6A0E","ودَارِ قَوْمٍ أشِبٍ شِعْبُها","دَائِمَةٍ هَبْوَةُ إِقْتَامِها"],["38DBE2C9-89F3-5940-B77A-E53903E50716","شمِّ الأعالي، شائل، حولَها","شَعْرَاءُ، مُبْيَضٍّ ذُرَى هَامِها"],["24775986-4C9B-542D-A2C2-4ED54457F743","خادعةِ المسلكِ، أرصادُها","تمسي وكوناً فوقَ آرامِها"],["B286B996-024B-5EC8-B954-73E0918518EF","ضطعنَتْ بالجيشِ بها هادياً","خَوْفَ مَلاَقِيها وأَهْضَامِها"],["BAF940FF-2FD1-5435-A66C-328A9D478F1D","قدَّ التِّهاميِّ بإزميلهِ","عَنْ قُدْرَةٍ مَقْرُوظَ آدَامِها"],["650376E1-387D-5374-9DEE-FCA69A86B118","ثُمَّتَ طَارَتْ بَعْدَ إِظْلاَمِها","كَجُبَّةِ السَّاجِ فَحَافَاتُها"],["76397119-793B-5448-BC5F-1C459F7D12CB","صُبْحٌ جَلاَ خُضْرَةَ أهْدَامِها","بَثَّ عَلَيْها غَارَةً أكْثَرَتْ"],["499CC527-09FF-540A-8435-923578DCA3ED","عَيْلَ أيَامَاهَا وأيْتَامِها","بالخيلِ قدْ جفَّتْ مبادينُها"],["5DF758BD-68D9-5AB6-BEDC-2CC05BB07F85","وآلَ منْ حيلةِ أجرامِها","مِرْدَى حُرُوبٍ مِثْلُهُ سَاسَها"],["75004AAD-DFDA-55AC-91EC-6FA447536162","متلفِ أموالٍ وغنَّامِها","شاحبةِ الأفواهِ، تهمِي دماً"],["C4D182C6-5682-5D73-8789-4465B9244792","أشداقُها منْ طولِ إلجامِها","ترنِّقُ الطَّيرُ، إذا ما عدَتْ"],["7B282F95-A5E3-5D1F-BF6A-3342D5AAB5D9","أنْفَاسَها في قُبْلِ إِرْخَامِها","يُجَزِّىءُ الغُنْمَ بِمَحْشُورَةٍ"],["45178EDD-8E64-5F71-92B6-91B5A9364B8F","خرسٍ خفيٍّ ضرسُ أعلامِها","تَجُورُ بِالأَيْدِي إِذَا اسْتُعْمِلَتْ"],["24CCE4EF-6B8F-5978-8863-DD75375E16C1","مِنْهَا عَلى خِفَّةِ أَجْسَامِها","جَوَارَ غِزْلاَنِ لِوَى هَيْثَمٍ"],["3FB9EF1F-4BDA-5B17-956F-BC0A4508D35F","تَذَكَّرَتْ فِيقَة آرَامِها",""]]},"53FC684E-9A9D-5626-B9AC-4BE33BB1306D":{"t":"يَطْوِي البَعِيدَ كَطَيِّ الثَّوْبِ هِزَّتُهُ","p":78,"s":"يطوي البعيد كطي الثوب هزته","r":"439242","v":[["943F26FA-B654-556F-AEE2-35B0DFC2281F","يَطْوِي البَعِيدَ كَطَيِّ الثَّوْبِ هِزَّتُهُ","كمَا تَرَدَّدَ بالدَّيُمومَةِ الحَارُ"]]}}}