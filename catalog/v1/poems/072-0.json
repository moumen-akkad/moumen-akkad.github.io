{"v":1,"poems":{"9B278480-BFD3-5379-84EE-7FDA0A1B7855":{"t":"أبلغا قومنا جذاما ولخما","p":72,"s":"أبلغا قومنا جذاما ولخما","r":"440041","v":[["289ECC64-3491-53B5-9708-D46244EE54F6","أبلغا قومنا جذاما ولخما","قَوْلَ مَنْ عَزَّهُمْ إلَيْهِ حَبِيْبُ"],["634E84FA-8965-51FC-91F7-2C4E8C8AE9E2","كان أباؤكم إذا الناس حرب","وَهُمُ الأَكْثَرُونَ كَانَ الحُرُوبُ"],["27979589-ACE6-5F7B-A133-D5BC151D261E","منعُوا الثُّغْرَةَ التي بين حِمْصٍ","والكهاتينليس فيها عريب"]]},"9820317E-90B4-5DEB-AE41-6888484978A0":{"t":"أخبرِ النفسِ إنما النفسُ كالعيـ","p":72,"s":"أخبر النفس إنما النفس كالعيـ","r":"440079","v":[["1B930D00-D2E8-537B-8B6D-9F08C9B349AC","أخبرِ النفسِ إنما النفسُ كالعيـ","ـدَانِ مِنْ بَيْنِ نَابِتٍ وهَشِيْمِ"],["F9445751-E649-5746-AAE4-8AE379C32982","منْ ديارٍ غشيتها دارساتٍ","بينَ قاراتِ ضاحكٍ فالهزيمِ"]]},"60C35B05-6642-56FD-9290-9011D64F16EB":{"t":"أطربتَ أمْ رفعتْ لعينك غدوةً","p":72,"s":"أطربت أم رفعت لعينك غدوة","r":"440068","v":[["0C0BF279-A466-5590-9AD1-C2930A25AE65","أطربتَ أمْ رفعتْ لعينك غدوةً","بينَ المُكَيْمِنِ والزَّجِيْجِ حُمُولُ"],["94EE2289-7E7F-51AF-86CC-0430DDFBC025","رَجْلاً تراوحها الحُدَاةُ فَحَبْسُهَا","وضحَ النهارِ إلى العشيِّ قليلُ"],["B4B545FB-A02E-5C7A-B2EA-8717A0CB7BDE","كمطردٍ طحلٍ يقلبُ عانةً","فيها لَوَاقِحُ كَالْقِسِيِّ وحُوْلُ"],["BF893B68-9E8B-5B55-A8EC-F74DBAF72ECA","نَفَثَتْ رياضَ أُعَامِقٍ حتى إذا","لم يبقَ من شملِ النهاءِ ثميلُ"],["B7D242A7-89C0-5C7C-B679-961D7CA43D56","بسطتْ هواديها بها فتكمشتْ","وَلَهُ على أَكْسَائِهِنَّ صَلِيْلُ"],["E17BC205-AF2A-5096-A70B-73ED01AD04F7","حتى وَرَدْنَ مِنَ الأَزَارِقِ مَنْهَلاً","وله على آثارِهِنَّ سَحِيْلُ"],["F043C376-9FBA-5208-B792-F9B16176A7FC","فاستفنهُ ورؤوسهنَّ مطارةٌ","تدنو فتغشى الماء ثمَّ تحولُ"]]},"9821FB0F-ED98-56EA-8D70-13BDD5096E40":{"t":"أَتَعْرِفُ الدارَ أَمْ لا تعرفُ الطَّلَلاَ","p":72,"s":"أتعرف الدار أم لا تعرف الطللا","r":"440029","v":[["B5AA63E2-D419-5C96-8378-12A7CDE0A5AD","أَتَعْرِفُ الدارَ أَمْ لا تعرفُ الطَّلَلاَ","أجلْ فهيجتِ الأحزان والوجلا"],["51AAE28E-EDA4-56C3-85C5-9BF5D11262F8","وقد أَرَانِي بها في عِيشةٍ عَجَبٍ","والدهر بينا له حال إذِ انْفَتَلا"],["FDBCDA0E-0717-5D6E-89A8-5BC44E9CA11E","ألهو بواضحة الخدينِ طيبةٍ","بعد المنام إذا ما سِرُّهَا ابتَذَلاَ"],["82BE143F-0C4B-5038-9CEE-1D906F0FC0C2","ليسَتْ تزالُ إليها نفسُ صاحِبِها","ظَمْأَى فلو رابت من قلبه الغَلَلاَ"],["031E4E2E-466D-528A-9B42-91C214461D77","كشارب الخمر لا تُشْفَى لَذَاذَتُهُ","ولو يطالع حتى يكثرَ العللا"],["5D61584B-29C3-5D86-8EB0-76C1B84041ED","حتى تصرمَ لذاتِ الشبابِ وما","من الحياةِ بذا الدَّهْرِ الذي نَسَلاَ"],["7170CF75-09AC-5FD9-ADA9-16913694C993","وَرَاعَهُنَّ بِوَجْهِي بَعْدَ جِدَّتِهِ","شَيْبٌ تَفَشَّغَ في الصُّدْغَيْنِ فاشْتَعَلاَ"],["AD889FAA-76E6-53DD-A63B-ABA4AF66670E","وسار غربُ شبابي بعدَ جدتهِ","كانما كانَ ضيفاً حفَّ فارتحلاَ"],["50B9C30E-BF62-50AD-B579-96F868E5BB18","فكم ترى من قويٍّ فَكَّ قُوَّتَهُ","طولُ الزمانِ وسيفاً صارماً نحلاَ"],["7764EC50-C972-59BE-9C4C-7172BD5C5C00","إنّ ابنَ آدمَ يرجُو ما وراءَ غدٍ","ودونَ ذِلكَ غِيْلٌ يَعْتَقِي الأَمَلاَ"],["C49471E2-032F-5A2A-BEB1-88D555E8DF03","لو كان يعتقُ حياً من منيتهِ","تَحَرُّزٌ وحِذَارٌ أَحرَزَ الوَعِلا"],["D70CAD89-2CAE-5A2D-B87C-92D1A95CB96C","الأَعْصَمَ الصَّدَعَ الوَحْشِيَّ في شَغَفٍ","دُونَ السَّماءِ نِيافٌ يَفْرَعُ الجَبَلاَ"],["8CA912FA-1558-5273-ACC0-64DE6762A6E9","يَبِيْتُ يَحْفِرُ وَجْهَ الأَرْضِ مُجْتَنِحاً","إذا اطمأنَّ قليلاً قام فانتقلا"],["7F7A9BC8-8C30-5784-AEBC-69F4ABA3969A","أو طائراً من عتاقِ الطيرِ مسكنهُ","مصاعبُ الأرضِ والأشرافِ قدْ عقلاَ"],["13851ADE-F0DA-511D-BE51-3E153E228CC7","يكاد يقطع صعداً غير مكترثٍ","إلى السماءِ ولولا بعدها فعلا"],["691DC413-8462-5609-940A-FDA0D13C3D18","وليس ينزل إلاّ فوق شاهقةٍ","جَنْحَ الظَّلاَمِ ولولا الليلُ ما نَزَلاَ"],["95A59574-74DC-5D12-BBDB-044901EEE0FD","فذاكَ منْ أحذرِ الأشياءِ لو وألتْ","نفسٌ من الموتِ والآفاتِ أَنْ يَئِلاَ"],["E4C13004-B126-5D97-9655-F0EA69970617","فصرَّمَ الهَمَّ إذ وَلَّى بناحِيَةٍ","عَيْرَانَةٍ لا تَشَكَّى الأَصْرَ والعَمَلاَ"],["C4E8D039-661A-56D1-9828-D24B059A193B","من اللواتي إذا استقبلن مهمهةً","نجينَ منْ هولها الركبانَ والقفلاَ"],["EC3000C5-4588-5F01-BAA1-BE671E70FAA8","من فَرَّهَا يَرَهَا مِنْ جَانِبٍ سَدَساً","وجانبٍ نابها لمْ يعدُ أنْ بزلاَ"],["9E4041B5-F542-50E2-84BD-41708D2A9F4F","حرفٌ تشذرَ عنْ ريانَ منغمسٍ","مستحقبٍ رزأتهُ رحمها الجملاَ"],["21F8DA4C-FC53-5EC5-B544-3668BB97852A","أوكتْ عليه مضيقاً من عواهنها","كَمَا تَضَمَّنَ كشحُ الحُرَّةِ الحَبَلا"],["D67F07EA-77A2-5790-A5A3-63F969C2D8CE","كأنها وهي تحتَ الرحلِ لاهيةٌ","إذا المطيُّ على أنقائِهِ ذَمَلاَ"],["7359CB6C-C264-587B-B546-DA8B648FAB98","جُونِيَّةٌ من قَطَا الصَّوَّانِ مَسكنُها","جفاجفٌ تنبتُ القفعاءَ والبقلاَ"],["94CB7463-57E3-566A-B12C-E2870CC3666E","بَاضَتْ بِحَزْمِ سُبَيْعٍ أَوْ بِمَرْفَضِهِ","ذي الشيحِ حيث تلاقى التلعُ فانسحلاَ"],["6829A900-E560-5D18-8F40-92E1B2C65654","تروي لأزغبَ صيفيٍّ مهلكةٍ","إذا تَكَمَّشَ أولاد القطا خَذلا"],["7F82DA54-8BC9-598F-B83D-BB8A55E14733","تنوش من صوة الأنهار يطعمه","من التهاويل والزباد ما أكلا"],["441DDDC1-43C6-5843-A810-FCE0855D2E8C","تَضُمُّهُ لجَنَاحَيْهَا وجُؤجُؤُهَا","ضمَّ الفَتَاةِ الصَّبيَّ المُغْيِلَ الصَغِلا"],["DEF139A2-4761-5DE8-8935-066E507FAFB1","تَسْتَوْرِدُ السِّرَّ أحياناً إذا ظَمِئَتْ","والضَّحْلَ أسفل من جرزاته الغَلَلاَ"],["627C4D70-0907-553A-8ACA-2427323BBC79","تحسرت عقة عنه فأنسلها","و اجتاب أخرى جديداً بعدما ابتقلا"],["E7CE4BDF-2E14-5096-908B-7B1F209DE82D","مُوَلَّعٌ بسوادٍ في أَسافِلِهِ","منه احْتَذَى وبلَوْنٍ مِثْلِهِ اكْتَحَلاَ"]]},"DC5B2088-D5CA-55A3-B47B-94EA88541854":{"t":"أَخَذِمَتْ أَمْ وَذِمَتْ أَمْ مَالَهَا","p":72,"s":"أخذمت أم وذمت أم مالها","r":"440082","v":[["1C0B8BEC-4A17-531E-AB32-C968673B99E5","أَخَذِمَتْ أَمْ وَذِمَتْ أَمْ مَالَهَا","أَوْ صَادَمَتْ في قَعْرِهَا حِبَالَهَا"]]},"4AB1B5D8-7D19-58B6-BE6F-76BA0664629F":{"t":"أَضَلاَلُ لَيْلٍ سَاقِطٍ أَكْنَافُهُ","p":72,"s":"أضلال ليل ساقط أكنافه","r":"440049","v":[["CA03FDCF-0524-5D5A-9E58-0F5D1487728D","أَضَلاَلُ لَيْلٍ سَاقِطٍ أَكْنَافُهُ","فِي النَّاسِ أَعْذَرُ أَمْ ضَلاَلُ نَهَارِ"],["7A534DFE-A759-5A93-959E-9D585DF5E205","قَحْطَانُ وَالِدُنَا الّذي نُدْعَى لَهُ","وأبو خزيمَةَ خِنْدِفُ بنُ نزارِ"],["2E0878EE-EB01-5C13-9FD0-5B3010D9DC1D","أنبيع والدنا الذي ندعى له","بِأَبِي معاشِرَ غَائِبٍ مُتَوَارِي"],["C4C8A7F3-8821-5DB3-BC90-7F4BEF92A3C3","تِلْكَ التِّجَارَةُ لا زَكَاءَ لِمِثْلِهَا","ذهب يباع بآنك وإيار"],["4C781AB8-5944-50E6-AAFE-602E0FCBD68B","تعاطيكها كف كأن بنانها","إذا اعترضتها العين صف مداري"]]},"9E99CA35-D32B-5B96-8C0E-47D00797F6D7":{"t":"أَلاَ رُبَّ لَهْوٍ آنَسٍ ولَذَاذَةٍ","p":72,"s":"ألا رب لهو آنس ولذاذة","r":"440052","v":[["027D2EE2-FE9B-5DC8-9C32-924B12787261","أَلاَ رُبَّ لَهْوٍ آنَسٍ ولَذَاذَةٍ","من العيش يغبيه الخباء المستر"]]},"F1155460-627E-536E-9D1F-E33E21EDC47B":{"t":"إليك رمت بالقوم خوص كأنما","p":72,"s":"إليك رمت بالقوم خوص كأنما","r":"440054","v":[["32E35B8D-3F07-5B51-A4B1-6F19D2497E75","إليك رمت بالقوم خوص كأنما","جماجمها فوق الحجاج قبور"]]},"B36CC078-AA00-5254-B766-C0F2DEB59B5F":{"t":"إنا رضينا وإنْ غابتْ جماعتنا","p":72,"s":"إنا رضينا وإن غابت جماعتنا","r":"440061","v":[["79FAF573-93A2-532A-BE56-24C422A1D5A3","إنا رضينا وإنْ غابتْ جماعتنا","مَا قَالَ سَيِّدُنَا رَوْحُ بنُ زِنْبَاعِ"],["8F96811A-DFF2-5278-B341-CAEA21D5ADD4","يرعى ثمانينَ ألفاً كانَ مثلهمُ","مما يخالفُ أحياناً على الراعي"]]},"EE2B8CA5-9A46-5CA0-BC7C-02E67FB8281D":{"t":"إنَّ الخليطَ أجدوا البينَ فانقذفوا","p":72,"s":"إن الخليط أجدوا البين فانقذفوا","r":"440062","v":[["B57C4AE0-FFB1-566D-82C9-379634F93A95","إنَّ الخليطَ أجدوا البينَ فانقذفوا","وأمتعوكَ بشوقٍ أيةَ انصرفوا"],["946743AB-1667-59C9-BB67-705258BB29BF","حتى أتيتَ مرياً وهوَ منكرسٌ","كَاللَّيْثِ يَضْرِبُهُ في الغَابَةِ السَّعَفُ"]]},"BEBAB89C-DD88-5235-A93C-A2AAB75F2D3E":{"t":"بِكْرٌ يُرَبِّثُها آثَارُ مُنْبَعِقٍ","p":72,"s":"بكر يربثها آثار منبعق","r":"440080","v":[["BAB210EA-F72B-5E7B-9BC2-ACD4DC51B558","بِكْرٌ يُرَبِّثُها آثَارُ مُنْبَعِقٍ","تَرَى بِهِ حُفَناً زُرْقاً وغُدْرَانَا"],["CF46A82A-88AA-5261-891B-541DF41EE724","أَوْ ظَبْيَةٌ مِنْ ظِبَاءِ الحُوَّةِ ابْتَقَلَتْ","مَذَانِباً فَجَرَتْ نَبْتاً وحُجْرَانَا"],["B9C29763-2715-5828-A7BC-FE7CF3B61F37","وما حُسَيْنَةُ إذْ قامَتْ تُوَدِّعُنَا","للبينِ واعتقدتْ شذراً ومرجانا"],["AD6A30AA-1C63-5DA4-95CF-C7950E9898B5","لولا الإله واهل الأردن اقتسمت","نار الجماعة يوم المرج نيرانا"],["35DB5E4F-7570-5D03-8085-D8780BD383C4","كانوا زواراً لأهلِ الشامِ قد علموا","لما رَأوا فيهِمُ جَوْراً وطُغْيَانَا"]]},"0A23C13C-D008-5938-83B6-1A0A7D5851E6":{"t":"تَوَهَّمَ إبْلاَدَ المَنَازِلِ عَنْ حُقُبْ","p":72,"s":"توهم إبلاد المنازل عن حقب","r":"440038","v":[["667B5844-DC50-569E-A9A0-EFE505B17167","تَوَهَّمَ إبْلاَدَ المَنَازِلِ عَنْ حُقُبْ","فراجع شوقا ثمت ارتد في نصب"],["2E7DDBF4-31F1-57E5-AB4F-053903DAA16A","بزهمان لو كانت تكلم أخبرت","بِمَا لَقِيَتْ بَعْدَ الأَنِيْسِ مِنَ العَجَبْ"]]},"C210CF06-3271-5874-A9E5-28D8E06FD661":{"t":"جَمَعْتَ اللَّوَاتِي يَحْمَدُ اللَّه عَبْدهُ","p":72,"s":"جمعت اللواتي يحمد الله عبده","r":"440030","v":[["C08C53E1-7845-57B9-86D9-37639BE54173","جَمَعْتَ اللَّوَاتِي يَحْمَدُ اللَّه عَبْدهُ","عَلَيْهِنَّ فَلْيَهْنِىءْ لَكَ الخَيْرُ وَاسْلَمِ"],["36852EA2-7A9A-5196-B3D7-FB8F1400482A","فَأَوَّلُهُنَّ البِرُّ والبِرُّ غالِبٌ","وَمَا بِكَ مِنْ غَيْبِ السَّرَائِرِ يُعْلَمِ"],["E20C0331-8E03-5E90-92DE-AA37EF6ACD36","وَثَانِيَةٌ كَانَتْ مِنَ اللَّهِ نِعْمَةً","عَلَى المُسْلِمِينَ إذْ وَلِي خَيْرُ مُنْعِمِ"],["68B13C27-5B67-5B87-BAE2-D74A49835A87","وثالثةٌ أنْ ليسَ فيكَ هوادةٌ","لِمَنْ رَامَ ظُلْماً، أَوْ سَعَى سَعْيَ مُجْرِمِ"],["DE6B5B3F-6F31-5ED0-8A62-B6816CE1A9D2","وَرَابِعَةٌ أَنْ لاَ تَزَالَ مَعَ التُّقَى","تخبُّ بميمونٍ منَ الأمرِ مبرمِ"],["847DBCD0-7220-5CDF-B166-F6BEF1F9C731","وخامسةٌ في الحكمِ أنكَ تنصفُ","الضَّعِيْفَ، وَمَا مَنْ عَلَّمَ اللَّهُ كالعَمِي"],["3DFC19A5-D850-5B28-AD89-3BA758AF2C3E","وسادسةٌ أنَ الذي هو ربنا","اصْطَفَاكَ فَمَنْ يَتْبَعْكَ لاَ يَتَنَدَّمِ"],["9AC50ECE-F532-5A75-87BA-8B23F4894638","وَسَابِعَةٌ أَنَّ المَكَارِمَ كُلَّهَا","سَبَقْتَ إلَيْهَا كُلَّ سَاعٍ ومُلْجِمِ"],["B2CFC71E-E45F-5519-BF76-B723AD44C77C","وَثَامِنَةٌ في مَنْصِبِ الناسِ أَنَّهُ","سَمَا بِكَ مِنْهُمْ مُعْظَمٌ فَوْقَ مُعْظَمِ"],["0E140DCC-772C-5471-B0D0-BF6B5FDDD4C2","وَتَاسِعَةٌ أَنَّ البَرِيَّةَ كُلَّهَا","يعدونَ سيباً منْ إمامٍ متممِ"],["9EA36EC5-5DFA-52C7-9905-CD9CAFEF659E","وَعَاشِرَةٌ أَنَّ الحُلُومَ تَوَابِعُ","لحلمكَ في فصلٍ منَ القولِ محكمِ"]]},"EA767508-EC3E-55E5-B6D0-A20FA6930F21":{"t":"حسب الرائد المورض أن قد","p":72,"s":"حسب الرائد المورض أن قد","r":"440055","v":[["CBC4030A-27FC-5B0F-9136-0F758A0C25D2","حسب الرائد المورض أن قد","در منها بكل نبءٍ صوار"]]},"DB8B7DF5-959E-5B09-94A7-20A572AA3568":{"t":"سأرحل من قود المهاري شملة","p":72,"s":"سأرحل من قود المهاري شملة","r":"440045","v":[["7D4198F8-660B-5E97-8F18-E53AC6F06623","سأرحل من قود المهاري شملة","مسخرة ما تستحث بحادي"],["C391AE03-20A8-59DC-BD5C-4A2A6ED988B8","مع الريح ماراحت فإن هي أعصفت","نهوز برأس كالعلاة وهادي"]]},"F09662F0-748D-5BA9-8F55-9A58215E0513":{"t":"طار الكرى وألم الهم فاكتنعا","p":72,"s":"طار الكرى وألم الهم فاكتنعا","r":"440056","v":[["1354F869-5353-5111-ABA4-9E7D48B82895","طار الكرى وألم الهم فاكتنعا","و حيل بيني وبين النوم فامتنعا"],["34B59467-BAFA-5051-84E3-D1D7C3AABEAA","كان الشباب قناعاً استكن به","وأَسْتَظِلُّ زَمَاناً ثُمَّتَ انْقَشَعَا"],["AFAF3D01-EA5C-5A31-9756-6E0556CDD5D1","فاسْتَبْدَلَ الرَّأْسُ شَيْباً بعد دَاجِيَةٍ","فينانةٍ ما ترى في صدغها نزعا"],["7649D45F-C9CF-50F8-92FE-6C6CC5F18B57","فإن تكن ميعة من باطل ذهبت","وأَعْقَبَ اللَّهُ بعد الصَّبْوَةِ الوَرَعَا"],["EB6BC90D-DB29-577E-B816-056EE6231C30","فقد أبيت أراعي الخود راقدة","على الوَسَائِدِ مَسْرُوراً بها ولِعَا"],["4003E4BC-29BD-5EBC-893D-8C0FE66F1C83","براقة الثغر تشفي القلب لذتها","إذا مقبلها في ريقها كرعا"],["82F2F046-C6F3-5853-A73B-A22EAB2B55E2","كَالأُقْحُوَانِ بِضَاحِي الرَّوْضِ صَبَّحَهُ","غَيْثٌ أَرَشَّ بِتَنْضَاحٍ وما نَقَعَا"],["6D8570A1-018D-5580-91F8-95ADF2A92B3D","صَلَّى الَّذِي الصَّلَوَاتُ الطَّيِّبَاتُ لَهُ","والمُؤْمِنُونَ إذَا مَا جَمَّعُوا الجُمَعَا"],["1F82E15C-7700-5AE0-B352-7C862F666ECA","عَلَى الَّذِي سَبَقَ الأَقْوَامَ ضَاحِيَةً","بِالأَجْرِ والحَمْدِ حَتَّى صَاحَبَاهُ مَعَا"],["52ACAD53-3A68-577F-82CF-321FE019C8EC","لا يبرح المرء يستقري مضاجعه","حتى يقيم بأعلاهن مضطجعا"],["18D96D88-BD08-5C8E-B92B-183F7CA7A7F9","هو الَّذي جَمَعَ الرَّحْمَنُ أُمَّتَهُ","على يديه وكانوا قبله شيعا"],["B371FB08-D182-58E3-8B06-B2B8E46F56BD","عذنا بذي العرش ان نحيا ونفقده","وأن نكونَ لِرَاعٍ بَعْدَهُ تَبَعَا"],["D5013FD2-BFC9-5C1F-848C-26D87026F31B","إنَّ الوليدَ أَميرَ المؤمنين لَهُ","ملك عليه أعان الله فارتفعا"],["D0433AD4-DA4C-5811-9BC4-3273458C822A","لَهُ عِبَادٌ ولا يُعْطَوْنِ مَا مَنَعَا","له عباد ولا يعطو ما منعا"]]},"99579DE0-B4E3-5672-AA7B-A3142B7C1407":{"t":"عاميةٌ جرتِ الريحُ الذيولَ بها","p":72,"s":"عامية جرت الريح الذيول بها","r":"440077","v":[["4BF5C16C-5A58-5FFE-BD59-B24AAC206B2D","عاميةٌ جرتِ الريحُ الذيولَ بها","فقد تَخَذَّمَهَا الهِجْرَانُ والقِدَمُ"]]},"CE672C20-BB8C-5EFF-877A-1E3CC11022B3":{"t":"عن لسان كجثة الورل الأحمر","p":72,"s":"عن لسان كجثة الورل الأحمر","r":"440048","v":[["7C22EAD7-B4FA-5267-8431-1A66112F2ADC","عن لسان كجثة الورل الأحمر","مَجَّ النَّدَى عَلَيْهِ العَرَارُ"],["2E2D5AA5-2804-5BD2-9AB5-4451F784D0BD","فَكَأَنِّي مِنْ ذِكْرِكُمْ خَالَطَتْنِي مِنْ م","فلسطين جلس خمر عقار"],["7AFC8DB6-A89C-5D34-BCDA-B6EBCF731C01","عُتِّقَتْ في القِلاَلِ مِنْ بَيْتِ رَأْسٍ م","سنوات وما سبتها التجار"],["2BFCCA2C-3DD7-5679-8BCD-00FE651ABF5F","فهي صهباء تترك المرء أعشى","في بياض العينين عنها احمرار"],["CBB7156C-0433-5CAF-B492-61FDF9AD52FA","فنأت وانتوى بها عن هواها","شظف العيش آبل سيار"]]},"0E23E05F-1B07-555A-94D4-F6D7970D1E8D":{"t":"عَرَفَ الدِّيَارَ تَوَهُّماً فاعْتَادَهَا","p":72,"s":"عرف الديار توهما فاعتادها","r":"440031","v":[["52B204BD-A599-5F33-872A-8E075438570D","عَرَفَ الدِّيَارَ تَوَهُّماً فاعْتَادَهَا","من بعدِ ما درسَ البلى أبلادها"],["243E1B62-D5E3-5D94-B390-3690B4B866DD","إلا رواسيَ كلهنَّ قد اصطلى","جمراً واشعلَ أهلها إيقادها"],["893A3EBE-7B08-5E92-B3C7-399C48F7802F","بِشُبَيْكَةِ الحَوَرِ الّتِي غَرْبِيّهَا","فَقَدَتْ رسومُ حِيَاضِهَا وُرَّادَها"],["9DD0AED7-A08F-58AD-AE39-8DF4BB8FC0AF","كانَتْ رواحِلَ للقُدُورِ فَعُرِّيَتْ","منهنَّ واستلبَ الزمانُ رمادها"],["FEBA4CE0-6FBD-5765-9F0C-C4216E2AC941","وتنكرتْ كلَّ التنكرِ بعدنا","وَالأَرْضُ تَعْرِفُ بَعْلَهَا وَجَمَادَهَا"],["B324DF69-8D18-5A68-A0DF-F031FDACDD56","وَلَرُبَّ وَاضِحَةِ الجَبِيْنِ خَرِيدَةٌ","بَيْضاءُ قَدْ ضَرَبَتْ بِهَا أَوْتَادَهَا"],["482F68AC-961D-5767-89FB-09D4AF5EB2B7","تصطادُ بهجتها المعللَ بالصبا","عُرُضاً فَتُقْصِدُهُ وَلَنْ يَصْطَادَهَا"],["0D9A10C8-BCEC-5561-9482-DD4F14F198EE","كالظبيةِ البكرِ الفريدةِ ترتعي","من أرضها قفاتها وعهادها"],["89474E38-624F-5541-AD59-84B3C8EBB00A","خضبتْ بها عقدُ البراقِ جبينها","مِنْ عَرْكِهَا عَلَجَانَهَا وَعَرَادَهَا"],["74CBBCED-55D6-5847-B2AA-BA0D070FA090","كَالزَّيْنِ فِي وَجْهِ العَرُوسِ تَبَذَّلَتْ","بَعْدَ الحَيَاءِ فَلاَعَبَتْ أَرْآَدَهَا"],["7E7D2D6F-76E7-5C38-86B3-AF42FC8D1D09","تُزْجِي أَغَنَّ كَأَنَّ إبْرَةَ رَوْقِهِ","قلمٌ أصابَ منَ الدواةِ مدادها"],["5FB47F26-75AC-5EE6-BFA4-D9BC5202D8EF","ركبتْ بهِ منْ عالجٍ متحيراً","قَفْراً تُرَبِّبُ وَحْشُهَا أَوْلاَدَهَا"],["8E540859-9929-5FE9-85BE-0F3019F8EF7A","فَتَرَى مَحَانِيهِ الَّتِي تَسِقُ الثَّرَى","والهبرُ يونقُ نبتها روادها"],["A2E80859-369B-50D9-A84A-C6881267EB76","بمجرِّ مرتجزِ الرواعدِ بعجتْ","غرُّ السحابِ بهِ الثقالُ مزادها"],["4ABFED2C-FB07-59DF-B96B-4194668FC3A8","بَانَتْ سُعَادٌ وَأَخْلَفَتْ مِيْعَادَهَا","وَتَبَاعَدَتْ عَنَّا لِتَمْنَعَ زَادَهَا"],["E31BF32F-EC30-562F-AE5C-04F90AB30D79","إنِّي إذَا مَا لَمْ تَصِلْنِي خُلَّتِي","وَتَبَاعَدَتْ عَنِّي اغْتَفَرْتُ بِعَادَهَا"],["FB6EE444-0C2E-5ADA-AC8E-5721B92E0D1E","وَإذَا القَرِيْنَةُ لَمْ تَزَلْ فِي نَجْدَةٍ","مِنْ ضِغْنِهَا سَئِمَ القَرِيْنُ قِيَادَهَا"],["35169A44-E3C3-5900-856A-888DFC7614AD","إمَّا تَرَى شَيْبِي تَفَشَّغَ لِمَّتِي","حتى علا وضحٌ يلوحُ سوادها"],["935703F5-6ECB-5AE9-A593-ACAE71B9DAAF","فلقدْ ثنيتُ يدَ الفتاةِ وسادةً","لي جاعلاً يسرى يديَّ وسادها"],["638A92F1-7025-5C8A-AF55-DA8E55A30CA1","وَلَقَدْ أَصَبْتُ مِنَ المَعِيشَةِ لَذَّةً","ولقيتُ منْ شظفِ الخطوبِ شدادها"],["B4A884A0-E30A-525D-91FC-566976E27646","وَعَمِرْتُ حَتَّى لَسْتُ أَسْأَلُ عَالِماً","عنْ حرفِ واحدةٍ لكيْ أزدادها"],["DF9EE61A-099E-5865-A6AC-493BC2591AC9","وأصاحبُ الجيشَ العرمرمَ فارساً","فِي الخَيْلِ أَشْهَدُ كَرَّهَا وَطِرَادَهَا"],["0222DCCE-C73E-5B73-AD48-74141CCD307D","وَقَصِيدَةٍ قَدْ بِتُّ أَجْمَعُ بَيْنَهَا","حتى أقومَ ميلها وسنادها"],["051FCF91-5198-5845-A1DF-7F5CB73C679A","نظرَ المثقفُ في كعوبِ قناتهِ","حتى يقيمَ ثقافهُ منآدها"],["F9D2CD4E-B9D2-58F1-BD1E-97355247940A","فَسَتَرْتُ عَيْبَ مَعِيْشَتِي بِتَكَرُّمٍ","وأتيتُ في سعةِ النعيمِ سدادها"],["2DBD5AB9-C1BB-56EF-983C-FFF246D0DE6B","وعلمتُ حتى ما أسائلُ عالماً","عنْ علمِ واحدةٍ لكيْ أزدادها"],["4B2CB2FF-C234-51A8-99D5-5389A5F53DB1","صَلَّى الإِلهُ عَلَى امْرِىءٍ وَدَّعْتُهُ","وَأَتَمَّ نِعْمَتَهُ عَلَيْهِ وَزَادَهَا"],["FAA44AFB-7738-5112-AFB4-C8F1C0D9E565","وإذا الربيعُ تتابعتْ أنواؤهُ","فَسَقَى خُنَاصِرَةَ الأَحَصِّ فَجَادَهَا"],["40812A19-C69A-5371-AE26-9BDD2654C791","نزلَ الوليدُ بها فكانَ لأهلها","غَيْثاً أَغَاثَ أَنِيْسَهَا وَبِلاَدَهَا"],["46D00A1C-2DF4-5428-A103-E7D415D079D8","وَلَقَدْ أَرَادَ اللَّهُ إذْ وَلاَّكَهَا","مِنْ أُمِّةٍ إصْلاَحَهَا وَرَشَادَهَا"],["86308713-9C3B-58AF-BE41-21704134A152","وَعَمِرْتَ أَرْضَ الْمُسْلِمِيْنَ فَأَقْبَلَتْ","وَنَفَيْتَ عَنْهَا مَنْ يُرِيْدُ فَسَادَهَا"],["7AC44F8C-CE48-58F8-9F25-10F1761C248B","وأصبتَ في بلدِ العدوِّ مصيبةً","بَلَغَتْ أَقَاصِيَ غَوْرِهَا وَنِجَادَهَا"],["8CEAA481-1E34-5B20-BF91-CB8E9B1AEFD7","ظفراً ونصراً ما تناولَ مثلهُ","أَحَدٌ مِنَ الخُلَفَاءِ كَانَ أَرَادَهَا"],["58A21DE4-A03C-5F0E-9B73-5B4BE85A2E4A","وإذا نشرتَ لهُ الثناءَ وجدتهُ","جَمَعَ المَكَارِمَ طُرْفَهَا وَتِلاْدَهَا"],["7B0DDC21-4B3F-58EB-93BA-E8F7130FC64F","أو ماترى أنَّ البريةَ كلها","أَلْقَتْ خَزَائِمَهَا إلَيْهِ فَقَادَهَا"],["CCCEDCBE-8E88-57B9-ACFC-F5B5B710173C","غَلَبَ المَسَامِيحَ الوَلِيدُ سَمَاحَةً","وكفى قريشَ المعضلاتِ وسادها"],["93FD01C8-F975-5DFD-ABE4-FEF986525FBF","تأتيهِ أسلابُ الأعزةِ عنوةً","قَسْراً وَيَجْمَعُ لِلْحُرُوْبِ عِتَادَهَا"],["D0AD267E-5C53-5CDE-9611-9095ECC127CA","وَإذَا رَأَى نَارَ العَدُوِّ تَضَرَّمَتْ","سامى جماعةَ أهلها فاقتادها"],["AD2E3DFC-F9A6-5B28-ACAB-B9F1268F1068","بعرمرمٍ - تبدو الروابي - ذي وعى","كَالْحِرَّةِ احْتَمَلَ الضُّحَى أَطْوَادَهَا"],["9759F37E-1226-586D-A749-B9C1DCC5AF2D","أَطْفَأْتَ نَاراً لِلْحُرُوبِ وَأُوْقِدَتْ","نَارٌ قَدَحْتَ بِرَاحَتَيْكَ زِنَادَهَا"],["061EC50B-D6A2-53CF-828E-D1E62170EB66","فبدت بصيرتها لمنْ يبغي الهدى","وَأَصَابَ حَرُّ شَدِيْدِهَا حُسَّادَهَا"],["5FB5DE8B-E4B1-51B4-B3EA-616F4207CD4E","وَإذَا غَدَا يَوماً بِنَفْحَةِ نَائِلٍ","عرضتْ لهُ الغدَ مثلها فأعادها"],["E268FB9A-CEE1-50B1-999B-9EC2BD138B91","وإذا عدتْ خيلٌ تبادرُ غايةً","فالسابقُ الجالي يقودُ جيادها"]]},"CD39D7B0-E460-55B6-B3BE-A0164ABF31F3":{"t":"عَلَى ذِي مَنَارٍ تَعْرِفُ العَيْنُ مَتْنَهُ","p":72,"s":"على ذي منار تعرف العين متنه","r":"440059","v":[["93FB7F20-B9AC-5039-ACF2-98DE30697D6A","عَلَى ذِي مَنَارٍ، تَعْرِفُ العَيْنُ مَتْنَهُ","كَمَا تَعْرِفُ الأَضْيَافُ دَارَ المُقَطَّعِ"]]},"0D5B1CD9-27B5-5002-90D9-4997DDE6F97D":{"t":"غَابَتْ سَرَاةُ بَنِي بَحْرٍ وَلَوْ شَهدُوا","p":72,"s":"غابت سراة بني بحر ولو شهدوا","r":"440042","v":[["76561BFD-8DFC-5117-945F-C517270C53B9","غَابَتْ سَرَاةُ بَنِي بَحْرٍ، وَلَوْ شَهدُوا","يوما لأعطيت ما أبغي وأطلب"],["74BEA9C9-9AF8-5D33-9659-BBDB241D35CF","حَتَّى وَرَدْنَا القُنَيْنِيَّاتِ ضَاحِيَةً","في ساعة من نهار الصيف تلتهب"],["FFAEF9D4-EDDD-5DEA-8AAE-8040DB24E649","فَجَاءَ بِالْبَارِدِ العَذْبِ الزُّلاَلِ لَنَا","ما دام يمسك عودا ذاويا كرب"],["C767E017-9196-5A18-9BA9-FC90BA3768A6","مِنْ مَاءِ خَالَةَ جَيَّاشٌ بِذِمَّتِهِ","مما توارثه الأوحاد والعتب"]]},"A50B15ED-AA87-5AB1-A615-E5404235FF90":{"t":"غَشِيْتُ بِعِفْرَى أو بِرِجْلَتِهَا رَبْعاً","p":72,"s":"غشيت بعفرى أو برجلتها ربعا","r":"440060","v":[["47CE7185-E84D-574E-B7A5-4D3D7B627224","غَشِيْتُ بِعِفْرَى أو بِرِجْلَتِهَا رَبْعاً","رَمَاداً وَأَحْجَاراً بَقِيْنَ بِهَا سُفْعَا"],["B2414F3D-47F1-5AD0-8F6E-2476EBCE2359","فما رمتها حتى غدا اليومُ نصفهُ","وحتى سَرَتْ عيناي كلتاهُمَا دَمْعَا"],["70264FAE-87D9-5899-9BB2-B1B7B9FA809B","فظلتُ كأني شاربٌ لعبتْ بهِ","عقارٌ ثوتْ في سجنها حججاً تسعاً"],["77CECC04-63B9-5D8F-9D0D-82DD1EC8306A","مَقَدِّيَّةٌ صَهْبَاءُ تُثْخِنُ شَرْبَهَا","إذا ما أرادوا أنْ يروحوا بها صرعى"],["9B1DD26A-0B55-58D5-A1F2-8ED035884502","أُسِرُّ هُمُوماً لو تَغَلْغَلَ بَعْضُهَا","إلى حجرٍ صلدٍ تركنَ بهِ صدعا"],["8D6B0DB7-6290-5727-AE94-8B29A27CC19C","عُصَارَةُ كَرْمٍ مِنْ حُدَيْجَاءَ لَمْ تَكُنْ","مَنَابِتُها مُسْتَحْدَثَاتٍ ولا قُرْعَا"],["148BB3C8-2070-594B-A675-E8C3D8645A5E","قذرْ ذا ولكن هل ترى ضوءَ بارقٍ","وَمِيْضاً ترى منه على بُعْدِهِ لَمْعَا"],["3452E5EC-F9D7-5E97-9FC1-514E15F483D2","تَصَعَّدَ في ذاتِ الأَرَانِبِ مَوْهِناً","إذا هَزَّ رَعْداً خِلْتَ في وِدْقِهِ شَفْعَا"]]},"CE6CB548-B810-55AC-B79C-EB38AEE1443D":{"t":"فأوردها لما انجلى الليل أودنا","p":72,"s":"فأوردها لما انجلى الليل أودنا","r":"440040","v":[["775B5712-6AE2-5F52-90F3-07EA88B1066F","فأوردها لما انجلى الليل أودنا","فضًى كُنَّ لِلْجُوْنِ الحَوَائِمِ مَشْرَبَا"],["AE9D039B-46E3-5615-9959-4FEF476B055D","أَتَعْرِفُ بِالصَّحْرَاءِ شَرْقِيَّ شَابِكٍ","منازل غزلان لها الأنس أطيبا"],["F2C318C1-F429-5E25-AAF9-BDFE1D71D584","ظللت أريها صاحبي وقد أرى","بِهَا صَاحِباً مِنْ بَيْنِ غُرٍّ وَأَشْيَبَا"]]},"944F7623-B92C-58A2-B815-CD5731982E6B":{"t":"فبت ألهي في المنام بما أرى","p":72,"s":"فبت ألهي في المنام بما أرى","r":"440053","v":[["B65FB052-B193-5E11-ACFF-9BD1BE3291B8","فبت ألهي في المنام بما أرى","وفي الشَّيْبِ عن بعضِ البطالةِ زاجِرُ"],["50136080-F947-5158-848E-C59790AF978A","بساجية العينين خود يلذها","إذا طرق الليل الضجيع المباشر"],["9069803B-5764-505E-91D9-2A39848168E3","كأن ثناياها بنات سحابة","سَقَاهُنَّ شُؤْبُوبٌ مِنَ الليْلِ بَاكِرُ"],["A5228A6E-8CC8-5E4B-929E-FB3EEF731DC6","فهنَّ معاً أو أُقْحُوانٌ بِرَوْضَةٍ","تعاوره صوبان: طل وماطر"],["2D637A51-48FA-52FA-8695-761AB967EDEF","أَهَمَّ سُرىً أَمْ غَارَ للغَيْثِ غَائِرٌ","أَم انْتَابَنَا من آخِرِ اللَّيْلِ زَائِرُ"],["E842155F-AAD1-5814-AF5F-DA2609E1B371","وَنَحْنُ بأرضٍ قَلَّ ما يَجْشَمُ السُّرى","بها العربيات الحسان الحرائر"],["B3D9F0B2-9D29-5AFE-AC7E-41754CE0D4E5","كثيرٌ بها الأَعْدَاءُ، يَحْصَدُ دُوْنَها","بريد الإمام المستحث المثابر"],["0334DE44-2834-5539-8B24-DAB45924A2D5","فقلت لها: كيف اهتديت ودوننا","دُلُوكٌ وَأَشْرَافُ الجِبَالِ القَوَاهِرُ"],["1716B891-E983-5D1E-BD4F-A422C7B946D0","وجَيْحَانُ جَيْحَانُ الملوكِ وَآلِسٌ","وحزن خزازى والشعوب القواسر"]]},"D4691114-9289-5FC4-B1D2-221F54634DFD":{"t":"فشبحنا قناعا رعت الحياة","p":72,"s":"فشبحنا قناعا رعت الحياة","r":"440036","v":[["8CEB993C-0856-57F6-9647-1DB715F3072A","فشبحنا قناعا رعت الحياة","أَوْ جُوْشٌ فَهِيَّ قُعْسٌ نِوَاءُ"]]},"3AA8624E-6709-5B37-A4A3-6ECD7A78A9D9":{"t":"فظل بصحراء الأميشط يومه","p":72,"s":"فظل بصحراء الأميشط يومه","r":"440043","v":[["828E4721-A786-5DF9-A6C7-A079581FD33B","فظل بصحراء الأميشط يومه","خميصا يضاهي ضغن هادية الصهب"],["DF9ED075-0F7F-58BF-83F0-70E5AEE78375","فَسَلَّ هَوَى مَنْ لاَ يُؤَاتِيْكَ وُدُّهُ","بِآدَمَ شَهْمٍ لاَ حُلُوٌّ وَلاَ صَعْبُ"],["10A2FEBF-C7A6-5613-9641-853413223FCB","كَأَنِّي وَمَنْقُوشاً مِنَ المَيْسِ قَاتِراً","وَأَبْدَانَ مَكْبُوْنٍ تَحَلَّبَهُ عَضْبُ"],["4C521218-3C92-513C-8E03-7B7E4870CCE6","عَلَى أَخْدَرِيٍّ لَحْمُهُ بِسَرَاتِهِ","مُذْكِي فِتَاءٍ مِنْ ثَلاَثٍ لَهُ شُرْبُ"],["8F929D94-A058-5C06-8FA7-20F05052AF2E","فَلاَهُنَّ بِالْبُهْمَى وَإيَّاهُ إذْ شَبَتَا","جَنُوْبَ إرَاشٍ فَاللَّهَالِهُ فَالْعَجْبُ"]]},"5C9AE8AA-C998-5815-B53E-1EB76D9DC0F3":{"t":"فما بهِ بطنُ وادٍ غبَّ نضحتهِ","p":72,"s":"فما به بطن واد غب نضحته","r":"440064","v":[["E559A3EA-FA10-5D70-9841-E4FBA4E1EF75","فما بهِ بطنُ وادٍ غبَّ نضحتهِ","وإنْ تراغبَ إلاَّ مسفهٌ تئقُ"],["46618F15-EFF5-5189-B616-B1E24EE7A2EA","واسْتَذْفَرُوا بِنَوىً حَذَّاءَ تَقْذِفُهُمْ","إلى أقاصي نواهمْ ساعةَ انطلقوا"]]},"B0D5554A-5BCD-5C26-A94E-2303778DF343":{"t":"فما عزلوك مسبوقاً ولكن","p":72,"s":"فما عزلوك مسبوقا ولكن","r":"440044","v":[["4843FB58-BA1A-5EC5-821A-2A7200337095","فما عزلوك مسبوقاً ولكن","إلى الخَيْرَاتِ سَبَّاقاً جَوَادَا"],["856897EA-2B0F-576A-B6E6-44D5CEFAD6AE","وَكُنْتَ أخي وما وَلَدَتْكَ أُمِّي","وصولا باذلاً لي مستزادا"],["7BC1A010-E092-5646-AA04-5B235F71B508","وقد هيضت لنكبتك القدامى","كَذَاكَ اللَّهُ يَفْعَلُ مَا أَرَادَا"]]},"7C18F022-9829-540E-BADC-DB50CDAC6097":{"t":"فَإنْ تَكُ فِي مَنَاسِمِهَا رَجَاءٌ","p":72,"s":"فإن تك في مناسمها رجاء","r":"440067","v":[["E502FFFA-D404-5175-BD67-83163536DB44","فَإنْ تَكُ فِي مَنَاسِمِهَا رَجَاءٌ","فقد لَقِيَتْ مَنَاسِمُها العِدَالاَ"],["F0E2BBC8-3244-59D4-84C9-90DE42FDA77E","أَتت عَمْراً فَلاَقَتْ مِنْ نَدَاهُ","سِجَالَ الخَيْرِ إنَّ لَهُ سِجَالاً"]]},"46EAF507-D632-5AD0-829B-3567B8C5BAE0":{"t":"قد حباني الوليد يوم أسيس","p":72,"s":"قد حباني الوليد يوم أسيس","r":"440035","v":[["ED26860C-C952-5867-AFE1-D7CC9FDC73B3","قد حباني الوليد يوم أسيس","بِعِشَارٍ فِيْهَا غِنًى وَبَهَاءُ"]]},"78D415E6-BC89-508D-95AF-0BF43A030692":{"t":"قمر السماء وشمسها اجتمعا","p":72,"s":"قمر السماء وشمسها اجتمعا","r":"440057","v":[["CC4C1046-E3E5-5D46-883A-19A155C52D0C","قمر السماء وشمسها اجتمعا","بالسَّعْدِ ما غَابَا ومَا طَلَعَا"],["3FA51050-4DD9-5E99-8BD9-7F073485362B","مَا وَارَتِ الأَسْتَارُ مِثْلَهُمَا","مِمَّنْ رَأَى هَذَا وَمَنْ سَمِعَا"],["1C744DA2-FAD5-51BA-A3CB-E4E1973692FF","دام السرور له بها ولها","وَتَهَنَّيَا طُولَ الحَيَاةِ مَعَا"]]},"B41F206F-2398-570F-BC3F-F0C353029884":{"t":"كانت تحل إذا ما الغيث أصبحها","p":72,"s":"كانت تحل إذا ما الغيث أصبحها","r":"440051","v":[["ABA77E9A-3F15-5CA2-9A27-15A474297EA1","كانت تحل إذا ما الغيث أصبحها","بَطْنَ الحَلاَءَةِ فالأَمرارَ فالسُّرَرَا"]]},"0CDD4F56-EDE9-524A-AD20-51458279D203":{"t":"كُلَّمَا رَدَّنَا شَطاً عَنْ هَوَاهَا","p":72,"s":"كلما ردنا شطا عن هواها","r":"440034","v":[["FED14478-2F19-51F7-BE04-5992B2A8F999","كُلَّمَا رَدَّنَا شَطاً عَنْ هَوَاهَا","شطنت دار ميعة حقباء"],["5114368B-4DE0-57AB-A7B6-3DC25E1D3CA3","بِعُرَابٍ إلَى الإلاهَةِ حَتَّى","تبعت أمهاتها الأطلاء"],["AF00E63C-3611-5888-BFB2-080D20A72152","ردني النجم واستقلت وحارت","كل يوم عشية شهباء"],["ADFAFC92-EC2D-5724-B0C4-5B6C0273F8E3","فترددن بالسماوة حتى","كَذَبَتْهُنَّ غُدْرُهَا وَالنِّهَاءُ"],["2F78FD00-0638-5FEF-B0B5-4A76ABA0BC63","وَيَكِرُّ العَبْدَانِ بِالْمِحْلَبِ الأَجْنَفِ م","فِيْهَا حَتَّى يَمُجَّ السِّقَاءُ"],["92A63A01-53FD-5FAB-A4E8-96DBBEF4F04F","يَحْسَبُ النَّاظِرُوْنَ مَا لَمْ يُفَرُّوا","أنها جلة وهن فتاء"],["70E5B604-21F1-59D1-B66F-EA916F299432","لو ثوى لا يريمها ألف حول","لم يطل عندها عليه الثواء"],["21B038B5-8F45-519E-B725-DF4583293036","أَهْوَاهَا يَشُفُّهُ أَمْ أُعِيْرَتْ","مَنْظَراً فَوْقَ مَا أُعِيْرَ النِّسَاءُ"]]},"9337D449-CADB-5EA6-BD14-B14131CC6F49":{"t":"لمن المنازل أقفرت بغباء","p":72,"s":"لمن المنازل أقفرت بغباء","r":"440033","v":[["14945BFE-F2C2-5F4A-A435-4FE7F08EA2F0","لمن المنازل أقفرت بغباء","لو شئت هيجت الغداة بكائي"],["FFE47923-9BE4-5124-A5A5-46F8533DE140","فالغمر غمر بني جذيمة قد ترى","مأهولة فخلت من الأحياء"],["32DDE366-6357-5818-B985-B1A6B80395F4","لولا التجلد والتعزي إنه","لاَ قَوْمَ إلاَّ عَقْرُهُمْ لِفَنَاءِ"],["9A60DD78-3D33-5000-969B-C044D83E5F0F","نَادَيْتُ أَصْحَابِي الَّذِيْنَ تَوَجَّهُوا","وَدَعَوْتُ أَخْرَسَ مَا يُجِيْبُ دُعَائِي"],["21794ABF-2DC4-55D8-8B71-DF893C8E0E35","وإذا نظرت إلى أميري زادني","ضَنّاً بِهِ نَظَرِيْ إلَى الأُمَرَاءِ"],["4B295FB1-3004-5382-B505-2E507E1824E8","تسمو العيون إليه حين يرونه","كالبدر فرج بهمة الظلماء"],["C11A692B-3108-5028-9CF6-C9DEC93BCF98","والأصل ينبت فرعه متأثلا","والكف ليس بنانها بسواء"],["C53BD275-D8D8-552C-BE89-39EBF9746708","بل ما رأيت جبال أرض تستوي","فِيْمَا غَشِيْتُ وَلاَ نُجُوْمَ سَمَاءِ"],["61F7D4F4-243F-5AA2-B529-6D9062D5FC34","والقوم أشباه وبين حلومهم","بون كذاك تفاضل الأشياء"],["C2BE1E3E-8FFD-57DE-9220-7AB65BF2D4AD","والبرق منه وابل متتابع","جود وآخر ما يبض بماء"],["4F92D416-1BA5-5DB5-A94D-91596E5AF9D2","وَالْمَرْءُ يُوْرِثُ مَجْدَهُ أَبْنَاءَهُ","ويموت آخر وهو في الأحياء"],["88C4A1F4-1010-59EE-9F7F-91051C740E27","وَالدَّهْرُ يَفْرُقُ بَيْنَ كُلِّ جَمَاعَةٍ","ويلف بين تباعد وتناء"]]},"6CA26108-20A4-5719-B67F-5EBCFEEEE0E7":{"t":"لولاَ الحياءُ وأنَّ رأسيِ قدْ عثا","p":72,"s":"لولا الحياء وأن رأسي قد عثا","r":"440071","v":[["BD5EC8EE-E9A5-55F4-BEAB-E951EDDE2EEC","لولاَ الحياءُ وأنَّ رأسيِ قدْ عثا","فِيهِ المَشِيْبُ لَزُرْتُ أُمَّ القَاسِمِ"],["3F373180-A588-5638-BE66-FC1D2C5C0311","وكأنها وسطَ النساءِ أعارها","عينين أحورُ منْ جآذرِ جاسمِ"],["8FE3EB75-AA9E-5F58-941A-82621B861DCF","وسنانُ أقصدهُ النعاسُ فرنقتْ","فِي عَيْنِهِ سِنَةٌ وَلَيْسَ بِنَائِمِ"],["A0D47CB3-DD2A-57CF-AC62-2FA785FFA973","يَصْطَادُ يَقْظَانَ الرِّجَالِ حَدِيْثُهَا","وتطيرُ بهجتها بروحِ الحالمِ"],["538D0D1E-8837-5346-8A69-8A2B814DF0B6","ألممْ علىْ طللٍ عفا متقادمٍ","بَيْنَ الذُّؤَيْبِ وبين غَيْبِ النَّاعِمِ"],["67C94E84-02C0-5F92-B96E-0EA7A248112A","بمجرِّ غزلانِ الكناسِ تلفعتْ","بَعْدِي بِمُنْكَرِ تُرْبِها المُتَرَاكِمِ"]]},"E6660B42-3B50-50F3-87BC-4A0248296105":{"t":"لَعَمْرِي لَقَدْ أَصْحَرَتْ خَيْلُنَا","p":72,"s":"لعمري لقد أصحرت خيلنا","r":"440037","v":[["0E5BDD34-078D-5A32-A541-72E2A7821A01","لَعَمْرِي لَقَدْ أَصْحَرَتْ خَيْلُنَا","بأكناف دجلة للمصعب"],["584FBE74-1231-5DD2-BC22-3E84D559A0F0","إذا ما منافق أهل العرا","قِ عُوْتِبَ ثُمَّتَ لَمْ يُعْتَبِ"],["7E7D8DF9-D848-541E-ADC1-B977C97AD946","دَلَفْنَا إلَيْهِ بِذِي تُدْرَإِ","قليل التفقد للغيب"],["FE3143F5-001A-5A7D-AB1A-ED41BCDDB516","يهزون كل طويل القنا","ةِ مُلْتَئِمِ النَّصْلِ وَالثَّعْلَبِ"],["8131E14F-DCA0-54A0-A5E9-FA8DD38506CB","كأن وعاهم إذا ما غدوا","ضجيج قطا بلد مخضب"],["F1B27AC0-BB03-5F14-A02D-A5AD3AECD97E","فَقَدَّمَنَا وَاضِحٌ وَجْهُهُ","كَرِيْمُ الضِّرَائِبِ وَالْمَنْصِبِ"],["64F5341C-F167-5AD1-8DD7-01A8AC3B2B1F","فداؤك أمي وأبناؤها","وَإنْ شِئْتَ زِدْتُ عَلَيْهَا أَبِي"],["88C06410-884C-5CFC-93D3-7D1AAF7E86FD","وَمَا قُلْتُهَا رَهْبَةً إنَّمَا","يَحُلُّ العِقَابُ عَلَى المُذْنِبِ"],["E387EC8A-6849-516A-BE43-AD8F720D01B1","إذَا شِئْتُ نَازَلْتُ مستثْقِلاً","أزاحم كالجمل الأجدب"],["7DD64BDB-812B-50DD-B2F0-085E1602E211","فمن يك منا منا","ومن يك من غيرنا يهرب"],["1FEAF267-0D8D-5DEC-BE9D-CB1CC7FD149D","أعين بنا ونصرنا به","ومن ينصر الله لم يغلب"]]},"679C4EC5-8290-5EDE-ACEB-BD49D04C9FC3":{"t":"لَمَّا غَدَا الحَيُّ من صَرْخٍ وغَيَّبَهُمْ","p":72,"s":"لما غدا الحي من صرخ وغيبهم","r":"440078","v":[["A19A12D2-3EBD-5715-B276-6FFC12E1818E","لَمَّا غَدَا الحَيُّ من صَرْخٍ وغَيَّبَهُمْ","مِنِ الرَّوَابِي التي غَرْبِيُّها اللَّمَمُ"],["3D60A788-AEB6-5EAD-A503-AC2F498A0ECE","ظلتْ تطلعُ نفسي إثرهمْ طرباً","كأنني منْ هواهمْ شاربٌ سدمُ"],["5B24D479-5EA6-59DA-BC44-310909ABB390","مِسْطَارَةٌ بَكَرَتْ في الرَّأْسِ نَشْوَتُهَا","كأنَّ شاربها مما بهِ لممُ"],["5715488E-8F26-581B-8A04-6AB23B91C26C","حتى تعرض أعلى الشيح دونهمُ","والحبُّ حبُّ بني العسراءِ والهدمُ"],["74DCF3BB-8067-5259-899C-9DF39FD39E22","فَنَكَّبُوا الصُّوَةَ اليُسْرَى فَمَالَ بِهِمْ","على الفِرَاضِ فِراضُ الحاملِ الثَّلِمُ"],["06808AA7-2D6E-5FFD-8B3C-85E5B51F4F60","لولا اخْتِيَارِي أبَا حَفْصٍ وطَاعَتَهُ","كادَ الهَوَى مِنْ غَداةِ البَيْنِ يَعْتَزِمُ"]]},"15B4DE3B-D4C1-5CEF-B787-E9DB2F6C8DD7":{"t":"لِمَنْ رَسْمُ دَارٍ كالكتابِ المُنَمْنَمِ","p":72,"s":"لمن رسم دار كالكتاب المنمنم","r":"440069","v":[["54AE6FBB-DAA2-5F72-9C02-AE09D51F1281","لِمَنْ رَسْمُ دَارٍ كالكتابِ المُنَمْنَمِ","بِمُنْعَرَجِ الوادي فُوَيْقَ المُهَزَّمِ"],["86A153B4-07BD-5E6E-A4D5-E9CBFBCD3E83","فلما تجاوزنَ الحصيداتِ كلها","وخلفنَ منها كل رعنٍ ومخرمِ"],["6E15B63C-1562-51BF-BFA7-F452A3136B03","تخطينَ بطنَ السرِّ حتى جعلنهُ","يلي الغربَ سيلَ المنتوى المتيممِ"],["7720662D-8B4B-5BDF-8F76-92B8ACEEE6D2","إذَا شِئْتَ أَنْ تَلْقَى فَتَى الْبَأسِ والنَّدَى","وَذَا الْحَسَبِ الزَّاكِي التَّلِيْدِ المُقَدَّمِ"],["7A64C7E9-A740-5CB7-967E-FB7ED9809B79","فكُنْ عُمَراً تَأْتِي ولا تَعْدُوَنَّهُ","إلى غَيْرِهِ وَاسْتَخْبِرِ النَّاسَ وَافْهَمِ"],["28A04642-4BBD-5933-A25C-F9849D84F32E","كَأَنَّ قُرَادَيْ زَوْرِهِ طَبَعَتْهُمَا","بطينٍ منَ الجولانِ كتابُ أعجمِ"],["F611320E-DD25-514C-B83A-896F5D326FCD","كَأَنَّ زُرُوْرَ القُبْطُرِيَّةِ عُلِّقَتْ","بنادكها منهُ بجذعٍ مقومِ"],["250E2201-3220-5EE5-BA59-25FAD6257A68","يكافحُ لوحاتِ الهواجرِ بالضحى","مُكَافَحَةً لِلْمَنْخَرَيْنِ وَلِلْفَمِ"]]},"390677A1-03E4-5972-BCBE-31409DA348AA":{"t":"ما هاجَ شوقكَ من مغاني دمنةٍ","p":72,"s":"ما هاج شوقك من مغاني دمنة","r":"440032","v":[["FA0ED7EA-E69A-5568-B340-8DE1820DD5AC","ما هاجَ شوقكَ من مغاني دمنةٍ","ومنازلٍ شغفَ الفؤادَ بلاها"],["F516198A-4379-5190-A7B7-199CE71E8EDA","جيداءُ يطويها الضجيعُ بصلبها","طَيَّ المَحَالَةِ لَيِّن مَتْنَاهَا"],["030AE061-2443-52C5-A4EF-029F842D8CCB","دارٌ لِصَفْرَاءَ الَّتِي لاَ تَنْتَهِي","عَنْ ذِكْرِهَا أَبَداً وَلاَ تَنْسَاهَا"],["596A55EF-55BD-56B6-AAFB-0A446626BD75","لوْ يستطيعًُ ضجيعها لأحبها","فِيْ الجَوْفِ مِنْهُ يَشُمُّهَا وَحَشَاهَا"],["96DBFD64-757D-5E65-A40C-EE536998B081","صَاْدَتْكَ أُخْتُ بَنِي لُؤَيٍّ إذْ رَمَتْ","وَأَصَابَ سَهْمُكَ إذْ رَمَيْتَ سِوَاهَا"],["E542ECAC-C656-54BD-B235-2D638709519D","وأعارها الحدثانُ منكَ مودةً","وَأعِيْرَ غَيْرُكَ وُدَّهَا وَهَوَاهَا"],["F3A5B4BE-A70A-538D-B689-9A4E9E0CD305","تِلْكَ الظُّلاَمَةُ قَدْ عَلِمْتَ فَلَيْتَهَا","إذْ كُنْتَ مُكْتَهِلاً تَلُمُّ نَوَاهَا"],["21BD0531-37BA-58BB-9FBC-D6ABCA64D6F9","بَيْضَاءُ تَسْتَلِبُ الرِّجَالَ عُقُولَهُمْ","عَظُمَتْ رَوَادِفُهَا وَدَقَّ حَشَاهَا"],["77C062CC-1E26-52A1-9005-2B95428CBB72","وَكَأَنَّ طَعْمَ الزِّنْجَبِيْلِ وَلَذَّةً","صَهْبَاءَ سَاكَ بِهَا المُسَحِّرُ فَاهَا"],["DF3F3760-DFC7-5FAA-B1CE-9DCB24BDAF82","يَا شَوْقُ مَا بِكَ يَوْمَ بَانَ حُدُوْجُهُمْ","منْ ذيْ المويقعِ غدوةً فرآها"],["9366B0BE-4856-587B-92B8-0B04B8A87D72","وكأن نخلاً في مطيطةَ ثاوياً","بالكمعِ بينَ قرارها وحجاها"],["6DC94C56-CEFF-587C-8148-F1C17F8BBD04","وعلى الجمالِ إذا ونينَ لسائقٍ","أنزلنَ آخرَ رائحاً فحداها"],["CF7782C9-8519-596B-B5C0-DE63FF896425","منْ بينِ مختضعٍ وآخرَ مشيهُ","رفلٌ إذا رفعتْ عليهِ عصاها"],["F9F7D522-ACDA-55F2-8CC6-1985FD16D67C","من بين بكر كالمهاة وكاعب","شَفَعَ النَّعِيْمُ شَبَابَهَا فَعَرَاهَا"],["ACF9EE01-4D95-5DD6-82BC-03E1E04DD761","لاَ مُكْثِرٌ عَيْشٍ وَلاَ ابْنُ وَلِيْدَةٍ","بَادِي المُرُوْءَةِ تَسْتَبِيْحُ حِمَاهَا"],["01B862DC-58F1-505A-8438-36B537B8468C","وَجَعَلْنَ مَحْمَلَ ذِي السِّلاَحِ تَحِيَّةً","عن ذي اليتيمة وافترشن لواها"],["65F2A33D-524B-5759-8BCC-0766330E8EA4","أَصْعَدْنَ فِي وَادِي أُثَيْدَةَ بَعْدَمَا","عسف الخميلة واحزأل صواها"],["2EA4A6D8-0AC7-5C10-9914-34A0DBC9C87C","قرية حبك المقيظ وأهلها","بحشى مآب ترى قصور قراها"],["A15597AF-D2D2-5591-9A3B-F06A933B517B","واحتل أهلك ذا القتود وغربا","فالصحصحان فأين منك نواها"],["01B46ABF-99F5-5BF4-AC24-F8A713BAF784","فَإذَا تَحَيَّرَ فِي الفُؤَادِ خَيَالُهَا","شرق الشؤون بعبرة فبكاها"],["3C6706B5-AF9F-5AB3-A10C-E2796C617FEB","أفلا تناساها بذات براية","عنس تجل إذا السفار براها"],["63481ABC-9344-591B-A88F-68EBDD797E89","تطوي الفلاة إذا الإكام توقدت","طَيَّ الخَنِيْفِ بِوَشْكِ رَجْع خُطَاهَا"],["BCE30B9C-5984-56D6-84BA-6993E525EE2D","وَتَشُوْلُ خَشْيَةَ ذِي اليَمِيْنِ بِمُسْبَلٍ","وَحْفٍ إذَا صَحِبَ الذِّئَابِ حَمَاهَا"],["921E4108-33F8-5C8C-BE67-ACF628C33581","متذيل لون المناضل فوقه","عجب أصم يسل خور صلاها"],["3EEF11AC-243E-50F4-A53A-612308B3756F","نَخَسَتْ بِهِ عَجُزٌ كَأَنَّ مَجَالَها","دَرَجٌ سُلَيْمَانُ القَدِيْمُ بَنَاهَا"],["52CB4B92-91CB-584A-9543-18EE6708EB9F","بنيت على كرش كأن حرودها","مقط مطواة أمر قواها"],["8AFE0FA5-0C7F-5CE1-A550-4EB32B827836","في مجفر حابي الضلوع كأنه","بئر يجيب الناطقين رجاها"],["378DEB51-6986-5720-AD5D-B78DF4521D0D","ويقود ناهضها مجامع صلبها","قَوْداً وَتَبْتَدِرُ النِّجَاءَ يَدَاهَا"],["8942F975-99FE-5366-95EC-2A9B24C74B7F","وَتَسُوْقُ رِجْلاَهَا توالى خَلْفِهَا","طَرْداً وَتَلْتَطِسُ الحَصَى بِعُجَاهَا"],["158A37A7-941F-5020-B34F-DFB562DCEA45","فَغَدَتْ وَأَصْبَحَ فِي المُعَرَّسِ ثَاوِياً","كَالْخِرْقِ مُلْتَفِعاً عَلَيْهِ سَلاَهَا"],["C518E765-F815-50C4-8026-B8669ED1B7A3","وبها مناخ قلما نزلت به","وَمُصَمَّعَاتٌ مِنْ بَنَاتِ مِعَاهَا"],["FDCB6C9C-79D8-54FD-BF21-019FB90774DF","سود توائم من بقية حسوها","قذفت بهن الأرض غب سراها"],["CBAF382E-4BB9-5E5D-AA6C-3B0D05FEF7C9","وكأن مضطجع امرىء أغنى به","لِقَرَارِ عَيْنٍ بَعْدَ طُوْلِ كَرَاهَا"],["2352777F-DFDE-5E63-A36F-CC4E9AC7321C","حتى إذا انقشعت ضبابة نومه","عَنْهُ وَكَانَتْ حَاجَةً فَقَضَاهَا"],["9F79FCF1-B1BD-5EEB-83D1-9D26F0091900","أهوى فعصب رأسه بعمامة","دَسْمَاءَ لَمْ يَكُ حِيْنَ نَامَ طَوَاهَا"],["6609621C-AA03-5697-A2B8-28918DA9B912","ثُمَّ اتْلأَبَّ إلَى زِمَامِ مُنَاخَةٍ","كَبْدَاءَ شَدَّ بِنِسْعَتَيْهِ مَشَاهَا"],["91F8891A-8093-567F-A246-024BEB24DEB5","حَتَّى إذَا يَئِسَتْ وَأَسْحَقَ حَالِقٌ","ورأت بقية فشجاها"],["6DDBD745-B6FB-52C7-A596-A0F50B67AC4B","وغدت تنازعه الجديل كأنها","بَيْدَانَةٌ أَكَلَ السِّبَاعُ طَلاَهَا"],["DDE5F8B7-2197-5F95-AFE5-F33D0C22A325","قَلِقَتْ وَعَارَضَهَا حِصَانٌ حَائِصٌ","صَحِلُ الصَّهيْلِ وَأَدْبَرَتْ فَتَلاهَا"],["42AA357A-7853-5C4C-8DBD-7406457B7FC2","يتعاوران من الغبار ملاءة","بَيْضَاءَ مُخْمَلَةً هُمَا نَسَجَاهَا"],["34DF7819-3378-5195-8CEA-6D2B1CA4BD04","تطوى إذا علوا مكانا جاسيا","وَإذَا السَّنَابِكُ أَسْهَلَتْ نَشَرَاهَا"],["9BE414A9-E5FC-572C-BE9C-C4B732DE2DFD","فَأَلَحَّ وَاعْتَزَمَتْ عَلَيْهِ بِشَأوِهَا","شرفين ثمت ردها فثناها"],["DF64D17A-B155-534D-83B2-B0FB15BA8BE5","بسرارة حفش الربيع غثاءها","حَوَّاءُ يَزْدَرِعُ الغَمِيْرَ ثَرَاهَا"],["9736E911-192D-5933-AA1A-F895EEEE3BF1","فَتَصَيَّفَاهَا يَصْحَبَانِ كِلاَهُمَا","لِثَرَا الجَحَافِلِ مَنْ وَكَيْفَ؟ يَدَاهَا"],["7A2DF69F-D368-5ACF-8B17-EA6153750510","حَتَّى اصْطَلَى وَهَجَ المَقِيْظِ وَخَانَهُ","أبقى مشاربه وشاب عثاها"],["EC227680-D9FD-5E49-ABD6-1AA70DE8270A","وَنَوَى القِيَامَ عَلَى الصُّوَى فَتَذَكَّرَا","مَاءَ المَنَاظِرِ قُلْبَهَا فَأَضَاهَا"],["6B3E6603-6ACD-5DB4-B09C-A368079D9034","فأرن تارتها إذا عرضت له","بَيْدَاءُ ذَاتُ مَخَارِمٍ عَسَفَاهَا"],["966533D1-DB48-5EB1-A0AA-D38150F3488A","حَتَّى تَأَوَّبَ مَاءَ عَيْنٍ زَغْرَبٍ","يَبْغِي الضَّفَادِعَ فِي نَقِيْعِ صَرَاهَا"]]},"003195FD-E204-5F16-8057-7516239A26BE":{"t":"مَشَيْنَ كما اهْتَزَّتْ رِمَاحٌ تَسَفَّهَتْ","p":72,"s":"مشين كما اهتزت رماح تسفهت","r":"440076","v":[["A2A4E273-F7FA-50AF-AD6E-03454F772A8C","مَشَيْنَ كما اهْتَزَّتْ رِمَاحٌ تَسَفَّهَتْ","أَعَالِيْهَا مَرُّ الرَّيَاحِ النَّوَاسِمِ"]]},"7FF14115-B45E-5883-9E10-B0C832FB908B":{"t":"مُجْرَنْشِماً لَعَمَايَاتٍ تُضِيءُ بِهِ","p":72,"s":"مجرنشما لعمايات تضيء به","r":"440066","v":[["7BD5FED0-B396-5386-82A4-3A1C523E14FE","مُجْرَنْشِماً لَعَمَايَاتٍ تُضِيءُ بِهِ","منه الرضابُ ومنه المسبلُ الهطلُ"]]},"8200DCFD-67EF-5E06-AE9A-1120F9864B78":{"t":"نِعْمَ قُرْقُوْرُ المَرَوْرَاتِ إذَا","p":72,"s":"نعم قرقور المرورات إذا","r":"440039","v":[["30D5CE4C-ECA2-540B-A20C-2204840429D1","نِعْمَ قُرْقُوْرُ المَرَوْرَاتِ إذَا","غَرِقَ الحُزَّانُ في آلِ السَّرَابِ"],["16EF1BD1-1014-5621-83B2-F2A984C3920D","حملته بازل كودانة","فِي مِلاَطٍ وَوِعَاءٍ كَالْجِرَابِ"]]},"5576B581-0EFF-5B5A-A45B-5E8CE929E78A":{"t":"هلْ أنتَ منصرفٌ فتنظرُ ماترى","p":72,"s":"هل أنت منصرف فتنظر ماترى","r":"440065","v":[["5F336981-7C8F-52C7-B32A-600B73FC3417","هلْ أنتَ منصرفٌ فتنظرُ ماترى","أبقى الحوادثُ منْ رسومِ المنزلِ"],["F8EE3DF1-3A21-5CF8-A810-EE89720A34DC","فَرَمَى بِهِ أَدْبَارَهُنَّ غَلاَمُنَا","لمَّا اسْتَتَبَّ بِهَا وَلَمْ يَتَدَخَّلِ"],["D62B2BD2-DABF-500A-A0EB-A2610671010F","دارٌ بإحدى الرحلتينِ كأنما","قَدْ عُفِّيَتْ حِجَجاً ولَمَّا تُحْلَلِ"],["BB66D66C-0063-56BB-B7F1-BC8D1A5B5323","وَكَذَاكَ يَعْلُو الدَّهْرُ كُلَّ مَحَلَّةٍ","حتى تصيرَ كأنها لمْ تنزلِ"],["F43DC25E-2BE8-5737-802C-26C7A49EA387","لا يومَ إلاَّ سوفَ يورثهُ غدٌ","والعامُ تاركهُ لآخرَ مقبلِ"]]},"A0EA56E4-96F1-5B6B-920C-56D1485AE89C":{"t":"هَلْ عِنْدَ مَنْزِلَةٍ قَدْ أَقْفَرَتْ خَبَرُ","p":72,"s":"هل عند منزلة قد أقفرت خبر","r":"440050","v":[["E7603676-247F-58AF-963E-7F0FA3DF5B19","هَلْ عِنْدَ مَنْزِلَةٍ قَدْ أَقْفَرَتْ خَبَرُ","مجهولة غيرتها بعدك الغير؟"],["4F42B456-D8BC-51D7-BF82-42E40F99C157","بين الأقاعص والسكران قد درست","منها المعارف طراً ما بها أثر"],["8B68E936-4778-52CF-8E1C-E93B5DA431B0","شمس العداوة حتى يستقاد لهم","وأعظم الناس أحلاما إذا قدروا"]]},"DFCF3550-7D7F-56D6-B6BD-15988D1A6C8A":{"t":"هُنَّ عُجْمٌ وقد عَلِمْنَ مِنَ القَوْ م","p":72,"s":"هن عجم وقد علمن من القو م","r":"440072","v":[["D590D439-875F-52EF-929A-0741B427B180","هُنَّ عُجْمٌ، وقد عَلِمْنَ مِنَ القَوْ م","لِ هبي واقدمي وآوو وقومي"]]},"0D0859D8-A8B9-5B93-A42A-B7A8897B86F8":{"t":"والله يصرف أقواماً عن الرشد","p":72,"s":"والله يصرف أقواما عن الرشد","r":"440046","v":[["ACB05A0A-7426-5274-80D2-69868B51E3E4","..............","والله يصرف أقواماً عن الرشد"],["E78BFCC4-B49C-5A71-AA51-68F056FF05FF","فأنت والشعور ذو تزجي قوافيه","كَمُبْتَغِي الصَّيْدِ فِي عِرِّيْسَةِ الأَسَدِ"]]},"27538A15-2F25-5C4E-B210-27B4A2C7B7AD":{"t":"وعون يباكرن البطيمة موقعا","p":72,"s":"وعون يباكرن البطيمة موقعا","r":"440058","v":[["7613F407-8E26-51A8-9E22-EA3969BC2B7F","وعون يباكرن البطيمة موقعا","حَزَأْنَ فما يَشْرَبْنَ إلاّ النَّقَائِعَا"],["075FCFCC-9333-5E44-89B0-6B8583D6A7F4","تضيفنه حتى جهدن يبيسه","وآضَ الفرات قَانِطاً ليس جَامِعَا"],["A22A7311-2EA1-56DF-B353-82C0CB7AF296","وَيَأْكُلْنَ مَا أَعْنَى الوَلِيُّ فَلَمْ يُلِتْ","كأن بحافات النهاء المزارعا"]]},"F7A8A829-10D0-5CA6-B33C-A1530F1CA04A":{"t":"وكانَ أمركَ منْ أهلِ الطوانةِ منْ","p":72,"s":"وكان أمرك من أهل الطوانة من","r":"440081","v":[["8A2C5A03-FAE8-53E4-8CDC-EF6A317BCF9D","وكانَ أمركَ منْ أهلِ الطوانةِ منْ","نَصْرِ الَّذِي فَوْقَنَا واللَّهُ أَعْطَانَا"],["CB2C80B6-56D4-5262-83A8-FF7FEB1863ED","أَمْراً شَدَدْتَ بِإذْنِ اللَّهِ عُقْدَتَهُ","فَزَادَ في دَيْنِنَا خَيْراً وَدُنْيَانَا"]]},"12890C12-CF8C-5C24-9D95-D84FE2287AA2":{"t":"ولله عينا من رأى كحمالة","p":72,"s":"ولله عينا من رأى كحمالة","r":"440047","v":[["55AD7953-60D5-554E-87E3-8C1A1E33F5B4","ولله عينا من رأى كحمالة","يُحْمِّلُهَا كَبْشُ العِرَاقِ يَزِيْدُ"]]},"B95DC0ED-5E26-5528-BF30-362F4954D902":{"t":"ومما شجاني أنني كنتُ نائماً","p":72,"s":"ومما شجاني أنني كنت نائما","r":"440074","v":[["EE891E43-646C-553A-AADD-CDB6C44584A1","ومما شجاني أنني كنتُ نائماً","أعللُ من بردِ الكرى بالتنسمِ"],["5F806A7B-8AEE-5EDE-BF10-92D57CF9828A","إلَى أَنْ بَكَتُ وَرْقَاءُ في غُصْنِ أَيْكَةٍ","تُرَدِّدُ مَبْكَاهَا بِحُسْنِ التَّرَنُّمِ"],["E103CEDA-9D6A-58B1-91C6-CFBB8F8FA1BE","فَلَوْ قَبْلَ مَبْكَاهَا بَكَيْتُ صَبَابَةً","سُعْدَى شَفَيْتُ النَّفْسَ قَبْلَ التَّنَدُّمِ"],["A90D3946-F4CB-5793-9B96-93F78D566077","ولكِنْ بَكَتْ قَبْلِي فَهَاج لِيَ البُكَا","بكاها فقلتُ الفضلُ للمتقدمِ"]]},"D7490A38-872E-50EE-8DDF-939FCA24DF15":{"t":"وَتَرَى لَغَرِّ نَسَاهُ غَيْباً غَامِضاً","p":72,"s":"وترى لغر نساه غيبا غامضا","r":"440085","v":[["037D2D59-8C70-58B9-B14C-AFD85A3584E1","وَتَرَى لَغَرِّ نَسَاهُ غَيْباً غَامِضاً","قلقَ الخصيلةِ من فويقِ المفصلِ"]]},"8A7135EF-96A1-5545-9459-0EA12474B9EC":{"t":"وَجَعَلْنَ مِحْمَلَ ذِي السِّلاَ م","p":72,"s":"وجعلن محمل ذي السلا م","r":"440083","v":[["E4DE4FD1-45FC-509A-80FA-17188B0DB590","وَجَعَلْنَ مِحْمَلَ ذِي السِّلاَ م","حِ مجنهُ رعنَ اليتيمهْ"]]},"C6A96BF5-5376-5CC0-9F37-CEBDF3E5700A":{"t":"وَلَقَدْ يَخْفِضُ الْمُحَاوِرُ فِيْهِمْ","p":72,"s":"ولقد يخفض المحاور فيهم","r":"440070","v":[["276725D5-F695-536E-836F-BA85EC077528","وَلَقَدْ يَخْفِضُ الْمُحَاوِرُ فِيْهِمْ","غيرَ مستشرفٍ ولاَ مظلومِ"]]},"76BF2896-F296-5741-971E-F7D510EBE0B1":{"t":"وُلِدَتُ تُرَابِيْهِ رَأْسُهَا","p":72,"s":"ولدت ترابيه رأسها","r":"440063","v":[["543772E5-7441-5838-B514-64AE9E4C85B9","وُلِدَتُ تُرَابِيْهِ رَأْسُهَا","عَلَى كُلِّ رَابِيَةٍ نَيِّفُ"],["8CA885FD-F93B-517D-9712-8E57097D6856","وما لاْ مرىءٍ أربٍ بالحيا","ةِ عنها محيصٌ ولاَ مصرفُ"]]},"991454FC-29F5-5793-B58D-B41B1A5FF046":{"t":"يا منْ رأى برقاً أرقتُ لضوئهِ","p":72,"s":"يا من رأى برقا أرقت لضوئه","r":"440084","v":[["218369C3-56BA-5EFC-B468-869136E4B0B7","يا منْ رأى برقاً أرقتُ لضوئهِ","أَمْسَى تَلأْلأَ في حَوَارِكِهِ الْعُلَى"],["E9BCE5EE-9209-5E56-8E27-2D1FFE61ED9E","لما تلحلحَ بالبياضِ عماؤهُ","حولَ الغريفةِ كاد يثوي أو ثوى"],["E2933E0C-5981-51E6-9211-4A76BB85C12B","فأَصَابَ أَيْمَنُهُ المَزَاهِرَ كُلَّها","واقْتَمَّ أَيْسَرُهُ أُثَيْدَةَ فَالْحَثَا"],["E5116E1D-9F6E-53A1-B861-A65E42BE1E1B","فعظامُ البرقاتُ جادَ عليهما","وأَبَثَّ أبْطُنَهُ الثُّبُورُ بِهِ النَّوَى"]]},"910EE282-17B1-5485-93E4-D0258174766F":{"t":"يتبعنَ ناجيةً كأنَّ بدفها","p":72,"s":"يتبعن ناجية كأن بدفها","r":"440073","v":[["B510A2BC-9DD0-56B5-B423-EFC3FCFF3686","يتبعنَ ناجيةً كأنَّ بدفها","منْ غرضِ نسعتها علوبَ قواسمِ"]]},"8CEB4ACE-5614-5E01-9690-EE8AABF66C66":{"t":"يخرجنَ من فرجاتِ النقعِ داميةً","p":72,"s":"يخرجن من فرجات النقع دامية","r":"440075","v":[["C3FEB3AE-AA8D-5C18-B533-10F391B4A812","يخرجنَ من فرجاتِ النقعِ داميةً","كأنَّ آذانها أطرافُ أقلامِ"]]}}}