{"v":1,"poems":{"84F97C31-14B3-5DF4-8A78-BBBAFDDA0F5D":{"t":"يا حاديَ الظُّعنِ إن جُزتَ المَواقيتا","p":201,"s":"يا حادي الظعن إن جزت المواقيتا","r":"465437","v":[["C3E4ACBC-B852-54F8-86D7-955C475821CD","يا حاديَ الظُّعنِ إن جُزتَ المَواقيتا","فحيِّ من بمنىً والخَيْفِ حُيِّيتا"],["9DAC0F21-9E33-5EBA-8FEE-43D641747465","وسلْ بجمعٍ أجمعُ الشَّمل مؤتَلِفٌ","أم غالَه الدَّهرُ تفريقاً وتَشْتيتاً"],["509EE8E5-40F0-5038-8C5A-B15309A9F2C6","والثمْ ثَرى ذلكَ الوادي وحطَّ به","عن الرِّحال تَنلْ يا سعدُ ماشِيتا"],["AF0C83A3-EB3D-5AC9-8D77-7FE0665A14E0","عهدي به وثراهُ بالشذا عبقٌ","كالمسك فتَّتهُ الداريُّ تفتيتا"],["11B86A2D-635E-50BB-BF39-2B1D5234FE00","والدرُّ ما زالَ من حَصْبائه خجِلاً","كأنَّ حصباءَه كانت يَواقِيتا"],["7CB2B5AC-4D10-5961-BA4E-9DBE816A37A4","يؤمُّه الوفدُ من عربٍ ومن عَجمٍ","ويسبرونَ له البِيدَ السَّباريتا"],["E84CCF4E-871F-5E44-AF96-696C28E6884D","يَطوُونَ عَرضَ الفَيافي طولَ ليلهُمُ","لا يهتدون بغيرِ النَّجم خِرِّيتا"],["22A62221-0E73-5F2F-8968-891764E3581B","من كلِّ منخرق السِّربال تحسبه","إذا تسربلَ بالظَّلماءِ عِفرِيتا"],["236685E9-7B60-504F-A095-764BAEC347B3","لا يطعم الماء إلاَّ بلَّ غلَّته","ولا يذوقُ سوى سَدِّ الطَّوى قُوتا"],["8DFD99DE-5704-5F0A-978B-0322A758A954","يفري جيوب الفلا في كلِّ هاجرةٍ","يُماثِل الضَبُّ في رَمضائِها الحُوتا"],["D06F411C-D343-5254-8C9A-B68C9A7563A2","تَرى الحَصى جَمراتٍ من تَلهُّبِها","كأنَّما أوقدتْ في القفر كِبريتا"],["C3D71017-2A0F-54A4-93CA-9AA12038540E","أجابَ دعوة داعٍ لا مردَّ لها","قضى على النَّاس حجَّ البيت توقيتا"],["52149024-2061-5B01-8B0A-1CC1D46E60DA","يرجو النَّجاة بيومٍ قد أهاب به","في مَوقفٍ يدَعُ المنطيقَ سِكِّيتا"],["45C21EE7-9D5E-5166-8D91-0B853C73EB65","فسار والعزم يطويه وينشره","ينازلُ البينَ تصبيحاً وتَبْيِيتا"],["A83C6AE4-5C15-58C6-BDCC-BE0337226961","حتى أناخَ على أمِّ القرى سحراً","وقد نَضا الصُّبحُ للظَّلماءِ إصْلِيتا"],["CAE4DCB7-60EC-5E21-B845-78F3D2FDA186","فقامَ يقرعُ بابَ العَفوِ مُبْتَهلاً","لم يَخشَ غَيرَ عِتابِ الله تبكِيتا"],["1EE421DB-E40E-5563-91E4-9D0C82CE9581","وطافَ بالبيتِ سَبْعاً وانثنى عجِلاً","إلى الصَّفا حاذِراً لِلوَقْت تَفْوِيتا"],["1A642A9C-5E81-52B1-ACEB-B437EF0B93C9","وراحَ مُلتمساً نيلَ المُنى بِمِنىً","ولم يَخَفْ حينَ حلَّ الخَيفَ تَعنيتا"],["38209857-0F0C-53AD-BED4-C924962A07C3","وقامَ في عرفاتٍ عارفاً ودعا","ربّاً عوارفُهُ عمَّته تربيتا"],["E9AFF2DA-C708-5342-8ACC-3134174C3BB7","وعادَ منها مُفِيضاً وهو مُزْدلِفٌ","يَرجو من اللهِ تمكيناً وتثبيتا"],["D956ACD4-8CC5-5D98-9C9A-E39F7E532D68","وباتَ للجَمَراتِ الرُّقْش مُلتَقِطاً","كأنَّه لاقِطٌ دُرّاً وياقُوتا"],["BDA88515-ACE1-5524-A0F6-6D0C2C87CE15","وحين أصبح يومَ النَّحرِ قام ضُحىً","يُوفي مناسِكَه رَمياً وتَسْبِيتا"],["CDA987A1-B854-50AF-981D-0B0FA15FF216","وقرَّب الهَديَ تَهدِيهِ شَرائعُهُ","إلى الهُدى ذاكراً للَّهِ تَسْمِيتا"],["AA662F4D-500A-543F-A2E3-179FEA749145","وملأتْهُ ليالي الخَيْفِ بَهجتَها","فحجَّ للدِّين والدُنيا مُواقيتا"],["C1676D6C-72D5-5F5E-89E3-358F5F1B3C04","حتى إذا كان يومُ النَّفْر نفَّرَهُ","وجدٌ ينكِّثُ في الأحشاء تنكيتا"],["1A64DB81-71C2-5C12-A2B0-F688693696C1","ثمَّ اغتَدى قاضِياً من حجِّه تَفَثاً","يرجو لتزكيةَ الأعمال تزكيتا"],["53C1948B-3779-5C83-8091-87C7DAE8F4D4","وودَّع البيتَ يرجو العودَ ثانيةً","وليتَه عنه طولَ الدَّهرِ مالِيتا"],["11BE15C7-6BC0-5A0C-87AD-9ECF65C81FD5","وأمَّ طيبةَ مثوى الطَّيِّبين وقد","ثنى له الشوقُ نحو المصطفى لِيتا"],["948274D1-E158-5624-A819-C5BDAA405CF2","فواصلَ السيرَ لا يَلوي على سَكَنٍ","أزاد حبّاً له أم زاد تمقيتا"],["B2B3C5A4-F211-58BF-8205-5E4D50E04BC4","حتى رأى القبَّة الخضراءَ حاكيةً","قَصراً من الفَلَك العُلويِّ مَنْحوتا"],["8DE5DDD2-CCC2-5F34-BA36-F7E740BEE1C8","فقبَّل الأرضَ من أعتابِ ساحتِها","وعفَّر الخدَّ تَعظيماً وتَشْمِيتا"],["373DC0B1-DC38-549E-A99D-1EEB87279CCB","حيث النبوَّةُ ممدودٌ سُرادِقُها","والمجدُ أنبتَه الرحمنُ تَنْبيتا"],["75B08818-B3E6-5671-B58E-3FA1BE4AC353","مقامُ قدسٍ يحار الواصفون له","ويرجِعُ العقلُ عن عَلْياه مَبْهوتا"],["326C2B99-3F17-5313-88E5-CCBD6D44227E","لو فاخَرَتْه الطِّباقُ السبعُ لانتكسَتْ","وعادَ كوكبُها الدُّريُّ مَكبُوتا"],["7604431C-8A5E-51D5-8C61-DCC7B62D1911","تَستَوقفُ السَّمعَ والأبصارَ بهجَتُه","ويجمعُ الفضلَ مَشْهوداً ومَنْعوتا"],["12A40F83-FCD8-5E46-B7B8-9800B882ABFB","يقولُ زائرُه هاتِ الحديثَ لنا","عن زوره لا عن الزَّوراء أوهيتا"],["F8DB8270-F3CA-5EC9-AA7D-6F77CCAD816F","وصف لنا نوره لا نار عاديةٍ","باتت تشبُّ على أيدي مصاليتا"],["D73E32B4-7915-5F20-8EB3-CD04460E1873","مثوى أجلِّ الورى قدراً وأرحبهم","صدراً وأرفعهم يومَ الثَّنا صِيتا"],["BC2838CC-5A8A-5881-AB6E-CCEB11CE267C","نبيُّ صدقٍ هدت أنوار غرَّته","بعد العمى للهدى من كان عمِّيتا"],["D508634C-343B-57EC-9A24-151C9F6BAB70","وأصبحتْ سُبُلُ الدين الحنيفِ به","عَوامراً بعدَ أن كانت أمارِيتا"],["3216873E-A9B0-57C9-B621-A2175CB6C7BD","أحيا به اللهُّ قوماً قام سعدهم","كما أمات به قوماً طواغيتا"],["7E6487B2-C242-5ADA-93E2-17D0998B22D9","لولاه ما خاطب الرحمان من بشرٍ","ولا أبان لهم ديناً ولا هوتا"],["FCC8031F-1CD8-52D8-B92F-44A3D8F597BB","له يدٌ لا نُرجِّي غيرَ نائِلهَا","وقاصد البحر لا يرجو الهراميتا"],["17B99DEC-2F54-5AD9-927C-9483591EB431","فلو حوت ما حوته السُّحب من كرمٍ","لما سمعت بها للرعد تصويتا"],["21F0E5B4-1104-50DF-BCBB-A28FE4E5E6E6","فقل لمن صدَّه عنه غوايته","لو اهتديت إلى سبل الهدى جيتا"],["FBDFE602-E6F0-5625-B54B-272E804B3E03","ما رام حصر معانيه أخو لسنٍ","إلاَّ وأصبح بادي العيِّ صِمِّيتا"],["C0E4FE89-1E02-521B-9F6D-B9EBC5F1EB40","يا أشرفَ الرُّسْلِ والأملاكِ قاطبةً","ومن به شرَّف الُّله النَّواسيتا"],["DE893D0E-A1DC-590E-90FF-CF6BC630D1B4","سمعاً لدعوة ناءٍ عنك مكتئبٍ","فكم أغثت كئيباً حين نوديتا"],["4D7A3A3E-3141-5B79-BEFF-A6E13D9D1641","يرجوك في الدِّين والدُّنيا لمقصده","حاشا لراجيك من يأسٍ وحوشيتا"],["57E18EDE-5BD6-5F17-ACC2-1E9A0A865EE9","أضحى أسيراً بأرض الهند مغترباً","لم يرجُ مخلصَه إلاَّ إذا شيتا"],["9C7BA773-F6CE-5DEF-8162-61F7651334D3","فنجِّني يا فدتك النفس من بلدٍ","أضحت لقاح العلى فيه مقاليتا"],["407F1075-0BFC-505C-BA66-53646528BB9D","وقد خدمتك من شعري بقافيةٍ","نَبَّتُّ فيها بديعَ القول تَنْبِيتا"],["1EA9C861-A81D-5ED8-AE7E-875CBDF750D0","وزانها الفكر من سحر البيان بما","أعيا ببابل هاروتاً وماروتا"],["5C9BE367-863E-5D14-AAA0-1220C9E2A2B1","جلَّت بمدحِكَ عن مِثْلٍ يُقاسُ بها","ومن يقيسُ بنَشْر المسْكِ حِلْتِيتا"],["191C9AD5-E94A-5BD4-B990-D7B31D83A6CD","عليكَ مِن صلوات الله أشْرفُها","وآلك الغرِّ ما حيُّوا وحييِّتا"]]},"9488CCD8-80FB-5AD2-9355-674F5C58A5CE":{"t":"يا حبذا الفيل الذي شاهدته","p":201,"s":"يا حبذا الفيل الذي شاهدته","r":"465909","v":[["E74F92BD-6968-5BF4-A640-0EBBA0DB9B29","يا حبذا الفيل الذي شاهدته","وشهدتُ منه ما نَمى لي ذِكرُهُ"],["1138873C-11AF-550F-AEBC-3E5A04B7F3BB","فكأنه وكأن أبيض نابه","ليلٌ تبلَّج للنَّواظِر فَجرُهُ"]]},"46B556AC-C80F-5F12-940D-D1A3764220A8":{"t":"يا حسنها جاريةً أقبلت","p":201,"s":"يا حسنها جارية أقبلت","r":"465917","v":[["90F7EB60-8DCC-5362-AC82-A026D43019E2","يا حسنها جاريةً أقبلت","في اللَّيل والليلُ بها كالنَّهارْ"],["37E1B812-8DEE-5073-803B-6F17935533CF","لما رأتني خفضَتْ طَرْفَهَا","فقلت ما أحسن خفض الجوار"]]},"8110E1E1-36E3-5EC2-8FD6-D10C4524231A":{"t":"يا حمام الحبش","p":201,"s":"يا حمام الحبش","r":"465867","v":[["08BA8710-B954-5801-AD66-816146F56795","يا حمام الحبش","ويا قماري الغواني"],["E1DA9941-98ED-5845-91AF-C3858713A0E8","يا نجوم الغبش","ويا بدورَ المغاني"],["7A6814C1-D817-5035-94E1-58A11D8AF5E3","الحلا والورش","فيكم وكلُّ المعاني"]]},"5887591E-148E-53C1-9AB3-9BA28DB823E5":{"t":"يا دارَ ميَّة بالجرعاءِ حيَّاك","p":201,"s":"يا دار مية بالجرعاء حياك","r":"465659","v":[["0CDB7D7A-D418-5BD1-8611-BEAADE414DEC","يا دارَ ميَّة بالجرعاءِ حيَّاك","صوب الحيا الرائح الغادي وأحياك"],["4FB3F985-1031-5FA5-9278-A8D2B8E89286","ولا أغبك من دمعي سواجمه","إن كان يُرضيكِ ريَّا مدمعي الباكي"],["0E2A0D1E-5025-511E-B44A-891379194D2F","سَقياً ورَعياً لأيَّامٍ قضيتُ بها","عيش الشبيبة في أكناف مرعاك"],["6FF3D8AF-0A07-5D30-B736-06AC4DB5E402","ما هينَمَتْ نسماتُ الرَّوض خافقةً","إلا تنسمت منها طيب رياك"],["B0FA74EF-98EA-512D-9C63-D086ED16C561","ولا تغنى حمام الأيك في فننٍ","إلاَّ تذكرتُ أيَّامي بمغناكِ"],["5EA53E37-675C-5CE1-B41F-63ECA7D3592F","أصبو إلى الرمل من جرعاء ذي إضمٍ","وما لقلبي وللجرعاءِ لولاكِ"],["EA729031-8A9A-592C-99FD-B9923A1E92B1","يخونُني جَلَدي ما حنَّ مكتئِبٌ","وينفذُ الصبرُ مهما عنَّ ذكراكِ"],["EE30F9F6-A1D1-5448-94D7-B7F7A73CB599","لله طيبُ ليالٍ فيكِ مشرقةٍ","مرت فما كان أحلاها وأحلاك"],["53CFB7F6-21F9-5FAC-BDF7-CA1D6A144547","إذ النَّوى لم تُرْع شملي ولا عرِيَتْ","من اصطياد الظباء الغيد أشراكي"],["86C6B0E4-67D2-506B-89C8-0EAAE9CD2632","ياظبيةً بالكثيب الفرد راتعةً","أوحشتِ عيني وفي الأحشاءِ مثواكِ"],["101270B9-D596-5689-9408-780FCB687C73","رميتِ قلبي بسهمٍ من رَناكِ وقد","سكنت فيه فما أبعدت مرماك"],["490A19A3-EA2C-5A50-808D-5CC08BF6FD14","الغصنُ يُعرب عن عِطفيك مائسُهُ","وطلعة البدر تنبي عن محياك"],["CCC2A9DC-07C4-5F08-9606-ECC65B3F4A63","وكاد يَحكيكِ ضوءُ الصُّبح مبتسِماً","لكن ثناه وميضٌ من ثناياك"],["EC4E8193-D44B-578B-8B8C-A17E9482C149","وقيل شمسُ الضُّحى تَحكيكِ مشرقةً","وما حكتكِ ولكن أوهِمَ الحاكي"]]},"CCDB07C7-C9E1-52AC-A73A-EBE026A57B4F":{"t":"يا دارَميَّة باللِّوى فالأجرعِ","p":201,"s":"يا دارمية باللوى فالأجرع","r":"465611","v":[["971FAFAF-4921-5710-B7F7-0FAF6541444B","يا دارَميَّة باللِّوى فالأجرعِ","حياك منهل الحيا من أدمعي"],["6A6E06DC-5595-5569-9309-6D95FAC97D0C","وسرى نسيم الروض يسحب ذيله","بمصيف أنسٍ في حماك ومربع"],["66E8F7FF-D85C-5FCB-90B4-E7C36A7091A7","لو لم تبيتي من أنيسكِ بلقعاً","ما بت أندب كل دارٍ بلقع"],["F4F85BC2-9480-567D-AA43-A566ED2A3C21","لم أنس عهدك والأحبة جيرةٌ","والعيشُ صفوٌ في ثراكِ المُمْرعِ"],["712AC9B9-45C1-538E-B9CD-C80EE89EEBAF","أيام لا أصغي للومة لائمٍ","سَمعاً وإن ثُغِر الصَّبابةُ أسمعِ"],["89BE8EE1-2DF2-55B4-B5F4-5441562B6CB1","حيث الربى تسري برياها الصبا","والروض زاهي النور عذب المشرع"],["8AB9257C-2EB9-5B7E-BA67-914360CC0434","تحنو علي عواطفاً أفنانه","عندَ المبيت به حنَّو المُرضِعِ"],["6BDFFB70-3E51-5A12-B579-B17B412D21B0","والورق في عذب الغصون سواجعٌ","تشد وبمرأىً من سعاد ومسمع"],["6B5FEE38-753B-57A3-9BB3-5B29B0633827","كم بت فيه صريع كأس مدامةٍ","حلف البطالة لا أفيق ولا أعي"],["25551014-35F0-5F96-8D99-F46C0F071F5F","أصبو بقلبٍ لا يزال موزعاً","في الحبِّ بين معمَّمٍ ومقنَّعِ"],["7AFDB94E-858F-5437-9CD7-7B2E1CE7D1C8","مستهتراً طوَع الصَّبابة في هَوى","قمرَيْ جمالٍ مُسفِرٍ ومُبرقَعِ"],["84570248-FE70-5143-87B5-0A440ECF4C0C","ما ساءني أن كنت أول مغرمٍ","بجمال ربِّ رداً ورَبَّة بُرقعِ"],["928890F5-EA29-5E65-AB7D-6BCF4B4258B3","يقتادني زهر الشباب وعفتي","فيه عَفافَ الناسكِ المتورَّعِ"],["A1B50E4F-8DE9-5A5C-A6A4-217FED61C5F5","لله أيامي بمنعرج اللوى","حيث الهَوى طَوعي ومن أهوى مَعي"],["7E9C5004-1E63-5E4E-A1A4-7EB9F9AADAD6","لم أنسه والبين ينعق بيننا","متصاعدَ الزفرات وهو مُودِّعي"],["98AC7526-B96F-5D61-BA1A-1AD2E6840B12","إن شبَّ في قلبي الغَضا بفراقِه","فلقد ثوى بالمنحنى من أضلعي"],["EA8D67AA-47DE-5675-9464-4BA9A754B9E3","أتجشم السلوان عنه تكلفاً","والطبعُ يغلبُ شيمةَ المتطبِّعِ"]]},"92D6C014-421B-5949-BA73-5AB90DFB0475":{"t":"يا راحلينَ وهم في القَلب سكَّانُ","p":201,"s":"يا راحلين وهم في القلب سكان","r":"465772","v":[["A77DEBD6-220D-5905-A2B6-6946A7A14103","يا راحلينَ وهم في القَلب سكَّانُ","هل غير قلبي لكم مأوى وأوطان"],["068272F8-CE26-5B3E-8092-0207864DE6F7","خذوا من الأرض أنى شئتم نزلاً","فأنتم في سويدا القلب قطان"],["50DFC61E-0A72-5776-AEE3-092C5C4CBF52","وأنت يا حادي الظعن التي ظعنت","فيها العشية أقمارٌ وأغصان"],["4B81369E-7FA2-550E-9040-428EBF292842","بالله إن لم يكن بدٌ لمن ظعنوا","من منزل بالحمى تأويه أظعان"],["A871AE36-A61E-57E9-9353-BE4AB7AA76AC","فعُجْ بشرقيِّ وادي الرَّمل من اضم","حيث الغضا والأضى والرند والبان"],["E2735DD6-06D1-596C-8556-E0D80D9A7781","لعلهم أن يحلوا منه منزلةً","كانوا يحلونها والدهر جذلان"],["C7C469B0-EA66-5989-A599-EE5414054190","أيَّامَ أختالُ في بُرد الصِّبا مَرَحاً","والعمرُ غضٌّ وصفو العيش فَيْنانُ"],["395FBFC2-0BAC-5D54-AF61-21430799D841","لا أوحش الله من ناءٍ تؤرقني","ذكراه وهو خليُّ البال وَسْنانُ"],["26476344-ADA8-52B3-A60F-1D5CB13DD251","أذوى وريق شبابي بعده ظمأٌ","وغصنه من مياه الحسن ريان"],["B57BF7FC-EC18-5D59-B743-F8C12BA297E2","حيَّا به الله يوماً روحَ عاشقه","فإنَّما هو للأرواح رَيحانُ"],["7BCA7F31-D398-5FBB-9A97-CB527083994A","قد جل في حسنه عن أن يقاس به","ظبيٌ وبدرٌ وأغصانٌ وكثبانٌ"],["900AB244-A9B8-5136-917F-EE56F52CD1DB","لله كم فيه من حُسنٍ يُدِلُّ به","لو كان يشفع ذاك الحسن إحسان"],["8D1BCF0B-B902-591F-B81D-2F105C347A0F","يا عاذلي في هواه لا ترم شططاً","دعني فعذلك شانٌ والهوى شان"],["873B0E30-47DC-5481-9764-4227081C0EC6","والله ما جادل العذال عاشقه","إلاَّ وقام له بالحسنِ بُرهانُ"],["430B3E54-44F8-52F0-A952-F7C40A5177E9","وأين من سمعيَ اللاَّحي وزُخرفُهُ","ولي من الحبِّ سلطانٌ وشيطانُ"],["ED33B488-B80E-55D1-A7FB-853DDC6A31F6","وليلةً بات بدري وهو معتنقي","فيها سروراً وبدرُ الأُفق غَيرانُ"],["99629AB7-9364-589B-8ADC-E2176EDD4DEB","فظل ينقع من قلبي غليل جوىً","إذ كانَ من قبل إعراضٌ وهجرانُ"],["517AA9E0-B696-5BE2-A63B-3766202B66FF","حتى بدا الفجر فارتاعت كواكبها","كأنها نقدٌ والفجر سرحان"],["AC9E1827-9411-5906-9E40-C0139EC0AAA0","فقام يَثني قواماً زانَه هَيَفٌ","كأنَّه بمُدام الوصل نَشوانُ"],["72BBF03B-8497-5012-B049-77D18312E96C","وراح والدمع من أجفانه دررٌ","ورحت والدمع من جفني عقيان"],["5FC31B6B-E4E9-50C8-9266-6BF6EFE0CAC7","لله أزمانُ وصلٍ قد مضَت وقضت","أن لا تعود بها ما عشت أزمان"],["4E24AEE9-94FE-51DC-86C3-9EE879437D44","مرت فلم يبق لي إلا تذكرها","وذكر ما قد مضى للوجد عنوان"],["9D993C76-5B02-5B3D-8F61-2A226FC8738C","فيا زمانَ اللِّوى حيِّيتَ من زمنٍ","ولا أغب اللوى والسفح هتان"]]},"10E4A2A7-7753-56A6-B473-B88A18004068":{"t":"يا ربيب الندى وترب المعالي","p":201,"s":"يا ربيب الندى وترب المعالي","r":"465950","v":[["81DC8C57-32D7-5B11-9C0C-D8970AAEA955","يا ربيب الندى وترب المعالي","وأديباً فاق الورى بالمقال"],["C995CB76-49D6-588C-8302-2BDD083F90F9","إستمع لي - لا زلت - وأصغ لقولي","وأجبني بما يخف ثقالي"],["31FC28D3-7095-53C1-8C71-C046C2A71DB3","فأنا اليومَ منذُ عامين صَبٌّ","بغزالٍ يفوقُ كلَّ غزالِ"],["2FB88A78-414C-59F9-AF43-08B193B61412","رق لي من جفاه كل عذولٍ","ورثى لي من صده كل قال"],["A94C8924-69C3-5980-8D28-B6D36E132E4E","كلَّما رمتُ رشفَةً من لماه","صد عني وسامني بالمحال"],["31BFD6A0-1B81-5449-89FE-BCD2B7ADADAE","وأنا والذي أعلَّ فؤادي","بهواه لست الغداة بسالي"],["75F21C1F-D23B-55D6-B0F1-49AF92C304B9","كيفَ والوجدُ قد أباحَ اصْطباري","ودموعي لما تزل في انهمال"],["289D57EB-9FC4-5174-93E6-C0C9C77C6483","فافْتِني ـ لا برحت ـ فَتوى أريب","فعساه يُصغي ويَرثي لحالي"],["3452CEE1-F6B1-5E7B-AEDC-167432EB89C3","وابق واسلم في عزةٍ وعلاءٍ","يا ربيب الندى وترب المعالي"]]},"15A2D7CB-785B-56B5-B96E-854AF821144F":{"t":"يا ربِّ كم لكَ من يَدٍ عظُمَتْ","p":201,"s":"يا رب كم لك من يد عظمت","r":"465459","v":[["F882F70B-97E6-509C-BA45-5F27496DD091","يا ربِّ كم لكَ من يَدٍ عظُمَتْ","عندي فنلت بها المنى سرحا"],["90EB949A-0817-5FE8-BC1E-07C495603B3F","وأجلهن يدٌ كتبت بها","لزبور آل محمدٍ شرحا"]]},"9EB1CC21-DB0E-5F97-8384-83CC48399744":{"t":"يا صاح هذا المشهد الأقدس","p":201,"s":"يا صاح هذا المشهد الأقدس","r":"465576","v":[["FE823189-3C60-5AFD-A034-9613FD355D0D","يا صاح هذا المشهد الأقدس","قَرَّت به الأعينُ والأنْفُسُ"],["E4760556-158C-5305-970B-9ECD477C9463","والنجف الأشرف بانت لنا","أعلامه والمعهد الأنفس"],["3DEAF60A-5794-5A40-B1AB-DE2C2C941E78","والقبة البيضاء قد أشرقت","ينجاب عن لألائها الحندس"],["93085074-D2A9-5279-AF4F-BFBC38ECFEAD","حضرةُ قُدسٍ لم ينلْ فضلَها","لا المسجد الأقصى ولا المقدس"],["83F7773E-AE3E-5A62-BAF5-D993501D0C6D","جلَّت بمن حلَّ بها رتبةً","يقصرُ عنها الفَلَكُ الأطلسُ"],["B5EDFF9A-63E1-515D-AC69-7A85F4F0867B","تود لو كانت حصى أرضها","شب الدجى والكنس الخنس"],["1E42B894-DA37-5755-9103-C728D79EBE94","وتحسدُ الأقدامَ منَّا على","السعي إلى أعتابها الأرؤس"],["A3DACD97-1E11-56B5-AB04-1BAFF320A89A","فقف بها والثم ثرى تربها","فهي المقامُ الأطهرُ الأقدسُ"],["13173C09-C44A-5F10-B7CC-16C73D6F0712","وقل صلاةٌ وسلامٌ على","من طاب منه الأصل والمغرس"],["08E6D77C-933F-51AF-8EAC-7E501F509FC7","خليفةُ الله العظيم الذي","من ضوئه نور الهدى يقبس"],["D36DA395-D292-5B61-8C17-C0BFD00DF66D","نفس النبي المصطفى أحمدٍ","وصنوُه والسيِّدُ الأرأسُ"],["934E3B59-6493-52D8-A93F-8196A1B436FD","العلم العيلم بحر الندى","وبره والعالم النقرس"],["6FAD06DA-F9CB-5686-B507-12F8B47A92C7","فليلنا من نوره مقمرٌ","ويومُنا من ضَوئه مُشمِسُ"],["1BC30199-E71E-52BC-9F33-8BBD7E6FD984","أقسم بالله وآياته","أليَّةً تنجي ولا تُغمِسُ"],["DC837F07-D54D-5283-A319-7FC3B18B9461","أن علي بن أبي طالبٍ","منار دين الحق لا يطمس"],["55D6404B-96F2-597C-A764-A02F88D57F78","ومن حباهُ الله أنباءَ ما","في كُتْبه فهو لها فِهرِسُ"],["A65A03EC-D506-5B70-A83B-6B42F6338B09","أحاط بالعلم الذي لم يحط","بمثله بليا ولا هرمسُ"],["FA0D2B43-568E-5907-BC8C-BE503B7F4401","هذا أمير المؤمنين الذي","شرائع الله به تحرس"],["2DD9916A-E6FF-5B2A-8B32-274DCF05D7BF","وحجة الله التي نورها","كالصُّبح لا يَخفى ولا يبلسُ"],["37C1BB5C-24CD-5A0E-B6D9-3165ACC1BF47","تالله لا يَجحَدها جاحِدٌ","إلاَّ امرؤٌ في غيِّه مُركَسُ"],["73374AEF-4244-54E6-A1FD-802B7C4323AB","المعلِنُ الحقَّ بلا خَشيَةٍ","حيثُ خطيبُ القوم لا يَنبِسُ"],["F159FBEA-6654-526A-A463-3AC09A199FEA","والمقحم الخيل وطيس الوغى","إذا اتقاها البطل الأحوس"],["D5501D90-F146-5093-9BA1-305CC5515395","جلبابُه يومَ الفَخارَ التُّقى","لا الطيلسان الخز والبرنس"],["80F27950-93E6-58F1-B549-D6C4AA099E69","يرفل من تقواه في حلةٍ","يحسدُها الدِّيباجُ والسُّندسُ"],["E6C8C421-E4D5-5592-B805-E9737242B114","يا خيرة الله الذي خيره","يشكرُه النَّاطِق والأخرسُ"],["2B2FCE9C-C155-5EBC-B9E6-461595120D08","عَبدُك قد أمَّك مُستوحشاً","من ذنبه للعفو يستأنس"],["EF296354-895D-577A-9771-FDEDB9D899EC","يَطوي إليكَ البحرَ والبرَّ لا","يوحشه شيءٌ ولا يؤنس"],["B76E8AED-499A-56A4-B3E1-DC5344A0B0F4","طوراً على فلكٍ به سابحٍ","وتارة تَسري به عِرمسُ"],["35ECCDB3-9E48-58AA-A5D6-3688D4058182","في كلِّ هيماءَ يُرى شَوكُها","كأنَّه الريحانُ والنرجسُ"],["05B70937-F9A4-5CE9-9094-2C0F5AE84C6C","حتى أتى بابك مستبشراً","ومن أتى بابَك لا يَيأسُ"],["F620AC04-3D25-5DBF-9205-C21A10239CDC","أدعوك يا مولى الورى موقناً","أن دعائي عنك لا يحبس"],["8999D81C-8A91-5FBF-A3F3-2E06C7EA57CD","فنجني من خطب دهرٍ غدا","للجسم مني أبداً ينهس"],["6B2DB3DF-EF0E-5C69-911A-0533CD891D33","هذا ولولا أملي فيكَ لم","يقر بي مثوىً ولا مجلس"],["E212C8C0-A9AB-57F0-B42D-7E533B7DE6B3","صلَّى عليك الله من سَيِّدٍ","مولاه في الدارين لا يوكس"],["74C9D3AA-AE4C-5C97-87A5-07A52E921AE7","ما غردت ورقاء في روضةٍ","وما زهت أغصانها الميس"]]},"A7FB2F62-3C8D-5320-A791-D95CDDB7FF5F":{"t":"يا طودَ مجدٍ في المكارم راسِ","p":201,"s":"يا طود مجد في المكارم راس","r":"465578","v":[["1FAE1FD7-E9E7-535A-82D3-43A8A81771A9","يا طودَ مجدٍ في المكارم راسِ","سامي العماد موطد الآساس"],["CBAAA281-A996-5893-B738-2AA5069DD6D8","لا غرو إن سقط الجوادُ لعثرةٍ","عثرت لها قدم الندى والباس"],["0A3879D0-3C0D-51F4-B77B-3EEC853D7B75","فلقد حملت عليه أثقال العلى","فغدا ذلولاً بعد طول شماس"],["D3566D2E-4FFF-5789-894B-2B43A7B5AF34","حتى إذا ألقيتَ فضلَ عِنانه","سبقاً إلى الغايات قبل الناس"],["CE9CF457-EDD1-56CB-A866-6DC3F95381CA","لم يستطع حملاً لما أوقرته","فهوى كما يهوي العظيم الراسي"],["6757ED1F-F1CA-5146-8141-309BAD87E83F","هيهات أن يَسطيعَ يحملُ راكضاً","جبلَ العُلى فرسٌ من الأفراسِ"],["D098D9FC-8F5B-545C-9679-A929FA7B09AB","فليذهب النغل الحسود لما به","وليحظ مما رامه بالياس"],["BC7D68DF-03C6-5B2C-9460-727CBB180C76","واسلمْ على مرِّ اللَّيالي راتعاً","في طيب عيشٍ طيب الأنفاس"]]},"DACF493C-B83D-549B-996B-C0CC992F4F7C":{"t":"يا عاذلي في الأماني","p":201,"s":"يا عاذلي في الأماني","r":"465687","v":[["0765249E-A9F3-56A3-8766-9D2FB87693E8","يا عاذلي في الأماني","أكثرتَ في العذلِ قَولا"],["1FA83A7F-96E5-5A9A-AAF2-26C11CFE66DF","دَعني أُعلِّلُ نفسي","ما أضيقَ العَيشَ لَولا"]]},"8FB69BA1-61BE-57BA-97F6-5646FAED30DC":{"t":"يا عذيب النيوب","p":201,"s":"يا عذيب النيوب","r":"465869","v":[["0AC1F772-D715-5C91-A995-B1EA5ECF4E95","يا عذيب النيوب","ويا حويلي المؤشر"],["4BF37C81-5642-57CF-BE48-6EEC7F778C07","هاك ما في الجيوب","وهات ما في المؤزر"]]},"2CBC4483-59D9-5060-9B7B-6484267CE4A5":{"t":"يا غزال أمحره","p":201,"s":"يا غزال أمحره","r":"465862","v":[["43EE1C3D-D7C9-5E4C-A381-1D00197BA457","يا غزال أمحره","أكفُفْ فديتُك سهامَكْ"],["2BD523C4-FB51-5B4A-99BD-0DA905F17749","لا تزدني شره","إلى التثام لثامك"],["C8EE48DB-E4E1-5244-B86C-D4982A2530D4","فالهوى أيسره","أضنى معنى غرامك"],["AC2B835B-A618-5937-BF7D-2632196375AC","في مِقاكَ عنترهْ","وسمهرية قوامك"],["3967F109-64DF-513F-B7DB-E280FAE20064","سعدَ من أسكَره","ريقك وسلسل مُدامكْ"],["DCCD2D5E-408E-5958-B721-21FA945A026B","صلْ محبَّك ترَهْ","حافظ وحقَّكْ ذمامَكْ"],["47AF84BE-5573-55C6-B45F-53B309EB0EED","شوقُهُ اسهرَه","وأنت تهنى منامَكْ"]]},"20B2411C-3214-5D88-97A8-43FF7C205C1C":{"t":"يا غزالاً يخفي سناه الغزاله","p":201,"s":"يا غزالا يخفي سناه الغزاله","r":"465681","v":[["5CF9E27C-F90B-5ACA-BEF4-3917B927E5D2","يا غزالاً يخفي سناه الغزاله","فتنَتْني لحاظُك الغَزَّالَهْ"],["4AB0B58B-E957-59A6-83AE-6BFEDE7040BE","مرَّ دهرٌ والعيشُ صفوٌ إلى أن","ذاق قلبي طعمَ الهوى فحَلالَهْ"],["AD487F52-50D6-53AE-8349-E521E083C2BD","ما لقلبي والحب لو لم تمله","للتًصابي أعطافك المياله"],["8B184377-5A13-5E30-9DC6-7EDD1F09ACF3","زادَني لحظُك السقيم اعتلالاً","لا شفى الله سقمَه واعتلالَهْ"],["7E0F5A6C-28B8-5C11-B53E-11BC98412163","كنتُ غِرّاً بالحبِّ حتى دَهَتْني","برناها لحاظك المغتاله"],["7033A3F8-4956-559E-84E9-3683B298D658","كيف أرجو الوفا وأنت على العهد","بطيء الرّضا سريع الملاله"],["7CAC1897-7F5C-58B4-87C9-5EAABE6B19CD","قلت لمّا أاطال فيك عذولي","أنا راضٍ به على كلّ حاله"],["7521070F-BEBF-56EE-8A4E-8B14BFF31A38","يا نسيماً سَرى من الغَور وَهْناً","ساحباً في ربى الحمى أذياله"],["04FD4ECF-6E8A-5D7F-80C7-A8C462AD5AE1","طاب نشراً بطيب من سكن الجِزع","ووافى يجرّ برد الجلاله"],["9509954F-D558-510D-9C8C-2750922B23A9","فروى أحسن الحديث صحيحاً","مسنداً عنهم وأدى الرساله"],["85C5C7E1-DB1B-5F1B-A805-5A9D3C0E1ED1","هات كررّ ذاك الحديث لسمعي","ولك الطول ان رايت الإطاله"],["FB2E1181-BF49-5BB7-A897-83C20FEB3853","قد نكأتَ الغداة في القلب جُرحاً","كنتُ أرجو بعد البِعاد اندِمالَهْ"],["918006BA-6356-5D1F-ABC0-DDEC11921628","يالك الخير إن أتيت ربى سلع","وشارفَت كثبَه ورمالَهْ"],["FF15F08C-F3DF-54D6-AB7F-E130BDEF778F","قف بأعلامه وسل عن فؤادٍ","خَتَلْته ظباؤه المُختالَه"],["E6DEDD55-B1FE-5175-8339-E6F1D3CD1FFA","وتلَّطف واشرَح لهم حالَ صبٍّ","غير السقم حاله فأحاله"],["96431C23-FF4A-5119-A3E6-2E8D4948B6F3","ما سرى بارقٌ برامةَ إلاَّ","واستهلت دموعيَ الهَطَّاله"],["6679B8B8-A90F-5D46-B6D4-A6289F27916B","وتذكرت مربع الأنس والهم","وعصرَ الصِّبا وعهدَ البِطالَهْ"],["5B0B8FC7-DC34-55F5-9A07-E250C9DA05C2","حيثُ ظلِّي من الشَّباب ظليلٌ","والهوى مُسبِغٌ عليَّ ظِلاله"]]},"B545737B-8B05-5BCA-9E55-4CD955289C59":{"t":"يا قائلاً إن القشر البن قد حرما","p":201,"s":"يا قائلا إن القشر البن قد حرما","r":"465728","v":[["EF9E8F67-6D04-5C71-86C7-FA26D5614DC8","يا قائلاً إن القشر البن قد حرما","لكونه مفسداً عقل الذي طعما"],["C68364CC-28E6-5837-B2A1-57C5F6BCF9A2","إفسادُه العقلَ ممنوعٌ كما شهِدَتْ","به التجاربُ فاسأل من به عَلما"],["FFFAACF2-B5FF-5789-BD8E-C02441030A39","وإن بتحريمه أفتى مكابرةً","أبو كثيرٍ فدَعهُ والذي زَعَما"],["4F196DC4-C6C0-5AE6-BB78-FF3D7FBD6EE5","فليس تحريمه يوماً بضائرنا","إذ كان إفسادُه للعقل قد عُدِما"],["3E55E9E9-5D15-5574-AF2D-3C07D039AB26","وما يحلِّلُ شيئاً أو يحرِّمُه","إلا الذي خلق الأشياء لا العلما"]]},"AF83C6AF-C983-5919-85EF-0D337326C7AA":{"t":"يا قهوةً قِشْرِيَّةً","p":201,"s":"يا قهوة قشرية","r":"465978","v":[["A18C0E4C-D421-5D64-8E91-75636C32D013","يا قهوةً قِشْرِيَّةً","حَكَت النُّضارَ بلَوْنِها"],["7B777F5C-607E-5C95-8034-2D4154BDDD42","ولكم حباك حبابها","بخَلاصِها ولُجَينِها"],["03E68549-A3DA-5E5B-A022-E6A39A3A04B6","جليت علي مصونةً","بِزفافِها وبصَوْنِها"],["E14A9239-5E3A-5DAA-A8A9-B2ADA367963C","وكأنَّ كلَّ حَبابَةٍ","تَرنُو إليَّ بِعَينِها"]]},"B30E0C9C-0592-5299-9479-ABA91F3BA2D3":{"t":"يا كحيل الجفون","p":201,"s":"يا كحيل الجفون","r":"465854","v":[["1FD4E26A-C3EB-5318-BBA3-80B829A08A7A","يا كحيل الجفون","لا تجعل العتب ضيقه"],["3A5AF5FC-771E-5961-A236-EE2876F4D536","الهوى لَهْ فنونْ","وله معانٍ دقيقه"],["C18B90C9-CB5A-5334-B9E5-E6B7BFF244E6","خَلِّ عنك الظنون","واسلك طريقَ الحقيقهْ"],["404CF933-212E-521A-8C3D-AA96AD262028","عاشقك لو يخونْ","ما أعطاك قلبه وثيقه"],["CE9DE58C-58C1-550A-802B-C37B679736B2","سر حبك مصون","ما سار غيرك طريقه"],["11EBD051-78B2-53CB-90ED-71C981099B63","ها عيوني عيون","على خدودي دفيقه"],["B5FCD304-14DE-5656-82E9-7A4CCFC885F5","كم شجاً كم شجونْ","ماذا هوىً ذي حريقه"]]},"62128206-1ED6-58E7-9175-DB9DF76A2884":{"t":"يا كوكباً لم تحوه الأفلاك","p":201,"s":"يا كوكبا لم تحوه الأفلاك","r":"465651","v":[["DF1137A6-B7A6-55BD-AD2F-0323E2E4ED37","يا كوكباً لم تحوه الأفلاك","وبعارِضيه مِرْزَمٌ وسِماكُ"],["11CC3AA7-D0A2-5982-BA06-736F2F8ED7A1","يُحيي بطلعتِه النفوسَ ولحظُه","لدماءِ أرباب الهوى سَفَّاكُ"],["3175418C-0390-5056-9C39-921BFB8DACE1","إغمد شَباكَ عن القلوب وصِدْ بأهـ","بأهداب الجفون فإنهن شباك"],["14B4D85D-8BFD-5086-ACFC-3CB5107279B8","أسرَ الغرامُ لكَ النفوسَ بأسْرِها","قَسراً فما يُرجى لَهنَّ فَكاك"],["B504C0E6-2952-5225-B81B-7AC828A76DF3","أنَّى يُرجَّى مِنْ هواك فكاكُها","من بعد ما علقت بها الأشراك"],["A888E888-7A6D-57EA-A7A4-54B82240B50C","خفقَت عليكَ قلوبُ أربابِ الهوى","حتى غَدَونَ وما بهنَّ حَراك"],["C69C3E01-8073-5BD0-B70F-AFBDF96B16EE","لك في القبائل نسبةٌ بجمالها","تسمو الحُبوشُ وتفخر الأتراكُ"],["C3D84C08-0054-5977-92AF-11015264E008","ما كنتُ أحسب للدُّموع بَوارقاً","حتَّى تلألأ ثغرك الضحَّاكُ"],["08B07028-7836-5ACF-A62D-DE401E0A8343","بشفاته ماءُ الحياة لأنفُس","أودى بهن من الصدود هلاك"],["47C8BDF1-108C-568A-90E0-991A064945C3","ما ذقتُ موردَها ولكن هكذا","نقلَ الأراكُ وحدَّث المِسواكُ"],["FB8E913E-A9D3-5864-A670-EDB3B1E48508","قل للأراك أراك تلثم مبسماً","ما راح لاثمه سواك سواك"],["9B4F077A-C69A-54CE-B788-841B1EB05A10","لو أبصر النساك بارق ثغره","ضلت سبيل رشادها النساك"],["05DABCEC-7517-59D2-ABDC-0ADC020ABF85","سِيَّان في نَهب النُّفوس وسفكها","حد الحسام وطرفه البتاك"],["CC68CCAD-A30E-5CD4-BDFF-6A8E189ECEF6","ظبي الصريم إذا تلفت أو رنا","وإذا سطا فالضغيم الفتاك"],["52BA6336-08AB-5CCA-B05F-56E177C60AB2","وأنا الذي في الحب مذ وحدته","ما شان توحيدي له إشراك"],["9797ADE4-F013-5D22-A60E-85AA6A06FB15","وعلى التفنُّن في محاسن وصفهِ","ما حامَ حولَ أقلِّها الإِدراكُ"],["1915D53E-3C1B-5A88-9472-9147A8F8B2DB","لولا أبي وأبي الرضيُّ المُرتضَى","لم يثنِني عن وصفِه اسْتِدراكُ"],["354CE93C-58D3-5BAF-9FAC-45C095C1D872","السيِّدُ الندبُ الهمامُ أخو العُلى","من أذعنت لجلاله الأملاك"],["4A0FD454-3881-5DA2-945A-5F93E1859FBC","هو شمس مجدٍ أشرقت بضيائها","ظُلَمُ الدُّجى وأنارت الأحلاكُ"],["75AF38C5-A2DF-5A04-853D-3E22F51B7142","طافَت بكعبة جُوده يومَ النَّدى","عُصَبُ الوفود ولاذت الهُلاَّكُ"],["347BAC78-C524-515D-B14B-52B6AB18DF18","الألمعيُّ إذا ادلهمَّت طَخيَةٌ","عمياء فهو لسترها هتاك"],["DA010C81-4859-5E4B-8295-0781A563E0A7","واللوذعيُّ إذا تسامت رُتبةٌ","قعساءُ فهو لنيلها دَرَّاكُ"],["66A499A3-798A-5057-9A4C-1910961A8783","والهبرزي إذا تغالت خصلةٌ","علياءُ فهو لرقِّها ملاَّكُ"],["9CF3ACBC-CD27-5CD3-A9B8-AAD7B093FCAA","فلجيدِه دُررُ المدائح تُنتَقى","ولجوده بُردُ الثَّناءِ يُحاكُ"],["676071BC-E5D4-5AE7-BB4D-33FB49190602","سمعاً أخا العلياء مدحة ناظم","نثرت لآلئها له الأسلاك"],["06CA1B95-6942-57F1-8EF5-EFA5C5A1C493","يدعوك بعد أبيه في الدنيا أباً","فكلاكما للمكرُماتِ مِلاكُ"],["7B809092-BF8C-563D-A47A-1C95482ECC0C","يا ليت شعري كيف رأيك بعدما","حال الزمانُ ودارت الأفلاكُ"],["3D477175-0D8D-51E4-814A-804E8D87C8F3","هل قائمٌ عذري لديك بما مضى","مني وقلبي بالخطوب يشاك"],["4947541F-6CE3-52F9-9888-7EE6EC1C0D03","أم آخذٌ في العتب أنتَ وتاركي","حرضاً وأنت الآخذ التراك"],["BEA807B9-339E-5448-867F-ECBBB1E304C9","ما كان إهمالي الجواب لجفوةٍ","لا والذي دانت له الأملاك"],["C48CD589-6965-5558-B3FD-AEB62FD607BB","لكن مخافة أن يقول ويفتري","عني المحال الكاذب الأفاك"],["9840F0A5-97FE-5774-8235-798D4EB0D86A","وإليكها مني عروساً لم يكن","لِسوى ودادِك عندها إملاكُ"],["2CD2685F-CB5C-5CC9-911A-31A470134FF3","لا زلت مقصود الجناب ممجداً","ما لاح برقٌ واستهل سماك"]]},"85323A56-F987-521B-B442-4BC5B156FEC6":{"t":"يا متعباً بنقوشِ الخطِّ أنملَه","p":201,"s":"يا متعبا بنقوش الخط أنمله","r":"465966","v":[["19810387-C890-5AFC-8308-FCD15E51B453","يا متعباً بنقوشِ الخطِّ أنملَه","وساهرَ اللَّيل لم يَرقُدْ ولم يَنَمِ"],["3A6B1D94-FD81-56DE-875C-E7995A227E29","دَعْ عنكَ ما راحت الأقلام تنقُشُه","في صفحة السيف ما يغني عن القلم"]]},"A92B6F03-FBE5-5224-8B9B-EA3F9943BBD1":{"t":"يا ملكاً عم نداه الورى","p":201,"s":"يا ملكا عم نداه الورى","r":"465619","v":[["4998B91B-2DA2-5790-BFCD-ED100B00BF16","يا ملكاً عم نداه الورى","وألحق الباديَ بالعاكفِ"],["3D4ECDDF-0FA4-5D42-AF98-21E76961D97B","لمَّا حللتَ الطائفَ المُشتهى","وصرتَ فيه مأمنَ الخائفِ"],["0750D810-9648-5D97-9AE0-E8F03B21A682","طاف بكَ الخلقُ جميعاً فها","بيتك أضحى كعبة الطائف"]]},"72F03311-0B6B-5C74-9306-F3727BAFD0A2":{"t":"يا نسيمَ الصَّبا متى جُزتَ نجدا","p":201,"s":"يا نسيم الصبا متى جزت نجدا","r":"465492","v":[["529B85BF-F004-5749-9302-A4AFD76257EA","يا نسيمَ الصَّبا متى جُزتَ نجدا","فلقد هجت لي غراماً ووجدا"],["DC6254EB-2053-5E28-8659-4E109C502D55","عَمْرَكَ اللَّه هل مررتَ سُحيراً","بزرُودٍ فزدتَ طيباً وبَردا"],["BB351615-9B3D-5CA4-8FF7-C7C91F7E0359","أم بليلى عرجت ليلاً فقبلـ","ـت ثغيراً منها وعانقت قدا"],["12D89AF2-5243-548F-BFE4-FA2BB6531D44","أم تنسَّمتَ نفحةً من ثَراها","حيث جرَّتْ مُختالةً فيه بُرْدا"],["C59A4DD7-BF6F-5A29-A1C8-8C2A5DB46B7A","إن عهدي بغيد وجرة يسحبـ","ـن بروداً تضوع مسكاً وندا"],["71F1F045-9B24-5E78-97B1-ED91A7EA82BC","كلُّ غرَّاءَ لا تَرى البدرَ مِثْلاً","لسَناها ولا الغَزالةَ نِدَّا"],["086CF830-26C4-5EF8-9E61-7B528333A017","نشرت من دجى الغياهب فرعاً","وتحلَّت زُهرَ الكواكب عِقْدا"],["6AE58126-2823-56EB-9F92-8F085E43CD82","يا رَعى اللَّهُ بالحِمى عصرَ أنسٍ","عشت فيه حيناً من الدهر رغدا"],["954596A5-085E-5FC0-946A-2586BDD64AC8","حيث روضُ الشَّباب غضٌّ نضيرٌ","وغصونُ الصِّبا ترفُّ وتَندى"],["66260F7B-BEFE-59D6-84B5-19C236A906E9","وزماني ذاك الزمانُ المُهَنَّى","وحبيبي ذاك الحبيب المفدى"]]},"B90B155F-1037-5F0A-BA4C-8A3D155CDD4F":{"t":"يا هماماً له المعالي قصور","p":201,"s":"يا هماما له المعالي قصور","r":"465526","v":[["3F6CE975-71BB-52E2-BFE1-4525560C0931","يا هماماً له المعالي قصور","لا تلمني إن عن مني قصور"],["8FC26183-9414-5530-A11C-71E322925EA3","حكم الدهرُ كيف شاء بهضمي","وشبابي والعمرُ غضٌّ نَضيرُ"],["B19F3975-97E4-5469-841B-2630D91139BA","عُمُري لم يكن يزيدُ على اثنين","وعشرين والشباب غرور"],["828F7AC3-93A1-534C-ACBA-C3B9099D501A","كاثرتني الخطوب والجد كابٍ","وقليلٌ من الخطوب كثيرُ"],["FAFDE900-19C7-5AC7-A3B6-46781719A220","حزنٌ شاملٌ وشملٌ شتيتٌ","وهوىً نازحٌ وقلبٌ كسيرُ"],["EAC3BA7E-C8DD-51B5-A380-C6E470E6A198","وفؤادٌ من المسرَّة قَفْرٌ","وجنانٌ من الأسى معمور"],["14D32087-AE13-58C7-B83B-9D0B13B8366B","كمْ إلى كمْ قطيعةٌ وصدودٌ","أقلوبٌ نَحيا بها أم صخورُ"],["499C1819-A374-5B60-B6D3-18A49A470BA0","أين مني ذاك الصديق المفدى","والحيا العذب والحسام الغرير"],["F6DDF743-E610-5C37-90F0-10150382E3B1","حيث عُودي على الزَّمان صَليبٌ","وبعيدي دانٍ ووردي نمير"],["6A60A22D-F40D-5CA2-810B-FC526F1785E9","أيها الماجد الكريم المعلى","والفتى القرم والهمام الكبير"],["9B4EE2B4-5002-5919-B193-8530088870AA","هاكها نفثةً أباحتكَ سرِّي","نفثهُ السِّحر قد وَحاها الضَّميرُ"],["45AB208B-CD2F-54D4-8842-A8FA0AC5B445","وابق واسلم على ممر الليالي","ما حلا موردٌ ومرت شهور"]]},"D534CAD2-3F5E-5A9A-9EE6-6116F27E0C7B":{"t":"يقول الهاشميُّ غداةَ جُزْنا","p":201,"s":"يقول الهاشمي غداة جزنا","r":"465502","v":[["55111861-3A9F-538C-8CED-392BE5D1B88A","يقول الهاشميُّ غداةَ جُزْنا","بحار الهند نقطع كل وهد"],["11DEDF9F-01A2-5B9F-849B-34AEDC06A1CB","أتذكر عن هوى تَلَعَاتِ نجدٍ","وأين الهند من تلعات نجد"]]},"822711AA-302B-5D66-83C3-CFE505F9B11E":{"t":"يقولُ تفَّاحُنا الزاهي بنضرته","p":201,"s":"يقول تفاحنا الزاهي بنضرته","r":"465789","v":[["654C3532-945A-5A9C-9046-A24B3BC71D9A","يقولُ تفَّاحُنا الزاهي بنضرته","وقد جنته يدُ الجاني من الفَننِ"],["F76D0D4A-913A-5B53-98D1-44F6B6F794C8","وقلَّدته يدُ الحسناءِ عاتقَها","ما أبت عن غصنٍ إلا إلى غصن"]]},"2D6E81F8-E62E-5362-8BFD-17F5B1C4C940":{"t":"يهلك المال بالعطاء ويحيا","p":201,"s":"يهلك المال بالعطاء ويحيا","r":"465887","v":[["75DC7E2D-7F12-54DD-BBE0-D344E6001163","يهلك المال بالعطاء ويحيا","ميتُ فضلٍ فاعجَبْ لمحيٍ مُميتِ"]]}}}