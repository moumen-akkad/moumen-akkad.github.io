{"v":1,"poems":{"CF6965FB-0585-52D2-9551-3F380AF6A3D5":{"t":"أحقّاً يا حمامةَ بطنِ وجِّ","p":46,"s":"أحقا يا حمامة بطن وج","r":"440154","v":[["4A88B6B6-2372-5AE2-A5EF-8CE372458927","أحقّاً يا حمامةَ بطنِ وجِّ","بهذا النّوحِ إنَّكِ تصدُقينا"],["09BDC007-197A-5C3E-BDF9-603BF324406E","غلبتُكِ بِالبُكَاءِ لأَنَّ لَيْلِي","أواصلهُ وإنّكِ تهجعينا"],["6AB8A6A4-6310-543A-9A1F-21C5494B509C","وَإنِّي إنْ بَكَيْتُ حقاً","وإنّكِ في بكائكِ تكذبينا"],["F2419578-4BD8-5FB0-A68F-963C8A9FAE40","فلستِ وإنْ بكيتِ أشدَّ شوقاً","ولكنِّي أسرُّ وتعلنينا"],["051E3A11-CB15-5D2B-BF72-B26F2ED9D28C","فَنُوحِي يَا حمَامةَ بطنِ وَجٍّ","فقدْ هيّجتِ مشتاقاً حزينا"]]},"BFFFA698-533A-53D0-B09C-A895C8FCE6A4":{"t":"أَلاَ لا تَلُوما ليس فِي اللَّوْمِ رَاحةٌ","p":46,"s":"ألا لا تلوما ليس في اللوم راحة","r":"440149","v":[["A519D0BE-9832-532C-8428-F95849D75A48","أَلاَ لا تَلُوما ليس فِي اللَّوْمِ رَاحةٌ","فقد لُمْتُ نَفْسِي مِثْلَ لَوْمِ قَضِيبُ"]]},"159B9D4C-1319-5629-BFCE-72E3EC3DB0CB":{"t":"أَمُنْصَدِعٌ قَلبي مِنَ البَيْنِ كُلَّمَا","p":46,"s":"أمنصدع قلبي من البين كلما","r":"440153","v":[["635B83EA-E3B1-5507-8D33-FBF2DBEB6155","أَمُنْصَدِعٌ قَلبي مِنَ البَيْنِ كُلَّمَا","تَرَنَّمَ هَدّالُ الحَمَامِ الهواتفِ"],["735A7C1A-7AA9-57A3-943F-B1B00D985B31","سَجَعْنَ بِلَحْنٍ يَصْدَعُ القلبَ شَجْوُهُ","على غير عِلْمٍ بافترَاقِ الأَلايفِ"],["4F9B7B29-2006-54FE-BD18-B8F5AA1C2E44","ولو نِلْتُ منها ما يُوازَن بالقَذَى","شفى كلَّ داءٍ في فؤادي حالفِ"]]},"01F826FF-AA49-5620-B8FE-32DE0B8AC3C7":{"t":"بِيَ اليأْسُ أَوْ داءُ الهُيَامِ شَرِبْتُهُ","p":46,"s":"بي اليأس أو داء الهيام شربته","r":"440158","v":[["B27E7951-6232-5A60-B850-F01FABDD3971","بِيَ اليأْسُ أَوْ داءُ الهُيَامِ شَرِبْتُهُ","فَإيَّاكَ عَنِّي لا يَكُنْ بِكَ ما بِيا"],["4AE48381-3416-5AD4-96D3-0B3030C8DD3D","فما زادني النّاهونَ إلّا صبابةً","ولا كثرةُ الواشينَ إلّا تماديا"]]},"7E4F83B8-F716-585A-8F07-11B95EFD98CB":{"t":"خليليَّ منْ عليا هلالِ بنِ عامرٍ","p":46,"s":"خليلي من عليا هلال بن عامر","r":"440155","v":[["7515320D-5010-51A9-8F8E-0FC1E179A547","خليليَّ منْ عليا هلالِ بنِ عامرٍ","بِصَنْعَاءِ عوجا اليومَ وانتظراني"],["E1553F79-50BC-5543-B9E2-5848FE598D38","أَلم تَحْلِفا بِالله أَنِّي أَخُوكُمَا","فلمْ تفعلا ما يفعلُ الأخوانِ"],["9165D9B7-F22F-5E2E-A943-676462D2D1BA","ولم تَحْلِفا بِالله قدْ عَرَفْتُمَا","بذي الشِّيحِ رَبْعاً ثُمَّ لا تَقِفَانِ"],["74C416D3-6AE1-534A-94E5-9AA0789D5E65","ولا تَزْهدا في الذُّخْرِ عندي وَأَجْمِلاَ","فَإنَّكُمَا بِيْ اليومَ مبتَلِيَانِ"],["934650A7-BECE-5676-B53B-92C7FB087EF6","أَلَمْ تَعْلَمَا أَنْ لَيْسَ بِالمَرْحِ كُلِّهِ","أَخٌ وصدِيقٌ صالحٌ فَذَراني"],["996829CE-E6E4-5838-9B4C-674EFAD76576","أفي كلِّ يومٍ أنتَ رامٍ بلادها","بِعَيْنَيْنِ إنساناهما غَرِقَانِ"],["5CBDE580-A478-592E-98D9-F6034C9F0271","وعينايَ ما أوفيتُ نشزاً فتنظرا","بِمَأْقَيْهما إلاَّ هما تَكِفَانِ"],["5080CC0F-BF37-5382-AC45-F65F07E09AB8","أَلاَ فَاحْمِلاَنِي بارَكَ الله فِيكُما","إلَى حَاضِرِ الرَّوْحَاءِ ثُمَّ ذَرَانِي"],["16D5F7E7-6787-5A5B-88B3-54DD1EC6D139","على جسرةِ الأصلابِ ناجيةِ السُّرى","تُقْطِّعُ عَرْضَ البيدِ بِالوَخَذَانِ"],["BE86ECFB-E0FD-5E87-B1EB-701D5DA57C14","إذا جبنَ موماةً عرضنَ لمثلها","جَنَادِبُها صَرْعى من الوَخَدَانِ"],["5C55E040-8142-5696-8BE6-048337030248","ولا تعذلاني في الغواني فإنّني","أَرَى فِي الغواني غَيْرَ ما تَرَيَانِ"],["AD279C8A-D9DF-5A4B-9E71-C0EAB53B2F38","إلمّا على العفراءِ أنّكما غداً","وَمَنْ حَلِيتْ عَيني به ولساني"],["8BBBFF0A-207E-5E5B-92FC-C71E5EE19614","فيا واشِيَيْ عفرا دعاني ونظرةً","تقرُّ بها عينايَ ثمَّ دعاني"],["996737EE-DBF2-5715-8EF0-5B3BD1B04BE4","أَغَرَّكما لا بَارَكَ الله فيكما","قميصٌ وَبُرْدا يَمنةٍ زَهَوانِ"],["F71E8DA4-4E37-5CFE-828C-9207B081874A","متى تكشفا عنِّي القميصَ تَبَيَّنا","بِيَ الضُّرَّ من عَفْراء يا فَتَيَانِ"],["22993D18-0960-53DB-8182-A8E1875E5CBF","وَتَعْتَرفَا لَحْماً قليلاً وَأَعْظُماً","دِقَاقاً وَقَلْباً دائمَ الخَفَقانِ"],["337FC4C0-7991-5132-9E4C-A3F66F93736E","على كبدي منْ حبِّ عفراءَ قرحةٌ","وعينايَ منْ وجدٍ بها تكِفانِ"],["E16B53AC-D206-526A-A066-C9A19C36B19C","فعفراءُ أرجى النّاسُ عندي مودّةً","وعفراء عنّي المُعْرِضُ المتواني"],["3D93BBD6-C3BE-527C-B294-363ECBE09B76","أُحِبُ ابْنَةَ العُذْرِيِّ حُباً وَإنْ نَأَتْ","وَدانَيْتُ فيها غيرَ ما مُتَدانِ"],["E13394D4-89A7-58CF-9145-D607E0F6BFDD","إذَا رَامَ قلبي هَجْرَهَا حالَ دونَه","شَفِيعانِ من قَلْبِي لها جَدِلانِ"],["0BB49FB5-FEED-5274-A531-16402DD7546D","إذَا قلتُ لا قالا: بلي، ثمَّ أَصْبَحَا","جَمِعياً على الرَّأْيِ الذي يَرَيانِ"],["A3E2367E-91F7-5E28-BF6C-A7C2BC494D3B","فيا ربِّ أنتَ المستعانُ على الّذي","تحمّلتُ منْ عفراءَ منذُ زمانِ"],["E3117452-7EBE-5317-968F-AAE90AD379AD","فيا ليتَ كلَّ اثنينِ بينهما هوىً","منَ النّاسِ والأنعامِ يلتقيانِ"],["9B2AE6D5-E413-59EE-BDE9-700CEB6915EB","فَيَقْضِي مُحِبٌّ مِن حَبيبٍ لُبَانةً","ويرعاهما ربّي فلا يُريانِ"],["BBB0C298-0CEA-5842-9163-3F7852C96C79","أَمامي هوىً لا نومَ دونَ لِقَائِهِ","وَخَلْفِي هوىً قد شفَّني وبَرَاني"],["38DBFE26-AAA4-5081-AD31-CA19B005E0FD","فمنْ يكُ لم يغرضْ فإنّي وناقتي","بِحَجْرٍ إلَى أَهْلِ الحِمى غَرَضانِ"],["7D52E744-2CA7-535D-AEF6-292937BCD240","تحنُّ فتبدي ما بها منْ صبابةٍ","وأخفي الّذي لولا الأسى لقضاني"],["A3140EF8-4D06-5527-A014-5D238B915A13","هوى ناقتي خَلْفِي وقُدَّامي الهوى","وَإنِّي وَإيَّاهَا لَمُخْتَلِفَانِ"],["6A0926BE-84EE-55BD-990B-5D1039180644","هوايَ عراقيٌّ وتثني زمامها","لبرقٍ إذا لاحَ النجومُ يمانِ"],["C1042663-01C9-55F5-88A2-40CC1E3E2962","هوايَ أمامي ليسَ خلفي معرَّجٌ","وشوق قَلوصي في الغُدُو يمانِ"],["CE918583-17AD-593C-BC2A-966E0695747D","لعمري إنّي يومَ بصرى وناقتي","لَمُخْتَلِفَا الأَهْواءِ مُصْطَحَبانِ"],["59D2A07E-37BE-5590-A1CE-80A1FE1A626B","فَلَوْ تَرَكَتْنِي ناقتي من حَنِينَها","وما بي منْ وجدٍ إذاً لكفاني"],["FE7259AD-0B09-5EEF-99C8-625045EF5833","متى تَجْمعي شوقي وشوقَكِ تُفْدحِي","وما لكِ بِالْعِبْءِ الثَّقِيلِ يَدَانِ"],["1AC95BBD-63A1-5522-B9C3-9FECD0C65882","يا كبدينا منْ مخافةِ لوعةِ","الفراقِ ومنْ صرفِ النّوى تجِفانِ"],["BD38B52A-A048-5E91-ADF9-FE39F56AC407","وإذْ نحن منْ أنْ تشحطَ الدّارُ غربةً","وإنْ شقَّ البينُ للعصا وجلانِ"],["6F6029FC-0778-52FB-A830-EA42C4464AC3","يقولُ ليَ الأصحابُ إذ يعذلونني","أَشَوْقٌ عِراقيٌّ وَأَنْتَ يَمَانِ"],["6385A3C2-6500-575D-9CCE-968761CE0AAC","وليسَ يَمانٍ للعِراقيْ بِصَاحِبٍ","عسى في صُرُوفِ الدَّهْرِ يَلْتَقِيانِ"],["28A3DA00-52A5-5B39-8D01-82725F9046EA","تحمّلتُ منْ عفراءَ ما ليسَ لي بهِ","ولا للجبالِ الرّاسياتِ يدانِ"],["8415FE08-F1FE-53D7-BFC8-A889C99656C2","كَأَنَّ قَطاةٌ عُلِّقَتْ بِجَناحَهَا","على كبدي منْ شدّةِ الخفقانِ"],["79A1EF92-9816-5B61-9411-D9D271C294C8","جعلتُ لعرّافِ اليمامةِ حكمهُ","وَعَرّافِ حَجْرٍ إنْ هما شَفيانِي"],["2245BC5E-96B3-51DA-A313-6CB0C85A2636","فَقالاَ: نَعَمْ نَشْفِي مِنَ الدَّاءِ كُلَّهِ","وقاما مع العُوَّادِ يُبتَدَرانِ"],["D0DAED4C-2D8F-5036-855E-18CB54895C1D","ودانَيْتُ فيها المُعْرِضُ المُتَوَانِي","لِيَسْتَخْبِرانِي. قُلْتُ: منذ زمانِ"],["C15B242B-4F41-5FC6-978F-E84761613796","فما تركا من رُقْيَةٍ يَعْلمانِها","ولا شُرْبَةٍ إلاَّ وقد سَقَيَانِي"],["D96029A4-344E-5243-BF2C-88376082A8E3","فما شفا الدّاءَ الّذي بي كلّهُ","وما ذَخَرَا نُصْحاً، ولا أَلَوانِي"],["02FD1A4B-3B66-527D-AB39-D9F179C36434","فقالا: شفاكَ اللهُ، واللهِ ما لنا","بِما ضُمِّنَتْ منكَ الضُّلُوعُ يَدَانِ"],["9F7DA9B2-BD4A-51F4-8718-EBDE22B5918E","فرُحْتُ مِنَ العَرّافِ تسقُطُ عِمَّتِي","عَنِ الرَّأْسِ ما أَلْتاثُها بِبَنانِ"],["83F689A7-FD67-5BE7-B332-F6513FF80CED","معي صاحبا صِدْقٍ إذَا مِلْتُ مَيْلَةً","وكانَ بدفّتي نضوتي عدلاني"],["F0A561ED-6672-5E68-BA07-E4A6428A62F8","ألا أيّها العرّافُ هل أنتَ بائعي","مكانكَ يوماً واحداً بمكاني؟"],["E150DCFE-94D2-5B3E-BDB6-3E54BFB4B95C","أَلَسْتَ تراني، لا رأَيْتَ، وأَمْسَكَتْ","بسمعكَ روعاتٌ منَ الحدثانِ"],["C76B0CB6-1ECF-5D82-8C78-3A1010CD2FA2","فيا عمٌ يا ذا الغَدْرِ لا زِلْتَ مُبْتَلىً","حليفاً لهمٍّ لازمٍ وهوانِ"],["7BC530D4-AEE1-5945-A404-8913F9408E88","غدرتَ وكانَ الغدرُ منكَ سجيّةً","فَأَلْزَمْتَ قلبي دائمَ الخفقانِ"],["B661382D-C948-5378-A559-C0CD9F73DB38","وأورثتني غمّاً وكرباً وحسرةً","وأورثتَ عيني دائمَ الهملانِ"],["C89EDCE8-56E7-5588-9116-FCAECAC378F5","فلا زِلْتَ ذا شوقٍ إلَى مَنْ هويتهُ","وقلبكَ مقسومٌ بِكُلِّ مكانِ"],["9EFF417F-90C9-5700-A7FE-81342A9298B7","وإنّي لأهوى الحشرَ إذ قيلَ إنّني","وعفراءَ يوْمَ الحَشْرِ مُلْتَقِيَانِ"],["3CA71DF4-3B7B-5088-8718-2BAE28569833","وَإنَّا على ما يَزْعُمُ النّاسُ بَيْنَنَا","مِنَ الحبِّ يا عفرا لَمُهْتَجِرانِ"],["2E099F52-64C8-58AC-BA0D-43CC9D3C42B7","تحدّثَ أصحابي حديثاً سمعتهُ","ضُحَيّاً وَأَعْنَاقُ المَطِيِّ ثَوانِ"],["FE61E013-9E69-587C-B16A-AB8CC9E1B020","فقلتُ لهم: كلاّ. وقالوا. جماعةً","بلى، والذي يُدْعى بِكلِّ مكانِ"],["BDB75FB5-BB19-5D9C-A1CC-B029AA058213","ألا يا غرابيّ دمنةِ الدّارِ بيّنا","أَبَا الصَّرْمِ من عفراءَ تَنتحبانِ؟"],["23FCFB45-CC8E-530B-877C-B13A28120BDD","فَإنْ كَانَ حقاً ما تقُولاَنِ فاذهبا","بلحمي إلى وكريكما فكلاني"],["C658A9DA-94F9-5FFC-B712-939642236B1F","إذَنْ تَحْمِلاَ لَحْماً قلِيلاً وَأَعْظُماً","دِقَاقاً وقَلْباً دائمَ الخفَقَانِ"],["3AFDC830-A509-51F2-AE90-5BDE8B245E0E","كُلاَني أَكْلاً لَم يَرَ النَّاسُ مِثْلَهُ","ولا تهضما جنبيَّ وازدرداني"],["54CBEC30-13B8-5640-AC33-B3FC067E67B7","ولا يعلمنَّ النّاسُ ما كانَ ميتتي","ولا يَطْعَمَنَّ الطَّيْرُ ما تَذَرَانِ"],["6B74C1D8-FD54-55F4-BE6D-9A26378F2548","أَنَاسِيَةٌ عَفْراءُ ذكريَ بَعْدَما","تركتُ لها ذِكْرا بِكُلِّ مَكَانِ"],["1992D88F-183E-5820-8CFA-6C7CE525F6C5","ألا لعنَ اللهُ الوشاةَ وقولهمْ","فُلاَنَةُ أَمْسَتْ خُلَّةٌ لِفُلاَنِ"],["267B002D-73A2-5887-8007-C6F2AB1A7A69","فَوَيْحَكُمَا يا واشِيَيُ أَمِّ هَيْثَمٍ","ففيمَ إلى منْ جئتما تشيانِ؟"],["708C900C-4366-588D-9A7A-4446A6B15D1A","ألا أيّها الواشي بعفراءَ عندنا","عَدِمْتُكَ مِنْ واشٍ أَلَسْتَ ترانِي؟"],["10136972-FB3C-5C75-8868-3F9C453D260A","أَلَسْتَ ترى لِلْحُبِّ كيف تَخلَّلَتْ","عناجيجهُ جسمي، وكيفَ براني؟"],["491E726C-4D59-5C6E-BA8E-00A2E8DE8619","لو أنَّ طبيبَ الإنسِ والجنِّ داوياً","الّذي بيَ منْ عفراءَ ما شفياني"],["2FAFAA21-A5A9-5C04-9631-7D58104B5709","إذا ما جلسنا مجلساً نستلذّهُ","تَواشَوا بِنَا حتى أَمَلَّ مكاني"],["E408EF03-7152-5D3C-9963-6214F04673B6","تكنّفني الواشونَ منْ كلِّ جانبٍ","ولو كانَ واشٍ واحدٍ لكفاني"],["B5EA294B-0E52-5B11-8295-0A8FA3C4F5E6","ولو كانَ واشٍ باليمامةِ دارهُ","وداري بأعْلى حَضْرَمُوت أَتَانِي"],["D8C8A7E1-DBC2-5A00-9C79-BC10A94DD016","فَيَا حَبَّذَا مَنْ دونَهُ تَعْذِلونَنِي","ومنْ حليتْ بهِ عيني ولساني"],["A5382735-FB15-57C3-9A91-DEFF6278C828","ومنْ لو أراهُ في العدوِّ أتيتهُ","وَمَنْ لو رآنِي في العَدُوِّ أَتَانِي"],["D710A23D-B18C-57B9-816E-21D3DF389115","ومنْ لو أراهُ صادياً لسقيتهُ","ومَنْ لو يرَانِي صادياً لَسَقَانِي"],["3645AB42-69B3-5A5D-8BF0-5C44D0BF730B","ومنْ لو أراهُ عانياً لكفيتهُ","ومَنْ لَوْ يَرانِي عانِياً لَكَفَانِي"],["F8CCFC44-3D4C-5DCE-B7B0-396CD3835201","ومنْ هابني في كلِّ أمرٍ وهبتهُ","ولو كنتُ أمضي منْ شباةِ سنانِ"],["8F4C8EDE-1902-5F15-B4F8-ED821C302CE6","يُكَلِّفُنِي عَمِّي ثمانين بَكْرَةً","ومالي يا عفراءُ غيرُ ثمانِ"],["FF282D34-5CEF-540A-B4BA-C17F75DE388B","ثَمانٍ يُقْطِّعْنَ الأَزِمَّةِ بالبُرى","ويقطعنَ عرضَ البيدِ بالوخدانِ"],["FE1CA971-5D52-53DD-A7AC-DDA01F17625A","فيا ليتَ عمّي يومَ فرّقَ بيننا","سُقيْ السُّمَّ ممزوجاً بِشَبِّ يَمانِ"],["12AB1C2F-D898-5895-83FD-28DBB68EBFDD","بنيّةُ عمّي حيلَ بيني وبينها","وضجَّ لِوَشْكِ الفُرْقَةِ الصُّرَدانِ"],["105285B5-B8F8-5F43-A60B-43F602FF7A31","فيا ليتَ محيّانا جميعاً وليتنا","إذا نحنُ متنا ضمّنا كفنانِ"],["DCC60E88-EC9C-5E26-8637-3EAAF2FCA0CC","ويا ليت أَنَّا الدَّهْرَ في غيرِ رِيبةٍ","بعيرانِ نرعى القفرَ مؤتلفانِ"],["76805D4D-17CC-5FFC-810D-5C61875D46C1","يُطْرِّدُنا الرُّعْيَانُ عَنْ كُلِّ مَنْهَلٍ","يقولونَ بَكْرا عُرَّةٍ جَربَانِ"],["D2047773-E58D-5247-BF12-7C4B080A3DA0","فواللهِ ما حدّثتُ سرّكِ صاحباً","أَخاً لِي ولا فَاهَتْ بِهِ الشَّفَتانِ"],["5F3C9E97-BD82-5AE0-87B1-B2635DB1FDC7","سِوى أَنَّنِي قد قُلْتُ يوماً لِصَاحبي","ضُحىً وقَلوصانا بنا تَخِدَانِ"],["C4934F8B-1B7F-5687-807F-4625A43A8F4E","ضُحَيّاً وَمَسَّتْنَا جَنوبٌ ضَعيفةٌ","نسيمٌ لريّاها بنا خفقانِ"],["8A85B1D4-4E7A-5488-9D2F-D7680A5FB6F3","تحمّلتُ زفراتِ الضّحى فأطقتها","وما لي بزفراتِ العشيِّ يدانِ"],["79515146-1B96-5DD8-B4E8-AA88EE2066DB","فيا عَمِّ لا أُسْقِيتَ من ذي قَرابَةٍ","بلالاً فقدْ زلّتْ بكَ القدمانِ"],["495AA764-09C7-509A-A3AC-66CF058798A0","فأنتَ ولم ينفعكَ فرّقتَ بيننا","ونحنُ جمعٌ شعبنا متدانِ"],["EEDB12E4-55AB-5C49-BC32-ED92DCB692AF","وَمَنَّيْتَنِي عَفْراء حتى رَجَوْتُها","وشاعَ الذي مَنَّيْتَ كُلَّ مكانِ"],["9E463661-F0A3-5322-89CD-E94216D3042C","منعّمةٌ لمْ يأتْ بينَ شبابها","ولا عَهْدِها بِالثَّدْيِ غيرُ ثَمانِ"],["AEB88E97-4161-5E2F-957B-0988F0DF48B5","ترى بُرَتَيْ سِتِّ وستِّين وافياً","تهابانِ ساقيها فتنفصمانِ"],["2A8844D4-3518-56DF-B08D-8854F228391D","فواللهِ لولا حبُّ عفراءَ ما التقى","عليَّ رواقا بيتكِ الخلِقانِ"],["80A2357C-6CE0-5961-B096-DC2F799EB3E9","خُلَيْقانِ هَلْهالانِ لا خَيْرَ فيهما","إذَا هَبَّتِ الأَرْواحُ يَصْطَفِقَانِ"],["C1DFDA4E-EB6B-5284-9D56-385E30C08F50","رواقانِ تهوي الرّيحُ فوقَ ذراهما","وبِاللّيْلِ يسرِي فيهما اليَرقانِ"],["3EF34D9A-F219-5146-B05D-2B5310B26512","ولم أَتْبَعِ الأَظْعَانِ فهي رَوْنَقِ الضُّحَى","ورحلي على نهّاضةِ الخديانِ"],["CF917C6E-9C3C-520E-9B1C-388896A2426F","ولا خَطَرَتْ عَنْسٌ بِأَغْبَرَ نازِحٍ","ولا ما نحتْ عينايَ في الهملانِ"],["A4B43876-A339-5207-8723-179FF2EC3A11","كَأَنَّهُمَا هَزْمَانِ من مُسْتَشِنَّةٍ","يُسْدانِ أَحْيَاناً وَيَنْفَجِرانِ"],["A5D4F082-8714-526F-AF22-29DE431AA4D0","أرى طائريَّ الأوّلينِ تبدّلا","إلَيَّ فما لي منهما بَدَلاَنِ"],["8F337697-12C7-5202-BB22-9481C733246F","أَحَصّانِ من نَحْوِ الأَسَافِلِ جُرِّدا","أَلفّانِ مِنْ أَعلاهما هَدِيان"],["69E2A0BE-3A41-5036-A3B7-86EA1ACFFACE","لِعَفْراءَ إذْ في الدَّهرِ والنَّاسِ غَرَّةٌ","وَإذْ حُلُقَانَا بِالصِّبَا يَسَرانِ"],["AF04ADC5-C7B8-5A1C-ABC7-859EB07C8A15","لأَدنُو مِنْ بيضاءَ خَفَّاقَةِ الحشا","بنيّةِ ذي قاذورةٍ شنآنِ"],["23B33511-45DB-52DF-9222-5EDB54B0550A","كأنَّ وشاحيها إذا ما ارتدتهما","وقامتْ عِنانا مُهْرَةٍ سَلِسَانِ"],["3006B1CE-020F-58C0-ABE1-B34BF0546128","يَعَضُّ بَأَبْدَانِ لها مُلْتَقَاهما","ومثناهما رخوانِ يضطربانِ"],["8C1C0ED1-1395-56ED-BD92-02014B2D4B85","وتحتهما حقفانِ قدْ ضربتهما","قطارٌ منَ الجوزاءِ ملتبدانِ"],["F52A736B-93BD-51CA-8F40-5654481F524D","أَعَفْراءُ كم مِنْ زَفْرَةٍ قد أَذقْتِنِي","وحزنٍ ألجَّ العينَ بالهملانِ"],["473266BC-796E-5589-AE0E-77022D968CB3","فلو أنَّ عينيْ ذي هوىً فاضتا دماً","لفاضتْ دماً عينايَ تبتدرانِ"],["DD8D217A-D75F-57F8-AA61-C0AF35D7273E","فهلْ حاديا عفراءَ إنْ خفتَ فوتها","عَلَيَّ إذَا نَادَيْتُ مُرعَويانِ"],["DFD0A8B8-56D2-53ED-A627-E04499A6BAD4","ضَرُوبانِ للتّالِي القطوفِ إذَا وَنَى","مشيحانِ منْ بغضائنا حذرانِ"],["B1CB836F-56A1-5FD9-BD25-CE55E01B7E9D","فما لكما من حادِيَيْنِ رُمِيتُما","بحمّى وطاعونٍ إلا تقفانِ؟"],["4CAF6738-C5B6-5659-97E4-251C1E13EDE1","فما لكما من حادِيَيْنِ كُسِيتُما","سرابِيلَ مُغْلاَةً من القَطِرانِ"],["F0308070-428E-5483-AD79-A4F3FCEC7123","فويلي على عفراءَ ويلٌ كأنّهُ","على النَّحْرِ والأَحشاءِ حَدُّ سِنَانِ"],["33A359E0-5A7B-58C5-9410-4D08B95C8210","ألا حَبَّذا مِنْ حُبِّ عفراءَ مُلْتقى","نَعَمْ وألا لا حيث يَلْتَقِيانِ"],["D32C1A82-C1C1-5348-970F-E0033DD050D6","أحقاً عبادَ اللهِ أنْ لستُ زائراً","عفيراءَ إلا والوليدُ يراني"],["D605F171-AAA6-5CB9-9E5B-8481ED7674DE","لَوْ أَنَّ النَّاسِ وَجْدا وَمِثْلَهُ","مِنَ الجنِّ بعد الإنس يلتقيان"],["CA395D8B-6655-5C61-8892-7DE6D20B196F","فيشتكيان الوجدَ تمَّت أشتكي","لأَضْعَفَ وَجْدِي فوقَ ما يَجِدانِ"],["81CEEA58-6954-5611-9D6B-E0B20A7572A5","وما تَرَكَتْ عفراءُ مِنْ دَنَفٍ دوىً","بِدِوْمةٍ مَطْويٌّ له كَفَنَانِ"],["F25A3BB5-2EE5-57AC-AA96-A4857E56EEC8","فقد تَرَكْتَنِي ما أَعِي لمحدِّثٍ","حديثاً وإنْ ناجيتهُ ونجاني"],["4708652F-EBB1-51DB-B414-CAAC5CC899D9","وقد تَرَكَتْ عفراءُ قلبي كَّأَنَّهُ","جَنَاحُ غُرابٍ دائمُ الخَفَقَانِ"]]},"72E76BF5-8454-517A-B38F-581015E20978":{"t":"عجبتُ منَ القيسيِّ زيدٍ وتربهِ","p":46,"s":"عجبت من القيسي زيد وتربه","r":"440156","v":[["9FFF6363-1CF7-567D-9819-F2382CBB867F","عجبتُ منَ القيسيِّ زيدٍ وتربهِ","عَشِيَّةِ جوِّ الماءِ يختبِرانِي"],["D5614903-0D3C-518F-807C-067CB241DF64","هما سألاني ما بعيرانِ قيّدا","وشخصانِ بالبرقاءِ مرتبعانِ"],["5A5B7795-A05B-5264-835E-B7574E111517","هما بكرتانِ عائطانِ اشتراهما","منَ السّوقِ عبدا نسوةٍ غزلانِ"],["90BA0A92-7EA7-558E-8F30-77C3F02C090D","هما طرفا الخودينِ تحتَ دجنّةٍ","منَ اللّيلِ والكلبانِ منطويانِ"],["05C92701-28DA-58A6-9EE8-A2490DD14E17","فَبَاتَا ضَجِيعيْ نِعْمَةٍ وَسَلامَةٍ","وسادهما منْ معصمٍ ومتانِ"],["7FF29EB5-4C0E-581B-A702-E5668B273068","وأصبحتا تحتَ الحجالِ وأصبحا","بِدَوِيَّةِ يَحْدوهما حَدْيانِ"],["3703C323-A38C-5F4C-ABE5-50DFC04BACBD","فما جأبهُ المدرى تروحُ وتغتدي","ذُرى الطّامساتِ الفرْدِ من وَرَقانِ"],["1AABEFFD-AD93-5BBE-9688-7B0557142CC4","بِأَنْفَعِ لي منها وَأَنَّى لِذَاكِرِ","هوىً ليَ أبلى جدّتي وبراني"],["5EA1AD69-4D33-530B-AE96-65A3A306B167","رَأَتْنِي حَفَافَيْ طُخْفَتَيْنِ فَظَلَّتَا","ترنّانِ ممّا بي وتصطفقانِ"],["AEF0F6E3-79FE-5B5B-966F-3C9890D34080","إزَارٌ لَها تحت القميص يَمَانِ","تَمَنَّيْتُ مِنْ وَجْدِي بِعفراءَ أَنَّنَا"],["9955850C-5158-5C01-A582-57568DB853D0","بعيرانِ نرعى القفرَ مؤتلفانِ","أَلاَ خَبِّرَانِي أَيُّهَا الرّجُلاَنِ"],["BA260F34-C9CC-5866-9E07-20AAE230915A","عَنِ النّوْمِ إنَّ الشوقَ عنه عَدانِي","وكيفَ يلذُّ النّومُ أمْ كيفَ طعمهُ"],["A1BF32C4-09F4-5F28-B7D3-FBB35B466CEB","صِفَا النَّومَ لي إنْ كنتما تصفانِ","أصلّي فأبكي في الصّلاةِ لذكرها"],["730A5F14-A699-5247-8107-725CB798024B","ليَ الويلُ ممّا يكتبُ الملكانِ","خَلِيليَّ عوجا اليومَ وانْتَظِرا غدا"],["C390F2B9-221C-5655-AB14-199644B0FC0E","علينا قليلاً إنّنا غرضانِ","وإنّنا غداً باليومِ رهنٌ وإنّما"],["D8E81D27-1D97-5D48-8B9A-8AE101DFD173","مَسِيرُ غدٍ كاليومِ أَوْ تَريَانِ","إذَا رُمْتُ هِجْراناً لها حالَ دونَه"],["B7190D1E-349C-51CB-80E4-9EAE771A8BFE","حجابانِ في الأحشاءِ مؤتلفانِ",""]]},"DE698DE9-5B43-5631-B557-376893CEDD1E":{"t":"منْ كانَ منْ أخواتي باكياً أبداً","p":46,"s":"من كان من أخواتي باكيا أبدا","r":"440152","v":[["2BBC3CC7-D0FA-5A2A-8FE8-42D2A119F907","منْ كانَ منْ أخواتي باكياً أبداً","فَاليومَ إنِّي أَرانِي اليومَ مَقْبُوضاً"],["E139EA15-0C0E-5F40-9F50-DCFC066BC87F","يسمعننيهِ فإنّي غيرُ سامعهِ","إذَا عَلَوْتُ رِقابَ القوم مَعْروضاً"]]},"04801716-AC51-58D7-9A86-B3D8B569CD29":{"t":"نَذودُ بِذِكْرِ الله عَنَّا مِنَ السُّرى","p":46,"s":"نذود بذكر الله عنا من السرى","r":"440157","v":[["9E7EEEFD-3F26-5620-BC28-FB87E674B87F","نَذودُ بِذِكْرِ الله عَنَّا مِنَ السُّرى","إذا كانَ قلبانا بنا يجفانِ"]]},"E5BC2BFB-B917-550C-BC10-256E92CE59A0":{"t":"وأحبسُ عنكِ النّفسَ والنّفسُ صبّةٌ","p":46,"s":"وأحبس عنك النفس والنفس صبة","r":"440148","v":[["16AAD3EA-B3D8-5A08-8901-D04DAA344B75","وأحبسُ عنكِ النّفسَ والنّفسُ صبّةٌ","بِذِكْراكَ وَالممشى إلَيكَ قَريبُ"],["4B17DEC0-603A-546D-8FD2-091AAC35E216","مخافةَ أن يسعى الوشاةُ بظنّةٍ","وَأَحْرسُكُمْ أَنْ يِسْتريب مُرِيبُ"]]},"678C45FE-165D-53BF-BCA6-FC80803150A9":{"t":"وإنّي لتعروني لذكراكِ رعدةٌ","p":46,"s":"وإني لتعروني لذكراك رعدة","r":"440147","v":[["49BBBCB5-CFEC-5C13-BD70-2F38B3CCE137","وإنّي لتعروني لذكراكِ رعدةٌ","لها بين جسمي والعظامِ دبيبُ"],["14AC02A9-01DB-54E9-9CEE-DAEEF1D7AE13","وما هوَ إلاّ أن أراها فجاءةً","فَأُبْهَتُ حتى مَا أَكَادُ أُجِيبُ"],["488F80EE-E61C-55CC-9A72-835300D99869","وأُصرفُ عن رأيي الّذي كنتُ أرتئي","وأَنْسى الّذي حُدِّثْتُ ثُمَّ تَغِيبُ"],["9CA4440F-099C-5F8B-AE6E-3AD114F0641B","وَيُظْهِرُ قَلْبِي عُذْرَهَا وَيُعينها","عَلَيَّ فَمَا لِي فِي الفُؤاد نَصِيبُ"],["7CE63885-9AA9-54DD-9065-D76FA7712AD9","وقدْ علمتْ نفسي مكانَ شفائها","قَرِيباً وهل ما لا يُنَال قَرِيبُ"],["95A07B0A-F801-5191-8FA5-3F7A4A76F130","حَلَفْتُ بِرَكْبِ الرّاكعين لِرَبِّهِمْ","خشوعاً وفوقَ الرّاكعينَ رقيبُ"],["A3582D97-CCAA-5EB0-AF2F-10527BE16ADB","لئنْ كانَ بردُ الماءِ عطشانَ صادياً","إليَّ حبيباً، إنّها لحبيبُ"],["E973D9ED-33C9-52B2-8D4A-0EAF66CC475D","وَقُلْتُ لِعَرَّافِ اليَمَامَةِ داونِي","فَإنَّكَ إنْ أَبْرَأْتَنِي لَطَبِيبُ"],["731F1C09-E02E-51F3-AA09-5D192ABFC443","فما بي من سقمٍ ولا طيفِ جنّةٍ","ولكنَّ عَمِّي الحِمْيَريَّ كَذُوبُ"],["3FAC22DE-AB39-5075-B4DB-2F2BB9244351","عشيّةَ لا عفراءُ دانٍ ضرارها","فَتُرْجَى ولا عفراءُ مِنْكَ قَريبُ"],["2DFEA393-662C-514A-B47C-44FF7A92E3C7","فلستُ برائي الشّمسِ إلا ذكرتها","وآلَ إليَّ منْ هواكِ نصيبُ"],["0E63E494-7AF1-585A-A1B4-FFE65D4CF4CB","ولا تُذكَرُ الأَهْواءُ إلاّ ذكرتُها","ولا البُخْلُ إلاّ قُلْتُ سوف تُثِيبُ"],["E45AD924-CD73-5C35-98F4-0998CBAAA041","وآخرُ عهدي منْ عفيراءَ أنّها","تُدِيرِ بَنَاناً كُلَّهُنَّ خَضيبُ"],["41746471-0348-582D-95D2-43BB54D65A0E","عشيّةَ لا أقضي لنفسي حاجةً","ولم أدرِ إنْ نوديتُ كيفَ أجيبُ"],["5BDD044B-6835-57E2-9D15-5894A6D09AA4","عشيّة لا خلفي مكرٌّ ولا الهوى","أَمَامي ولا يَهْوى هَوايَ غَرِيبُ"],["2CFE04E7-D4C6-5B05-9393-11D5AEBD6679","فواللهِ لا أنساكِ ما هبّتِ الصّبا","وما غقبتها في الرّياحِ جنوبُ"],["80CC041F-332F-5592-A2F6-714E4AAE7B7B","فَوَا كَبِدًا أَمْسَتْ رُفَاتاً كَأَنَّمَا","يُلَذِّعُهَا بِالمَوْقِدَاتِ طَبِيبُ"],["671BE0A7-0693-54B2-9F0C-BC2F8C6DBED5","بِنَا من جَوى الأَحْزَانِ فِي الصّدْرِ لَوْعَةٌ","تكادُ لها نفس الشّفيقِ تذوبُ"],["796F73EE-87D0-58ED-A963-CFD87CD495DC","ولكنَّما أَبْقَى حُشَاشَةَ مُقْولٍ","على ما بِهِ عُودٌ هناك صليبُ"],["78BCC291-241B-5532-8C55-EAB90E4C2458","وما عَجَبِي مَوْتُ المُحِبِّينَ في الهوى","ولكنْ بقاءُ العاشقينَ عجيبُ"]]},"EED631AD-FB3E-5726-9AC7-ACACAAD146D1":{"t":"وكم مِن كرِيمٍ قد أَضَرَّ بِهِ الهوى","p":46,"s":"وكم من كريم قد أضر به الهوى","r":"440150","v":[["8DBB092F-5376-513F-90DA-7181B27DF0A5","وكم مِن كرِيمٍ قد أَضَرَّ بِهِ الهوى","فَعَوَّدَه ما لمْ يَكُن يَتَعَوَّدُ"]]},"D0FEA8AA-79AD-59BF-98AF-CF4B0C02B880":{"t":"يا عفرُ إنَّ الحيَّ قد نقضوا","p":46,"s":"يا عفر إن الحي قد نقضوا","r":"440151","v":[["AAA4F03A-D2F6-5D74-8D4F-59C3BCFDF941","يا عفرُ إنَّ الحيَّ قد نقضوا","عهدَ الإلهِ وحاولوا الغدرا"]]},"6A00AC65-5DFA-5691-BC24-E2934A6ECB83":{"t":"يطالبني عمّي ثمانينَ ناقةً","p":46,"s":"يطالبني عمي ثمانين ناقة","r":"440159","v":[["989C219C-789A-5248-9703-D52D64FEA2F5","يطالبني عمّي ثمانينَ ناقةً","وما لي يا عفراءُ إلّا ثمانيا"]]}}}