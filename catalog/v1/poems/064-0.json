{"v":1,"poems":{"E846971B-4282-57CB-9C29-A8E4A60A6ECB":{"t":"أبـا مُعْرِضٍ كُنْ أنْتَ إنْ مُتُّ دافني","p":64,"s":"أبـا معرض كن أنت إن مت دافني","r":"438588","v":[["6C199212-39BA-54D5-ABBE-1A8C49677E59","أبـا مُعْرِضٍ كُنْ أنْتَ إنْ مُتُّ دافني","إلى جَنْبِ قَبْرٍ فيه شِلْوُ المُضَلَّلِ"],["7A3CD74E-0F44-5584-854E-E6F5A9A1FA7F","فَعَلِّيَ أنْ أنْجُو مِنَ النَّارِ إنَّها","تُضَرَّمُ لِلْعَبْدِ اللَّئيمِ المُبَخَّلِ"],["6DFA8C28-FD48-520E-B214-D384CC6F8184","بِذلِكَ أوْصَاها الإلهُ وَلَمْ تَزَلْ","تُحَشُّ بأوصالٍ وَتُرْبٍ وَجَنْدَلِ"],["56576AA0-E648-53A3-A075-74EEAC8EA06D","وَأَنْتَ بِحَمْدِ الله إنْ شِئْتَ مُفْلِتي","بِحَزْمِكَ فاحْزُمْ يـا أُقَيْشِرُ وَآعْجَلِ"]]},"DB45F1A1-C19D-5497-B3CD-3A58FC0D3053":{"t":"أَبني تَمِيمٍ مَا لِمِنْبَرِ مُلْكِكُمْ","p":64,"s":"أبني تميم ما لمنبر ملككم","r":"438564","v":[["CDEB7B09-C35A-5A28-975C-DA4910DA4959","أَبني تَمِيمٍ مَا لِمِنْبَرِ مُلْكِكُمْ","لاَ يَسْتَقِرُّ قَرَارُهُ يَتَمَرْمَرُ"],["7DD23E65-5D8B-56CA-AB60-453BEDCEE4AA","إنَّ المنابِرَ أَنْكَرَتْ أَسْتَاهَكُمْ","فادْعُوا خُزَيْمَةَ يَسْتَقِرَّ المِنْبَرُ"],["194EAD99-09A0-594E-93C2-CAA97A1C8F90","خَلَعُوا أمِيرَ المُؤْمِنِينَ وَبَايَعُوا","مَطَراً لَعَمْرُكَ بَيْعَةٌ لاَ تَظْهَرُ"],["CCD1EE7D-0125-550A-AE6F-5AF5B20710EA","وَاسْتَخْلَفُوا مَطَراً فَكَانَ كَقَائِلٍ:","«بَدَلٌ لَعَمْرُكَ مِنْ يَزِيدٍ أَعْوَرُ»"]]},"2533AB15-5F2A-51C0-8BDB-3D25F34B163B":{"t":"أَبْلِغْ أَبـا مَرْوَانَ أَنَّ عَطَاءه","p":64,"s":"أبلغ أبـا مروان أن عطاءه","r":"438586","v":[["5FC5D01F-9D51-5607-AF77-FB696424BF0B","أَبْلِغْ أَبـا مَرْوَانَ أَنَّ عَطَاءه","أَزَاغَ بِهِ مَنْ لَيْسَ لِي بِعِيالِ"]]},"E6D102C6-78E2-593E-B8B1-6DD0B7EDE687":{"t":"أَتَدْعُوني الأُقَيْشِرَ ذَلِكَ اسْمِي","p":64,"s":"أتدعوني الأقيشر ذلك اسمي","r":"438552","v":[["457A3C1E-7304-5912-AA5B-34861FDFCC6F","أَتَدْعُوني الأُقَيْشِرَ ذَلِكَ اسْمِي","وَأَدْعُوكَ ابْنَ مُطْفِئَةِ السِّرَاجِ"],["2F0D533E-B6C6-5140-9F80-93BEF504373E","تُناجِي خِدْنَهَا باللَّيْلِ سِرّاً","وَرَبُّ النَّاسِ يَعْلَمُ مَا تُنَاجِي"]]},"6E96D1A7-156F-56D7-992E-48C12AA8BAA5":{"t":"أَقُولُ وَالكَأْسُ فِي كَفِّي أُقَلِّبُها","p":64,"s":"أقول والكأس في كفي أقلبها","r":"438581","v":[["B29BEA2A-5943-5E89-A503-EBDEDED267BD","أَقُولُ وَالكَأْسُ فِي كَفِّي أُقَلِّبُها","أُخَاطِبُ الصِّيدَ أَبْناءَ العمالِيقِ"],["BBBDADCB-8144-5880-9649-5D959DBD6FE4","إنّي يُذَكرُنِي هِنْداً وَجَارَتَها","بِالطَّفِّ صَوْتُ حَمَامَاتٍ عَلَى نِيقِ"],["1B8C2346-5489-5B4D-A034-24DCE6428E83","أَفْنَى تِلاَدِي وَمَا جَمَّعْتُ مِنْ نَشَبٍ","قَرْعُ القَوَاقِيزِ أفْوَاهَ الأَبَارِيقِ"],["41CB76C5-4764-5035-A17B-3A54BEA78A01","كأَنَّهُنَّ وأيْدِي الشَّرْب مُعْمَلَةٌ","إذَا تَلأْلأْنَ فِي أيْدِي الغَرَانِيقِ"],["49A0A6BB-ECD7-5064-ACE5-0E82FFD79F91","بَنَاتُ مَاءٍ مَعاً بِيضٌ جَآجِئُهَا","حُمْرٌ مَنَاقِيرُها صُفْرُ الحَمَالِيقِ"],["68C97D7B-543A-513D-87DF-3C2629D2A2C1","أَيْدِي سُقاةٍ تَخِزُّ الأَرْضَ مُعْمَلَةً","كَأَنَّما أَوْبُها رَجْعُ المَخَارِيقِ"],["4CCCC6CF-47AA-5CBE-97D0-9359A9454F15","هِيَ اللَّذَاذَةُ مَا لَمْ تَأْتِ مَنْقَصَةً","أوْ تَرْمِ فِيهَا بِسَهْمٍ سَاقِطِ الفُوقِ"],["F07B3EC8-0488-5844-BD4C-8DF693BCBAAF","عَلَيْكَ كُلُّ فَتًى سَمْحٍ خَلاَئِقُهُ","مَحْضِ العُرُوقِ كَرِيمٍ غَيْرِ مَمْذُوقِ"],["E5C77E44-468A-5FF9-81B5-4F5C4435437B","وَلاَ تُصَاحِبْ لَئِيماً فِيهِ مَفْرَقَةٌ","وَلاَ تَزُورَنَّ أصْحَابَ الدَّوَانِيقِ"],["BA88B7DA-964F-5507-9247-B083F2F4E7A1","لاَ تَشْرَبَنْ أَبَداً رَاحاً مُسارَقَةً","إلاّ مَعَ الغُرِّ أَبْنَاءِ البَطَارِيقِ"]]},"D052BEF8-0EDB-58BC-8176-BADBF2FA5E84":{"t":"أَلاَ أَبْلِغْ لَدَيْكَ أَبَـا هِشَامٍ","p":64,"s":"ألا أبلغ لديك أبـا هشام","r":"438584","v":[["688E8B1C-CEF2-5154-B61A-5752C2227125","أَلاَ أَبْلِغْ لَدَيْكَ أَبَـا هِشَامٍ","فَإِنَّ الرِّيحَ أَبْرَدُها الشَّمَالُ"],["DFE0AA0F-DEF1-5959-986D-C9B29669DB7A","عِدَاتُكَ فِي الهِلاَلِ عِدَاتُ صِدْقٍ","فَهَلْ سَمِنَتْ كَمَا سَمِنَ الهِلاَلُ"]]},"B4DB8C46-C5E4-533C-BF16-2EA74A896FCC":{"t":"أَلاَ يَا دَوْمُ دَامَ لَكِ النَّعِيمُ","p":64,"s":"ألا يا دوم دام لك النعيم","r":"438592","v":[["AC282F93-1422-5D1B-9F2D-8ADF4F4EC29C","أَلاَ يَا دَوْمُ دَامَ لَكِ النَّعِيمُ","وأسْمَرُ مِلْءُ كَفِّكِ مُسْتَقِيمُ"],["952C84D2-F53E-5AF7-81EC-92B03A8FAA8B","شَدِيدُ الأسْرِ يَنْبِض حَالِبَاهُ","يُحَمُّ كَأنَّهُ رَجُلٌ سَقِيمُ"],["1B738230-6F5B-5D31-B9A7-EC3670DCC967","يُرَوِّيهِ الشَّرَابُ فَيَزْدَهِيهِ","وَيَنْفُخُ فِيهِ شَيْطَانٌ رَجِيمُ"]]},"1E197D5F-DE87-54BD-8E0D-EB5EF4680C6F":{"t":"أَلَمْ تَرَ قَيْسَ الأكْمَهَ بْنَ مُحَمَّدٍ","p":64,"s":"ألم تر قيس الأكمه بن محمد","r":"438585","v":[["2E7B1085-6078-55E5-896D-93FE0738E729","أَلَمْ تَرَ قَيْسَ الأكْمَهَ بْنَ مُحَمَّدٍ","يَقُولُ وَلاَ تَلْقَاهُ لِلْخَيْرِ يَفْعَلُ"],["2DF6FDCF-7A19-54E2-ABA9-DB9108C98AED","رَأَيْتُكَ أعْمَى العَيْنِ والقَلْبِ مُمْسِكا","وَمَاخَيْرُ أعْمَى القَلْبِ وَالعَيْنِ يَبْخَلُ"],["D6E79989-5349-590A-83B2-15CF12F26020","فَلَوْ صُمَّ تَمَّتْ لَعْنَةُ اللَّهِ كُلُّها","عَلَيْهِ وَمَا فِيهِ مِنَ الشَّرِّ أفْضَلُ"]]},"CBA9E2C5-8A24-5D73-88F3-D0EF783B1AD7":{"t":"أَيَا صَاحِبِي أَبْشِرْ بِزَوْرَتِنَا الحِمَى","p":64,"s":"أيا صاحبي أبشر بزورتنا الحمى","r":"438556","v":[["01BFF531-83F3-55BE-8599-D5FF4AED490C","أَيَا صَاحِبِي أَبْشِرْ بِزَوْرَتِنَا الحِمَى","وَأَهْلُ الحِمَى مِنْ مُبْغضٍ وَوَدُودِ"],["6799251D-89CE-561D-9867-4EDF6D0FDA2F","قَدِ اخْتَلَجَتْ عَيْنِي فَدَلَّ اخْتِلاَجُهَا","عَلَى حُسْنٍ وَصْلٍ بَعْدَ قُبْحِ صُدُودِ"]]},"8DF53491-7E86-5258-8A4E-FF6187A95DBA":{"t":"إذِا صَلَّيْتُ خُمْساً كُلَّ يَوْمٍ","p":64,"s":"إذا صليت خمسا كل يوم","r":"438579","v":[["1015656C-181C-564D-8A79-553F267911C0","إذِا صَلَّيْتُ خُمْساً كُلَّ يَوْمٍ","فَإنَّ اللَّهَ يَغْفِرُ لِي فُسُوقِي"],["8D73C70B-8B66-5FB5-A058-BFEFC7B4F925","وَلَمْ أُشْرِكْ بِرَبِّ النَّاسِ شَيْئاً","فَقَدْ أَمْسَكْتُ بالحَبْلِ الوَثِيقِ"],["5733F85A-FF0B-5927-A2F0-DE139BEFE18D","وَهَذَا الحَقُّ لَيْسَ بِهِ خَفَاءٌ","فَدَعْنِي مِنْ بُنَيَّاتِ الطَّرِيقِ"]]},"FCFEC4DD-BE73-5C92-BB12-9ED701990C58":{"t":"إنَّمَا لِقْحَتُنَا بَاطِيَةٌ","p":64,"s":"إنما لقحتنا باطية","r":"438546","v":[["160C9ADD-384D-5729-AFED-82B8065E1C73","إنَّمَا لِقْحَتُنَا بَاطِيَةٌ","فإذا ما مُزِجَتْ كَانَتْ عَجَبْ"],["E1B894EA-6673-555B-A8C7-9E86E323642C","لَبَنٌ أصْفَرُ صَافٍ لَوْنُهُ","يَنْزَعُ البَاسُورَ مِنْ عَجْبِ الذَّنَبْ"],["81CAC8E8-0423-5828-A2C0-A729668DF63E","سَأَلَ الشُّرْطِيُّ أَنْ نَسْقِيَهُ","فَسَقَيْنَاهُ بأُنْبُوبِ القَصَبْ"],["E4960D3D-07C8-5600-AB7D-8635597817E4","إِنَّمَا نَشْرَبُ مِنْ أَمْوَالِنَا","فَسَلُوا الشُّرْطِيَّ ما هذا الغَضَبْ"]]},"CA29CE57-B7DF-5F72-A4FB-24F0C544ED85":{"t":"إنْ كَانَتِ الخَمْرُ قَدْ عَزَّتْ وَقَدْ مُنِعَتْ","p":64,"s":"إن كانت الخمر قد عزت وقد منعت","r":"438551","v":[["33BB2CBF-BD8D-55DC-9588-73970F78C12B","إنْ كَانَتِ الخَمْرُ قَدْ عَزَّتْ وَقَدْ مُنِعَتْ","وَحَالَ مِنْ دُونِهَا الإسْلاَمُ والحَرَجُ"],["49AA7F12-AF34-5540-8950-1BEAF7F924A8","فَقَدْ أُبَاكِرُهَا صِرْفاً وَأَشْرَبُهَا","أَشْفِي بِهَا غُلَّتِي صِرْفاً وأَمْتَزِجُ"],["6FE3B3F9-B422-5FD4-9165-8776EE84A2E0","وَقَدْ تَقُومُ عَلَى رَأسِي مُغَنِّيَةٌ","لَهَا إذَا رَجَّعَتْ فِي صَوْتِهَا غَنَجُ"],["317C60EB-FDE8-5FE4-B654-D38F5EAAF820","وَتَرْفَعُ الصَّوْتَ أحْيَاناً وَتَخْفِضُهُ","كَمَا يَطِنُّ ذُبَابُ الرَّوْضَةِ الهَزِجُ"]]},"3D3C1ED7-F10B-5552-8B8B-C5AFB994085F":{"t":"إِمَّا تَرَانِي قَدْ هَلَكْتُ فَإنَّما","p":64,"s":"إما تراني قد هلكت فإنما","r":"438557","v":[["4C22470F-A0DE-5B2E-BF54-6C16C569D9B1","إِمَّا تَرَانِي قَدْ هَلَكْتُ فَإنَّما","رَمَضَانُ أَهْلَكَنِي وَدِينُ أُسَيْدِ"],["ABE918B7-A29E-5951-98DB-0379D08F35A5","هذَا يُصَرِّدُني فَلَستُ بِشَاربٍ","وَأخٌ يُؤَرِّقُني مَعَ التَّصْرِيدِ"]]},"73548A14-A48E-5BFF-9BFB-58CB735DC3CB":{"t":"إِنّي أَتَانِي مَقَالٌ كُنْتُ آمِنُهُ","p":64,"s":"إني أتاني مقال كنت آمنه","r":"438577","v":[["F0612662-7FE6-5992-81A6-DB9BBBF6FEE6","إِنّي أَتَانِي مَقَالٌ كُنْتُ آمِنُهُ","فَجَاءَ مِنْ فَاحِشٍ فِي الناس مَخْلُوعِ"],["E7B67EE4-2C34-510F-802C-5019677A4059","عَبْدُ العَزِيزِ أبُو الضَّحَّاكِ كُنْيَتُهُ","فِيهِ مِنَ اللُّؤْمِ وَهْيٌ غَيْرُ مَمْنُوعِ"],["0C838413-1F53-5682-828F-D2A8F99D921F","وِلَمْ تَبِتْ أمُّهُ إلاَّ مُطَاحِنَةً","وَأنْ تُواجِرَ فِي سُوقِ المَرَاضِيعِ"],["77F26CE0-3EEA-50FE-8508-801E7E1BD24D","يَنْسَابُ مَاءُ البَرَايَا فِي کسْتِها سَرِباً","كَأَنَّمَا انْسَابَ فِي بَعْضِ البَلاَليعِ"],["0E05EA8B-896E-5002-AC91-8523F63CB17A","مِنْ ثَمَّ جَاءَتْ بِهِ وَ البَظْرُ حَنَّكَهُ","كَأَنَّهُ فِي اسْتِها تِمْثَالُ يُسْرُوعِ"]]},"409859B6-06E4-559C-B3F3-47612200E2B7":{"t":"تَقُولُ يَا شَيْخُ أَمَا تَسْتَحِي","p":64,"s":"تقول يا شيخ أما تستحي","r":"438568","v":[["DE263CD5-FAC0-5374-B78E-E134A765C71A","تَقُولُ يَا شَيْخُ أَمَا تَسْتَحِي","مِنْ شُرْبِكَ الخَمُرَ على المَكْبَرِ"],["347A7631-08BB-562F-A60B-B3086B377128","فَقُلْتُ: لَوْ بَاكَرتِ مَشْمُولَةً","صَهْبَا كَلَوْنِ الفَرَسِ الأَشْقَرِ"],["4D3B36B3-1F45-54BF-AB90-69A92E46F781","رُحْتِ وَفِي رِجْلَيْكِ عُقَّالَةٌ","وَقَدْ بَدَا هَنْكِ مِنَ المِئْزَرِ"]]},"AEB3D4D8-0852-51E1-9200-9D99F965D228":{"t":"تَمِيمُ بْنُ مُرَّ كَفْكِفُوا عَنْ تَعَمُّدِي","p":64,"s":"تميم بن مر كفكفوا عن تعمدي","r":"438589","v":[["8279E4E5-42E3-5B80-9D18-78479958D00B","تَمِيمُ بْنُ مُرَّ كَفْكِفُوا عَنْ تَعَمُّدِي","بِذُلٍّ فَإنّي لَسْتُ بِالمُتَذَلِّلِ"],["27754E4C-5383-560B-8246-81732E6D755C","أَيَهْزَأُ بِي العَبْدُ الهُجَيْمِيُّ ضِلَّةً","وَمِثْلِي رَمَى ذَا التُّدْرَإِ المُتَضَلِّلِ"],["0FAF94E8-A30D-5BB1-81D9-63AE4CB1A595","بِدَاهِيَةٍ دَهْيَاءَ لاَ يَسْتَطِيعُهَا","شَمَارِيخُ مِنْ أرْكَانِ سَلْمَى وَيَذْبُلِ"],["EBBD257F-D4B2-5B5D-ADCE-0A08C2DB47C1","وَبِاللَّهِ لَوْلاَ أنَّ حِلمِيَ زَاجِرِي","تَرَكْتُ تَمِيماً ضُحْكَةً كُلَّ مَحْفَلِ"],["8E03E0AC-12DC-5EE2-8D87-D7D43282EB91","فَكُفُّوا رَمَاكُمْ ذُو الجَلاَلِ بِخِزْيَةٍ","تُصَبِّحُكُمْ فِي كُلِّ جَمْعٍ وَمَنْزِلِ"],["30DC2F9D-31CD-5FE5-B260-D68761149174","فَأَنْتُمْ لِئَامُ النَّاسِ لاَ تُنْكِرُونَهُ","وَأَلأَمُكُمْ طُرّاً حُرَيْثُ بْنُ جَنْدَلِ"]]},"D60F5D9B-DCC1-533F-854B-3ADAC154A99F":{"t":"تُرِيْكَ القَذَى مِنْ دُوْنِهَا وَهْيَ دُوْنَهُ","p":64,"s":"تريك القذى من دونها وهي دونه","r":"438549","v":[["E335F261-38A6-545A-91E9-C2DF4744B700","تُرِيْكَ القَذَى مِنْ دُوْنِهَا وَهْيَ دُوْنَهُ","لِوَجْهِ أَخِيْهَا فِي الإِنَاءِ قُطُوْبُ"],["46EAA915-814F-5A3F-B89A-5ECD52A14961","كُمَيْتٌ إذَا شُجَّتْ وَفِي الكَأْسِ وَرْدَةٌ","لَهَا فِي عِظَامِ الشَّارِبِينَ دَبِيبُ"]]},"018AC83C-D403-5077-A8CB-F76EF6636815":{"t":"جَرَيْتُ مَعَ الصِّبَا طَلْقَ العَتِيقِ","p":64,"s":"جريت مع الصبا طلق العتيق","r":"438580","v":[["62D62D9D-5779-5C9B-B155-3BE8096CE804","جَرَيْتُ مَعَ الصِّبَا طَلْقَ العَتِيقِ","وَهَانَ عَلَيَّ مَأْثُورُ الفُسُوقِ"],["7FEBF569-2AA1-5202-85E1-50B075BF4A9C","وَجَدتُ أَلَذَّ عَارِيَةِ اللَّيالِي","قِرَانَ النَّغْمِ بالوَتَرِ الخَفُوقِ"],["86A61869-F5DC-5A41-888E-FBA73A5356A4","وَمُسمِعَةً إذَا مَا شِئْتُ غَنَّتْ","مَتَى نَزَلَ الأحِبَّةُ بالعَقِيقِ"]]},"60A2919B-9D5C-520A-A498-27305C22E2B2":{"t":"حَضْرَمَوتٌ فَتَّشَتْ أَحْسَابَنَا","p":64,"s":"حضرموت فتشت أحسابنا","r":"438547","v":[["285E756E-D331-54ED-B5C5-C5A9DCD1AA99","حَضْرَمَوتٌ فَتَّشَتْ أَحْسَابَنَا","وَإلَيْنَا حَضْرَمَوْتٌ تَنْنَسِبْ"],["2173E525-DE64-5CB4-910B-B9DEF7C55FFE","إخْوَةُ القِرْدِ وَهُمْ أَعْمَامُهُ","بَرِئَتْ مِنْكُمْ إلى اللَّهِ العَرَبْ"]]},"8964F8B2-EA99-5D7D-B1F0-3E2AB431D77B":{"t":"خَرَجْتُ مِنَ المِصْرِ الحَوَارِيِّ أهْلُهُ","p":64,"s":"خرجت من المصر الحواري أهله","r":"438587","v":[["5A1837F5-877B-5F4B-9BAC-EEF6A8B57980","خَرَجْتُ مِنَ المِصْرِ الحَوَارِيِّ أهْلُهُ","بِلاَ نُدْبَةٍ فِيهَا کحْتِسَابٌ وَلاَ جُعْلِ"],["7018C5A2-E277-54A3-986D-11D668756DB9","إلى جَيْشِ أهْلِ الشَّامِ أُغْزِيتُ كَارِهاً","سَفَاهاً بلا سَيْفٍ حَدِيدٍ وَلاَ نَبْلِ"],["48353D5D-17BC-5FCD-AF73-87A3628B5098","وَلكِنْ بِتُرْسٍ لَيْسَ فِيهَا حَمَالَةٌ","وَرُمْحٍ ضَعِيفِ الزُّجِّ مُنْصَدِعِ النَّصْلِ"],["06FF90B9-752E-5C4B-AD9B-A8D2F93B66E6","حَبَانِي بِهَا ظُلْمُ القُبَاعِ وَلَمْ أجِدْ","سِوَى أمْرِهِ والسَّيْرِ شَيئاً مِنَ الفِعْلِ"],["E62AB0F0-2E3B-508B-AD2F-5A85F5CF1735","فَأَزْمَعْتُ أمْري ثُمَّ أصبَحْتُ غَازِياً","وَسَلَّمْتُ تَسْلِيمَ الغُزَاةِ عَلَى أهْلِي"],["5CEF5711-860E-524B-89B8-C8A59F0F244B","وَقُلْتُ لَعَلِّي أنْ أرَى ثَمَّ رَاكباً","عَلَى فَرَسٍ أو ذا مَتَاعٍ عَلَى بَغْلِ"],["9039531D-933B-55AB-BE21-FFAFE24AB4BC","جَوَادِي حِمَارٌ كَانَ حِيناً بظَهْرِهِ","إكافٌ وإشْنَاقُ الَزَادَةِ وَالحَبْلِ"],["96E17043-6B36-5B99-B274-BE48A5F739A6","وَقَدْ خَانَ عَيْنَهِ بَيَاضٌ وَخَانَةُ","قَوَائِمُ سَوءٍ حِينَ يُزْجَرُ فِي الوَحْلِ"],["9959648D-37B0-5B77-AB88-811DB84ECA3F","إِذَا مَا کنْتَحَى فِي المَاءِ وَالوَحْلِ لَمْ تَرِمْ","قَوَائِمُهُ حَتَّى يُؤَخَّرَ بِالحَمْلِ"],["26036519-63A5-5DCD-AEDC-A887BCCEFAAA","أُنَادِي الرَّفَاقَ:بَارَكَ الَّلهُ فِيكُمُ","رُوَيْدَكُمُ حَتَّى أجُوزَ إلَى السَّهْلِ"],["42661EED-776A-52A5-B82E-6B9100DE9B36","فَسِرْنَا إلَى قِنِّينَ يَوْماً ولَيْلَةً","كَأَنَّا بَغَايَا مَا يَسِرْنَ إلَى بَعْلِ"],["A4CA6288-8DA6-5A4A-9993-33F40414B18A","إِذَا مَا نَزَلْنَا لَمْ نَجِدْ ظِلَّ سَاحَةٍ","سِوَى يَابِسِ الأنْهَارِ أو سَعَفِ النَّخْلِ"],["6A980CF1-7E01-55F4-9A6B-F0139147059E","مَرَرْنَا عَلَى سُورَاءَ نَسْمَعُ جِسْرَهَا","يَئِطُّ نَقيضاً عَنْ سَفَائِنِهِ الفُضْلِ"],["29EE21A3-C499-55B1-A160-398165A4D20B","فَلَمّا بَدَا جِسْرُ السَّرَاةِ وَأَعْرَضَتْ","لَنَا سُوقُ فُرَّاغَ الحَدِيثِ إلى شُغْلِ"],["5BCCD820-989D-5DE1-9B86-10800B5B945D","نَزَلْنَا إلَى ظِلٍّ ظَليلٍ وَبَاءَةٍ","حَلاَلٍ بِرَغْمِ القَلْطَمَانِ وَمَا نَغْلِ"],["D28ECC93-95CF-59A3-BD05-3CD4DBD988F3","بِشَارِطَةٍ مَنْ شَاءَ كَانَ بِدِرْهَمٍ","عَرُوساً بِمَا بَيْنَ السَّبِيئَةِ والنَّسْلِ"],["22C8C2C8-5843-59AD-8257-9D8BDA262B88","فَأَتْبَعْتُ رُمْحَ السُّوءِ سُمْيَةَ نَصْلِهِ","وَبِعْتُ حِمَارِي وَکسْتَرَحْتُ مِنَ الثِّقْلِ"],["4B2D5EFF-9170-500E-9D10-77265C5E3999","تَقُولُ ظَبَايَا:قُلْ قَلِيلاً ألاَ لِيَا","فَقُلْتُ لها:أصْوِي فإنّي على رِسْلِ"],["674A2F92-F817-5445-8C18-F04D1BD8A8B7","مَهَرْتُ لَهَا جِرْدِيقَةً فَتَرَكْتُهَا","بِمَرْهَا كَطَرْفِ العَيْنِ شَائِلَةَ الرِّجْلِ"]]},"C2D5DC8A-8CAF-51A6-BDDF-4636D13E6A48":{"t":"رُبَّ نَدْمانٍ كَرِيمٍ مَاجدٍ","p":64,"s":"رب ندمان كريم ماجد","r":"438558","v":[["A2905490-EF09-56A0-A504-92F8738444D8","رُبَّ نَدْمانٍ كَرِيمٍ مَاجدٍ","سَيِّدِ الجَدَّيْنِ مِنْ فَرْعَيْ مُضَرْ"],["6FF913A0-5EF3-58BA-9023-611A8AC2AF2D","قّدْ سَقَيْتُ الكَأْسَ حَتَّى هَرَّهَا","لَم يُخَالِطْ صَفْوَهَا مِنْهُ كَدَرْ"],["ACB4110F-1B29-57C3-8E65-CF6C0E37E664","قُلْتُ: قُمْ صَلِّ، فَصَلَّى قَاعِداً","تَتَغَشَّاهُ سَمَادِيرُ السَّكَرْ"],["3D7D9655-A07C-554D-ADCD-3FC228C426A9","قَرَنَ الظُّهْرَ مَعَ العَصْرِ كَمَا","تُقْرَنُ الحِقَّةُ بالحِقَّ الذَّكَرْ"],["4211BCBA-1337-502E-B28C-2508E79473A0","تَرَكَ «الفَجْرَ» فَمَا يَقْرَأُهَا","وَقَرا \"الكَوْثَرَ\" مِنْ بيْنِ السُّوَرْ"]]},"0C21F0FA-37D7-5C59-8B6B-E63F9ACDE1C2":{"t":"سَأََلْتُ رَبِيعَةَ مَنْ شَرُّها","p":64,"s":"سألت ربيعة من شرها","r":"438591","v":[["46FF5C67-4AF5-594E-B924-CA9E82EEADA9","سَأََلْتُ رَبِيعَةَ مَنْ شَرُّها","أَباً ثُمَّ أُمَّاً فَقَالُوا: لِمَهْ"],["AAC94317-EFC0-5D73-8C58-55B82957994B","فَقُلْتُ:لأَعْلَمَ مَنْ شَرُّكُمْ","وَ أَجْعَلَ بالَّسبَّ فِيِه السِّمهْ"],["0BAB6B81-B19A-5A9C-9C46-FD2903C2D45F","فَقَالُوا: لِعِكْرِمَةَ المُخْزِيَاتُ","وَمَاذَا يَرَى النَّاسُ فِي عِكْرِمَهْ"],["B2A6553A-E593-59A9-8693-1D667F0C87AF","فَإنْ يَكُ عَبْداً زَكَا مَالُهُ","فَمَا غَيْرُ ذَا فِيهِ مِنْ مَكْرُمَهْ"]]},"C5FE00BF-EF34-5E3A-B1D8-F2F50C7A00B5":{"t":"سَالَنِي النَّاسُ: أيْنَ يَعْمِدُ هذا؟","p":64,"s":"سالني الناس: أين يعمد هذا؟","r":"438597","v":[["71C9C441-1F22-5A6D-A30E-535CC74C0CC0","سَالَنِي النَّاسُ: أيْنَ يَعْمِدُ هذا؟","قُلْتُ: آتي في الدَّارِ قَرْماً سَرِيّا"],["B32572B1-6535-5092-A7C1-688891239BBE","ما قَطَعْتُ البِلاَدَ أسْرِي ولا يَمَّمْـ","ـتُ إلاّ إيّاكَ يَا زَكَرِيّا"],["DC3AEF21-6065-596B-A4D1-43FB1381C995","كَمْ عَطَاءٍ وَنَائلٍ وَجَزِيلٍ","كَانَ لِي منكم هَنِيّاً مَرِيّا"]]},"06152940-4A1F-52BF-B24B-AF4330ED4848":{"t":"سَرِيعٌ إلَى کبْنِ العَمِّ يَلْطِمُ وَجْهَهُ","p":64,"s":"سريع إلى کبن العم يلطم وجهه","r":"438578","v":[["AB9D118D-9A22-535C-B67B-98F91B6E1D11","سَرِيعٌ إلَى کبْنِ العَمِّ يَلْطِمُ وَجْهَهُ","وَلَيُسَ إلَى دَاعِي النَّدَى بِسَريعِ"],["971B74D6-6C94-5430-9F99-3B769E06F186","حَرِيصٌ عَلَى الدُّنُيَا مُضِيعٌ لِدينِهِ","وَلَيْسَ لِمَا فِي بَيْتِهِ بِمُضِيعِ"]]},"E64256D8-B0EB-5AFE-997D-3EA2F70CBEF8":{"t":"عاهَدَتْ زَوْجَهَا وَقَدْ قَالَ إنِّي","p":64,"s":"عاهدت زوجها وقد قال إني","r":"438596","v":[["2EFD1E92-0C29-5B16-9BCE-EE034F744AD5","عاهَدَتْ زَوْجَهَا وَقَدْ قَالَ إنِّي","سَوْفَ أَغْدُو لحاجَتِي وَلِدَيْنِي"],["74B65829-841B-5B76-B78F-7621C5112E6A","فَدَعَتْ كالحِصَانِ أبْيَضَ جِلْداً","وَافِرَ... مُرْسَلَ الخُصْيَتَيْنِ"],["EAE506A5-FD9E-5F9A-BDB0-E117C3F02253","قالَ:مَا أجْرُ ذَا؟-هُدِيتِ-فَقَالَتْ:","سَوْفَ أعْطِيكَ أجْرَهُ مَرَّتَيْنِ"],["C4F57DDB-88A2-53E7-9F49-E41689C1ABC0","فَآبْدَإ الآن بالسِّــفَاحِ فَلَمَّا","سَافَحَتْهُ أرْضَـتْهُ بالأُخْرَبَيْنِ"],["DC247B70-3A23-57F1-B036-20BEEC5D19C6","تَلَّها لِلْجَبِينِ ثُمَّ امْتَطَاهَا","عَالِمَ... أفْحَجَ الحَالِبَيْنِ"],["178B052B-435D-5D26-A687-1810D53ED16B","بَيْنَمَا ذَاكَ مِنْهُمَا وَهْيَ تَحْوِي","ظَهْرَهُ بِالبَنَانِ وَالمِعْصَمَيْنِ"],["D7B24B1A-CB53-5EA4-9052-F9F01730D6BD","جَاءهَا زَوْجُهَا وَقَدْ شَامَ فيهَا","ذَا انْتِصَابٍ مُوَثَّقَ الأخْدَعَيْنِ"],["E2F82D49-BF80-50F0-AD97-5BFD0E25DE12","فَتَأسَّى وقال: وَيْلٌ طَوِيلٌ","لِحُنَيْنٍ مِنْ عَارِ أمِّ حُنَيْنِ"]]},"59C6CE6C-B49D-55B2-888E-4AE17D0E9F7C":{"t":"عَجِبْتُ لِشَاعِرٍ من حَيِّ سُوءٍ","p":64,"s":"عجبت لشاعر من حي سوء","r":"438576","v":[["5E33A0D9-79D7-5BFB-8C83-174CDF50E6B7","عَجِبْتُ لِشَاعِرٍ من حَيِّ سُوءٍ","ضَئِيلِ الجِسْمِ مِبْطَانٍ هَجِينِ"]]},"7D1D30FD-1A88-5E2C-B69E-6CCE58FB298A":{"t":"عَدِمْتُ أَبَا الذَّيَّالِ مِنْ ذِي نَوَالَةٍ","p":64,"s":"عدمت أبا الذيال من ذي نوالة","r":"438562","v":[["6049B856-B791-5E6E-9784-6CE6D7D41104","عَدِمْتُ أَبَا الذَّيَّالِ مِنْ ذِي نَوَالَةٍ","لَهُ فِي بُيُوتِ العَاهِرَاتِ طَريقُ"],["F903A24F-4E02-54D2-9D20-7648DC9AC26B","أَبَا الخَمْرِ عَبَّرْتَ امْرَأً لَيْسَ مُقْلِعاً","وَذَلِكَ رَأْيٌ لَوْ عَلِمْتَ وَثِيقُ"],["CD9CF1ED-A48C-5949-85DF-A755D6119241","سَأَشْرَبُهَا مَا دُمْتُ حَيّاً فَإنْ أمُتْ","فَفِي النَّفْسِ مِنْهَازَفْرَةٌ وَشَهِيقُ"]]},"AA45D537-9C30-56F6-A5C1-14E15875BF55":{"t":"غَضِبَتْ دُودَانُ مِنْ مَسْجِدِنَا","p":64,"s":"غضبت دودان من مسجدنا","r":"438553","v":[["07BA691A-613B-5681-A235-A5B840122EB0","غَضِبَتْ دُودَانُ مِنْ مَسْجِدِنَا","وَبِهِ يَعْرِفُهُمْ كُلُّ أحَدْ"],["A9523EBE-1D92-5062-8E7D-DCB1CC73C0C7","لَوْ هَدَمْنا غُدْوَةً بُنْيَانَهُ","لاَنْمَحَتْ أسْمَاؤُهُمْ طُولَ الأبَدْ"],["017D0191-DFF0-5BBB-A9D0-198FAA2C4338","إسْمُهُمْ فِيهِ وَهُمْ جِيرَانُهُ","وَاسْمُهُ الدَّهْرَ لِعَمْرِو بْنِ أسَدْ"],["02EA19B4-8878-5EA3-86AD-826E6066ED97","كُلَّمَا صَلَّوا قَسَمْنَا أَجْرَهُ","فَلَهَا النِّصْفُ عَلَى كُلِّ جَسَدْ"]]},"8C869F65-130A-5C75-BEE2-E1BAC6E210E0":{"t":"غَلَبَ الصَّبْرُ فکعْتَرَتْنِي هُمُومٌ","p":64,"s":"غلب الصبر فکعترتني هموم","r":"438594","v":[["3F6FED40-98C0-52D4-96E8-1D97785C9B01","غَلَبَ الصَّبْرُ فکعْتَرَتْنِي هُمُومٌ","لِفِراقِ الثِّقَاتِ مِنْ إِخْوَانِي"],["1E324C94-4886-51B0-AA88-D3714B7EA3DD","مَاتَ هذَا وَغَابَ هذَا وَهذَا","دَائِبٌ فِي تِلاَوَةِ القُرآنِ"],["119A588A-B309-5D1C-80F7-302E3620B3CF","وَلَقَدْ كَانَ قَبلَ إِظهاَرِهِ النُّسْكَ","قَدِيماً مِنْ أظْرَفِ الفِتْيَانِ"]]},"A710215C-A5CC-50E2-AF06-B9D8A9D18D9C":{"t":"فلا أَسَداً أَسُبُ وَ لاَ تَمِيْماً","p":64,"s":"فلا أسدا أسب و لا تميما","r":"438565","v":[["D9997263-9ACF-54E0-894F-600B52E371AA","فلا أَسَداً أَسُبُ وَ لاَ تَمِيْماً","وَكَيْفَ يَحُلُّ سَبُّ الأكْرَمِينَا"],["EFB4585D-DF68-5184-9192-9D2F8812F39E","وَلَكِنَّ التَّقَارُضَ حَلَّ بَيْنِي","وَبَيْنَكَ يَا بْنَ مُضْرِطَةِ العَجِينَا"]]},"69205557-FA56-56C9-AB93-BA2ED6242532":{"t":"في فِتْيَةٍ جَعَلُوا الصَّليبَ إلهَهُمْ","p":64,"s":"في فتية جعلوا الصليب إلههم","r":"438566","v":[["F0D38396-D280-551C-ADE6-562BA1D068C8","في فِتْيَةٍ جَعَلُوا الصَّليبَ إلهَهُمْ","حاشايَ إنِّي مُسْلِمٌ مَعْذُورُ"]]},"2BA51764-B24E-5AA5-BDE1-173E38BC4338":{"t":"فَإِنِّ أَبَا مُعْرِضٍ إذْ حَسَا","p":64,"s":"فإن أبا معرض إذ حسا","r":"438569","v":[["DAD8388F-609B-52C5-B04D-F4759A8C7BC3","فَإِنِّ أَبَا مُعْرِضٍ إذْ حَسَا","مِنَ الرَّاحِ كَأْساً عَلَى المِنْبَرِ"],["9CA165B9-F040-552B-9100-6FD14A8ED70D","خَطِيبٌ لَبِيبٌ أَبُو مُعْرِضٍ","فَإنْ لِيمَ فِي الخَمْرِ لَمْ يَصْبِرِ"],["A1CBAB26-D4D8-504B-B6C5-7A5BB8153258","أَحَلَّ الحَرَامَ أبُو مُعْرِضٍ","فَصَارَ خَلِيعاً على المَكْبَرِ"],["700DABA0-B274-5A27-A8D4-AC7B7682EE1B","يُجِلُّ اللِّئَامَ وَيَلْحَى الكِرَامَ","وإنْ أقْصَرُوا عَنْهُ لَمْ يُقْصِرِ"]]},"F15E98DA-CF72-5DFC-AEC8-736755BE917E":{"t":"فَلَيْتَ زِيَاداً لاَ يَزَلْنَ بَنَاتُهُ","p":64,"s":"فليت زيادا لا يزلن بناته","r":"438572","v":[["C4B6551F-4094-5F28-8B47-0E8BF57A6E36","فَلَيْتَ زِيَاداً لاَ يَزَلْنَ بَنَاتُهُ","يَمُتْنَ وَأَلْقَى كُلَّ مَا عِشْتُ عَابِسَا"],["D7B7DEC6-0416-53E4-BD5D-D1FF986E759B","فَذَلِكَ يَوْمٌ غَابَ عَنّيَ نَحْسُهُ","وأنْجَحْتُ فِيهِ بَعْدَ مَا كُنْتُ آيِسَا"]]},"1287EC02-8E25-59E1-BC79-A0006555F817":{"t":"قَرَّبَ الله بالسَّلامِ وَحَيَّا","p":64,"s":"قرب الله بالسلام وحيا","r":"438575","v":[["5BF92494-4715-5CD1-A2AD-210593F4305F","قَرَّبَ الله بالسَّلامِ وَحَيَّا","زَكَريَّا بْنَ طَلْحَةَ الفّيَّاضِ"],["9223AC91-D53F-53A2-A6CC-CA79FB04D523","مَعْدِنَ الضَّيْفِ إنْ أَنَاخُوا إلَيْهِ","بَعْدَ أَيْنِ الطلائِحِ الأنْقَاضِ"],["1001ADA5-C567-5BE8-81D6-1ABDCC4DCD7F","سَاهِماتُ العُيُونِ خُوضٌ رَذَايَا","قَدْ بَرَاهَا الكَلاَلُ بَعْدَ إِبَاضِ"],["983591DA-C6BC-5D57-845C-D54308853EBD","زَادَهُ خَالِدُ کبْنُ عَمِّ أبِيهِ","مَنْصِباً كَانَ فِي العُلاَ ذا انْتِفَاضِ"],["D8C5233E-8FE8-5FE7-92AA-12B0C733FF0D","فَرْعُ تَيْمٍ مِنْ تَيْمِ مُرَّةَ حَقّاً","قَدْ قَضَى ذَاكَ لآبْنِ طَلْحَةَ قَاضِ"]]},"A99DAC34-6F0F-5121-8BA1-F0962A38CE81":{"t":"كَفَانِي المَجُوسِيُّ مَهْرَ الرَّبَابِ","p":64,"s":"كفاني المجوسي مهر الرباب","r":"438590","v":[["7AA54C1A-B0AD-5A47-88B7-B70FEC0E2E69","كَفَانِي المَجُوسِيُّ مَهْرَ الرَّبَابِ","فِدًى لِلْمَجُوسِيِّ خَالٌ وَعَمْ"],["D50DE5EA-FED2-5483-8E7B-FC483C8F7A58","شَهِدْتُ بأَنَّكَ رَطْبُ المُشَاشِ","وَأَنَّكَ بَحْرٌ جَوَادٌ خِضَمْ"],["22DF7944-50D6-54FC-9D51-3A976F9A76A3","وَأَنَّكَ سَيِّدُ أَهلِ الجَحيم","إِذا ما تَرَدَّيتَ في مَن ظَلَم"],["7C5F62DB-E968-53B8-AED3-46307DF2E8AD","تُجاوِرُ هامانَ في قَعرِها","وَفِرعَونَ والمُكتَني بالحَكَم"]]},"EA30BB12-D3C1-58B3-AE5E-9ADAC75FF666":{"t":"لم يُغَرَّرْ بِذَاتِ خفٍّ سِوَانا","p":64,"s":"لم يغرر بذات خف سوانا","r":"438595","v":[["672A485E-E001-503E-8E76-7D46F2ED595C","لم يُغَرَّرْ بِذَاتِ خفٍّ سِوَانا","بَعْدَ أخْتِ العِبَادِ أمِّ حُنَيْنِ"],["5A127EC5-DCC8-5B47-A230-9C447BEF2300","وَعَدَتْنَا بِدِرْهَمَيْنِ نَبِيذاً","أو طِلاءً مُعَجّلاً غيْرَ دَيْنِ"],["8B3801AC-57B3-5B27-B215-1F20BFBCCE04","ثُمَّ ألْوَتْ بالدِّرْهَمَيْنِ جَمِيعاً","يَا لَقَومي لِضَيْعَةِ الدِّرْهمَيْنِ"]]},"B1C62F1A-2FBE-5C37-BC97-1F659225A394":{"t":"لِسَانُكَ مِنْ شكْرٍ ثَقِيلٌ عَنِ التُّقَى","p":64,"s":"لسانك من شكر ثقيل عن التقى","r":"438561","v":[["409507CF-B15B-552F-8FA0-9793338F79BB","لِسَانُكَ مِنْ شكْرٍ ثَقِيلٌ عَنِ التُّقَى","وَلكِنَّهُ بالمُخْزِيَاتِ طَلِيقُ"],["1E0F410F-8522-5EA5-893B-6972BB40BD02","وَأَنْتُ حَقِيقٌ يَا أُقَيْشِرُ أنْ تُرَى","كَذَاكَ إذَا ما كُنْتَ غَيْرَ مُفيقِ"],["51867DC5-19A7-51E6-B6CC-A43A669E8F5E","تَسُفُّ مِنَ الصَّهْباءِ صِرْفاً تَخَالُها","جَنَى النَّحْلِ يُهْدِيهِ إلَيْكَ صَدِيقُ"]]},"92C5523A-AFEC-5118-9139-A8B591182298":{"t":"وَأَسْعَدَتْها أَكُفٌّ غَيْرُ مُقْرِفَةٍ","p":64,"s":"وأسعدتها أكف غير مقرفة","r":"438570","v":[["B4F59E3A-F9FD-5C86-A6C8-7E08747A541C","وَأَسْعَدَتْها أَكُفٌّ غَيْرُ مُقْرِفَةٍ","تَثْني أنَامِلُها شِرْعَ المَزَاهِيرِ"],["4736D495-80C0-5001-90B8-6C9EBF22BCEF","مِنْ كُلِّ غَيْداءَ في تَفْرِيدِها صَحَلٌ","كَأَنَّ أَعْكَانَها طَيُّ الصَّوامِيْرِ"]]},"BDD047D9-49E7-5D31-BBDA-5F7C443EB9B4":{"t":"وَأَنَّكَ سَيِّدُ أهْلِ الجَحِيمِ","p":64,"s":"وأنك سيد أهل الجحيم","r":"438593","v":[["658D9D21-ED0B-5608-9629-318B951C1B75","وَأَنَّكَ سَيِّدُ أهْلِ الجَحِيمِ","إِذَا مَا تَرَدَّيْتَ فِي مَنْ ظَلَمْ"],["332EA340-31EA-56F6-8C22-28AD7520DE24","تُجَاوِرُ هَامَانَ فِي قَعْرِهَا","وَفِرْعَوْنَ والمُكْتَنِي بِالحَكَمْ"]]},"92B03C80-8E77-51F4-AA70-ECCF14E5A79B":{"t":"وَبَنُوا دُودَانَ حِيٌّ سَادَةٌ","p":64,"s":"وبنوا دودان حي سادة","r":"438554","v":[["8D69A700-57E2-5BAA-8869-2905F311B60F","وَبَنُوا دُودَانَ حِيٌّ سَادَةٌ","حَلَّ بَيْتُ المَجْدِ فِيهِمْ والعَدَدْ"]]},"80F52531-29E9-5F24-8254-2E4756D88DC5":{"t":"وَسَأَلْتَنِي يَوْمَ الرَّحِيلِ قَصَائِداً","p":64,"s":"وسألتني يوم الرحيل قصائدا","r":"438548","v":[["7650DC1F-FCE3-52F0-80AB-6341B2F32518","وَسَأَلْتَنِي يَوْمَ الرَّحِيلِ قَصَائِداً","فَمَلأْتُهُنَّ قَصَائِداً وَكِتَابَا"],["1C86E5D3-D5B6-56C2-AF29-42235B8B1DCE","إنّي صَدَقْتُكَ إذْ وَجَدْتُكَ كَاذِباً","وَكَذَبْتَنِي فَوَجَدْتَنِي كَذَّابَا"],["2C1F76C5-180B-5D47-A79E-52FA98BAA887","وَفَتَحْتُ بَاباً للخِيانَةِ عَامِداً","لَمّا فَتَحْتَ مِنَ الخِيَانَةِ بَابَا"]]},"94026454-22EF-53B6-991D-7D61E7326157":{"t":"وَصَهْبَاءَ جُرْجانِيَّةٌ لَمْ يَطُفْ بِهَا","p":64,"s":"وصهباء جرجانية لم يطف بها","r":"438563","v":[["1C553EDF-B7BE-5532-992E-5162E1A19F03","وَصَهْبَاءَ جُرْجانِيَّةٌ لَمْ يَطُفْ بِهَا","حَنيْفٌ وَلَمْ تَنْغَرْ بِهَا سَاعَةً قِدْرُ"],["D74F3936-0A5D-5058-8F50-0BB3EB37D9A7","وَلَم يَشْهَدِ القَشُّ المُهَيْنِمُ نَارَهَا","طَرُوقاً ولا صَلَّى عَلَى طَبْخِها حَبْرُ"],["BF911854-DBC8-543B-BF2B-863C52FCA271","أَتَانِي بِهَا يَحْيَى وَقَدْ نِمْتُ نَوْمَةً","وَقَدْ غَابَتِ الشِّعْرَى وَقَدْ جَنَحَ النَّسْرُ"],["9441CE96-6037-5DF4-A73F-78866C9C5335","فَقُلْتُ اصْطَبِحْهَا أوْ لِغَيْرِيَ فَاسْقِهَا","فَمَا أَنَا بَعْدَ الشَّيْبِ وَيْبَكَ والخَمْرُ"],["3BCD5D66-3A7C-55D7-8A6A-FD5A7F692067","تَعَفَّفْتُ عَنْهَا فِي العُصُورِ التي خَلَتْ","فَكَيْفَ التَّصَابِي بَعْدَمَا كَلأَ العُمْرُ"],["19EA6DE3-AC7D-5BE9-9FCC-944D2A1E887B","إذا المَرْءُ وَفَّى الأرْبعِينَ وَلَمْ يَكُنْ","لَهُ دُونَ مَا يَأْتِي حَيَاءٌ وَلاَ سِتْرُ"],["93E2B74D-7746-5A1D-BBB3-F3C34125F01F","فَدَعْهُ وَلاَ تَنْفَسْ عَلَيْهِ التي أتَى","وَإنْ جَرَّ أسْبَابَ الحَيَاةِ لَهُ الدَّهْرُ"]]},"C88A1608-0F73-5896-9B81-15B32BB32828":{"t":"وَفَدَ الوُفُودُ فَكُنْتَ أوَّلَ وَافِدٍ","p":64,"s":"وفد الوفود فكنت أول وافد","r":"438582","v":[["4F736B97-EAAA-53ED-BE69-0095A581C83C","وَفَدَ الوُفُودُ فَكُنْتَ أوَّلَ وَافِدٍ","يَا فَاتِكُ بْنُ فُضَالَةَ بْنِ شُرَيْك"]]},"402FEAEC-0D88-5419-AFFB-D2DFAB5E83DB":{"t":"وَلَقَدْ أَرُوحُ بِمُشْرِفٍ ذِي مَيْعَةٍ","p":64,"s":"ولقد أروح بمشرف ذي ميعة","r":"438555","v":[["473B9E46-C585-5F62-A579-287DA1A9031B","وَلَقَدْ أَرُوحُ بِمُشْرِفٍ ذِي مَيْعَةٍ","عَسِرِ المَكَرَّةِ مَاؤُهُ يَتَفَصَّدُ"],["D1D0A3F9-E4B1-5ADC-A8D7-9496431DE601","مَرِحٍ يَطِيرُ مِنَ المِرَاحِ لُعَابُهُ","وَيَكَادُ جِلْدُ إهَابِهِ يَتَقَدَّدُ"],["0634DB0E-5427-5696-8D05-C83CBDFFD534","حَتَّى عَلَوْتُ بِهِ مَشَقَّ ثَنِيَّةٍ","طَوْراً أغُورُ بِهَا وَطَوْراً أُنْجِدُ"]]},"7B5B6EA8-D0EA-542E-A1ED-5EA3E26A5BEC":{"t":"وَمَنْ لِي بِأنْ أَسْطِيعَ أنْ أَذْكُرُ اسْمَهُ","p":64,"s":"ومن لي بأن أسطيع أن أذكر اسمه","r":"438560","v":[["542366D3-B6A5-5178-8818-5F5B4F21A79C","وَمَنْ لِي بِأنْ أَسْطِيعَ أنْ أَذْكُرُ اسْمَهُ","وَأعْيَا عِقَالاً أنْ يُطِيقَ لَهُ ذِكْرَا"]]},"714BA09B-C2DE-59FA-A989-445B050863EA":{"t":"وَمُسَوَّفٍ نَشَدَ الصَّبُوحَ صَبَحْتُهُ","p":64,"s":"ومسوف نشد الصبوح صبحته","r":"438545","v":[["F77A75D6-8B1F-5567-825E-7ED3E1B04D2D","وَمُسَوَّفٍ نَشَدَ الصَّبُوحَ صَبَحْتُهُ","قَبْلَ الصَّباحِ وَقَبْلَ كُلِّ نِدَاءِ"]]},"FEE8E37C-3F82-5F18-94E1-A2B27263604A":{"t":"وَمُقْعَدِ قَوْمٍ قَدْ مَشَى مِنْ شَرَابِنَا","p":64,"s":"ومقعد قوم قد مشى من شرابنا","r":"438559","v":[["CBDED2DA-2AF8-560B-83CB-50C07D94677E","وَمُقْعَدِ قَوْمٍ قَدْ مَشَى مِنْ شَرَابِنَا","وأَعْمَى سَقَيْنَاهُ ثَلاثاً فَأَبْصَرَا"],["89C90991-54D6-5871-8249-1C80CFD6864C","شَرَاباً كَرِيحِ العَنْبَرِ الوَرْدِ رِيحُهُ","وَمَسْحُوقَ هِنْدِيٍّ مِنَ المِسْكِ أَذْفَرَا"],["C41A4EB6-12C6-5537-810A-41E3054842A7","مِنَ الفَتَيَاتِ الغُرِّ مِنْ أرْضِ بَابِلٍ","إذَا صَبَّهَا الحَانيُّ فِي الكَأْسِ كَبَّرَا"],["FAEFEEBE-78A9-5843-B974-A4C73CBC19C5","لَهَا مِنْ زُجَاجِ الشَّامِ عُنْقٌ غَرِيبَةٌ","تَأَنَّقَ فِيهَا صَانِعٌ وَتَحَيَّرَا"],["89CFCEF3-EB69-5DEF-AB38-0E492006FB0C","ذَخَائِرُ فِرْعَوْنَ التي جُبِيَتْ لَهُ","وَكُلٌّ يُسَمَّى بالعَتِيقِ مُشَهَّرَا"],["9B66FF7A-1248-5851-A01D-91D6E5257F5E","إذَا مَا رَآهَا بَعْدَ إنْقَاءْ غُسْلِهَا","تَدُورُ عَلَيْنَا صَائِمُ القَوْمِ أفْطَرَا"]]},"FEEA7094-56F7-51F7-BE58-F4E460757B2C":{"t":"يا أيُّهَا السَّائِلُ عَمَّا مَضَى","p":64,"s":"يا أيها السائل عما مضى","r":"438550","v":[["C7BE9FE6-D7DD-553F-ABCE-EF24071A8E12","يا أيُّهَا السَّائِلُ عَمَّا مَضَى","مِنْ عِلْمِ هذا الزَّمَنِ الذاهِبِ"],["5F9E0D49-B475-503E-8F7C-F5CE8755AA6C","إنْ كُنْتَ تَبْغِي العِلْمَ أَوْ أَهْلَهُ","أَوْ شَاهِداً يُخْبِرُ عَنْ غَائِبِ"],["CFCC3EE8-677F-5C94-B9A2-2A547075BD80","فاختَبِرِ الأرْضَ بِأَسْمَائِها","وَاعْتَبِرِ الصَّاحِبَ بالصَّاحِبِ"]]},"39B5ADF2-EEC2-5A39-B9B4-24A39D504A6C":{"t":"يا خَلِيلَيَّ أسْقِيَانِيَ كِاسا","p":64,"s":"يا خليلي أسقياني كاسا","r":"438571","v":[["A83A72D6-69DC-5AC2-B74D-64B7F80881BA","يا خَلِيلَيَّ أسْقِيَانِيَ كِاسا","ثُمَّ كَأْساً حَتّى أَخِرَّ نُعَاسَا"],["3ECC876C-10F3-5656-A18C-477921ABBB75","إنَّ في الغُرْفَةِ التي فَوْقَ رَأْسِي","لأُنَاساً يُخَادِعُونَ أُنَاسَا"],["B9B86E30-4837-51AB-ACEE-6ED808275DD5","يَشْرَبُونَ المُعَتَّقَ الرَّاحَ صِرْفاً","ثُمَّ لا يَرْفَعُونَ لِلزَّوْرِ رَاسَا"]]},"D5D63666-2338-5506-9D26-91F00530DCEF":{"t":"يقولونَ لي آنْكَهْ قد شَرِبْتَ مُدامَةً","p":64,"s":"يقولون لي آنكه قد شربت مدامة","r":"438583","v":[["3029C3D0-5357-5712-85C5-80325464A284","يقولونَ لي آنْكَهْ قد شَرِبْتَ مُدامَةً","فَقُلْتُ لَهُمْ: لاَ بَلْ أَكَلْتُ سَفَرْجَلاَ"]]},"DD1A8203-4446-5A2F-B6A2-62A484FFE3F2":{"t":"يَا بَغْلُ بَغْلَ أبي مَضَاءَ تَعَلَّمَنْ","p":64,"s":"يا بغل بغل أبي مضاء تعلمن","r":"438567","v":[["82BBD366-D8C7-51FA-AE0D-7FA41B9CC5C1","يَا بَغْلُ بَغْلَ أبي مَضَاءَ تَعَلَّمَنْ","أنّي حَلَفْتُ وَلِلْيَمِينِ نُذُورُ"],["6B9BE48C-FFE2-53E9-AA67-7DD2951879BF","لَتُعَسِّفَنَّ وَإنْ كَرِهْتَ مَهَامِهاً","فيما أحُلُّ وَكُلُّ ذَاكَ يَسِيرُ"],["86704912-8EB9-531E-9FE3-C4E217FDFCA6","بالرَّغْمِ يَا وَلَدَ الحِمَارِ قَطَعْتَهَا","عَمْداً وَأنْتَ مُذَلَّلٌ مَصْبُورُ"],["091C3BD0-9873-5900-9C94-72A48E436097","حَتَّى تَزُورَ مُسمِّعاً فِي دَارِهِ","وَتَرَى المُدَامَةَ بالأكُفِّ تَدُورُ"],["5FB70EF5-C66C-5A67-9826-FFCFE78CCCF2","لا يَعْرِفُونَ بِمَا يَسُوؤُكَ نُعْرَةً","وإذا سَخِطْتَ فَخَطْبُ ذَاكَ صَغِيرُ"]]},"EA41DFFB-8940-5694-A7B2-3767F496048C":{"t":"يُرِيدُ النِّسَاءَ وَيَأْبَى الرِّجَالْ","p":64,"s":"يريد النساء ويأبى الرجال","r":"438574","v":[["43F32CAE-0AEE-539D-BF01-584068ADFBA7","يُرِيدُ النِّسَاءَ وَيَأْبَى الرِّجَالْ","فَمَا لِي وَمَا لأبي عَائِشَهْ"],["32070215-C4F5-5A9E-B58D-2FB89C9C58CF","أَدَامَ لَهُ اللَّهُ كَدَّ الرِّجَالْ","وَأَثْكَلَهُ کبْنَتَهُ عَائِشَهْ"]]},"4D26027D-ECD0-58FC-ABD5-56F1B0132E84":{"t":"يُسَائِلُنِي هِشَامٌ عَنْ صَلاَتِي","p":64,"s":"يسائلني هشام عن صلاتي","r":"438573","v":[["E18D4FA8-3EA7-543D-8614-657DD1F421F9","يُسَائِلُنِي هِشَامٌ عَنْ صَلاَتِي","صَلاَةِ المُسْلِمِينَ فَقُلْتُ: خَمْسُ"],["56576CF2-6E9A-5C37-B049-D994ADD61DD5","صَلاَةُ العَصْرِ والأولَى ثَمَانٍ","مُوَاتَرَةً فَمَا فِيهِنَّ لَبْسُ"],["30BAD0FA-6673-5A32-9F63-D534723BAC4F","وَعِنْدَ مَغِيبِ قَرْنِ الشَّمْسِ وِتْرٌ","وَشَفْعٌ بَعْدَهَا فِيهِنَّ حَبْسُ"],["8FD25A6A-ACE8-5C9E-B965-7972EDF35E72","وَغُدْوَةً کثْنَتَانِ مَعاً جَمِيعاً","وَلَمَّا تَبْدُ للرَّائِينَ شَمْسُ"],["654C018F-CF2D-5686-AFFD-EB83F87956BC","وَبَعْدَهُمَا لِوَقْتِهِمَا صَلاَةٌ","لِنُسْكٍ بالضحَاءِ إذا نَبُسُّ"],["EFE30FF1-1350-5E29-A3A5-E0E1093C4200","أَأَحْصَيْتَ الصَّلاَةَ أَبَا هِشَامٍ","فَذَاكَ مُكدِّرُ الأخلاقِ جِبْسُ"],["6C1F794C-315D-518D-88A7-3E25DC49B9FE","تَعَوَّدَ أنْ يُلامَ فَلَيْسَ يَوْماً","بِحامِدِهِ إلى الأْقوامِ إنْسُ"]]}}}