{"v":1,"poems":{"51AABE73-7C1F-52DC-B9B9-6A576DA6353F":{"t":"أصبحتُ أفني عاديا وبَقِيتُ","p":13,"s":"أصبحت أفني عاديا وبقيت","r":"436187","v":[["9CB47B82-0C78-5515-A968-6748F4185AC6","أصبحتُ أفني عاديا وبَقِيتُ","لم يبقَ غَير حُشاشَتي وأمُوتُ"],["B5EF3C67-AF12-5AF3-AD3D-21F74D52169C","ولقد لَبِستُ على الزّمان جديدَة","ولبِسْتُ إخوانَ الصّبَى فبَلِيتُ"],["BE246D27-9217-5902-B260-6DF1B41A63C3","غَلبَ العَزَى عمّنْ أرى فتبِعتُه","و خدعتُ عما في يدي فأسيتُ"],["37B71235-D61F-5BF0-8F10-AE708F48DF54","ومَسالِكٍ يَسّرتُها فتركتُها","و مواعظٍ علمتها فنسيتُ"]]},"91B8FF9E-C330-5A65-9165-F345023DC0A1":{"t":"أعاذلتي ألا لاَ تعذ ليني","p":13,"s":"أعاذلتي ألا لا تعذ ليني","r":"436188","v":[["059B3040-D06E-552D-8400-C2D6B5679262","أعاذلتي ألا لاَ تعذ ليني","فكمْ منْ أمرِ عاذلةٍ عصيتُ"],["A4B71F57-0742-5780-BB77-3BC438093D91","دَعيني وارشُدي إن كنتُ أغوى","ولا تغويْ زعمتِ كما غويتُ"],["0720E328-5EF5-59D3-8171-971F62F7DB33","أعاذلَ قدْ أطلتِ اللومَ حتى","لو انِّي مُنْتَهٍ لقدِ انتَهَيْت"],["D727D0E6-B2E1-5E43-938E-6D9A917B450E","وصفراءِ المعاصمِ قدْ دعتني","إلى وصلٍ فقلتُ لها أبيتُ"],["2F9653A6-DE27-566E-A6C0-FA5DDB963A7E","وزِقٍّ قد جَرَرْتُ إلى النَّدامَى","وزِقٍّ قد شرِبتُ وقد سَقَيت"],["81594BF1-7F99-52B5-9E91-428570CB00B6","وحتى لو يكونُ فَتى أُناسٍ","بكى منْ عذلِ عاذلةٍ بكيتُ"],["80BC566A-D051-593E-B256-2535FD33ECEC","ألا يا بَيْتُ بالعلياءِ بَيْتُ","ولولا حبُّ أهلكَ ما أتيتُ"],["D21269C1-1582-52B3-88C1-24E35FB0C05B","ألا يا بَيْتُ أهْلُكَ أوعَدوني","كأنّي كلَّ ذَنْبِهِمِ جَنيْت"],["EAD1B7E8-E07F-552D-AF2C-B80E42A430FE","إذا ما فاتني لحمُ غريضُ","ضربتُ ذراعَ بكري فاشتويتُ"]]},"5B0765D7-2626-5A03-BD5B-E2AF734F1E48":{"t":"إرفَعْ ضعيفَكَ لا يُحِرْ بكَ ضَعْفُه","p":13,"s":"إرفع ضعيفك لا يحر بك ضعفه","r":"436181","v":[["EFEBA62D-6267-5C9C-B26C-E6C3D7472A47","إرفَعْ ضعيفَكَ لا يُحِرْ بكَ ضَعْفُه","يوماً فتدركه العواقبُ قد نما"],["992244D2-7FAE-5CFC-A534-8B8DF9C3B848","يَجْزِيكَ أو يُثْني عليك، وإنّ مَن","أثنى عليكَ بما فَعَلْتَ فقد جَزى"]]},"E3CB793D-1DCD-572C-8166-1E829F5699CE":{"t":"إسلمْ سلمتَ ولا سليمَ على البلى","p":13,"s":"إسلم سلمت ولا سليم على البلى","r":"436186","v":[["23B5AFFD-F015-57FF-87C1-1CB73FE343CE","إسلمْ سلمتَ ولا سليمَ على البلى","فَنيَ الرّجالُ ذوُو القُوَى فَفَنِيتُ"],["9D0A29AC-9E35-5FBD-BA13-12E5F60FE748","كيفَ السلامةُ إن أرد تُ سلامةً","والموتُ يَطلُبُني ولستُ أفوتُ"],["C2FEF639-E05E-5B0C-992F-9D977762BC88","وأقيلُ حيثُ أُرى فلا أخفى لهُ","و يرى فلا يعيا بحيثُ أبيتُ"],["B7FFFBAE-0E81-521D-BE1C-CC2B973FCC4C","ميتاً خُلِقْتُ ولم أكُنْ مِن قبلها","شيئاً يموتُ فمُتُّ حيثُ حَيِيتُ"],["C74B4DD5-4E5B-5897-A5A4-83082DBA56DA","وأموتُ اخرى بعدها ولأعلمنْ","إن كان ينفَعُ أنّني سأموتُ"]]},"BDCAA215-4B68-5CC0-A995-B97D1467D25D":{"t":"إن كانَ ما بلغتَ عني فلامني","p":13,"s":"إن كان ما بلغت عني فلامني","r":"436192","v":[["900C6EB7-433B-59BE-8485-5F1C0C36E5EA","إن كانَ ما بلغتَ عني فلامني","صديقي وحُزّتْ مِن يدَيّ الأناملُ"],["D2278A86-AB95-5BA1-A67C-055441592428","وكفنتُ وحدي منذراَ في ثيابه","وصادفَ حوطاَ من عدوي قاتلُ"]]},"F234403A-A180-56B7-B67A-E4692B245546":{"t":"إنّ امرَأً أمِنَ الحوادثَ جاهِلٌ","p":13,"s":"إن امرأ أمن الحوادث جاهل","r":"436190","v":[["4436B593-510A-51A2-B4C3-D432388AFD9F","إنّ امرَأً أمِنَ الحوادثَ جاهِلٌ","ير جو الخلودَ كضاربٍ بقداحٍ"],["C6660107-9A81-5059-9778-52CF3AB18DA9","منْ بعدِ عاديَّ الدهورِ ومآربٍ","ومَقاوِلٍ بِيضِ الوجوه صِباحِ"],["ADF66B3D-7CEE-54A0-9EA1-3C6AA30FFE1E","مرتْ عليهمْ آفةُ فكأنها","عفتْ على آثارهمْ بمتاحِ"],["228F872A-98C5-59E7-9BA7-1377285F033D","ياليتَ شعري حينَ أند بُ هالكاَ","ماذا تؤبنني به أنواحيِ"],["369AF798-AA0B-5FC7-9072-9E28DB7514B3","أيقلنَ لا تبعدْ فربّ كريهةٍ","فرجتها بشجاعةٍ وسماحِ"],["668B14BA-C4F4-5BE3-ADBD-89691A7FC28B","ومغيرةٍ شعواءَ يخشى درؤها","يوماً رددتُ سلاحها بسلاحي"],["58F7AF3D-D593-517A-AAB0-A9A976A61E4D","ولَرُبّ مُشعَلَةٍ يَشُبُّ وَقُودُهَا","أطفأتُ حَرّ رِماحِها برِماحي"],["42E87CF6-397F-5126-9396-29C4807555AC","وكَتِيبَةٍ أدْنَيْتُهَا لِكَتِيبَةٍ","ومُضاغِنٍ صَبّحْتُ شَرَّ صَباح"],["E4FDAE5A-D96E-522A-9339-A683600C6BBD","وإذا عمدتُ لصخرةٍ أسهلتها","أدعو بأفلحْ مرةً ورباحِ"],["2EF82239-6757-5760-A55F-32B0B1D52CFC","لا تَبعَدَنّ فكُلُّ حيّ هالِكٌ","لا بدّ من تلفِ فبنْ بفلاحِ"],["124ED0C0-6709-53E2-AFF7-08812DA9FEAE","إنّ امرأً أمِنَ الحوادثَ جاهلاً","ورجا الخلودَ كضاربِ بقداحِ"],["4CA24DBE-799A-5203-BF0B-D9623B10A5CC","ولقدْ أخذتُ الحقَّ غيرَ مخاصمٍ","ولقدْ بذ لتُ الحقَّ غيرَ ملاحِ"],["553ACD09-F355-5926-A81C-4C1B8F787C9A","ولقدْ ضربتُ بفضلِ مالي حقهُ","عندَ الشتاءِ وهبةِ الأرواحِ"]]},"5DEE5DC4-5760-57F4-A87F-84FB1AAC091B":{"t":"إنّي إذا ما المرء بَيّنَ شَكّه","p":13,"s":"إني إذا ما المرء بين شكه","r":"436193","v":[["E893863A-ED1E-5FEB-BCA3-5638C4F0CC63","إنّي إذا ما المرء بَيّنَ شَكّه","وبَدَتْ عَواقِبُه لمَنْ يتأمّلُ"],["CC3F119D-5ECD-5D42-8947-2CE3A05B5F62","وتبرأ الضعفاء منْ إخوانهم","وألَحّ من حرّ الصّميم الكلكلُ"],["83A87EFC-AEF8-59D2-B28D-D096899E3657","أدعُ التي هيَ أرمقُ الحالاتِ بي","عندَ الحفيظةِ للتي هيَ أجملُ"]]},"95A1A79C-DCC0-57CD-B158-55CE12C19577":{"t":"إِذا المَرءُ لَم يُدنَس مِنَ اللُؤمِ عِرضُهُ","p":13,"s":"إذا المرء لم يدنس من اللؤم عرضه","r":"436180","v":[["F185DB35-E1D1-53A0-82CE-B0C359DB5E93","إِذا المَرءُ لَم يُدنَس مِنَ اللُؤمِ عِرضُهُ","فَكُلُّ رِداءٍ يَرتَديهِ جَميلُ"],["8C9C2A2A-13AC-5026-B7F9-F4FF4F5956E2","وَإِن هُوَ لَم يَحمِل عَلى النَفسِ ضَيمَها","فَلَيسَ إِلى حُسنِ الثَناءِ سَبيلُ"],["34CFEC25-57A3-53CE-BA16-0FC1C4A2984B","تُعَيِّرُنا أَنّا قَليلٌ عَديدُنا","فَقُلتُ لَها إِنَّ الكِرامَ قَليلُ"],["9442F7BC-323A-55DE-9C1A-E46FE6819799","وَما قَلَّ مَن كانَت بَقاياهُ مِثلَنا","شَبابٌ تَسامى لِلعُلى وَكُهولُ"],["81DBA60C-8086-582F-9FA8-686CD9DEFBF4","وَما ضَرَّنا أَنّا قَليلٌ وَجارُنا","عَزيزٌ وَجارُ الأَكثَرينَ ذَليلُ"],["7560338B-B1D9-5AF7-AD8A-D802BAFEFFCE","لَنا جَبَلٌ يَحتَلُّهُ مَن نُجيرُهُ","مَنيعٌ يَرُدُّ الطَرفَ وَهُوَ كَليلُ"],["9C754019-FCB7-53DF-A335-87FD422D56D1","رَسا أَصلُهُ تَحتَ الثَرى وَسَما بِهِ","إِلى النَجمِ فَرعٌ لا يُنالُ طَويلُ"],["564C6310-34FB-5CB6-9D86-A63AF85C4EEB","هُوَ الأَبلَقُ الفَردُ الَّذي شاعَ ذِكرُهُ","يَعِزُّ عَلى مَن رامَهُ وَيَطولُ"],["6ED62413-E136-5A44-87DC-92507C8F679C","وَإِنّا لَقَومٌ لا نَرى القَتلَ سُبَّةً","إِذا ما رَأَتهُ عامِرٌ وَسَلولُ"],["68C02825-695B-5D21-9D05-ED57D6722D27","يُقَرِّبُ حُبُّ المَوتِ آجالَنا لَنا","وَتَكرَهُهُ آجالُهُم فَتَطولُ"],["A794F5EF-4C91-5506-BB99-12370BB059A3","وَما ماتَ مِنّا سَيِّدٌ حَتفَ أَنفِهِ","وَلا طُلَّ مِنّا حَيثُ كانَ قَتيلُ"],["8BFA284F-49FE-5344-9585-6015252E222C","تَسيلُ عَلى حَدِّ الظُباتِ نُفوسُنا","وَلَيسَت عَلى غَيرِ الظُباتِ تَسيلُ"],["2361A168-3D79-5AD7-9292-187A96D6CE82","صَفَونا فَلَم نَكدُر وَأَخلَصَ سِرَّنا","إِناثٌ أَطابَت حَملَنا وَفُحولُ"],["D3C67975-2613-525D-A044-3CB8D34755CB","عَلَونا إِلى خَيرِ الظُهورِ وَحَطَّنا","لِوَقتٍ إِلى خَيرِ البُطونِ نُزولُ:"],["9555BA6A-D77A-57E8-9784-B2128CD549E5","فَنَحنُ كَماءِ المُزنِ ما في نِصابِنا","كَهامٌ وَلا فينا يُعَدُّ بَخيلُ"],["9D725D1B-52CB-5090-8B2E-63A8AFB5FF68","وَنُنكِرُ إِن شِئنا عَلى الناسِ قَولَهُم","وَلا يُنكِرونَ القَولَ حينَ نَقولُ"],["329682E7-A558-5AA8-83E2-322DEA05DD95","إِذا سَيِّدٌ مِنّا خَلا قامَ سَيِّدٌ","قَؤُولٌ لِما قالَ الكِرامُ فَعُولُ"],["04B41522-625F-5E93-915E-54C9501A8B35","وَما أُخمِدَت نارٌ لَنا دونَ طارِقٍ","وَلا ذَمَّنا في النازِلينَ نَزيلُ"],["6D34D880-4E24-50F2-87C3-107952064A5C","وَأَيّامُنا مَشهورَةٌ في عَدُوِّنا","لَها غُرَرٌ مَعلومَةٌ وَحُجولُ"],["622ED342-B62C-59F5-BBA6-AB9E4F4CEA8C","وَأَسيافُنا في كُلِّ شَرقٍ وَمَغرِبٍ","بِها مِن قِراعِ الدارِعينَ فُلولُ"],["291C6990-B6B9-50B4-A388-FA9DE3C39A6F","مُعَوَّدَةٌ أَلّا تُسَلَّ نِصالُها","فَتُغمَدَ حَتّى يُستَباحَ قَبيلُ"],["3CC0875D-D0F4-5E81-B041-8F7AB00070AF","سَلي إِن جَهِلتِ الناسَ عَنّا وَعَنهُمُ","فَلَيسَ سَواءً عالِمٌ وَجَهولُ"],["39576CBD-3378-56DC-9E23-FE7BD770399C","فَإِنَّ بَني الرَيّانِ قَطبٌ لِقَومِهِم","تَدورُ رَحاهُم حَولَهُم وَتَجولُ"]]},"72385D14-061B-5059-97CD-BBAD748F1408":{"t":"بالأبْلَقِ الفردِ بيتي بهِ","p":13,"s":"بالأبلق الفرد بيتي به","r":"436191","v":[["B509D408-D22A-53E9-A558-88C739097ECF","بالأبْلَقِ الفردِ بيتي بهِ","وبيتُ المصيرِ سوى الأبلقِ"],["2A0C12C9-DD07-5C93-B4E5-22C31FB6B910","ببلقعَةٍ أثبَتَتْ حُفْرَةً","ذراعَيْنِ في أرْبَعٍ خيسَقِ"],["12A5596B-7FAB-576D-B91B-11FAD1C38DE4","فلاَأ دفعُ الضيفَ عنْ رزقهِ","لديّ إذا قيلَ لمْ يرزقِ"],["5FEAB364-0FD3-52D1-A57F-6467DE7C040F","وفي البيْتِ ضَخماءُ مملُوءةٌ","وجَفْنٌ على هَمِعٍ مُدْهَقِ"],["C0F27216-FB6C-5541-8A5D-9C36BA73A93D","أبيتُ الذي قد أتى عادياً","وحيّاً من الحَلَقِ الأروقِ"]]},"68FB22FD-8EB5-5823-8C6F-BA659DFAA088":{"t":"رأيتُ اليتامى لا يَسُدُّ فقورَهُمْ","p":13,"s":"رأيت اليتامى لا يسد فقورهم","r":"436184","v":[["F07A2ED1-69D3-5156-9C22-56B0A346DF19","رأيتُ اليتامى لا يَسُدُّ فقورَهُمْ","قرانا لهمْ في كلّ قعبٍ مشعبِ"],["C7E24CE5-64B7-56C0-A724-425C79F60142","فقلتُ لعبد ينا:أريحا عليهمِ","سأجعَلُ بَيْتي مثلَ آخرَ مُعزَبِ"]]},"27C6368F-8ED2-5972-A0CF-09F6595E76F1":{"t":"عَفا من آلِ فاطِمةَ الخُبَيْتُ","p":13,"s":"عفا من آل فاطمة الخبيت","r":"436189","v":[["3E7BECB9-8EA2-5A35-B01C-0C78D727C94F","عَفا من آلِ فاطِمةَ الخُبَيْتُ","إلى الإحرا مِ ليسَ بهنّ بيتُ"],["3F97D4D5-0AE1-57A1-B44D-DDABE9446019","أغا ذلتيّ قو لكما عصيتُ","لنفسي إنْ رشد تُ وإنْ غويتُ"],["B50A8695-B278-57EE-8F59-86B3480D2A0A","بنى لي عاديا حصناً حصيناً","وعيناً كلما شئتُ استقيتُ"],["C1EBFE48-68E8-54C9-A5A0-9DC11F10F2DE","طِمِرّاً تَزلَقُ العِقبانُ عَنْهُ","إذا ما نابني ضيمُ أبيتُ"],["CA41678C-2E0E-567E-B0C3-DE57429336A6","وأوصى عاديا قِدْماً بأن لا","تهدم يا سموألُ ما بنيتُ"],["7BA66870-2E16-575E-B02B-6E3EBA9800A5","وبيتٍ قد بنيتُ بغيرِ طِينٍ","ولا خشَبٍ ومجْدٍ قد أتَيْتُ"],["10770FCE-F315-562F-A094-5F7656E16D35","وجيشِ فيد جى الظلماء مجرِ","يَؤمُّ بلادَ مَلْكٍ قد هَدَيتُ"],["27E42D80-B9FC-56C2-A946-41D86A2C0B45","وذنبٍ قد عَفَوْتُ لغير باعٍ","ولا واعٍ وعنهُ قدْ عفوتُ"],["30EAFEF0-C8A9-53CD-969F-B5867EC77F5C","فإن أهلِكْ فقد أبليْتُ عُذْراً","وقضّيْتُ اللُّبانَةَ واشْتَفَيتُ"],["0779FF2A-D2D5-560F-8E8E-994B4F6028A2","وأصرفُ عنْ قوارصَ تجتد يني","ولو أني أشاء بها جَزَيْتُ"],["F0B013E3-25C6-5D36-99AE-5A4319590EE4","فأحمي الجارَ في الجُلّى فيُمْسي","عزيزاً لا يرامُ، إذا حميتُ"],["BF4706DD-B828-5FEC-BE39-0C2314730453","وفيتُ بأدرع الكند يّ، إني","إذا ما خانَ أقوامٌ وَفَيتُ"],["02281CA8-5BAC-5196-A903-1F3CAF9BC12A","وقالوا: إنّهُ كَنْزٌ رَغِيبٌ","فلاَ واللهِ أعذرُ ما مشيتُ"],["836EB128-E609-5AA3-88C2-22F65AA27B3F","ولولا أنْ يقالَ حبا عنيسُ إلى بعض","البيوتِ لقدْ حبوتُ"],["F6E8E27F-70B2-55C4-B257-CBA61E6F794A","وقُبّةِ حاصِنٍ أدخلتُ رَأسي","ومعصمها الموشمَ قدْ لويتُ"],["BB45F163-EC1C-5BFD-81E7-D4AB95729AE7","وداهِيَةٍ يَظَلُّ النّاسُ منها","قِياماً بالمحارِفِ قد كفيتُ"]]},"3A69F9BE-AC21-5E93-BA51-667FA16A7EA4":{"t":"لم يقض منْ حاجةٍ الصبا أربا","p":13,"s":"لم يقض من حاجة الصبا أربا","r":"436182","v":[["F2EA1D9F-FA94-51B2-9CB4-1883E02883AE","لم يقض منْ حاجةٍ الصبا أربا","وقد شآكً الشبابُ إذ ذهبا"],["65EF1F3A-03A4-55EF-8145-96BFF657F13D","وعاودَ القلبَ بعدَ صِحّتِهِ","سُقمٌ فلاقى من الهوى تَعَبا"],["B8A31E66-A6A1-58A1-B29E-95204A4617AF","إن لـنا فخمةً ملـملمةً","تَقري العدوّ السِّمامَ واللّهبا"],["E10C0F9C-6405-52A4-BB15-9915E5B8D517","رجراجةً عَضّلَ الفضاءُ بها","خَيْلاً ورَجْلاً ومنصباً عَجَبا"],["363EDD16-7F28-5007-ACBF-F27D7523E427","أكنافُها كلُّ فارسٍ بَطَلٍ","أغلبَ كالليثِ عادياً حَرِبا"],["B3F827AD-CFDB-5B3D-856A-EF17B999E36B","في كفةِ مرهفُ الغرارِ إذا","أهوى بهِ منْ كريهةٍ رسبا"],["A31351DB-EFB4-5744-A43F-D5F9161B7867","أعدَّ للحربِ كلَّ سابغةٍ","فَضفاضَةٍ كَالغَديرِ وَاليَلَبا"],["9E864C2C-0DCF-5683-9D05-3C3F97273536","والشمرَ مطرورةً مثقفةً","والبيضَ تزهى تخالها شهبا"],["3D37BDB1-AA9F-5098-8F2C-A3B13354EBBF","يا قيسُ إنّ الاحسابَ أحرزَهَا","منْ كانَ يغشى الذ وائبَ القضبا"],["0283D8D1-CDCB-51FB-840A-6102754461AE","منْ غادرَ السيدَ السبطرَ لدى","المعرك عَمراً مُخضَّباً تَرِبا"],["5B12FA5C-A72F-5EAD-A9C7-C78A0F062DC4","جاشَ منَ الكاهنينِ إذْ برزوا","أمواجَ بحْرٍ تُقمِّصُ الحدَبا"],["570EE8E6-4C58-5AF3-B84D-993DEDA4C154","لِنصرِكُم والسيوفُ تَطلُبُهم","حتى تولوا وأمعنوا هربا"],["7048FC2A-A612-5656-A634-4D070C3031D0","وأنتَ في البيتِ إذْ يُحَمُّ لكَ","الماءُ وتدعو قتالنا لعبا"]]},"E6682A9F-3B12-5FDB-8D83-B95014D733D6":{"t":"نطفة ما منيتُ يومَ منيتُ","p":13,"s":"نطفة ما منيت يوم منيت","r":"436185","v":[["7C16ACCB-09BA-52F6-885C-33EAD5B54E91","نطفة ما منيتُ يومَ منيتُ","أمرتْ أمرها وفيها بريتُ"],["A6D17A4D-B244-5C5A-BDD9-74DFB045F00C","كَنَّها الله في مكانٍ خَفِيٍّ","وخَفِيٌّ مكانُها لو خَفِيتُ"],["50DC93F4-E032-500E-A634-3E6A2B87ADA3","مَيْتَ دَهْرٍ قد كنتُ ثم حَيِيتُ","وحياتي رهنُ بأنْ سأموتُ"],["F17574BB-DBBD-5409-914D-BCB338C066D0","إنًّ حلمي إذاتغيبَ عني","فاعلمي أنني كبيراَ رزيتُ"],["ECB7E8C5-F476-57A0-9A4C-7765C90F4EFE","ضيقُ الصدرِ بالأمانةٍ لا","ـقُصُ فَقْرِي أمَانَتِي ما بَقِيتُ"],["2B251A70-0862-58DF-9F72-0FEBC28FE9B8","رُبَّ شَتْم سَمِعْتُه فَتَصامَمْـ","ـتُ وَغَيٍّ تَرَكْتُه فكُفِيتُ"],["2C9BF6AD-A0F2-58F0-86D6-A5B5CA4FF07A","ليتَ شِعْرِي وأشْعُرَنَّ إذا ما","قربوها منشورة ودعيت"],["833C03F7-279D-526D-AFFF-AC47918B8F01","أَلِيَ الفَضْلُ أمْ عَلَيَّ إذا حُو","سبتُ أنيَّ على الحسابِ مقيتُ"],["004BA639-AC3C-5F29-BE97-8F068FF86A31","وأتاني اليقينُ أني إذا متُّ","مِتُّ أوْ رَمَّ أعْظُمِي مَبْعُوتُ"],["FB759F90-CF68-5A3B-AF61-75CB465F1CDC","هلْ أقولنّ إذ تداركَذ نبي","وتذ كى عليّ إني نهيتُ؟"],["FADB6752-E1E5-5DB3-949A-AA4C87AC706F","أبِفَضْلٍ منَ المَلِيكِ ونُعْمَى","أمْ بذ نبِ قد متهُ فجزيتُ؟"],["E8FFB4B1-5263-555B-B674-D64F41E413A6","ينفعُ الطيبُ القليلُ من الرزْ","قِ ولا يَنْفَعُ الكَثِيرُ الخَبِيتُ"],["48D6A65B-CE07-5EFD-B0F1-DE42C07443A7","فاجْعَلَنْ رِزْقِيَ الحلالَ من الكَسْـ","ـبِ وبِرّاً سَرِيرَتِي ما حَيِيتُ"],["4CDAB2F3-24A5-55B4-BDD4-F0DBD6CA2271","وأتَتْنِي الأنْباءُ عن مُلْكِ دَاوُ","فقرتْ عيني بهِ ورضيتُ"],["127D17E5-74F9-58DE-B943-485E244BA564","ليسَ يعطى القويُّ فضلاً من الرزقٍ","ولا يحرمُ الضعيفُ الشخيتُ"],["7F59341C-9F26-5AC9-A488-8453A003A7BC","بلْ لكلِّ منْ رزقهِ ما قضى اللهُ","وإ نْ حّزأّ نفه ا لمستميتُ"]]},"F8D67B92-9EA0-5121-8956-449662DFB8D8":{"t":"ولسنا بأولِ منْ فاتهُ","p":13,"s":"ولسنا بأول من فاته","r":"436183","v":[["9AD44765-2661-5594-BD51-1B404E6B2544","ولسنا بأولِ منْ فاتهُ","على رِفْقِهِ بَعْضُ ما يُطْلَبُ"],["549BC011-E782-55E7-BB1A-BA514E3F2894","وقدْ يدركُ الأمرَ غيرُ الأريبِ","وقد يُصرَعُ الحُوَّلُ القُلَّبُ"],["F03238BB-573B-515C-8B83-F3759F689C29","ولَكِنْ لهَا آمِرٌ قَادِرٌ","إذا حاولَ الأمْرَ لا يُغْلَبُ"]]}}}