{"v":1,"poems":{"022C7894-4BD7-5F93-86E2-6FF41511709F":{"t":"أبإذْنٍ نَزَلْتَ بِي يَا مَشِيبُ","p":88,"s":"أبإذن نزلت بي يا مشيب","r":"466276","v":[["88089806-7236-5F30-8763-749A37C00715","أبإذْنٍ نَزَلْتَ بِي يَا مَشِيبُ","أيُّ عَيش ـ وَقَد نَزَلْتَ ـ يَطيبُ"],["88C40071-B888-59A3-839B-BB25B9DB36B9","وكفى الشيبَ واعظاً غيرَ أني","آملُ العيشَ والمماتُ قريبُ"],["E06B9CCB-91A1-5611-8980-4E733F71B5A6","كم أنادِي الشبابَ إذْ بانَ منِّي","وندائي مولياً ما يُجيبُ"]]},"9FCAE14B-A1D3-5811-BF47-5C2CFBD675D5":{"t":"أرَى أناساً بأدنى الدينِ قدْ قنعُوا","p":88,"s":"أرى أناسا بأدنى الدين قد قنعوا","r":"466334","v":[["8F5094DA-66FB-5879-93CB-D3B799441A35","أرَى أناساً بأدنى الدينِ قدْ قنعُوا","ولاَ أراهمْ رضُوا في العيشِ بالدونِ"],["83BF97A4-E73D-543B-BF80-0DE63B39340A","فاستغنِ بالله عنْ دنيَا الملوكِ كمَا","استغنَى الملوكُ بدنياهمْ عنِ الدينِ"]]},"093F8A7C-AA68-5BDF-9033-A3357B857BD9":{"t":"أرَى النَّاسَ يَبكونَ مَوتَاهمُ","p":88,"s":"أرى الناس يبكون موتاهم","r":"466332","v":[["88ED0763-D9E0-5839-A789-4C32043E6D8A","أرَى النَّاسَ يَبكونَ مَوتَاهمُ","وما الحيُّ أبقَى منَ الميتينا"],["D17FBE22-246F-5D9F-8179-68D4CD2453A9","أليسَ مصيرهمُ للفنا","وإنْ عَمَّرَ القَومُ أيضَاً سِنينَا"],["BC9F7CE3-5F08-5A46-96C8-BEF4BB6102BE","يساقونَ سوقاً إلى يومهِم","فهمْ السياقِ ومَا يشعُرونا"],["3CA24AA4-DDA7-56D8-9465-6E55EE3B73AF","فإنْ كنتِ تبكينَ منْ قدْ مضَى","فَبكّي لِنفسِكِ فِي الهَالِكينَـا"],["82089674-1AD8-5BC8-B943-EFF283DD9C72","فإنَّ السبيلَ لكمْ واحدٌ","سيتبِعُ الآخرُ الأوَّلينا"]]},"FE5C3544-BD98-566A-985B-D19C42689592":{"t":"أفي الجنانِ وفوز لاَ انقطاعَ لهُ","p":88,"s":"أفي الجنان وفوز لا انقطاع له","r":"466296","v":[["2A41C602-C64E-5E96-A64D-50A693DD1337","أفي الجنانِ وفوز لاَ انقطاعَ لهُ","أمْ الجَحيـمِ فَمَـا تُبِقـي وَلا تَدعُ"],["8BA321B0-F166-53AC-BA0C-96BC4AD111D3","تهوي بهلكاتهَا طوراً وترفعهُمْ","إذَا رَجَوا مخرجَا مِن غَمِّهـا وَقَعُـوا"]]},"DDB08721-CF40-558A-B596-2D35EAE5F152":{"t":"ألا إنَّ تقْوى الله أكرمُ نسبَة","p":88,"s":"ألا إن تقوى الله أكرم نسبة","r":"466316","v":[["82AF0F53-931A-5B5E-9484-DC3A1BD76B71","ألا إنَّ تقْوى الله أكرمُ نسبَة","يسَامي بها الفخارِ كريمُ"],["254D6114-2708-5D40-92FC-E4081593D0A8","إذَا أنتَ نَافَستَ الرِّجَالَ عَلَى التُّقَى","خَرجتَ مِنَ الدُّنَيـا وَأنتَ سَليـمُ"],["AE978DE2-908F-5EB1-B3FA-BA54533A1E4C","أرَاك امْرأً تَرجُـو مِن الله عَفـوَهُ","وأنتَ على ما لا يحبّ مقيمُ"],["113EC3D3-356D-5BAC-9092-01D412B96CCD","وإنَّ امرَأً لا يَرتَجِـي النَّاسُ عَفـوه","ولمْ يأمَنوا منهُ الأذَى للئيمُ"]]},"14C57D72-AB26-53CE-AAF0-4669B84B96D4":{"t":"إذَا صَاحَبتَ فِي الأسفَارِ قَوماً","p":88,"s":"إذا صاحبت في الأسفار قوما","r":"466310","v":[["71134C85-F4BD-5331-A274-62AF9B21CC9E","إذَا صَاحَبتَ فِي الأسفَارِ قَوماً","فكنْ لهمُ كذِي الرحمِ الشفيقِ"],["D7A7F534-626C-5515-80C6-6A54F846A82F","بعيبِ النفسِ ذو بصرٍ وعلمٍ","غنيُّ النفسِ عنْ عيبِ الرفيقِ"],["E5CF874F-4F7E-5949-8909-FD326D020F5F","ولا تأخذْ بعثرةِ كلِّ قومٍ","وَلَكنْ قُلْ: هَلمَّ إلى الطَّريق"],["890CF5C8-AB8C-5A41-9B1A-5042A1BB2B2C","فَإنْ تَأخُذْ بِهَفوَتِهمْ تُمَلُّ","وَتَبقَى فِي الزَّمَانِ بِلا صَديِق"]]},"088F86BD-3AC6-57EC-A5BC-F0283FEB1142":{"t":"إذَا مَا الَّليلُ أظلَمَ كَابَدُوه","p":88,"s":"إذا ما الليل أظلم كابدوه","r":"466300","v":[["375A2A32-4B9B-594B-AAD4-15B1BAFC7514","إذَا مَا الَّليلُ أظلَمَ كَابَدُوه","فيسفرُ عنهمُ وهمُ ركوعُ"],["97681EBF-B62B-5A54-87A0-09107E9AA9F2","أطَارَ الخَوفُ نومَهُم فَقَامُوا","وَأهلُ الأمنِ فِي الدُنَيا هُجُوعُ"],["E54A676B-DA5E-5916-B3B0-6AAED0C207C1","لَهُم تَحتَ الظَّلامِ وَهُمْ سُجُودٌ","أنِينٌ مِنهُ تَنفَرجُ الضُّلُـوعُ"],["F833596A-E062-5D49-BB11-7798C9DC8629","وَخُرسٌ بالنَّهارِ لِطُولِ صمتٍ","عليهِم منْ سكينتهمْ خشوعُ"]]},"EC4C6284-D17A-568F-A452-728545B10F59":{"t":"إلَى الله أشكُو لا إلى النَّاسِ أنَّني","p":88,"s":"إلى الله أشكو لا إلى الناس أنني","r":"466304","v":[["D48088EE-41DE-51CB-A50F-228A76100501","إلَى الله أشكُو لا إلى النَّاسِ أنَّني","أرَى صالح الأخلاقِ لا أستطيعُها"],["C8555D50-5CB4-5AD6-BF85-D290C6657932","أرَى خَلَّةً في إِخْوَةٍ وَعَشِيرَةٍ","وَذِي رَحِمٍ مَا كُنتُ مِمنْ يُضِيُعهَا"],["48714C9E-494C-5F0B-AC21-64E07BC71302","فَلو طَاوَعَتني بِالمَكَارِمِ قُدْرَةً","لجادَ عليْها بالنوالِ ربيعُها"]]},"02CA8781-382D-5657-B9F6-2415C5D50A6B":{"t":"إنها دار بَلاَءٍ","p":88,"s":"إنها دار بلاء","r":"466286","v":[["3AEEDEC9-D2CC-5AEE-B73C-A73F306A1C4E","إنها دار بَلاَءٍ","وزوالٍ وغرورِ"],["B89CE9C1-CA3E-5064-B888-55F18B27B40D","كَمْ لَعَمْـري صرعتْ قَب","ـلَكَ أصحَــاب الــقُصُورِ"],["81C09E8C-BA15-5F58-8C76-0486E1E7D3D4","وذوي الهيئةِ في المجـ","لِسِ وَالجَمْــعِ الكَثيــــرِ"],["74F017EE-34D0-5777-9C25-8BB5BB740DD5","أخرجُوا منهَا فمَا كا","ن لَدَيْهــــمْ مِنْ نَكيِـــرِ"]]},"099E67CE-6D28-582F-A96E-6E716B6A2B94":{"t":"إنْ تلبستَ عنْ سؤالكَ عبدَ الله","p":88,"s":"إن تلبست عن سؤالك عبد الله","r":"466340","v":[["2A9AC940-8061-52E4-B108-58D67999ADC5","إنْ تلبستَ عنْ سؤالكَ عبدَ الله","ـله ترجع غداً بخفـيّ حنيـنِ"],["7E3709D2-7F50-5D36-A1EA-511377AC6178","فاعنت الشيخَ بالسؤالِ تجدهُ","سَلِساً يلتقيكَ بالراحتينِ"]]},"C7008888-FD26-53FE-BAD7-8A3E5F38C0E8":{"t":"الصمتُ أزيـنُ بالفتـى","p":88,"s":"الصمت أزيـن بالفتـى","r":"466342","v":[["A6887261-21B3-545B-BA32-E7A250A376F2","الصمتُ أزيـنُ بالفتـى","منْ منطقٍ في غيرِ حينِه"],["F6BF16FC-81AB-5117-BFB6-9620787622F4","والصدقُ أجملُ بالفتَى","فِي القول عندي من يمينه"],["928A8E08-C66C-52F5-BC6F-1BC6AB83C9FE","وعلى الفتـى بوقــاره","سمةٌ تلوحُ علَى جبينِه"],["DFB54B92-1F36-56A6-BC05-7CCE71A6B271","فمن الذي يخفى عليـ","ـك إذا نظرت إلى قرينه"],["644A7C9A-CDF9-5EF6-B996-660F2990C3E4","رُبَّ امـرىء متيقـن","غلب الشقاء على يقينه"],["53AD3A85-1F8D-540B-B46E-0F358DDFEDEB","فأزالهُ عنْ رأيهِ","فابتاع دنيـاه بدينـه"]]},"B2BAA09D-07DE-5607-B34A-BEBADFB05F36":{"t":"بُغْضُ الحَيَاةِ وَخَوفُ الله أخرَجَنِي","p":88,"s":"بغض الحياة وخوف الله أخرجني","r":"466330","v":[["CF441095-17A8-517A-B8F7-E39784426E66","بُغْضُ الحَيَاةِ وَخَوفُ الله أخرَجَنِي","وَبَيـعُ نَفسِي بِمَـا لَيسَتْ لَهُ ثَمَنَـا"],["2EBED6F6-D391-56E1-9E04-78ADA0CFEBF7","إنِّـي وَزَنتُ الـذِي يَبقَـى لِيَعدِلَهُ","مَا لَـيسَ يَبقَـى فَلا والله مَا اتَّزَنَـا"]]},"C699C817-B73C-5CC4-88A0-A3DBE13FCAC2":{"t":"تعصى الإله وأنت تُظهر حبه","p":88,"s":"تعصى الإله وأنت تظهر حبه","r":"466302","v":[["191F8732-01F7-5C16-A9CF-168DB26AEC45","تعصى الإله وأنت تُظهر حبه","هذا لعمري في الفعال بديعُ"],["9061AB76-99D3-50B6-B204-4E443862BBD4","لو كان حبك صادقاً لأطعته","إنَّ المحب لمن يحب مطيعُ"]]},"FC30AABC-2BA8-581C-9229-297C3C4283BA":{"t":"تنعَّمَ قومٌ بالعبادَة والتقَى","p":88,"s":"تنعم قوم بالعبادة والتقى","r":"466284","v":[["043E570D-CD25-5D45-BCC9-D4BEAC64AFA4","تنعَّمَ قومٌ بالعبادَة والتقَى","ألَذَّ النَّعِيـمِ، لاَ الَّلذَاذةَ بالخَمرِ"],["8857EBA7-D5F6-5416-812B-E19AF5076B1E","فقرَّت بهمْ طولَ الحياةِ عيونهمْ","وكانتْ لهمْ والله زاداً إلى القبرِ"],["EA0EB57D-95EF-5482-B463-F9E7C140B3B2","على برهةٍ نالوا بهَا العزَّ والتُّقى","ألا وَلَذِيذَ العِيش بِالبرِّ والصبَّرِ"]]},"B1AF1BC5-BDD1-5644-8025-E2B8BF9CEDAE":{"t":"تَذَكَّـرتُ أيَـامَ مَن قَدْ مَضَى","p":88,"s":"تذكـرت أيـام من قد مضى","r":"466328","v":[["3BB69A74-0F53-50E4-915C-C6D0F2A17689","تَذَكَّـرتُ أيَـامَ مَن قَدْ مَضَى","فهاجَ لي الدمْع سحاً هتُونا"],["234C76D5-E37D-5D7F-9DD7-DE88273E4424","فرددتُ في النفسِ ذكراهمُ","ليحدثَ ذلكَ للقلبِ لِينا"],["05886A80-4A2F-59C1-B1B6-E00C793854E4","حَنيـنُ عِشَارٍ تُحبُّ الحَنينَــا","وإخوان صدقٍ لحقنَا بهمْ"],["9E216E8F-988B-55F5-8194-82ED9BF2A347","فقد كنتُ بالقرب منهُم ضنينا","وَأوحَشَت الدَّارُ مِنْ بَعدِهم"],["E73807B9-CA75-5FDD-AE9F-E75BE4739086","أظَلُّ عَلى ذكرِهـم مُستَكينـا","وَإن كُنتِ بالعَيشِ مُغَتَّرةً"],["FDF6C751-2D1C-5CE2-9887-CEAA9B71A81A","تُمنِّيك نَفسُكِ فِيهَا الظُنِونَـا","فنادي قبورك ثمَّ انظري"],["A41081FA-381E-512C-AF52-8EE79438A04F","مصارعَ أهلك والأقربينا","إلى أينَ صَارُوا وَمَاذَا لَقُوا"],["74AB8F76-450F-5638-8DF9-3992AD029699","وَكَانُوا كَمثْلكِ فِي الدُّورِ حِيناً","وأينَ الملوكُ وأهلُ الحجَا"],["F23B4AB4-B5BA-52C6-92F0-AEE94C750DA9","ومنْ كنت ترضين أو تحذرينَا؟","وَأينَ الذينَ بَنَوا قَبلَنَا"],["CDBEA4B4-C5E0-5B1A-9E42-AB45009F1F3A","قروناً تتابعُ تتلُو القرونا؟","أتيتُ بسنين قد رمتا"],["A2F76A72-7A93-558D-BA3B-6A7625FBA2D5","منَ الحِصنِ لما أثاروا الدفينا","على وزنِ منين إحداهما"],["ADA79AFF-02AF-56D6-BC22-A72B44A0B33C","تقلُّ به الكفَّ شيئاً رزينا","ثَلاثينَ أخرىَ عَلَى قَدرِها"],["7806B021-3D8E-5C71-9DB8-63FFDD9C271C","تَبـارَكتَ يَا أحسَنَ الخَالِقينَــا","فَمَاذَا يَقُومُ لأفْوَاهِهِمْ"],["7AA4D755-B0BD-59CC-8C4C-B3A2E6126340","وما كانَ يملأ تلكَ البطُونا","وَكلّ عَلَى ذَاكَ لاقَى الرَّدَى"],["CDDF3006-18CE-5F25-AF57-AD58F12F1924","فبادوا جميعاً فهمْ خامدونا",""]]},"576621F5-9473-5DC4-ADBA-B2396E2FA138":{"t":"دنيَا تداولهَا العبادُ ذميمةً","p":88,"s":"دنيا تداولها العباد ذميمة","r":"466312","v":[["8A75E9B3-46F0-5293-A0AF-86A17FA9BFE2","دنيَا تداولهَا العبادُ ذميمةً","شِيبَت بأكرَهَ مِن نَقيـعِ الحَنْظَـلِ"],["A034C17B-33F6-5768-8152-140AC37CBE96","وَبَنَـاتُ دَهـرٍ لا تَزَالُ مُلِمَّـةٌ","فيها فجائِع مثلَ وقعِ الجندلِ"]]},"FB91D3FC-CF3B-599C-9C93-B2EEEB1CBD06":{"t":"رأيتُ الذنوبَ تميتُ القلوبَ","p":88,"s":"رأيت الذنوب تميت القلوب","r":"466324","v":[["88CF23CE-8917-5602-9EC8-2DC76DFB0EFC","رأيتُ الذنوبَ تميتُ القلوبَ","ويُتْبِعُهـا الــذُّلَّ إدمَانُهــا"],["E90F1833-0724-5CBE-8FC7-00E4FEE827A5","وتركُ الذنوبِ حياةُ القلوبِ","وخيرٌ لنفسكَ عصيانُها"]]},"4FA23AA5-8685-5953-8CAB-BF3A02EB874F":{"t":"رَأيتُ أبَا حَنيفَةَ كُلَّ يَومٍ","p":88,"s":"رأيت أبا حنيفة كل يوم","r":"466282","v":[["9CB51ECF-03AC-5EF4-A3A9-3A676BB714FC","رَأيتُ أبَا حَنيفَةَ كُلَّ يَومٍ","يزيدُ نبالةً ويزيدُ خيرا"],["563BCCDA-1BF3-5B25-B1F0-839463CE4D2F","وينطقُ بالصوابِ ويصطفيهِ","إذا ما قالَ أهلُ الجورِ جُورا"],["F5B74512-C4C0-5A24-B8BC-8966E3D0EBB9","يقايسُ منْ يقايسهُ بلبٍّ","فَمَن ذَا يَجْعلُون لَهُ نَظيرَا"],["60474DA9-97DB-5D4A-9518-342748249785","كَفَانَا فَقْد حَمَّادٍ وَكَانَت","مصيبتنَا به أمراً كبيرا"],["4A536604-F1F6-562E-8A0A-9ABAB7B6ED1A","فردَّ شماتَة الأعداءِ عنَّا","وأبدَى لعبدهُ علماً كثيرا"]]},"92FAAEC6-CEAF-5D8E-B619-9D2FF25EC8B3":{"t":"عَجِبتُ لِشَيطَانٍ أتَى النَّاسَ دَاعِيـاً","p":88,"s":"عجبت لشيطان أتى الناس داعيـا","r":"466318","v":[["BE57B126-090C-50CF-BC03-BDE60B49C072","عَجِبتُ لِشَيطَانٍ أتَى النَّاسَ دَاعِيـاً","إلى النَّارِ واشتُقَّ اسِمُهُ مِن جَهَنَّـمِ"]]},"3A8F0D78-35E5-540F-847F-A26CD534B48D":{"t":"غايةُ الصبْر لذيذٌ طعمهَا","p":88,"s":"غاية الصبر لذيذ طعمها","r":"466288","v":[["FBE8C719-3448-5285-8F0D-9BD0E9490A74","غايةُ الصبْر لذيذٌ طعمهَا","ورديءُ الذوقِ منهُ كالصبرْ"],["18CAF2BE-C8EC-5AA0-B47F-DEAD9F5A241A","إنَّ فِي الصَّبرِ لَفِضلا بَيَّنَاً","فاحملِ النفسَ عليه تصطبِر"]]},"5C64837F-D919-5434-840B-417C277D4465":{"t":"قدْ يفتحُ المرءُ حانوتاً لمتجرهِ","p":88,"s":"قد يفتح المرء حانوتا لمتجره","r":"466338","v":[["9AEFF4DB-60D4-511F-8FB7-6F85D477F317","قدْ يفتحُ المرءُ حانوتاً لمتجرهِ","وقدْ فتحتَ لكَ الحانوتَ بالدينِ"],["9C57CE34-A441-597E-8D15-617469909EE5","بينَ الأساطينِ حانوتٌ بلاَ غلقٍ","تَبتَاعُ بِالدينِ أموَالَ المَسَاكِيـنِ"],["F7DE019E-CA2B-5585-91CB-BB052A4C4464","صَيَّرت دِينَكَ شَاهِيناً تصيدُ به","وليس يُفلِحُ أصحابُ الشَواهِينِ"]]},"E8CF91F7-EA7B-52F7-AB43-4B4F592B67C4":{"t":"قص أيَضمَنُ لِي فَتىً تَرْكَ المَعَاصِي","p":88,"s":"قص أيضمن لي فتى ترك المعاصي","r":"466294","v":[["B07F1E1E-4E9B-5C35-80A9-266334F96114","قص أيَضمَنُ لِي فَتىً تَرْكَ المَعَاصِي","وأرهنهُ الكفالةَ بالخلاصِ"],["6CF168F4-7908-5795-8C3E-C2257DB75764","أطَاعَ الله قومٌ فَاستَراحُوا","ولمْ يتجرعُوا غصصَ المعَاصي"]]},"4C7A7270-EE3F-55C1-94D7-AA45FC88BBEB":{"t":"كلُّ عيشٍ قد أراهُ نكداً","p":88,"s":"كل عيش قد أراه نكدا","r":"466292","v":[["4754BD99-9A5B-5C23-9841-58B0D0DA5635","كلُّ عيشٍ قد أراهُ نكداً","غَيـرَ رُكنِ الرُّمحِ فِي ظِلِّ الفَرَسْ"],["66E6CAEE-9EE3-5523-A8AB-F7015CB4EE4D","وقيامٍ في لَيالٍ دجُنٍ","حَارساً للناس فِي أقصىَ الحَرَسْ"]]},"306942D9-B903-5ED8-8986-C6649220A023":{"t":"لاَ خيرَ في المالِ لكنازهِ","p":88,"s":"لا خير في المال لكنازه","r":"466278","v":[["280343B3-6B6E-55DA-9F60-51B14106F206","لاَ خيرَ في المالِ لكنازهِ","إلاَّ جوَاد الكفِّ وهابهِ"],["42ED4F48-2750-5462-8A88-4528D4BC81D6","يَفعَلُ أحيانـاً بِزُوَّارِهِ","ما يفعلُ الخمرُ بشرابهِ"]]},"E1CB18A8-655C-5C14-BC3B-976D3202D435":{"t":"لقدْ زانَ المسلمينَ وما عليهَا","p":88,"s":"لقد زان المسلمين وما عليها","r":"466344","v":[["CD675839-39BB-5FAA-A461-C8AB93BC3672","لقدْ زانَ المسلمينَ وما عليهَا","في الناس محمدة بلينـه"]]},"33DC795C-771B-5671-BD1D-E8F8A711AF27":{"t":"لله دَرُّ القُنُوعِ مِن خُلُقِ !","p":88,"s":"لله در القنوع من خلق !","r":"466308","v":[["33BAACB8-BE4B-5397-B5FD-509129C9D42B","لله دَرُّ القُنُوعِ مِن خُلُقِ!","كمْ منْ وضيعٍ بهِ قد ارتفَعا"],["1153CB9E-7AD9-5063-809E-1B957776B9EA","يَضيقُ صدَرُ الفَتَى بِحاجَتِه","ومنْ تأسَّى بدونهِ اتسَعا"]]},"78AD582E-2E81-5CAB-9B43-A9AFD144C98B":{"t":"ما بـال ديـنك ترضى أن تدنـه","p":88,"s":"ما بـال ديـنك ترضى أن تدنـه","r":"466290","v":[["6A56A441-C6C1-586B-876A-380F08A7ACCA","ما بـال ديـنك ترضى أن تدنسـه","وثوبكَ الدهرَ مغسولٌ منَ الدنسِ"],["F6E7BAC9-4CC0-52E9-AB89-D54AFDD11F67","ترجو النجاة ولم تسلك طريـقتها","إن السفينـة لا تجري على اليـبس"]]},"884A376F-D4B6-51B4-9BA2-4D642ADA4C8F":{"t":"منْ كانَ ملتمِساً جليساً صالحاً","p":88,"s":"من كان ملتمسا جليسا صالحا","r":"466320","v":[["9652CB0C-242B-5B5E-9E69-FFE799573A14","منْ كانَ ملتمِساً جليساً صالحاً","فَليَـأتِ حَلقَـةَ مِسعَـر بن كِدَامِ"],["16F769D8-85E5-5C29-A4FD-6D4E0C44F5D2","فيهَا السكينَةُ والوقارُ، وأهْلها","أهـلُ العَفَـاِف وَعليَـةُ الأقـوَامِ"]]},"13DCC342-363A-52B9-A48D-C86F028AA639":{"t":"همومكَ بالعيشِ مقرونةٌ","p":88,"s":"همومك بالعيش مقرونة","r":"466322","v":[["EF94DF2A-B09A-5066-8958-F1708C82AFC1","همومكَ بالعيشِ مقرونةٌ","فمَا تقطع العيشَ إلاَّ بهمْ"],["0BA8A1EB-3CFE-5291-9965-7C7DC38929BF","إذا تمَّ أمرٌ بدَا نقصهُ","ترقبْ زوالاً إذا قيل تمْ"],["75AC69DF-4982-566D-9B70-2D489889419F","حلاوةُ دنياكَ مسمومةٌ","فمَا تأكلُ الشهدَ إلاَّ بسَمْ"],["36CEBB05-08F8-5BFB-9948-FE413A605677","وكان الـذي نالهم كالحلـم","صلوا بالجحيم وفـات النـعيم"]]},"A024151F-4297-5A45-9625-BF44144B949B":{"t":"وهلْ أفسدَ الدينَ الملوكُ","p":88,"s":"وهل أفسد الدين الملوك","r":"466326","v":[["953C33CC-3ED2-5040-AE04-406EC5D77041","وهلْ أفسدَ الدينَ الملوكُ","وَأحبــارُ سُوءٍ وَرُهبانُهـــا"],["3E2B2C5A-5F6A-5AF4-9E67-0433BE37AC4C","فباعُوا النفوسَ ولمْ يربحَوا","ولمْ تغلُ في البيعِ أثمانهُا"]]},"2ACEE2EB-07B1-5669-9BF9-3C3C4E88C12F":{"t":"وَفَتـىً خَلاَ مِنِ مَالَـه","p":88,"s":"وفتـى خلا من مالـه","r":"466314","v":[["14FB61B3-AB2C-5583-8CD5-8C1581BB002C","وَفَتـىً خَلاَ مِنِ مَالَـه","ومنَ المروءةِ غيرُ خالِ"],["543D2B6D-148C-5CA3-B19D-26F8034D6FCD","أعطاكَ قبلَ سؤالهِ","وكفاكَ مكرُوه السؤالِ"]]},"E1051A7D-DEA5-5C7D-9C42-BA3EB9625EAC":{"t":"وَمِن البَلاءِ وَللَبلاءِ عَلاَمةٌ","p":88,"s":"ومن البلاء وللبلاء علامة","r":"466298","v":[["9786EE37-DB12-5F5F-95B4-4EAFEDE86488","وَمِن البَلاءِ وَللَبلاءِ عَلاَمةٌ","أنْ لا يرَى لك عنْ هواكَ نزوعُ"],["4E909D35-DC3A-57C5-A169-87FBE19C9216","العَبدُ عَبدُ النَفسِ فِي شَهَوَاتِها","والحرُّ يشبعُ مرةً ويجوعُ"]]},"5CAEDF68-C8AD-5BD3-9081-6393D937C179":{"t":"يا جاعلَ العلمِ لهُ بازياً","p":88,"s":"يا جاعل العلم له بازيا","r":"466336","v":[["556AD855-8947-5B90-97FF-1EFF49172490","يا جاعلَ العلمِ لهُ بازياً","يَصِيــدُ أمـوَالَ المَساكِيــنِ"],["B24FFACA-C2DE-5C13-AF87-EC4983232550","احتلتَ للدنيَا ولذاتهَا","بحيلــةٍ تَذهَبُ بالديــــنِ"],["0608E68B-A0A7-56FC-B294-6DA80A75014F","وَصِرتَ مَجنُونـاً بِهَـا بَعدَمَـا","كُنتَ دَوَاءً لِلمَجانِيـــــنِ"],["9E2BB2C9-82A4-593F-AB00-D44031C1C46F","عنِ ابنِ عونٍ وابنِ سيرينِ",""]]},"E2E01AD1-9AB2-54EA-906E-83B2F0C5A01B":{"t":"يا طالبض العلمِ بادرِ الورعَا","p":88,"s":"يا طالبض العلم بادر الورعا","r":"466306","v":[["FA7D42FA-0E43-5C2C-833B-DD968D5A25E7","يا طالبض العلمِ بادرِ الورعَا","وَهَاجر النَّومَ وَاهجُر الشبَعَا"],["841AFDB1-D711-5ECD-8041-59574280765A","يا أيهَا الناسَ أنتمُ عشبٌ","يحصدهُ الموتُ كلَّما طلَعا"]]},"32D3D2AD-1837-54CE-9E87-8FFF5FD118F5":{"t":"ياعابدَ الحرمينِ لوْ أبصرتناَ","p":88,"s":"ياعابد الحرمين لو أبصرتنا","r":"466274","v":[["B3C012C0-25D8-56C1-ACA6-D5DFE646306F","ياعابدَ الحرمينِ لوْ أبصرتناَ","لَعَلِمتَ أنَّك فَي العِبَادَةِ تَلْعَبُ"],["7A73E8AD-6CF8-5178-8EEA-F0372260A06F","من كان يخضِبُ خدّه بدموعِه","فنُحورُنا بدمائِنا تَتَخَضَّبُ"],["78369B7B-8631-5C2F-A6B8-1EDF21F405D4","أوْ كانَ يُتعبُ خيلهُ في باطلِ","فخيولُنا يومَ الصبيحةِ تَتعبُ"],["A994E39C-EC48-5051-99F2-1DFA214A3661","ريحُ العَبِيرِ لَكُمْ وَنَحنُ عَبِيرُنَا","رهجُ السنابِكِ والغبارُ الأطيبُ"],["57D5EFF3-EAB2-530F-BD24-74B2087E89D0","ولقدْ أتانَا منْ مقالِ نَبينَا","قَولٌ صَحِيحٌ صَادِقٌ لا يَكْذِبُ"],["6CF37794-7D75-50C4-B2A3-C819C6CF977A","لا يَستَوي غُبَارُ خَيِل الله فِي","أنْفِ امرِىء وَدُخَانُ نَارٍ تَلْهَبُ"],["13088815-BFB6-5EA1-8569-031A1B1D7890","هَذَا كَتَابُ الله يَنْطِق بَيْنَنَا","ـ لَيْسَ الشَّهِيدُ بِمَيِّتٍ ـ لاَ يَكْذبُ"]]},"687C9DCF-EA82-5C09-BCDB-C92C7533570C":{"t":"يَدُ المَعرُوف غُنمٌ حَيثُ كَانَت","p":88,"s":"يد المعروف غنم حيث كانت","r":"466280","v":[["B6125400-BEB5-5524-9B97-14FB1838C6E0","يَدُ المَعرُوف غُنمٌ حَيثُ كَانَت","تَحمَّلَهَا شَكُورٌ أو كَفُورُ"],["7247A433-0C65-54BB-9839-64B0F6DA50D9","ففي شكرِ الشكورِ لها جزاءٌ","وعندَ الله ما كفرَ الكفور"]]}}}