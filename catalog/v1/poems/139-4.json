0A4-5438-8E7F-A936A23F0A8A","وجد شانيك مخفوض فكان لهم","عقاب خسف مبين الزجر والطيرة"],["7E11D272-E3D6-5D85-93A1-00883FC0D0F7","سعي تركت به أرض العدى نهجا","لمن سعى في مداه واقتفى أثره"],["3868420D-34C0-597C-A375-849165872F00","فهل لنفس ابن شنج بعدها عوض","من لب لبس أو من كافر الكفره"],["8F713B43-AD5A-5F1E-9B7F-86D760820D93","صنواه في حربه أو في ضلالته","قد كان ذا سمعه فيها وذا بصره"],["72A23EFE-17C2-50CF-B8AB-D8BE61BE969A","وفت دماؤهما ثأرا فلم يدعا","للمسلمين على حرب الضلال تره"],["24A22F74-180D-5245-B205-68C72F1AC4F7","فليهنك اليوم فتح تقتفيه غدا","عوائد من فتوح الله منتظره"],["7C1578CE-D8C4-58D7-BC78-18364BC4BCE1","بضائع لك من بأس ومن كرم","محفوظة لك عند الله مدخرة"],["6A3A92BA-A6BD-5D55-AB12-60C9950307CE","سلمتها في سبيل الله وافية","فناجز النقد أو مستقرب النظرة"],["C5D899C1-D0A3-571E-BF3B-50D4E70909CE","وابشر بأخرى وأخرى واعدت فوفت","بوعد ذي العرش في نعماء من شكره"]]},"F0924849-594A-5049-BD85-8BA157A11DED":{"t":"وفي سر من را من محلي مقاصر","p":139,"s":"وفي سر من را من محلي مقاصر","r":"441631","v":[["EE7EDAFF-07EC-5C8C-8DF0-E0A0270A5078","وفي سر من را من محلي مقاصر","تلاعب فيهن الظباء الجآذر"],["2F808FB1-2ECE-52ED-A79B-DDDDB3365F02","وتزهى بها من صنو دجلة لجة","تحلل منها الروض جار وجائر"],["60510EC0-EDA5-5778-958C-472D606723AC","حدائق جنات نضائر زانها","تقلب أحداق إليها نواظر"],["15D79DD0-AC95-5FA3-A001-D063EAE469C2","مشابه حسن ما لهن مشابه","نظائر شكل ما لهن نظائر"],["F51AECFA-9294-5F0E-96F7-1568C644F11D","ثلاث كأطلاء الظباء روائع","ولا شبه إلا الطلى والنواظر"],["B5B29689-9442-54DA-8352-BB7F18395B4D","نماها إلى الأرءام روم وجلق","وأرضعها منهم سليم وعامر"],["3417DFDE-140A-573C-B0D3-97A9D63DD9F7","لتأثر عنا كلما فاه خاطب","وأغرب رجاز وأبدع شاعر"],["5189927A-B9A7-5178-A89B-304440D8C950","إذا أجرت الأقلام عنهم بمنطق","أرتك بطون الصحف وهي أزاهر"],["60EE3758-CED2-5AF9-B824-B8FBDE431BC2","يذكرنني ما أنت عني مبلغ","خواطب أحياء وهن منابر"],["27ED2622-C9D7-572B-A698-E1BD8D44B5BA","بترجيع ألحان كأن حنينها","لما أنا من آثار مجدك ذاكر"],["7A06BB54-F948-5912-8B7B-F920A56A9F68","ويذهلني عن سحر ما في جفونها","...... بتفاح..... سواحر"],["3FFE0241-C52D-5148-9A0F-AC7361EDA44D","تطاردها في الجو نزوا كأنها","نوازع........ وبوادر"],["92CD704D-EEB1-5B8C-B315-CFE9765AFAE6","نسور تهادى بالسرور وإنني","لها بالذي يهدي السرور لزاجر"],["75BEF1CB-A86E-535B-85BA-45A86548A051","وإن بدلت منها السكاكين خلتها","غماما..... دى..... صائر"],["39B2E2F7-AACE-5467-B828-95F6C76C9D11","وإن قام باسطر لا بها يد بعضها","فكيوان أو بهرام......."],["69CC7A5B-FB24-5D19-A359-669CCFBCF5AD","يخبرني أن قد تبينت أنني","لمعروف ما تسديه نحوي شاكر"],["380CFD45-34F0-5A7B-BC41-D02566BE0CE9","وأنك موصول السعود بغبطة","يطاولها في عمر أمرك عامر"],["31CFE6FF-648D-56AD-BC45-3B6929097403","وحييت مني كل يوم تحية","تسير بها الركبان ما سار سائر"],["9F2A0622-E5F7-52C1-B3B6-32FCABF9F5D7","يلوح بها نجم من الأفق طالع","ويرجعها لي منك ما غار غائر"]]},"3CA173C9-C134-571C-A3C0-DED43F324D4A":{"t":"وفي غيابات أطباق الخطوب شج","p":139,"s":"وفي غيابات أطباق الخطوب شج","r":"441629","v":[["B5969BC7-F8CD-5AF9-A084-78E669F06B66","وفي غيابات أطباق الخطوب شج","بالبين ييأس أحيانا وينتظر"],["3BB0A09D-9ADB-565D-B521-921F0644FA33","مظاهر بين ليلي كربة ودجى","لا يرتجى لهما فجر ولا سحر"],["58D52B42-05D5-58EF-AF7A-31F9E0012F4C","قد أخرس الدهر منه منطقا هتفت","عنه الرزايا ألا غاد فمعتبر"],["593F8733-E558-5AD0-B682-A57D07C5D2F8","لمعتلي همة بين النجوم هوت","به النجوم برزء ما له وزر"],["3E28ABCF-373D-56DC-B150-E53F57025F47","وتلك آثاره بالمشرقين سنا","للعين والعين لاحظ ولا أثر"],["6446BAA6-4297-5A98-AEA8-00E71CAE1C3E","حان على كرش منثورة سلب","يكاد من شجوهن النجم ينتثر"],["F9BECEDE-CBA5-5D06-AD0A-7FA1E0991EC5","أبرزن من ستر الإكرام وانسدلت","من الهوان علينا بعده ستر"],["55B467C7-E420-5ACB-98C8-A01F04AE67CF","يخفي التعفف مثوانا فليس لذي","أنس إلى وحشنا سمع ولا بصر"],["B4EAF2CF-E655-5D08-BB98-C89F43D865FF","ولا يد غير أيدي الظلم تعرفنا","ولا بغير دموع العين ننتصر"],["D6EFBA2E-227A-516F-A987-A90FD2DAA9D7","نرعى الهشيم ونمتص الثمار وقد","أظل أنهارنا الأغصان والثمر"],["1C2BA683-172A-5B78-B26D-77AB443EEACB","والأرض مضجع أبشار ممهدة","لها الأرائك في الأكنان والسرر"],["5B057956-C2F1-521A-A540-047D1ECBE177","وتحت أجنحة الإشفاق حانية","حمر الحواصل لا ماء ولا شجر"],["96F7AACF-C2E4-56D3-8490-EB05BD01E915","إذا تضرم بالشكوى تحلللهوجه بماء الحياء العد ينفجر","وهل بسمعك يا يحيى حييت لنا"],["C9143B3D-47FF-55A3-A51D-E5128C2D07D8","عن دعوتي زور أو عنك لي وزر","وهل بمدحك أستقضيك عارفة"],["15736AEE-13D5-5CF6-885F-1B5B67EEDF79","بل الغمام بطبع السكب ينهمر","وإن أولى بمهد فيك مدحته"],["9F066936-E0E0-588D-95F7-24D15FCD0AAA","لو جاء قبل من التقصير يعتذر","وأين نظمي ونثري من حلى ملك"],["4BFC76C6-6286-5EEC-93CD-038F45CBFD65","تتلى بمفخره الآيات والسور","وكيف يبلغ سبقي في مدائحه"],["2AC55A4D-9A1D-54BB-A9BB-72EAA68A02C4","مدى تقاصر عنه الجن والبشر","ليهنك الفطر والأعياد تتبعه"],["368098EE-3A5E-54A2-BBC2-DB55C01E790C","في عز ملكك ما في صفوه كدر","والنصر متصل والفتح مقتبل"],["28E334A1-874C-5205-BA25-A689AA0814BE","سار فمدلج غاد فمبتكر","وقد تسابقت البشرى إليك بما"],["00D25662-10BA-5E11-8DDD-AD3F2D587A9E","به توالت إلى أعدائك النذر","فالبس ثياب ثناء حلي عاتقها"],["5F7B99FE-1CCA-5B2A-AD39-DB7B82E195C5","سيف على الثغر لا يبقي ولا يذر","لعلنا نرد الماء الذي صدرت"],["0E5B4C9A-E5CA-5457-A1D9-2470D77131D8","عنه الحوائم وردا ما له صدر","وتنجلي ظلمات الخطب عن أمم"],["2675F7B0-EA03-5C74-B244-4C1452E189EA","لا الشمس آفلة عنها ولا القمر","بأوجه الفاطميين التي شهدت"],["CA9268BE-BF75-553D-8544-084B72A611EB","شمس الضحى أنها في وجهها غرر",""]]},"B8C99C91-2DCF-5EB0-A2BB-810B8E0F63A9":{"t":"ولا في سرور العيد نحن مهنوه","p":139,"s":"ولا في سرور العيد نحن مهنوه","r":"441431","v":[["AD48B329-D587-5314-BB38-D082967B36E9","ولا في سرور العيد نحن مهنوه","ولا في سرير الملك نحن محيوه"],["4F06F6D8-135D-5908-A0DE-FDB1E45DDA43","لهفي عليه والكماة تهابه","ولهفي عليه والملوك مطيعوه"],["EEA83099-A0B3-5DE4-9223-3A4AFCDB52F2","ولهفي عليه والوعى تستخفه","ولهفي عليه والكتائب تقفوه"],["0D1BB395-FE96-515B-B8FA-86D7E54B142C","ولهفي عليه والضيوف تزوره","ولهفي عليه والركائب تنحوه"],["42BC6FD0-059B-56F1-9593-98F586CC529E","ولهفي عليه والأماني تؤمه","ولهفي عليه والخلائق ترجوه"],["9DDF0767-5B29-5A87-B2F0-23363F35145E","ولهفي عليه والمصاحف حوله","يخط كتاب الله فيها ويتلوه"],["1AB357DE-17F1-51CE-ABE9-DBA9D0880A71","ولهفي عليه حاضرا كل مسجد","وداعوه أشياع له ومصلوه"],["03D543D9-8348-54BC-82A5-C5C089DE113B","تلهف قلب ليس يشفي غليله","سوابق دمع لاعج الحزن يحدوه"],["3B6BF505-CDDF-55A4-ADA4-C22CFA28214F","وأشكو إلى الرحمن ترحه فجعة","بمن لم يبت داع إلى الله يشكوه"],["67484813-7778-5687-9DE4-2DBBFEB9B698","وادعو لديه فوز روح وراحة","لمن لم يزل يدعو إليه ويدعوه"],["8E0E76DA-324D-5C59-98EE-CA8B97D66668","وإن جل فينا فقده ومصابه","ليبلونا في الصبر عنه ويبلوه"],["539EA028-C288-5EA4-AFF1-DBA7E004A383","فقد عوض الإسلام من فقد نفسه","هلال سماء لا يضل مهلوه"],["4D754931-3FED-56D7-9370-C233BCF6C77F","وبحرا سقاكم ري جود وأنعم","فسقوه إخلاص الصدور وروه"],["B257B230-D291-5379-A83A-69B10302B3AF","وسيفا حباكم صفحه ومضاءه","فصوغوا له حر الوفاء فحلوه"],["5A7F138A-6839-5B9E-B27E-A570B6ED4109","فقد حتم الدهر الذي حل خطبه","بأن ليس إلا بالمظفر يجلوه"],["213EAEE8-2BE6-5F28-9EFC-87629793D248","ومن كان لا يعدو الرياسة سعيه","فليس تباشير الرياسة تعدوه"],["1346E43D-2021-5679-9BBE-082A8E5378AF","بهدي من المنصور ليس يضيعه","على سنن من سعيه ليس يألوه"],["319E3593-A272-5463-B400-7C458BF3AE5F","فلولاك يا يحيى لهدت لفقده","ذرى علم أذواؤك الغر بائوه"],["6A81D8C1-E9F4-5787-B2C2-9E6C2E62ACA9","ولولاك يا يحيى لمات بموته","رجال بأحرار القلوب مواسوه"],["B153B779-3F00-5D91-8E4F-A1E74F58CDA4","وما رغبوا عن نفسه بنفوسهم","وقد ذاق طعم الموت حتى يذوقوه"],["354ACEAE-0153-542E-87C9-20D5ECAD1CA0","وودعت الأرواح عند وداعه","وضل سبيل الصبر عنه مضلوه"],["614B20DD-84A0-50E7-AE85-3D5EEA624116","وقلبت الدنيا قلوبا وأنفسا","فلا العيش محبوب ولا الموت مكروه"],["44CFBF33-0F68-5691-B2BF-755E8C29D493","فلا فضنا دهر وأنت تلمنا","ولا مضنا جرح ويمناك تأسوه"],["4AA12426-5A9A-5D6B-9D16-1CAAEBF043EF","ولا وقي الإشراك ما منك ينقي","ولا عدم الإسلام ما منك يرجوه"]]},"4BD55DA1-12BE-54F6-8F46-45FDD82C3003":{"t":"وما أسفي إلا على فوت رتبة","p":139,"s":"وما أسفي إلا على فوت رتبة","r":"441641","v":[["55969CF9-F0A6-575A-BB6C-0CCF230D830B","وما أسفي إلا على فوت رتبة","عهدتك فيها ناديا أو مناديا"],["3EF71782-80F5-5E27-8F14-853150372F80","وكون مكاني من سمائك عاطلا","ولولا مكاني الدهر ما كان حاليا"]]},"9F66D401-17AD-567F-A150-70F0256E9773":{"t":"ومحق الشهر كمال البدر","p":139,"s":"ومحق الشهر كمال البدر","r":"441635","v":[["0F0516B8-DA7A-5D70-B8D1-B2C558EF4486","ومحق الشهر كمال البدر","فلاح في أولى الصباح النضر"]]},"FFCC04EA-4C69-5D38-AF6B-D9BC2C2B283C":{"t":"ونيلوفر قمن بالذبول","p":139,"s":"ونيلوفر قمن بالذبول","r":"441396","v":[["51DF6111-6781-5BA4-8D26-319F1E658D4B","ونيلوفر قمن بالذبول","يروق فيذبل عما قليل"],["4A8CC965-F7FC-5B09-A80F-C11A919C71C8","يلاقي الصباح بيمنى جواد","ويخفي الظلام بيمني بخيل"],["1C7A7FEA-CA45-52D3-8165-8822B45C1A85","يليح الضحى ما حوى من نسيم","ويمنعه عند وقت الأفول"],["859B987F-092B-5796-825F-4CA414B191FB","ألم ير عبد المليك المليك","مجيب الرجاء ومعطي الجزيل"],["554E686B-6FA9-5D5A-818C-2B9725304F89","لو ازدادت الأرض عرضا بعرض","ولو وصل الدهر طولا بطول"],["2AA95213-2753-579E-81FF-E4E97BADBEBC","لما زال يوسع هذا وتلك","بفعل كريم وذكر جميل"]]},"57441E07-4BC0-571B-A543-F37F8831D445":{"t":"ويوم كسوتها رهج المصلى","p":139,"s":"ويوم كسوتها رهج المصلى","r":"441621","v":[["C78169B6-4084-589A-9784-3844931AB45B","ويوم كسوتها رهج المصلى","تناديها المنى أهلا وسهلا"],["B48E0A3B-00DF-548B-83F0-5D62DBFB41D5","مجللة هواديها بعز","يجلل أوجه الأعداء ذلا"],["2318622D-60E2-51A2-A252-5D23372CCDAB","إذا ضل العجاج بها هداها","جبينك أن تعرج أو تضلا"],["06ED1CBE-E850-5F8C-BC29-B46BA220B4E7","وقد نشقت رياح النصر تزجي","غمام الموت أبرق فاستهلا"],["29A26999-6DE9-594F-B7AF-C43B20442186","شوازب كالقداح مساهمات","ضربت بها العدى حزنا وسهلا"],["04C7187F-04FA-5045-9D3B-9303E13809F4","وكنت نصيحها سرا وجهرا","وكنت أمينها قولا وفعلا"],["031BC833-E55B-5474-994D-661E0B088EC5","وكنت ولي حكم الله فيها","تنير بنوره صدقا وعدلا"],["36C4882A-0A21-5978-8F4C-8510006DA925","فحاز الغدر أخيبها سهاما","وطبت ففزت بالقدح المعلى"],["6541F6D7-1C2F-574D-A530-8DCF366D5423","فما جلت الدجى شمس تجلت","كوجهك في الوغى لما تجلى"],["327F2144-FB95-5F02-9BA9-92229E1431DA","ولا راق الحلي على سيوف","كسيفك من دمائهم محلى"],["670D4DF6-EDD2-5087-9D32-FC2D2B6AB3AE","إذا التقت الفتوح عليك تترى","فأولى للمصاب بهن أولى"],["12E57A2C-632B-5931-BDC5-C33CB703EFDE","وجاءتك المنى صورا توالى","فلا تحزنك صفحة ما تولى"],["E082223E-7B99-5F85-8661-771FDC7E2813","ولا يؤيسك أبراج تسامت","بأهماج فإن لديك أعلى"],["CAF3CEBB-2E94-5FB8-9F0D-AA2C5C0F8260","ورب عقاب شاهقة تعلى","بها أمل إلى يدكم تدلى"]]},"A4412F0B-2F87-5BB7-B111-7F1BE3D7C8A4":{"t":"يا حبذا خجل التفاح في طبق","p":139,"s":"يا حبذا خجل التفاح في طبق","r":"441618","v":[["E144C0B1-F6DB-5AD9-97AD-E9E8CB12D76C","يا حبذا خجل التفاح في طبق","منضد بجني الزهر متسق"],["45039CBB-0712-554D-B14A-748CE84DEE2F","فيه عيون بهار قد أحطن به","نواظرا بجفون العاشق الأرق"],["9BC6ECB8-4365-554C-8C20-95582B601C0B","كأن ما احمر من تفاحه خجلا","بدر بدا قطعا من حمرة الشفق"],["8AA08D7F-7008-5863-9998-030123AA1206","في مجلس الملك المنصور يانعة","كأنما غذيت من جوده الغدق"]]},"A79FE33B-AA25-5037-9353-1D8FE5EDC2D6":{"t":"يا صفوة الأجفان من عبراتها","p":139,"s":"يا صفوة الأجفان من عبراتها","r":"441628","v":[["84E6BF03-FEE4-5F1A-872D-12BFC605354F","يا صفوة الأجفان من عبراتها","ومدخر الأضلاع من زفراتها"],["64EC4E8A-B8DF-569B-A1A7-E064785DE0CC","هلمي إلى أم الرزايا فأسعدي","نفوسا يضيق الدهر عن حسراتها"],["CA0BEA9B-7E88-5B56-B8F0-FDAFBF005694","لخطب رمى في آل خطاب سهمه","ففجعت الدنيا بأسرى سراتها"],["9AF5D42F-FA1E-52A5-A45E-714A7C02122A","فيا عبرة الأيام بالقمر الذي","به عاذت الأيام من عبراتها"],["C30451A0-BE07-570F-87F1-5AFBD75C2313","ويا غمرة للموت غال حمامها","فتى أنقذ الأحرار من غمراتها"],["181BD016-390E-56ED-88B1-B00D48BBD509","ويا دوحة العز التي قادت المنى","إلى باسق الأغصان من شجراتها"],["C1B3BB48-2E43-5218-8EE4-EC1D626B3B90","لئن فاتني صرف الحمام بظلها","لقد اخلفت لي من جنى ثمراتها"],["C99FCBF4-0E7F-56EF-ADEB-A5C67308117E","وإن غاض عيني ماء دجلة حينها","لقد أغرقت أرضي بعد فراتها"]]},"BFC6DFA6-A055-5EAF-8713-84382F0F606E":{"t":"يا عاكفين على المدام تنبهوا","p":139,"s":"يا عاكفين على المدام تنبهوا","r":"441638","v":[["BF4D6843-957C-53AC-8B0A-2EA2916C5C44","يا عاكفين على المدام تنبهوا","وسلوا لساني عن مكارم منذر"],["DE362B81-4AE2-57CE-A45E-73CE6377337E","ملك لو استوهبت حبة قلبه","كرما لجاد بها ولم يتعذر"]]},"3BE9B0AA-2068-5287-9693-FC64ED973A05":{"t":"يا غياث العباد إن بخل المزن","p":139,"s":"يا غياث العباد إن بخل المزن","r":"441486","v":[["5BE31B9F-C3BD-5523-BE76-382D40B8E6F5","يا غياث العباد إن بخل المزن","سقاهم وبلا وما استمطروه"],["FC11988A-6AFC-57CC-9641-E8020A9486EC","والذي أمن العباد ببيض","مرهفات لقاؤهن كريه"],["02E50FBE-A935-573A-A102-31C89BDC29FB","شهد الناس أمس ما لم يروه","في الذي أدركوا ولا شهدوه"],["577F4AB8-141D-5CFD-8394-B94308727731","قتل المشركون منا شهيدا","فتمنوا بأنهم أنشروه"],["34ED89A4-2570-5DB0-8110-D33950D796CE","سفكت بالدم الكريم دماء","وكذا يوبق الحليم السفيه"],["470BF152-34DB-56C6-9DB0-95DB52B777F8","قتلوه مصفدا فودوه","لو علا ظهر طرفه لم يدوه"],["4A3F7A04-628B-5C12-A51E-0D98AC2D457F","لقي الموت في الرصيف رجال","كلهم في بني أبيه وجيه"],["A71EC9B1-5FCD-5471-9430-9841926DA5CA","غادرتهم صوارم الهند والزرق","حصيدا يا بؤس يوم لقوه"],["FEAA94BB-0509-5A18-975A-8C6F00896935","ورأينا الوزير كالليث أنى","غير هذا والعامري أبوه"],["297ABC9B-BD77-5CFA-A2BF-1AC16C5CCC73","أيقنوا بالحمام لما رأوه","مقبلا نحوهم وسيئت وجوه"],["DA07B3B8-10C3-5C55-BE23-389D6FA5564B","ورأيناه كالحسام مضاء","فشهدنا أن الحسام أخوه"],["93F24172-FC6E-5B55-AF80-DBB7322CE0AD","زرق العلج زرقة تركته","حرضا قد أظله المكروه"],["E6EA87CA-5A3A-5D35-A2B3-445C17B1911B","ولكم أيما له وقتيلا","صم عن أن يجيب من يدعوه"],["E4736FCA-DC08-5CB1-B35E-28DF3EC72F68","وأسيرا مصفدا في وثاق","وغياثا لطارق جف فوه"],["C4205C88-656A-5E4F-ADC1-176884D98BDB","ذاك حتى إذا اللقاء دعاه","عاين الناس منه ما استعظموه"],["D91871A2-4C67-5C3A-A91F-74A18762EF17","أسدا ساقطا لزرقة شبل","لو دروا حيث أوغلت عذروه"],["F4213C30-F88C-5DAD-AC48-5B4B10895BCF","وقفوا يذعرون منه فلما","عاينوا الفضل ماثلا أملوه"],["565B4E57-B408-554E-8AD9-FC5EEBB27CD8","وكذا العامري ما دام طفلا","ولعمري لنعم ما شبهوه"],["F4CEA16E-FB49-5FFC-A82E-918E4AAD2CC7","فإذا جاز تسعة وثلاثا","جل عن أن يحده تشبيه"],["554AA5D2-C156-55FB-9AF6-6EE042E31D42","قد حباني دهري بإدراك دهر","ما به ناجه ولا منجوه"],["F40EB975-66D3-5B11-AC55-EA6858C0CE25","لو حباني بذاك عصر شبابي","لرآني على العباد أتيه"],["E13A92AB-5B4C-5BC9-AA98-050D90BF94D2","ورجائي ما قد علمت وشكري","وثنائي في الناس ما علموه"],["BD07A970-7827-5953-ACB4-414C3307C123","غير أن الزمان ثقل ظهري","فهو ثقل علي صعب كريه"]]}}}