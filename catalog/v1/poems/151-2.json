{"v":1,"poems":{"24246269-CA31-5468-AF4E-3E9FC1DDCDA4":{"t":"يا غزالاً ! أصَارني","p":151,"s":"يا غزالا ! أصارني","r":"441790","v":[["C15FFBBF-8AC8-5967-A10B-C8EAC5DE0294","يا غزالاً! أصَارني","موثقاً، في يد المِحنْ"],["8BF6B26D-B27B-59C2-AB1D-D6F5A3C713B1","إنّني، مُذْ هَجرْتَني،","لمْ أذُقْ لذّةَ الوسنْ"],["C067503D-BFC3-5483-8542-FD4D60AC6490","ليتَ حظّي إشارةٌ","منكَ، أو لحظةٌ عننْ"],["47A1B3DA-6FEB-548C-ACAA-A811388FC6CC","شافِعي، يا مُعذّبي،","في الهوَى، وجهُكَ الحسنْ"],["8CB2F6AF-A317-5713-BD8A-81E199AA4BA8","كُنْتُ خِلواً منَ الهَوى؛","فأنَا اليَوْمَ مُرْتَهَنْ"],["D16A05BB-757B-5023-9E0A-4D79B9670AAF","كانَ سرّي مكتًّماً؛","وَهُوَ الآنَ قَدْ عَلَنْ"],["F37DDCFB-5753-5867-9FC6-80A5CC82EDB3","ليسَ لي عنكَ مَذهَبٌ؛","فكما شئتَ لي فكُنْ"]]},"AD0421C7-4838-5B73-BD78-0AADEC1F5292":{"t":"يا غزالاً جمعَتْ فيهِ","p":151,"s":"يا غزالا جمعت فيه","r":"441845","v":[["0EB7D5A5-F7FC-575F-9C4B-9636F4E6B584","يا غزالاً جمعَتْ فيهِ،","منَ الحسنِ، فنونُ"],["21EE5966-9338-535A-A19B-EB416E95D09C","أنتَ في القربِ، وفي البعدِ،","مِنَ النّفسِ، مَكِينُ"],["684049FB-6970-5EC1-B0C2-638A0F309ABD","بهَوَاكَ، الدّهْرَ، ألْهُو،","وَبحُبّيكَ أدِينُ"],["631C219E-60E9-5091-8F66-FFB5C65DFE25","مُنْيَةَ الصّبّ أغِثْني،","قَدْ دَنَتْ مِنّي المَنُونُ"],["DC29C675-FB9F-5C66-B494-EE09936CF376","وَاحْفِظِ العَهْدَ، فإنّي","لستُ، واللهِ، أخونُ"],["EF906C57-289C-5065-A5DA-E47E708D0497","وارحمَنْ صبّاً شجيّاً،","قَدْ أذَابَتْهُ الشّجُون"],["EF42A4D7-ED98-56D1-A5D3-F0A1FAE0260D","لَيْلُهُ هَمٌّ وَغَمٌّ،","وَسَقَامٌ، وَأنِينُ"],["E204C55C-0181-544D-BE88-05DBDDD73A89","شفَّهُ الحبُّ، فأمسَى،","سَقَماً، لا يَسْتَبِينُ"],["98BDF27E-A8AF-51E0-AEFD-51FC72250D4D","صارَ، للأشواقِ، نهباً،","فَنَبَتْ عَنْهُ العُيُونُ"]]},"CB4B8275-2443-5CFC-A2C0-ECB74F8B5B46":{"t":"يا قاطعاً حبلَ ودّي","p":151,"s":"يا قاطعا حبل ودي","r":"441834","v":[["2B55C093-5293-5498-9622-C23EABB9ABC3","يا قاطعاً حبلَ ودّي،","وَوَاصِلاً حَبْلَ صَدّي"],["297828CE-F8B0-540C-821B-7F4DF2484DFC","وَسَالِياً، لَيْسَ يَدرِي","بطولِ بثّي ووجدِي"],["B43F242E-2810-509D-8690-816EBE2BF066","لوْ كانَ، عندكَ، مني","مثلُ الذي منكَ عندي"],["DD4EA162-5F61-5831-A65D-04C10C936A97","لبتَّ، بعديَ، مثلي،","وبتُّ مثلَكَ بعدِي"]]},"C8F7AEFD-42C3-53B3-B76B-51D22EC12AF1":{"t":"يا قَمَراً مَطْلَعُهُ المَغْرِبُ","p":151,"s":"يا قمرا مطلعه المغرب","r":"441809","v":[["3B5D6B01-7C29-5049-9A1D-93F0FFBAB5D0","يا قَمَراً مَطْلَعُهُ المَغْرِبُ،","قد ضاقَ بي، في حبّكَ، المذهبُ"],["19E8C4AD-2C38-5980-8CE4-8B59E98F1A82","أعتبُ، من ظلمِكَ لي جاهداً،","ويغلبُ الشّوقُ، فأستعتِبُ"],["A3B11569-AB8B-516E-9196-DC41DB562B34","ألزمتَني الذّنْبَ الذي جئتَهُ،","صَدَقْتَ، فاصْفَحْ أيّها المُذنِبُ"]]},"2ECBEA6A-3FE6-5907-A318-BE335CAD2786":{"t":"يا ليلُ طلْ لا أشتَهي","p":151,"s":"يا ليل طل لا أشتهي","r":"441828","v":[["AF39D3DB-79B2-5583-B0C6-7AC3CB6C7BDB","يا ليلُ طلْ، لا أشتَهي،","إلاّ بِوَصْلٍ، قِصَرَكْ"],["1EBB0F00-E703-5A77-8A1C-3AA876CA2870","لوْ باتَ عندي قمرِي،","ما بتُّ أرعَى قمرَكْ"],["FEDE9000-383A-507C-B9F9-B3A9BC3CEC30","يا ليلُ خبّرْ: أنّني","ألْتذُّ عنْهُ خبرَكْ"],["79DA9BAE-E879-52F1-92E0-F8262A060A4F","بِاللَّهِ قُلْ لي: هَلْ وَفَى؟","فَقالَ: لا، بَل غَدَرَكْ!"]]},"FBDA72B5-FEAB-59BE-A271-8D691B11FFBB":{"t":"يا مستخفّاً بعاشقيِهِ","p":151,"s":"يا مستخفا بعاشقيه","r":"441810","v":[["1A12F41B-3D5B-5000-9F35-EF308AACC73C","يا مستخفّاً بعاشقيِهِ،","ومستغشّاً لناصحِيهِ"],["DD80B487-E99A-5440-9D47-BDE98116A797","ومَنْ أطاعَ الوشاةَ فينَا،","حتى أطَعْنَا السّلُوّ فِيهِ"],["0594D0DC-7EB4-5C43-ADB7-17190ECBF49D","الحَمْدُ للَّهِ، إذْ أرَاني","تَكذيبَ ما كُنتَ تَدّعِيهِ"],["D9673D5E-E4AF-5459-BCD3-45538CE2063E","مِن قبلِ أن يُهزَمَ التّسَلّي؛","ويغلبَ الشّوقُ ما يليهِ"]]},"6F49AE76-8253-5901-8EF4-15648E3C8BA5":{"t":"يا مَنْ تَزَيّنَتِ الرّيا","p":151,"s":"يا من تزينت الريا","r":"441914","v":[["88EDA51E-8136-5E05-BE07-117B56980285","يا مَنْ تَزَيّنَتِ الرّيا","سَةُ حِينَ أُلْبِسَ ثَوْبَها"],["17D70EDC-EF86-5B82-BD77-C0D81F09B077","وَلَهُ يَدٌ يَئِسَ الغَمَا","مُ مِنْ أنْ يُعارِضَ صَوْبَها"],["C98619DD-C2A0-5BDE-9E75-D39D9E502ABC","جاءتْكَ جامِدَةُ المُدا","مِ، فخذْ عليهَا ذوْبَهَا"]]},"2A9BB27A-7F8C-5A2C-B492-520A261109FC":{"t":"يا مُخجلَ الغُصُنِ الفَينانِ إن خطَرَا","p":151,"s":"يا مخجل الغصن الفينان إن خطرا","r":"441794","v":[["B1955AFE-77AB-5D27-A53F-104D75C6DA60","يا مُخجلَ الغُصُنِ الفَينانِ إن خطَرَا؛","وفاضِحَ الرَّشإِ الوسنانِ إنْ نظَرَا"],["B3979C30-8275-57BD-BF9B-C3B5EBAF811D","يَفديكَ مي مُحِبٌّ، شأنُهُ عَجَبٌ،","ما جئتَ بالذّنبِ إلاّ جاء معتذِرَا"],["14930F12-70E9-5332-9C06-5CDBE960F8B2","لم يُنجني منكَ ما استشعرْتُ من حَذَرٍ؛","هيهاتَ كيدُ الهوَى يستهلِكُ الحذرَا"],["C6E31C63-933D-51D1-90EF-9F785508D05B","ما كانَ حبُّكَ إلاّ فتنةً قدرَتْ؛","هلْ يستطيعُ الفتى أن يدفعَ القدرَا؟"]]},"6919F67F-C0C6-5404-84A2-6019FFD409F3":{"t":"يا مُعطِشِي من وِصَالٍ كنتُ وَارِدَهُ","p":151,"s":"يا معطشي من وصال كنت وارده","r":"441846","v":[["D333061A-C7F3-57F2-B66C-3C859CC241DB","يا مُعطِشِي، من وِصَالٍ كنتُ وَارِدَهُ،","هل منك لي غُلّةٌ إن صِحتُ: وَاعطشِي"],["7A0DFFA5-F2A7-5CBE-85B8-E742EB5D8268","كسوتَني، من ثيابِ السّقم، أسبغَها","ظلماً وصيَّرْتَ من لحفِ الضّنى فرُشِي"],["C83F2E40-2FDB-541C-B1B5-8040D9061B29","إني بَصرْتُ الهوَى، عن مُقلَةٍ كُحلتْ","بالسّحرِ منك، وَخَدٍّ بالجمالِ وُشِي"],["8D5F8EF1-EE98-5899-8076-2C21665F4079","لمّا بدا الصّدغُ مسودّاً بأحمرِهِ","أرَى التّسالُمَ بَينَ الرّوم وَالحَبَشِ"],["D6D13F7F-25D5-5F4B-BDC1-737776076C56","أوفَى إلى الخدّ، ثمّ انصاعَ منعطفاً","كالعُقْرُبانِ انثنَى من خوْفِ محْترِشِ"],["359AE26D-BD4C-5A10-AC2D-F0FFE9EA87B0","لو شئتَ زرتَ وسلكُ النّجم منتظم،","والأفقُ يختالُ في ثوبٍ من الغبشِ"],["A3A45E8B-B2EC-55B0-B276-8FE1A2CE1081","صبّاً، إذا التذّتِ الأجفانُ طعم كرىً،","جفا المنامَ، وصاحَ اللّيلَ: يا قرَشي"],["FA5D8829-8DED-565E-885E-46864FC82F44","هذَا وَإنْ تَلِفَتْ نَفسي فلا عَجَبٌ،","قد كان موْتيَ من تلك الجفونِ خُشِي"]]},"0D481EF6-B3A7-50E2-B4DB-046F94300256":{"t":"يا نازِحاً وَضَمِيرُ القَلْبِ مَثْوَاهُ","p":151,"s":"يا نازحا وضمير القلب مثواه","r":"441804","v":[["CAA74350-2E5C-58A3-B954-6F6EFE155F2E","يا نازِحاً، وَضَمِيرُ القَلْبِ مَثْوَاهُ،","أنْسَتكَ دُنياكَ عَبداً، أنتَ مولاهُ"],["2B0D0493-1C22-5493-B732-A0CB846FB76F","ألْهَتْكَ عَنْهُ فُكَاهاتٌ، تَلَذُّ بها،","فليسَ يجري، ببالٍ منكَ، ذكرَاهُ"],["F48B9105-5A69-527F-91F4-C7DC93E81F16","عَلّ اللّياليَ تُبْقِيني إلى أمَلٍ","الدّهْرُ يَعْلَمُ وَالأيّامُ مَعْنَاهُ"]]},"888AE9AF-509E-5158-B56E-2EA60A854E4F":{"t":"يا نَاسِياً لي على عِرْفَانِهِ تَلَفي","p":151,"s":"يا ناسيا لي على عرفانه تلفي","r":"441832","v":[["E61F7BB4-11C1-5439-A3BF-0AEF09B4D7B8","يا نَاسِياً لي، على عِرْفَانِهِ، تَلَفي،","ذِكْرُكَ منيَ، بالأنفاسِ، مَوْصُولُ"],["8A3978DB-E6ED-5151-AE7C-BCAC26BE5CF4","وقاطعاً صلتي، من غيرِ ما سببٍ،","تاللَّهِ! إنّكَ، عن رُوحي، لَمسؤولُ"],["20CE95D4-9BC6-5F4E-8FB9-30B48C19090B","ما شئتَ فاصنَعهُ، كلٌّ منكَ مُحْتَمَلٌ،","والذّنبُ مغتفرٌ، والعذرُ مقبولُ"],["C04F81E0-020C-5F36-8535-748449C911DB","لو كنتَ حظّيَ، لم أطلبْ بهِ بدلاً،","أوْ نِلْتُ منكَ الرّضَا، لم يبقَ مأمُولِ"]]},"5A3E2F3E-CF7F-5C30-93A3-A21587477886":{"t":"يقصِّرُ قربُكَ ليلي الطّويلا","p":151,"s":"يقصر قربك ليلي الطويلا","r":"441900","v":[["49F306E6-4230-5515-99B0-60E7656F6425","يقصِّرُ قربُكَ ليلي الطّويلا؛","ويشفي وصالُكَ قلبي العليلا"],["C19B98FA-D147-54AE-B16B-57F7628EE5BD","وإنْ عَصَفَتْ مِنكَ رِيحُ الصّدُودِ،","فقدْتُ نسيمَ الحياةِ البليلا"],["F137AF65-56AF-5406-9943-A5F9CA80E2FC","كمَا أنّني، إنْ أطلْتُ العثارَ،","ولمْ يُبدِ عُذْرِيَ وَجْهاً جَمِيلا"],["0679DA34-C091-551E-879F-0ACDE5BCD2B1","وَجَدْتُ أبا القَاسِمِ الظّافِرَ، الـ","ـمُؤيَّدَ باللهِ، مولىً مقيلا"],["E511DC56-1176-5724-9CDB-25B178B37862","إذا ما نداهُ همَى والحيَا","شَآهُ، كَشأوِ الجَوادِ البَخِيلا"],["E2894147-1432-5E9D-A11F-5D681DDA63EC","وأقْلامُهُ وَفْقُ أسْيافِهِ،","يَظَلّ الصّريرُ يُبارِي الصّلِيلا"]]}}}