{"v":1,"poems":{"988EF6BA-76D4-5F4E-98A8-7C1D34E133FF":{"t":"رُفِعَ الحَجْبُ عَنْ بُدُورِ الجَمَالِ","p":166,"s":"رفع الحجب عن بدور الجمال","r":"474072","v":[["DB1CD935-2FAC-5EAA-9A9F-3D946626205E","رُفِعَ الحَجْبُ عَنْ بُدُورِ الجَمَالِ","مَرْحَباً مَرْحَباً بِأَهْلِ الجَمَالِ"],["14CC4E3B-5A87-5598-BF73-AEB5BAC13ABE","مَلَكُونِي بِحُبِّهِمْ وَرَضُوا عَنْ","عَبْدِ رِقٍّ فَسُدْتُ بَيْنَ المَوَالِي"],["978B421D-AEAC-591C-9545-F190C6DE6B1A","عَامَلُونِي بِلُطْفِهِمْ فِي غَرَامِي","فَحَلَى فِي بَصَائِرِ النَّاسِ حَالِي"],["48760476-0D59-5B66-9471-D9F1F093589E","فَرَّحُونِي بِصَرْفِ رَاحِ هَوَاهُمْ","فَتَرَبَّيْتُ فِي حُجُورِ الدَّلاَلِ"],["8845EA57-438E-5C74-933B-1344FE1355A5","إنْ أرَادُوا الصَّدُودَ يَفْنَ وُجُودِي","رَحَمُونِي وأَنْعَمُوا بالوِصَالِ"],["E8DE0D29-6EFB-5EA0-9B01-70507C030C38","وَإِذَا مَا ضَلَلْتُ عَنْهُمْ هَدُونِي","هَكَذا هَكَذَا تَكُونُ المَوِالي"],["FEE840D6-6CF6-54E1-9770-DDE60D6E4354","سَادَتِي سَادَتِي بِحَقِّي عَلَيْكُمْ","إِنَّنِي عِنْدَكُمْ عَزِيزٌ وَغَالِ"],["8224692B-85FF-52B7-8463-91ABDC2D2FE5","مَا بَقَى لِي حَبيبُ قَلْبِ سِوَاكُمْ","مَاتَ وَهْمِي بِكُمْ وَبَانَ خَيَالِي"],["8ADC5957-5BC1-5B68-8B15-8EF390DC02DC","بِحَيَاتِي عَلَيْكُمُ يَا سُقاتِي","رَوِّقُوا الكَأْسَ إنَّ حِبِّي مَلاَلِي"],["9F956489-34B7-5BB3-BC63-FC6838556A18","وَأَدِيرُوا الكُئُوسَ بَيْنَ النَّدَامَى","فَجَمِيعُ الأَنَامِ سَكْرَى بِحَالِي"]]},"8AC0FE87-8E3B-56BE-9B3A-D53ABD18363A":{"t":"رُفِعَتْ عَلَى أَعْلَى الْوَرَى أَعَلاَمُنَا","p":166,"s":"رفعت على أعلى الورى أعلامنا","r":"474078","v":[["5E21A908-123F-54B1-8CEB-23B3941E780A","رُفِعَتْ عَلَى أَعْلَى الْوَرَى أَعَلاَمُنَا","لَمَّا بَلَغْنَا فِي الغَرَامِ مَرامَنَا"],["166392D6-29B4-5494-8E82-9D5AA452C57B","نَحْنُ المُلُوكُ عَلَى سَلاَطِينِ المَلا","وَالكَائِنَاتُ وَمَنْ بِهَا خُدَّامُنَا"],["096FEC22-14B1-53DC-85AA-35D4A70F6205","وَبِبَذْلِنَا لِلحُبّش نِلْنَا عِزَّةً","وَعَلَى الرؤوس تَنَقَّلَتْ أَقْدامُنَا"],["4AFAED14-9709-57CC-990C-3D67D55F220A","إِنْ كَانَ أَخَّرَنَا الزَّمَانُ فَإِنَّنَا","فُقْنَا الَّذِينَ تَقَدَّمُوا قُدَّامَنَا"],["48D01826-C665-5894-8327-1DF92711A3A3","بِالأَخْذِ عَمَّنْ قَابَ قَوْسَيْنِ دَنَا","المُصْطَفَى المُخْتَارِ عَيْنُ مُرَادِنَا"],["A6276749-1C78-5599-B027-F84462AC8545","ضَرَبَتْ طُبُولُ العِزِّ فِي سَاحَاتِنَا","وَعَلى السُّهَى شَرَفَاً نَصَبْنَ خِيَامَنَا"],["6FB65513-647B-56A8-90FE-D0B3CA15446A","فَجَمَالُنَا مَلأَ المَلاَ وَجَلاَلُنَا","لاَ يُسْتَطَاقُ وَلاَ يُفَلُّ حُسَامُنَا"],["768F7464-0D44-5BE3-B5DB-5439D1EF48A9","وَلأَجْلِنَا وُجِدَ الزَّمَانُ وكَوْنُهُ","فَالدَّهْرُ عَبْدٌ والزَّمَانُ غُلاَمُنَا"],["63945196-373B-597F-A746-2C37EA2E04BA","وَلَنَا الوِلاَيةُ مِنْ أَلَسْتُ بِرَبِّكُمْ","رَشَقَتْ قُلُوبَ المُنْكِرينَ سِهَامُنَا"],["D12F7F10-DC4B-5229-8C56-3CF6E3D77682","وَخُيُولُنَا مَشْهُورَةٌ بَيْنَ الوَرَى","عَالٍ عَلى كُلِّ الرِّكَابِ رِكَابُنَا"],["3B2DC260-374F-5707-AF00-6B23969AD9BF","وَجَلِيسُنَا لَمْ يَشْقَ يَوْمَاً فِي الوَرَى","وَمُرِيدُنَا مَا زَال فِي إِكْرَامِنَا"],["DFF3D0A8-4200-52EA-9866-A87ACBAEF4D9","عِشْ يَا مُرِيدِي آمناً فِي غِبْطَةٍ","فَالعِزُّ ثُمَّ العِزُّ فِي عَرَصَاتِنَا"],["D65B6332-B8EC-5A40-91A7-CB27EC8D7EDC","لَوْحُ الوُجُودِ بِصَدْرِنَا مَحْفُوظَةٌ","وَبِسَعْدِنَا فِيهِ جَرَتْ أَقْلاَمُنَا"],["8516FA32-5ABD-5493-90B3-805BFE9052D0","قَدْ قَالَ لِي رَبُّ البَرِيَّةِ لاَ تَخَفْ","قُلْ مَا تَشَاءُ فَأَنْتَ مِنْ أَحْبَابِنَا"],["235FD73A-6CE8-586D-90B5-F80116D9C673","أَنَا قُطْبُ أَقْطَابِ الوُجُودِ حَقِيقَةً","وَجَمِيعُ مَنْ فِي الأَرْضِ مِنْ خَدَّامِنَا"],["58F4ADC9-4815-5E67-B683-FBA0C6AAD49B","قُطْبُ الْزمانِ وَغَوْثُهُ وَمَلاَذُهُ","وَالأَوْلِيَا جَمْعَاً بِظِلِّ خِبَابِنَا"],["9AC800AC-0F15-5AE4-8C61-AFF8CA0BB6C1","ثُمَّ الصَّلاَةُ عَلَى النَّبِيِّ مُحَمَّدٍ","وَالآلِ والأَصْحَابِ ثُمَّ صِحَابِنَا"]]},"7F26C754-7DAF-5C38-B18E-B1C153BB135C":{"t":"سَقَانِي الْحُبُّ كَاسَاتِ الْوِصَالِ","p":166,"s":"سقاني الحب كاسات الوصال","r":"474073","v":[["C8478D8F-FFCA-56B5-9C8D-7A2D907BF935","سَقَانِي الْحُبُّ كَاسَاتِ الْوِصَالِ","فَقُلْتُ لِخَمْرَتِي نَحْوِي تَعَالِي"],["E3383954-5BD6-587F-AD8A-8695BF49E042","سَعتْ وَمَشَتْ لِنحْوِى فِي كُئُوسٍ","فَهِمْتُ بِسَكْرَتِي بَيْنَ الْمَوَالِي"],["798D47F9-67A7-5027-970D-39BE0213E39A","وَقُلْتُ لِسَائِرِ الأَقْطَابِ لُمُّوا","بِحَانِي وَادْخُلُوا أَنْتُمْ رِجَالِي"],["C0975765-27B0-5329-9A60-ED31F8669435","وَهِيمُوا وَاشْرَبُوا أَنْتُمْ جُنودِي","فَسَاقِي الْقَوْمِ بِالْوَافِي مَلاَلِي"],["DF60DA58-420F-57D2-BF46-88099F8D2AE3","شَرِبْتُمْ فَضْلَتِي مِنْ بَعْدِ سُكْرِي","وَلاَ نِلْتُمْ عُلُوِّي وَاتِّصَالِي"],["C7A8C62D-6632-5FDF-BEB3-C898663B1E26","مَقَامُكُمُ الْعُلا جَمْعَاً وَلَكِنْ","مَقَامِي فَوْقَكُمْ مَا زَالَ عَالِي"],["A1B7C2A3-DEF7-5020-9177-E08CDBFE403B","أَنَا في حَضْرَةِ التَّقْرِيبِ وَحْدِي","يُصَرِّفُنِي وَحَسْبِي ذُو الْجَلاَلِ"],["FCF60717-607D-5EF0-BEF3-CE132104E8D4","أَنَا الْبَازِيُّ أَشْهَبُ كُلِّ شيْخٍ","وَمَنْ ذَا فِي الرجال أُعْطَي مِثَالِي"],["A3C25F02-A8DD-5280-9BBF-5ECC9C14A3E1","دَرَسْتُ الْعِلْمَ حَتَّى صِرْتُ قُطْباً","وَنِلْتُ السَّعْدَ مِنْ مَوْلَى الْمَوَالِي"],["45C79C69-7B5E-5F01-9704-E9B241B8475C","كَسَانِي خِلْعَةً بِطِرَازِ عِزٍّ","وَتَوَّجَنِي بِتِيجَانِ الْكَمَالِ"],["013CE7CE-19A5-5BB0-ADBE-87690C8AE7BF","وَأَطْلَعَنِي عَلَى سِرٍّ قَدِيمٍ","وَقَلَّدَنِي وَأَعْطَانِي سُؤالِي"],["3D5CFF2A-4183-516D-9CB3-B94CA4137422","وَوَلاَّنِي عَلَى الأَقْطَابِ جَمْعاً","فَحُكْمِي نَافِذٌ فِي كُلِّ عَالِي"],["829BC402-CEDB-572A-B290-59AD12295E6B","فَلَوْ أَلْقَيْتُ سِرِّي وَسْطَ نَارٍ","لَذَابَتْ وَانْطفَتْ مِنْ سِرِّ حَالِي"],["E3C8783F-B4BC-50A5-A45B-8F41480AC0F6","وَلَوْ أَلْقَيْتُ سِرِّي فَوْقَ مَيْتٍ","لَقَامَ بِقُدْرَةِ الْمَوْلَى سَعَى لِي"],["0458D258-F6FE-5A85-845E-42FC52D72A4A","وَلَوْ أَلْقَيْتُ سِرِّي فِي جِبَالٍ","لَدُكْتُ وَاختَفَتْ بَيْنَ الرِّمَالِ"],["6352D095-E609-5A5B-8E6A-72103FD1536C","وَلَوْ أَلقْيتُ سِرِّي فِي بِحَارٍ","لَصَارَ الْكُلُّ غَوْراً فِي الزَّوَالِ"],["BC7C9F5C-2198-5324-825B-5CBD7EBD9397","وَمَا مِنْهَا شُهُورٌ أَوْ دُهُورٌ","تَمُرُّ وَتَنْقَضِي إِلاَّ أَتَى لِي"],["5FA5EA6F-CF3E-5822-9673-CAFBEB6E7600","وَتُخْبِرُنِي بِمَأ يَجْرِي وَيأْتِي","وَتُعْلِمُنِي فَأُقْصِرُ عَنْ جِدَالِي"],["12E0CB8F-F7B5-5BA5-BC8F-B9FB234746CA","بِلاَدُ اللَّهِ مُلْكِي تَحْتَ حُكْمِي","وَوَقْتِي قَبْلَ قَبْلِي قَدْ صَفا لِي"],["F4EEAEE2-9DE2-5B7D-BA26-59B778D8696A","طُبُولِي فِي السَّمَا والأَرْضِ دَقَّتْ","وَشَاءُوسُ السَّعَادَةِ قَدْ بَدَا لِي"],["11892262-9C05-5612-8D70-937DBDFF2CE8","أَنَا الجِيلانِي مُحْيى الدِّينِ إِسْمِي","وَأَعْلاَمِي عَلَى رُؤْسِ الْجبَالِ"],["F0E149CD-548E-5C8A-A60C-F271B007E6EA","أَنَا الحَسَنِيُّ وَالْمخْدَعْ مَقَامِي","وَأَقْدَامِي عَلى عُنُقِ الرِّجَالِ"],["E06A49DB-CA26-5D1C-B6FB-62EF6D5DE924","رِجَالٌ خَيَّمُوا فِي حَيِّ لَيْلى","وَنَالُوا فِي الْهَوَى أَقْصَى مَنَالِ"],["FD02A444-A566-5273-9709-B09445911148","رِجَالٌ فِي النَّهارِ لُيُوثُ غَابٍ","وَرُهْبَانٌ إِذَا جَنَّ اللَّيَالِي"],["A5101D88-9409-54D2-A809-DC63CFD39BCF","رِجَالٌ فِي هَوَاجِرِهِمُ صِيَامٌ","وَصَوْتُ عَوِيلِهِمْ فِي اللَّيْلِ عَالِي"],["2B6B1BC9-B502-5989-9C7B-CC4A01B26078","رِجَالٌ فِي النَّهارِ لُيُوثُ غَابٍ","وَرُهْبَانٌ إذَا جَنَّ اللَّيَالِي"],["A26ACB61-1B1B-5BC5-AC4E-8A53C6BF21E0","رِجَالٌ سَائِحُونَ بِكُلِّ وَادٍ","وَفِي الْغَابَاتِ فِي طَلَبِ الْوِصَال"],["71940FE7-92E4-55E8-8762-23D2B257A1B4","أَلا يَا لِلْرِجَالِ صِلُوا مُحِبّاً","لِنَار الْبُعْدِ وَالهِجْرَانِ صَالِ"],["35C57784-60D3-5BEF-9729-555E1087A805","أَلاَ يَا لِلْرِجَالِ قُتِلْتُ ظُلْماً","بِلَحْظٍ قَدْ حَكَى رَشْقَ النِّبَالِ"],["83CE0DB5-E41B-52B7-ADCA-4D66393376C9","أَلاَ يَا لِلرِجَالِ خُذُوا بِثَأْرِي","فَإِنِّي شَيْخُكُمْ قُطْبُ الْكَمَالِ"],["B61DD4CA-4EB5-56F4-B294-404A5E5ED2E3","أَنَا شَيْخُ الْمَشَايخِ حُزْتُ عِلْماً","بآدابٍ وَحِلْمٍ وَاتْصِالِ"],["75819753-37CF-530B-8A3A-7C2041C382F4","فَمَنْ فِي أَولَياءِ اللهِ مِثْلِي","وَمَنْ فِي الْحُكْمِ وَالْتَصْرِيفِ خَالِي"],["177A45F1-FA6B-5531-AF47-36C9478FE7BA","تَرَى الدُّنْيَا جَمِيعَاً وَسْطَ كُفِّي","كَخَرْدَلَةٍ عَلى حُكْمِ النَّوالِ"],["D0592CC9-FF6C-5129-8618-3C67ABAFB43C","مُرِيدِي لاَ تَخَفْ وَشْياً فَإِنِّي","عَزُومٌ قَاتِلٌ عِنْدَ الْقِتال"],["DA08D315-1248-54D7-A690-DFB52A1B891B","مُرِيدِي لاَ تَخَفْ فاللَّهُ رَبِّي","حَبَانِي رِفْعَةً نِلْتُ الْمَعَالي"],["4C6347BA-8D58-5BA1-942A-25E0A7EF976A","مُريدِي هِمْ وَطِبْ وَاشْطَحْ وَغَنِّي","وَافْعَلْ مَا تَشَا فَالإسْمُ عَالِي"],["83D2B003-22D2-595F-9508-11FC544F537E","وَكُلُّ فَتَىً عَلَى قَدَمٍ وَإِنِّي","عَلَى قَدَمِ النَّبِي بَدْرِ الْكَمَالِ"],["9696BAB4-C165-5A11-B3C6-8CC94D59A121","عَلَيْهِ صَلاَةُ رَبِّي كُلَّ وَقْتٍ","كَتَعْدَادِ الرِّمَالِ مَعَ الْجبَالِ"]]},"847DFD84-3F60-58DC-BBA1-B296B98BBE2E":{"t":"سَقَانِي حَبِيبِي مِنْ شَرَابِ ذَوِي الْمَجْدِ","p":166,"s":"سقاني حبيبي من شراب ذوي المجد","r":"474071","v":[["F551BADE-7B2E-5EE4-A86F-52E3B508A48E","سَقَانِي حَبِيبِي مِنْ شَرَابِ ذَوِي الْمَجْدِ","فَأَسْكَرَنِي حَقّاً فَغِبْتُ عَلَى وَجْدِي"],["80623069-A6BE-5C92-B09A-54C9EA4EBA2C","وَأَجْلَسَنِي فِي قَابَ قَوْسَيْنِ سَيِّديِ","عَلَى مِنْبَرِ التَّخْصِيصِ فِي حَضْرَةِ الْمَجْدِ"],["B4AF5796-1623-55C1-B856-2C0BDD27EF75","حَضَرْتُ مَعَ الأَقْطَابِ فِي حَضْرَةِ اللِّقَا","فَغِبْتُ بِهِ عَنْهُمْ وَشَاهَدْتُهُ وَحْدِي"],["33D4F798-3079-5FF0-8D50-7EA1F59FB22B","فَمَا شَرِبَ الْعُشَّاقُ إِلاَّ بَقِيَّتي","وَفَضْلَهُ كَاسَاتِي بِهَا شَرِبُوا بَعْدِي"],["DDD23FD9-A5FC-51B4-9770-4281E37F8DA2","وَلَوْ شَرِبُوا مَا قَدْ شَرِبْتُ وَعَايَنُوا","مِنَ الْحَضْرَةِ الْعَلْيَاءِ صَافِيَ مَوْرِدِي"],["DC4A97F8-12A9-5E2C-8C8B-70C5B751665A","لأَمْسَوْا سُكَارَى قَبْلَ أَنْ يَقْرَبُوا الْمُدَا","م وَامْسَوْا حَيَارَى مِنْ مُصَادَمِة الورْدِ"],["47046BB6-C18F-54F3-B376-896F2A880D02","أَنَا البَدْرُ فِي الدُّنْيَا وَغَيْرِي كَوَاكِبٌ","وَكُلُّ فَتىً يَهْوَى فَذَلِكُمُ عَبْدي"],["B4B42DAC-00E2-5DCB-BA4B-CE1D28A1A231","وَبَحْرِي مُحِيط بِالبِحَارِ بأَسْرِهَا","وَعِلْمِي حَوَى مَا كَانَ قَبْلِي وَمَا بَعْدِي"],["EB5455EC-854F-5FDD-95FE-09F1C5B08D77","وَسِرِّي لَهُ الأَسْرَارُ تُزْجَرُ في الدُّجَا","كَزَجْرِ سَحَابِ الأُفْقِ مِنْ مَلَكِ الرَّعْدِ"],["E22781AC-421F-54FE-A4C1-FEBABB433FB9","فَيَا مَادِحِي قُلْ مَا تَشَاءُ وَلاَ تَخَفْ","لَكَ الأَمْنُ فِي الدُّنْيَا لَكَ الأَمْنُ فِي غَدِ"],["214E666F-77F4-5BA2-9885-EA6E8BC89F5D","فإِنْ شِئْتَ أَنْ تَحْظَى بِعِزِّ وَقُرْبَةٍ","فَدَاوِمْ عَلى حُبِّي وَحَافِظْ عَلى عَهدِي"]]},"6A500280-C37E-5271-8A49-68DE62C8CA0F":{"t":"شَرَعْتُ بِتَوْحِيدِ الإِلهِ مُبَسْمِلاَ","p":166,"s":"شرعت بتوحيد الإله مبسملا","r":"474074","v":[["FEB4658C-C265-5B05-B410-5BE503E18E06","شَرَعْتُ بِتَوْحِيدِ الإِلهِ مُبَسْمِلاَ","سَأَخْتِمُ بِالذِّكْرِ الْحَمِيدِ مُجَمِّلاَ"],["3A354E93-7390-54B5-880B-D2FDD95C6FFA","وَأَشْهَدُ أَنَّ الله لاَ رَبَّ غَيْرُهُ","تَنَزَّهَ عَنْ حَصْرِ الْعُقُولِ تَكَمُّلا"],["3B71CABC-9F36-535C-9CD4-0F67FBC69568","وَأَرْسَلَ فِينَا أَحْمَدَ الْحَقِّ مُقْتَدي","نَبِياً بِهِ قَامَ الْوُجُودُ وَقَدْ خَلاَ"],["1D495A1D-6CC2-591F-AF73-664BA3CC9033","فَعَلَّمَنَا مِنْ كُلِّ خَيْرِ مُؤَيَّدٍ","وَأَظْهَرَ فِينَا الْعِلْمَ وَالْحِلْمَ وَالْوَلاَ"],["CAFFA507-1D3F-5940-8093-49651684AF2D","مَا طَالِباً عِزّاً وَكَنْزاً وَرِفْعَةً","مِنَ الله فَادْعهُ بِأَسْمَائِهِ الْعُلاَ"],["6EEE90F5-F1DF-57C9-A867-353EE6BE4DE4","وَقُلْ بِانْكِسَارِ بَعْدَ طُهْرِ وَقُرْبَةٍ","فَأَسْأَلُكَ اللَّهُمَّ نَصْراً مُعَجَّلاَ"],["29488274-64D8-5848-ADC1-AF0249BC2C89","بِحَقِّكَ يَا رَحْمَنُ بِالرَّحْمَةِ الَّتي","أَحَاطَتْ فَكُنْ لِي يَا رَحِيمُ مُجَمِّلا"],["2ADA4163-7102-530A-BCDF-6C38042F7898","وَيَا مَلِكٌ قُدُّوسُ قَدِّسْ سَرِيرَتِي","وَسَلِّمْ وُجُودِي يَا سَلاَمُ مِنَ الْبَلاَ"],["2C205F23-1D8B-5925-A7AB-1D055407786B","وَيَا مُؤْمِنٌ هَبْ لِي أَمَاناً مُحَقَّقاً","وَسِتْراً جَميلاً يَا مُهَيْمِنُ مُسْبَلاَ"],["E34D0B22-3653-5C42-AB0B-3F6C928C4A3C","عَزِيزٌ أَزِلْ عَنْ نَفْسيَ الذُّلَّ وَاحْمِنِي","بِعِزِّكَ يَا جَبَّارُ مَا كَانَ مُعْضِلاَ"],["E597AEF6-9B15-5EA3-8103-DCA807A662C9","وَضَعْ جُمْلَةَ الأَعْدَاءِ يا مُتَكَبِّرٌ","وَيَا خَالِقٌ خُذْ لِي عَنِ الشَّرِّ مَعْزِلاَ"],["35B62A76-E216-5494-9A97-6FB8D9F72184","وَيَا بَارِيَّ النَّعْمَاءِ زِد فَيْضَ نِعْمَةٍ","أَفَضْتَ عَلَيْنَا يَا مُصَوِّرُ أَوَّلاَ"],["CD4E8FEC-2DB3-5F3C-9337-D0DCC6F3E7CF","رَجَوْتُكَ يا غَفَّارُ فاقْبِلْ لتوْبَتي","بقَهْرِكَ يا قَهَّارُ شَيْطَانِيَ اخْذُلاَ"],["9CDA35BF-9D0F-5267-B60E-2B4623C054DC","وَهَبْ لِيَ يَا وَهَّابُ عِلْماً وَحِكْمَة","وَللرِّزْقِ يَا رزَّاقُ كُنْ لِي مُسَهِّلاَ"],["856AE074-EE52-5C0C-A7BF-DD5109E0B1A9","وَبِالفَتْحِ يَا فَتَّاحُ نَوِّرْ بَصِيرَتِي","وَعِلْماً أَنِلْنِي يَا عَليمُ تَفَضُّلاَ"],["1E158BCA-1371-5BA9-9DE1-2F2AF89971A6","وَيَا قَابِضْ أَقبضُ قَلْبَ كُلِّ مُعَانِدٍ","وَيَا بَاسِطُ ابْسُطْنِي بِأَسْرَارِكَ الْعُلاَ"],["6BF0F9AE-3D5B-5B58-94B5-36F80CEBADA3","وَيَا خَافِضُ اخفِضْ قَدْرَ كُلِّ مُنَافِقٍ","وَيَا رَافِعُ ارفَعْنِي بِرَوْحِكَ أَسْأَلاَ"],["BBC7F40A-AF35-5A29-8190-BE95839DDA65","سَأَلْتُكَ عِزّاً يا مُعِزُّ لأَهْلِهِ","مُذِلٌّ فَدِلَّ الظَّالِمِينَ مُنَكِّلاَ"],["0ED18A19-C6B7-5723-AF91-882FD073926A","وَعِلْمُكَ كَافٍ يَا سَمِيعُ فَكُنْ إذَنْ","بَصِيراً بِحَالِي مُصْلِحَاً مُتَقَبِّلاَ"],["7154EA0D-2306-513A-8A13-7C653B5B3817","وَيَا حَكَمٌ عَدْلٌ لَطِيفٌ بِخَلْقِهِ","خَبِيرٌ بِمَا يَخْفَى وَمَا هُوَ مُجْتَلاَ"],["6D9DFDBE-5B4F-54DC-88DD-B3468CADF9AC","فَحِلْمُكَ قَصْدِي يَا حَلِيمُ وَعُمْدَتِي","وَأَنْتَ عَظِيمٌ عُظْمُ جُودِكَ قَدْ عَلاَ"],["6FD1E9BA-7498-5B46-A396-8F90C33A3431","غَفُورٌ وَسَتَّارٌ عَلَى كُلِّ مُذْنِبٍ","شَكُورٌ عَلَى أَحْبَابِهِ كُنْ مُوَصِّلاَ"],["830E49EC-2B34-556D-AEBF-57A2087FC628","عليِّ وَقَدْ أَعْلَى مَقَامَ حَبِيبِهِ","كَبِيرٌ كَثِيرُ الْخَيْرِ وَالجُودِ مُجْزِلاَ"],["E7DD83E9-0B95-5539-AD50-609379A5CAC0","حَفِيظٌ فَلاَ شيءٌ يَفُوتُ لِعِلْمِهِ","مُقِيتٌ يُقِيتُ الْخَلْقَ أَعْلَى وَأَسْفَلاَ"],["C9728079-9A88-5C57-834A-DCA0B217D7F3","فَحُكْمُكَ حَسْبِي يَا حَسِيبُ تَوَلَّنِي","وَأَنْتَ جَلِيلٌ كُنْ لِخَصْمِي مُنَكِّلاَ"],["3A96A6A7-3BA8-5727-875E-B9459F310031","إلهي كَرِيمٌ أَنْتَ فَاكْرِمْ مَوَاهِبِي","وَكُنْ لِعَدُوِّي يَا رَقِيبُ مُجَنْدِلاَ"],["E1C67D2D-25B5-5D2B-B2BE-A601BA111F9A","دَعَوْتُكَ يَا مَوْلى مُجِيباً لِمَنْ دَعَا","قَدِيمَ الْعَطَايَا وَاسِعَ الْجُودِ فِي الْمَلاَ"],["375434E9-9901-5D23-B695-715D1FDA6793","إلَهِي حَكِيمٌ أَنْتَ فَاحْكُمْ مَشَاهِدِي","فَوُدُّكَ عِنْدِي يَا وَدُودُ تَنَزَّلاَ"],["6AC48DC3-37BB-561D-9225-7D370E61FDB2","مَجِيدٌ فَهَبْ لِي الْمَجْدَ وَالسَّعْدَ والْوِلاَ","وَيَا بَاعِثُ ابعَثْ جَيْشَ نَصْرِي مُهَروِلاَ"],["6D673355-63EC-5C27-803B-229F7F7D88C8","شَهِيدٌ عَلَى الأَشْيَاءِ طَيِّبْ مَشَاهِدِي","وحَقَّقْ لِي يا حَقُّ الْمَوَارِدِ مَنْهَلاَ"],["CD306134-7C33-5C2C-B58D-95D8B16428D8","إِلَهِي وَكِيلٌ أَنْتَ فَاقْضِ حَوَائِجِي","وَيَكْفِي إِذَا كَانَ الْقَويُّ مُوَكَّلاَ"],["32F7967A-5EB3-5FF2-BF01-637FDED3FC7A","مَتِينٌ فَمَتِّنْ ضَعْفَ حَوْلِي وَقُوَّتِي","أَغِثْ يَا وَليُّ مَنْ دَعَاكَ تَبَتُّلاَ"],["5CECF2B2-78CE-5540-939E-0DBA0885B539","حَمَدْتُكَ يَا مَوْلىً حَمِيداً مُوَحِّداً","وَمُحْصِيَ زَلاَّتِ الْوَرَى كُنْ مُعَدِّلا"],["B8352AF5-0B4C-5D3F-837B-BC7ADE2C818F","إِلَهِيَ مُبْدِي الْفَتْحَ لِي أَنْتَ وَالْهُدَى","مُعِيدُ لَمِا فِي الْكَوْنِ إنْ بَادَ أَوْ خَلاَ"],["4A9BCE6E-F07A-5D93-B193-CCD3AB405FFB","سَأَلْتُكَ يَا مُحْيي حَيَاةً هَنِيئَةً","مُمِيتٌ أَمِتْ أَعْدَاءَ دِينِي مُعَجِّلا"],["368A4FE2-2599-52F8-9B18-56B835CB3DBC","وَيَا حَيُّ أَحْيِي مَيْتَ قَلْبِي بِذِكْركَ الْ","قدِيمِ وَكُنْ قَيُّومَ سِرِّى مُوَصِّلاَ"],["D39C91CC-6244-553A-8D40-B2EB986EC36A","وَيَا وَاجِدَ الأنَوَار أَوْجِدْ مَسَرَّتِي","وَيَا مَاجِدَ الأَنْوَارِ كُنْ لِي مُعَوِّلاَ"],["96262D89-8E16-550C-97C1-8566818A8B42","وَيَا وَاحِدٌ مَا ثَمَّ إلاَّ وُجُودُهُ","وَيَا صَمَدٌ قَامَ الْوُجُودُ بِهِ عَلاَ"],["B484BBC7-2B0F-5F73-BB8E-85DBB9C3798B","وَيَا قَادِرٌ ذَا الْبَطْشِ أَهْلِكْ عَدُوَّنَا","وَمُقْتَدِرٌ قَدِّرْ لِحُسَّادِنَا الْبَلاَ"],["74276EA7-9F86-5FC2-AE81-974DA58D6205","وقَدَّمْ لِسِرِّي يَا مُقْدِّمُ عَافِنِي","مِنَ الضُّرِّ فَضْلاً يَا مُؤَخِّرُ ذَا الْعُلا"],["70C0DF73-46E0-5A33-A8FC-7ABE148B5C82","وَأَسْبِقْ لَنَا الْخَيْرَاتِ أَوَّلَ أَوَّلاَ","وَيَا آخِرُ اخْتِمْ لِي أَمُوتُ مُهَلِّلاَ"],["8F45CF09-FB0E-5B8E-851B-816323EE125C","وَيَا ظَاهِرُ أَظِهرْ لِي مَعَارِفَكَ التي","بِبَاطِنِ غَيْبِ الْغَيْبِ يا بَاطِنٌ وَلاَ"],["71F1162F-7ADE-58BB-AF1A-2F7869ABFC21","وَيَا وَالٍ أَوْلِ أمْرَنَا كُلِّ نَاصِحٍ","وَمُتْعَالِ أَرْشِدْهُ وَأَصِلحْ لَهُ الَولاَ"],["9C93B606-7D86-58EF-A25C-43B174534174","وَيَا بَرُّ يَا رَبُّ الْبَرَايَا وَمُوهِبَ الْ","عَطَايَا وَيَا تَوَّابُ تُبْ وَتَقَبَّلاَ"],["7E40B52D-E29E-5F1D-BAEF-8CE9DD1760A2","وَمُنْتَقِمٌ مِنْ ظَالِمِينَ نُفُوسَهُمْ","كَذَاكَ عُفُوٌّ أَنْتَ فَاعْفُ تَفَضُّلاَ"],["5004E136-A2BC-5BBF-86CE-8B422F91C67D","عَطُوفٌ رَءُوفٌ بِالْعِبَادِ وَمُسْعِفٌ","لِمَنْ قَدْ دَعَا يَا مَالِكَ الْمُلْكِ أَجَزِلا"],["7829AA74-D444-5D03-B93C-2B81FB90054F","فأَلْبسْ لَنَا يَا ذَا الْجَلاَلِ جَلاَلَةً","فَجُودُكَ بِالإِكْرَامِ مَا زَالَ مُهْطِلاَ"],["98716739-2D38-524F-8A9F-DBE17B5280F9","وَيَا مُقْسِطٌ ثَبِّتْ عَلَى الْحَقِّ مُهْجَتِي","وَيَا جَامِعُ اجْمَعْ لِي الْكَمالاَتِ فِي المَلاَ"],["362264E4-5FEB-59BD-B82E-CE74D5401E04","إلهي غَنَيِّ أَنْتَ فَاذْهِبْ لِفَاقَتِي","وَمُغْنٍ فَأَغْنِ فَقْرَ نَفْسي لِمَا خَلاَ"],["7D3F51C4-8412-558F-A3A5-9E9DE2ACA722","وَيَا مَانِعُ امْنعْنِي مِنَ الذَّنْبِ وَاشْفِنِي","مِنَ السُّوء مِمَا قَدْ جَنَيْتُ تَعَمُّلاَ"],["D20D540C-5A9C-504C-8A39-CA75AD2BD782","وَيَا ضَارُّ كُنْ لِلْحَاسِدِينَ مُوَبِّخاً","وَيَا نَافِعُ أنْفَعْنِي بِرُوحِ مُحَصَّلاَ"],["46201A5F-7A99-5520-82DD-CD6C0E9A34B4","وَيَا نُورُ أَنْتَ النُّورُ فِي كُلِّ مَا بَدَا","وَيَا هَادِ كُنْ لِلنُّورِ فِي الْقَلْب مُشْعِلاَ"],["7A16C3C3-9F0A-5AD2-80F6-68A7E6773F68","بَديعَ الْبَرَايَا أَرتَجِي فَيْضَ فَضْلِهِ","وَلَمْ يَبْقَ إِلاَّ أَنْتَ بَاقٍ لَهُ الْولا"],["5831FFAC-B733-5CB5-9EB3-9A8CEBA1AF19","وَيَا وَارِثُ اجْعَلْنِي لِعِلْمِكَ وَارِثاً","وَرُشْداً أَنِلْنِي يا رشِيدُ تَجَمُّلاَ"],["0E0A2198-A96C-5208-8029-294E3D55F464","صَبُورٌ وَسَتَّارٌ فَوَفَّقْ عَزِيمَتِي","على الصَّبْرِ وَاجْعَلِ لِي اخْتِياراً مُزَمِّلاَ"],["2D7C0ABB-FAE1-5BE6-9BE1-B348BA341388","بَأَسْمَائِكَ الْحُسْنَى دَعَوْتُكَ سَيِّدِي","وَآيَاتُكَ العُظْمَى ابْتهَلْتُ تَوَسُّلاَ"],["4A05D457-8F70-5591-B3F9-157935E19A9D","فَأَسأَلُكَ اللَّهُمَّ رَبِّي بِفَضْلِهَا","فَهِيِّئْ لَنَا مِنْكَ الكَمَالَ مُكَمِّلاَ"],["5246CB4C-0306-5C7D-959A-C3B7B4149F72","وَقَابِلْ رَجَائِي بِالرِّضَا مِنْكَ وَاكْفِنِي","صُرُوفَ زَمَانٍ صِرْتُ فِيِه مُحَوَّلاَ"],["9CFE24D6-1F57-53B9-9472-C1547A5C824B","أَغِثْ وَاشْفِنيِ مِنْ دَاءِ نَفْسِىَ وَاهْدِنِي","إِلَى الخَيْرِ وَاصْلِحْ مَا بِعَقْلِي تَخَلَّلاَ"],["78355F57-7D39-5A39-98E6-12A4F5FCE709","إِلَهِيَ فَارْحَمْ وَالِدَيَّ وإِخْوَتِي","وَمَنْ هَذِهِ الأَسْمَاءِ يَدْعُو مُرَتِّلاَ"],["44B01DC0-5A7B-5D05-918D-079F7666829C","أَنَا الْحَسَنِيُّ الأَصْلِ عَبْدٌ لِقَادِرٍ","دُعِيتُ بِمُحْيِي الدِّينِ في دَوْحَةٍ العُلاَ"],["9F07BC24-9DAC-5281-A1DE-A91E740484A0","وَصَلِّ عَلَ جَدِّي الْحَبِيبِ مُحَمَّدٍ","بِأَحْلَى سَلاَمٍ فِي الْوُجُودِ وَأَكْمَلاَ"],["2903899B-FDC7-5659-AA68-FF5E69BC2AE7","مَعَ الآلِ وَالأَصْحَابِ جَمْعَاً مُؤَيَّداً","وَبَعْدُ فَحَمْدُ اللهِ خَتْمَاً وَأَوَّلاَ"]]},"5AE861C2-59F6-545C-97EB-72150B05C7F3":{"t":"طُفْ بِحَانِي سَبْعاً ولُذْ بِذِمَامِي","p":166,"s":"طف بحاني سبعا ولذ بذمامي","r":"474076","v":[["A016F464-773A-5FAC-97CF-8FBE706EBE41","طُفْ بِحَانِي سَبْعاً ولُذْ بِذِمَامِي","وَتَجَرَّدْ لِزَوْرَتِي كُلَّ عَامِ"],["BA4947D4-89EC-5FF3-BCCA-97AFB42A63A5","أَنَا سِرُّ الأَسْرَارِ مِنْ سِرِّ سِرِّي","كَعْبَتِي رَاحَتِي وَبَسْطِي مُدَامي"],["885A1C7E-6242-524A-9969-EBAE19E468FD","أَنَا نَشْرُ العُلُومِ والدَّرْسُ شُغْلي","أَنَا شَيْخُ الوَرَى لِكُلِّ إِمَام"],["BA6C5174-04FA-5ECB-9E71-C8FDC66912F3","أَنَا فِي مَجْلِسِي أَرَى العَرْشَ حَقاً","وَجَميعَ الأَمْلاكِ فِيه قِيَامِي"],["6C8F3218-1E92-58F6-9901-1ED2C17308FB","قَالتِ الأَوْلِيَاءُ جَمْعاً بِعَزْمٍ","أَنْتَ قُطْبٌ عَلَى جَمِيعِ الأَنَامِ"],["0F3D2397-B163-534E-8BCA-168307F3E371","قُلْتُ كُفُّوا ثُمَّ اسْمَعُوا نَصَّ قَوْلِي","إِنَّمَا القُطْبُ خَادِمِي وَغُلاَمِي"],["06A0CA32-9EB2-5378-9029-660155AB0463","كُلُّ قُطْبِ يَطُوفُ بالبَيْتِ سَبْعاً","وَأَنَا الْبَيْتُ طَائِفٌ بِخِيَامِي"],["393EA903-A977-5AD5-B419-C060D8114ADE","كَشَفَ الحُجْبَ والسُّتُورَ لِعَيْنِي","وَدَعانِي لِحَضْرَةِ وَمَقَامِ"],["C4BFBC7C-19CF-507F-A8BD-BAD9CC43FCCC","فَاخْتَرَقْتُ السُّتُورَ جَمْعاً لِحبِّي","عِنْدَ عَرْشِ الإِلَهِ كَانَ مَقَامِي"],["3A6ECFC9-0466-52E5-8ADD-63835A518DC7","وكَسَانِي بِتَاجِ تَشْرِيفِ عِزٍّ","وَطِرَازِ وَخِلْعَةٍ بِاخْتِتَامِ"],["18B2D6F1-00F8-5C63-83F2-FF0426C352D7","فَرسُ العِزَ تَحْتَ سَرْجِ جَوَادِي","وَرِكَابي عَالٍ وَعَزْمِي لِجَامِي"],["949A39CB-1180-5E94-8A3F-6A12B61EE713","وَإِذَا مَا جَذَبْتُ قَوْسَ مَرَامِي","كَان نَارُ الْجَحِيم مِنْهَا سِهَامِي"],["BDB0E1D1-BAFE-518B-B214-07E230955A31","سَائِرُ الأَرْضِ كُلِّهَا تَحْتَ حُكْمِي","وَهْيَ فِي قَبْضَتِي كَفَرْخِ حَمَامِ"],["0B7ED9CE-2C71-544A-8203-EF4EF773069C","مَطْلَعُ الشَّمْسِ ثُمَّ أَقْصَى الْغَرُوبِ","خُطْوَتِي وَأَقَلُّهَا بِاهْتِمامِ"],["05593E3C-E55B-5A3E-9F46-00BA2E2EA79F","يَا مُرِيدِي لَكَ الهَنَا بِدَوَامٍ","عِشْ بِعِزٍ وَرِفْعَةٍ وَاحْتِرامِ"],["B5DB4F09-9E1D-5CB3-A039-495AAAA6CC4D","وَمُرِيدِي إذا دعانِي بِشَرْقٍ","أَوْ بِغَرْبٍ أَوْ نَازلٌ بَحْرَ طَامِ"],["41845546-1843-5484-82B5-650CFABAB8D9","فَأَغِثْهُ لَوْ كَانَ فَوْقَ هَواءِ","أَنَا سَيْفُ القَضَا لِكُلِّ خِصَامِ"],["847E599B-B431-59D6-AA1F-A44DD722A5E6","أَنَا فِي الْحَشْرِ شَافِعٌ لِمُرِيدِي","عِنْدَ رَبِّي فَلاَ يُرَدُّ كَلاَمِي"],["7CDB5EDB-85AA-578A-8FE3-52772D37AC02","أَنَا شَيْخٌ وَصَالِحٌ وَوَلِيٌّ","أَنَا قُطْبُ وَقُدْوَةٌ لِلأَنَامِ"],["AF5CE1C4-A78F-516E-B00C-72F8A16A2804","أَنَا عَبْدٌ لِقَادِرٍ طَابَ وَقْتِي","وَجَدِّيَ الْمُصْطَفَى شَفِيعُ الأَنَامِ"],["9ABACE63-14D4-5EF4-A162-D88C6806BC0C","فَعَلَيْهِ الصَّلاَةُ في كُلِّ وَقْتٍ","وَعَلى آلِهِ بِطُولِ الدَّوَامِ"]]},"7D111778-C8DA-5D4B-B0F5-B47190549B3E":{"t":"عَلَى الأَوْلِيَا أَلْقَيْتُ سِرِّي وَبُرْهَانِي","p":166,"s":"على الأوليا ألقيت سري وبرهاني","r":"474080","v":[["EB1D4C5C-706B-5D29-BCD3-A55F44DCEE6F","عَلَى الأَوْلِيَا أَلْقَيْتُ سِرِّي وَبُرْهَانِي","فَهَامُوا بِهِ مِنَ سِرِّ سِرِّي وَإِعْلاَنِي"],["18C2CDD3-26C7-598C-8AF6-CA8C0C57CF21","فَأَسْكَرَهُمْ كَأْسِي فَبَاتُوا بِخَمْرَتِي","سَكَارَى حَيَارَى مِنْ شُهُودِي وَعِرْفَانِي"],["6EAD2B5B-7188-5ADE-98FF-750F7862F344","أَنَأ كُنْتُ قَبْلَ القبْلِ قُطْباً مُبَجَّلاَ","تَطُوفُ بِي الأَكْوَانُ وَالرَّبُّ سَمَّانِي"],["05EF7152-D99A-5342-86C2-FEFC04726F33","خَرَقْتُ جَمِيعَ الْحُجْبِ حَتَّى وَصَلْتُهُ","مَقَاماً بِهِ قَدْ جِدَّى لَهُ دَانِي"],["87027A94-F22B-59D9-A537-592128FBB49F","وَقَدْ كَشَفَ الأَسْتَارَ عَنْ نُورِ وَجْهِهِ","وَمِنْ خَمْرَةِ التَّوْحِيدِ بِالْكَاسِ أَسْقَانِي"],["97F0D2B2-59A9-5A58-A817-4C484DB456A4","نَظَرْتُ إِلَى الْمَحْفُوظِ والْعَرْشِ نَظْرَةً","فَلاَحَتْ ليَ الأَنْوَارُ والرَّبُ أَعْطَانِي"],["5E888670-4808-5FBD-BDC5-20D1D8FFE169","أَنَا قُطْبُ أَقْطَابِ الْوُجُودِ بأَسْرِهِ","أَنَا بَازُهُمْ وَالكُلُّ يُدْعَى بِغِلْمَانِي"],["34EA2CFA-E55C-59A7-9CAE-1E85A7EEF4B5","فَلَوْ أَنَّنِي أَلْقَيْتُ سِرِّي بِدَجْلَةٍ","لغَارَتْ وَرَاحَ الْمَاءُ مِنْ سِرِّ بُرْهَانِي"],["17503973-D79A-584C-A2AD-758C02ED1824","وَلَوْ أَنَّنِي أَلْقَيْتُ سِرِّي إِلَى لَظَىً","لأَخْمِدَتِ النِّيرانُ مِنْ عُظْمِ سُلْطَانِي"],["D20429E1-4E6D-55A4-BB21-22EE1328E20E","وَلَوْ أَنَّنِي أَلْقَيْتُ سِرِّي لِمَيِّتٍ","لقَامَ بإِذْنِ اللهِ حَيّاً وَنَادَانِي"],["6C1E7D60-10B2-5181-8F42-7D38ED21BD43","سَلُوا عَنِّيَ السُّرَى سلُوا عَنِّيَ المُنَى","سَلُوا عَنِّيَ القَاصِي سَلُوا عَنِّيَ الدَّانِي"],["4EFF33E1-9FE2-52DD-945B-4E6C80458A62","سَلُوا عَنِّيَ العَليَا سَلُوا عَنَّيَ الثَرَّى","وَمَا كَأنَ تَحْتَ التَحْتِ وَالإِنْسِ وَالجَانِ"],["E67C0D58-A6F4-534F-A04C-4A8A716BC6FA","فَيَا مَعْشَرَ الأَقْطَابِ لُمُّوا بِحَضْرَتِي","وَطُوفُوا بِحَانَاتِي وَاسْعُوا لأَرْكَانِي"],["C2574086-2C2E-5EE2-A3DE-C6F7E2C35B45","وَغُوصُوا بِحَارِي تَظْفَرُوا بِجَوَاهِرِي","وَتِبْرِي وَيَاقُوتِي وَدُرِّي وَمُرْجَانِي"],["6C46CE9D-3468-5415-A6D8-5E6ADF837358","وَقَفْتُ عَلَى الإِنْجِيلِ حَتَّى شَرَحْتُهُ","وَفَكَّكْتُ في التَّوْرَاةِ رَمْزَةَ عِبْرانَيِ"],["53BA2918-04AD-5C07-AF2F-29C694E3C93B","وَحَلَّلتُ رَمْزاً كَانَ عِيسَى يَحُلُّهُ","بِهِ كَانَ يُحْيِي الْمَوْتَا وَالرَّمْزُ سُرْيَانِي"],["FD20413D-E1DE-5812-8D1A-B63A05BE078C","وَخُضْتُ بِحَارَ الْعِلْمِ مِنْ قَبْلِ نَشْأَتِي","أَخِي وَرفَيقِي كَانَ مُوسَى بْنِ عِمْرَانِ"],["D60DD6B9-8E8A-5994-B760-1C5F687331B0","فَمَنْ فِي رِجَالِ اللهِ نَالَ مَكَانَتِي","وَجَدِّي رَسُولُ اللَّهِ فِي الأَصْلِ رَبَّانِي"],["3F1073CA-DF89-5997-BD3E-848F546305A3","أَنَا قَادِرِيُّ الْوَقْتِ عَبْدٌ لِقَادِرٍ","أُكَنَّى بِمُحْيِي الدِّينِ وَالأَصْلُ جِيلاَنِي"]]},"400225DB-3985-58E3-A0AC-9FE2AD32ABDC":{"t":"مَا فِي الصَبابَةِ مَنْهَلٌ مُسْتعْذَبُ","p":166,"s":"ما في الصبابة منهل مستعذب","r":"474069","v":[["75C39A3D-58C3-5205-B9A7-58568BF0B007","مَا فِي الصَبابَةِ مَنْهَلٌ مُسْتعْذَبُ","إِلاّ وَلِي فِيهِ اْلأَلَذُ الأَطْيَبُ"],["3D2E251B-65C3-52DE-A452-33B5527E8BF2","أَوْ فِي الْوِصَالِ مَكَانَهُ مَخْصوْصَةٌ","إلاَّ وَمَنْزلَتي أَعَزُّ وَأَقْرَبُ"],["4D57F790-3699-59C3-B470-A379B5892F41","وَهَبَتْ لِيَ الأَيّامُ رَوْنَقَ صَفْوِهَا","فَحَلَتْ مَنَاهِلْهَا وَطَابَ الْمَشْرَبُ"],["AA2D664E-8B5A-5BA9-BD95-DE415BE19F5F","وَغَدَوْتُ مَخْطُوباً لِكُلِّ كَرِيمةٍ","لاَ يَهْتَدي فِيهَا اللَّبِيبُ فَيَخْطُبُ"],["226D8B01-6CE8-5667-8838-406CEA94A2C7","أَنَا مِنْ رِجَالِ لاَ يَخَافُ جَليسُهُمْ","رَيْبَ الزَّمَانِ وَلاَ يَرى مَا يَرْهَبُ"],["5C48F7D9-461B-5B44-B152-B24365CF039F","قَوْمٌ لَهُمْ فِي كُلِّ مَجْدٍ رُتْبَةٌ","عُلْويَّةٌ وَبِكُلِّ جَيْشٍ مَوْكِبُ"],["6511AA51-E22B-57C3-8C61-40099CAC88F5","أَنَا بُلْبُلُ الأَفْرَاحِ أَمْلأَ دَوْحَها","طَرَباً وَفِي الْعَلْيَاءِ بَازٌ أَشْهَبُ"],["60BDF1E2-4170-5C98-BE0B-3160905CDE2A","أَضْحَتْ جُيُوشُ الحُبِّ تَحْتَ مَشِيئَتي","طَوْعاً وَمَهْمَا رُمْتُهُ لاَ يَعْزُبُ"],["03F79B53-EFB5-5125-A610-3756FF22B248","أَصْبَحْتُ لاَ أَمَلاً ولاَ أُمْنِيَّةً","أَرْجُو وَلاَ سَوْعُودةً أَتَرَقَّبُ"],["EE09ACC0-142A-5130-ACEA-52436A4FFB9D","مَا زِلْتُ أَرْتَعُ فِي مَيَادِينِ الرِّضَا","حَتَّى بَلَغْتُ مَكَانَةً لاَ تُوهَبُ"],["3F920E85-24FD-5493-969E-3E3112151A0B","أَضْحَى الزَّمَانُ كَحُلَّةٍ مَرْقُومَةٍ","نَزْهُو وَنَحْنُ لَهَا الطِّرَازُ المُذْهَبُ"],["A3B5EAF7-56F4-5E23-BC4A-C1C804B9D0F8","أَفَلتْ شُمُوسُ الأَوَّلِينَ وَشَمْسُنَا","أَبَداً عَلَى فَلَكِ الْعُلَى لاَ تَغْرُبُ"]]},"1C789128-02B0-5698-A1ED-3A4E007031DF":{"t":"نَظَرْتُ بِعَيْنِ الْفِكْرِ فِي حَانِ حَضْرَتِي","p":166,"s":"نظرت بعين الفكر في حان حضرتي","r":"474070","v":[["8B822559-BB2A-5930-AA7B-E44497364067","نَظَرْتُ بِعَيْنِ الْفِكْرِ فِي حَانِ حَضْرَتِي","حَبِيباً تتَجَلَّى لِلْقُلُوبِ فَحَنَّتِ"],["3F6E4343-81A9-57D2-B146-DA282D095AE9","سَقَانِي بِكَأْسٍ مِنْ مُدَامَةٍ حُبِّهِ","فَكَانَ مِنَ السَّاقِي خُمَارِي وَسَكْرتِي"],["7F23F8DD-E097-555C-B876-0FAEC152640C","يُنادِمُنِي فِي كُلِّ يَوْمٍ وَلَيْلَةٍ","وَمَا زَالَ يَرْعَانِي بِعَيْنِ الْمَوَدَّةِ"],["A381A268-A543-5949-A43B-B318BC013FAD","ضَرِيحيَ بَيْتُ الله مَنْ جَاءَ زَارَهُ","بِهَرْوَلَةٍ يَحظَ بِعِزٍّ وَرِفْعَةِ"],["64745561-B46C-53F3-970B-3A057F543924","وَسِرَّى بِسِرِّ اللهِ سَارَ بِخَلْقِهِ","فَلُذْ بِجَنَابِي إِنْ أَرَدْتَ مَوَدْتِي"],["5FA6A150-4CA4-5404-BACE-BEE4FCF2EA34","وَأَمْرِي بِأَمْرِ اللهِ إِنْ قُلْتُ كُنْ يَكُنْ","وَكُلٌّ بِأَمْرِ اللهِ فاحْكُمْ بِقُدْرَتِي"],["45E9005D-AF21-5FB8-A29D-B7D1C589BE09","وَأَصْبَحَتُ بِالْوَادِ المُقَدَّسِ جَالِسَاً","عَلَى طُورِ سِينَا قَدْ سَمَوْتُ بِخَلْعَتِي"],["46023789-EC54-570A-991B-13408D6744B5","وَطَافَتْ بِيَ الأَكْوانُ مِن كُلِّ جَانِبٍ","فَصِرْتُ لَهَا أَهْلاً بِتَحْقِيقِ نِسْبَتِي"],["80AF95DD-8080-53DE-ABE1-B6408633A9CF","فَلِي عَلَمٌ فِي ذَرْوَةِ الْمَجْدِ قَائِمٌ","رَفِيعُ الْسَّنَا تَأْوِي لَهُ كُلُّ أُمَّةِ"],["BD20A037-36EF-593E-99CF-24080265B03C","فَلاَ عِلْمَ إِلاَّ مِنْ بِحَارٍ وَرَدْتُهَا","وَلاَ نَقْلَ إِلاَّ مِنْ صَحِيحِ رِوَايَتي"],["F275AF3A-0A82-505C-9D8E-73DEDBE65356","عَلَى الدُّرَّةِ الْبَيْضَاء كَانَ اجْتمَاعُنَا","وفِي قَابَ قَوْسَيْنِ اجْتِمَاعُ الأَحِبَّةِ"],["5EC3EF96-BC0F-507D-9449-3A727301A8C2","وَعَايَنْتُ إِسْرَافيل وَاللَّوْحَ وَالرِّضَا","وَشَاهَدْتُ أَنْوَارَ الجَلاَلِ بِنَظْرَتِي"],["34AED48B-CC14-509B-95A2-D49CCAAC73DA","وَشَاهَدْتُ مَا فَوْقَ السَّماوَاتِ كُلَّهَا","كَذَا الْعَرْشُ وَالْكُرْسيِّ فِي طَيِّ قَبْضَتِي"],["8C1E7D6B-ED2F-5BE7-99B9-80827A8C3D84","وَكُلُ بِلاَدِ اللهِ مُلْكِي حَقِيقَةً","وَأَقْطَابُهَا مِنْ تَحْتِ حُكْمِي وَطَاعَتِي"],["59EB908C-DEE2-50EE-B56B-D1BEF45BD444","وَجُودِي سَرَى فِي سِرِّ سِرِّ الحَقِيقَةِ","وَمَرْتَبَتِي فَاقَتْ عَلى كُلِّ رُتْبَةِ"],["3BBE06B2-937F-55FC-8906-AD24E516A03F","وَذِكْرِى جَلَى الأَبْصَارَ بَعْدَ غِشَائِهَا","وَأَحْيَا فُؤَادَ الصَّبِّ بَعْدَ الْقَطِيعَةِ"],["53C7B67B-4C8D-5C96-AD58-DF29B13FD36B","حَفِظْتُ جَمِيعَ الْعِلْمِ صِرْتُ طِرَازَهُ","عَلَى خِلْعَةِ التَّشْرِيفِ فِي حُسْنِ خَلْوَتِي"],["2C0893C0-44C1-56B8-85C6-3F2D7D817E45","قَطَعْتُ جَمِيعَ الْحُجْبِ لِلْحُبِّ صَاعِداً","وَمَا زِلْتُ أَرْقَى سَائِراً بِمَحَبتِي"],["2F38A2EC-D216-534B-AE37-FDB3145B7082","تَجَلَّى لِيَ السَّاقِي وَقَالَ إلىَّ قُمْ","فَهَذَا شَرَابُ الْحُبِّ فِي حَانِ حَضْرَتِي"],["57EEE330-6840-548A-A07B-19C2C3C939B0","تَقَدَّمْ وْلاَ تَخْشَ كَشَفْنَا حِجَابَنَا","تَمَلَّ بِحَانِي وَالشَّرَابِ وَرُؤْيَتي"],["73B36A13-F63A-50CD-9522-FDEB87670DAB","شَطَحْتُ بِهَا شَرْقَاً وَغَرْبَاً وَقِبْلَةً","وَبَرَّاً وبحراً مِنْ نَفَائِسِ خَمْرَتِي"],["B570E19A-BD55-558F-8C27-7CDC2F047DA8","وَلاَحَتْ لِيَ الأَسْرارُ مِنْ كُلِّ جَانِبٍ","وَبَانَتْ لِيَ الأَنْوَارُ مِنْ كُلِّ وَجْهَةِ"],["7834E3FC-2AC1-5491-890E-F170C3404C27","وَشَاهَدْتُ مَعْنىً لَوْ بَدَا كَشْفُ سِرِّهِ","لِصُمِّ الْجِبَالِ الرَّاسِيَاتِ لَدُكَّتِ"],["167D4B86-DFB5-560C-AC34-4CC7E272E7CA","وَمَطلعُ شَمْسِ الأُفْقِ ثُمَّ مَغِيبُهَا","وَأَقْطَارُ أَرْضِ الله فِي الْحَالِ خَطْوَتِي"],["937E75C3-56B1-560B-AAAD-A249AA8B5BB3","أَقَلَّبُهَا فِي رَاحَتَىَّ كَأُكْرَةِ","أَطُوفُ بِهَا جَمْعَاً عَلَى طُولِ لَمْحَتِي"],["4AFAD8FE-CAE8-549B-A075-19562F970785","أَنَا قُطْبُ أَقْطَابِ الوُجُودِ حَقِيقَةً","عَلَى سَائِرِ الأَقْطَابِ قَوْلِي وَحُرْمَتِي"],["E90DC758-1B3A-5F77-A699-8D1514230173","تَوَسَّلْ بِنَا فِي كُلِّ هَوْلٍ وَشِدَّةٍ","أُغِيثُكَ فِي الأَشْيَاءِ طُرَّاً بِهِمَّتِي"],["2039D2F6-5CDB-5385-88AC-9F252FADE4DF","أَنَا لِمُرِيدِي حَافِظٌ ما يَخَافُهُ","وَأَحْرُسُهُ مِنْ كُلِّ شَرٍّ وَفِتْنَةِ"],["ADF1604B-0720-5AAD-9B27-8FCCB2FC0207","مُرِيدِيَ إِذْ مَا كَأنَ شَرْقاً وَمَغْرباً","أُغِثْهُ إِذَا مَا سَارَ فِي أَيِّ بَلْدَةِ"],["0DC2C3B5-BD1C-520F-B4E5-1A39FB38A7B4","فَيَا مُنْشِدَاً لِلنَّظْمِ قُلْهُ وَلاَ تَخَفْ","فَإِنَّكَ مَحْرُوسٌ بِعَيْنِ الْعِنَايَةِ"],["268187DC-6496-5FF3-991F-10066DABA903","وَكُنْ قَادِرِيَّ الْوَقْتِ لِلَّهِ مُخْلِصَاً","تَعِيشُ سَعِيدَاً صَادِقَاً بِمَحَبَّتِي"]]},"CEF1BDA6-E004-585A-B7B0-74BBFA308A20":{"t":"وَلَما صَفَا قَلْبي وَطَاَبتْ سَرِيرَتِي","p":166,"s":"ولما صفا قلبي وطابت سريرتي","r":"474068","v":[["182C7A36-3AE8-5666-A517-4D1F9588A42C","وَلَما صَفَا قَلْبي وَطَاَبتْ سَرِيرَتِي","وَنَادَمَنِي صَحْويِ بِفَتْحِ الْبَصِيرة"],["0532C28A-7D9E-51F1-9053-682742446B62","شَهِدْتُ بِأَنَّ الله مَوْلَى الْوِلاَيَةِ","وَقَدْ مَنَّ بِالتَّصْرِيفِ فِي كُلِّ حَالَةِ"],["12AD6A58-C9F4-56B8-B595-407CC41E579E","سَقَانِي إِلهيِ مِنْ كؤوس شَرَابِهِ","فَأَسْكَرَنِي حَقَاً فَهِمْتُ بِسَكْرتِي"],["0128EF10-F13E-5620-BB0A-801E5A00F923","وحَكْمَنِي جِمْع الدِّنَانِ بِمَا حَوَى","وَكُلُّ مُلُوكِ الْعَالمِينَ رَعِيَّتي"],["F1DE88C2-4415-5898-B3E0-A30163800A0D","وَفيِ حَانِنَا فادْخُلْ تَرَ الْكَأْسَ دَائِراً","وَمَا شَرِبَ العُشَّاقُ إِلاَّ بَقِيَّتي"],["55E53780-E31B-54D6-8ED8-45E209158898","رُفِعْتُ عَلَى مَنْ يَدَّعِي الْحُبَّ فِي الْوَرَى","فَقَرَّبَني الْمَوْلَى وَفُزْتُ بِنَظْرَةِ"],["F21D75D2-4068-578E-81CA-6FF0F00801E1","وَجَالَتْ خُيُولِي فِي الأَرَاضِي جَمِعَها","وَزُفَّتْ لِيَ الْكَاسَاتُ مِنْ كُلِّ وِجْهَةِ"],["57961FE5-A6B9-54BE-8CC9-4B8A2EE06425","وَدُقَّتْ لِي الْرَايَاتُ فِي الأَرْضِ وَالسَّمَا","وَأَهْلُ السَّمَا والأَرْضِ تَعْلَمُ سَطْوتِي"],["45EAAE62-3907-5C21-AEE2-43DFF4381FF9","وَشَاءُوسُ مُلْكِي سَارَ شَرْقاً وَمَغْرِباً","فَصِرْتُ لأَهْلِ الْكَرْبِ غَوْثاً ورَحْمَةِ"],["38948B82-65A9-5352-A569-FD33FB1E5B6E","فَمَنْ كَانَ مِثْلِي يَدَّعِي فِكُمُ الْهَوَى","يُطَاوِلُني إنْ كَانَ يَقْوَى لِسَطْوَتِي"],["3787A432-29F7-56C9-BEE8-ADC4F230B5E8","أَنَّا كُنْتُ في الْعُلْيَا بِنُور مُحَمَّدٍ","وَفِي قَابَ قَوْسَيْنِ اجْتِمَاعُ الأَحِبَّةِ"],["B93C0F96-A66B-5D96-AEDD-CDF395FA5A77","شَرِبْتُ بِكَاسَاتِ الغَرَامِ سُلاَفَةً","بِهَا انْتَعَشَت روحِي وَجِسْمِي وَمُهْجَتِي"],["BA3B64E1-26ED-5048-ACBE-67D23233A417","وَصِرْتُ أَنَا السَاقِي لِمَنْ كَانَ حَاضِراً","أُدِيرُ عَلَيهِمْ كَرَّةً بَعْدَ كَرَّةِ"],["EEE2D0D0-50B2-50B1-882D-35D747832893","وَقَفْتُ بِبَابِ اللهِ وَحْدِي مُوَحِّدَاً","وَنُودِيتُ يَا جِيلاَنِيَ ادْخُلْ لِحَضْرتِي"],["F178AD0F-4E63-5283-9E48-929387AE3032","وَنُوديتُ يَا جِيلاَنِيَ ادْخُلْ وَلا تَخفْ","عُطيتُ اللوا مِنْ قَبْلِ أَهْلِ الحَقِيقَةِ"],["749C395A-EBC0-52D7-8243-EE08676F9A3C","ذِرَاعِيَ مِنْ فَوْقِ السَّمَواتِ كُلَّهَا","وَمِنْ تَحْتِ بَطْنِ الحُوتِ أَمْدَدْتُ رَاحَتي"],["F24646CE-D29D-5249-971A-5D1B930E53BD","وَأَعْلَمُ نَبْتَ الأَرضِ كَمْ هُوَ نَبْتَةٌ","وَأَعْلَمُ رَمْلَ الأَرْضِ عَدَّاً لِرَمْلَةِ"],["59E98CF8-E1F8-58DB-9C0A-17AE5262C22A","وَأَعْلَمُ عِلْمَ اللهِ أُحْصِي حُروفَهُ","وأَعْلَمُ مَوْجَ الْبَحْرِ عَدَّا لِمَوْجَةِ"],["99852441-B2B4-5071-A65C-8821A0D595FD","وَمَا قُلْتُ هَذَا القَوْلَ فَخْراً وإنَّمَا","أَتَى الإِذْنُ حَتَّى تَعْرِفُوا مِنْ حَقِيقَتي"],["7D43B623-D3F0-53FA-9907-C378AC72A2DB","وَمَا قُلْتُ حَتْى قِيلَ لِي قُلْ وَلاَ تَخَفْ","فَأَنْتَ وَلِييِّ فِي مَقَامِ الْوِلاَيةِ"],["A907FD54-9E4B-5DF0-99A7-82B64E8F1552","أَنَا كُنْتُ مَعْ نُوْحٍ أُشَاهِدُ فِي الْوَرَى","بِحَاراً وَطُوقَاناً عَلَى كَفِّ قُدْرَتي"],["DAAC117F-5BCB-53BA-90DC-15D80E52C5CC","وَكُنْتُ وَإِبْراهِيمَ مُلْقَىً بِنَارِهِ","وَمَا بَرَّدَ النِّيرانَ إِلاَّ بدَعْوَتِي"],["6E649BFF-50C5-5BB3-BB3F-BABFABDA98FB","وَكُنْتُ مَعَ اسْمَعِيلَ في الذَّبْحِ شاهِدَاً","وَمَا أَنْزَلَ المَذْبُوح إِلاَّ بِفُتْيَتي"],["0C0B55E2-1618-57D0-B04F-297437CF8FB2","وَكُنْتُ مَعَ يَعْقُوبَ فِي غَشْوِ عَيْنِهِ","وَمَا بَرِئَتْ عَيْنَاهُ إِلاَّ بِتَفْلَتِي"],["081B564C-79A2-5783-BCDE-B98153C0E8A2","وَكُنْتُ مَعَ إِدْرِيسَ لَمَّا ارْتَقَى الْعُلا","وَأُسْكِنَ فِي الْفِرْدَوْسِ أَحْسَنَ جَنَّةِ"],["3505B5A0-04C9-50A3-8182-B18FFC8DA06F","وَكُنْتُ وَمُوسَى فِي مُنَاجَاةِ رَبِّهِ","وَمُوسَى عَصَاهُ مِنْ عَصَايَ اسْتَمَدَّتِ"],["BE9A506C-7A2E-5F34-94C4-3789AFB1DE8E","وَكُنْتُ مَعَ أيِّوبَ في زَمَنِ الْبَلا","وَمَا بَرِئَتْ بَلْوَاهُ إلاَّ بِدَعْوَتِي"],["F1AA55DD-595F-53F2-A078-FD0226C78A62","وَكُنْتُ مَعَ عِيسَى وَفِي الْمَهْدِ ناطِقَاً","وَأَعْطَيْتُ دَاوُداً حَلاَوةَ نَغْمَتِي"],["F3DB953C-4949-5A71-84A6-C792DD4A69D2","وَلِي نَشَأَةَ في الْحُبِّ مِنْ قَبْلِ آدمِ","وَسِرِّي سَرَى فِي الْكَوْنِ مِنْ قَبْلِ نَشْأَتِي"],["107B9E34-3942-524D-BC1C-D4BA704F5AF0","أَنَا الذَّاكِرُ المَذْكُورُ ذِكْراً لِذَاكِرٍ","أَنَا الشاكِرُ المَشْكُورُ شُكْراً بِنِعْمَتِي"],["BB28E484-0D25-5CAD-91DE-C80300E12019","أَنَا الْعَاشِقُ الْمَعْشَوقُ فِي كُلِّ مُضْمَرٍ","أَنَا السَّامِعُ الْمَسْمُوعُ فِي كُلِّ نَغْمَةِ"],["FC095E7F-CE54-5876-AE6D-7EE5C9BC0E31","أَنَا الْوَاحِدُ الْفَرْدُ الْكَبِيرُ بِذَاتِهِ","أَنَا الْوَاصِفُ الْمَوْصُوفُ عِلْمُ الطَّرِيقَةِ"],["E6DA1C7C-0809-5E94-99C1-8BA606C11182","مَلَكْتُ بِلاَدَ اللَّهِ شَرْقَاً وَمَغْرِباً","وَإِنْ شِئْتُ أَفْنَيْتُ الأَنَامَ بِلَحْظَةِ"],["4948C3C8-2CB9-5FFC-A0C9-6D2E974B73BF","وَقَالَوا فَأَنْتَ الْقُطبُ قُلْتُ مُشَاهدُ","وَنَالٍ كِتَابَ اللهِ فِي كُلِّ سَاعَةِ"],["726F2D09-0696-5F45-A89E-95DE1E4E6062","وَنَاظِرُ مَا فِي اللَّوْحِ مِنْ كُلِّ آيَةٍ","وَمَا قَدْ رَأَيْتُ مِنْ شُهُودٍ بِمُقْلَتِي"],["4F2801CF-45FC-59EE-96CD-1E7F868291A9","فَمْن كَانَ يَهْوَانَا يَجِي لِمَحَلِّنَا","وَيَدْخُلْ حِمَى السَّادَاتِ يَلْقَ الْغَنِيمَة"],["E310751B-D969-5D8F-84E7-05E9F5260803","فَلاَ عَالِمٌ إِلاَّ بِعِلْمِيَ عَالِمٌ","وَلاَ سَالِكٌ إِلاَّ بِفَرْضِي وَسُنَّتِي"],["33FD4F5E-BCE0-5AE2-B6FC-5EF3937B0FF3","وَلاَ جَامِعٌ إِلاَّ وَلِي فِيهِ رَكْعَةٌ","وَلاَ مِنْبَرٌ إِلاَّ وَلِي فِيهِ خُطْبَتِي"],["39D96CB5-F19F-5435-8937-EEB9C4EA01F9","وَلَوْلاَ رَسُولُ اللهِ بِالْعَهْدِ سَابِقٌ","لأَغْلَقْتُ أَبْوَابَ الْجَحِيمِ بِعْظمَتِي"],["1B8C61EB-5E86-535E-BEC6-EB0071DB77FB","مُرِيدِي لَكَ الْبُشْرَى تَكُونُ عَلى الْوَفَا","وَإِنْ كُنْتَ فِي هَمٍّ أُغِثْكَ بِهِمَّتي"],["2F4A0A85-71B8-532F-B5E8-2CE1E920548F","مُرِيدِي تَمَسَّكْ بِي وَكُنْ بِيَ وَاثِقَاً","لأَحْمِيكَ فِي الدُّنْيَا وَيَوْمَ الْقِيَامَةِ"],["06E0DCD3-86B5-5F28-B098-A04BD453E0AC","وَكُنْ يَا مُرِيدِي حَافِظَاً لِعُهُودِنَا","أَكُنْ حَاضِرَ الْميِزَانِ يَوْمَ الْوَقِيعَةِ"],["57253A69-D48B-5BCF-98E4-21DA7093536C","وَإِنْ شَحَّتِ الْميزَانُ كُنْتُ أَنَا لَهَا","بِعَيْنِ عِنَايَاتٍ وَلُطْفِ الْحَقِيقَةِ"],["65F4A116-AC5F-53B6-91C1-48DFF1C756DB","حَوَائِجُكُمْ مُقْضِيَّةً غَيْرَ أَنَّنِي","أَرِيدُكُمُو تَمْشُون طُرْقَ الْحَمِيدَةِ"],["AF5DB3E3-2872-50D4-BA9A-D13C04CE619A","وَأَوْصِيكُمُو كَسْرَ النُّفُوسِ فإِنَّها","مَرَاتِبُ عِزِّ عِنْدَ أَهْلِ الطَّرِيقَةِ"],["A3A576C6-5DBB-5835-99B8-7E4C1045FD35","وَمَنْ حَدَّثَتْهُ نَفْسُهُ بِتَكَبُّرٍ","تَجِدْهُ صَغِيراً في عُيُونِ الأَقِلَّةِ"],["02C83796-BE7E-5462-BAF5-352365AE2204","وَمَنْ كَانَ فِي حَالاتِهِ مُتَواضِعَاً","مَعَ اللهِ عَزَّتْهُ جَميعُ الْبَرِيَّةِ"]]}}}