{"v":1,"poems":{"6AA02D80-87A8-593B-B71F-905792F80B5F":{"t":"أبى القلبُ اليمانيّ الـــ","p":69,"s":"أبى القلب اليماني الـــ","r":"441306","v":[["C25BBB80-E9B5-5200-890D-361EF0E0CD05","أبى القلبُ اليمانيّ الـــ","ذي تُحمدُ أخلاقهْ"],["212BC5F9-2818-55AD-B2F1-5659BEA6E78E","ويرفضُّ له اللحنُ","فما تفتق أرتاقهْ"],["8D38975A-F1A8-5D3F-9535-27FABD89086B","غزالٌ أدعجُ العينِ","رَبيبُ خَدَلَّجٍ ساقُهْ"],["4E85A99B-F592-5EAB-AB8F-874C8F8D751A","رماني فسبى قلبي","وأرميهِ فأشتاقهْ"]]},"87E003BD-7B6A-59EE-8BE0-38C528D7B4B1":{"t":"أتعْرِفُ أطْلالاً بميْسَرَةِ اللِّوى","p":69,"s":"أتعرف أطلالا بميسرة اللوى","r":"441324","v":[["6BD47C08-C629-5B3A-AD1E-0401BC40016F","أتعْرِفُ أطْلالاً بميْسَرَةِ اللِّوى","إلى أرعبٍ قدْ حالفتكَ به الصبا"],["165CF895-F9EF-53AF-86B7-D125109BDEAF","فأهْلاً وسَهْلاً بالَّتِي حَلَّ حبُّها","فؤادي وحلَّتْ دارَ شَحْطٍ من النَّوى"],["44173856-0FED-5E62-AAD6-430B6CD7A705","أبادرُ درنوكَ الأميرِ وقربهِ","لأذْكرَ في أهلِ الكَرامَةِ والنُّهى"],["4EDB3E8D-0A0F-5130-BA56-02D0C598511D","وأتبع القصاصَ كلَّ عشيةٍ","رَجاءَ ثوابِ اللَّه في عدَدِ الخَطا"],["D4650568-5B77-526B-827E-C3EFE25D90AF","وأمْستْ بقصرٍ يَضْرِبُ الماءُ سورَهُ","وأصْبَحْتُ في صَنْعاءَ ألْتَمِسْ النَّدَى"],["5AD460EF-812B-56A4-8FDB-406727A2539A","فمنْ مبلغٌ عني سماعةَ ناهياً","فإنْ شئْتَ فاقْطَعْنا كما يُقْطَع السَّلى"],["9064DFB6-E44B-5DFD-9AC7-BAAE935D8A42","وإنْ شئتَ وصلَ الرحمِ في غيرِ حيلةٍ","فعَلْنا وقُلْنا للَّذِي تَشْتَهي بَلى"],["8CC9C9BD-9059-5FCD-9F84-ADAF950503F0","وإنْ شئْتَ صُرْماً للتفرُّقِ والنَّوى","فبُعداً، أدامَ اللَّهُ تفرقَةَ النَّوى"]]},"CC6F5605-FD5C-5A7A-AD0F-3E128CB013ED":{"t":"أراعكَ طائرٌ بعدَ الخفوقِ","p":69,"s":"أراعك طائر بعد الخفوق","r":"441303","v":[["764F4880-FEA5-5145-939F-BB0E8FC8E1CB","أراعكَ طائرٌ بعدَ الخفوقِ","بفاجِعَةٍ مُشنَّعةِ الطُّروقِ"],["EB8A2A75-4DE8-5463-B015-A42F3AC0B5DC","نَعمْ ولَهاً على رجلٍ عميدٍ","أظَلُّ كأنَّني شَرِقٌ برِيقي"],["8B7D6155-B6DF-50A0-9A93-9AD910014570","كأنِّي إذا عَلمتُ بها هُدُوًّا","هوتْ بي عاصفٌ منْ رأسِ نيقِ"],["25F67F44-C540-5756-B6F4-E310387416AB","أعلُّ بزفرةٍ منْ بعد أخرى","لَها في القلْبِ حَرٌّ كالحَرِيقِ"],["6D7C080F-5217-5D86-8C77-259FDBF97675","وتَرْدُفُ عبْرَةً تَهتَانَ أخرى","كفائضِ غربِ نضاحٍ فتيقِ"],["46BF604F-158E-51B8-B4EE-02C35748A8DC","كأنِّي إذْ أكفكِفُ دَمعَ عيني","وأنهاها أقولُ لها: هريقي"],["D0B169B0-3CD4-547B-B404-A01D28EE930C","ألا تلكَ الحوادثُ غبتُ عنها","بأرْضِ الشَّامِ كالفَرْدِ الغَريقِ"],["3770F9C4-A91E-533E-AEF0-E268FE80F179","فما أنْفَكُّ أنظرُ في كتابٍ","تداري النفسُ عنهُ هوى زهوقِ"],["3BC8BAED-E0FB-5798-9F47-B944C7D018F8","يُخَبّرُ عَنْ وَفاةِ أخٍ كَرِيمٍ","بعيدِ الغَوْرِ نفَّاعٍ طَليقِ"],["3534D278-33A8-5D36-A297-36A8256D8CE9","وقرمٍ يعرضُ الخصمانُ عنهُ","كما حادَ البِكارُ عنِ الفَنيقِ"],["23ECE941-A6BE-54EB-AACA-4BA0BC635929","كَريمٍ يملأُ الشّيْزى وَيَقري","إذا ما قلَّ إيماضُ البروقِ"],["8C1B6EEE-7363-5526-886F-5F5464C8D00C","وأعظمُ ما رميتُ به فجوعاً","كتابٌ جاءَ منْ فجٍ عميقِ"],["2A1E40B8-BA7C-54BF-A9E9-17D3B29AADC2","يُخبِّرُ عَنْ وفاةِ أخٍ فصبْراً","تَنَجَّزْ وعْدَ منّانٍ صَدُوقِ"],["83A0538B-08AB-58BA-87E0-758840F5E50F","سأصْبِرُ للقضاءِ فكُلٌّ حَيٍّ","سيَلْقَى سَكْرَةَ الموْتِ المَذُوقِ"],["DDCA5599-82A4-5D16-BF2B-BFDE664B98B8","فما الدّنيا بقائِمةٍ وفيها","منْ الأحياءِ ذُو عَيْنٍ رَمُوقِ"],["4DCA3BB7-8691-5DC8-B714-59D0C93F94A9","وللأحياءِ أيامٌ تقضى","يلفُّ ختامها سوقاً بسوقِ"],["13678528-4702-5221-A614-312D1E77027A","فأعْناهُمْ كأعْدمِهم إذا ما","تقضتْ مدةُ العيشِ الرقيقِ"],["D6335F04-88E7-53C6-B4CB-AD2662B55105","كذلِكَ يُبعثنَ وهُم فُرادى","ليومٍ فيه توفيةُ الحُقوقِ"],["82A384D6-553F-54CF-8E97-A4E6781FEE6B","أبعدَ هُمامِ قوْمِكِ ذِي الأيادي","أبي الوضاحِ رتاق الفتوقِ"],["F3891CDB-84FE-57AC-B20C-A88014D44DCC","وبعدَ عبيدةَ المحمودِ فيهمْ","وبعدَ سماعةَ العودِ العتيقِ"],["14C8FBF3-0C5B-5767-87E9-45FB07F4A6A6","وبعدَ ابنِ المُفضَّلِ وابنِ كافٍ","هما أخَواكَ في الزَّمنِ الأنيقِ"],["978FBAE4-975E-5836-B168-19F7EFBE2AC5","تؤمِّلُ أنْ تعيشَ قَرِيرَ عَينٍ","وأينَ أمامَ طَلاّبٍ لَحُوقِ"],["FFF53ED6-2F7E-5B61-B5FB-9FEB8810BD0B","ودُنْياكَ الَّتِي أمْسَيْتَ فيها","مزايلةُ الشقيقِ عنِ الشقيقِ"]]},"21BFB514-03EF-56F5-B981-E6114154055D":{"t":"أضاءتْ لهُ الآفاقُ حتى كأنما","p":69,"s":"أضاءت له الآفاق حتى كأنما","r":"441294","v":[["D8043346-917A-5755-94BF-FA5FD110A495","أضاءتْ لهُ الآفاقُ حتى كأنما","رأينا بنصفِ الليلِ نورَ ضُحى الغَدِ"]]},"41A47FAE-C324-563E-86E0-FA94AC30E134":{"t":"أعِنِّي على بيضاءَ تَنكَلُّ عَنْ بَرَدْ","p":69,"s":"أعني على بيضاء تنكل عن برد","r":"441296","v":[["6B85AB60-A2EF-5A36-8D0C-987A4B8C1694","أعِنِّي على بيضاءَ تَنكَلُّ عَنْ بَرَدْ","وَتَمْشِي على هَوْنٍ كمِشْيَةِ ذِي الحَرَدْ"],["18B09F71-C5FC-56A9-9B02-9F2E8BB8CE22","وتلبسُ منْ بزِّ العراقِ مناصفاً","وأبرادَ عصبٍ من مهلهلةِ الجندْ"],["94429619-5443-5FA7-B577-0FC33AFF9A07","إذا قُلتُ يوماً نَوّليني تَبَسَّمَتْ","وقالتْ لعمرُ اللهِ لوْ أنهُ اقتصدْ"],["4B36BA75-32EE-575F-A343-A823E19C782E","سموتُ إليها بعدَ ما نامَ بعلها","وقدْ وسَّدَتْهُ الكَفَّ في ليلةِ الصَّرَدْ"],["44FDCBA2-F46C-55C7-816F-30849EEDC802","أشارتْ بطرفِ العينِ أهلاً ومرحباً","ستعطي الذي تهوى على رغمِ منْ حسدْ"],["7C54091A-CDB6-5551-A7D4-742BBE3746F6","ألستَ ترى مَنْ حوْلَنا مِنْ عَدوِّنا","وكُلَّ غُلامٍ شامِخِ الأنفِ قدْ مَرَدْ"],["1C7A6B3E-5EFA-5B77-83D2-072447E388F3","فقلْتُ لها: إنّي أمرؤٌ فاعْلَمِنَّهُ","إذا أخذتُ السيفَ لم أحفل العددْ"],["CCB98B71-188F-5B6F-944F-690C0E88B924","بَنَى ليَ إسماعِيلُ مَجْداً مُؤَثَّلاً","وعبْدُ كُلالٍ قَبْلَهُ وأبُو جَمَدْ"],["E206183C-D4C5-5C6D-B1EE-15CA8D30FA83","تُطِيفُ عَلينا قَهْوَةٌ في زُجاجَةٍ","تُريكَ جَبانَ القَوْمِ أمضى مِنَ الأسَدْ"]]},"BB782957-6B33-5864-80F2-4945B1B563DC":{"t":"أغَدَوْتَ أمْ في الرَّائحين تَروحُ","p":69,"s":"أغدوت أم في الرائحين تروح","r":"441293","v":[["3241DF40-B4E6-50F9-8476-502D7C252198","أغَدَوْتَ أمْ في الرَّائحين تَروحُ","أمْ أنْتَ مِنْ ذِكْرِ الحِسانِ صَحيحُ"],["E7C162BD-B2DE-5DD7-9F4C-5CF36EB8100B","إذْ قالتِ الحسناءُ: ما لصديقنا؟","رثَّ الثيابِ وإنَّه لَمِليحُ"],["112AF0FA-DFBB-51CC-A1C4-D8BF0819B95B","لا تسألنَّ عن الثيابِ فإنني","يومَ اللقاءِ على الكماةِ مشيحُ"],["7E66FE03-82C7-5E09-A5FB-0C25806B902F","أرْمِي وأطْعَنُ ثُمَّ أُتبِعُ ضَرْبَةً","تدعُ النساءَ على الرجالِ تنوحُ"]]},"4F6019DF-2ED0-53A1-80C8-BAD2B4A49BEE":{"t":"ألا يا لقومي أطلقوا غلَّ مرتهنْ","p":69,"s":"ألا يا لقومي أطلقوا غل مرتهن","r":"441323","v":[["41361A73-D369-566B-B0AC-9839237EF66A","ألا يا لقومي أطلقوا غلَّ مرتهنْ","ومنوا على مستشعرِ الهمِّ والحزنْ"],["7CB8218F-6862-5532-B5E8-29BBE835B76F","تَذَكَّرَ سَلْمى وَهْيَ نازِحَةٌ فَحَنْ","وهَلْ تَنْفَعُ الذِكْرَى إذا اغْتَرَب الوَطَنْ"],["7666DA14-EDB8-5419-8E24-CBF772C2FF6C","ألمْ ترها صفراءَ رؤداً شبابها","أسِيلَةَ مَجْرَى الدَّمْعِ كالشَّادِنِ الأغَنْ"],["72C0DFEE-ADDE-5E8E-B0E7-0E949A58447A","وأبْصَرْتُ سَلمى بَيْنَ بُرْدَيْ مَراجِلٍ","وأبرادُ عصبٍ من مهلهلةِ اليمنْ"],["F192A007-8132-5C1E-AB8D-28C45B578BD1","فقُلْتُ لَها تَرْتَقِي السَّطْحِ إنَّنِي","أخافُ علَيْكُمْ كُلَّ ذِي لِمَّةِ حَسَنْ"]]},"6563E6C8-8818-51B2-BEE3-105EF8A4AD7C":{"t":"أيا بنةَ الواحدِ جودي فما","p":69,"s":"أيا بنة الواحد جودي فما","r":"441316","v":[["F213F468-914C-5786-8B69-20341049671A","أيا بنةَ الواحدِ جودي فما","إنْ تصرميني فبما أولما"],["C9150AA5-420B-5538-919F-9FA04F9FBE8E","جودي علينا اليومَ أو بيِّني","فِيمَ قَتَلْتِ الرَّجُلَ المُسْلِما"],["B006B7A5-4B8A-514E-9BAB-DA2798599C6B","إنّي وأيْدِي قُلُصٍ ضُمَّرٍ","وكلِّ خرقٍ وردَ الموسما"],["727614F8-8D9F-50E8-A11D-AD151000FFA4","ما عُلِّقَ القَلْبُ كتَعْلِيقِها","واضعةً كفاً علتْ معصما"],["9450E834-02E5-5FED-A80C-CF23A9FCB75D","رَبَّة مِحْرابٍ إذَا جِئْتُها","لمْ ألقها أوْ أرتقي سلما"],["0C169587-D504-5430-BA94-5CE3085E9256","إخْوَتُها أرْبَعَةٌ كُلُّهُمْ","ينفونَ عنها الفارسَ المعلما"],["F7ED546B-8A4E-54B7-ACC4-C6F8647ADA8D","كيفَ أرجيها ومنْ دونها","بَوّابُ سُوءٍ يُعْجِل المُشْتَما"],["696DF2FB-958E-5EDD-80C6-EC0A3679EAB5","أسودُ هتاكٌ لأعراضِ منْ","مرَّ على الأبوابِ أو سلما"],["9917F04B-9B8C-5351-8209-01A854058BE2","لا مِنَّةً أعْلَمُ كانتْ لَها","عِنْدِي وَلا تَطْلُبُ فِينَا دَما"],["71F561E2-7752-5723-81BC-B071FEB383AD","بِلْ هِيَ لمَّا أنْ رأَتْ عاشِقاً","صَبّاً رَمتْهُ اليَوْمَ فِيمَنْ رَمَى"],["1EA0218C-2C0A-53D0-95B4-989A7DF90808","لمَّا ارْتَمَيْنا ورَأَتْ أَنَّها","قدْ أثبتتْ في قلبهِ أسهمها"],["91478795-F786-5E0F-B3E6-ADDB85CDA940","أعجبها ذاكَ فأبدتْ لهُ","سُنَّتَها البَيْضاءَ والمِعْصَما"],["F456F369-1F90-58F3-A72F-8B9B76D2A5B2","قامَتْ تَراءَى لِي على قَصرِها","بينَ جوارٍ خردٍ كالدمى"],["79DAEBA0-F8AB-5487-A185-9A1C1BB7942D","وتعقدُ المرطَ على جسرةٍ","مثلِ كَثيبِ الرمْلِ أوْ أعْظَما"]]},"F2526BEC-95D6-5AF4-B0B2-2AF55034CF28":{"t":"أيا نخلتيْ وادي بوانةَ حبذا","p":69,"s":"أيا نخلتي وادي بوانة حبذا","r":"441318","v":[["E10D7950-0169-500E-85DB-8844C16599C5","أيا نخلتيْ وادي بوانةَ حبذا","إذا نَامُ حُرَّاسُ النَّخِيلِ جَنَاكُما"]]},"1C916BA5-947B-5BA8-B637-BE8618EA61EE":{"t":"أيها الناعبُ ماذا تقولُ","p":69,"s":"أيها الناعب ماذا تقول","r":"441310","v":[["556FFCDA-F873-53D2-903C-09DDAFAED1C2","أيها الناعبُ ماذا تقولُ","فكلانا سائلٌ ومسولُ"],["1F18FC61-698F-531B-8583-D0EA1C4EF64E","لا كساكَ اللهُ ما عشتَ ريشاً","وبخوفٍ بتَّ ثمَّ تقيلُ"],["58E70605-1411-5B35-807C-F48E0446509B","ثُمَّ لا أَنْقَفْتَ في العُشِّ فَرْخاً","أبداً إلاَّ عليكَ دليلُ"],["38299E30-C0F7-56F2-BBA5-F27A418BEA68","حِينَ تُنْبِي أنَّ هِنْداً قَرِيبٌ","يَبلُغُ الحاجاتِ منها الرَّسولُ"],["953D005A-2B4D-52FC-8A36-D066361A30DA","ونأتْ هِنْدٌ فَخبَّرْتَ عَنها","أنَّ عهدَ الودِّ سوفَ يزولُ"]]},"B7DC0DB3-6914-5494-B02B-A791467047B3":{"t":"أيَا رَوْضَةَ الوَضَّاحِ يا خَيرَ روْضَةٍ","p":69,"s":"أيا روضة الوضاح يا خير روضة","r":"441307","v":[["C3264B5A-F9D4-556E-B5C7-B47E61501208","أيَا رَوْضَةَ الوَضَّاحِ يا خَيرَ روْضَةٍ","لأهْلِكِ لَوْ جَادُوا عَلَيْنا بمَنْزلِ"],["1A4E452A-715D-5227-86DB-CBF924966C86","رَهِينُكِ وضَّاحٌ ذَهَبْتْ بِعَقْلهِ","فإنْ شِئتِ فاحْييهِ وإنْ شِئْتِ فاقْتُلِي"],["A95A95BB-F823-5515-AA08-9E218C5CEC6C","وَتُوقِدُ حِيْناً بِاليَلَنْجُوجِ نارَها","وَتُوقِدُ أحْياناً بِمشكٍ وَمَنْدَلِ"]]},"57C1FDDB-B315-5579-85A1-ABE45013B5E1":{"t":"إنَّ قَلْبِي مُعَلَّقٌ بِنِساءٍ","p":69,"s":"إن قلبي معلق بنساء","r":"441320","v":[["D849464D-53B1-5ED7-89E8-576DFD68334D","إنَّ قَلْبِي مُعَلَّقٌ بِنِساءٍ","واضحَاتِ الخُدودِ لَسْنَ بِهُجْنِ"],["BCE3D224-BADE-52B7-B69A-B2C19B65CBC8","مِنْ بناتِ الكَرِيمِ داذَ وفي كِنْـ","ــدةَ ينسبنَ منْ أباةِ اللعنِ"]]},"847FF041-FED7-5510-BBEB-647E71443982":{"t":"بانَ الخَلِيطُ بمَنْ عُلِّقْتَ فَانْصَدَعُوا","p":69,"s":"بان الخليط بمن علقت فانصدعوا","r":"441300","v":[["8BD3280F-B618-5DCE-82C7-821F28445A18","بانَ الخَلِيطُ بمَنْ عُلِّقْتَ فَانْصَدَعُوا","فدَمْعُ عَيْنَيكَ واهٍ واكِفٌ هَمِعُ"],["0DE860EC-5279-5AE3-8E9C-3AF04493B871","كيفَ اللقاءُ وقدْ أضحتْ ومسكنها","بطنُ المَحِلَّةَ مِنْ صَنْعاءَ أوْ ضَلَعُ"],["3284AC5F-81DA-5363-BC9E-8741812B8A66","كمْ دونها منْ فيافٍ لا أنيسَ بها","إلاَّ الظليمُ وإلاَّ الظبيُّ والسبعُ"],["89304983-2D5C-5E0A-B058-468538BC9B0A","ومَنْهَلٍ صَخِبِ الأصداءِ وارِدُه","طيرُ السماءِ تحومُ الحينُ أو تقعُ"],["FAFCE64C-CCB0-5854-BC55-A37063AC076F","لا ماؤهُ ماءُ أحساءٍ تقرظهُ","أيدي السُّقَاةِ ولا صادٍ ولا كَرِعُ"],["B9E14C54-B072-5DD3-B028-C9045C9CE41D","إلاّ تَرَسُّخُ عِلْبا دُونَهُ رَهَبٌ","مِن عِرْمِضٍ فأباءٍ فَهيَ مُنْتَقَعُ"],["48A75A44-D49A-5563-8117-45A85F62EC09","تقولُ عاذلتي مهلاً فقلتُ لها","عني إليكِ فهلْ تدرينَ منْ أدعُ"],["7C967598-A0FD-5431-B0BC-F99BE96E88D7","وكيفَ أترُكُ شَخْصاً في رَواجِبهِ","وفي الأناملِ منْ حنائهِ لمعُ"],["A8F0C626-F844-5E49-83BA-25842B02ACD0","وأنتِ لو كنتِ بي جدُّ الخبيرةِ لمْ","يطمعكِ في طمعٍ من شيمتي طمعُ"],["F7B68F46-0A70-5C94-8384-4F69150E7B2B","إني ليعوزني جدي فأتركهُ","عَمْداً وأُخدَعُ أَحْيَاناً فأنْخَدِعُ"],["6D03B8C4-5EA1-5789-BB4E-67FA65B02FE3","وأكْتُمُ السِرَّ في صَدْرِي وأخْزِنهُ","حتى يكون لذاك القول مطلعُ"],["5A9A211B-E83B-5537-A7EE-0D221DD1F630","وأتْرُكُ القولَ إلاّ في مُراجَعَةٍ","حتّى يَكُونَ لَهُ مُلْحُ وَمُسْتَمِعُ"],["CC2D476E-3C25-51F4-A4D8-4BFD025F3F4B","لاَ قُوَّتِي قُوَّةُ الرَّاعِي رَكائِبَهُ","يأوي فيأوي إليهِ الكلبُ والربعُ"],["D06A08D8-CFAC-55CD-87F8-436BC6901B26","ولا العسيفِ الذي يشتدُّ عقبتهُ","حتى يبيتُ وباقي نعلهِ قطعُ"],["99DB56ED-83F7-5CCD-9C25-D9300280EEE5","لا يَحمِلُ العَبْدُ مِنّا فَوْقَ طاقَتهِ","ونَحنُ نحْمِلُ ما لا تحمل القَلَعُ"],["D9FCCA0E-419A-5729-ABFE-8022FDAA1BDF","منا الأناةُ وبعضُ القومِ يحسبنا","إنّا بِطاءٌ وفي إبطائِنَا سَرَعُ"]]},"8EB41B3A-C08E-5F5C-9D40-FED3D1783611":{"t":"بنتُ الخليفةِ والخليفةُ جدها","p":69,"s":"بنت الخليفة والخليفة جدها","r":"441314","v":[["CF1EE46C-1A98-5E52-A4DC-30790A3A1176","بنتُ الخليفةِ والخليفةُ جدها","أختُ الخليفةِ والخليفةُ بعلها"],["54E95B71-E39B-513F-B37E-B1ED34CA952A","فَرِحَتْ قَوابِلُها بِها وتباشَرتْ","وكذَاكَ كانوا في المسرَّةِ أهْلُها"]]},"CC770D40-2800-5CDE-B95E-F306799D640A":{"t":"تذكَّرَت المنازِلَ","p":69,"s":"تذكرت المنازل","r":"441289","v":[["BBD5E5ED-2DDD-589B-A814-873CDD3F220E","تذكَّرَتِ المنازلَ مِنْ شَعُوب","وحيّاً أصبحوا قُطِعُوا شُعوبَا"],["F2250BC5-CBB3-5E5C-9EF3-9167AE05A7E4","سبَوا قلبي فحَلَّ بحيث حلُّوا","ويعظمٌ إنْ دعوا ألاَّ يجيبا"],["9C1A944C-D169-55CB-AE7E-3D4CD8E44DC9","ألا ليتَ الرياحَ لنا رسولٌ","إليكمْ إنْ شمالاً أو جنوبا"],["EAC01D28-DC56-5CBE-9F32-A13B12CD3B09","فتأتيكمْ بما قلنا سريعاً","ويبلغنا الذي قلتمْ قريبا"],["AA479F8A-1D4C-54D1-9DC6-C7EBE71C6BCF","ألا ياروضُ قدْ عذبتِ قلبي","فأصبحَ منْ تذكركمْ كئيبا"],["813BBABB-5349-5E6B-AE66-952C84E0358E","ورَقَّقَني هواكِ وكُنتُ جلداً","وأبدي في مفارقيَ المشيبا"],["4ACFD7F6-27CF-5BE3-8469-E434E4AC2072","أما ينسيكَ روضةَ شحطُ دارٍ","ولا قربٌ إذا كانتْ قريبا"]]},"EB849C3B-D5C9-526B-980D-9667DAE4BE27":{"t":"تَرَجَّلَ وَضَّاحٌ وأسْبَلَ بَعْدَما تَرَجَّلَ وَضَّاحٌ وأسْبَلَ بَعْدَما","p":69,"s":"ترجل وضاح وأسبل بعدما ترجل وضاح وأسبل بعدما","r":"441317","v":[["5FF2DD38-91ED-51D6-8AA6-FED1A9ECFA7C","تَرَجَّلَ وَضَّاحٌ وأسْبَلَ بَعْدَما تَرَجَّلَ وَضَّاحٌ وأسْبَلَ بَعْدَما","تكهَّلَ حيناً في الكهولِ وما احتلمْ"],["A54AC8BC-FDBE-5FB1-8151-8BE4A9B6B766","وعُلِّقَ بَيْضاءَ العَوارِضِ طَفْلَةً","مُخَضَّبةَ الأطْرافِ طَيِّبةَ النَّسَمْ"],["3A784DC4-55D1-50EA-AF1F-F7B46C8B8D21","إذا قُلْتُ يوماً نَوّلِيني تَبَسَّمَتْ","و قالتْ معاذَ اللهِ منْ فعلِ ما حرمْ"],["2DA38541-FC89-5C82-A41C-FDC14C58FF71","فما نوَّلتْ حتى تضرعتُ عندها","وأعْلَمْتُها ما رَخَّصَ اللَّهُ في اللَّمَمْ"]]},"B82FBD62-2514-5BD8-9796-8AA75FBF04BB":{"t":"حتَّامَ نكْتُم حُزنَنا حَتَّاما","p":69,"s":"حتام نكتم حزننا حتاما","r":"441315","v":[["F1BDA50F-DD70-5A58-8106-A54DFF29ABF4","حتَّامَ نكْتُم حُزنَنا حَتَّاما","وعَلامَ نَسْتَبْقِي الدُّموعَ عَلاما"],["244C4504-3AB4-5139-8136-C3F6E083F777","إنَّ الذي بي قد تفاقمَ واعتلى","ونما وزادَ وأورثَ الأسقاما"],["586E59C0-0D1A-562F-A74B-8D96F70971E2","قدْ أصبحتْ أمُّ البنينَ مريضةً","نَخْشى ونُشْفِقُ أنْ يَكونَ حِماما"],["3C692A59-0A4C-572A-A2B2-1D43E18AE8EA","يا ربَّ متعني بطولِ بقائها","واجبرْ بها الأرمالَ والأيتاما"],["193690C2-D689-5260-A4A3-A94C05834694","واجبرْ بها الرجلَ الغريبَ بأرضها","قدْ فارقَ الأحوالَ والأعماما"],["2C69750D-4D20-598D-A507-CED6FE6A88CF","كَمْ راغِبينَ ورَاهِبينَ وَبُؤَّسٍ","عُصِمُوا بِقُرْبِ جَنابِها إعْصاما"],["6553A855-64C2-5D0E-AD9C-AD8222C70779","بجنابِ ظاهرةِ الثنا محمودةٍ","لاَ يستطاعُ كلامها إعظاما"]]},"AC1EAAEB-18A0-554F-A367-293EE3A903F2":{"t":"حيَّ التي أفصى فؤادك حلتِ","p":69,"s":"حي التي أفصى فؤادك حلت","r":"441291","v":[["244F1AE0-3F8D-559A-82BA-978A61876660","حيَّ التي أفصى فؤادك حلتِ","عَلِمَتْ بأَنَّكَ عَاشِقٌ فَأَدلَّتِ"],["31D994F2-F7D4-5A7B-8721-AE0AE4A41C35","وَإِذَا رأتك تَقَلْقَلَتْ أَحْشَاؤُها","شَوْقاً إِلَيْكَ فَأَكْثَرَتْ وَأَقَلَّتِ"],["8A8E1C29-2C2A-54C7-ADCE-75AC927905F7","وإذا دخلتَ فأغلقتْ أبوابها","غرمَ الغيورُ حجابها فاعتلتِ"],["C8FA536F-38C3-5E13-A2CC-558BB486E592","وإذا خرجتَ بكتْ عليكَ صبابةً","حَتَّى تَبُلَّ دُموعُها مَا بَلَّتِ"],["2B206ECD-9479-5A27-8088-CC0A15DD8DA9","إنْ كنتَ يا وضاحُ زرتَ فمرحباً","رحبتْ عليكَ بلادنا وأظلتِ"]]},"BBB5A1C4-8262-5025-89BF-0E5064015F3D":{"t":"دَعاكَ مِنْ شَوْقِكَ الدَّواعِي","p":69,"s":"دعاك من شوقك الدواعي","r":"441299","v":[["0D4305A3-73A2-575A-96FF-46B2B9FB805F","دَعاكَ مِنْ شَوْقِكَ الدَّواعِي","وأنتَ وضاحُ ذو اتباعِ"],["E8F50DA7-BF60-505C-94D2-8C18D1D73FD3","دعتكَ ميالةٌ لعوبٌ","أسِيلَةُ الخَدِّ باللِّماعِ"],["1548E330-5B99-5F2C-966D-764574F194C4","دلالكِ الحلو والمشهى","وليْسَ سَرِّيكِ بالمُضّاعِ"],["EB459C18-2C03-5E7F-B958-CE8E69198321","لا أمنعُ النفسَ عن هواها","وكلُّ شيءٍ إلى انقطاعِ"]]},"A844F0F7-1C76-5084-9E73-1FCE9B35AA63":{"t":"صدعَ البينُ والتَّفرّقُ قلبي","p":69,"s":"صدع البين والتفرق قلبي","r":"441290","v":[["3BE4A071-8025-52A0-8D2C-88395378ED07","صدعَ البينُ والتَّفرّقُ قلبي","وتولَّتْ أُمُّ البَنينِ بِلُبّي"],["0A172DC5-D1E3-5604-A1F2-F6C57E3D4543","ثوتِ النفسُ في الحمولِ لديها","وتولَّى بالجِسْمِ منّي صَحْبي"],["0805EE7E-BF29-5E07-AE66-B565568B5C92","ولقدْ قلتُ والمدامعُ تجري","بدموعٍ كأنها فيضُ غربِ"],["7522C0F5-30D6-5E87-B326-214F640DAD1A","جزعاً للفراقِ يومَ تولتْ:","حسبيَ الله ذو المعارجِ حسبي"]]},"59A9B825-6F0C-5108-833B-AF54C2362C0B":{"t":"صَبا قَلبي ومالَ إليْكَ مَيْلا","p":69,"s":"صبا قلبي ومال إليك ميلا","r":"441312","v":[["913960C2-6DCD-5D9F-B69F-0A75733DC78C","صَبا قَلبي ومالَ إليْكَ مَيْلا","وأرَّقَني خَيالُكَ يا أُثَيْلا"],["23B8A095-88A1-5A4C-9EA0-694409041702","يمانِيةٌ تُلِمُّ بِنا فتُبْدِي","دَقيقَ مَحاسِنٍ وتُكِنُّ غَيلا"],["FF750721-EDDA-59BB-B3C2-668D89896701","دَعِينا ما أمَمْتِ بَناتِ نَعْشٍ","من الطيفِ الذي ينتابُ ليلا"],["5EA65829-7C56-5DA3-A140-BFF3C9E3EE6C","ولكنْ إنْ أردتِ فصبحينا","إذا أمَّتْ رَكائِبُنا سُهَيْلا"],["D1772C4A-0962-5EF0-9E1B-2784F690796C","فإنَّكَ لوْ رأيتِ الخيلَ تَعْدُو","سراعاً يتخذنَ النقعَ ذيلا"],["CF7489B9-EE0F-5402-A5DC-B1EA9FED0C12","إذاً لرأيتِ فوقَ الخيلِ أسداً","تُفِيدُ مَغانِماً وتُفِيتُ نَيْلا"],["5DA2BA10-5030-5F01-8CE9-A50CF2D0785C","إذا سارَ الوليدُ بنا وسرنا","إلى خَيلٍ نَلُفُّ بهِنَّ خَيْلا"],["76CB9F85-B41A-5EEC-B8E2-B5E4BB65F889","وندخلُ بالسرورِ ديارَ قومٍ","ونعقبُ آخرينَ أذىً وويلا"]]},"1D38DFAA-4BB5-552C-B1B9-C6024DC84F26":{"t":"ضحكَ الناسُ وقالوا","p":69,"s":"ضحك الناس وقالوا","r":"441319","v":[["9F42246F-B94D-5636-9251-379E98792CD8","ضحكَ الناسُ وقالوا","شعرُ وضاحِ اليماني"],["8D8D2534-B508-5268-A932-C71643398812","إنَّما شِعْريَ قَنْدٌ","خُلِطَتْ بِالْجُلْجُلانِ"]]},"B6B80972-8F92-5BB9-83BC-72E40DCA07F8":{"t":"طربَ الفؤاد لطيفِ روضةَ غاشي","p":69,"s":"طرب الفؤاد لطيف روضة غاشي","r":"441298","v":[["62FCC0B3-AAB8-5525-A427-4056F013106C","طربَ الفؤاد لطيفِ روضةَ غاشي","والقومُ بين أباطحٍ وعشاشِ"],["27E4DF79-61F5-56C2-B164-188026FDFD46","أنَّى اهتديتِ ودونَ أرضكِ سبسبٌ","قَفْرٌ وحَزْنٌ في دُجىً ورِشاشِ"],["82787FB6-25AD-50CE-997C-CA823D774F73","قالتْ: تكاليفُ المحبِّ كلفتها","إنَّ المحِبَّ إذا أُخيفَ لَماشِي"],["4161E480-77E1-5A07-AA2E-A7B7C019BACE","أدعوكِ روضةَ رحبٍ واسمكِ غيرهُ","شفقاً وأخشى أن يشي بكِ واشي"],["7ED72086-C28F-5A0C-B10A-3425B1DC757C","قَالَتْ: فَزُرْنا قلتُ كيفَ أزُورُكم","وأنا امرُؤٌ لِخُروجِ سِرِّكِ خاشِي"],["F04C96FD-5083-5FB6-B146-6ECC5F99FFFE","قَالَتْ: فكُنْ لِعُمومَتي سَلْماً مَعاً","والطفْ لإخوتيَ الذين تماشي"],["D5E550AB-DF07-5CF4-A687-3CB38693D7C9","فَتَزورَنا معهُم زيارةَ آمنٍ","والسرُّ يا وَضَّاحُ لَيس بفَاشِي"],["6A407054-20C0-54F3-B01A-56B519098320","ولقيتها تمشي بأبطحَ مرةً","بِخلاخِلٍ وبِحُلَّةٍ أكْباشِ"],["B1CDD11A-C85E-5C75-BFA0-813C2F05D226","فَظَلِلْتُ مَعْمُوداً وبِتُّ مُسَهَّداً","ودموعُ عيني في الرداءِ غواشي"],["45F8B84C-FE28-5190-9EFB-47C264E3A63F","يا رَوْضُ حُبُّكِ سَلَّ جِشمي وانْتَحى","فِي العَظْمِ حتى قدْ بَلَغْتِ مُشاشِي"]]},"EF39B2F1-1B8A-52B7-A62E-45C91107F245":{"t":"طرقَ الخيالُ فمرحباً ألفاً","p":69,"s":"طرق الخيال فمرحبا ألفا","r":"441302","v":[["B2A2C336-34A7-5A09-81CF-D130F1A2B829","طرقَ الخيالُ فمرحباً ألفاً","بالشاغفاتِ قلوبنا شغفا"],["A3310C6B-6A43-507B-8981-2596A35A6D67","ولقَدْ يقُولُ لِيَ الطَبِيبُ وما","نبّأتُهُ مِنْ شأنِنَا حَرْفا:"],["47E625C3-834E-576C-ADFC-3E450CF74C34","إنِّي لأحسَبُ أنَّ داءَكَ ذا","منْ ذي دمالجَ يخضبُ الكفَّـا"],["70B62E51-9C0D-56AD-A533-14B7AF41845E","إنِّي أنّا الوضَّاحُ إنْ تَصِلي","أحسنْ بكِ التشبيبَ والوصفا"],["1AD22480-2731-5840-8F87-1BD5AEBAE8C2","شطت فشفَّ القلبَ ذكركها","ودَنَتْ فَما بَذَلَتْ لنا عُرْفا"]]},"DC5DD110-09FF-5823-9013-AB3744706135":{"t":"طرقَ الخيالُ فمرحباً سهلا","p":69,"s":"طرق الخيال فمرحبا سهلا","r":"441311","v":[["EFCB6898-0564-5513-BFB2-5A1B708DE63F","طرقَ الخيالُ فمرحباً سهلا","بخيالِ منْ أهدى لنا الوصلا"],["86EA124B-2563-56A6-8735-D1F31C4DD58A","وسرى إليَّ ودونَ منزلهِ","خمسٌ دوائمُ تُعمِلُ الإبلا"],["791B8B64-F59E-59F7-8B95-B006BBC5FD27","يا حبذا منْ زار معتسفاً","حزنَ البلادِ إليَّ والسهلا"],["AE51C83A-6D11-50AF-9492-4B0A288A1C80","حتى ألمَّ بنا فبتُّ بهِ","أغنى الخلائقَ كلهمْ شملا"],["227892F5-A0F6-5229-B4AD-9202AB51DFD0","يا حبَّذا هِي حَسْبَ قدْكْ بها","واللَّهِ ما أبْقَيْتَ لِيْ عَقْلا"],["E2BB85BE-48A3-5729-86F8-4B6EE5DCFAA3","واللَّهِ ما لي عَنْكِ مُنصَرَفٌ","إلاَّ إليكِ فأجملي الفعلا"]]},"A276B542-19B4-53BE-A7EE-0307706608BA":{"t":"كلُّ كربٍ أنتَ لاقٍ","p":69,"s":"كل كرب أنت لاق","r":"441292","v":[["B2849886-F3AB-52E2-86C7-C2D0436B343A","كلُّ كربٍ أنتَ لاقٍ","بعدَ بلواهُ انفراجاً"]]},"CD8A2D97-0217-5F7B-8760-4D2997CFC287":{"t":"ما بالُ عيْنِكَ لا تَنامُ كأنَّما","p":69,"s":"ما بال عينك لا تنام كأنما","r":"441313","v":[["D9EE4C56-9E64-5388-90E5-DA8A8B982684","ما بالُ عيْنِكَ لا تَنامُ كأنَّما","طلبَ الطبيبُ بها قذىً فأضلهُ"],["E0468F51-DB38-5887-B0C8-C2BB4A8DFEDB","بلْ ما لقلبكَ لا يزالُ كأنهُ","نَشْوانُ أنْهَلَهُ النَّدِيمُ وعَلَّهُ"],["5D7A0293-5ED5-596C-A3B8-5E900FEF3C9D","ما كُنْتُ أحْسِبُ أنْ أبيتَ ببلْدَةٍ","وأخي بأخرى لا أحلُّ محلهُ"],["9ED49AB6-66E8-5D43-92B1-22C8DFCF09A9","كنا لعمركَ ناعمينِ بغبطةٍ","معْ مانُحبُّ مَبِيتَهُ ومَظَلَّهُ"],["C9902C82-BB6B-5502-A383-2CB871EE6E81","فأرى الذي كنا وكانَ بغرةٍ","نلهو بغرتهِ ونهوى دلهُ"],["D54B76F2-F92D-5CF9-9933-57B87CB79F90","كالطيفِ وافقَ ذا هوىً فلها بهِ","حتَّى إذا ذَهَبَ الرُّقادُ أضَلَّهُ"],["A0F1DA50-B589-54C6-831F-A2DC919D0236","قُلْ لِلَّذِي شَعَفَ البَلاءُ فُؤادَهُ","لا تهلكنَّ أخاً فربَّ أخٍ لهُ"],["C81325EA-F33B-59A8-96D9-756C290AB7D3","والقَ ابنَ مروانَ الذي قدْ هزهُ","عِرْقُ المكارِمِ والنَّدى فأقَلَّهُ"],["9CEA2E8F-D2C0-5AF6-8DF2-298B45D3F672","وَاشْكُ الَّذِي لاقَيْتَهُ مِن دونهِ","وانشرْ إليهِ داءَ قلبكَ كلَّهُ"],["3B6FD91F-8EFF-5B0D-9D75-4EAA63B97C23","فعَلى ابنِ مَرْوانَ السَّلامُ مِنِ امرىءٍ","أمسى يذوقُ منَ الرقادِ أقلهُ"],["63C40203-0C7A-5614-BBFA-6B6AA9AC7F30","شَوْقاً إليْكَ فَما تنالُكَ حالُهُ","وإذا يَحِلُّ البابَ لمْ يُؤذَنْ لهُ"],["65F21BAB-FF51-5442-9E11-85A579827345","فإليكَ أعلمتُ المطايا ضمراً","وقَطَعْتُ أرْواحَ الشِتاءِ وظلَّهُ"],["8BED47F4-E8ED-5C58-91F1-A1376339C5D4","وليالياً لوْ أنَّ حاضرَ بثها","طَرفَ القَضيبِ أصابَهُ لأشَلَّهُ"]]},"5685F1AB-D4A2-5380-98F5-47139C1E0407":{"t":"ما لَكَ وَضَّاحُ دائمَ الغَزَلِ","p":69,"s":"ما لك وضاح دائم الغزل","r":"441308","v":[["9F3BDB31-829C-5665-8883-A9648EA73FAB","ما لَكَ وَضَّاحُ دائمَ الغَزَلِ","ألستَ تخشى تقاربَ الأجلِ"],["6E9CCBEA-1C22-5C56-BD44-995058037D24","صَلِّ لِذِي العَرْشِ واتَّخِذْ قَدَماً","تُنْجيكَ يَوْمَ العِثارُ والزَّلَلِ"],["AF8ED315-C9B0-5B1F-9C22-0FDE9353A9D7","يا موتُ ما إنْ تزالُ معترضاً","لآملٍ دونَ منتهى الأملِ"],["BF20417D-AA6E-5121-A502-ADF8FE325727","لَوْ كانَ مَنْ فَرَّ مِنْكَ مُنْفَلِتاً","إذاً لأسْرَعتُ رِحْلَةَ الجَمَلِ"],["B09BA47C-0170-5EA8-927B-78402E5AE577","لَكنَّ كفَّيْكَ نالَ طولُهُما","ما كلَّ عنهُ نجائبُ الإبلِ"],["C8781189-D358-5D3B-86F9-9A46E7C11434","تنالُ كفاكَ كلَّ مشهلةٍ","وحوتَ بحرٍ ومعقلِ الوعلِ"],["8B745205-A7E8-5F9D-B804-EDF07EE2CB04","لولا حذاري من الحتوفِ فقدْ","أصبحتُ من خوفها على وجلِ"],["B9F6D8BD-4CC7-5D30-8A37-141206549CA4","لكنتُ للقلبِ في الهوى تبعاً","إنَّ هَواه رَبائِبُ الحَجلِ"],["B8009583-8EA8-551F-8F2F-31964DDD8D18","حرميهِ تسكنُ الحجازُ لها","شيخٌ غيورٌ يعتلُّ بالعللِ"],["F8D5BA3A-4684-53AB-B4A1-D31F4CDD259A","عُلِّقَ قَلْبِي رَبيبَ بَيْتِ مُلو","كٍ ذاتَ قرطينِ وعثةُ الكفلِ"],["CA795271-69DD-5EF3-AE2C-02631CC893FD","تفترُّ عنْ منطقٍ تضنُّ بهِ","يجري رضاباً كذائبِ العسلِ"]]},"13B5D022-2BC3-56B0-8DFE-785C215BE5F2":{"t":"يا أيها القلب بعضَ ما تجدُ","p":69,"s":"يا أيها القلب بعض ما تجد","r":"441295","v":[["B496EF2F-6BC7-5BE7-87FC-8FCBCD5F190C","يا أيها القلب بعضَ ما تجدُ","قدْ يعشقُ المرءُ ثم يتئدُ"],["C9FA91D5-F1C7-52BA-BAC2-3BF63886D94A","قدْ يكتمُ المرءُ حُبَّه حِقَباً","وهوَ عميدٌ وقلبهُ كمدُ"],["22974FD2-7332-59E1-B779-B374B872A221","ماذا تريدين منْ فتىً غزلٍ","قدْ شَفَّهُ السُّقْمُ فِيكِ والسَّهَدُ"],["36DB65A0-8785-554B-AA02-C769764DE899","يهددوني كيما أخافهمُ","هَيْهاتَ أنَّى يُهَدَّدُ الأسدُ"]]},"751EDD46-F939-5B2F-A4F3-46A3114512CC":{"t":"يا خَليليّ قدْ صفا كدر العيـ","p":69,"s":"يا خليلي قد صفا كدر العيـ","r":"441301","v":[["FA39ABF7-AE6D-5492-B70E-A9C85450DCC6","يا خَليليّ قدْ صفا كدر العيـ","ـش وقد أسعد الزمان الخريفُ"],["44B25465-9D2D-5929-AF57-BF7FA5CC437C","إنّ طرفي ممازح ولساني","وضميري عن الفسوق عفيفُ"],["06C7973E-F833-560B-93A5-8357FD4438F5","لو سلا القلب كنت من أسعد النا","س ولكنه المشوم ألوفُ"],["1EA7C870-BAA7-512E-B5C5-C30D57E52C75","طرقتنا بعَسْقَلان ألوف","مرحباً بالخيال حين يطيفُ"],["DD260708-6E1C-54A0-8522-779F06A0D03D","يعلم الله أنَّ قلبي ضعيف","وفؤادي مع ضعف قلبي نحيفُ"]]},"6174B9E9-16D0-533D-829E-48042888C85C":{"t":"يا رَوضَةَ الوضَّاحِ قَدْ","p":69,"s":"يا روضة الوضاح قد","r":"441322","v":[["EBF7BFBB-D76E-5391-A48C-5F992D3BB50F","يا رَوضَةَ الوضَّاحِ قَدْ","عَنَّيْتِ وَضَّاحَ اليَمَنْ"],["58730A3E-B42A-52BC-B7C2-C07D2BDF103F","فاسقي خليلكِ من شرا","بٍ لمْ يكدرهُ الدرنْ"],["74C7D931-7939-57DB-9761-183F854CCD39","الريحُ رِيحُ سَفَرْجَلٍ","والطعمُ طعمُ سلافِ دنّ"],["FC65956B-CFCC-5A65-BECE-73CE222558F3","إني تُهَيِّجُني إلَيْـ","ـكِ حَمامَتانِ على فَنَنْ"],["D85ACD3B-A858-5E81-8FEF-FD814DFA6629","الزَّوجُ يدْعو إلْفهُ","فَتَطاعَما حُبَّ السَكَنْ"],["08C51105-3177-5A23-AF33-805C3DFC8E1D","لا خَيرَ في نَثِّ الحديـ","ـثِ ولا الجَلِيسِ إذا فَطَنْ"],["A6F47C60-B65A-5B70-80D7-8ECC412934D9","فاعْصِي الوُشاةَ فإنَّما","قولُ الوشاةِ هو الغبنْ"],["8D666797-6718-51F8-8530-234E17B6360F","إنَّ الوشاةَ إذا أتَوْ","كِ تَنَصَّحُوا وَنَهَوْكِ عَنْ"],["F138DDDE-32CF-5025-8EF9-865F2B374B5E","دَسَّتْ حُبَيْبَةُ مَوْهِناً","إنِّي وعَيْشِكِ يَا سَكَنْ"],["FFC1902F-F248-5E3A-BC70-0922A57292AE","أبلغتُ عنكِ تبدلاً","وأتى بذلكَ مؤتمنْ"],["30269B75-F4BD-5AA0-B475-92D18AFE17E4","وظننتُ أنكِ قد فعلــ","ـتِ فَكِدْتُ مِنْ حَزَنٍ أُجَنْ"],["0AC83509-C4B8-5EC4-BD12-ADFE08E2E1FF","ذرفتْ دموعي ثمَّ قلـــ","ـتُ بِمَنْ يُبادِلُني بِمَنْ"],["3B903D5F-D6E6-5B6F-A28B-A0FA526650C6","أسْكُتْ فَلَسْتَ مُصَدَّقاً","مَا كانَ يَفْعَلُ ذَا أظُنْ"],["35587F04-E9D2-5672-95DD-18885B1958E4","إنِّي وَجَدِّكَ لَوْ رأيْـ","ـتُ خَلِيلَنا ذَاكَ الحَسَنْ"],["3E8D997E-D426-5A6F-9E0A-746E427975AE","يَجْفُوهُ ثُمَّ يُحِبُّنَا","واللهِ متُّ منَ الحزنْ"],["967B0C22-FB7E-5212-BC25-E6938900DE02","أخبرهُ إما جئتهُ","أنَّ الفؤادَ بهِ يُجَنْ"],["0C724226-4AB8-5AF5-BFF9-B76040F84E37","أبْغَضْتُ فيهِ أحِبَّتي","وقليتُ أهلي والوطنْ"],["18DB731D-188A-58DF-86EA-85321429A71D","أتركتني حتى إذا","علقتُ أبيضَ كالشطنْ"],["FF619C85-29C7-5A8B-B200-5E44BFD71209","أنشأتَ تطلبُ وصلنا","في الصيفِ ضيعتِ اللبنْ"],["14921FCA-0650-59D4-A53C-38E0AA139434","لَوْ قِيلَ يا وَضَّاحُ قُمْ","فاخترْ لنفسكَ أوْ تمنْ"],["6EF1A47A-42F1-58EB-B170-776292ED71C8","لَمْ أعْدُ رَوْضَةَ وَالَّذِي","ساقَ الحجيجُ لهُ البدنْ"]]},"B76107B1-645B-5952-AC77-7057D7123074":{"t":"يا رَوضُ جيرانُكُمُ الباكِرُ","p":69,"s":"يا روض جيرانكم الباكر","r":"441297","v":[["73B122A6-42BD-5973-86AD-2F8708A3A0BD","يا رَوضُ جيرانُكُمُ الباكِرُ","فالقَلْبُ لا لاهٍ ولا صابِرُ"],["7005F8BC-1B04-5EA2-9775-304363C8EB0E","قَالَتْ: ألا، لا تَلِجَنْ دَارَنا","إنَّ أبانا رجلٌ غائرُ"],["564E8649-468F-5118-971A-2774F46F08FB","قُلتُ: فإنِّي طالبٌ غِرَّةً","منهُ وَسَيْفِي صارِمٌ باتِرُ"],["D5705E7F-A574-5D79-83BC-556826A05CEC","قَالَتْ: فإنَّ القصرَ مِنْ دُونِنا","قُلْتُ: فإنّي فوقَهُ ظاهِرُ"],["32199B6E-6308-577B-8895-88D31B25574C","قَالَتْ: فَإِنَّ البَحْرَ مِنْ دُونِنَا","قُلْتُ: فَإِنِّي سابِحٌ ماهِرُ"],["A06021A8-3DE9-5CC1-B9D6-6B8682D47DE7","قَالَتْ: فَحَوْلي إخْوةٌ سبْعَةٌ","قُلْتُ: فإنِّي غالِبٌ قاهِرُ"],["1FDB8262-D16A-5351-9101-7FDCA7CE4704","قَالَتْ: فلَيثٌ رابضٌ بينَنا","قُلْتُ: فإنِّي أسَدٌ عاقِرُ"],["331BA0EF-9016-5309-A21B-6ECFC7BAFE68","قَالَتْ: فإنَّ اللَّه مِنْ فوْقِنا","قُلْتُ: فَرَبِّي راحِمٌ غافِرُ"],["2A1C4803-D4DD-58E3-8DAD-BE2CE3398773","قالتْ: لقدْ أعييتنا حجةً","فأتِ إذا ما هجعَ السامرُ"],["6F9ED312-2977-5356-851E-AFF0610344B2","فاسقطْ علينا كسقوطِ الندى","ليلَةَ لا ناهٍ ولا زاجِرُ"]]},"213F7685-3A33-52E2-809C-8888C831F984":{"t":"يا قلبُ ويحكَ لا تذهبُ بكَ الخرقُ","p":69,"s":"يا قلب ويحك لا تذهب بك الخرق","r":"441304","v":[["02A53C36-D670-5126-B779-BEDFE191B806","يا قلبُ ويحكَ لا تذهبُ بكَ الخرقُ","إنَّ الأُلى كُنتَ تهواهُمْ قَد انْطَلَقُوا"],["EEACD7AF-CABA-522D-B28D-0483E76A0395","ما بالهم لم يبالوا إذْ هجرتهمْ","وأنتَ منْ هجرهمْ قد كدتَ تحترقُ"],["49074B64-BC7D-5D69-BB51-E8E6F1B16E75","قد كنتُ أشفقُ مما قد فجعتُ به","إن كانَ يدفعُ عن ذي اللوعةِ الشَّفقُ"]]},"F16127A9-9A1C-5328-990A-143F0A8A43A0":{"t":"يا لقَوْمِي لِكِثْرَةِ العُذَّالِ","p":69,"s":"يا لقومي لكثرة العذال","r":"441309","v":[["6C96C2E8-6235-5EE4-81C3-D7D62CED20DF","يا لقَوْمِي لِكِثْرَةِ العُذَّالِ","ولطيفٍ سرى مليحِ الدلالِ"],["42D4B6AC-AF2F-5BB6-8DC2-DB7CD2269040","زائرٍ في قصور صنعاءَ يسري","كُلَّ أرْضٍ مَخُوفَةٍ وَجِبالِ"],["EE8D5491-F5E3-5381-8FFC-EC946D2E1AE0","يَقْطَعُ الحُزْنَ والمَهامِهَ والبِيـ","دَ ومنْ دونه ثمانُ ليالي"],["316FF339-4229-529A-9F0A-E2E9126B555E","عاتبٌ في المنامِ أحُبِبْ بُعُتبَا","هُ إلَيْنَا وقَوْلِهِ مِنْ مَقالِ"],["3F5EE0A8-B412-5ED3-9A0C-7D402833350C","قُلتُ أهْلاً وَمَرْحَباً عَدَدَ القَطْـ","ـرِ وسَهلاً بطيْفِ هذا الخيالِ"],["BCA061EC-05E6-5B48-978B-73273901EB85","حَبَّذا مَنْ إذا خَلوْنا نَجيًّا","قالَ: أهلي لكَ الفداءُ ومالي"],["E7AAC21A-D828-52F5-82A0-267FDE5147C8","وَهِي الهَمُّ والمُنَى وَهَوى النَفْـ","سِ إذا اعتلَّ ذو هوىً باعتلالِ"],["EFF1DC31-C721-5A6F-BBEE-FC4F594FAA4F","قِسْتُ ما كانَ قَبْلَنا مِنْ هَوى النّا","ـسِ فَما قِسْتُ حُبَّها بِمثالُ"],["914092C9-818C-5634-8685-DD0A57648F3F","لَمْ أجِدْ حُبَّها يُشاكِلُهُ الحُـ","ـبُّ وَلاَ وَجْدَنا كَوَجْدِ الرِجالِ"],["2CCEAC7B-441E-5563-9CC9-E12D6FED59BB","كُلُّ حُبٍّ إذا استَطالَ سَيَبْلَى","وهَوى روضةِ المُنى غَيرُ بَالِي"],["C8DF4474-DD0C-5014-9499-BFBF8FB6E7C1","لمْ يزده تقادمُ العهدِ إلاَّ","جِدَّةً عِندَنا وحُسْنَ احتِلالِ"],["44F2ECD1-62A3-5147-AD60-020A36E239E9","أيها العاذلونَ كيفَ عتابي","بعدما شابَ مفرقي وقذالي"],["3DA75DB6-F607-535E-A1C5-E945DFB732AB","كيفَ عذلي على التي هيَ مني","بمكانِ اليمينِ أختِ الشمالِ"],["67730975-3862-5765-AEFC-F8682387788B","والَّذِي أحْرَموا لَهُ وأحَلُّوا","بمنىً صُبحَ عاشِراتِ الليالي"],["18EC4DFA-9049-56D7-A85A-5C8AB1D5FA9C","ما ملكتُ الهوى ولا النفسَ مني","منذُ عُلِّقْتُها فَكَيْفَ احتِيالِي"],["C789F055-342A-5D6B-98FF-790ECBC62383","إنْ نأتْ كانَ نأيُها الموتَ صِرْفاً","أوْ دَنَتْ لِي فَثَّم يَبدُو خَبالي"],["38DC5591-5A5E-5A67-BA41-1B0A5719A956","يا بنةَ المالكيِّ يا بَهْجَةَ النَّفْـ","ـسِ أفي حُبِّكُمْ يَحِلُّ اقتِتالِي"],["64F3ADCB-732E-5E52-96CC-E7B2AB984315","أيُّ ذَنْبٍ عليَّ إنْ قُلْتُ إنِّي","لأُحِبُّ الحِجازِ حُبَّ الزُّلالِ"],["CAF502C7-7F2C-50EC-B841-40E3E5E07AB0","لأحِبُّ الحِجازَ مِنْ حُبِّ مَنْ فِيـ","ـهِ وأهْوى حِلالَهُ مِنْ حِلالِ"]]},"DD29A450-C7EA-5E72-8ED6-BE89445D9E6C":{"t":"يا مرحباً ألفاً وألفا","p":69,"s":"يا مرحبا ألفا وألفا","r":"441325","v":[["D85927D2-BD38-5FA0-B807-55416E1E36EA","يا مرحباً ألفاً وألفا","بالكاسراتِ إليَّ طرفا"],["1A059531-FC06-5BEB-8E0E-2A3075C34D13","رُجْحِ الروادفِ كالظِّبَا","ءِ تعرضتْ حُـوَّاً ووطفا"],["26B9B941-93AF-5E2C-B967-FF3D8101B44F","أَنْكَرْن مَرْكَبِي الحِمَا","رَ وكنَّ لا ينكرنَ طرفا"],["C5F47B32-9720-5F97-AB66-9EF43830253A","وسألنني أينَ الشبا","بُ فَقُلْتُ بَانَ وكَانَ حلْفا"],["A542F709-85F3-5D7A-9A27-1E56124EDA70","أفنى شبابي فانقضى","حلفُ النساءِ تبعنَ حلفا"],["605488E6-E629-538E-88C8-34D8EADF0B24","أَعْطَيْتُهُنَّ مَوَدَّتِي","فجزينني كذباً وخلفا"],["C109B5E3-07E7-5109-8E57-A1169B752FB8","وقَصائِدٍ مِثْلِ الرُّقَى","أَرْسَلْتُهُنَّ فكنَّ شَغْفا"],["FEC8ABDA-1C13-525C-A41E-257C94AC66C3","أَوجَعْن كُلَّ مُغَازِلٍ","وعَصَفْنَ بِالغَيْرَان عَصْفا"],["FE6B337E-35EE-5CE7-AC2F-FDF8AD4C6800","من كُلِّ لَذَّاتِ الفَتَى","قدْ نلتُ نائلةً وعُـرفا"],["0139F7A0-0F39-5E2D-A9A0-0638DF00CA86","صدتُ الأوانسَ كالدمى","وسَقَيْتُهُنَّ الخَمْرَ صِرْفَا"]]},"82613454-5656-529A-BDFD-41DB64D94E33":{"t":"يا منْ لقلبٍ لا يطيــ","p":69,"s":"يا من لقلب لا يطيــ","r":"441305","v":[["8321D185-C052-5AD5-A0FF-234362C5DD30","يا منْ لقلبٍ لا يطيــ","ـعُ الزَّاجِرينَ وَلا يُفِيقْ"],["0C2D8091-394E-5E5A-8472-927295D8FFA2","تشلو قلوبُ ذوي الهوى","وهُوَ المُكلَّفُ والمُشوقْ"],["931F9346-C51B-57D7-9AD3-6FC8954B8D03","تبلَتْ حَبابةُ قلبَهُ","بالدَّلِ والشَّكلِ الأنِيقْ"],["7520F1FC-FB28-57FC-BED0-1861086C856A","وبعينِ أحورَ يرتعي","سقطَ الكثيبِ منَ العَقِيقْ"],["8FDC9A33-29CF-50EC-8DF1-527C2E44A620","مَكحُولَةً بالسِّحْرِ تُنْـ","ـشِي نَشْوَةَ الخَمْرِ العَتيقْ"],["FAF8C61F-7F3D-5234-986D-D6FB18EDA2D2","هيفاءَ إنْ هي أقبلت","لاحتْ كطالعةِ الشروقْ"],["32C0936C-5DB8-59B9-9485-B9B61944E9EA","والرِّدْفُ مثلُ نقاً تَلـ","بدَّ فهو زحلوقٌ زلوقْ"],["DCC65D35-D343-51F8-AC66-94E9B4B9871C","في دُرَّةِ الأصْدافِ مُعْـ","تنفاً بها ردعُ الخلوقْ"],["3D9C13AA-08F5-58BD-89E3-E62BDDD3565A","داوي هوايَ وأطفئي","ما في الفِؤادِ منَ الحَرِيقْ"],["A881D0FA-8762-56DE-A265-BA252B175D88","وترفقي أملي فقدْ","كلفتني مالا أطيقْ"],["1BCA03EF-3B3E-5492-8F96-4943626EA442","في القلبِ منكِ جوى المحبــ","بِّ وراحةُ الصبِّ الشقيقْ"],["43919DCC-FCE9-5EF2-9845-C1DE8338B492","هذا يقودُ برمتي","قَوْداً إليْكِ وَذَا يَسُوقْ"],["5C1E5DD7-CAF9-509B-B8EB-837F87464DEF","يا نَفْسُ قدْ كَلَّفْتِني","تعبَ الهوى منها فذوقْ"],["82102ED2-4B8C-5DEF-AFF9-97E7456D17FB","إنْ كنتِ تائقةً لحــ","ـرِّ صبابةٍ منها فتوقْ"]]},"427A1973-D35D-5303-B996-A51EF83A0022":{"t":"يقيناً ما نخاف وإن ظننا","p":69,"s":"يقينا ما نخاف وإن ظننا","r":"441321","v":[["012CED25-90E8-5039-B637-EEC14A403D94","يقيناً ما نخاف وإن ظننا","به خيراً أراناه يَقينا"],["84C626B0-4965-58D3-87C0-470F00D48AE4","نميلُ على جوانبه كأنَّا","إذا ملنا نميل على أبينا"],["5F63D816-9727-517C-BF21-94857D3B59E2","نُقَلّبه لِنُخْبر حالَتَيهِ","فَنُخْبرُ منهما كرماً ولينا"]]}}}