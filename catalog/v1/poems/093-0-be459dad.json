{"v":1,"poems":{"917C8F6D-ABF8-55E3-A5EA-7ABC57DAA915":{"t":"أراني ولا كفرانَ للهٍ راجعاً","p":93,"s":"أراني ولا كفران لله راجعا","r":"465293","v":[["E8F6330A-F314-5A01-B585-AB44ED3E70C8","أراني ولا كفرانَ للهٍ راجعاً","بخفي حنينٍ من نوالِ ابن حاتمِ"]]},"040BF831-993F-5783-B00F-EC67F6674855":{"t":"أعثمةُ أطلقي العلقَ الرهينا","p":93,"s":"أعثمة أطلقي العلق الرهينا","r":"465297","v":[["E877CC7D-C73F-5051-A46F-67572704D2D7","أعثمةُ أطلقي العلقَ الرهينا","بعيشكِ وارحمي الصبِّ الحزينا"],["90CFC65C-6843-5624-83E3-28913B9C7BCE","ربيعةُ مغرمٌ بكِ مستهامٌ","يحنُّ إليكِ من شوقٍ حنينا"],["003C840F-7A85-5211-A559-7A50EE9D3396","تعرضَ زائراً لكِ فارحميهِ","فقد أورثتِ زائركِ الجنونا"],["6FE048A8-A667-5B5F-939E-2310E64BA2B7","رآكِ وأنتِ مقبلةٌ فلما","رأتكِ العينُ هجتَ لنا فتونا"],["5CBBFEFB-7C28-5AC3-8B57-E05D4C508036","وقمتِ تأوينِ وعهدُ عيني","بحسنكِ في الخزوز تأودينا"],["D2FFC977-F0CA-531A-B631-73E79AC48C15","فلما أنْ رآك الناسُ قالوا","تعالى اللهُ ربُّ العالمينا"],["CC443D6A-2E04-5C52-9B0C-8D6A363734E9","بدتْ منكِ الروادفُ مشرفاتٍ","روادفُ لم تدعْ للناسِ دينا"],["A61AFD27-A036-5006-B5F8-FB678B8CD339","وقد أعطاكِ ربكِ فاشكريهِ","جمالاً فوقَ وصفِ الواصفينا"],["C3D0CE55-F343-5616-9A0B-31289CFDDE07","فما الشمسُ المضيئةُ يومَ دجنٍ","بأحسنَ منكِ يومَ تبذلينا"],["A6F4584E-2AA6-5F63-8C98-FBBAAF0CE0AC","إذا أقبلتِ رعتِ الناس حسناًفلو أنَّ الملوكَ رَأَوْكِ يوماًلخرُّوا مِنْ جَمَالِكِ ساجِدينَا","وإنْ أدبرتِ قيدتِ العيوناسقط بيت ص"],["CB6B33A1-D959-5CFD-870F-A416903DF0AE","ولو أنَّ النساءَ ملكنَ أمراً","لكنتِ إذنْ أمير المؤمينا"],["F0760525-06C8-52C9-AE66-51F75A846FAC","لقد أعطيتِ أردافاً ثقالاً","وقد حملتِ ما لا تحملينا"],["279C0F3C-0821-570F-8B72-090E2B466D46","إذا رمتِ القيامَ نخالُ دعصاً","يمانعكِ القيامَ فتقعدينا"],["0CC0DE42-6896-57D2-A686-CBA992D37538","إذا صليتِ ثمّ سجدتِ قلنا","ألا يا ليتها سجدتْ سنينا"]]},"D1B8A507-A146-57FD-B027-335BC57C4DF6":{"t":"أليس الزمان كما قدْ علمتَ","p":93,"s":"أليس الزمان كما قد علمت","r":"465288","v":[["97F079EC-2F8E-522E-8777-387AAC5FD6F4","أليس الزمان كما قدْ علمتَ","فما لكَ تجزعُ من صرفهِ"],["92F4D333-D2C4-530A-83C3-845E33D105BD","وعندكَ علمٌ بهِ ثاقبٌ","وعينٌ تدلُّ على وصفهِ"],["B00F5BA1-6BF3-5FB9-B702-D581E3436A09","و أيّامهُ دولٌ والنّفوس","رهونُ الحوادثِ من حتفهِ"],["B66E969E-1D68-58C2-9B3E-EB1F8B4B15CA","فأين المعافى من النائبات","و من صاحب الدّهر لم يعفهِ"],["9F6C7A69-6D25-5758-87E4-E6D5D320C14B","ومنْ صاحبَ الدهر لاقى الذي","يخافُ على الرغمِ من أنفهِ"],["2A1D0DCA-EC2A-57C3-B705-58D1F575A373","فكنْ حازمَ الرأي واصبرْ لهُ","فللحرَّ صبرٌ على ضعفهِ"],["17491241-FDAE-5071-A26B-F7B00375C4DF","ولاتسألِ الناس ما يملكونَ","ولكنْ سلِ الله واستكفهِ"],["D6768964-8FA2-52AF-9B74-DE07CC0E6229","ولاتخضعنَّ إلى سلفةٍ","وإن كانتِ الأرضُ في كفهِ"],["D33B3BED-4304-52B4-B5D4-1A50431AE5CD","فإن اللئيمَ وإن خلته","كريماً يذودوك عن عرفهِ"],["B6E39225-91A8-51C1-986B-C7B598AEB2AE","ويرجعُ محصولُ أخلاقهِ","إلى أصلهِ وإلى صنفهِ"],["9A78D30F-94F4-5CC2-8E63-F5D983B9A33F","وكلُّ مقلًّ وذي ثروةٍ","فإنَّ المنيةَ منْ خلفهِ"]]},"C7EC047B-E801-59A9-BD48-BDAF9C9CE359":{"t":"إذا المرء لم يكسبْ معاشاً لنفسه","p":93,"s":"إذا المرء لم يكسب معاشا لنفسه","r":"465302","v":[["14A574F8-4053-56B3-96ED-6FA989842035","إذا المرء لم يكسبْ معاشاً لنفسه","شكا الفقرَ أو لاقى الصديقَ فأكثرا"],["032D5E00-AC7F-54AC-93BE-B9D104AF465C","وصار على الأذنينَ كلاًّ وأوشكتْ","صلاتُ ذوي القربى له أن تنكرا"],["AC008EC6-F09D-54A6-A46A-0DCD5575C284","فسرْ في بلاد الله والتمس الغنى","تعشْ ذا يسار أو تموتَ فتعذرا"],["2825CF81-EBC3-549B-A008-E7C8EB5EF8E7","وما طالبُ الحاجاتِ منْ حيثُ تبتغى","من الناسِ إلا منْ أجدَّ وشمرا"],["A7F7AFDB-E602-5A26-8367-27E4BFE294A5","فلا ترضَ من عيشٍ بدون ولا تنمْ","وكيف ينامُ الليلَ من كانَ معسرا"]]},"17242015-E538-509E-A25E-C7544AA550D2":{"t":"اعتادَ قلبكَ من حبيبكِ عيدهُ","p":93,"s":"اعتاد قلبك من حبيبك عيده","r":"465277","v":[["A2888CA2-FEDD-5694-94A5-84C6B898DE82","اعتادَ قلبكَ من حبيبكِ عيدهُ","شوقٌ عراكَ فأنت عنهُ تذودهُ"],["85B2E232-4C25-533E-8CB1-F17EEFDB9271","والشوقُ قد غلبَ الفؤادَ فقادهُ","والشوقُ يغلبُ ذا الهوى فيقودهُ"],["9816B470-DD2A-5EF5-92F0-85988A727FDB","في دار مرار غزالُ كنيسةٍ","عطرٌ عليه خزوزهُ وبرودهُ"],["E6497C3A-06E3-56B9-9C35-B635BED6B08C","ريمٌ أغرُّ كأنه من حسنهِ","صنمٌ يحجُّ ببيعةٍ معبودهُ"],["5130F527-CD99-5766-AC1B-38D355CA029D","عيناهُ عينا جؤذرٍ بصريمةٍ","وله من الظبي المرببِ جيدهُ"],["9C8ABB26-02E1-5235-A9E3-6515C6E24C59","ما ضرَّ عثمةَ أن تلمَّ بعاشقٍ","دنفِ الفؤادِ متيمٍ فتعودهُ"],["43780515-600C-5D85-BEBE-518753A8E82F","وتلدهُ من ريقها فلربما","نفع السقيمِ من السقامٍ لدودهُ"]]},"16CDA33C-0AFE-5F36-A6D3-1B47456A09FF":{"t":"بكى أهل مصرٍ بالدمع السواجم","p":93,"s":"بكى أهل مصر بالدمع السواجم","r":"465294","v":[["6C677A28-36E7-569A-B74B-7B4DDC674B6A","بكى أهل مصرٍ بالدمع السواجم","غداة غدا منها الأغر ابنُ حاتمِ"],["D878F70A-EFF9-5C61-BF74-F25DCCBA14AB","حلفتُ يميناً غيرَ ذي مثنويةٍ","يمينَ امرىء آلى بها غيرِ آثمِ"],["BC6DEB23-4346-5AAD-B8C4-BDFC40137F5D","لشتانَ ما بين اليزيدينِ في الندى","يزيدِ سليمٍ والأغر ابنِ حاتمِ"],["46DB5D2D-9176-57AC-A9A0-094A8706193E","يزيدُسليم سالمَ المالَ والفتى","أخو الأزد للأموالِ غيرُ مسالمِ"],["24F639F0-3C48-51B7-9378-F06C36C0DA28","فهم الفتى الأزديّ إتلافُ مالهفلا يَحْسَبِ التّمتامُ أنّي هجوتُهُولكنّني فَضَّلْتُ أهلَ المكارمِ","وهم الفتى القيسي جمع الدراهمسقط بيت ص"],["D5D972EC-A0DE-5219-9CD2-0606DB88FEE6","فيا أيها الساعي الذي ليس مدركاً","بمسعاتهِ سعيَ البحورِ الخضارمِ"],["981E6605-0D32-5D16-8FA0-BFDF287A932F","سعيتَ ولم تدركْ نوالَ ابنِ حاتمٍ","لفكَّ أسيرٍ واحتمالِ العظائمِ"],["6409F33F-2F97-5557-96D5-EBE2E0052FFC","كفاكَ بناءَ المكرماتِ ابنُ حاتمٍ","وتمتَ وما الأزدي عنها بنائمِ"],["2CEB04AF-35CC-5136-9F6E-F21ADD64E3AF","فيا ابنَأسيدٍ لا تسامِ ابنَ حاتمٍ","فتقرعَ إنْ ساميتهُ سنَّ نادمِ"],["470AF4D2-B92E-567F-B9C4-CF60D2F59F3F","هو البحرُ إن كلفتَ نفسكَ خوضهُ","تهالكتَ في آذيهِ المتلاطمِ"],["919D74A2-AA19-52EF-AD53-1D5FDE56AB5A","تمنيتَ مجداً في سليمٍ سفاهةً","أمانيَّ خالٍ أو أماني حالمِ"],["CC82E1B7-F0E8-54FC-91E4-FB452DEE2BBC","ألأ إنما آل المهلبِ غرةٌ","وفي الحربِ قاداتٌ لكمْ بالخزائمِ"],["18A3B274-4FD4-5436-9745-21D9B9F3C0DD","همُ الأنفُ في الخرطومِ والناسُ بعدهمْ","مناسمُ والخرطومُ فوقَ المناسمِ"],["634C2DFC-039D-5526-BFD8-8780C399A4FA","قضيتُ لكمْ آل المهلبِ بالعلاَ","وتفضليكمْ حقٌ على كلَّ حالمِ"],["E204EDB9-F389-559B-82AA-429CC495047D","لكمْ شيمٌ ليستْ لخلقٍ سواكمُ","سماحٌ وصدقُ البأسِ عند الملاحمِ"],["D98CF0E9-F8EA-5422-B91D-E7C900FF6A33","مهينونَ للأموالِ فيما ينوبكمْ","مناعيشُ دفاعونَ عن كلَّ جارمِ"],["B119D9D4-6492-5B15-9CA2-93DEE731E80B","أبا خالدٍ أنت المنوه باسمهِ","إذا نزلتْ بالناس إحدى العظائم"],["D9A4FC3D-C30C-5267-B18E-ADAF84C05BDC","كفيتَ بني العباس كل عظيمةٍ","وكنت عن الإسلام خير مزاحم"]]},"AEE79CBC-05D5-5D22-B314-A7ECEF71A834":{"t":"ترى الرجل النحيف فتزدريه","p":93,"s":"ترى الرجل النحيف فتزدريه","r":"465301","v":[["48E2150E-A29E-5B77-A991-0C576E6CF226","ترى الرجل النحيف فتزدريه","وفي أثوابه أسد مزيرُ"],["E0589B0D-C904-5763-A774-49314BE20275","فما عظم الرجال لهم بفخر","ولكن فخرهمْ كرمٌ وخيرُ"]]},"946D1486-5541-521A-8F72-769848E3A3E9":{"t":"ثفوا ثفوا باسم إلهي الذي","p":93,"s":"ثفوا ثفوا باسم إلهي الذي","r":"465287","v":[["8DEEB74E-A9E2-5794-B2C3-0AF15AF8B715","ثفوا ثفوا باسم إلهي الذي","لا يعرضُ السقمُ لمن قد شفىَ"],["856C5A83-6E1E-5975-9608-728E52B36FDD","أعيذُ مولاتي ومولاتها","وابنتهل بعوذةِ المصطفى"],["EB33D666-E30C-5E6E-BEA6-F62E49BE8AA8","من شرَّ ما يعرضُ من علةٍ","في الصبح والليلِ إذا أسدفاَ"]]},"EE8DBE57-01B2-52E7-9961-DB07204E6FB6":{"t":"ثنى شوقه والمرءُ يصحو ويسكرُ","p":93,"s":"ثنى شوقه والمرءُ يصحو ويسكرُ","r":"465283","v":[["A139F5AC-A759-5E10-8E74-B52DE6FE0CB5","ثنى شوقه والمرءُ يصحو ويسكرُ","رسومٌ كأخلاقٍ الصحائف دثرُ"],["8AFC14D5-1DA7-558E-AEDC-6BCDBDE2C435","حسبتُ بها صحبي فظلتْ عراصةُ","بدمعي وأنفاسي تراحُ وتمطرُ"]]},"CB26531C-F618-5CBD-AF79-F04196623465":{"t":"جعفي جيرانها فقد عطرتْ","p":93,"s":"جعفي جيرانها فقد عطرت","r":"465300","v":[["45C57A09-47A8-5CCF-89CD-545E6750261B","جعفي جيرانها فقد عطرتْ","جعفي من نشرها ورياها"]]},"5DE12FD9-C070-5C75-BF42-BCB15618DC35":{"t":"حبذا الرقةُ داراً وبلدْ","p":93,"s":"حبذا الرقة دارا وبلد","r":"465282","v":[["5EB34ED9-CB41-50AF-AB35-F3FB7AA757ED","حبذا الرقةُ داراً وبلدْ","بلد ساكنهُ ممن تودْ"],["677185F7-6627-568F-849A-D5819D72E675","ما رأينا بلدةً تعدلها","لا ولا أخبرنا عنها أحدْ"],["8AA7DCE9-11C4-5F21-8E48-14BF878EEDD4","إنها بريةٌ بحريةٌ","سورها بحرٌ وسورٌ في الجددْ"],["2DA57443-0B80-59EA-AEA1-0CB9411A14A9","تسمع الصلصلُ في أشجارهاَ","هدهدَ البرَّومكاءً غردْ"],["82406816-DEB6-56BD-965B-99E0B6A23802","لم تضمنْ بلدةٌ ما ضمنتْ","من جمالٍ في قريشٍ وأسدْ"]]},"45E2155E-29B5-5F6F-A4F1-0743D0D60F32":{"t":"حمامة بلّغي عنّي سلاماً","p":93,"s":"حمامة بلغي عني سلاما","r":"465291","v":[["F3D6A2CA-46E7-512D-9198-07A380C5A437","حمامة بلّغي عنّي سلاماً","حبيباً لاأطيق له كلاما"],["27244CED-0105-5F5F-8179-87134264562E","و قولي للتي غضبت علينا","علام وفيم يا سكني علاما"],["4067C936-3EEB-50AD-A878-28BFB6002F3A","أفي هجران بيتك تصرميني","و ما رمنا لصرمكم صراما"],["6661FD55-AEA7-5A0B-9AC1-A09AB873E5D3","و لم أهجرك مقليةً ولكن","حللت عراقكم وحللتشاما"],["C9BC2C61-9B06-5256-8C67-D232B5E50120","عديني أن أزورك إنّ داري","و دارك لاأرى لهما التياما"],["C27ED4DF-BB91-5B8B-9101-49805156B8D6","و إنّ جميع أهلك عنفوني","و لامونيو لم أطق الملاما"],["59853189-2216-5248-A39D-C3D95C9629D8","كرام النّاس قبلي قد أحبّوا","كرائمهم وأحببن الكراما"],["F91281CB-26B9-5E85-800E-19797CCF9E73","جميلٌو الكثّير قد أحبّا","و عروة من هوىً لاقى حماماً"],["7A2FDBBB-2883-587E-BDD1-DE7D6D12060A","هم سنوا الهوى والحبّ قبلي","و ما ألفي لهم في النّاس ذاما"],["A17E4AC3-BA8C-5937-A7CD-38F142FB9C17","فياغنّام يا بصري وسمعي","رسيس هواك أورثتي سقاما"],["932670C0-9624-5C9A-B2D2-CB4FCD4E5A78","لقدأقصدت حين رميت قلبي","بسهم الحبّإنّ له سهاما"],["D0C218DF-E9DB-571C-A50A-62B6B3836024","زجرت القلب عنك فلم يطعني","و يأبى في الهوى إلاّ اعتزاما"],["D0CEFF5A-4A34-5EC8-9405-C5AB9DFE78AE","إذا ما قلت أقصر واسل عنها","أبى من صرمكم إلاّ انهزاما"],["AF91EC65-A397-5DC6-92E2-012A397B48C7","و لولا فتنتي بكفاعلميها","إذاً صلّى ربيعة ثمّ صاما"],["CAA0F527-CAFB-5E62-808D-3BDA9C8E3916","أقام الحبّ حبّك في فؤادي","و حبّي في فؤادك قد أقاما"],["E191DD59-ADEB-5522-B7E7-1F32E335F120","كلانا وامقٌ كلفٌ معنّى","بصاحبه وما يبغي حراما"],["3A817E3C-B66F-591D-B63D-4832B7054481","أحبّ حديثها وتحبّ قربي","و ما إن نلتقي إلاّ لماما"],["775D5E27-F132-51DA-B068-1CBE0155EDDD","فيا ليتَ النهارَ يكونُ ليلاً","وليت الصبحَ لا يجلو الظلاما"],["4CEE05A8-59BD-5D20-BF9B-690A721747CE","ويا ليتَ الحمامَ مسخرات","لنرسلَ في رسائلنا الحماما"],["B5612016-35DA-5EF5-B948-5823D1444B1D","لعلّ حمامةً تهدي إلينا","كتاباً منكِ نجعلهُ إماماَ"],["44392F6C-9325-5DD0-8F04-8840EDDD3974","وتبلغك المحبة عن محبًّ","أحبكِ قبله يفعاً غلاما"],["8814B1AB-F550-59F3-94D0-E07EC12B02AE","وما ذنبي وحبك هاج هذا","ولو ترك القطا لغفا وناما"],["987E961A-E962-508E-A02F-06148F8BEEBD","ولو أبصرت غنمةَ ذاتَ يومٍ","وقدسفرتْ وأحدرتِ اللثاما"],["942B7FEF-84E5-553D-B103-ADC10C059001","ينوطُ وشاحها بقضيب بانٍ","ويكسو مرطها دعصاً ركاما"],["2258A7EB-CB88-5310-A102-033AE8A0BB3D","إذا ابتسمتْ حسبتَ الثغر منها","تألقَ بارقٍ يجلو الظلاما"],["DDB19A0A-EF32-5BA0-BE97-F5070033E33C","جلتْ ببشامةٍ برداً عذابافلم تَزِدِ البشامةُ فاكِ طيباًولكنْ أنتِ طيّبت البَشَاما","كأن عليه مسكا أو مداماسقط بيت ص"],["E4AEDA95-AC00-593B-B164-A7AAF573AC22","وما أدماءُ جؤذرها تراعي","وتدنو حين يسمعها بغاما"],["0A483DE3-CB83-56DA-9122-D7467670C21F","بأحسن منكِ يوم رحلت عناّ","وقد بلتْ مدامعك اللثاما"],["03E18BE1-691A-54A0-BEC4-68CC206147FC","وتحتكِ بغلةٌ زينتْ برحلٍ","مواشكةٌ تنازعكِ اللجاماَ"],["92C87315-BA85-5FD3-8C5E-DEA4E29DFD00","وكل الحبَّ لغوٌ غيرَ حبي","فقد أردى الحشا وبرى العظاما"]]},"667C1551-E81D-532A-BD89-5EEAEE572B4D":{"t":"خليليَّ هذا ربعُ ليلى فقيداَ","p":93,"s":"خليلي هذا ربع ليلى فقيدا","r":"465279","v":[["4D3056FD-3E7D-5878-95B1-46657FE5627A","خليليَّ هذا ربعُ ليلى فقيداَ","بعيريكما ثمّ ابكيا وتجلداَ"],["64B8D3F4-862B-501D-BDC5-88F9EA55A1E7","قفا أسعداني باركَ الله فيكما","وإن أنتما لم تفعلا ذاكَ فاقعداَ"],["6DC1BBEC-9D3F-5D43-B3D3-4E3B1410574A","وإلأّ فسيرا واتركاني وعولتي","أقلْ لجنابي دمنةِ الدارِ أسعداَ"],["67EA3503-BE81-5201-ABC5-33BBD1D401E8","فقالا وقد طال الثويُّ عليهما","لعلك أن تنسى وأن تتجلدا"],["E082D98B-7A65-567B-A140-27A098457AA1","فسرْ عنكَ قد عنيتنا وحبستناَ","على دمنِ الأطلال يوماً مطرداَ"],["565E2658-C1C1-5541-82F5-2119C1DF2E1C","يلومُ على ليلى خليلي سفاهةً","وماكنتُ أهلاً في الهوى أن أفنداَ"],["651EFA19-EDB4-5486-BB15-76D890CB458D","لعمريَ أي ليلى لئنْ شطتِ النوى","بليلى لقد صادتْ فؤادي معمداَ"],["424AA640-0D11-5E40-A0CF-359A777A4330","قتولٌ بعينيها صيودٌ بدلها","وما تقتل الفتيانَ إلا تعمداَ"],["F901B900-994B-561D-B285-33A06071DEF2","ألا حبذا ليلى وأترابها الألى","وعدنكَ من ليلى ومنهنَّ موعداَ"],["3101643A-F7D8-506C-897E-7064AA81C26B","فأقبلنَ من شتى ثلاثاً وأربعاً","وثنتينِ يمشينَ الهوينا تأودا"],["0555BBA7-E1BA-596F-A32E-8C95D3C3C6E2","يطانَ مروطَ الخزَّ يلحفها الجنى","ويسحبنَ بالأعطافِ ريطاً معمدا"],["7B714F68-D1E9-52DE-80BA-BA6C822D289C","فلما التقينا قلنَ أهلاً ومرحباً","تبوأ لنا بالأبطحِ السهلِ مقعداَ"]]},"C53DFF1B-7A09-514B-9D7E-7DAEF30B984B":{"t":"دستْ سعادُ رسولاً غير متهمٍ","p":93,"s":"دست سعاد رسولا غير متهم","r":"465292","v":[["E331B634-A8C7-5A9D-8FB0-C1C25EF0565E","دستْ سعادُ رسولاً غير متهمٍ","وصيفةً فأتتْ إتيانَ منكتمِ"],["6735D270-0EED-5295-9337-4DA557173EB1","جاء الرسول بقرطاسٍ بخاتمهِ","وفي الصحيفة سحرٌ خطَّ بالقلمِ"],["0E9890EF-340B-5C61-8108-EC4F319FE633","فيه فتونُ هوىً ظلت تغيبهُ","على الجهول وما يخفى على الفهمِ"],["E34C8110-BEB7-5BA1-8AE0-A977E1C68681","وقد فهمتُ الذي أخفتْ فقلت لها","بوحي بلا ونعم من بين الكلمِ"],["DB393E80-3EAA-5A17-9B8C-CDF0F3ECF706","قالتْ تعالَ إذا شئت مستتراً","والحكم حكمك يارقي فاحتكم"],["12F68495-862A-5321-920E-F78DAC3B92FF","أقدمْ ربيعةُ في رحبٍ وفي سعةٍ","في غير قمراءَ والظلما فاغتنم"],["DCA731D6-8948-51C8-92E4-881887666BB5","فزرتها واقعاً طرفي على قدمي","وقد تلبستُ جلبابين من ظلم"],["E7D06F08-4C97-58D9-BCDB-034860C0B8DB","فكان ما كان لم يعلمْ به أحدٌ","وما جرحتُ وما عللتُ بالحرم"],["B41A86F5-495D-5E14-9E9B-3692A42B24C1","زراتكَ سعدى وسعدى منكِ نازحةٌ","فأرقتكَ وما زارتك من أممِ"],["31E56BFD-E970-58C8-8117-7AEE12327DFE","أهلاً بطيفك ياسعدى الملم بنا","طيفٌ يسير بلا نجمٍ ولا علم"],["2C500164-B8EB-5B48-B146-AF4F5B4975CB","أنتِ الضجيعُ إذا مانمت في حلمي","والنجم أنت إذا ما العينُ لم تنمِ"],["F527A62D-11B7-5327-9436-11D55180553A","ما أكذبَ العينَ والأحلامَ قاطبةً","أصادقٌ مرةً في وصلها حلمي"],["B20F071F-5541-5A9C-87FF-16E34D4B8297","قولي نعمْ إنها إنْ قلتِ نافعةٌ","ليستُ عسى وعسى صبرٌ إلى نعم"],["0BE94EB0-42FA-5EB9-A93F-7D5A60F41C5A","أنعمتِ نعمي علينا لستُ أنكرها","حتى أغيبَ في ملحودةِ الرجمِ"],["4AB26DDD-EECC-5992-A4BE-60CD2210FC20","قلبي سقيمٌ وداءُ الحبَّ أسقمهُ","ولو أردت شفيتِ القلبَ من سقمِ"],["1D456490-A683-5A95-BDB9-C4A91C76EF24","قالتْ فؤداكَ بين البيضِ مقتسمٌ","ما حاجتي في فؤادٍ منكَ مقتسمِ"],["1E8DAE5A-B14B-5FB2-BAB6-EBE274E8FC2F","أنتَ الملول الذي استبدلتَ بي بدلاً","قصرتَ بي وشربت الؤمَ بالكرامِ"],["A5FB3A13-9C24-5C7A-B1BB-E9ECE5238BE1","قد كنتُ أقسمتُ أني من هواك فما","بري يمينيَ قد أغلطتُ في القسمِ"],["F9A5ABC9-0CB0-5F1A-9FBA-474C246C70BA","استغفرً الله قد رقَّ الفؤادُ وما","بيني وبينك يا رقيًّ من رحمِ"],["7A48DFDD-ECA5-51C9-8C8C-CEAF0C80A395","ياليتَ من لامنَا في الحبُ جربهُ","فلو يذوقُ الذي قد ذقتُ لم يلمِ"],["E50BC880-24EE-531B-92FA-8C84413F7E12","الحبُّ داءٌ عياءٌ لا دواء لهُ","إلا نسيمُ حبيبٍ طيبِ النسمِ"],["628914C5-195C-5920-9292-F7BB33374C6D","أو قبلةٌ من فمٍ نيلتْ مخالسةً","وما حرامٌ فمٌ ألصقتهُ بفمِ"],["0221B3AA-6A33-5E07-AB76-B8D3D8675ACB","هذا حرامٌ لمن قد عدهُ لمماً","ولن يعذبنا الرحمنُ باللممِ"],["B28CA19B-4A6B-5BC3-863D-1507822E4983","هامَ الفؤادُ بسعدى من ضلالتهِ","ياليتَ قلبي بكمْ يا سعدَ لم يهمِ"],["B9456E4A-1C4A-511D-9AB9-33D4C0B9CEE4","أنتِ التي أورثتْ قلبي مودتها","داءً دخيلاً وشوقاً غير منصرمِ"],["E48ED1B2-0F5A-50A1-AAC3-2C85C1DA69A6","خلقتْ من مسكةٍ والناسُ خلقهمُ","من لازبِ الطينِ من صلصالة القتمِ"],["A332B78F-578F-5687-A144-7E4F871DED4E","ماصورَ اللهُ إنساناً كصورتكمْ","من بعدِ يوسف في عربٍ ولا عجمِ"],["0D561D09-D373-5324-97A8-BA9EE72CCFB8","أعلاكِ من صعدهٍ سمرا مقومةٍ","والمرطُ فوقَ كثيبٍ منكِ مرتكمِ"],["403FBFA5-2FBB-58BC-B82A-B66D67B49C5B","وأنتِ جنةُ ريحانٍ لها أرجٌ","أو وروضةٌ نضحتْ بالويلِ والديمِ"],["65BEBCCB-59DC-5187-B78B-EC1746347F0E","أو بيضةٌ قي نقاً أو درةٌ خرجتْ","من زاخرٍ مزبدِ الأذي ملتطمِ"],["B2E94577-D85A-5677-9C7F-A31EA64BD011","لاقيتُ عند استلام الركنِ غانيةً","غراءَ واضحةَ الخدينِ كالصنمِ"],["785A2CD1-BEF2-5C0D-8B85-08E8BEEFEDE8","مرتجةُ الردفِ مهضومٌ شواكلها","تمشي الهوينى كمشي الشارب الثلمِ"],["F07CC4AA-36ED-5219-9930-0B6C60297197","تقول قيناتها والردفُ يقعدها","من خلفها قد أتيتِ الركنَ فاستلمي"],["669A380D-B91A-5BA6-9B8D-8D3DDA8CD4E4","فاستلمتْ ثم قامتْ ساعةً فدعتْ","فقمتُ أدعو ولولا تلك لم أقمِ"],["D4286FAC-3AAE-5AF4-8171-6C728ADF6D6E","حتى إذا انصرفتْ سلمتُ فالتفتتْ","فقلتُ إنكِ من همي ومن سدمي"],["C6B34277-5EEF-5EB9-8FC4-D1435E70C332","قالتْ ومن أنتَ قلنَ التابعاتُ لها","هذا ربيعةُ هذا فتنةُ الأممِ"],["568BD1E6-4E4D-5318-9E68-EE547585B68A","هذا المعنى الذي كانتْ مناسبهُ","تأتيكِ فاستتري بالبردِ والتثمي"],["302CADBC-D89C-59E6-B0A8-FF447F3E2ED3","شيطانُ أمتهِ لا قاكِ محرمةً","فبإلاله من الشيطان فاعتصمي"],["DF1650A7-BF42-5F30-A8DA-0311CD1A8754","قالتْ أعوذُ بربي منكَ واستترتْ","بغادةٍ رخصةِ الأطرافِ كالعنمِ"],["791B514B-21FE-5B22-BFEB-78EC9B1F2117","قلتُ الذمام وعهدُ اللهِ خنت بهِ","لا عهدَ للغادرِ الختارِ للذممِ"],["9FD496DE-545F-5E81-9F91-1C4AEE6A5DD5","ألم تقولي نعمْ قالتْ بلى وهماً","مني وهل يؤخذُ الإنسانُ بالوهمِ"],["1F5FEB83-B976-5DC0-B0CF-9CF05882CF33","تبنا وصمنا وصلينا لخالقنا","ولم تتبْ أنتَ من ذنبٍ ولمتصمِ"],["22550FC0-25E7-5C1F-B2C7-E8D2920F80E2","فلمتُ نفسي على بذلي لها مقتي","وبخلها وقرعتُ السنَّ من ندمِ"],["C88710C3-EABF-574E-8B8F-DB7C30D48397","فأبعدَ اللهُ إنساناً وأسحقهُ","أدامَ وداً لإنسانٍ ولمْ يدمِ"]]},"DAF2B6A6-4E5F-5FE5-A044-294DF34BAA96":{"t":"صاحِ إني غيرُ صاحي","p":93,"s":"صاح إني غير صاحي","r":"465276","v":[["553B7A47-9532-56AC-A93E-FB8EE2AC8CC5","صاحِ إني غيرُ صاحي","أبداً من حبَّ داحِ"],["F9B80EAC-79A3-56B3-9AF8-5C96629C783A","صارَ قدحاً حبُّ داحِ","في فؤادي المستباحِ"],["CD53F188-0798-5490-8355-24FE38012D29","جنحَ القلبُ إليها","إنّ قلبي ذو جناحِ"],["E70BE6E6-6B37-5C23-A37D-D335F5A0A84B","وعصى في حبَ داحِ","كلَّ لوامٍ ولا حي"],["9349539C-8E46-5590-83FD-F2C16C129828","ليتَ لي رسلاً من الجنَّ","إليها والرياحِ"],["36532338-C9B5-5C7E-9986-752E2E7F9D58","تبليغُ الحاجاتِ عني","ثم تأتي بالنجاحِ"],["3045BE76-6D28-566F-AC39-D38FEF13A308","داحُ داحُ حبَّ نصرِ","آحِ من حبكِ آح"],["B54F04D6-4F16-59EE-91A3-08DE95747FC1","أنا واللهِ قتيلٌ","لكِ من غيرِ جراحِ"],["1FACBE26-D9FF-5F83-ABD7-B6B3FB8943C0","لا بسيفٍ قتلتني","لا ولا سمرِ الرماحِ"],["9FEF8974-B02A-5831-A9A0-FB53D59DB573","أنتِ للناسِ قتولٌ","بالهوى لا باالسلاحِ"],["20916FC8-F775-57C1-9004-EE8AC6D657E8","وبشكلٍ وبدلَّ","وبغنجٍ ومزاجِ"],["4C5B9194-15F9-5CC9-9A7F-D12DFCAD0A06","وبعينينِ صيودين","ِ وثغرٍ كالأقاحي"],["0B35DCF8-0A83-5976-B3E0-40FC2C2BECE2","ليتني كنتُ حماماً","لكِ مقصوصَ الجناحِ"],["2F991DEF-A9F9-5631-AD3A-6C5EF792622C","أيها الناسُ ذروتي","لستُ من أهلِ الفلاحِ"],["9C12EB25-7F89-5A09-8E80-D277EE4E93CC","أنا إنسانٌ معنى","بهوى المرضِ الصحاحِ"],["3708349E-703C-592E-8ED6-C0641569F5C1","أنا زيرٌ للغواني","وأخو لهوٍ وراحِ"],["01389ED0-0671-5F6D-9489-663388B4B171","غير أني لستُ أغشى","أبداً بابَ السفاحِ"],["F81D9227-593F-51E0-B6BB-E072DD9099E4","إنّ ريعَ ابنِ نصيرٍ","معدنُ البيضِ الملاحِ"],["95DEC330-61CE-5439-8A64-77D542BAAA84","فيهِ داحٌ ولما في","حبَّ داحٍ من جناحِ"],["EC7A9AD5-486A-50E4-969C-79FA892CB604","وفتاةٌ غيرُ داحٍ","ذاتُ لهوٍ ومزاحِ"],["AF48C2D9-E462-5820-9925-978C12DD852C","قد تجشمتُ إليها","هولَ ليلٍ ونباحِ"],["28287089-3C70-5752-B5A1-AA728D68E00E","فخلونا بفتاةٍ","غادة غرثى الوشاحٍ"],["CECB5613-54F6-5D31-AF37-051CFAF8E04E","فلبستُ العكنَ البيضَ","من الخودِ الرداحِ"],["9F57E82A-ACBB-5CF4-9FE0-8BEBB8C965FD","ثمّ لما صاحَ ديكُ","قبل إبانِ الصباحِ"],["BC972010-3068-5A92-AB7E-9D9E74C5EDE9","قلتُ صحْ يا ديكُ ألفاً","ليس ذا وقتَ البراحِ"],["F85B3B7F-DA75-5002-96CF-405FB8018167","أو أرى الصبحَ وإن كان","لفي الصبحِ افتضاحي"]]},"EE5077E5-C531-56DD-98B5-63E88B998FC0":{"t":"عينا ربيعةَ رمداوانِ فاحتسبي","p":93,"s":"عينا ربيعة رمداوان فاحتسبي","r":"465281","v":[["198C94FE-65DF-5998-A7BF-FB2324A33553","عينا ربيعةَ رمداوانِ فاحتسبي","بكحلةٍ منك تشفيه من الرمدِ"],["9BE942E7-9636-513C-A52C-A5C8C58F99E8","إنْ تكتحلْ منك عيناه فلا رمدٌ","على ربيعةَ يخشى آخر الأبدِ"]]},"30176772-4699-5C54-9F97-5843367D5D6B":{"t":"قد بسطَ المهديُّ كفَّ الندى","p":93,"s":"قد بسط المهدي كف الندى","r":"465295","v":[["4C3229D9-9A33-5625-874C-388A21AB4C2C","قد بسطَ المهديُّ كفَّ الندى","للناسِ والعفو عن الظالمِ"],["F37FF643-9C8B-5AB4-A006-F7F8B56DDAAC","فالراحلُ الصادرُ عن بابهِ","مبشرٌ للواردِ القادمِ"]]},"2FC4B6D1-1105-50C6-A0CB-086175A73319":{"t":"لستُ أدري أعزمهُ الدهرِ أمضي","p":93,"s":"لست أدري أعزمه الدهر أمضي","r":"465296","v":[["5C1C9DFF-16DE-5D54-A4F9-5AD3CD265126","لستُ أدري أعزمهُ الدهرِ أمضي","في الأعادي أم كيدهُ أم حسامهْ"]]},"88E6272F-20FC-5561-A70E-888AEF3313DF":{"t":"لمن ضوءُ قابلتْ أعينَ الركبِ","p":93,"s":"لمن ضوء قابلت أعين الركب","r":"465274","v":[["A469A693-E61F-5010-91FE-07B6B5CF7EF7","لمن ضوءُ قابلتْ أعينَ الركبِ","تشبًّ بلدنِ العودِ والمندلِ الرطبِ"],["B8186CB5-6F44-5F5B-9926-F83F77D874C9","فقلتُ لقد آنستُ ناراُ كأنها","سنا كوكبٍ لاحتْ فحنَّ لها قلبي"]]},"13DC76E1-BE55-5E0D-90B9-0895F1325BD1":{"t":"لوقيل للعباس يا ابن محمدٍ","p":93,"s":"لوقيل للعباس يا ابن محمد","r":"465290","v":[["CA9328F6-92C4-5FB5-8E4F-2DD3C582AFC9","لوقيل للعباس يا ابن محمدٍ","قلْ لا وأنت مخلدٌ ما قالها"],["16FEF25A-6062-572F-9ED1-F9556840489B","ما إن أعدُّ من المكارم خصلةٍ","إلاّ وجدتك عمها أو خالها"],["2D9495F9-1AF9-57A5-8465-38931C3C32AD","و إذا الملوك تسايروا في بلدةٍ","كانوا كواكبها وكنت هلالها"],["12BA563D-E931-50F6-90DF-1C9C39BB57F6","إن المكارم لم تزل معقولةً","حتى حللت براحتيك عقالها"],["494FA56F-7C5B-563B-BFFE-8B147CB75D80","العود يرطب إن مسست لحاءه","و الأرض تعشب إن وطئت رمالها"]]},"7D2C0CB4-8368-57F6-BFB4-0A932B8F5CA1":{"t":"معنُ يا معنُ يا ابن زائدة الكلبِ","p":93,"s":"معن يا معن يا ابن زائدة الكلب","r":"465299","v":[["55B9FAE3-7E79-5DB4-97BA-DEFD721A266F","معنُ يا معنُ يا ابن زائدة الكلبِ","التي في الذراع لا في الفنانِ"],["C5DBA46F-38BD-534D-8D5E-A699CB967CA3","لا تفاخرْ إذا فخرتَ بآبائكَ","وافخرْ بعمك الحوفزانِ"],["96B7DF63-886C-5FCC-BB90-B5E0820A36B3","فهشامٌ من وائلٍ في مكانٍ","أنت ترضى بدون ذاك المكانِ"],["0C7DDC57-DC52-5A00-83EC-4F52EB679A9F","ومتى كنت يا ابنَ ظبيةَ ترجوهي حوراءُ كالمَهَاةِ هِجِانٌلِهِجَانٍ وأنتَ غيرُ هِجَانِ","أن تبني على ابنة الغضبانسقط بيت ص"],["C61EC1A1-5CDA-5A27-A05C-40A5370BE2BF","وبناتُ السليلِ عند بني ظبيةَ","أفٍّ لكمْ بني شيبانِ"],["EF150AF0-674D-51F2-86E0-F4823B8A80FB","قيل معنٌ لنا فلما اختبرنا","كان مرعى وليس كالسعدانِ"]]},"B55011B7-84A7-512D-9AFA-84B18F60F197":{"t":"منْ لعينٍ رأتْ مطيفاً","p":93,"s":"من لعين رأت مطيفا","r":"465286","v":[["6C25137C-D661-5152-B58A-2B9BF9551194","منْ لعينٍ رأتْ مطيفاً","وفقاً هكذا علينا وقوفاَ"],["4B9FCE55-A15C-5578-83B5-50BD43164B83","طارقاً موهناً ألم فحياَّ","ثم ولىَّ فهاجَ قلباً ضعيفاَ"],["FCD397CA-C07E-5074-AD14-2CA371C05AA8","ليتَ نفسي وليتَ أنفسَ قومي","يايزيدَ الندى تقيكَ الحتوفا"],["8A2C0661-3E4E-575D-98FF-44CB38BD5CF7","عتكيُّ مهلبيُ كريمٌ","حاتميُّ قد نالَ فرعاً منيفاَ"]]},"DB8FA961-458B-58D4-B45C-E0D14B466DBF":{"t":"هززتكَ هزةَ السيفِ المحلى","p":93,"s":"هززتك هزة السيف المحلى","r":"465275","v":[["6AE691B4-D322-5E0C-9D9C-A7781EDC4A6F","هززتكَ هزةَ السيفِ المحلى","فلما أن ضربتُ بكَ انثنيتُ"],["C7F56A9A-0324-53FB-B489-5A81A288313D","مدحتك مدحةَ الطرفِ المجلي","لتجري في الكرام كما جريتُ"],["1949D7EF-0AAF-57A2-8DE8-AF747A6FDBCE","فهبها مدحةً ذهبتْ ضياعاً","كذبتُ عليكَ فيها وافتريتُ"],["AF0AFF72-3A6B-5C74-A00E-51DE1AB06A30","فأنتَ المرءُ ليس له وفاءٌ","كأني إذ مدحتكَ قد زنيتُ"]]},"88D3ADDC-F5A9-578A-9435-C58489214CFC":{"t":"وبلائي أنّ أمي","p":93,"s":"وبلائي أن أمي","r":"465284","v":[["2DF0644A-368B-5A2E-AC01-A2B6E8579680","وبلائي أنّ أمي","أثقلتني بإزاري"],["9E30FD4E-981A-59A7-871A-F392E65F59D0","فإذا ما قمتُ أمشي","همَّ خصري بانبتارِ"],["D4D389FC-6A86-5ADD-A87B-AFC4D22A7145","كلَّ ذا أحملُ وحدي","أين من أمي فراري"],["ABFA6A5A-F94D-5E3C-8057-1102A5CFBBD9","أمتا هذاَ وربي","حملُ برذونٍ بخاري"],["56ED037D-9518-50A5-9EFE-5F3A87FEC878","أمتا لستُ ببرذونٍ","ولا بغلٍ مكاري"]]},"17906646-F083-55E4-B757-E94317AA724E":{"t":"وتزعم أني قد تبدلتُ خلةً","p":93,"s":"وتزعم أني قد تبدلت خلة","r":"465289","v":[["14B33866-49E5-5896-A773-4DD5CE947260","وتزعم أني قد تبدلتُ خلةً","سواها وهذا الباطلُ المتقولُ"],["5D4CE15A-AA3B-5EF6-AA69-E8EF71300C8C","لحا اللهُ منْ باعَ الحبيبَ بغيره","فقالتْ نعمْ حاشاك إن كنت تعقلُ"],["F7F76EFA-2A4E-5558-8196-EE040668AB6B","ستصرمُ إنساناً إذا ما صرمتني","يحبك فانظرْ بعده منْ تبدلُ"],["D57D3E69-2E48-5A3E-A104-902D86251ACB","أعلل نفسي منك بالوعدِ والمنى","فهلاً بيأسٍ منك قلبي أعللُ"],["33E8C973-9AD3-58B4-A01B-09FA5B97E5CF","وموعدكِ الشهدُ المصفى حلاوةً","ودون نجاز الوعدِ صابٌ وحنظلُ"],["A444AFC9-B678-559A-AC23-FFF639AF5DA2","وأمنحُ طرف العينِِ غيركِ رقبةُ","حذارَ العداَ والطرفُ نحوكِ أميلُ"],["F7E74740-58E9-53BA-8E3C-2C2B685AD4AE","لكيما يقول الناسُ إنَّ امرأ رمى","ربيعة في ليلى بسوءٍ لمبطلُ"],["DD62FD44-99EC-55AB-876C-E4F31A5696B4","لقد كذبَ الواشون بغياً عليهما","وما منهما إلا بريءٌ مغفلُ"],["4FEDE4A8-2566-54B3-9C47-03611E3BD2E6","فلو كنتُ ذا عقلٍ لأجمعتُ صرعكمْ","برأيي ولكني امرؤٌ لستُ أعقلُ"],["E62326C1-51D4-5266-875A-A393EADDD7E3","وكيف بصبرْ القلب لا كيف عنكمُ","وبابُ فؤادي دونَ صرمكِ مقفلُ"],["0D9B640B-87A1-50C1-A6C8-B3DE57711FCE","ومن أين لامن أين يحرم قتلكمْ","وقتلي لكم يا أمَّ ليلى محللُ"],["8DE23CFE-AF21-5736-BE1E-0A637D657BDB","أغركِ أنْ لا صبر لي في طلابكمْولمّا تَبَيَّنْتِ الذي بي من الهوى وأيْقَنْتِ أنَّي عنكِ لا أَتَحَوَّلُ","وأن ليس لي إلا عليكِ معولسقط بيت ص"],["D28D225A-13D4-50AE-9516-99083EB27919","ظلمتِ كذئبِ السوءِ إذ قال مرةً","لسخلٍ رأى والذئبُ غرثانُ مرملُ"],["88E341E4-04B1-590C-8F51-E930E4135CDF","أأنت الذي في غيرِ جرمٍ شتمتني","فقال متى ذا قال ذا عامُ أولُ"],["A291E153-B3B3-5845-A411-0870D14FD05C","فقال ولدتُ العامَ بل رمتِ غدرةً","فدونك كلني لا هنا لكَ مأكلُ"],["E8D08397-B038-5BCF-B1C4-D59DF9530BF5","أتبكينَ من قتلي وأنتِ قتلتني","بحبك قتلا بينا ليس يشكل"],["6B8E2F3C-CF78-53CD-9B5C-23624B320491","فأنتِ كذباحِ العصافيرِ دائباً","وعيناهُ من وجدٍ عليهنَّ تهملُ"],["C09A0625-39A0-59C6-A4C1-8D7BAB8725E4","فلو كان من رأفٍ بهنَّ ورحمةٍ","لكفَّ يداً ليستْ من الذبح تعطلُ"],["061999CB-B2C1-51A8-A8D3-25F09E91B611","فلا تنظري ما تهملُ العينُ وانظري","إلى الكفَّ ماذا بالعصافيرِ تفعلُ"],["D5C2540E-DB5E-5A59-A102-C62E20F0DE9B","هبيني امرءاً أذنبتُ ذنباً جهلتهُ","ولم آتهِ عمداُ وذو الحلمِ يجهلُ"],["77858A91-5111-5569-88F4-203E44862292","عفاَ الله عماً قد مضى لستُ عائداً","وها أنا ذا من سخطكمْ اتنصلُ"]]},"88EDC003-4879-5C16-865B-83FA87AA4108":{"t":"وتفاحةٍ غضةٍ","p":93,"s":"وتفاحة غضة","r":"465285","v":[["5AFB947C-F73D-5481-ADDE-0A31630766ED","وتفاحةٍ غضةٍ","عقيقيةِ الجوهرِ"],["FD3BF67F-CDD2-567A-8FE7-E1A175DE162E","تندتْ بماء الربيعِ","في روضها الأخضرَ"],["F2AF3448-7682-56AC-9180-D82D5ED09321","فجاءتْ كمثل العروسِ","في لاذها الأحمر"],["29FFD478-F28D-54C6-974B-D94E856FF4B4","ذكرتًُ بها الجلنار","في خدك الأزهرِ"],["176C2CE4-1D49-5D0E-9DD5-B242C14A6B0E","فملتْ سروراً بها","إلى القدحِ الأكبر"],["DBE6CF02-F228-5B8C-A4AE-54C46E362F95","وأنتَ لنا حاضرٌمجزوء الرملأنا للرَّحْمَن عاصيلجُنوني برُخَاصِثمَّ للنّاس جميعاًمن أَدانٍ وأَقَاصيورُخَاص الكَرخِ ظَبْيٌلم أَنَل منهُ افتراصيولقد طَالَ بأبواب الخُريميّ اقتصاصيطَمَعاً في صَيْدِ ظَبْيٍذي شِمِاسٍ ومِلاَصِصيْدُهُ أَعْسَرُ من صَيْدِ الضَّواري","وإن كنتَ لم تحضرِسقط بيت من ص"]]},"D04B1EC1-F96A-53E0-8267-0525C5E79B08":{"t":"يا أميرَ المؤمنينَ","p":93,"s":"يا أميرَ المؤمنينَ","r":"465298","v":[["B38C0A68-DF2A-5450-A155-F0D6698B0718","يا أميرَ المؤمنينَ","اللهُ سماك الأمينا"],["1F322531-9470-5951-87A2-AB0963C24768","سرقوني من بلادي","يا أميرَ المؤمنينا"],["A7D8FAAC-8420-5B80-A78C-05FC9BAE5EDE","سرقوني فاقض فيهمْ","بجزاءِ السارقينا"]]},"BE9605D7-B717-5FD6-A18A-F18BE79FF64F":{"t":"يا غنمَ ردي فؤادَ الهائمِ الكمدِ","p":93,"s":"يا غنم ردي فؤاد الهائم الكمد","r":"465280","v":[["4D759072-096D-55A9-B509-13CA5786B07A","يا غنمَ ردي فؤادَ الهائمِ الكمدِ","من قبلِ أن تطلبي بالعقلِ والقودِ"],["BDCE4E6A-1B52-56C7-B922-E5C1D3986A69","تيمتني بدلالٍ منكِ يقتلني","وقد رميتِ فما أخطأتِ عن كبدي"],["FB70FBB0-FECD-57D0-8F19-C49A9CA51E98","إن تقتليني كذا ظلماً بلا ترةٍ","فلستِ فائتهً قومي بني أسد"],["4F947581-A1A3-5CD2-AB35-9AD9DBCEF4A0","أما الفؤادُ فشيٌْ قد ذهبت بهِ","فما يضركِ ألا تسقمي جسدي"],["8F7FB610-B43C-5B86-A975-4C732E3AB2E5","أنتِ الهوى ومنى نفسي ومتعتها","أقولُ ذاكَ ولا أخفيهِ عن أحدِ"],["08A8AB5B-92A1-5642-8F45-C2966DEA1E04","نلتِ الجمالَ ودلاُّ رائعاً حسناً","فما تسمينَ إلأا ظبيةَ البلدِ"],["1CD6CBD9-09AC-5B17-91B9-BD7EE53F6C86","وأنت طيبةٌ في القيظِ باردةٌ","وفي الشتاء سخونٌ ليلةَ الصردِ"],["A6B2AAC9-CE5B-5A4F-8245-63865C7E3DE6","تسقي الضجيعَ رضاباً من مقبلهاَ","من باردٍ واضحِ الأنيابِ كالبردِ"],["894522D3-082F-5D02-9878-27F1A13A8496","ياليتني قبلَ موتي قد خلوتُ بها","على الحشية بين السجفِ والنضدِ"],["36BA2FBA-E587-5609-BEE2-CA7E64352071","قد وسدتني اليد اليمنى ويارقها","ودملجُ العضدِ اليسرى على عضدي"],["96CB287C-38A4-562C-B3D8-C5A2A0CC3596","في كل يومٍ لنا إلمامةٌ بكمُ","وليتَ داركِ من داري على صددِ"]]},"1F54E65D-F036-5493-B002-EE6B95D695EA":{"t":"يزيدَ الأزدِ إنّ يزيد قومي","p":93,"s":"يزيد الأزد إن يزيد قومي","r":"465278","v":[["3B9097FA-A4C8-55D0-BD70-49B8831AD13A","يزيدَ الأزدِ إنّ يزيد قومي","سميك لا يجود كما تجودُ"],["E72A37A0-082B-586C-BABD-3E2A0DA0F3DE","شبيهك في الولادة والتسمي","ولكن لا يجود كما تجود"],["10073AC3-FB15-5BFC-A3BC-83EAA165FCAA","يقود جماعةً وتقود أخرى","فترزقُ من تقودُ ومنْ يقود"],["27B204C5-A62C-582D-A3DD-C96DF4DBE350","فما تسعونَ يحقرها ثلاثٌ","يقيمُ حسابها رجلٌ شديدُ"],["4BE1B8FB-5279-5D51-B43E-F747261D63AF","وكفًّ شثنهٌ جمعتْ لوجءٍ","بأنكدَ من عطائكَ يا يزيدُ"]]}}}