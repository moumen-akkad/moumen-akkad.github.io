{"v":1,"poems":{"0ACBC8C7-390D-5BC7-8153-8FD06B61FBEB":{"t":"يا ملك الشرق عمدة الدول","p":135,"s":"يا ملك الشرق عمدة الدول","r":"462340","v":[["48A93250-740B-5C95-960D-13DEA73A4611","يا ملك الشرق عمدة الدول","ويا علا المكرمات لا الحيل"],["B3590558-ADF5-568B-A737-00079D57B003","يا أسد الملك لا الغياض ويا","سيف السنا والسناء لا الخِلل"],["70BED15D-14CF-5E2E-9B6E-871C4E2A2476","ويا سحاب العقيان لا بلل القطر","عقاب الملوك لا الحجل"],["68942880-547A-5598-8E5A-795EB60A4E7C","أصبح منك الزمان في وجل","ومن نداك الغمام في خجل"],["6B3E5137-C014-51ED-AAE7-607196255439","طلعت للناس مبتدا أمل","وللمعادين منتهى أجل"],["376D1770-E036-5055-BC54-4FA116135277","بنت لك المكرمات منزلة","اسس أركانها على زحل"],["4F30C8A4-DC91-5DBE-A9A4-7B600A985577","فامدد إلى الشِّعريينِ منك يداً","مخلوقة للعطاء والقبل"],["EEF18D18-5882-5EF0-9531-BD2406C086EC","إذا همت راحتاتك يوم ندى","فالغيم والبحر نطفتا وشل"],["ADA5334B-B2E9-506C-8534-9CBF68E7364E","وإن طمى عسكراك يوم ردى","فالسيل والليل واردا فشل"],["94C961FB-BCD5-5BF6-86EE-86C8F5A77E75","يا من يرى الحرب منتحى قنص","والضرب والطعن مجتنى عسل"],["F440B11B-41A0-5956-B4C1-6E50A0E9BB13","وأسمائه مدى الطول","فانكدر النجم دون ظنك بي"],["F516775B-E79C-5912-8318-73B277AE3E7F","وانتقل الفرض دون أمرك لي","ومن سمت في العلاء همته"],["1E524DF4-CDD8-5C2C-821D-12056BCDBDB8","يخطب ما خطبت من قبلي","لا جرم اجتبت كل مخترق"],["E521775C-840C-5365-BD5A-BC0F1A5B33F4","فيه وأدّخلت كل مدّخل","وشِمتَ دون السيوف سيف فمي"],["6F883927-FE54-5BEB-9B9A-611D29A16C38","لا ذا عمى ولا شلل","فسفت بالقلب أين أنت الصدر وبالصدر"],["4AFD90EA-42C8-5D86-B968-F939E41423BC","فقد سار سائر المثل","والصارم النافذ الشبا الجراز"],["6C534869-22C8-5FEF-92F3-C5C8ECC53780","ز المقاطع الحد غير منتصل","والكفصل السيف هو من فصل"],["C59DAF68-AFD3-5AB5-BB27-D7BC308E63BB","ـصَل العظم إذ قده على عجل","وفي السيوف الكهام هو الذي"],["C5419BA9-A865-5AFD-B78D-314A92AD2B94","يفتك لكن بالقرع والبصل","وفي السيوف المِجذ والجد معنـ"],["E6FB992F-0F3E-55DE-A72D-CAD54382A989","ـنًى سواء في الرعب والوجل","وقد يقال المهز وهو الذي"],["4AC01566-7058-50C3-BCF0-60F5268DF241","يهتز كالغصن ساعة العمل","وهو مقدّ إن خاض في مفرق الرأس"],["EE0E7DB5-73D0-5800-AEA9-99133F9BEC79","مقطّ لها من الكفل","ثم القَساسي وهو منتسب"],["B19EB9FF-5380-521A-8206-28EC39D59E3D","إلى قساسٍ مدينة العمل","قالوا من الريف عذبة الحلل"],["141C937F-F4D5-582F-8EB8-873B4EE91807","والأبرص السيف لا سواد به","كأنه شعلة من الشعل"],["5F5D45B8-7D2D-5E9F-AE42-0E8EECCBBE0D","والأبيض السيف راع منظره","كأنه من سناك في حلل"],["4B0FB6DA-84ED-593C-B9E6-CA84A54F76FE","والمرهف السيف رق جانبه","حتى كأني أعرته غزلي"],["DE737E0E-2B70-584E-B860-766EDE082F6C","والمِبعج السيف واللسان له","رأس طويل كهامة الأسل"],["33419DB4-8762-5DE5-8F6A-6B7B3FDE8A18","القاطع العظم عند مقتتل","وقد يسمونه المطبّق وهو"],["2CC9EE07-CFE5-54EA-A652-351F3CC7B1D1","ـو الضارب العظم ساعةَ الوَهَل","والقضب ما لم يقف على فلل"],["4B8B8054-A48D-59D6-9953-37BFE2579729","وبعض أسمائه المذكر وهـ","إن رمت علمه فسل"],["88D7C288-A2EB-5622-80D0-AB6BDB126512","تلك سيوف شفارها ذكر","من عمل الجزيرة النمل"],["A960C00C-ED45-56A6-9E81-C3E6A4C3A2D6","والباهر السيف نور منظره","يبهر نور العيون والمقل"]]},"0F48BC8B-FAD8-587D-8B09-DAD4B4057B0A":{"t":"يا من يلي أمر القضاءِ","p":135,"s":"يا من يلي أمر القضاء","r":"462112","v":[["F902834E-857A-5B10-8F24-2168FB4CDD8D","يا من يلي أمر القضاءِ","وذاك من سوءِ القضاءِ"],["8EFC465C-0649-50F6-B7A4-325E71BF4035","ويل لقاضي الأرض يوم","م الدين من قاضي السماءِ"],["F6EC4765-32BA-50BE-B3B2-23C4D3EDC9AD","كم من يتيم قد حشوت","ت غناه في ذاك الوعاء"],["2F85DED3-A72D-540E-B794-4A3FFD3E4233","ولرب ثكلى قد تركـ","ـت بعينها أثر البكاءِ"],["C946BE45-0BF9-567F-9A01-3364376AED0F","فسمنت من هزل اليتيم","نعم ومن غزل الإماءِ"]]},"5FF2EA48-11B3-56BC-86E0-B8E7ED876922":{"t":"يا نفس صبراً وإلا فکهلكي جزعاً","p":135,"s":"يا نفس صبرا وإلا فکهلكي جزعا","r":"462288","v":[["34055661-920C-5D40-97B6-04463F0F48A9","يا نفس صبراً وإلا فکهلكي جزعاً","وقلَّ أن تنشظي في الهوى قطعا"],["4AD8B612-FF49-5C47-ABC0-908A1A1AA8DE","أفضت دمعاً ولو أنصفت فضت دماً","ولو عدلتِ لفاضت مقلتاي معاً"],["44B85C33-01AC-530A-8926-55D1306A64A3","ويْب الليالي لقد ألفيتها غدراً","ويل الأماني لقد لاقيتها خدعا"],["9C7E42F5-ED4B-59A3-AC9C-25E262110E1C","للهدم ما شيد الباني وللرد ما","سعى المجدّ وللتفريق ما جمعا"],["3FF3D316-5756-5098-8C00-AD5C6B3C706F","دعا الزمان ولا لبيّه حين دعا","وإن أجبت ولا سَعْدَيْه حين سعى"],["9EADA18A-DA9A-57FB-B676-C1FC590ACBD4","ولا كرامة بالبرد التي طرأت","ولا مسرة بالنجم الذي طلعا"],["2EC53B7E-BA59-53F4-92A2-E862A003B227","أيعلم الليل ما أهدى الصباح لنا","من النكير أيدري الدهر ما صنعا"],["20FDDA3D-9092-5C07-8BEF-56BEFE003B30","أيعلم الناعيان استكَّ سمعهما","بأيّ داهية أسماعنا قرعا"],["6EB64BB7-AB4B-556E-A2D1-EDE22A48CAC1","وفيم لم تعم عين الدهر إذ لحظت","وكيف لم يخرس الناعي غداة نعي"],["6AB017B2-B4AD-5B26-9926-D4078AA7326A","خطب ترفَّع عن شق الجيوب له","وقد شققنا له الأضلاع لو نفعا"],["310ADDE5-3E5F-5F47-A11D-6902750A0883","خطب أفاض ولا أهلاً بخلعته","على الملوك لباس الثكل مدرَّعَا"],["690F3E0D-951F-5909-9AEA-C1009CB77021","يا بؤس مَقْدَمها من نكبة طرقت","وشؤم مصبحه من حادث وقعا"],["7D6333A5-2738-5407-87DC-637B6C3C5C92","لا غُرو إن فضتُ تأساءً وتعزية","بما أفيض ولا كفرانَ إن أدعَا"],["421FD148-3FDE-5E0D-A787-59D5D36A0348","فإن نطقت فإن الوجد انطقني","وإن سكت فعظم الرزء ما صنعا"],["D1CE5554-5DD0-516C-8887-A41FDD4E0867","يا من به يُقتدى في كل صالحة","وينتحى في المعاني راية تبعا"],["E83FD8C6-6C24-5D87-99C0-D90C5FF4B185","أفضى أخوك لما أفضى النبي له","وصنوه أفلا ترضاه متبعا"],["816FD212-47E9-5066-B287-7848E030D198","قد شرف الله مثواه وعرّفه","ونال من درج الجنات مفترعا"],["04F04D42-AD9A-58E2-BA01-D034EF0029D5","إن تحمد اللَّه شكراً عند نعمته","فراقب الله صبراً عند ما رجعا"],["712EF720-A236-57F8-BFA9-68AB21BA6638","أو كنت تعلم أن العالمين غدوا","فيما مُنيتَ به من حادث شرعا"],["83F4D564-E5FF-5A1B-8857-9B8A9355FF85","فالصبر أجمل إلا أن يكون أسى","يرده فإذن لا تأتي جزعا"],["BFFAA8F4-0258-5A5D-811A-CFBBAA858503","شر ألم فلم تملك نكبته","على الإله فبشر منه ما دفعا"]]},"B64EC040-7EB5-54B8-96F2-1F4757AB82B9":{"t":"يروعك النرجس منه الناكسه","p":135,"s":"يروعك النرجس منه الناكسه","r":"462254","v":[["0D39CD59-0B12-50F3-AA5E-EFB5C43ED835","يروعك النرجس منه الناكسه","بعين يقظى وبجيد الناعسة"]]},"812E34D3-42EB-5DFA-A405-C4E101558271":{"t":"يقتلني باللحظ من لحظه","p":135,"s":"يقتلني باللحظ من لحظه","r":"462258","v":[["A02001CE-2237-57C1-965B-358733F6FD96","يقتلني باللحظ من لحظه","يظهر منه أثر الخدشِ"],["95138A99-39A7-598B-9403-728A0AD44CAB","في نفرة الوحش كما أنه","في حسنه يحكي ظبا الوحش"],["D4A826F4-30FE-5EC5-A83D-F7B12FF0CE1C","قولي إذا أبصرته ماشياً","سبحان ربي خالق العرش"]]},"6F782E88-57F2-5022-AC43-03064953DDE7":{"t":"يقولون لي لا تحب الوصي","p":135,"s":"يقولون لي لا تحب الوصي","r":"462122","v":[["6CB45409-16FD-5EDD-A0AF-5F6BEC7B18D1","يقولون لي لا تحب الوصي","فقلت الثرى بفم الكاذ ب"],["FA666AFB-207C-5897-88AE-6F4B30B59D3D","أحب النبي وأهل النبي","وأختص آل أبي طالبِ"],["450728E5-7B7E-5FC5-AC16-CA7ED80FB408","وأعطي الصحابة حق الولاء","وأجري على السَّنن الواجبِ"],["2540F3B4-9DB6-5D8F-850E-817F7F8A1301","فإن كان نصباً ولاء الجميع","فإني كما زعموا ناصبي"],["DDCB4BD5-8A05-513A-A189-44367D20E68E","وإن كان رفضاً ولاء الوصي","فلا يبرح الرفض من جانبي"],["8B494723-CE4B-5309-AD43-F22418492B5F","فللَّه أنتم وبهتانكم","ولله من عجب عاجب"],["97901904-0833-5DEA-BB6B-E19B6F292ABC","فلو كنتم من ولاءِ الوصي","على العجب كنت على الغارب"],["EF87C07D-18B5-5A74-B010-0B4BEEEFE990","يرى اللَّه سري إذا لم تروه","فلم تحكمون على غائبِ"],["53D8BC6F-415A-5D63-91CC-BBF3695C508A","ألا تنظرون لرشد معي","ألا تهتد ون إلى الله بي"],["92F13678-7B8F-5949-AAB6-D1EF1AB2A1BF","أيرجو الشفاعة من سبهم","بل المثل السوء للضاربِ"],["3C1A0F9D-8FB3-53F0-958B-A2AE3B3DC30A","أعز النبي وأصحابه","فما المرء إلا مع الصاحبِ"],["AF4FCAF5-3370-5302-AEF8-00BED49FBE80","حنانيك من طمع بارد","ولبيك من أمل خائبِ"],["F592C574-AB38-58B0-B379-4F45DD1800FC","تمنوا على الله مأمولكم","وخطوه في الجمد الذائب"],["FE1A317E-5E54-5CF8-9EEC-D5A972813522","نعم قبّح الشتم من مذهب","وشتّامة في القومِ من ذاهبِ"],["292CB018-3068-5A7B-9BD6-8FAD89FD9DF7","له في المكارم قلب الجبان","وفي الشُّبهاتِ يد الخاطبِ"]]},"340FB729-887B-514D-81BA-DDFF38EFDE0D":{"t":"ينتابني في كل وقت صيف","p":135,"s":"ينتابني في كل وقت صيف","r":"462302","v":[["13D0F39B-6A58-5870-B368-77A0AB0B984C","ينتابني في كل وقت صيف","ضيف على الرجل شديد الحيف"],["6C00D25C-BA6E-5BD7-9077-C06A7E5A1C66","يركض في بتر ليالي الصيف","مقدار ألفي فرسخ ونيف"],["7FCAF179-3E97-5BDD-9813-35C51C8DC6ED","يبهرج النقد كثير الزيف","أبو المحال واسمه طويف"],["FC9E4ACB-A2B6-52BA-B759-925F26B887F4","لما نزلنا بالمنا فالخيف","وذلك بوادي فيف"],["23AB0BF5-1A45-5DE1-BF5C-262B3C803ADD","هب إلينا كهبوب الهيف","ولم يسر قدر غرار السيف"]]}}}