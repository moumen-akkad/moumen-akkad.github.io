{"v":1,"poems":{"246D8374-D4F1-55E5-9654-B4D2CD734E0D":{"t":"أتوا ناري فقلتُ منونَ أنتُمْ","p":31,"s":"أتوا ناري فقلت منون أنتم","r":"436375","v":[["F741BD29-9A94-5A85-9626-118E37384E69","أتوا ناري فقلتُ منونَ أنتُمْ","فَقَالُوا الْجِّنُ قُلْتُ عِمُوا ظَلاَمَا"]]},"FB67F5A8-FDCF-50F2-A62E-158E2E5C9C50":{"t":"أغَرَّكَ مِنِّي يَا بْنَ فَعْلَةَ عِلَّتِي","p":31,"s":"أغرك مني يا بن فعلة علتي","r":"436324","v":[["620C99AA-49CE-5FB2-B2B4-03E8A4F32A28","أغَرَّكَ مِنِّي يَا بْنَ فَعْلَةَ عِلَّتِي","عَشِيَّةَ أَنْ رَابَتْ عَلَيَّ رَوَائِبِي"],["4327BD5C-BF5C-5752-8C1B-B71776AFE848","وموقدُ نيرانٍ ثلاثٍ فَشَرّها","وألأمها إذ قُدتُها غيرَ عازبِ"],["2B182258-252A-5EA0-9749-D6550808C11E","سَلَبْتَ سِلاَحِي بَائِساً وَشَتَمْتَنِي","فيا خَيرَ مسلُوبٍ ويا شرَّ سالبِ"],["A6D6B517-7C9D-5B08-952D-45BB7A733D3D","فإن أكُ لم أخضِبكَ فيها فإنّها","نيوبُ أساويدٍ وشولُ عقاربِ"],["A34C207C-2465-5928-BB1C-D33B7486DA69","ويا ركبةَ الحمراءِ شرَّةََ ركبةٍ","وكادتْ تكونُ شرّ ركبةَ راكبِ"]]},"1E37967B-26E3-5DC3-8DFC-9889DE5A5838":{"t":"أقسمتُ لا أنسى وإن طالَ عيشُنا","p":31,"s":"أقسمت لا أنسى وإن طال عيشنا","r":"436355","v":[["D0E98448-929C-5EC8-B98D-A6CCD08682EE","أقسمتُ لا أنسى وإن طالَ عيشُنا","صَنِيعَ لُكَيْزٍ وَالأحَلِّ بن قُنْصُلِ"],["1CC24C88-2B8B-5C59-98A6-EB7D805AC9C8","نَزَلْنَا بِهِ يَوْماً فسَاءَ صَبَاحُنَا","فإنَّك عمري قد ترى أيَّ منزلِ"],["7BC0F45E-7C2F-56C8-987D-8B8EBF0BABCA","بَكى إذْ رَآنَا نَازِلِينَ بِبَابِهِ","وكيفَ بكاءُ ذي القليلِ المسبَّلِ"],["F02D7F24-8B84-5F87-A2CF-B32959C8B7FD","فلا وأبيهِ ما نزلنا بعامرٍ","ولا عامرٌ حتَّى الرئيسِ بن قوقلِ"],["1B098ACF-553C-53AB-A4B6-DB15AA77788E","ولا بالشَّليل ربُّ مروانَ قاعداً","بأحْسَنَ عَيْشٍ وَالنُّفَاثِيّ نَوْفَلِ"],["21C0AD72-88C5-5D4B-A32A-952CEF169528","ولا ابنِ وَهِيبٍ كَاسِبِ الحَمْدِ وَالعُلاَ","وَلاَ ابنِ ضَبَيْعٍ وَسْطَ آلِ المُخَبَّلِ"],["CF4B4D0B-62A7-5A4F-A889-94BE8A910E0C","ولا ابن حُلَيْسٍ قَاعِداً في لِقَاحِهِ","وَلاَ ابنِ جُرَيٍّ وَسْطَ آلِ المُغَفَّلِ"],["5C468975-A5C8-5580-8BB2-2F383874FDAF","ولا ابنِ رِياحٍ بالزُّلَيْفَاتِ دَارُهُ","رياح بنِ سعدٍ لا رياحِ بنِ معقلِ"],["0359A257-88A5-5F28-9A48-C3F47B256A63","أُولَئِكَ أعْطَى لِلوَلاَئِدِ خِلْفَةً","وَأدْعَى إلى شَحْمِ السَّدِيفِ المُرَعْبَلِ"]]},"AC50F4A5-4460-50F2-A008-D47898523D12":{"t":"ألا أبلغا سعدَ بنِ ليثٍ وجُندُعاً","p":31,"s":"ألا أبلغا سعد بن ليث وجندعا","r":"436356","v":[["F3AA48E4-578C-5644-8030-B453FC1E524A","ألا أبلغا سعدَ بنِ ليثٍ وجُندُعاً","وَكَلْبَاً أَنِيبُوا الْمَنَّ غَيْرَ المُكَدَّلِ"]]},"1E61F94A-B150-55BB-BB7A-82EC0618860C":{"t":"ألا أبلغْ بني فهم بنِ عمروٍ","p":31,"s":"ألا أبلغ بني فهم بن عمرو","r":"436347","v":[["B05AB330-F2F4-5A37-BBCE-629CB15A8C4B","ألا أبلغْ بني فهم بنِ عمروٍ","عَلَى طُولِ التَّنَائِي والمقَالَهْ"],["E5357EBA-2D87-5E18-8F8A-9A220343751A","مَقَالَ الكَاهِنِ الْجَامِيّ لَمَّا","رَأَى أَثَرِي وَقَدْ أَنْهَبْتُ مَالَهْ"],["2CE5B105-37AE-5C19-A51B-D3D7F2D3E053","أرَى قَدَمَيَّ وَقْعُهمَا حَثِيثٌ","كتحليل الظَّليم دعا رئالهْ"],["CF57CA4C-3601-5FCA-A369-6EDEBD59E109","أرَى بِهِمَا عَذَابَاً كُلَّ يَوْمٍ","لخثعمَ أو بَجِيلةَ أو ثمالهْ"],["0ADEB570-9BF6-55ED-B021-D4B3997E2B86","وشرّاً كانَ صبَّ على هُذيلٍ","إذَا عَلَقَتْ حِبالُهُمْ حِبَالَهْ"],["BEC66E58-E1D5-531E-B0B2-837126040D5E","وَيَوْمُ الأَزْدِ مِنْهُمْ شَرُّ يَوْمٍ","إذَا بَعدُوا فَقَدْ صَدَّقْتَ فَالَهْ"]]},"83D6CF96-79A9-5AAA-A473-CC294108329B":{"t":"ألا تلكُما عِرسي منيعةُ ضمّنت","p":31,"s":"ألا تلكما عرسي منيعة ضمنت","r":"436379","v":[["57D98780-B933-5D47-B693-8DB7094AD206","ألا تلكُما عِرسي منيعةُ ضمّنت","مِنَ الله إثْماً مُسْتَسِراً وَعالنا"],["2416115C-4126-540F-B33C-9249DB2B1C2E","تقولُ تركتُ صاحباً لكَ ضائعاً","وَجِئْتَ إَلَيْنَا فَارِقاً مُتَبَاطِنا"],["81792B87-71CD-55DE-AD83-90009E286376","إذَا مَا تَرَكْتُ صَاحِبِي لِثَلاَثَةٍ","أَوْ اثْنَيْنِ مِثْلَيْنَا فَلاَ أُبْتُ آمِنا"],["EF543918-B67A-5020-B1E6-406D7EC53786","وما كنتُ أبَّاءً على الخلّ إذْ دعا","وَلا المَرْءِ يَدْعُونِي مُمِرّاً مُدَاهِنَا"],["EB52B5CF-8289-5491-BFE4-B9DB957D90D5","وَكَرِّي إذَا أُكْرِهْتُ رَهْطاً وَأَهْلَهُ","وأرضاً يكونُ العوصُ فيها عُجاهنا"],["78257B06-3F42-5F29-A35D-168929CB4E95","ولمَّا سمعتُ العوصَ تدعو تنعَّرتْ","عَصَافِيرُ رَأسِي مِنْ غُوَاةِ فَراتِنَا"],["F18DFEAA-073F-532C-8B9F-FF1AA390759E","ولم أنتظر أن يدهموني كأنّهمْ","وَرَائِي نَحْلٌ فِي الخَلِيَّةِ وَاكِنَا"],["AA247EC9-6BFC-5BDA-9A58-0C0DA5DF2DD6","وَلاَ أَنْ تُصِيبَ النَّافِذاتُ مَقَاتِلِي","وَلَمْ أَكُ بِالشّدِ الذَّلِيقِ مَدَاينا"],["5CD366C0-CB6B-553A-ACA8-1BA77A081AF7","فَأَرْسَلْتُ مثنياً عَنِ الشَّرِّ عَاطِفاً","وَقُلْتُ تَزَحْزَحْ لاَ تَكُونَنَّ حَائِنَا"],["D3A12D49-45AD-51BE-A36C-F3F144E3DA02","وحثحثتُ مشعوفَ النَّجَاءِ كأنّني","هِجَفٌّ رَأى قَصْراً سَمَالاً وَداجِنَا"],["2DB603A4-E08B-56C9-9707-7454CE9E3CFD","من الحُصِّ هَزروفٌ كأنَّ عِفاءهُ","إذا استدرجَ الفيفاء مدَّ المغابنا"],["7C650996-BD1C-5B4B-9FB2-C2D533E280F1","أزَجُّ زَلوجٌ هذرفيٌّ زفازفٌ","هِزَفُّ يَبُذُّ النَّاجِيَاتِ الصَّوَافِنَا"],["A813B333-DABA-58C4-B1CD-4E6419B3BCA1","فَزَحْزَحْتُ عَنْهُمْ أَوْ تَجِئْنِي مَنِيَّتِي","بغبراءَ أو عرفاءَ تغدُو الدَّفائنا"],["5449F2DE-497A-51DD-9257-01F7A1D81806","كَأنِّي أَرَاها الْمَوْتَ لاَ دَرَّ دَرُّهَا","إذا أمكنتْ أنيابها والبراثنا"],["E391E7B9-EB21-5C15-93C7-F2DE2C2AA108","وقالتْ لأُخرى خلفَها وبناتِها","حَتُوفٌ تُنَقِّي مُخَّ مَنْ كَانَ وَاهِنَا"],["33B43457-9B1E-5BB3-9876-83B8E3A1B939","أَخَالِيجُ ورّادٍ عَلَى ذِي مَحَافِلٍ","إذا نزعوا مَدُّوا الدَّلاَ والشَّواطنا"]]},"5AA99DB3-6EF5-5F39-8746-1A38616177EB":{"t":"ألا مَنْ مُبلغٌ فتيانَ فهمٍ","p":31,"s":"ألا من مبلغ فتيان فهم","r":"436380","v":[["CA2AC3BA-FC65-566E-8A9E-DE4CBE6CEC92","ألا مَنْ مُبلغٌ فتيانَ فهمٍ","بِمَا لاَقَيْتُ عِنْدَ رَحَى بِطَانِ"],["7C8B8A93-D64C-5B39-8417-DF35E6B62430","بأني قد لقيتُ الغولَ تهوي","بِشُهْبٍ كَالصَّحِيفَةِ صَحْصَحَانِ"],["2D0D0231-73DA-5D45-A844-151FE20E5AB0","فقلتُ لها: كلانا نضوُ أينٍ","أَخُو سَفَرٍ فَخَلِّي لِي مَكَانِي"],["D4FC84C9-4586-5C60-824A-645C4F35A678","فَشَدَّتْ شَدَّةً نَحْوِي فَأَهْوَى","لها كفِّي بمصقولٍ يماني"],["96AD086A-44E4-57E9-A80A-D9A7551D8204","فأضرِبها بلا دهشٍ فخرَّت","صَرِيعاً لِلْيَدَيْن وَلِلْجِرَانِ"],["90F60863-2A84-53D5-992D-175A3172F131","فقالت عد فقلتُ لها رويداً","مكانك إنّني ثبتُ الجنانِ"],["E64F84C8-B861-596F-9772-9070889E0F38","فَلَمْ أَنْفَكَّ مُتَّكِئاً عَلَيْها","لأنظرَ مُصبحاً ماذا أتاني"],["8F81B50D-B802-5B50-9290-B60D811A8516","إذا عينان في رأسٍ قبيحٍ","كَرَأْسِ الْهِرِّ مَشْقُوقِ اللِّسَانِ"],["02DA91DD-4D77-5B97-A131-68517D995295","وَسَاقَا مُخْدَجٍ وَشَوَاةُ كَلْبٍ","وثوبُ من عباءٍ أو شنانِ"]]},"9B02686D-C09D-508D-8548-B1B07CE25F18":{"t":"ألا هل أتى الحسناءَ أنَّ حليلها","p":31,"s":"ألا هل أتى الحسناء أن حليلها","r":"436325","v":[["0418044A-D970-5A55-BE39-EC80CEB174B6","ألا هل أتى الحسناءَ أنَّ حليلها","تَأَبَّطَ شَرّاً وَاكْتَنَيْتُ أَبَا وَهْبِ"],["0DF2AA9E-5D34-52B0-B473-9147B70F37C3","فَهَبْهُ تَسَمَّى اسْمِي وَسَمَّاني باسْمِهِ","فَأَيْنَ لَهُ صَبْرِي عَلَى مُعْظَمِ الخَطْبِ"],["50CC3FC0-4C4E-50BC-A419-97162475A5D0","وأينَ لهُ بأسٌ كبأسي وَسَورَتي","وأينَ لَهُ في كُلِّ فَادِحةٍ قَلبي"]]},"64E545A4-1472-54A3-BBE5-2048DC060C35":{"t":"أَبَعْدَ قَتِيلِ الْعَوْصِ آسِي عَلَى فَتىً","p":31,"s":"أبعد قتيل العوص آسي على فتى","r":"436342","v":[["0B4402D1-F833-55A6-99BA-020AB906B488","أَبَعْدَ قَتِيلِ الْعَوْصِ آسِي عَلَى فَتىً","وصاحبِهِ أو يأمُلُ الزَّادَ طارقُ"],["C03EF854-F552-5190-A25C-1C3EBD5E503A","أَأَطْرِدُ نَهْبَاً آخِرَ الَّليْلِ أَبْتَغِي","عُلاَلَةَ يَوْمٍ أَوْ تَعُوق الْعَوَائِقُ"],["4F0BBD83-2A2D-56BE-AD18-417FD9C0AA50","لَنِعْمَ فَتىً نِلْتُمْ كَأَنَّ رِدَاءَهُ","على سَرحةٍ من سرحِ دومةَ شانقُ"],["A92DBEE3-4FBB-527C-8CD1-6F04557F591E","لأَطْرُدَ نَهْبَاً أَوْ نَرُودَ بِفِتْيَةٍ","بأيْمَانِهم سُمرُ القنَى والفتائقُ"],["7EA6F1B0-927F-54BB-91A3-8F06BDD69190","مساعِرةٌ شُعثٌ كأنَّ عيونَهُم","حَرِيقُ الْغَضَا تُلْفَى عَلَيْهَا شَقَائِقُ"],["8C9104F3-3A41-5C6A-8D8A-3E83C8D5A464","فعدُّوا شهورَ الحُرمِ ثمَّ تعرَّفوا","قتيلَ أناسٍ أو فتاةً تعانقُ"]]},"96FDCBF6-81B5-5ADE-B0A3-16F569A09C45":{"t":"أَتَنْظُرَانِ قَلِيلاً رَيْثَ غَفلَتِهِمْ","p":31,"s":"أتنظران قليلا ريث غفلتهم","r":"436333","v":[["3E97F7A8-CB85-5D9C-933B-FD8BAB1C50E2","أَتَنْظُرَانِ قَلِيلاً رَيْثَ غَفلَتِهِمْ","أوْ تَعْدُوَانِ فَإنَّ الرّيحَ لِلْعَادِي"]]},"7CD1B3D7-C198-5977-A94A-0548B09E6779":{"t":"أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","p":31,"s":"ألا عجب الفتيان من أم مالك","r":"436334","v":[["78504C14-2194-55C9-A650-8B05CC9D93CB","أَلاَ عَجِبَ الْفِتْيَانُ مِنْ أُمِّ مَالِكٍ","تَقُولُ أَرَاكَ الْيَوْمَ أَشْعَثَ أَغْبَرَا"],["223FE337-069B-5BC7-B756-EAAF04857ED0","تبُوعاً لآثار السَّريَّة بعدما","رَأَيْتُكَ بَرَّاقَ الْمَفَارِقِ أيْسَرَا"],["FA42A00F-8A9E-50BF-A8F3-B5EB2EDCA427","فقلتُ لها:يومَانِ يومُ إقامةٍ","أهزُّ به غُصناً منَ البانِ أخضَرا"],["9FD0B324-514B-5FBF-8821-667787373753","ويومٌ أهزُّ السَّيف في جيدِ أغيدٍ","لَهُ نَسْوَةٌ لَمْ تَلْقَ مِثْلِي أَنْكَرَا"],["79112F8B-C162-5089-BD6E-03983755DF39","يخفنَ عليهِ وهوَ ينزِعُ نفسَهُ","لقد كنتُ أبَّاءَ الظُّلامةِ قَسوَرَا"],["4AA6F42C-F609-508F-90E3-8AAFF0F67D4E","وَقَدْ صِحْتُ فيِ آثَارِ حَوْمٍ كَأنَّهَا","عَذَارَى عُقَيْلٍ أَوْ بَكَارَةُ حِمْيَرَا"],["BF222FD9-E5C9-58EC-A101-8529E7D66C2B","أبعدَ النَّفاثيِّينَ آملُ طُرفةً","وآسى عَلَى شيءٍ إذا هوَ أدبَرا"],["CCD793F1-59BA-50D5-824E-F3156D6E1D9D","أُكفكفُ عَنهُم صُحبتي وإخالُهم","مِنَ الذُّلِّ يَعْراً بِالتَّلاَعَةِ أعْفَرَا"],["681ECF9F-D27C-55BF-9D58-0DC773A3385D","فَلَوْ نَالَتِ الكَفَّانِ أَصْحَابَ نَوْفَلٍ","بمهمهةٍ من بطنِ ظَرءٍ فعَرعرا"],["C94EE13A-0CAB-5757-A04A-9AD6F9BDE0AA","وَلَمَّا أبى اللَّيْثِيُّ إلاَّ تَهَكُّماً","بعِرضي وكان العِرضُ عِرضي أوفَرَا"],["E1232A4B-4F46-5844-BE5A-2FA2E4C80FDB","قُلْتُ لَهُ حَقَّ الثَّنَاءُ فَإنَّنِي","سأذهبُ حتَّى لم أجِد متأخَّرا"],["AB4BE8DE-43EC-5FF4-9062-B60AE70FDEA9","وَلَمَّا رَأَيْتُ الْجَهْلَ زَادَ لَجاجَةً","يَقُولُ فَلاَ يَأْلُوكَ أَنْ تَتَشَوَّرَا"],["B958A2F6-7823-51ED-9305-05F50B8C246A","دَنَوْتُ لَهُ حَتَّى كَأَنَّ قَمِيصَهُ","تشرَّبَ من نَضح الأخادعِ عُصُفرا"],["BA232CEA-6FC6-5147-84EE-EBDF92EE2F45","فمَن مبلغٌ ليثَ بنَ بكرٍ بأنَّنا","ترَكَنا أخاهُم يومَ قرنٍ معفَّرا"]]},"E447F0C4-CB76-58F0-B4C2-12BED5544B2E":{"t":"إذا الحربُ أولَتكَ الكليبَ فوَلِّها","p":31,"s":"إذا الحرب أولتك الكليب فولها","r":"436374","v":[["6B0CA6F4-4355-5327-88B0-9FC382C3D9C4","إذا الحربُ أولَتكَ الكليبَ فوَلِّها","كَلِيبَكَ وَاعْلَمْ أَنَّهَا سَوْفَ تَنْجَلِي"]]},"EC38D738-3FBD-5396-BCA2-C723D5D2A539":{"t":"إذا المرءُ لم يحتل وقد جدَّ جِدُّهُ","p":31,"s":"إذا المرء لم يحتل وقد جد جده","r":"436337","v":[["5C6B1ED5-FF94-5D92-8C26-298A8259EC91","إذا المرءُ لم يحتل وقد جدَّ جِدُّهُ","أَضَاعَ وَقَاسَى أمْرَهُ وَهْوَ مُدْبِرُ"],["2C5408CF-D785-52CE-A8F9-275CF9F55784","لكن أخو الحزمِ الذي ليسَ نازِلاً","بِهِ الخطْبُ إلاَّ وَهْوَ لِلْقَصْدِ مُبْصِرُ"],["01631D14-8B48-5965-96E3-99D265C5AF9C","فذاكَ قريعُ الدّهرِ ما عاشَ حوَّلٌ","إذْا سُدَّ مِنْهُ مَنْخِرٌ جَاشَ مَنْخِرُ"],["B1F413B0-AB6F-5341-82DF-DC5D3A96F3C5","أَقُولُ لِلْحَيْانٍ وَقَدْ صَفِرَتْ لَهُمْ","وِطَابِي وَيَوْمِي ضَيِّقُ الجُحْرِ مَعْوِرُ"],["8B09359E-D999-5974-A4CA-A0BEA07A8D06","هما خُطَّتا إما إسارٌ ومنَّةٌ","وإما دمَّ والقتلُ بالحرِّ أجدرٌ"],["A67ABC35-1B8F-54F7-820F-5EEE9059F5A7","وأخرى أصادي النَّفسَ عنها وإنَّها","لَمَوْرِدُ حَزْمٍ إنْ فَعَلْتُ وَمَصْدَرُ"],["D2BC0E43-B581-503E-BB8D-83BA3AEDFC3C","فرَشْتُ لَهَا صَدْرِي فَزَلَّ عَنِ الصَّفَا","به جؤجؤ عبلٌ ومتنٌ مخصّرُ"],["9E8081BD-A395-5E00-A6EC-698D8CA21BB3","فَخَالَطَ سَهْلَ الأرْضِ لَمْ يَكْدَح الصَّفَا","به كدحةً والموتُ خَزيانُ ينظرُ"],["C220E3CC-5CCF-59DC-9697-1BCA54B5D524","فأبتُ إلى فهمٍ ولم أكُ آيباً","وَكَمْ مِثْلِهَا فَارَقْتُهَا وَهْيَ تَصْفِرُ"],["6BDC9BB7-DC2B-5D89-88BD-AB129E5E2363","فَإنَّكَ لَوْ قَايَسْتَ بِاللِّصْبِ حِيلَتِي","بِلُقْمَانَ لَمْ يُقْصِر بِيَ الدَّهْرَ مُقْصِرُ"]]},"4B79F825-9F70-554C-BEA7-5BE3553BAF95":{"t":"إذَا أفْزَعُوا أُمَّ الصَّبِيَّيْنِ نَفضُوا","p":31,"s":"إذا أفزعوا أم الصبيين نفضوا","r":"436354","v":[["10572639-BED6-5C21-B327-74C7BE46D628","إذَا أفْزَعُوا أُمَّ الصَّبِيَّيْنِ نَفضُوا","غَفَارِيَّ شُعْثاً صَافَةً لَمْ تُرَجَّلِ"]]},"3930F2E2-5CD6-5140-83C8-BF4418A33BAB":{"t":"إذَا وَجْرٌ عَظِيمٌ فِيهِ شَيْخٌ","p":31,"s":"إذا وجر عظيم فيه شيخ","r":"436381","v":[["2684A4ED-9D15-50B1-8D16-BF3E6B5E95D3","إذَا وَجْرٌ عَظِيمٌ فِيهِ شَيْخٌ","منَ السُّوادانِ يُدعى الشَّرَّتينِ"]]},"F564623F-2741-5A95-BB36-05BC224E534B":{"t":"إنَّ بالشَّعبِ الَّذي دُونَ سلعٍ","p":31,"s":"إنَّ بالشَّعبِ الَّذي دُونَ سلعٍ","r":"436352","v":[["154AEFF1-428F-5C0E-B855-C738626F9A98","إنَّ بالشَّعبِ الَّذي دُونَ سلعٍ","لقتيلاً دمهُ ما يُطلُّ"],["CBB351C2-4118-5D8B-8842-55F66213D4BF","خَلَّفَ الْعِبْءَ عَلَيَّ وَولَّى","أنا بالعبءِ لهُ مُستقلُّ"],["10B7D13D-B9E6-5589-82A4-323E21CE1427","ووراءَ الثَّأر منِّي ابنُ أختٍ","مَصِعٌ عُقْدَتُهُ مَا تُحَلُّ"],["815E5DF6-8672-52B8-A632-2E4572B9662F","مُطْرِقٌ يَرْشَحُ سَمّاً كَمَا أَطْـ","ـرَقَ أَفْعَى يَنْفِثُ السَّمَّ صِلُّ"],["4FD09FDC-6420-5F95-A370-E697CB619923","خبرٌ ما نابنا مصمئلٌّ","جلَّ حتّى دقَّ فيهِ الأجلُّ"],["74206561-D52E-5F11-AC3A-6D34317F1D53","بزَّني الدَّهرُ وكانَ غَشوماً","بأبي جارهُ ما يُذلُّ"],["509B35EC-A9A1-5082-A251-A539010CF9AF","شامسٌ في القرِّ حتى إذا ما","ذكتِ الشِّعرَى فبردٌ وظلُّ"],["50CA6C73-29A2-50A0-8764-56B5954D28C0","يابسُ الجنبينِ من غيرِ بؤسٍ","وَنَدِي الْكَفَّيْنِ شَهْمٌ مُدِلُّ"],["3E5DFA3A-DB12-5E7C-A804-02F586592B8B","ظَاعِنٌ بِالْحَزْمُ حَتَّى إذا مَا","حلَّ حلَّ الحزمُ حيثُ يحلُّ"],["33E54D24-951F-54F6-A355-371120F60472","غَيْثُ مُزْنٍ غَامِرٌ حَيْثُ يُجْدِي","وَإذَا يَسْطُو فَلَيْثٌ أَبَلُّ"],["A55DBC51-0935-5BF4-AFEE-22C57E555079","مُسْبِلٌ فِي الْحَيِّ أَحْوَى رِفَلٌّ","وَإذَا يَغْزُو فَسِمْعٌ أَزلُّ"],["D5FFD2F6-CA2C-5A79-A415-CCE7F18245B7","وَلَهُ طَعْمَانِ أَرْيٌ وَشَرْيٌ","وكلا الطَّعمينِ قد ذاق كلُّ"],["9C625627-BC45-575C-A800-94C8CDE66818","يَرْكَبُ الْهَوْلَ وَحِيداً وَلاَ يَصْـ","حبهُ إلاّ اليماني الأفلُّ"],["CA10D9C7-E445-5C24-8DEC-E51E8B0BE973","وَفتُوٍّ هَجَّرُوا ثُمَّ أَسْرَوْا","لَيْلَهُمْ حَتَّى إذَا انْجَابَ حُلُّوا"],["8B544D5B-4FC0-5D4F-B708-E4488F3AA23E","كلُّ ماضٍ قد تردَّى بماضٍ","كَسَنا البرقِ إذا ما يُسلُّ"],["1F7FDC08-BF85-548D-AF19-679F76E6A6E1","فَادَّرَكْنَا الثَّأرَ مِنْهُمْ وَلمَّا","ينجُ ملحيَّينِ إلاّ الأقلُّ"],["FDF46892-0F20-55AC-9C0B-595B5FDA21FB","فاحتسوا أنفاسَ نومٍ فلما","هَوَّمُوا رُعْتَهُمُ فَاشْمَعَلُّوا"],["41CC53D2-8AFF-5D8B-9E40-DD15EFBD5350","فَلَئِنْ فَلَّتْ هُذَيْلٌ شَباهٌ","لبما كانَ هذيلاً يفلُّ"],["ECDA3625-0678-50EE-9163-211F43A14308","وبم أبركها في مناخٍ","جَعْجَعٍ يَنْقَبُ فِيهِ الأَظَلُّ"],["2BF8E760-A58C-539C-9BA7-67402F973E51","وبما صبَّحها في ذراها","منهُ بعدَ القتل نهبٌ وشلُّ"],["A7F6393E-D690-5891-B25A-57418D46EE69","صليتْ منِّي هذيلٌ بخرقٍ","ولا يملُّ الشرَّحتى يملُّوا"],["6A897422-2D3C-5A1C-A6B5-D653D029D72B","يُنهلُ الصّعدةَ حتّى إذا ما","نهلت كان لها منه عِلُّ"],["F39A1DC2-41E0-527A-AB51-E49D7FCA0552","حَلَّتِ الْخَمْرُ وَكَانَتْ حَرَاماً","وبلأيٍ ما ألمَّت تحلُّ"],["9D33ACBF-0C75-51A2-A4A4-244E667F81D5","فاسقنيها يا سوادَ بن عمرو","إنَّ جِسمِي بَعْدَ خَالِي لَخَلُّ"],["B2FE52F6-F991-51CC-A0C4-52658E6F5622","تضحكُ الضَّبعُ لقتلي هذيلٍ","وترى الذِّئبَ لها يستهلُُّّ"],["4EFB59B1-3713-5E11-AC2D-454F28960648","وعتاقُ الطَّيرِ تغدو بطاناً","تَتَخَطَّاهُمْ فَمَا تَسْتَقِلُّ"]]},"63DC25C9-9238-569F-A563-1B165B36E182":{"t":"إنِّي إِذَا حَمِيَ الوَطِيسُ وَأُوْقِدَتْ","p":31,"s":"إني إذا حمي الوطيس وأوقدت","r":"436357","v":[["E390EF8B-619D-5931-96CD-95446E704679","إنِّي إِذَا حَمِيَ الوَطِيسُ وَأُوْقِدَتْ","لِلْحَرْبِ نَارُ كَرِيهَةٍ لَمْ أَنْكُلِ"]]},"63A5BCAA-919E-5492-97CF-932DAA0CD7AE":{"t":"إِذَا خَلَّفْتُ بَاطِنَتَيْ سَرَارٍ","p":31,"s":"إذا خلفت باطنتي سرار","r":"436330","v":[["3DED087C-78EC-5DAC-B23E-C9AB5B8BACDE","إِذَا خَلَّفْتُ بَاطِنَتَيْ سَرَارٍ","وبطنَ هضاضَ حيثُ غذا صباحُ"]]},"9BAD436A-B6F3-5BC3-97F1-B9A6BDCF4BDF":{"t":"بحليلةِ البجليّ بتْ من ليلها","p":31,"s":"بحليلة البجلي بت من ليلها","r":"436343","v":[["E0FF1DE5-EE51-5266-81DB-BB043CD5C872","بحليلةِ البجليّ بتْ من ليلها","بينَ الإزارِ وكشحِها ثمّ ألصَقِ"],["1AC85661-4446-5D24-BED2-F96A3FAF4C6B","بِأَنِيسَةٍ طُوِيَتْ على مَطْوِيِّها","طَيُّ الحَمَالَةِ أو كَطَيّ المِنْطَقِ"],["C0D9FB8D-662E-5793-9093-26A12256A192","فإذا تقومُ فصعدةٌ في رملةٍ","لبدتْ بريِّقِ ديمةٍ لم تغدقِ"],["584730D6-DA8D-51AD-9748-C26A5A025D93","وإذا تجيءُ تجيءُ شحبٌ خلفها","كالأثيمِ أُصعدَ في كئيبٍ يرتقي"],["F6BAE5CC-4201-5F2C-8E4D-818F74BFA4C6","كَذَبَ الْكَوَاهِنُ وَالسَّواحِرُ والهُنا","أن لا وفاءَ لعاجزٍ لا يتَّقي"]]},"C22E6D0E-387A-54FE-83C6-B518B70C35E2":{"t":"تقولُ سُليمى لجاراتِها","p":31,"s":"تقول سليمى لجاراتها","r":"436350","v":[["1C0291E2-F96C-5FEA-89AA-87AD1CC8844E","تقولُ سُليمى لجاراتِها","أَرَى ثَابِتاً يَفَناً حَوْقَلاَ"],["C3DA4653-5B5C-5BEF-BD1C-1C332024F4F1","لَهَا الْوَيْلُ مَا وَجَدَتْ ثَابِتاً","أَلَفَّ الْيَدَيْنِ وَلاَ زُمَّلاَ"],["08B432B7-C482-566F-B56D-682F11225D89","وَلاَ رَعِشَ السَّاقِ عِنْدَ الجِرَاء","إذَا بَادَرَ الْحَمْلَةَ الْهَيْضَلاَ"],["F9F26A0F-0695-57E6-8F88-0F1903633E67","يفوتُ الجيادَ بتقريبهِ","ويكسُو هواديَها القسطلا"],["9F828647-EC3A-5BA1-BDD2-6EE7255C38A2","وأدهمَ قد جُبتُ جلبابهُ","كَمَا اجْتَابَتِ الْكَاعِبُ الْخَيْعَلاَ"],["84BDA147-CAC8-5B1D-895E-355628F8A734","إلَى أَنْ حَدَا الصُّبْحُ أَثْنَاءَهُ","وَمَزَّقَ جِلْبَابَهُ الأَلْيَلاَ"],["A218F573-F2C0-553E-B468-090704B68B60","عَلَى شَيْمِ نَارٍ تَنَوَّرْتُهَا","فَبِتُّ لَهَا مُدْبِراً مُقْبِلاَ"],["A2951F25-8B4D-5C4F-BF94-9ED668B9403A","فَأصْبَحْتُ وَالْغُولُ لِي جَارَةٌ","فَيَا جَارَتَا أَنْتِ مَا أَهْوَلاَ"],["9A941AB5-9B59-5DD1-8853-9E82BB63B4C5","وَطَالَبْتُهَا بُضْعَهَا فَالْتَوَتْ","بِوَجْهٍ تَهَوَّلَ فَاسْتَغْوَلاَ"],["7E1B701B-EE27-553F-8EEF-C9C71BE4F233","فقلتُ لها يا انظري كي تريْ","فولّت فكنتُ لها أغوَلا"],["5AC3EFEB-DF13-5E2F-B175-2FDC92BF205D","فطارَ بقحفِ ابنةِ الجنِّ ذو","سَفَاسِقَ قَدْ أَخْلَقَ الْمِحْملاَ"],["2F5AC617-F330-5E87-8B55-9A459CC2AE7D","إذا كلَّ أمهيتُهُ بالصَّفا","فَحَدَّ وَلَمْ أَرِهِ صَيْقَلاَ"],["6E030890-3B68-5AB0-9994-2B1F9868E803","غَظَاءَةُ قَفْرٍ لَهَا حُلَّتَا","نِ مِنْ وَرَقِ الطَّلْحِ لَمْ تُغْزلاَ"],["F39B3FC6-73E7-5698-9339-DBC2C685725E","فمن سالَ أين ثوت جارتي","فإنَّ لها باللِّوى منزلا"],["E414F55E-7AC6-52CD-B672-FCCE5ECDA32F","وكنتُ إذا ما هممتُ اعتزمتُ","وأحرِ إذا قلتُ أنْ أفعَلا"]]},"DBAF8AA4-BDEF-5FA5-BBA6-31ACF64337AE":{"t":"تَأبَّطَ شَرّاً ثُمَّ رَاحَ أَوْ اغْتَدَى","p":31,"s":"تأبط شرا ثم راح أو اغتدى","r":"436358","v":[["322B5168-4A1D-527A-92EE-3E3189B16B5F","تَأبَّطَ شَرّاً ثُمَّ رَاحَ أَوْ اغْتَدَى","يُوَائِمُ غُنْماً أَوْ يَشِيفُ عَلَى ذَحْلِ"]]},"426A158E-1242-5F55-B4D1-604BCF5B1DA5":{"t":"تَعْتَعْتُ حِضْنَيْ حَاجِزٍ وَصِحَابَهُ","p":31,"s":"تعتعت حضني حاجز وصحابه","r":"436341","v":[["19A0C70D-05FB-5D6C-A5EE-3D7A305E6270","تَعْتَعْتُ حِضْنَيْ حَاجِزٍ وَصِحَابَهُ","وقد نبذوا خُلقانَهم وتشنَّعوا"],["C5414428-FFF3-52D1-A6CE-C20EA26F89C0","أظنُّ وإن صادفتُ وعثاً وإن جرى","بِي السَّهْلُ أَوْ مَتْنٌ مِنَ الأرْضِ مَهْيعُ"],["542FD4B8-1A49-55D6-B651-12E44FF5512B","أُجَارِي ظِلاَلَ الطَّيْرِ لو فَاتَ واحدٌ","ولو صدقوا قالوا بلى أنتَ أسرعُ"],["7F4CCD9A-EA96-5621-B271-1540AAC34122","فمن كانَ من فتيانِ قيسٍ وخِندفٍ","أَطَافَ بِهِ الْقَنَّاصُ مِنْ حَيْثُ أُفْزِعُوا"],["AEE2CC9A-9DFB-5AD9-8A9A-17C155A1D028","يحُبْ ثلاثاً بين يومٍ وليلةٍ","وآبَ مُرِيحاً وَهْوَ أَشْوَشُ أَرْوَعُ"],["32AB4F5A-DF79-5A9A-A4AE-F0627360179B","وَلَوْ كَانَ قِرْنِي وَاحِداً لَكَفَيْتُهُ","وما ارتجَعوا لو كانَ في القوم مَطمعُ"]]},"ABC4246D-C16C-5D03-8817-F242CD8A38AD":{"t":"تُرجّي نساءُ الأزدِ طلعةَ ثابتٍ","p":31,"s":"ترجي نساء الأزد طلعة ثابت","r":"436359","v":[["3887948E-205A-5A6D-B8BB-47350B9FE442","تُرجّي نساءُ الأزدِ طلعةَ ثابتٍ","أَسِيراً وَلَمْ يَدْرِينَ كَيْفَ حَوِيلِي"],["9AF71B75-0EEB-53BC-9CD1-F26C3C4A2276","فإنَّ الأُلَى أَوْصَيْتُمْ بَيْنَ هَارِبٍ","طريدٍ ومسفوحِ الدِّماءِ قتيلِ"],["680241EB-052B-53A0-A947-D48833C739DF","وَخَدْتُ بِهِمْ حَتَّى إذَا طَالَ وَخْدُهُمْ","وَرَابَ عَلَيْهِمْ مَضْجَعِي وَمَقِيلِي"],["8C3CAE7D-8270-54F3-812E-B5B988131553","مَهَدْتُ لَهُمْ حَتَّى إذَا طَالَ رَوْعُهُمْ","إلى المهدِ خاتلتُ الضِّيا بختيلِ"],["811DE915-1649-561D-96C5-36102C4F3470","فلمَّا أحسُّوا النَّومَ جاءوا كأنَّهُمْ","سِبَاعٌ أضَافَتْ هَجْمَةً بِسَلِيلِ"],["B1704D70-CD20-5437-B070-B6B84219104E","فقلَّدْتُ سوَّارَ بن عمرو بنِ مالكٍ","بِأسْمَرَ جَسْر القُّذَّتَيْنِ طَمِيلِ"],["1BCCD21C-BE50-598D-8E8A-98BC8871D2AF","فَخَرَّ كَأنَّ الْفِيلَ أَلْقَى جِرَانَهُ","عليه بريّان القواءِ أسيلِ"],["C5B9A1ED-3187-5381-B2CC-755685FAE81C","وَظَلَّ رَعَاَعُ الْمَتْنِ مِنْ وَقْعِ حَاجِزٍ","يخِرُّولو نهنهتُ غيرَ قليلِ"],["81BE5C5F-873F-5011-9FC8-99F819963EC0","لأُبتُ كما أبا ولو كنتُ قارناً","لجئتُ وما مالكتُ طولَ زميلي"],["777A3AB4-C69A-50CA-BB03-8B6D7F5D9C8E","فسرُّكَ ندماناكَ لمّا تتابعَا","وأنَّكَ لمْ ترجعْ بعوصِ قتيلِ"],["2D49E0DD-E12D-5D42-8DFF-1068A2BB1C86","ستأتي إلى فهمٍ غنيمةُ خلسةً","وفي الأزدِ نوحُ ويلةٍ بعويلِ"]]},"39F37704-596E-50E5-8C64-EB6816B3B963":{"t":"جَزَى اللَّهُ فِتْيَاناً عَلَى العَوْصِ أَمْطَرَتْ","p":31,"s":"جزى الله فتيانا على العوص أمطرت","r":"436378","v":[["680E518F-9B02-5BF5-827F-CF830FD63DAF","جَزَى اللَّهُ فِتْيَاناً عَلَى العَوْصِ أَمْطَرَتْ","سماؤهمُ تحتَ العجاجة بالدمِ"],["6D362A4D-5A9D-5630-A5E1-091F9702210D","وَقَدْ لاَحَ ضَوْءُ الْفَجرِ عَرْضاً كَأَنَّهُ","بلمحتهِ أقرابُ أبلقَ أدهمِ"],["5742DF20-2BE1-58E9-B51E-D2134D2D991B","فَإنَّ شَفَاءَ الدَّاءِ إدْرَاكُ نُحْلَةٍ","صياحٌ على آثارِ حومٍ عرمرمِ"],["2322AAB5-9A72-5861-B00D-A87925317C41","وضاربتهمْ بالسَّفحِ إذ عارضتُهم","قبائلُ من أبناءِ بشرٍ وخثعم"],["4969E8FC-5CA4-5A07-BDBE-D1AC3A740071","ضراباً غدا منهُ ابنُ حاجزَ هارباً","ذُرَى الصَّخْرِ فِي جَدْرِ الرَّجِيلِ المُرَيَّمِ"]]},"2845FB7B-B1CD-57C3-9630-BDEA415A2580":{"t":"شَنِئْتُ الْعَقْرَ عَقْرَ بَنِي شُلَيْلٍ","p":31,"s":"شنئت العقر عقر بني شليل","r":"436331","v":[["BCD9B72A-1908-5CAF-BF39-6A3742128A94","شَنِئْتُ الْعَقْرَ عَقْرَ بَنِي شُلَيْلٍ","إذَا هَبَّتْ لِقَارِيهَا الرِّيَاحُ"],["5B0B5DD1-6F40-5BA6-95B6-AC2FAEE322A9","كرهتُ بني جُذيمة إذ ثرونا","قَفَا السَّلَفَيْنِ وانْتَسَبُوا فَبَاحُوا"]]},"037724C3-6E04-5287-AA66-7816A7EC8AB8":{"t":"عَلَى الشَّنْفَرَى سَارِي الْغَمَام فَرَائِحٌ","p":31,"s":"على الشنفرى ساري الغمام فرائح","r":"436335","v":[["30AA742A-C389-57C5-97DC-6574F90E1E86","عَلَى الشَّنْفَرَى سَارِي الْغَمَام فَرَائِحٌ","غَزِيرُ الكُلَى أَوْ صَيِّبُ الْمَاءِ بَاكِرُ"],["B4029902-E41E-5850-921A-C9B702932598","عَلَيْكَ جَدَاءٌ مِثْلُ يَوْمِكَ بِالْحَيَا","وَقَدْ رَعَفَتْ مِنِّي السُّيُوفُ البَوَاتِرُ"],["1D4A80E2-8E3D-538C-A092-955CF9ADA458","ويومُكَ يوم العَيكتينِ وعَطفةٌ","عَطَفتَ وقد مسَّ القلوبَ الحَنَاجِرُ"],["481C9173-B381-515F-A329-F31F6583F90A","تُجيلُ سلاحَ الموتِ فيهم كأنَّهم","لِشَوْكَتِكَ الحُدَّى ضَئِينٌ نَوَافِرُ"],["69C19D08-1E9D-5F07-A78C-A101A88520B8","وطعنةِ خلسٍ قد طعنتَ مُرشَّةٍ","لها نفذٌ تَضِلُّ فيها المَسَابِرُ"],["0EED5F03-A46B-5A33-B38B-FE61117D3B0B","يظلُّ لها الآسي أميماً كأنَّهُ","نَزِيفٌ هَرَاقَتْ لُبَّهُ الْخَمْرُ سَاكِرُ"],["29548F1E-A8F6-5D7C-82CE-5A53D00E066A","وإنَّكَ لَوْ لاَقَيْتَنِي بَعْدَ مَا تَرَى","وهل يُلقَين من غيَّبتهُ المقابرُ"],["0807A4C8-5233-5EE1-94FB-65EFAE0D9202","لألفيتَني في غارةٍ أُدَّعى لها","إلَيْكَ وَإمَّا رَاجِعاً أَنَا ثَائِرُ"],["31C969E1-B1B6-52DD-8B59-698DB2F2B915","وإنْ تَكُ مَأْسُوراً وَظِلْتَ مُخَيِّماً","وَأَبْلَيْتَ حَتَّى مَا يَكِيدُكَ وَاتِرُ"],["8627A00F-1D99-56D6-904D-1CF776A9EBB2","وَحَتَّى رَمَاكَ الشَّيْبُ في الرَّأْسِ عَانِساً","وخَيرُكَ مبسُوطٌ وزادُكَ حَاضرُ"],["ECD2F558-8D19-59CA-A7C8-33F8268EBE85","وَأَجْمَلُ مَوْتِ الْمَرْءِ إِذْ كَانَ مَيِّتاً","وَلاَ بُدَّ يَوْماً مَوْتُهُ وَهْوَ صَابِرُ"],["A777C211-7D7E-5138-B495-4A537D0636EC","فَلاَ يَبْعَدَنَّ الشَّنْفَرَى وَسِلاَحُهُ","الْحَدِيدُ وَشَدُّ خَطْوِهِ مُتَوَاتِرُ"],["A4C8D254-6063-5C6D-AD96-12AB4F172276","إذَا رَاعَ رَوْعَ الْمَوْتِ رَاعَ وَإنْ حَمَى","حمى معهُ حرٌّ كريمٌ مصابرُ"]]},"71C35659-7C57-53AC-8645-6138EB33A0F2":{"t":"فإن تصرِميني أو تُسِيئي جنابَتي","p":31,"s":"فإن تصرميني أو تسيئي جنابتي","r":"436338","v":[["9A10759D-98C8-57E9-81B7-C3C0C206B0D0","فإن تصرِميني أو تُسِيئي جنابَتي","فإنِّي لصرَّامُ المُهينِ جُذامِرُ"]]},"8DD93A18-2A9A-51E2-B076-490544086C59":{"t":"فَيَوْماً بِغُزَّاءٍ وَيَوْماً بِسُرْيَةٍ","p":31,"s":"فيوما بغزاء ويوما بسرية","r":"436360","v":[["E155BB02-CC99-51AB-850C-42387F7167E6","فَيَوْماً بِغُزَّاءٍ وَيَوْماً بِسُرْيَةٍ","ويوماً بخشخاشٍ منَ الرَّجلِ هيضلِ"]]},"AC3C9295-8FF1-5A82-A145-9712966F7456":{"t":"قد أطعنُ الطَّعنةَ النَّجلاءَ عنْ عُرُضٍ","p":31,"s":"قد أطعن الطعنة النجلاء عن عرض","r":"436382","v":[["E17C774B-2872-580F-9E94-736C8C4D6BA2","قد أطعنُ الطَّعنةَ النَّجلاءَ عنْ عُرُضٍ","كَفَرْجِ خَرْقَاءَ وَسْطَ الدَّارِ مِسْكِينِ"]]},"80EB1A72-0165-5252-8543-AC9F0E00E90D":{"t":"لقدْ قالَ الخليُّ وقالَ حُلساً","p":31,"s":"لقد قال الخلي وقال حلسا","r":"436377","v":[["803A24E5-AC45-559B-BF41-B0C5A9F17EFF","لقدْ قالَ الخليُّ وقالَ حُلساً","بِظَهْرِ اللَّيْلِ شُدَّ بِهِ الْعَكُومُ"],["5BDD537D-266F-5712-878D-760D6FF939C2","لَطِيْفٍ مِنْ سُعَادَ عَنَاكَ مِنْهَا","مُراعَاةُ النُّجُومُ وَمَنْ يَهِيمُ"],["8417C794-9528-5985-A72A-E62453DEAC18","وَتِلْك لَئِنْ عُنِيتَ بِهَا رَدَاحٌ","مِنَ النسِّوَانِ مَنْطِقُهَا رَخِيمُ"],["3A8D699E-EF1A-5AF5-B929-CEEFD6CE826B","نَيَافُ الْقُرْطِ غَرَّاءُ الثَّنَايَا","وريداءُ الشَّبابِ ونِعمُ خيمُ"],["63C5777D-587E-5318-A7FC-5A38C7D19BA8","وَلَكِنْ فَاتَ صَاحِبَ بَطْنِ رَهْوٍ","وصاحبهُ فأنتَ به زعيمُ"],["090EFC82-5735-5F25-B524-9D6632934B93","أُوَاخِذُ خُطَّةً فِيهَا سَواءً","أبيتُ وليلُ داثرِها نؤومُ"],["C300653E-9813-5D29-83F1-592592E9E80D","ثَأَرْتُ بِهِ وَمَا افْتَرَقَتْ يَدَاهُ","فَظَلَّ لَهَا بِنَا يَوْمٌ غَشُومُ"],["AB83C926-A7C0-5396-948B-B7F6A8EF509C","نَحِزُ رِقَابَهُمْ حَتَّى نَزَعْنَا","وَأَنْفُ الْمَوْتِ مِنْخَرُهُ رَثِيمُ"],["6EB7709A-901C-5B9F-B543-D63B3635C638","وَإنْ تَقَعِ النُّسُورُ عَلَيَّ يَوْماً","فَلَحْمُ الْمُعْتَفَى لَحْمٌ كَرِيمُ"],["469734B1-D24B-5891-9540-068971E0AFC3","وَذِي رَحِم أَحَالَ الدَّهْرُ عَنْهُ","فَلَيْسَ لَهُ لِذِي رَحِمٍ حَرِيمُ"],["29E698AC-B862-5BA1-B373-AE92A9B6A49E","أصابَ الدَّهرُ آمنَ مِروتيهِ","فَألْقَاهُ المُصَاحِبُ والْحَمِيمُ"],["68D88846-BB15-523D-A7EC-3B695FE1545A","مددتُ لهُ يميناً من جناحي","لَهَا وَفْرٌ وَكَافِيَةٌ رَحُومُ"],["DA69B86D-C93D-53F9-8A74-620DE79A275C","أُواسيهِ على الأيامِ إنِّي","إذا قعَدتْ بهِ اللُّؤَمَا أَلُومُ"]]},"ED4BA338-F6AB-53AB-9E73-0B84740D2AA6":{"t":"لَعَلِّي مَيِّتٌ كَمَداً وَلَمَّا","p":31,"s":"لعلي ميت كمدا ولما","r":"436326","v":[["B098AAFC-D210-5DC8-8A8A-640FEE8D2A84","لَعَلِّي مَيِّتٌ كَمَداً وَلَمَّا","أطالع أهلَ ضيمٍ فالكرابِ"],["0EB051C5-A38C-5786-B80C-0B382116F79D","وإنْ لَمْ آتِ جَمْعَ بَنِي خُثَيْمٍ","وكاهِلَها برجلٍ كالضبابِ"],["6ECAE5B0-4673-5D40-B34B-057A98D2E63A","إذَا وَقَعَتْ بِكَعْبٍ أوْ قُرَيْمٍ","وسيَّارِ فّيَا سوغَ الشَّرَابِ"]]},"812DF35C-5E59-5F89-8FD9-B7670E1E46E5":{"t":"لَعَمْرِ أبِينَا مَا نَزلْنَا بِعَامِرٍ","p":31,"s":"لعمر أبينا ما نزلنا بعامر","r":"436361","v":[["DBCA652E-63EE-5EE8-8730-6E5A75893A24","لَعَمْرِ أبِينَا مَا نَزلْنَا بِعَامِرٍ","ولاَ عامرٍ ولاَ النُّفاثيُّ نوفلِ"]]},"5AA13A27-5D2F-5EA5-9F2C-247828A2E816":{"t":"مَا لَكَ مِنْ ... سليب الخُلَّةْ","p":31,"s":"ما لك من ... سليب الخلة","r":"436348","v":[["2C6898E2-EC63-5B7A-AB14-3243C9AF4E90","مَا لَكَ مِنْ... سليب الخُلَّةْ","عَجَزْتَ عَنْ جَارِيَةٍ رِفَلَّهْ"],["6148921D-1F18-5DD9-88F6-197882E08687","تَمْشِي إِلَيْكَ مِشْيَةَ هِرَكلَّهْ","كَمِشْيَةِ الأرْخِ تُرِيدُ العَلَّهْ"],["673C2DC8-2424-5049-9441-600C9954ED16","لو أنَّها راعيةٌ في ثلّةْ","تَحِمْلُ قِلعَينِ لِها قبلَّهْ"]]},"3ED77359-3563-5815-B446-8CE777A03BA2":{"t":"مَتى تَبْغِني مَا دُمْتُ حَيّاً مُسَلّماً","p":31,"s":"متى تبغني ما دمت حيا مسلما","r":"436362","v":[["28B80653-F70A-50EA-B1E0-A7A5AB31ED7C","مَتى تَبْغِني مَا دُمْتُ حَيّاً مُسَلّماً","تَجِدْنِي مَعَ الْمُسْتَرعِلِ المُتَعَبْهِلِ"]]},"FB72C6F9-4C92-5FF5-85D0-43B95ECDF938":{"t":"وإنك لا بزّاً منعتَ ولا يداً","p":31,"s":"وإنك لا بزا منعت ولا يدا","r":"436339","v":[["17F8BD6B-4879-5BFA-AD8F-613A17A5B8CA","وإنك لا بزّاً منعتَ ولا يداً","وإنَّ السُّيوفَ بالأكفِّ شوارعُ"],["6BFA9CD0-8D29-5D82-8055-06089DD2C9C4","غداةَ تقولُ قد ملكتم فأسجحُوا","وَإنِّي لِمَا أَسْلَكْتُمُونِي لَتَابِعُ"],["0FC8161A-7CA3-59FB-834A-046EBE509786","فوالله لولا ابنا كلابٍ وعامرٌ","بعوا أمرَ غياّتٍ همُ والأقارعُ"],["B0B08699-4D11-55FD-B024-51DB8A7FDD90","لجامعتُ أمراً ليسَ فيهِ هوادةٌ","ولا غُضَّةٌ وليسَ فيها تنازُعُ"]]},"AC8EF32C-8EE3-559B-AA22-D18DF16E0010":{"t":"وإنِّي لمُهدٍ من ثنائي فقاصدٌ","p":31,"s":"وإني لمهد من ثنائي فقاصد","r":"436345","v":[["F6292B18-5485-5D49-9A3A-6A7C49C6C0D2","وإنِّي لمُهدٍ من ثنائي فقاصدٌ","به لابن عمِّ الصِّدقِ شُمسِ بن مالكِ"],["16DAD1FC-C2D9-5CCD-95C0-59AFAC00A0DE","أهزُّ بهِ في ندوةِ الحيِّ عِطفهُ","كَمَا هَزَّ عِطْفِي بِالْهِجانِ الأوَارِكِ"],["A220DCF9-0216-579B-8F9D-1DCF2EF7DFD3","قَلِيلُ التَّشَكِّي لِلْمُهِمّ يُصِيبُهُ","كَثِيرُ الْهَوَى شَتَّى النَّوَى وَالْمَسَالِكِ"],["1B71CDF4-945F-5934-8E76-58C593A50B94","يَظَلُّ بِمَوْمَاةٍ وَيُمْسِي بِغَيْرِهَا","جَحيشاً ويَعرَورى ظهورَ المهالكِ"],["11F8FCB4-643D-56EA-A4F0-13C92F73D10A","ويسبقُ وفد الرِّيحِ من حيث ينتحي","بمنخَرقٍ من شدِّهِ المتداركِ"],["5062FC81-C85B-53F6-8EA4-066B454D33EB","إذا خَاطَ عَيْنَيْهِ كَرى النَّوْمِ لَمْ يَزَلْ","لَهُ كَالِىءٌ مِنْ قَلْبِ شَيْحَانَ فَاتِكِ"],["EF2C0DAB-4773-54BC-837D-C7FC5B440AD5","إذا طلعت أولى العَديِّ فنفرهُ","إلى سلَّةٍ من صارمِ الغربِ باتك"],["D544205B-CB1E-58D1-B3F5-337C8B595044","إذَا هَزَّهُ فِي عَظْمِ قَرْنٍ تَهَلَّلَتْ","نواجذُ أفواهِ المنَايا الضَّواحكِ"],["3A20038B-D8FF-58B5-99F5-7ACE5575F1F0","يَرَى الْوَحْشَةَ الأُنْسَ الأَنِيسَ ويَهْتَدِي","بِحَيْثُ أهتدت أُمُّ النُّجُومِ الشَّوَابِكِ"]]},"8CA77E81-86F3-57B8-AB35-CB6D173692E2":{"t":"وبالشَّعبِ إذا سدَّتْ بجيلةُ فجَّهُ","p":31,"s":"وبالشعب إذا سدت بجيلة فجه","r":"436351","v":[["B057EF79-81C6-566D-8AD3-B005583FCF80","وبالشَّعبِ إذا سدَّتْ بجيلةُ فجَّهُ","وَمِنْ خَلْفِهِ هُضْبٌ صِغَارٌ وَجَامِلُ"],["3603A5B7-73BF-5759-B075-2C0C96C6AD4D","شددتُ لنفسِ المرءِ مرّةَ حزمهُ","وَقَدْ نُصِبَتْ دُوَنْ النَّجَاءِ الْحَبَائِلُ"],["E656B10A-C3BD-58F5-97B8-7A059CB30976","وقلتُ لهُ كن خلفَ ظهري فإنني","سَأفْدِيكَ وانْظُرْ بَعْدُ مَا أَنْتَ فَاعِلُ"],["6B5EFC68-FD45-5A03-9699-D39CB31EEDF3","فَعَاذَ بِحَدِّ السَّيْفِ صَاحِبُ أَمْرِهِمْ","وَخَلَّوا عَنِ الشَّيْءِ الَّذِي لَمْ يُحَاولُوا"],["E9C042CD-0251-5179-977F-5B753D25F0C7","وَأخْطَأَهُمْ قَتْلِي وَرَفَّعْتُ صَاحِبِي","على اللَّيلِ لم تُؤخذْ علىَّ المخاتلُ"],["D58E1716-9913-5B67-9AED-9B98F3DB41F7","وَأخْطَأَ غُنْمَ الْحَيِّ مُرَّةُ بَعْدَ مَا","حَوَتْهُ إلَيْهِ كَفُّهُ وَالأنَامِلُ"],["A27978B8-4AFC-5207-ABE5-C8578B3CB53F","يَعَضُّ عَلَى أَطْرَافِهِ كَيْفَ زَوْلَهُ","وَدُونَ المَلاَ سَهْلٌ مِنْ الأرْضِ مَاثِلُ"],["8EFBA67A-74C4-5BCC-A0D6-D6E5FBD509F8","فَقُلْتُ لَهُ هَذِي بِتِلْكَ وَقَدْ يَرَى","لها ثمناً منْ نفسهِ ما يُزاولُ"],["7B367D7C-2E8F-565D-A971-3EBB88DC5B83","تولولُ سُعدى إنْ أتيتُ مجرَّحاً","إليها وقد منَّت عليَّ المقاتلُ"],["7F075707-3A9B-5F67-B1F2-88E2ED744731","وَكَائِنْ أَتَاهَا هَارِباً قَبْلَ هَذِهِ","ومَنْ غانمٍ أو أينَ منكَ الولاولُ"]]},"A9AEF806-894B-5541-ABF1-164532A719A4":{"t":"وشعبٍ كشلِّ الثوبِ شكسٍ طريقهُ","p":31,"s":"وشعب كشل الثوب شكس طريقه","r":"436336","v":[["A92623C4-83C0-5985-BBB1-4E5DED778ADF","وشعبٍ كشلِّ الثوبِ شكسٍ طريقهُ","مَجَامِعُ صَوْحَيْهِ نِطَاقٌ مُحَاصِرُ"],["A0DFFB73-BC59-5795-8AC0-7CDFE6AE1333","بِهِ مِنْ سُيُولِ الصَّيْفِ بِيضٌ أَقَرَّهَا","جُبارٌ لصمِّ الصَّخرِ فيه قراقرُ"],["8CBEF86D-577F-5873-88C5-8F278549007F","تبطَّنتُهُ بالقومِ لم يهدني لهُ","دَلِيلٌ وَلَمْ يُثْبِتْ لِيَ النَّعْتَ خَابِرُ"],["6B472F9D-6D0E-5CFF-A37E-71E966C478FF","به سملاتٌ من مياهٍ قديمةٍ","مَوَارِدُهَا مَا إنْ لَهُنَّ مَصَادِرُ"]]},"D4612DBB-532E-5F52-8126-C35F72E9FAFA":{"t":"وقالوا لها لاتُنكحيهِ فإنهُ","p":31,"s":"وقالوا لها لاتنكحيه فإنه","r":"436340","v":[["993923C6-2E8E-51FC-AEB2-FFCD3B238975","وقالوا لها لاتُنكحيهِ فإنهُ","لأوَّلِ نَصْلٍ أَنْ يُلاَقِيَ مَجْمَعا"],["FAF33BAD-8B8F-5EE3-8F11-E9450E3BCB25","فَلَمْ تَرَ مِنْ رَأْيٍ فَتِيلاً وَحَاذَرَتْ","تأيُّمها من لابسِ الَّليلِ أروَعا"],["2B3116B2-7DF9-5A0A-A1E1-5225C11E4FEE","قَلِيلُ غِرَارِ النَّوْمِ أَكْبَرُ هَمِّهِ","دمُ الثَّأر أو يَلقى كميّاً مسفَّعا"],["429AB1B2-BBFF-5FFA-AE3D-27176682E098","يُمَاصِعُهُ كُلٌّ يُشَجِّعُ قَوْمُهُ","وَمَا ضَرْبُهُ هَام العِدَا ليُشَجَّعَا"],["848EC1C0-5754-52ED-9869-F3534AEE9AB9","قليل ادِّخارِ الزَّاد إلاَّ تعلَّةً","فقد نشزَ الشُّرسوفُ والتصق المِعا"],["C7F7D680-12F1-5D71-AF80-A43447B640E6","يبيتُ بمغنى الوحوشِ حتَّى ألفنهُ","وَيُصْبِحُ لاَ يَحْمِي لَهَا الدَّهْرَ مَرْتَعَا"],["01FC6D23-7622-5966-8EDE-4963CBEEC69F","على غرةٍ أو نهزةٍ من مكانسٍ","أطالَ نِزالَ القومِ حتّى تسعسَعا"],["932BD262-8BA8-513A-B6B4-284985FE1F46","وَمَنْ يُغْرَ بِالأعْدَاءِ لا بُدَّ أنَّهُ","سَيَلْقَى بِهِمْ مَنْ مَصْرَعِ الْمَوْتِ مَصْرَعَا"],["859485BD-860C-5E7C-9610-C056EF21420D","رَأَيْنَ فَتىً لاَ صَيْدُ وَحْشٍ يُهِمُّهُ","فَلَو صَافَحَتْ إنْساً لَصَافَحْنَهُ مَعَا"],["F78011CB-D470-5610-8185-05E0F45D2F1F","وَلَكِنَّ أَرْبَابَ الْمَخَاضِ يَشُفُّهُمْ","إذَا اقْتَفَرُوهُ وَاحِداً أوْ مُشَيَّعَا"],["B2DE889E-9263-5802-970E-17D92EDFAFB2","وإنِّ وَإنّي عُمِّرْتُ أَعْلَمُ أَنَّنِي","سَأَلْقَى سِنَانَ الْمَوْتِ يَبْرُقُ أَصْلَعَ"],["79568966-AA5F-5CBC-A5EE-2FAA59B4F5DF","وَكُنْتُ أَظُنُّ المَوْتَ في الحَيِّ أَوْأُرَى","ألذَّ وأُكرى أو أموتَ مقنَّقا"],["D4E8CEDB-D3A7-5481-80AE-08BD24384910","ولستُ أبيتُ الدَّهرَ إلاّ على فتى","أسلِّبهُ أو أُذعرُ السربَ أجمَعَا"]]},"3FEA95B7-9D55-55FB-B358-F4C04C0232D0":{"t":"وكادت وبيتِ اللهِ أطنابُ ثاتبٍ","p":31,"s":"وكادت وبيت الله أطناب ثاتب","r":"436332","v":[["ED30A463-F08A-56DE-BF13-4AE383FCB47A","وكادت وبيتِ اللهِ أطنابُ ثاتبٍ","تَقَوَّضُ عَنْ لَيْلَى وَتَبْكِي النَّوَائِحُ"],["5FE6BB22-E020-537B-95A5-B27C73500291","تَمَنَّى فَتىً مِنَّا فَلاَقَى ولَمْ يَكَدْ","غلاماً نمته المُحصَناتُ الصَّرائحُ"],["7152CDCA-6F8A-5147-84ED-20E4111310B2","غُلاَمٌ نَمَى فَوْقَ الْخُمَاسِيِّ قَدْرُهُ","وَدُوْنَ الَّذِي قَدْ تَرْتَجِيهِ النَّوَاكِحُ"],["4A74B131-3493-552A-8690-2137DDB2A301","فإن تكُ نالتهُ خطا طيفُ كفِّه","بِأَبْيَضَ قَصَّالٍ نَمَى وَهْوَ فَادِحُ"],["91123776-0EA3-59B1-9DFA-C5520650898B","فَقَدْ شَدَّ في إِحْدَى يَدَيْهِ كِنَانَةً","تَدَاوَى لَهَا في أَسْوَدِ الْقَلْبِ قَادِحُ"]]},"242721DF-A15D-5D09-860F-40373A7CACAA":{"t":"ولا حوقلَ خطَّارةً حولَ بيتِهِ","p":31,"s":"ولا حوقل خطارة حول بيته","r":"436364","v":[["9BB8E06B-E881-5B87-88AD-EFD6885E0751","ولا حوقلَ خطَّارةً حولَ بيتِهِ","إذا العِرشُ آوى بيتُها كُلَّ خوتلِ"]]},"1A165F4D-68C2-5FB0-AF54-A281FE73CABD":{"t":"ولستُ براعي ثلَّةٍ قامَ وسطها","p":31,"s":"ولست براعي ثلة قام وسطها","r":"436367","v":[["BDA6C44F-50AB-5BA9-8C5F-6621A6E1A10B","ولستُ براعي ثلَّةٍ قامَ وسطها","طويلِ العصا غُرنيقِ ضَحلٍ مُرَسِّلِ"]]},"8090A465-252B-5DF7-B8BB-FF5073BF7F99":{"t":"ولستُ براعي صِرمةٍ كانَ عبدُها","p":31,"s":"ولست براعي صرمة كان عبدها","r":"436369","v":[["2E7C9A90-4238-5E3C-A77C-691939D64C1C","ولستُ براعي صِرمةٍ كانَ عبدُها","طويلَ العصا مئناثةَ الصَّقبِ مِهبلِ"]]},"944228CB-FA22-5F58-97D7-D20A1502F669":{"t":"ولقد سريتُ على الظَّلام بمغشمٍ","p":31,"s":"ولقد سريت على الظلام بمغشم","r":"436368","v":[["872E9949-813F-5957-BD98-62318B8C8D77","ولقد سريتُ على الظَّلام بمغشمٍ","جلدٍ من الفتيانِ غيرِ مُهبَّل"],["2A46D8AD-7C76-5DD8-AD76-5A3074C20BBD","مِمَّنْ حَمَلْنَ بِهِ وَهُنَّ عَوَاقِدٌ","حُبك النِّطاق فعاشَ غيرَ مثقلِ"],["F6B80A07-2E4E-5573-8B4E-D8D7A6239B89","حَمَلَتْ بِهِ في لَيْلَةٍ مَزْؤُودَةً","كرهاً وعقدُ نطاقها لم يُحلَّلِ"],["B3715BB2-1B79-5209-BD4F-B019454E8BF0","فأتت به حُوشَ الجنانِ مبطَّناً","سُهُداً إذَا مَا نَامَ لَيْلُ الهَوْجَلِ"],["6ACFBE31-47B5-5E05-A117-4452888BCB4B","وَمُبَرَّأً مِنْ كُلِّ غُبَّرِ حَيْضَةٍ","ورضاعِ مُغيلةٍ وداءٍ معضلِ"],["460802BA-2736-546F-84B6-1BE3CC850EE7","فإذا نظرتَ إلى أسرّة وجهه","بَرَقَتْ كَبَرْقِ الْعَارِضِ المُتَهَلِّلِ"],["13DC4804-BE78-5F0A-8582-9587F8923317","وَإذَا قَذَفْتَ لَهُ الْحَصَاةَ رَأَيْتَهُ","يَنْزُو لِوَقْعَتِهَا طُمُورَ الأخْيَلِ"],["944E7AF8-E8B2-5472-8A75-4524F2BBE16E","وإذا رميتَ به الفجاجَ رأيته","يهوى مخارمها هويّ الأجدلِ"],["312FE347-1311-5A77-82F8-826966ECC22E","وَإذَا يَهْبُّ من الْمَنَامِ رَأَيْتَهُ","كَرُتُوبِ كَعْبِ السَّاقِ لَيْسَ بِزُمَّلِ"],["49867911-ACC9-5D8B-92C0-BA5295DC355F","مَا إنْ يَمَسّ الأَرْضَ إلاَّ مَنْكِبٌ","مِنْهُ وَحَرْفُ السَّاقِ طَيَّ المِحْمَلِ"],["14CDE5C0-9FA0-5E05-A0EC-773A9E680D7C","يُعطي الصِّحابَ إذا تكونُ كريهةٌ","وَإذَا هُمُ نَزعلُوا فَمَأْوَى الْعُيَّلِ"],["19FBFE9C-B6C0-5E55-AC2A-A34FCB141EF3","فَإذَا وَذَلِكَ لَيْسَ إلاَّ ذِكْرُهُ","وَإذَا مَضَى شَيْءٌ كَأَنْ لمْ يُفْعَلِ"]]},"7D638B62-3786-5F1B-8D82-A4FDA2E0430C":{"t":"وما وَلدت أمِّي منَ القومِ عاجزاً","p":31,"s":"وما ولدت أمي من القوم عاجزا","r":"436329","v":[["AB089BC6-88B8-5A60-9978-58DBE5BDBEE0","وما وَلدت أمِّي منَ القومِ عاجزاً","وَلاَ كَانَ رِيشِي مِنْ ذُنَابِى وَلاَ لَغْبِ"]]},"4B804CAB-C90C-5073-AA7A-E209A4CA1492":{"t":"ونارٍ قد حضأتُ بُعيدَ وهنٍ","p":31,"s":"ونار قد حضأت بعيد وهن","r":"436376","v":[["B212DDCB-EDA3-57C1-84DF-EC10CF190232","ونارٍ قد حضأتُ بُعيدَ وهنٍ","بدارٍ ما أريدُ بها مُقامَا"],["485C950E-2D72-5EDA-B08E-C10C796DC04A","سوى تحليلِ راحلةٍ وعيرٍ","أكالئُهُ مخافةَ أن ينامَا"]]},"8DE67D74-12C8-5B45-B8F5-3EFFBBBA4299":{"t":"ونعلٍ كأشلاءِ السُّمَاني نبذتُها","p":31,"s":"ونعل كأشلاء السماني نبذتها","r":"436372","v":[["FEFDF3F2-A292-50AE-8DAE-EB90301EA4DF","ونعلٍ كأشلاءِ السُّمَاني نبذتُها","إلى صَاحِبٍ حافٍ وَقُلْتُ لَهُ انْعَلِ"]]},"4DAD08BC-A9EE-58F2-80B4-BDFE39FFA282":{"t":"ويوماً على أهلِ المواشي وتارةً","p":31,"s":"ويوما على أهل المواشي وتارة","r":"436373","v":[["33887A57-A02F-5979-9F60-C16DB1AC05BC","ويوماً على أهلِ المواشي وتارةً","لأهْلِ رَكِيبٍ ذِي ثَمِيلٍ وَسُنْبُلِ"]]},"02A76AF2-F704-5149-8834-44C68BABD1D6":{"t":"وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","p":31,"s":"واذهب صريم كي نحلن بعدها","r":"436323","v":[["E1B19D45-E049-5C23-AE62-0425F112E7D8","وَاذْهَبْ صُرَيْمُ كَيْ نَحُلَّنْ بَعْدَهَا","صَغْوَا وَحُلَّنْ بِالْجَمِيعِ الْحَوْشَبَا"]]},"550C42B0-9D71-5151-9234-FADC2080BC68":{"t":"وَحَرَّمْتُ النِّسَاءَ وَإنْ أُحِلَّتْ","p":31,"s":"وحرمت النساء وإن أحلت","r":"436327","v":[["4F18AC92-289B-5FA9-976E-39B2383FB9FB","وَحَرَّمْتُ النِّسَاءَ وَإنْ أُحِلَّتْ","بشورٍ أو بمزجٍ أو لصَاب"],["FFB24CC0-21B9-5FF4-85B1-6AA1A1709004","حَيَاتِي أوْ أزُورَ بَنِي عُتَيْرٍ","وكاهلها بجمعٍ ذي ضبابِ"],["B7788E73-4365-59D4-AD55-8FE9F3892E97","إذَا وَقَعْتُ لِكَعْبٍ أوْ خُثْيم","وسيَّارٍ يسوغُ لها شرابي"],["631AB17E-7BB1-575B-B847-6848DBD9D16E","أظُنّي ميِّتاً كمَداً ولمَّا","أطالعُ طلعة أهل الكرابِ"],["89841476-6E73-5B2B-9FD2-43A3B71B0F23","وَدُمْتُ مُسَيَّراً أَهْدِي رَعِيلاً","أؤُمُّ سوادَ طودٍ ذي نقابِ"]]},"43D5BC35-875A-539C-B6D9-BD98054EEB4E":{"t":"وَقِرْبَةِ أقْوامٍ جَعَلْتُ عِصامَها","p":31,"s":"وقربة أقوام جعلت عصامها","r":"436363","v":[["40D4A06F-4503-5E4C-96DB-738F4D11236F","وَقِرْبَةِ أقْوامٍ جَعَلْتُ عِصامَها","على كاهِلٍ مني ذَلُولٍ مُرَحَّلِ"],["92EA62C9-32D9-5DD8-9AD8-14421EBCCB3F","وَوادٍ كجَوْفِ العَيرِ قَفْرٍ قطعتُهُ","بهِ الذئبُ يَعوي كالخَليعِ المُعَيَّلِ"],["5DD71531-1CC1-5629-B4B6-D14A7B21B8FB","فَقُلتُ لَهُ لما عَوى: إنّ شَأنَنا","قليلُ الغنى إنْ كنتَ لمَّا تموِّلِ"],["D1BBACFE-FF7A-5759-91CA-E7ED963023C9","كِلانا إذا ما نالَ شَيْئاً أفاتَهُ","وَمن يحترِث حَرْثي وَحرْثَك يهزُلِ"]]},"B76512AA-696F-531B-A300-B1CAC4D016BF":{"t":"وَلا أتَمَنَّى الشَّرَّ والشَّرُّ تَارِكِي","p":31,"s":"ولا أتمنى الشر والشر تاركي","r":"436328","v":[["802F3EEE-73F6-5847-B67A-5A35A12D737C","وَلا أتَمَنَّى الشَّرَّ والشَّرُّ تَارِكِي","ولكن متى أُحمل على الشَّرِّ أركبِ"],["BE9E85F9-CB75-5887-A5B7-5A6D8776F978","ولستُ بمفراح إذا الدَّهرُ سرَّني","وَلاَ جَازِعٍ مِنْ صَرْفِهِ المُتَقَلِّبِ"]]},"D5907497-8A7D-5B90-8BB3-6E3C7C0F5929":{"t":"وَلاَ خَرِعٍ خَيْعَابَةٍ ذِي غَوائِلٍ","p":31,"s":"ولا خرع خيعابة ذي غوائل","r":"436365","v":[["F49F8835-78DF-5017-9D1B-72237FB72289","وَلاَ خَرِعٍ خَيْعَابَةٍ ذِي غَوائِلٍ","هَيامٍ كَجَفْرِ الأبْطَحِ الْمُتَهَيِّلِ"]]},"4AD67229-1A09-549F-894D-B7E533161472":{"t":"وَلَسْتُ بِتِرْعِيٍّ طَوِيلٍ عَشَاؤُهُ","p":31,"s":"ولست بترعي طويل عشاؤه","r":"436353","v":[["F14AB682-4126-5519-9F06-42ECF2F3B104","وَلَسْتُ بِتِرْعِيٍّ طَوِيلٍ عَشَاؤُهُ","يؤنِّفُها مستأنفَ النَّبتِ مبهلُ"]]},"6CDEBF88-4611-513E-AF6A-013456FAE97A":{"t":"وَلَسْتُ بِجِلْبٍ جِلْبِ لَيْلٍ وَقِرَّةٍ","p":31,"s":"ولست بجلب جلب ليل وقرة","r":"436366","v":[["756E94B3-92E5-5026-B120-C32D5653251C","وَلَسْتُ بِجِلْبٍ جِلْبِ لَيْلٍ وَقِرَّةٍ","ولا بصفاً صلدٍ عنِ الخيرِ معزلِ"]]},"214E55D0-BAD1-5584-AE92-73E531DFCE76":{"t":"وَلَقَدْ عَلِمْتُ لَتَعْدُوَنّ","p":31,"s":"ولقد علمت لتعدون","r":"436346","v":[["8EE18304-CF27-5CAF-A4E3-D4E760A0F522","وَلَقَدْ عَلِمْتُ لَتَعْدُوَنّ","عَلَيَّ شِيمٌ كَالْحَسَاكِلْ"],["33BEB4BC-FBF4-5774-8A88-A2A89858D5A3","يَأْكُلْنَ أَوْصَالاً وَلَحْـ","ـماً كَالشَّكَاعِي غَيْرَ جَاذِلْ"],["94E9EED2-0187-5190-A807-0850B4AB5718","يَا طَيْرُ كُلْنَ فَإنَّنِي","سُمٌّ لكُنَّ وذو دَغاولْ"]]},"57B109BA-F8D6-51EF-8D2F-DAD8262AFD8D":{"t":"وَلَكِنَّنِي أَرْوِي مِنَ الْخَمْرِ هَامَتِي","p":31,"s":"ولكنني أروي من الخمر هامتي","r":"436370","v":[["81A42152-4157-5AF1-9500-D8310B789875","وَلَكِنَّنِي أَرْوِي مِنَ الْخَمْرِ هَامَتِي","وأنضُو المَلاَ بالشَّاحبِ المُتشلشلِ"]]},"8B91D4CF-0A2F-50FC-8D19-FB744AEC876C":{"t":"وَمَرْقَبَةٍ يَا أُمَّ عَمْروٍ طِمِرَّةٍ","p":31,"s":"ومرقبة يا أم عمرو طمرة","r":"436371","v":[["61AB9EA0-C175-57E8-B0AE-4A2724709C2F","وَمَرْقَبَةٍ يَا أُمَّ عَمْروٍ طِمِرَّةٍ","مَذَبْذَبَةٍ فَوْقَ المُرَاقِبِ عَيْطَلِ"],["8ED8123C-B2E2-5746-90D2-98FD4C01C210","نهضتُ إليها منْ جُثُومٍ كأنَّها","عَجُوزٌ علَيْهَا هِدْملٌ ذاتُ خَيْعَلِ"]]},"FA51605C-2266-5AF8-BE44-DE4130FB561D":{"t":"يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","p":31,"s":"يا عيد ما لك من شوق وإيراق","r":"436344","v":[["4FE058FF-D3D7-5D52-96A3-411E8CB9ACAC","يَا عيدُ مَا لَكَ مِنْ شَوْقٍ وَإيِراقِ","وَمَرِّ طَيْفٍ عَلَى الأَهْوَالِ طَرَّاقِ"],["ECCA8B51-8EEB-58D3-9F0E-2C663656C316","يسرِي على الأينِ والحيَّات مُحتفيا","نفسي فداؤكَ من سارٍ على ساقِ"],["42F2EB4B-43FA-5DEB-99E0-76F11508BF41","إنِّي إذَا خُلَّةٌ ضَنَّتْ بِنَائِلِها","وَأَمْسَكَتْ بِضَعِيفِ الْوَصْلِ أَحْذَاقِ"],["38DB79E9-A019-5277-8E33-B36D1969FCE5","نَجَوْتُ مِنْهَا نَجَائِي مِنْ بَجِيلةَ إذْ","أَلْقَيْتُ لَيْلَةَ خَبْتِ الرَّهْطِ أَرْوَاقِي"],["5A5A1EC6-0B87-5B9A-ADEE-5558F9E3C17F","لَيْلَةَ صَاحُوا وَأَغْرَوْا بِي سِرَاعَهُمُ","بِالْعَيْكَتَيْنِ لَدَى مَعْدَى ابنِ بَرَّاقِ"],["CACA00BA-73B5-5485-A998-5D2D8B4B0419","كَأَنَّمَا حَثْحثُوا حُصّاً قَوَادِمُهُ","أو أمَّ خشفٍ بذي شثِّ وطُبَّاقِ"],["4A4C800A-1FA0-53D1-A89D-F675DA6DAFBC","لا شيءَ أسرعُ منِّي ليسَ ذا عُذَرٍ","وذا جناحٍ بجنبِ الرَّيدِ خفَّاقِ"],["A4C77C9C-2814-5F93-987E-D65F9F4211F9","حتى نجوتُ ولمَّا ينزِعوا سَلَبي","بوالهٍ من قَبيضِ الشَّدِّ غيداقِ"],["7915C55F-8670-5DF9-A0C6-6306E86E0985","ولا أقولُ إذا ما خُلٌّة صَرَمت","يا ويحَ نفسِي من شوقٍ وإشفاق"],["4D1DB6F7-945C-5CC5-A06D-83FF46F96D7D","لكنَّما عوَيلي إن كنتُ ذا عولٍ","على بصيرٍ بكسبِ الحمدِ سبَّاقِ"],["0AF1EC31-73F8-583F-AFB0-C7CB00BA492C","سَبَّاقِ غَايَاتِ مَجْدٍ في عَشِيرَتِهِ","مُرجِّع الصَّوتِ هدّاً بينَ أرفاقِ"],["28A21F1D-1D6B-56CA-B005-19E376196FE9","عَارِي الظَّنَابِيبِ مُمْتدٍّ نَوَاشِرُهُ","مِدْلاَجِ أَدْهَمَ وَاهِي الْمَاءِ غَسَّاقِ"],["D5AA2161-24D8-5D99-94DE-D596554220F6","حَمَّالِ أَلْوِيَةٍ شَهَّادِ أَنْدِيَةٍ","قوَّالِ مُحكمةٍ جوَّابِ آفاقِ"],["27584C85-E66A-5C4A-8991-E7D5AA4DA775","فذاك همِّي وغزوي أستغيثُ بهِ","إذَا اسْتَغَثتَ بِضَافِي الرَّأْسِ نَغَّاقِ"],["70BE58B1-A63C-5C21-ACAC-1C4133AEE620","كَالْحِقْفِ حَدَّأَهُ النَّامُونَ قلتُ لَهُ","ذُو ثَلَّتَيْنِ وَذُو بَهْمٍ وَأَرْبَاقِ"],["107BE8C1-3480-5926-A46C-C6D2D5EF488C","وقلَّةٍ كسنان الرُّمح بارزةٍ","ضَحْيَانَةٍ فِي شُهُورِ الصَّيْفِ مِحْرَاقِ"],["C977F11F-1E08-5620-B123-1D1D1EA1C9B7","بادرتُ قنَّتها صحبي وما كسِلوا","حَتَّى نَمَيْتُ إلَيْهَا بَعْدَ إشْرَاقِ"],["2871E520-07B6-5EC4-8C81-6A5CFCEC683E","لا شيء في ريدها إلاَّ نعَامتُها","مِنْهَا هَزِيمٌ وَمِنْهَا قَائِمٌ بَاقِ"],["F72D2336-F715-59C2-A163-4B84A30AA11C","بشرثةٍ خلقٍ يوقى البنانُ بها","شددتُ فيها سَريحاً بعد إطراقِ"],["82C58737-523D-59CF-89AE-71E58F31F3D5","بل من لعذَّالةٍ خذَّالةٍ أشِبٍ","حرّق باللّوم جِلدي أيَّ تحراقِ"],["A042667C-D1EE-555A-8E8D-CD69FCAC4308","يقولُ أهلكتَ مالاً لو قنعتَ بهِ","من ثوبِ صدقٍ ومن بزٍّ وأعلاقِ"],["5E98DCD5-2E66-55C4-8E92-1AB261422686","عاذلتي إنّ بعضَ اللَّوم معنفةٌ","وَهَلْ مَتَاعٌ وَإنْ أَبْقَيْتُهُ بَاقِ"],["1A83932F-0ACF-5D88-A998-22F18E46A5A4","إنِّي زعيمٌ لئن لم تتركوا عذلي","أَنْ يَسْأَلَ الْحَيُّ عَنِّي أَهْلَ آفَاقِ"],["27192C31-4E73-51D5-B3E3-17353419FB22","أَنْ يَسْأَلَ الْقَوْمُ عَنِّي أَهْلَ مَعْرِفَةٍ","فَلاَ يُخَبِّرُهُمْ عَنْ ثَابِتٍ لاَقِ"],["B9329F85-28FE-5476-807E-9ADB0B511E87","سدِّد خلالكَ من مالٍ تُجمّعهُ","حَتَّى تُلاَقِي الَّذي كُلُّ امْرِىءٍ لاَقِ"],["40957039-E9CB-51F3-B9B8-4B81D89C91E3","لتقرعنَّ عليَّ السِّنَّ من ندمٍ","إذا تذكَّرتَ يوماً بعضَ أخلاقي"]]}}}