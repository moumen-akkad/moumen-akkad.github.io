{"v":1,"poems":{"7378076E-915D-5A16-9D7B-F3FC2B7975B7":{"t":"المقدمة","p":204,"s":"أسهل المسالك في مذهب الإمام مالك/المقدمة","r":"493179","v":[["A767E8BD-F158-5E4D-A60F-F1B307CF23F3","الْحَمْدُ للهِ الَّذِي قَدْ فَرَضَا","عَلَى الْوَرَى تَوْحِيدَهُ وَحَرَّضَا"],["353553A8-795F-5B46-9AF6-F197522AAD98","عَلَى امْتِثَالِ أَمْرِهِ عِبَادَهْ","وَخَصَّ بِالتَّوْفِيقِ مَنْ أَرَادَهْ"],["06AA2BD3-ECA3-5D42-9329-B96C3B43B968","ثُمَّ الصَّلَاةُ وَالسَّلَامُ تَتْرَى","عَلَى نَبِيٍّ جَاءَنَا بِالْبُشْرَى"],["09E7E2C9-8A98-5AA7-AC70-865E5832A939","مُحَمَّدٍ خَيْرِ نَبِيٍّ أُرْسِلَا","لِلْعَالَمِينَ رَحْمَةً تَفَضُّلَا"],["0346FD99-ADB3-5763-8959-34539C565F48","وَالْآلِ وَالصَّحْبِ وَأَتْبَاعِ الْهُدَى","بِعَدِّ مَعْلُومَاتِ رَبِّي أَبَدَا"],["7824A6C2-3E46-5015-85F1-9DEC739F90A3","(وَبَعْدُ): إِنَّ الْعِلْمَ فَرْضٌ لَزِمَا","كُلَّ امْرِئٍ مُكَلَّفٍ أَنْ يَعْلَمَا"],["F0F40311-89EC-55AC-89F1-3E515210E40D","مَا أَوْجَبَ اللهُ مِنَ الْأَحْكَامِ","عَلَيْهِ فِي شَرَائِعِ الْإِسْلَامِ"],["ED51B684-FEA1-55E3-A394-B4A729139ECC","وَإِنَّ خَيْرَ مَا اعْتَنَى وَشَمَّرَا","لَهُ الْفَتَى: مَا فِيهِ نَفْعٌ لِلْوَرَى"],["B0C5A13B-845A-5939-9DE7-DA1BB9E58BFE","وَقَدْ رَأَيْتُ حَاوِيًا مُخْتَصَرَا","مُهَذَّبًا لِلْمُبْتَدِي مُيَسَّرَا"],["F45837DA-5283-575D-8955-47C327FD7589","لِلْفَاضِلِ السُّهَائِيِ ابْرَاهِيمَا","حَبَاهُ مَوْلَاهُ الرِّضَا الْمُقِيمَا"],["633915C4-0A80-504E-9D5C-33B6BC50334C","يُدْعَى: بِتَرْغِيبِ الْمُرِيدِ السَّالِكِ","فِي مَذْهَبِ الْحَبْرِ الْإِمَامِ مَالِكِ"],["AC63ED23-B8CF-57F3-B300-9ECE4D004BD7","فَرُمْتُهُ نَظْمًا رَجَا أَنْ يَحْصُلَا","لِلْمُبْتَدِي نَفْعًا وَحِفْظًا يَسْهُلَا"],["6B0E212F-CB48-53B0-AF26-DA73711AA29A","وَرُبَّمَا قَدَّمْتُ أَوْ أَخَّرْتُ","أَوْ زِدْتُ أَحْكَامًا بِهَا تَمَّمْتُ"],["CF129E46-BA37-59A0-966A-3B0A3B022E44","سَمَّيْتُهُ: بِأَسْهَلِ الْمَسَالِكِ","لِنَظْمِ تَرْغِيبِ الْمُرِيدِ السَّالِكِ"],["48D784C3-767B-5A64-B929-9A6EA537B78E","وَأَسْأَلُ اللهَ بِجَاهِ أَحْمَدِ","وَآلِهِ الْغُرِّ بُلُوغَ مَقْصِدِي"],["A5A6686F-FA85-5D09-A15E-7277DA92F8A5","وَأَنْ يَكُونَ خَالِصًا لِذَاتِهِ","وَمُوجِبًا لِلْفَوْزِ مَعْ مَرْضَاتِهِ"],["3F6FA822-C252-5F85-8759-4B819AFD81B4","ونافعا لمن حواه أو قرا","أو من وعى أو من سعى أو أمرا"],["A634E1FC-6A95-51EB-BA5D-3DD218469DC4","وعصمة من كل زيغ وزلل","فإنه حسبي عليه المتكل"]]},"37B92B07-2181-56BC-8AE3-7FC983CF47C1":{"t":"باب أصول الدين وما يجب على المكلف","p":204,"s":"أسهل المسالك في مذهب الإمام مالك/باب أصول الدين وما يجب على المكلف","r":"493185","v":[["64549311-DB79-59B2-848B-08C17B508CC8","أول واجب على المكلف","معرفة الله يقينا فاعرف"],["718E8169-E2D9-5F60-8689-B55AC449E53B","وإنما العالم طرا حادث","والله موجود قديم وارث"],["4B1AD278-71BD-552F-A69D-A7AA1633E2EE","وقائم بنفسه وذو غنا","مخالف لخلقه له الثنا"],["AED7FBE8-41F4-5167-8173-A3D1F1469175","وواحد في ذاته وفي الصفة","ليس كمثل الله شيء فاعرفه"],["EE99E467-0BFC-5C04-AC54-4090FA57A9D6","له: كلام قدرة سمع بصر","إرادة علم حياة جا الخبر"],["5B478542-E570-50CD-9F91-2237A6D74CF2","وكونه حيا مريدا قادرا","ومتكلما سميعا مبصرا"],["FDF9E692-E411-5D63-AD68-52950EBB161D","وعالما جل عن التمثيل","والطبع والتعليل والتعطيل"],["6B27B230-CD62-5EC0-9348-45F445E10085","واللون والطعم وجسم أو عرض","وما على الله أمور تفترض"],["CF9545C5-6E68-552B-AACC-D58BD60371EF","وكل ما جاء بلفظ يوهم","أوله أو قل فيه: ربي أعلم"],["37F34494-87AA-5701-AA2C-61C180B0301E","والقدر -اعلم- خيره وشره","بأمره وحلوه ومره"],["1E5FA91B-226B-5CA5-9869-500932609B36","ما شاء كائن وإلا لم يكن","إذا قضى أمرا يقول: كن يكن"],["1443A465-FF3B-5CEB-AB35-8FACE177B8CF","ويغفر الذنب سوى الشرك لمن","يشاء والتوبة فرض؛ فالزمن"],["6E0DE157-3D7F-554F-A2AF-CEAAD817362B","وشرطها: عن ذنبه أن يقلعا","من فوره والعزم أن لا يرجعا"],["7C729B43-6B63-5022-A358-51F1280F0C00","ورد ظلم ممكن والندم","وباجتناب الإثم يمحى اللمم"],["AA84E9E1-7F52-586F-AE1B-A5E5490049B6","ومن يمت ولم يتب عن وزره","فوض إلى الله جميع أمره"],["6ED1646B-BDFB-5134-8023-7FE496C54255","لا بالعذاب للمسيء يقطع","والكفر والتخليد عنه يمنع"],["193A6E4D-52C0-5E59-B937-1FFCA8E78544","وذو ابتداع واعتزال فسقا","من غير تكفير سوى نافي اللقا"],["95BBC8F2-9FD1-5232-B980-866336B124EF","أو قال بالكلي: ربي علما","من دون جزئياته أو جسما"],["74076EED-3E51-5F47-975B-02C0794FE870","وكل مقتول يموت بالأجل","والروح يبقى دائما مدى الأزل"],["B77E537B-7B79-5440-9A3D-74A71A6363A4","وعندنا للعبد كسب يخلق","ثم شهيد الحرب حي يرزق"],["3768598E-6A9B-5AF4-ABB4-4108ED23DB03","وكل أفعال العباد تكتب","للعدل لا عن علم ربي تعزب"],["750A88DD-B573-5301-8F82-94917F924B99","والرزق حقا: ما به ينتفع","حلال او مكروه او ممتنع"],["1195F7A0-4A52-5AA3-804A-262BFB08301D","واثبت لكل الأنبيا الأمانة","والصدق والتبليغ والفطانة"],["F8A3F188-76CB-580C-9FA9-89B209E382CA","وكلهم بالمعجزات أيدوا","وخيرهم: ختامهم محمد"],["AA22B62F-8A06-5903-BE90-DCF960D0AF0F","قد خص بالرؤية والمعراج","بالروح والجسم وبالتناجي"],["EB4A4CD4-DBE3-55FD-959F-9F6972572BF5","وباللوا والحوض والوسيلة","وبالشفاعات وبالفضيلة"],["7352D666-332C-59FC-B480-CA15F4906653","وكل ما قد جاءنا عن النبي","من ملك أو أنبيا أو كتب"],["D97784F7-2D53-54C5-8D02-2A4CDAE57CE5","أو يومنا الآخر أو أمر السما","إيماننا غيبا به قد لزما"],["F52B6832-BA51-52FA-B481-8BFDEE3621B9","ومنه أشراط مجيء الساعة","كالشمس والمهدي وكالجساسة"],["C773F170-6FFF-5411-88B7-F8778A458EE9","وغلق باب التوب عمن أثما","والرفع للقرآن والعلم كما"],["18670954-EAF8-5B67-BEAB-F84001F6DA35","ينزل عيسى يقتل الدجالا","وفتح يأجوج وخسف والى"],["B22315D4-115A-555C-B918-9EDB8C3921E3","نار تسوق الناس أرض الحشر","وفتنة المحيا وضم القبر"],["17B1CB09-9FB5-51A2-956D-8B63C36E9704","وبعذاب القبر والفتان","والحشر والنشر وبالميزان"],["69C1114D-3A1B-5CC8-9A82-69D705BFF3C0","والنفخ في الصور ونشر الصحف","وبالصراط ثم هول الموقف"],["51094D9A-0151-5CFD-8B67-48324ABA432D","والمؤمنون ينظرون الربا","في الحشر والجنة دار العقبى"],["1BCD17A1-1530-50F9-908F-79872F1D4077","ويشفع الأخيار من بعد النبي","في مؤمن موحد معذب"],["8BCC04B9-DA04-5D5D-8182-C3A24048441F","ورحمة الله تعالى عمت","كل امرئ إيمانه كالذرة"],["903DF9A6-CE4C-5189-A9D4-E7C7854A7CB0","والنار والجنة حقا خلقا","داري جزاء للنعيم والشقا"],["A8B022C5-29F9-5ECA-8078-32BA8259DB44","وأفضل الخلق جميعا: أحمد","صلى عليه الله نعم السيد"],["1E5848F0-6A5D-519E-89AD-1A4930DC98A0","وبعده: الخليل فالمكلم","فنوح فالروح أولو العزم هم"],["9C5FD930-FB72-5057-A1B2-2DCC9A07579C","فالرسل ثم الأنبيا ثم الملك","الخاص فالصديق ثم ذو النسك"],["C7577B52-E30B-5B56-8FF6-C4F99D71AE49","عمر عثمان يليهم حيدرة","ورتب الستة باقي العشرة"],["594AB4B1-8DDE-5F58-8C5D-2CCC0C50BBA4","فأهل بدر فأحد فالبيعة","فسائر الأصحاب ثم الأمة"],["D7D92C3D-D313-5718-AC14-8F985F3CA33F","وفي النساء: مريم فالزهرا","فإبنة الصديق بعد الكبرى"],["4CCE034A-BBB7-5430-95B6-455C9DCA0E90","وخير قرن: ما أتى فيه النبي","ثم ثلاث بعده وأقرب"],["10D9D845-3763-59D0-9E31-DF82CA3B5F74","وسائر الصحب عدول كمل","وما جرى من حربهم مؤول"],["B7B2611E-6846-566D-8056-48AAD4D6AFCD","و ((مالك)) و ((أحمد)) و ((الشافعي))","((أبو حنيفة)) الإمام التابعي"],["01D8D6CB-D4CD-5E74-AAC3-45015508F4DA","على هدى من ربهم و رحمة","والاختلاف نعمة للأمة"],["E3FFFBCC-2323-5F28-8B65-2C620FC9397E","و ((الأشعري)) قدوة مقدم","((جنيدنا)) طريقه مقوم"],["4995FDEA-C3E3-518F-8E14-2CD150A9422E","للأوليا كرامة لا تنكر","ثم الدعاء نفعه مؤثر"],["C6B3F829-EE55-5CA6-8A0F-EADD2C49A4E6","ولا نبي قط أنثى يجتبى","أو عبد او ذو عاهة قبل النبا"],["A4B9C6D3-49DF-55F4-95E2-15A21D4CB9B6","((لقمان)) و ((اسكندر)) ليسا أنبيا","في أرجح الأقوال، لكن أوليا"],["97A518F0-247D-58B0-A183-F2111D595794","والخلف في ((الخضر)) شهير منجل","أمرسل أو لا، وقيل: بل ولي"]]},"80AEF208-2BF1-5587-8E2A-30D42D2C00E0":{"t":"باب الأعيان الطاهرة والنجسة وما يجوز من التحلية","p":204,"s":"أسهل المسالك في مذهب الإمام مالك/باب الأعيان الطاهرة والنجسة وما يجوز من التحلية","r":"493187","v":[["D7F65DF3-A5EF-54BE-906F-113AE2309376","وَكُلُّ حَيٍّ طَاهِرٌ وَيَلْحَقُهْ:","لُعَابُهُ مُخَاطُهُ وَعَرَقُهْ"],["B92C2623-67DC-57EB-8533-ECBCC9F10B3B","صَفْرَاؤُهُ بَلْغَمُهُ دُمُوعُهُ","مَرَارَةُ الْمُبَاحِ أَوْ رَجِيعُهُ"],["55A2E59E-001A-5EA5-B970-28D178035115","إِنِ اغْتَذَى بِطَاهِرٍ وَاللَّبَنُ","مِنْ آدَمِيٍّ فِي حَيَاةٍ تُوقَنُ"],["6DE2B62E-FDD1-5F89-8298-11B6EBF7D476","وَسَائِرُ الْأَلْبَانِ كَاللُّحُومِ","فِي الْكُرْهِ وَالتَّحْلِيلِ وَالتَّحْرِيمِ"],["A36E6682-3041-5B68-A7B2-188434D9C3F4","وَبَيْضُ كُلِّ الْحَيِّ إِلَّا الْمَذِرَا","وَالْقَيْءُ عَنْ حَالِ الْغِذَا مَا غُيِّرَا"],["B17AC881-43B5-5999-89F2-BE5AB978554D","مِسْكٌ كَذَا فَأْرَتُهُ فَطَهِّرِ","ثُمَّ الْجَمَادَاتُ الَّتِي لَمْ تُسْكِرِ"],["6FEA0212-8F75-5490-B163-560A4E90C01F","دَمٌ بِلَا سَفْحٍ كَذَا أَجْزَاءُ مَا","ذُكِّي وَلَوْ بِالْكُرْهِ لَا مَا حُرِّمَا"],["3AE8DDB4-4827-51E2-9F6B-88DE62A9AF7F","وَمَيْتَةُ الْبَحْرِ وَمَا لَا دَمَ لَهْ","وَلَا وَزَغٌ وَشَحْمَةٌ وَسُحْلِيَةْ"],["63577ECA-8170-52DA-94AA-F3E5EF40BC10","وَزَغَبُ الرِّيشِ وَصُوفٌ وَوَبَرْ","إِنْ جُزَّ مِنْ حَيٍّ وَمَيْتٍ وَشَعَرْ"],["39374447-F40B-58B1-920E-D79C80CFA3BB","وَخَمْرَةٌ إِنْ خُلِّلَتْ أَوْ حُجِّرَتْ","وَالزَّرْعُ إِنْ يُسْقَى بِنَجْسٍ فَنَبَتْ"],["733F4D58-C052-5942-AB77-C8298AEA5C0E","فِي مَيْتَةِ الْإِنْسَانِ خُلْفٌ خَصَّصُوا","وَفِي الرَّمَادِ وَالدُّخَانِ رَخَّصُوا"],["DD79EE62-31B8-5BE6-AD50-D1E387F22808","وَأَرْجَحُ الْأَقْوَالِ بِالطَّهَارَةِ","فِي مَيْتَةِ الْإِنْسَانِ حَتَّى الْكَفْرَةِ"],["CA248A19-1963-5C9E-B533-F383EFBE9943","وَمَا مِنَ الْحَيِّ أَوِ الْمَيْتِ انْفَصَلْ","كَمَيْتَةِ الْحَيِّ الَّذِي مِنْهُ حَصَلْ"],["416C477B-E56F-53EE-A651-7147128A99BD","وَالنَّجَسُ الْمَيْتُ الَّذِي لَمْ يُذْكَرِ","وَكُلُّ مَا اسْتُثْنِي وَكُلُّ الْمُسْكِرِ"],["6D386212-29A1-5723-A98F-24ED3C0EE58F","وَفَضْلَةُ الْمَكْرُوهِ وَالْمُحَرَّمِ","وَمِثْلُ ذَا جَلَّالَةٌ وَالْآدَمِي"],["DCEFD002-09CB-530E-8D3C-0B14A8AE527D","سَوْدَا وَوَدْيٌّ أَوْ دَمٌ مَسْفُوحُ","مَذْيٌّ مَنِيٌّ أَوْ صَدِيدٌ قَيْحُ"],["B29B2FF8-9C58-5B44-BEF0-745FE9DEB0D6","تَمْلِيحُ زَيْتُونٍ كَزَيْتٍ مُزِجَا","بِالنَّجْسِ أَوْ بَيْضٌ كَلَحْمٍ نُضِّجَا"],["B08FD8F4-1D6C-5CE3-A1FE-4AD3E8B0F58D","كَفِي طَعَامٍ مَائِعٍ أَوْ سَارِ","فِي جَامِدٍ أَوْ غَاصَ فِي فُخَّارِ"],["AEAB746A-9B5F-5C9A-A6F5-977066B0ED5D","وَإِنْ يَكُنْ حَلَّ طَعَامًا جَامِدَا","كُلْ مَا بَدَا بِالطُّهْرِ وَاطْرَحْ مَا عَدَا"],["415DCE50-5087-57C5-AD1B-70EA8B1BE66F","وَانْفَعْ بِمَا نُجِّسَ غَيْرَ الْآدَمِي","وَمَسْجِدٍ وَالنَّجْسَ عَيْنًا حَرِّمِ"],["975A426F-1D1A-56BE-9B8D-0CF1B0275D4B","وَحَرَّمُوا اسْتِعَمَالَ نَقْدٍ كَالْإِنَا","وَلَوْ لِأُنْثَى وَاغْتِلَالًا وَاقْتِنَا"],["2C451B24-556E-5EE2-84A7-587AC88DD01D","وَحِلْيَةَ الرِّجَالِ بِالنَّقْدَيْنِ","لَا خَاتِمِ الْفِضَّةِ دِرْهَمَيْنِ"],["E63246D0-8F4B-5E47-A71E-1ACEC96C7E55","مُتَّحِدًا أَوْ مُصْحَفًا أَوْ سَيْفَا","وَرَبْطَ سِنٍّ مُطْلَقًا أَوْ أَنْفَا"],["67C73AAE-02D6-57FA-B36F-C4158BBA5352","وَحُرْمَةُ الْحَرِيرِ مِثْلُ الْقَزِّ","وَكَرِهُوا وَجَوَّزُوا فِي الْخَزِّ"],["7474329A-6557-5C78-8C12-F96DA3B4BB27","وَلِلنِّسَا إِبَاحَةُ الْحَرِيرِ","وَالنَّقْدِ لَا كَالْقُفْلِ وَالسَّرِير"]]},"EF3E3D0F-140C-5CA1-B9C9-7F2C800758C5":{"t":"باب فرائض الوضوء وسننه وفضائله","p":204,"s":"أسهل المسالك في مذهب الإمام مالك/باب فرائض الوضوء وسننه وفضائله","r":"493198","v":[["8F2CAD79-46A6-5F3F-8599-2D27A4DE8773","فَرَائِضُ الْوُضُوءِ سَبْعٌ عَدُّهَا","فَنِيَّةٌ وَ غَسْلُ وَجْهٍ بَعْدَهَا"],["8F5AE3CE-9ECD-5131-A19C-95D58A172559","وَ غَسْلُكَ الْيَدَيْنِ بِالْمَرَافِقِ","وَ مَسْحُ كُلِّ الرَّأْسِ بِالْمَفَارِقِ"],["52EEBC3B-19C1-5D37-B073-C7E5256E2D7F","وَ غَسْلُ رِجْلَيْكَ بِكَعْبَيْكَ اسْتَقَرْ","وَ الْفَوْرُ وَ الدَّلْكُ بِذِكْرٍ إِنْ قَدَرْ"],["0671304C-049B-50FC-9CDA-848AD46505C0","وَقُلْ ثَمَانٍ عِدَّةُ الْمَسْنُونِ:","فَابْدَأْ يَدَيْكَ الْغَسْلَ لِلْكُوعَيْنِ"],["D2B8A6C1-A7C2-5686-B59C-B5AC3E71D9B2","تَمَضْمَضَنْ وَ اسْتَنْشِقَنْ وَ اسْتَنْثِرِ","وَ رُدَّ مَسْحَ الرَّأْسِ مِنْ مُؤَخَّرِ"],["09953D6A-9EC6-5336-A899-AD443AFCE03B","وَ مَسْحَ وَجْهَيْ كُلِّ أُذْنٍ فَارْضَهُ","جَدِّدْ لِمَائِهْمَا وَ رَتِّبْ فَرْضَهُ."],["48FBFC96-54CC-572F-9A2D-CC5238DC1CE0","أما فَضَائِلْهُ فَعَشْرٌ تُذْكَرُ:","تَسْوِيكُهُ ثُمَّ الْمَكَانُ الطَّاهِرُ"],["5FB2DF9B-D503-550D-9BFD-19870C073BC0","وَالشَّفْعُ وَالتَّثْلِيثُ فِيمَا يُغْسَلُ","وَالْمَا مَعَ الْإِحْكَامِ كَالْغُسْلِ اقْلِلُوا"],["E646A415-87A4-5F35-85A6-A5181A9F2B10","وَلِلْإِنَا وَالْعُضْوِ يُمْنٌ وَالسُّنَنْ","فِي نَفْسِهَا أَوْ مَعْ فُرُوضٍ رَتِّبَنْ"],["0F0ACEC9-EB68-5A4E-8B33-E848BB7AFFE2","وَالْبَدْءُ بِالرَّأْسِ مِنَ الْمُقَدَّمِ","تَسْمِيَةٌ كَالْغُسْلِ وَالتَّيَمُّمِ"],["7B1F49B2-5454-57A0-BC42-34AC3D5D53E3","وَالْغَلْقِ وَالْإِطْفَاءِ وَالدُّخُولِ","وَاللُّبْسِ وَالضِّدِّ وَكَالْمَأْكُولِ"],["0B2676EF-792C-54C2-85B1-D38D4DB67B19","لَحْدٍ وَتَغْمِيضٍ صُعُودِ الْمِنْبَرِ","وَطْءٍ رُكُوبٍ صَيْدٍ اذْبَحْ وَانْحَر"],["CA94A058-D6B8-5738-A391-0F32409FDC15","أَمَّا (فَضَائِلْهُ) فَعَشْرٌ تُذْكَرُ:","تَسْوِيكُهُ ثُمَّ الْمَكَانُ الطَّاهِرُ"],["D3D3E879-355E-5379-A903-44D19AD07793","وَالشَّفْعُ وَالتَّثْلِيثُ فِيمَا يُغْسَلُ","وَالْمَا مَعَ الْإِحْكَامِ كَالْغُسْلِ اقْلِلُوا"],["8DB611AA-050B-5ECF-80B5-F3C3F5FC4D7A","وَلِلْإِنَا وَالْعُضْوِ يُمْنٌ وَالسُّنَنْ","فِي نَفْسِهَا أَوْ مَعْ فُرُوضٍ رَتِّبَنْ"],["4E1E9348-EEC2-5C81-8020-499F40C19C94","وَالْبَدْءُ بِالرَّأْسِ مِنَ الْمُقَدَّمِ","تَسْمِيَةٌ كَالْغُسْلِ وَالتَّيَمُّمِ"],["65CB0596-93E6-5E7A-B0DA-10B9ADEBB49F","وَالْغَلْقِ وَالْإِطْفَاءِ وَالدُّخُولِ","وَاللُّبْسِ وَالضِّدِّ وَكَالْمَأْكُولِ"],["10153059-CB31-5339-9A7B-CAEF7E70B794","لَحْدٍ وَتَغْمِيضٍ صُعُودِ الْمِنْبَرِ","وَطْءٍ رُكُوبٍ صَيْدٍ اذْبَحْ وَانْحَر"]]},"88750EA9-2CB6-55BC-AFFC-D31464F9E68A":{"t":"باب قضاء الحاجة","p":204,"s":"أسهل المسالك في مذهب الإمام مالك/باب قضاء الحاجة","r":"493202","v":[["099B05FA-DA98-55A2-853A-2FC5E36CE89E","فِي حَاجَةِ الْإِنْسَانِ فَاسْكُتْ وَاجْلِسِ","نَدْبًا وَبَوْلًا قِفْ بِرَخْوٍ نَجِسِ"],["15802D65-81E1-56B1-BEFC-3D060647CB69","وَالظِّلَّ وَالرِّيحَ وَجُحْرًا وَالصَّلِبْ","وَالطُّرْقَ وَالْمَوْرِدَ كُلًّا فَاجْتَنِبْ"],["8B88C006-8281-5EFF-83F8-7EB0DF3F4BB9","وَلَا تُقَابِلْ أَوْ تُدَابِرْ كَعْبَةْ","فِي الْمَنْزِلِ الْوَطْءَ أَجِزْ وَالْفَضْلَةْ"],["7D044D1A-22C6-54C5-A916-99C34F222FB2","وَنَحِّ ذِكْرَ اللهِ حَتْمًا فِي الْخَلَا","وَاسْتَحْسَنُوا سَتْرًا وَبُعْدًا فِي الْفَلَا"],["84D4BBB7-1D01-5F01-B850-9B41F775DD43","قُلْ قَبْلَهُ وَبَعْدَهُ ذِكْرًا وَرَدْ","وَلَمْ يَفُتْ قَبْلِيُّهُ إِنْ لَمْ يُعَدْ"],["ADF9AFE9-9AF0-5E24-965A-58CEC627A6BD","لَا تَلْتَفِتْ وَلِلْمُزِيلِ فَاسْتَعِدْ","وَرِجْلَكَ الْيُسْرَى عَلَيْهَا فَاعْتَمِدْ"],["0F341FB4-BE6C-5AA1-9100-BBEFC3489831","تَجُوزُ فَضْلَةٌ وَوَطْءٌ فِي الْفَضَا","بِسَاتِرٍ لِقِبْلَةٍ فِي الْمُرْتَضَى"],["D1670F23-DEC4-5E80-B5EC-C5DF53927E15","وَفِي سِوَاهُ فَالْجَوَازُ مُطْلَقَا","وَهَكَذَا أَفَادَهُ مَنْ حَقَّقَا"],["25B1E516-0B73-5738-BECF-368749082CEA","وَفَرِّجِ الْفَخْذَيْنِ بِاسْتِرْخَاءِ","مُسْتَجْمِرًا وِتْرًا وَعِنْدَ الْمَاءِ"],["7A84CE6D-5824-5E84-999F-CC05C8EB3184","يُقَدِّمُ الْإِحْلِيلَ قَبْلَ الدُّبُرِ","وَالْجَمْعُ بَيْنَ الْمَا وَ بَيْنَ الْحَجَرِ"],["52D95CBC-6BE7-5951-B63A-C646769A56A5","وَاخْرُجْ بِيُمْنَاكَ وَبِالْيُسْرَى ادْخُلِ","وَالْمَسْجِدَ اعْكِسْ يَمِّنَنْ بِالْمَنْزِلِ"],["60510B04-4941-5F0B-B890-73C0D9974B01","وَاسْتَنْقِ بِاسْتِفْرَاغِ مَا فِي الْمَخْرَجِ","وَاسْتَبْرِ بِالسَّلْتِ وَبِالنَّتْرِ النَّجِي"],["39893638-7F3B-535E-9A2B-65635931EC26","مُسْتَجْمِرًا بِطَاهِرٍ مُنْقٍ جَمَدْ","لَا نَقْدٍ او مَطْعُومٍ او مُؤْذٍ بِحَدْ"],["F99613E5-BE22-5332-BF19-1D4CC55B26BA","وَعَيَّنُوا لِلْمَاءِ فِي مَذِيِّ","أَوْ حَيْضٍ اوْ نِفَاسٍ اوْ مَنِيِّ"],["221C6EBE-289D-5E0E-A40D-5D9483D384E7","أَوْ بَوْلِ أُنْثَى أَوْ خَصِيٍّ أَوْ يُرَى","مُنْتَشِرًا عَنْ مَخْرَجٍ إِنْ كَثُرَا"]]},"C7399EBC-C106-5D90-9D7E-4D16B17CB4F4":{"t":"باب موجبات الغسل وفرائضه وسننه وفضائله","p":204,"s":"أسهل المسالك في مذهب الإمام مالك/باب موجبات الغسل وفرائضه وسننه وفضائله","r":"493205","v":[["F9272B8A-CBF1-5534-AE34-639EAD8B474C","وَمُوجِبَاتُ الْغُسْلِ عِنْدَ النَّاسِ","سِتٌّ: فَقَطْعُ الْحَيْضِ وَالنِّفَاسِ"],["C842ED2F-5D34-5CB4-8F82-6B0EA6F6E1A4","وَمِنْ مَنِيٍّ خَارِجٍ بِلَذَّةِ","مُعْتَادَةٍ فِي نَوْمٍ اوْ فِي يَقْظَةِ"],["195E63AD-E66C-59C0-98F4-D0D8FC492372","وَمِنْ مُغِيبِ حَشْفَةٍ فِي أَيِّ مَا","فَرْجٍ وَغَسْلُ الْمَيْتِ أَوْ مَنْ أَسْلَمَا"],["211E2F8F-7932-5DF6-A1D2-7C4CE729A7D5","فُروضُهُ خَمْسٌ: فَتَنْوِي غُسْلَكَا","وَعُمَّ كُلَّ الْجِسْمِ بِالْمَا وَادْلُكَا"],["CF6B584E-1C19-58A8-AC19-8C74EC0A239C","وَخَلِّلِ الشَّعْرَ وَوَالِ كَالْوُضُو","وَسُنَّ: الِاسْتِنْشَاقُ وَالتَّمَضْمُضُ"],["F54D9C17-4FEA-50C9-B8AF-0CB550701B85","وَغَسْلُكَ الْيَدَيْنِ لِلْكُوعَيْنِ","كَذَاكَ مَسْحُ صِمْخَيِ الْأُذْنَيْنِ"],["0DFD25DE-A5FD-5462-BB0A-6998C9D9C878","وَفَضْلُهُ: الْبَدْءُ بِغَسْلِ الْخَبَثِ","إِنْ كَانَ عَنْ جِسْمٍ وَرَأْسًا ثَلِّثِ"],["E9EA1758-B1DC-5009-924F-DA905F5783D2","وَغَسْلَ أَعْضَاءِ الْوُضُوءِ وَحِّدِ","وَبِالْيَمِينِ وَالْأَعَالِي فَابْتَد"]]},"9B7DDD51-DD36-5970-A95B-36117A6D1626":{"t":"باب نواقض الوضوء","p":204,"s":"أسهل المسالك في مذهب الإمام مالك/باب نواقض الوضوء","r":"493199","v":[["DE6D186D-DD81-5CFA-8D43-8CC2F9456BFF","يَنْقُضُهُ: الرِّدَّةُ أَوْ شَكٌّ حَدَثْ","فِي طُهْرٍ اوْ نَقْضٍ وَسَبْقٍ وَالْحَدَثْ"],["7A33BCE9-FAA4-5423-8714-C476032F2B44","بَوْلٌ وَرِيحٌ غَائِطٌ مَعَ الْوَدِي","وَاغْسِلْ جَمِيعَ الْفَرْجِ نَاوٍ لِلْمَذِي"],["4B19DDD7-A385-52E9-B0E7-45D64A1C6F0F","أَسْبَابُهُ: زَوَالُ عَقْلٍ إِمَّا","بِالْجِنِّ أَوْ بِالسُّكْرِ أَوْ بِالْإِغْمَا"],["895190E8-EE39-5B1D-9BC7-74B064CE7D09","نَوْمٌ طَوِيلٌ أَوْ قَصِيرٌ إِنْ ثَقُلْ","لَا خَفَّ مَعْ قِصَرْ وَنَدْبًا إِنْ يَطُلْ"],["EC0C9D2C-9236-5C24-9635-05B7193F724F","أَوْ لَمْسُ مَنْ تَهْوَى بِطَبْعٍ مُعْتَبَرْ","بِلَذَّةٍ مُعْتَادَةٍ وَلَوْ ذَكَرْ"],["5208A1CF-D1CA-563A-8A10-252DD90583FC","وَمَسُّ إِحْلِيلٍ وَمَسُّ الْكَفِّ","أَوْ أُصْبُعٍ وَامْرَأَةٍ بِالْخُلْف"]]}}}