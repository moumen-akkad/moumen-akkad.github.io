{"v":1,"poems":{"CD3CF6B7-914C-5E82-98A9-08E6733D66A4":{"t":"يُذكِّرني الحِمـى عهدَ الوصـالِ","p":152,"s":"يذكرني الحمـى عهد الوصـال","r":"457217","v":[["ECF27BA0-0BD6-5B8D-950A-E5EB3F6BC599","يُذكِّرني الحِمـى عهدَ الوصـالِ","وأيامَ الشبابِ ومَن بِهـا لـي؟"],["59CBB23E-3CEF-5040-B9DF-4CA28BA43D18","وسلمى والسّلامـةَ من هواهـا","ونعمـى والنعـيمَ بـلا زوالِ"],["5311F416-7F7F-5027-BBB1-41A1BA4DBBC2","وهَصري غُصـنَ ذابلةِ التثنِّي","وقطفي وردَ ناضرةِ الجمالِ"],["75CA58D9-CB56-5388-A292-B6FD48955567","ورَشفي حيـثُ يبتسمُ الأقاحي","وشمي حيثُ تنعجنُ الغوالي"],["D0F43FFC-85BD-596C-9BAC-3FB9F2153F63","وتَركي الزُّهـد في راحٍ شمولٍ","ورَفْضي النُسكَ في ريحٍ شمالِ"],["843FB662-5D70-54E1-800B-97B7F75A1FC6","وحبي شربَ ياقوتٍ مذابٍ","يَرضُّ المـزجُ فيهِ حصى اللآلـي"],["D294A518-9090-5EBA-9015-A5135BD7A410","وهزِّي العطفَ في غَفَـلاتِ عيشٍ","وريقِ الأيكِ ممطورِ الظلالِ"],["1438498B-21F6-52F0-8CAA-8D8A67EAB2A4","فها أنا من لبابِ العمر أشجى","إذا هجستْ خواطرُهـا ببـالـي"],["903B8706-CDC4-57DF-86C1-768927B75D7C","وأجتنبُ الشجونَ وأينَ صبري؟","وأحتلبُ الشؤونَ وكيفَ حالي؟"],["2886A674-59B7-52AC-A34E-FB4F2C615130","وتَذوي مُهجـتي واشْتف لَوني","وتدمى مقلتي وسلِ الليالي"],["E747A56B-42E0-50BB-8634-035855EB8F6A","فخذي الزعفرانُ ولا أحاشي","ودَمعـي الأرجوانُ ولا أُبـالي"],["6AC4C291-1DD9-5549-BA29-0C54A60AA2BC","أحاكي الوردَ ذا الوجهين يحذى","معاً في الصبغتينِ على مثـاليِ"],["9814EEAE-C7E2-5F4F-9802-C9B868DEE865","وكيفَ يُرَدُّ لي مـا فـاتَ منِّـي","وردُّ الغَانيـاتِ منَ المُحـالِ؟"],["2E14BB13-D34E-57EE-BA0D-B21CE80DD543","ومـا للمُفلسين سوى التّمنِّـي","ومـا للنّائمينَ سِوى الخَيـالِ"],["03C3EA2E-5616-5E32-B53A-8425792454C1","ذَوى الشّعرُ البنفسجُ في عِـذاري","وزاحَمَـهُ ثَغـامُ الاكتهـال"],["EC9BCB7D-1637-5916-91AC-DF6927FB27E8","وكدّ تفاوتُ الخطّـينِ قَلـبي","وخـاطَ عـلي أثوابَ الخَبـالِ"],["EA081DD4-9117-50E2-AC1F-BBE927A881FF","فخيطُ دب بدءُ الشيبِ فيهِ","دبيبَ النارِ في طرفِ الذبالِ"],["10C49949-DD7E-58A8-B578-CA8EF109E92F","وآخرُ فاحمٌ كالفحمِ جانٍ","على جارٍ بحر النار صالِ"],["C5DE2F59-7E3C-5842-B9D4-C533B2E59E7A","يُحاذرُ أنْ يصـابَ وغيرُ بـدعٍ","لجارِ النارِ عدوى الإشتعالِ"],["59DD2841-6AEB-5EB7-8B6B-259BC9391C44","فذي ظلمُ الشبابِ على صَداهـا","ضيـاءُ الشيبِ حودِثَ بالصقالِ"],["86834BD2-2B4D-5875-A257-2FEDF8CCC98F","تُرى تلـكَ العهود تعودُ يومـاً؟","وحال الوصلِ يلقحُ عن حِيالِ"],["DCF22D89-1BEE-5CC3-89DC-F484750C5F04","وينسَى البـينُ عـادَتَهُ وتَنْجـو","منَ الأقتابِ أسمنةُ الجمالِ"],["92D8F9BF-81C8-5ABE-9B6F-F75598134B67","فتعمرُ باللوى تلكَ المغاني","وترجعُ بالحمى تلكَ الليالي"],["C9E4ED9F-55BB-5283-8090-B196B37D7E15","رخيمُ الدلِّ مكسالُ التهادي","طويلُ الذيلِ صرارُ النعالِ"],["0DD7C3F7-76CC-5C75-8B0F-81B41E97AA0E","يرقِّـقُ طَبعيَ المأيـوسَ عنـهُ","ويشحذُ غَرْبَـهُ بعـدَ الكـلالِ"],["BFF81825-CC27-5D19-83C6-EA780C6DBEBF","فينشطُ لاختراعِ الشعرِ عقلي","وينشطني البيانُ منَ العقالِ"],["1BAABB31-1E0B-51AB-ACE6-96FC0BDCF0CC","وأطنب في ثناءِ أبي عليِّ","نظامِ الملك نظامِ المعالي"],["0CF08830-8AFC-501F-99AA-8289CB7C61C7","فـتىً كالليثِ مَشبوبُ المـآتي","فتىً كالقرمِ محذورُ الصيِّالِ"],["036AE41E-3720-5039-A341-F3A4386F542F","وتسخر كفهُ والبحرُ فيها","بمن شامَ السحائبَ للنوالِ"],["84F8ECFF-B7B7-5C7A-9547-E26545FAA7F2","ويعلى كعبهُ عرضٌ مصونٌ","معولهُ على مالٍ مذالِ"],["B64DC4E3-33F0-524F-B5AE-809C27A6B343","أعارَ عواطلَ اى دابِ عيناً","تُراعيهـا فهُـن بـهِ حَوالِ"],["CBD1E25C-2F98-5EB5-BE3C-E2CA1718E0EA","وعطر شعرَ صدغيها بمسكِ","ونقطَ وردَ خديها بخالِ"],["BF9F78A3-C2EB-5C6D-8DD0-1FE9CC9B3547","وبوءَ وفدها كنفاً رحيباً","مرودَ العشبِ مورودَ الزلالِ"],["A5B6C47D-40B3-5DDA-85BE-003005087DBB","حراماً مثلَ بيتِ اللهِ يشدو","بسحرٍ في مناقِبـهِ حَـلالِ"],["B2EC852D-143E-535A-91A0-1D9C6C0038AD","يسفُّ بهِ تواضعه فتدنو","مَقاطِعُـهُ على بعـدِ المَنـالِ"],["FE98139C-BFBC-5B7E-83A1-66C7D8C826FA","ويُظْهِرُ نطقُـهُ إعجـازَ عيسى","بردٍّ الروحِ في الرممِ البوالي"],["52A6EE39-21AD-581C-B06B-26D880029A38","وأهـداف الصـوابِ مُغَربـلاتٌ","بأقـلامِ لـهُ مثـل النِّبـالِ"],["61B97488-6716-589C-A3E6-328FB9E3C30D","يفوقها فلا تخطي وتمضي","مضاءَ القعضبيةِ في العوالي"],["48A49E95-05FA-507A-99E2-C8EBC898EA2B","بخطٍّ إثمدي اللونِ يشفي","عيونَ الرمدِ عندَ الاكتحالِ"],["0132028D-03D7-518D-96D4-803B948D0163","فمن دالٍ تُصـاغُ عـلى اعتدالٍ","ومن ذالٍ تصانُ عن ابتذالِ"],["70A98DD8-DB81-54C8-9AF5-4A9FDB8848FD","وليس تحسُّ منه العينُ عيباً","سوى المحذورِ من عـينِ الكَمالِ"],["FE646CAF-9AF1-52B0-8213-DA70B1A48BA9","تُساقُ إلى النّبيِّ بـهِ صَـلاةٌ","وتُعرفُ فيهِ قُـدرةُ ذي الجَـلالِ"],["6A333B11-C649-5FD6-99DD-05D09165F2EB","ويثبتُ ركنهُ في كلِّ خطبٍ","تزلزلُ منهُ أركانُ الجبالِ"],["349B4FC4-30F4-51A7-8EA2-9EF336A9DA48","وما شربَ الطلا إلا استراحت","مسامعُهُ إلى نَغَـمِ السُّؤالِ"],["80D20351-6BC3-54AD-ACBF-5B4B8ABC594D","فكأسٌ في اليمينِ يميلُ منها","إلى طربٍ وكيسٌ في الشمـالِ"],["E2A5AE04-5600-54C0-9060-1AC310D13163","وإن برقت غزالةُ وجنتيهِ","حسبتَ الشمسَ ناظرةَ الغزالِ"],["E3D09ECA-1273-5483-BFD3-22691830A4AA","ويذهلُ عن نفائسه بنفسٍ","تَرى الذكرَ المخلّدَ خيَر مـالِ"],["C02FCCCE-020A-5CB3-B73A-70A7751B7099","رماها بالعراءِ كما تجافت","عن البيضاتِ حاضنـةُ الرِّئـالِ"],["7B4B4C92-36B6-5804-90F2-E5CEAB1FF33C","أمولانا خدمتك غيرَ وانٍ","وأُلْتُ إلى جَنابِـكَ غـيرَ آلِ"],["32A3B512-8BDB-5F50-8A4A-0D2CC7306E92","وجادَ رياضَ مَجدِكَ مِنَ ثنَائي","حياً يَنْهـلُّ مُنحلَّ العَـزالي"],["7DB20F6D-F033-544D-BE02-ED55FE5D3E37","فكم أنشدتُ بينَ يديكَ شعري","فلم يَخجـل مَقامي من مَقـالي"],["C72DAC65-167D-54DF-82A8-0F5E89F01D4F","ولي في صَنْعتي بُرهـانُ مـوسى","وعندَ سوايَ تزويرُ الخيالِ"],["750404BB-0017-5CFC-99E7-87DAD01893D3","وكم فحصت يد الأيامِ عني","كأيْدي الخيلِ أبصرتِ المَخالي"],["9E361219-7FF0-52FA-BE0D-EE577F6FAAB1","فلذاتُ ببابِ داركَ مستجبراً","مخلى السربِ متسعَ المجالِ"],["BC3F3829-722F-5542-BFCA-46B902A8EC5F","ونلتُ لدَيـكَ رفعاً في مَحلِّي","تناقضهُ يوضعٍ في رحالي"],["D6196D38-75F3-58EC-9E0F-57111A4A5779","فعِشْ ما شِئتَ مَقْهـورَ الأعـادي","ودم ما شئتَ منصور الموالي"],["63556A34-02E2-56C4-AB18-DC8EF806E23C","وخذ في مجلسِ الأنس المهنا","هلالاً في هلالٍ من هلالِ"]]}}}