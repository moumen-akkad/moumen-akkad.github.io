{"v":1,"poems":{"4C53FC96-F861-557D-9B6B-BC5025377322":{"t":"ياحادِيَ الشَّدَنِيّاتِ المَطاريبِ","p":158,"s":"ياحادي الشدنيات المطاريب","r":"456695","v":[["19B5E5D6-09A7-5D73-8D57-BAC1EA146C92","ياحادِيَ الشَّدَنِيّاتِ المَطاريبِ","أَناقِلٌ أَنْتَ أَخْبارَ الأَعاريبِ؟"],["D50F780D-11D4-5B73-8A96-74611884D3D9","ترَّفعت بكَ أو بي همَّةٌ تركت","هذا الرُّدينيَّ مهزوزَ الأنابيبِ"],["8180E1C5-D906-5803-B62E-5AA48EC7B737","فَعُجْ عَلى خِيَمٍ لَفّتْ وَلائِدُها","أَطنابَهُنَّ بِأَعْرافِ السَّراحِيبِ"],["94331754-1445-50F3-BF72-6F60BC66418A","واهاً لليلتنا بالجزعِ إذ طرقتْ","عفرَ الأجارعِ من بطحاءِ ملحوبِ"],["F0DD0CD4-BC7A-5C08-B59C-32064503FF8C","وَالوائليُّونَ يَسْري في عُيونِهِمُ","كَرَىً هُوَ الغُنْجُ في لَحْظِ الرَّعابيبِ"],["1F66FE5E-6CED-533F-83F2-5FC437EDBC6A","وَلاحَ في الكِلَّةِ الصَّفراءِ لي رَشأٌ","يرمي دجى اللَّيلِ عن أجفانِ مرعوبِ"],["92DD239E-366E-5413-90BB-D910484E26A5","طَرَقْتُهُ وَالنُّجومُ الزُّهْرُ حائِرَةٌ","على مطهَّمةٍ جرداءَ يعبوبِ"],["8EB21578-B411-53C0-8A88-2FCF78D0F9C3","وقد دَنَتْ منهُ حَتّى أَوْدَعَتْ أَرَجاً","أَحْناءَ سَرْجي أَفاوِيهٌ مِنَ الطِّيبِ"],["94FFEEEF-0310-5A2B-90F9-DF79A563AE90","وَكادَ يَفْتِلُ إكْرامَاً لِزائِرِهِ","عِذارَها مِنْ أَثيثِ النَّبْتِ غِرْبيبِ"],["31A515DF-0A5C-50B1-B3C8-ACE29B2C61A3","لكنَّهُ سترَ البدرَ المنيرَ بهِ","حتى أجارَ محبّاً صدغُ محبوبِ"],["0340D13C-B92B-53E1-8515-288430D1C62B","وقد أَخَذْنا بِأَطْرافِ الحَديثِ فَكَمْ","دَمْعٍ على مَلْعَبِ الأَطواقِ مَسْكوبِ"],["3664F802-6B1E-50E1-B355-B9E3D69E25E4","وَاسْتُعْجِلَتْ قُبَلٌ مَرَّتْ على شَبِمٍ","صافي القرارةِ بالصَّهباءِ مقطوبِ"],["584D75E6-65B6-5633-BAC9-9A017E0FB23B","إنّي لأَدَّرِعُ اللَّيلِ البَهيمَ ولا","أُليحُ مِنْ قَدَرٍ يَأْتيكَ مَجْلوبِ"],["A7A1324A-F9BB-5751-956A-9A6EECAAA951","وفيَّ من شيمِ الضِّرغامِ جرأتهُ","إذا أَرابَتْكَ أَخْلاقٌ مِنَ الذِّيبِ"],["9399F722-ADBF-5A9F-B3C2-AC2EA2C141D4","أواصلُ الخشفَ والغيرانُ مرتقبٌ","لا خيرَ في الوصلِ عندي غيرَ مرقوبِ"],["E76CCDF6-70F0-57E0-82F6-F84F12A1D1F5","وَلا أُحالِفُ إلاّ كلَّ مُشْتَمِلٍ","على حسامٍ منَ الأعداءِ مخضوبِ"],["EF5E9BF1-89D7-5F58-8984-049B53E3241F","يستنزلُ الموتَ في إقدامهِ طرباً","إلى مدىً يدعُ الشُّبانَ كالشِّيبِ"],["072D7F7E-8457-5D47-A6D2-B33CF972C2FD","ويستجيشُ إذا ما خطَّةٌ عرضت","رَأْياً يَشيعُ بِأَسْرارِ التَّجاريبِ"],["FC7F8200-9966-5707-8952-DDD116C497D3","مِنْ مَعْشَرٍ يَحْمَدُ العافي لِقاحَهُمُ","إذا امتدرَّت أفاويقُ الأحاليبِ"],["933E105C-4B0C-5F22-9C57-B0B23532EF4F","أَعْداؤُهُمْ وَمَطاياهُمْ على وَجَلٍ","فهم أعادي رؤوسٍ أو عراقيبِ"],["7F863A41-9CCD-55E7-8E22-6A3AE6CF4FDC","مدَّ المعاويُّ من أضباعهم فلهم","عزٌّ تردَّوا بهِ ضافي الجلابيبِ"],["88DCFF2D-8739-5C4E-B03E-F65B3BBF2C86","أبو عليٍّ لهُ في خندفٍ شرفٌ","لفَّ العلا منهُ موروثاً بمكسوبِ"],["F6D21435-D417-5362-B68E-97FB82665761","على نحورِ الملوكِ الصِّيدِ منشؤهُ","وفي الحُجورِ مِنَ البِيضِ المَناجيبِ"],["E826ED50-60AD-516E-A191-6137B2489E85","ذُو هِمَّةٍ تَرَكَتْ كَعْباً وَأُسْرَتَهُ","بغاربٍ في مراقي الفخرِ مجبوبِ"],["93626050-DD2D-5840-8758-360965B82108","وشيمةٍ فاحَ ريَّاها كما أرجت","خميلةٌ وهيَ نشوى من شآبيبِ"],["75CE7701-E507-5172-B333-D437897269DD","فَأَسْفَرَتْ عُقَبُ الأَيَّامِ عَنْ مَثَلٍ","بِهِ وَإنْ رَغِمَ الطّائِيُّ مَضْروبِ"],["A3A5576A-F81E-50E6-9D8B-82B003A2908E","لَهُ أَساليبُ مِنْ مَجْدٍ أَبَرَّ بِها","على الوَرى، وَالعُلا شَتَّى الأَساليبِ"],["63C52BB7-1E86-51EA-BDCA-6B52FC18284B","يهتزُّ منبرهُ عجباً بمنطقهِ","ترنُّحَ الشَّربِ من سكرٍ وتطريبِ"],["3511B8AB-5931-52F5-B301-A65C706E4A37","وَلَيْسَ إنْ ثارَ في أَثْناءِ خُطْبَتِهِ","كالمهرِ يخلطُ ألهوباً بألهوبِ"],["4B375964-4EDB-5654-AD0C-47D444444D9E","لكنّهُ يَمْلأُ الأَسماعَ مِنْ كَلِمٍ","ضاحٍ على صفحاتِ الدَّهرِ مكتوبِ"],["CC2751B6-FCFF-50E3-9041-A02E42F544F2","والقارحُ المتمطّي في علالتهِ","يشوبُ في الحضرِ تصعيداً بتصويبِ"],["19606184-9DA6-5AA9-9645-F1539D5E3286","يابنَ الّذينَ إذا ما أفْضَلُوا غَمَروا","عُفاتَهُمْ بِعَطاءٍ غَيْرِ مَحْسوبِ"],["DF0CECE1-5B94-506D-BC05-F901E37078A4","إنّي بِمَدْحِكَ مُغْرىً غَيْرُ مُلْتَفِتٍ","إلى نَدىً خَضِلِ الأنْواءِ مَطْلوبِ"],["76EF25B3-56D3-5BD8-9F4D-A3F71174C3C4","وَكَمْ يَدٍ لَكَ لاتَخْفَى أَمائِرُها","ما هَيَّجَتْ عَرَبيَّاً حَنَّةُ النِّيبِ"],["E9E8FC70-C7BC-5FB8-8D29-B53C60C0FDFD","وَكَيفَ أَشْكُرُ نُعماكَ التي هَطَلَتْ","بها يَمَينُكَ وَطْفاءَ الأهاضِيبِ"],["FB244DF9-24E6-59FB-8150-D5586FA5AC2A","لا زِلْتَ تُلْقِحُ آمالاً وَتَنْتِجُها","مواهبٌ يمتريها كلُّ محروبِ"],["8359CEAD-8837-5F7E-8055-E30EAB0C931F","وتودعُ الدَّهرَ من شعرٍ أحبِّرهُ","مَدائِحاً لَمْ تُوَشَّحْ بِالأكاذيبِ"]]},"AA44875B-3D1B-5180-B99D-7822AC99F0E6":{"t":"ياعَبْرَتي هذِهِ الأطْلالُ وَالدِّمَنُ","p":158,"s":"ياعبرتي هذه الأطلال والدمن","r":"456940","v":[["B06BCEB7-A1CB-5920-ADB6-A5BF7F83C73D","ياعَبْرَتي هذِهِ الأطْلالُ وَالدِّمَنُ","فما انتظاركِ؟ سيلي فهيَ لي وطنُ"],["C423993D-5BD4-5C99-81D2-AFD2EAFA7419","لمْ ألقَ قبلَ ابنةِ السَّعديّ لي سكناً","يكادُ يلفظُ روحي بعدهُ البدنُ"],["258B40A4-8BC9-58BA-90CD-94BAE489A527","تَلَفَّتَ القَلْبُ نَحْوَ الرَّكْبِ حينَ ثَنى","عَنِ التَّأَمُّلِ طَرْفِي دَمْعِيَ الهَتِنُ"],["FBCC77C8-A231-5DD7-8A4A-9B0186DF72C2","غَدَوْا وَما فَلَقَ الإصْباحَ فالِقُهُ","فَاللَّيْلُ لِلنَّاسِ غَيْري بَعْدَهُمْ سَكَنُ"],["15932741-0DBC-5812-9AEE-932AE83E99AF","في القربِ والبعدِ مالي منهمُ فرجٌ","فَالوَجْدُ إِنْ نَزَلوا والشَّوقُ إِنْ ظَعَنوا"],["BC31A0D2-E749-57C6-BD19-EE9AFC87BA93","وَقَدْ سَكَنْتُ إِلى الأَخْبارِ بَعْدَهُمُ","وَعِنْدِيَ المُزْعِجانِ الذِّكْرُ وَالحَزَنُ"],["8C1F2C61-7FE5-5E85-AA16-CE8394F18864","فَالأُذْنُ تَسْمَعُها وَالْقَلْبُ يَصْحَبُهُمْ","وَأَنْتِ ياعَيْنُ لا يَعْتادُكِ الوَسَنُ"],["A5FAE22B-8ECD-5E4F-9B0A-DD5179D51CFA","فليتَ حظَّكِ منهمْ مثلُ حظِّهما","ما آفةُ العينِ إلاّ القلبُ والأذنُ"]]},"07BE67C2-6805-595D-AEAD-25804AD9DD33":{"t":"يامن يساجلني وليس بمدركٍ","p":158,"s":"يامن يساجلني وليس بمدرك","r":"456828","v":[["CEE57495-5D51-5AAC-96B6-B5BFC1EF0436","يامن يساجلني وليس بمدركٍ","شأوي، وأين له جلالة منصبي"],["AFB5A1A0-C170-5EAD-AECF-7B5B0FA9FCAB","لا تتعبنَّ فدونَ ما أمَّلتهُ","خرطُ القتادةِ وامتطاءُ الكوكبِ"],["324E3435-94F2-5ACE-9FDC-878E2DA6BFE0","المجدُ يَعْلَمُ أيُّنا خَيْرٌ أباً","فاسألهُ تعلمْ أيَّ ذي حسبٍ أبي"],["72D11484-FA0D-56F6-B754-83473AA1C1FF","جدِّي معاويةُ الأغرُّ سمتْ بهِ","جُرْثُومَةٌ مِنْ طِينِها خُلِقَ النَّبِي"],["073FAD04-321F-534E-B1AB-A70E43A67C19","وَوَرِثْتُهُ شَرفاً رفَعتُ مَنارَهُ","فبنو أميَّةَ يفخرونَ بهِ وبي"]]},"BB2CD521-BCCD-54C8-8E54-39740B9BD22B":{"t":"يعيِّرني أخو عجلٍ إبائي","p":158,"s":"يعيرني أخو عجل إبائي","r":"456834","v":[["E941ABBB-47C6-5488-B15D-4FE95E3705A9","يعيِّرني أخو عجلٍ إبائي","على عدمي وتيهي واختيالي"],["62A5E93A-ABFC-5DA9-BAEE-C6F6BA41D98F","ويعلمُ أنَّني فرطٌ لحيٍّ","حَمَوْا خُطَطَ المَعالِي بِالعوالي"],["B7C9B266-F730-5D7B-B769-73C0D3686793","فلستُ بحاصنْ إنْ لمْ أزرها","عَلى نَهَلٍ شَبا الأَسَلِ الطِّوالِ"],["73AE0AB3-E578-535F-A5B8-C27D8F686B43","وَإنْ بَلَغَ الرِّجالُ مَدايَ فِيما","أحاولهُ فلستُ منْ الرِّجالِ"]]}}}