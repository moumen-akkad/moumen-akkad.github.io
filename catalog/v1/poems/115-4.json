{"v":1,"poems":{"1CF0D383-8868-5B9D-863B-0F1F3EE56FD1":{"t":"يا مَن يُفنّدُني في اللّهوِ والطّرَبِ","p":115,"s":"يا من يفندني في اللهو والطرب","r":"454999","v":[["E04B58EA-F607-587D-BFB7-ACD2EDEB95F5","يا مَن يُفنّدُني في اللّهوِ والطّرَبِ،","دَعْ ما تراهُ وخُذْ رأيي فحسبُك بي"],["CE5F60FB-B3F1-5938-A963-39819FDD27BE","أفي المُدامةِ تلحاني، وتَعذُلُني،","لقد جَذَبتَ جَموحاً غيرَ مُنجذِبِ"],["B997AD8F-85C2-5785-84FB-47EE3A8855CA","و ربّ مثلكَ قد ضاعتْ نصيحته،","ولم يُطِق ودَّ ذي رأيٍ ولا أدَبِ"],["5B55A0B3-4C99-5488-9553-5460F8D4FCEC","وقد يُباكرُني السّاقي، فأشرَبُها","راحاً تريحُ منَ الأحزانِ والكربِ"],["089683A5-2E09-5719-9522-FADDB66288B7","ما زالَ يقبضُ روحَ الدنّ مبزلهُ،","حتى تغَلغَلَ سِلكُ الدُّرّ في الثُّقَبِ"],["9592A7A5-E49A-584B-9141-B6C561FDCB5A","و أمطرَ الكأسُ ماءً منْ أبارقهِ،","فأنبتَ الدُّرَّ في أرضٍ مِنَ الذَّهَبِ"],["2A493382-DC70-59D1-AFA6-53A35C3053A6","وسبّحَ القومُ لمّا أن رَأوا عجَباً،","نُوراً من الماءِ في نارٍ من العِنَبِ"],["6112F0B4-FE12-5E39-9687-EAC3A16B3A6C","بم يبقِ فيها البلى شيئاً سوى شبحٍ،","يُقِيمُهُ الظّنُّ بين الصّدقِ والكذِبِ"],["25B25CBF-611E-5FF9-81D2-1790E4E451B7","سلافةٌ ورثتها عادُ عن إرمٍ،","كانَتْ ذخيرةَ كِسرَى عن أبٍ وأبِ"],["D696AB77-2BD2-5CFD-B591-E6B9ECCF9469","في جوفِ أكلَف قد طال الوقوفُ به،","لا يَشتكي السّاقَ من أينٍ ولا تَعَبِ"],["609804EB-1691-5028-9305-4FCA183995D7","يتيمةٌ بينَ أهلِ الدّهرِ قد رُزِقت","جِدّاً مُزاحاً، وجِدّ النّاس مِن لَعِبِ"]]},"246FA2BE-A8BB-595D-BE84-F0C369CF6A71":{"t":"يا مَنْ يَجودُ بمَوْعِدٍ من حَظّهِ","p":115,"s":"يا من يجود بموعد من حظه","r":"455144","v":[["A268355B-8367-5B8B-A7CC-7B9E90E1861C","يا مَنْ يَجودُ بمَوْعِدٍ من حَظّهِ،","وَيصُدُّ، حينَ أقول: أين الموْعدُ؟"],["895ECACA-977D-5621-9519-EAFFA8E1DE42","ويَظَلُّ صَبّاغُ الحياءِ بخَدّهِ،","تعباً، يعصفرُ تارةً ويوردُ"],["4B888E87-5579-55C6-B585-0EEC27596451","ماذا يضركَ لو رثيتَ لعاشقٍ،","قَلِقٍ يقومُ به هَواكَ ويَقعُدُ"],["E6D8FC86-F9DE-5AD7-9C06-DDE330B33783","تجدُ العيونُ رقادها، ورقاده،","حتى الصّباحِ، مَسرّةٌ لا تُوجدُ"],["3D99AE8A-AB41-531A-93BA-51BBB7496003","وله، إذا ما قصّرَ الليلُ الكرَى،","ليلٌ طويلُ العُمرِ ليسَ لهُ يدُ"]]},"E083C4A6-807D-5DB4-8356-EB3102B89B35":{"t":"يا مَنْ يُبَعِّدُ وَعْدي","p":115,"s":"يا من يبعد وعدي","r":"455166","v":[["7692D350-D1BD-5E4D-8309-4CF0803BBDB5","يا مَنْ يُبَعِّدُ وَعْدي،","أطلتَ مطلي وكدي"],["C9AEA870-DEA9-52B0-8A6C-AEB173FDCAFF","خُلِقتَ، لا شكّ عندي،","مِن فَضْلِ طِينةِ قِرْدِ"]]},"8F48FC5B-8797-5519-85DE-89DEF8CEA3BB":{"t":"يا مُدخِلَ الصُّلعِ حمّاماً يَزيدُهمُ","p":115,"s":"يا مدخل الصلع حماما يزيدهم","r":"455117","v":[["45267794-3A48-5A45-B60F-993F4BC8904A","يا مُدخِلَ الصُّلعِ حمّاماً يَزيدُهمُ","بطولِ مكثهم في جوفهِ وسخا"],["2DE64711-47D4-5F18-87B2-029353E16B60","حتى إذا عرقوا من حرهِ شرعوا،","و كلهم بخلوفٍ منه قد لطخا"]]},"52889B7E-A007-5363-918C-935DB88BBD1F":{"t":"يا مُفرداً في الحُسنِ والشّكلِ","p":115,"s":"يا مفردا في الحسن والشكل","r":"455625","v":[["88C8C134-758C-5E04-B558-3EEC4BC53939","يا مُفرداً في الحُسنِ والشّكلِ،","من دلّ عينيكَ على قتلي"],["394B19F5-247D-533E-8E7B-2A7639D14C01","البَدرُ من شَمسِ الضّحى نُورُهُ،","و الشمسُ من نوركَ تستملي"]]},"9647D0DD-16A3-5E0A-A654-90EDDAF1DDC4":{"t":"يا مُقلَةً أُدنِفَتْ كما دَنِفتُ","p":115,"s":"يا مقلة أدنفت كما دنفت","r":"455042","v":[["60A7CF1B-0AC3-53EF-ABFF-0552EBD70C80","يا مُقلَةً أُدنِفَتْ كما دَنِفتُ،","مرّت بنا سَنحةً، وما وقفتُ"],["27F6B558-BA42-5C4F-9766-845DBBE0590D","وجفنُها ساحرٌ ليقتلَني،","فتبتُ من توبتي، التي سلفتُ"],["F1A2E954-2CBB-5516-85B4-E2CCD0B9F2AC","رثَى لعينٍ يَقوَى بلحظتِها،","كيدٌ لإبلِيسَ كلّما ضَعُفتُ"]]},"EF04BD25-DBDF-59D1-A6F1-E54002155F4D":{"t":"يا ناصِرَ الإسلامِ عِشْ","p":115,"s":"يا ناصر الإسلام عش","r":"455729","v":[["1789DC4C-FC84-5B1A-888A-C189D1320588","يا ناصِرَ الإسلامِ عِشْ،","واسلَمْ على رَيبِ الزّمَنْ"],["870F3392-D9CA-5A9B-8ED2-784FEA54F595","شَقّ الجَموعَ بسَيفِهِ،","وشَفَى حَزازاتِ الإحَنْ"],["8D3C0026-2D05-516C-9669-C64DF5862E4B","دامي الجِراحِ كَأنّهُ","وردٌ تفتحَ في غصنْ"]]},"4D325965-66EC-5AA4-A59F-44860FA2FE83":{"t":"يا ناظراً أودَعَ قلبي الهوَى","p":115,"s":"يا ناظرا أودع قلبي الهوى","r":"454934","v":[["43A6060A-FFB3-5C74-9304-13BC69B022F0","يا ناظراً أودَعَ قلبي الهوَى،","كَوَيتَ بالصّدّ الحَشا، فاكتَوَى"],["C11C87AF-0096-51DA-8C59-01A874CADC44","و يا قضيباً ناعماً في نقاً،","أحس ريحاً، فانثنى، واستوى"],["3E933A2C-1B53-51E4-ACBC-7D6C39148B8A","إرحَمْ مُحِبّاً عادَ في غَيّه،","مِن بعدِ قِيلَ صَحا وارعوَى"],["5919CFF0-B159-5E00-810B-FA3F8F92ED3F","قد كتبَ الدمعُ على خده:","هذا حبيسٌ في سبيلِ الهوى"],["DFFF4FEC-D0FA-553A-80EF-1FF7D8DAD7BF","ما نلتُ منه نائلاً، غيرَ أن","وافق كمي كمه، فالتوى"]]},"2BBB4B07-0568-5085-896F-2A6CC1E05B35":{"t":"يا نسيمَ الرياحِ من بلدي","p":115,"s":"يا نسيم الرياح من بلدي","r":"455133","v":[["B3399429-DB17-5552-A73E-F8D25C6BB871","يا نسيمَ الرياحِ من بلدي،","إنْ لم تفرجْ همي، فلا تردِ"],["174F266B-6455-5D1D-B3C2-DA462E377583","أبيتُ، والشوقُ في الفراش معي،","يكحلُ عيني بمرود السهدِ"],["F5EA92C7-5B22-5C7A-A68B-18E9CB459266","معترفاً بالشّوقِ مُكتئِباً،","أشكُو إلى الله لا إلى أحَدِ"],["7836D97F-371A-5121-85D1-9023434E92D4","صباً يرى آخرَ الحياةِ، ولا","يطمعُ في راحةٍة لا خلدِ"]]},"15A09D8E-25E3-5315-B4D3-613B858069BE":{"t":"يا نَفسِ صَبراً صَبرَا","p":115,"s":"يا نفس صبرا صبرا","r":"455295","v":[["220D94B7-902C-5F31-9033-A6E3B6212ABA","يا نَفسِ صَبراً صَبرَا،","أما عرفتِ الدهرا"],["516C7B94-46A2-52EB-8A8B-2CEE57B8B940","لله منّيَ قَلبٌ،","يَقري البَلايا شُكرَا"],["7B8A97BA-31E0-59EE-B72B-85C8CB278FD7","يا رُبّ لَيلٍ قاسٍ،","كأنّ عليَّ قرا"],["05CA57EE-2747-5AE5-895B-FC9B0B7F5C53","سريتهُ بعيني،","حتى رأيتُ الفجرا"],["A242690B-A174-5A57-90BF-3DEDD72CFAF0","كأنّما سَناهُ","أطارَ عَنّيَ نَسرَا"],["9AC81E47-415D-5027-B669-8EE2C287CD51","واستَجمعَتْ هُمومي،","حتى ملأنَ الصدرا"],["1962B2E7-44CD-5A3A-A434-12592269D65E","ذاقَتْ من الأعادي","عينايَ لحظاً مرا"],["0FE91902-3E35-5038-B2B7-630BCF4FFC35","ضاعَ الوَفاءُ منهمْ،","وأضمَروا لي الغَدرَا"],["3C749CE6-0AE2-5EF3-9162-92D43B527501","يا نَفسِ لي بقَومٍ","كانوا كراماً زهرا"],["4389B94D-5B92-5560-A86D-B4F412294279","مَضَوا بخَيرِ عُمري،","وتركوا لي الشّرّا"],["46120B3E-548B-516F-8F3F-FD0B5AE58F7D","ولم أجِدْ إذْ ماتُوا،","لي في الحياةِ عذرا"],["5C8A8C77-F161-5D8A-814D-4763675496C4","عاشُوا بخَيرِ عَصرٍ،","سَقياً لذاكَ عَصرَا"],["1BFED598-8890-5A34-8118-D9087B4E644B","نبئتث أنّ قومي","قد دَفَنوا لي مَكرَا"],["9CE1B1A4-CFD0-57C0-971B-C8C578300865","فابتَلَعَ المَطايا،","فاستعجلوا بي القبرا"],["F80E3C34-942A-52D8-BA32-2BA9380FECAC","ردوا ردائي لما","رأوا بقائي فخرا"],["6FB93113-FB09-5E5B-A284-5674FD048651","كأنّهمْ بيَومي،","فلا تَحثّوا العُمرَا"],["2795B084-9385-51AF-9084-096A31DA457A","هل للأغَرّ ذَنبٌ،","إن لم يَكونوا غُرّا"],["C9B6F853-62AD-5E8D-8D33-5B2161EE9712","أغمَدتُ عَنكُمُ سَيفي،","وقد مَلَكتُ النّصرَا"],["5A91717B-EC89-5688-824E-32DE4C45D3C1","صيانَةً وعَطفاً،","لرحمي، وغَفرَا"],["BC814626-F3D1-52D4-B747-25B556D9C7A0","و ليسَ كلُّ وقتٍ","يُطفىءُ ماءٌ جَمرَا"],["BCA4412F-7C20-5C42-A661-04CF8712BF08","أأنْ ألمّ دهرٌ،","جاءَ بكم وسُرّا"],["453B4CEB-D72C-53E1-9177-72FB985319E9","كَفّرتمُ كريماً،","حنّ لكم ودرا"],["FCDD6882-3040-5577-8CBE-CDACE99B5C73","أتعبتمُ يديهِ،","بالقَلَباتِ دَهرَا"],["93B414BF-6F15-5E93-BF8F-12D58F1DFD31","و مهمهٍ رحيبٍ","ظمآنَ يُضني السَّفرَا"],["F77810C7-D10C-5413-9C4C-0ED6515F5E99","يَخطِرُ في فلاةٍ،","موجُ السحابِ خطرا"],["729D3157-BDB7-572A-B8CA-AE3CDD8985EE","خاضُوا الظّلامَ بَعدي،","معَ الحداةِ شهرا"],["06BF06B5-CCCC-519D-84B1-E709BA99CC70","كم من عبيدِ دارٍ،","ظعنتُ عنهمُ حرا"],["6B8A2B1E-69AF-52F4-AFF5-11F5C8EBC704","ذا خلقٍ كريمٍ،","لم يُبقِ فيهم عَقرَا"],["B436FEFA-CF6E-57E8-AF59-58DDCCCA6FD5","خاضوا الظلامض بعدي،","و كنتُ فيهم فجرا"]]},"242B6883-EF1D-59C4-BF18-C77C5D630AFD":{"t":"يا نَفسِ صَبراً لعَلّ الخَيرَ عُقباكِ","p":115,"s":"يا نفس صبرا لعل الخير عقباك","r":"455606","v":[["A5F2DB8D-214F-5CF1-A73D-14DE53BB9E4E","يا نَفسِ صَبراً لعَلّ الخَيرَ عُقباكِ،","خانَتكِ من بَعدِ طولِ الأمنِ دُنياكِ"],["90778FE7-86A2-5B0D-9070-7F795DA41763","لكِن هوَ الدّهرُ لُقياهُ على حَذَرٍ،","فربّ حارسِ نفسي تحتَ أشراكِ"]]},"67C087EF-E35A-51CF-984E-EA1A2B0C63F7":{"t":"يا هلالاً يدورُ في فلكِ الما","p":115,"s":"يا هلالا يدور في فلك الما","r":"455234","v":[["436F20C8-3FE6-5087-9FCD-2DD9E166FC0B","يا هلالاً يدورُ في فلكِ الما","وردِ! رِفقاً بأعيُنِ النّظّارَه"],["E8E68B9E-F608-5E15-B06C-CEB387998533","قِفْ لَنا في الطّريقِ، إن لم تزُرْنا،","وَقفَةٌ في الطّريقِ نِصفُ الزّيارَه"]]},"C97D884F-B7DE-5D0B-8211-B2BCF953D26F":{"t":"يا وَجه شُرّةَ يا أخا البَدرِ","p":115,"s":"يا وجه شرة يا أخا البدر","r":"455240","v":[["929B33B8-B604-5002-9A03-EDC15130FB91","يا وَجه شُرّةَ، يا أخا البَدرِ،","أرَضيتَ بالإعراضِ والهَجرِ"],["B5E3A902-7D22-5CE5-B663-C9BE8A23A5A0","وترَكتَني، وحجَجتَ مُعتمراً،","طُوبَى لرُكنِ البَيتِ والحَجَرِ!"]]},"8DF5CE3A-9B1B-5F15-A7A8-1107010201E7":{"t":"يارَبّ قَد أبلاني","p":115,"s":"يارب قد أبلاني","r":"455732","v":[["2BB6ECF7-9A1B-52DF-B7D6-13B050FD01B2","يارَبّ قَد أبلاني،","حبي لذا الخوانِ"],["50963400-4AB0-5204-9DAA-91D628020926","وباحَ دَمعي بسِرّي،","و خانني كتماني"],["7153FA67-2299-5086-B61F-CB3E9C992711","يا زهرةَ البستانِ،","يا نَفحَةَ الرَّيحانِ"],["CBD57FEB-4E30-5179-835D-E50A5A9EE5E8","أنتَ ابن بَدرٍ وشَمسٍ،","ما أنتَ من إنسانِ"],["D9D1D3E1-B9E2-5C5D-9CB4-3E7CA0467DBA","ما للثّرَيّا شَبيهٌ،","فيما بنى قطُّ بانِ"],["FEAB5C68-A7D0-51FE-9666-9D2FF514414E","حِيطانُهُ مِن نُورٍ،","والسّقفُ مِن نِيرانِ"],["7974DF18-9DCE-565E-9AEE-B19EF08077C3","و الصحنُ ياقوتُ درٍّ،","للعَينِ في جِنانِ"],["444134D8-01EE-511D-9D97-83ED9FFF992B","و الماءُ يعدو عليها،","في جدولٍ ريانِ"],["25D11756-7DFB-5EC7-9FD5-703144BF845A","فعِشْ بذاكَ سَليماً،","خَليفَةَ الرّحمَنِ"],["AD4C6714-92F9-55DE-87D1-98B2A6CEEFB5","وكُن مع الدّهرِ دَهراً،","عمراً، كما عمرانِ"]]},"E8C6C9D1-C878-5E99-8F46-B62D7BB0E74E":{"t":"يارُبّ لَيلٍ سَحَرٌ كلُّهُ","p":115,"s":"يارب ليل سحر كله","r":"455695","v":[["90673B27-7714-53FC-991F-117A0B759659","يارُبّ لَيلٍ، سَحَرٌ كلُّهُ،","مفتضحُ البدرِ عليلُ النسيمْ"],["80DE2E96-7212-5E19-90C1-E0A65E43A7E6","يَلتَقِطُ الأنفاسَ بَردُ النّدى","فيهِ فيَهديهِ لحَرّ السَّمُومْ"],["DFB9AFB2-7716-50CB-A47E-E368F68F2820","لم أعرِفِ الإصباحَ في ضَوئِهِ،","لما بدا، إلاّ بسكرِ النديمْ"]]},"4D7FE2B2-03D8-54D6-8AB2-785B7E265FB1":{"t":"ياصاحِ! وَدّعتُ الغَوانيَ والصِّبَا","p":115,"s":"ياصاح! ودعت الغواني والصبا","r":"455635","v":[["0F536BA9-4703-5802-98FD-16F86F6E4C5F","ياصاحِ! وَدّعتُ الغَوانيَ والصِّبَا،","وسَلَكتُ غَيرَ سَبيلِهِنَّ سَبيلا"],["E3F41C18-F29A-50D3-878A-31CC8AD135CA","و ثنيتُ أعناقَ الهوى نحوَ العلى،","و رأيتُ شأوَ العاشقينَ طويلا"],["93E23CCD-73C3-50EB-922B-F345F62BDA4F","فأجَبتُ واعظةَ النُّهَى، فاستَجمعتْ","ألفاظُ عينكَ وانثنى مغلولا"],["D9C2F996-387E-55F0-BC44-19A7F68A50F6","عهدانِ ماتا للأوانسِ والصبا،","فاندبهما، لا تندبنّ طويلا"],["8CEDF8FD-BCD4-5AA7-A79A-FF6092002A40","ذَهبا بمَعسُولِ الحَياةِ وأيَّسا،","من رجعةٍ وتعجلٍ تحويلا"],["D946038E-DA38-5B61-A7FD-009A2F64E360","بدلتُ، من ليلِ الشبابِ بمفرقي،","صبحَ النهى، أحببْ بذاكَ بديلا"],["14D6ED36-50DC-5431-87FE-AD60E177F819","لكنّ في قلبي، إذا صَدّ الرَّشَا","عني، أسى يعتادني، وغليلا"],["138281D1-81A1-5838-99CF-2445618DBB2C","و لربّ ليلٍ لا تجفّ جفونهُ","من دمعةٍ ملقٍ عليهِ سدولا"],["D0E95EA0-2F59-5332-8B6D-A95C0FBC3D11","ماتتْ كواكبهُ، وأمسى بدرهُ،","في الأفقِ، مُتّهَمَ الحَياةِ عَليلا"],["1C412425-7073-5F01-A5AC-6027E2EA6984","دَبّتْ بنا في غَمرَةٍ مَشمُولَةٍ،","حتى توهمنا الصباحَ أصيلا"],["6A0C9EEE-12AC-52E9-B726-562043B337A9","صَفراءُ تَحسَبُها، إذا ما صُفّقَتْ،","ذهباً حوتهُ كأسها محلولا"],["FB52BC99-D77F-5831-9746-3D8109DD60D4","أهلاً وسَهلاً بالإمامِ ومَرحَباً،","لو أستطيعُ غلى اللقاءِ سبيلا"],["F99D0928-286C-5A8F-8482-CCF55CDCE1B4","لا يمتطي حفظاً ولا يمسي لهُ","طَرْفٌ بمِروَد رَقدَةٍ مَكحُولا"],["6E64A666-F15D-52E3-9153-82C6E40F66B3","ومُشَمِّرٍ أذيالَهُ يَومَ الوَغَى،","جرتْ عليهِ السافياتُ ذيولا"]]},"272B70BD-CE9E-5690-83AF-EEA583C7DD62":{"t":"يقولون لي والبعدُ بيني وبينها :","p":115,"s":"يقولون لي والبعد بيني وبينها :","r":"454960","v":[["39FC668E-2A7B-5440-A0EE-B84542019667","يقولون لي، والبعدُ بيني وبينها:","نأت عنك شرٌّ، وانطوى سببُ القُربِ"],["75BADA17-2474-5F05-BDA1-9EA58B1E5CEA","فقلت لهم، والسّرُّ يُظهِره البُكا:","لئن فارقت عيني، لقد سكنت قلبي"]]},"F129BCFC-82F7-57E5-BA19-AFC17A7FAB68":{"t":"يومُ سعيدٍ قد أطرقَ الدهرُ عنه","p":115,"s":"يوم سعيد قد أطرق الدهر عنه","r":"454977","v":[["9728ED34-0C5A-5DE3-AC99-97C915D28271","يومُ سعيدٍ قد أطرقَ الدهرُ عنه،","خاسئُ الطرفِ لا تراه الخطوبُ"],["671A019C-F622-57E3-9236-09011AE28C66","فيه ما تشتهي: نديمٌ وريحان","نٌ، وروحٌ، وقينةٌ، وحبيبُ"],["291EE146-9E4B-59BB-8643-663214A65FE9","منعمٌ مسعدٌ بؤاتيهِ في الوصـ","ـلِ، رقيبٌ على العيونِ رقيبُ"],["4A6A9966-8BA8-5E91-8B2C-0AADFFFACADC","ورسولٌ يقولُ ما تَعجِزُ الألْفا","ظُ عنه، حلوُ الحديثِ أديبُ"],["93FC7921-63BF-568E-BE09-05F847823448","و لنا موعدٌ، إذا النـ","ـوامُ ليلاً، والليلُ منا قريبُ"]]},"0597B170-92EB-5809-88CA-E8BF2A5D5DEF":{"t":"يَتيه عندي وأنا أخضَعُ","p":115,"s":"يتيه عندي وأنا أخضع","r":"455520","v":[["44761852-F4BA-5A57-B920-FE630000523F","يَتيه عندي، وأنا أخضَعُ،","إن كانَ ذا بَختي، فَما أصنَعُ"],["F4DBC49D-AC19-5FAE-9186-C69FEC3669F7","يا عاذلي عذلكَ لي ضائعٌ،","أسمعتَني، والحبُّ لا يَسمَعُ"]]}}}