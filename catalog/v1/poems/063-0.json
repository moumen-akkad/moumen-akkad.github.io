{"v":1,"poems":{"57AE7C82-8896-544C-8EBD-6DC86B52A37D":{"t":"أقول لها وقد طارت شعاعاً","p":63,"s":"أقول لها وقد طارت شعاعا","r":"441326","v":[["D92E3B6A-F2EF-5BBC-9221-934AEB96810F","أَقولُ لَها وَقَد طارَت شَعاعاً","مِنَ الأَبطالِ وَيحَكِ لَن تُراعي"],["C586DBA2-1FC7-555C-BA00-094AA1C57C45","فَإِنَّكِ لَو سَأَلتِ بَقاءَ يَومٍ","عَلى الأَجَلِ الَّذي لَكِ لَم تُطاعي"],["31C639F2-3724-5D41-8AE6-50467F2E650F","فَصَبراً في مَجالِ المَوتِ صَبراً","فَما نَيلُ الخُلودِ بِمُستَطاعِ"],["F16E9FAB-7336-572A-BED1-B648C9D1032A","وَلا ثَوبُ البَقاءِ بِثَوبِ عِزٍّ","فَيُطوى عَن أَخي الخَنعِ اليُراعُ"],["90396804-5DD9-5696-8898-EEF46DA7C197","سَبيلُ المَوتِ غايَةُ كُلِّ حَيٍّ","فَداعِيَهُ لِأَهلِ الأَرضِ داعي"],["8BFBDCF0-A1BE-5AFA-863A-4DF9DC426627","وَمَن لا يُعتَبَط يَسأَم وَيَهرَم","وَتُسلِمهُ المَنونُ إِلى اِنقِطاعِ"],["8BF58E7F-5B84-5826-A516-E8463C766664","وَما لِلمَرءِ خَيرٌ في حَياةٍ","إِذا ما عُدَّ مِن سَقَطِ المَتاعِ"]]},"1DD01C9C-BA2B-5681-BE4F-F8648FA5C487":{"t":"ألم يأتها أني لعبت بِخالِدٍ","p":63,"s":"ألم يأتها أني لعبت بخالد","r":"441328","v":[["3325B3D7-8B9B-5AF5-96F9-57964963D54A","أَلَم يَأتِها أَنّي لَعِبتُ بِخالِدٍ","وَجاوَزتُ حَدَّ اللُعبِ لَولا المُهَلَّبُ"],["D4104ABD-7D85-531B-B89C-696D6DDFAC31","وَأَنا أَخَذنا مالَهُ وَسِلاحَهُ","وَسُقنا لَهُ نيرانَها تَتَلَهَّبُ"],["A16A5213-4AB1-5506-B018-7887448A7287","فَلَم يَبقَ مِنهُ غَيرُ مُهجَةِ نَفسِهِ","وَقَد كانَ مِنهُ المَوتُ شَبراً وَأَقرَبُ"],["B32F4ADF-20BC-5ACA-AF68-870FFE9E3C24","وَلكِن مُنينا بِالمُهَلَّبِ إِنَّهُ","شَجىً قاتِلٌ في داخِلِ الحَلقِ مُنشَبُ"]]},"3AD7822C-28D0-51FE-96BE-F10BA1631AFE":{"t":"أَلا أَيُّها الباغي","p":63,"s":"ألا أيها الباغي","r":"441327","v":[["716E3E35-65E8-5CB8-9805-BFFED7B6A472","أَلا أَيُّها الباغي البِرازَ تَقَرَّبَن","أُساقِكَ بِالمَوتِ الذُعافَ المُقَشَّبا"],["AD616E33-4EFF-52DC-90C9-83025AB7A3CD","فَما في تَساقي المَوتِ في الحَربِ سُبَّةٌ","عَلى شارِبَيهِ فَاِسقِني مِنهُ وَاِشرَبا"]]},"8319B2AF-10E5-5196-BEA2-BD2044F123A1":{"t":"أَلا قُل لِبُشرَ إِن بِشَراً مُصَبَّحٌ","p":63,"s":"ألا قل لبشر إن بشرا مصبح","r":"441329","v":[["2C6B8ECD-F2CE-5015-A36A-C0E396930EE0","أَلا قُل لِبُشرَ إِن بِشَراً مُصَبَّحٌ","بِخَيلٍ كَأَمثالِ السَراحينَ شُزَّبِ"],["D97A56C4-7270-58F3-9298-A039A7267A1F","يُقَحِّمُها عَمرو القَنا وَعُبَيدَةٌ","مُفدىً خِلالَ النَقعِ بِالأُمِ وَالأَبِ"],["6D019C4C-E995-5256-8F8A-AF9958B7430B","هُنالِكَ لا تَبكي عَجوزٌ عَلى اِبنِها","فَأَبشِر بِجَدعٍ لِلأُنوفِ مُوَعَّبِ"],["6EE54185-5C0D-5D15-902C-D0C13FB36E45","أَلَم تَرَنا وَاللَهُ بالِغُ أَمرِهِ","وَمَن غالَبَ الأَقدارَ بِالشَرِّ يُغلَبُ"],["06031C9A-30FC-5E7E-8552-24281CD7D26A","رَجِعنا إِلى الأَهوازِ وَالخَيلُ عُكَّفٌ","عَلى الخَيرِ ما لَم تَرمِنا بِالمُهَلَّبِ"]]}}}