{"v":1,"poems":{"FB406A93-39FD-51AA-AB02-82DC80C75A4A":{"t":"أظاعنةٌ ولا تودعنا هندُ","p":38,"s":"أظاعنة ولا تودعنا هند","r":"436133","v":[["ABAEB628-1217-5DF4-BDCD-5DCFBB8E674C","أظاعنةٌ ولا تودعنا هندُ","لِتَحْزُنَنا، عَزَّ التَّصَدُّفُ والكُنْدُ"],["53BF368A-2C24-5D30-ACE1-BC2C38F41A9E","وَ شطتْ لتنأى لي المزارَ وَ خلتها","مُفَقَّدَةً، إِنَّ الحَبيبَ لَهُ فَقْدُ"],["5D6F2D6B-0002-502B-B659-9A87ECF8E4DB","فلسنا بحمالي الكشاحةِ بيننا","لِيُنْسِيَنا الذَّحْلَ الضَّغائنُ والحِقْدُ"],["1A653032-D49F-559A-9271-4B73FF12226B","فَلا فُحُشٌ في دارِنا وصديقِنا","وَ لا ورعُ النهبى إذا ابتدرَ المجدُ"],["7A57F386-FC1A-55BC-93CF-532F8DDB6F8D","وإِنَّا سَواءٌ كَهْلُنا وَوَليدُنا","لنا خلقٌ جزلٌ شمائلهُ جلدُ"],["DD6F5FCB-7020-5048-8778-7B3CD064743F","وَإِنَّا لَيَغْشَى الطَّامِعُونَ بُيُوتَنا","إذا كانَ عوصاً عندَ ذي الحسبِ الرفدُ"],["40E1822B-9207-5296-AFC8-77A29743989A","وَ إني لمنْ قومٍ فأنى جهلتهمْ","مَكَاسِيبَ في يَوْمِ الحَفِيظَةِ للحَمْدِ"],["0FEBFB5E-7FE2-53F1-AB84-326EBCD5F33E","ألا هلْ أتى ذبيانَ أنَّ رماحنا","بِكُشْيَةَ عالَتْها الجِراحةُ والحَدُّ"],["FD7F5F2B-77DE-5E7C-B2A6-2CCF85425333","فأثنوا علينا، لا أبا لأبيكمُ","بإِحسانِنا، إِنَّ الثَّناءَ هُوَ الْخُلْدُ"],["4D6768A7-E2E2-56C5-A11D-C7CD5E970C7E","بمحبسنا يومَ الكفافةِ خيلنا","لنمنعَ سبيَ الحيَّ إذْ كرهَ الردُّ"],["CA1B8679-3A15-5B7D-A1C3-061567AF2687","بمحبسِ ضنكِ والرماحُ كأنها","دَوَالي جَرُورٍ بَيْنَها سلَبٌ جُرْدُ"],["1AF99184-1091-5785-A6B3-6EEC322FB06A","إلى الليْل حَتَّى أُشْرِقَتْ بِنُفوسِها","وَزَيَّنَ مَظْلُومٌ دَوَابِرَها وَرْدُ"],["88E4A07F-9984-5418-AD7E-1EE2AFADBFED","تصبُّ سراعاً بالمضيقِ عليهمُ","وَتُثْنَى بِطاءً لا تُحَشُّ ولا تَعْدُو"],["FAF50086-3063-5444-81F9-666A455AD603","إِذا هيَ شكَّ السَّمْهَرِيُّ نُحُورَها","وَ خامتْ عنِ الأبطالِ أقحمها القدُّ"],["318FCE58-A03B-570F-B8E8-B529C71B002C","سوالفها عوجٌ إذا هيَ أدبرتْ","لِكَرٍّ سَريعٍ فَهْيَ قابِعَةٌ حُرْدُ"]]},"5BFCA723-59AC-5C9B-BA1D-E558E9F33603":{"t":"أمستْ سميةُ صرمتْ حبلي","p":38,"s":"أمست سمية صرمت حبلي","r":"436134","v":[["CE4D01F4-9866-5B0F-80D8-8CA0837A1B8A","أمستْ سميةُ صرمتْ حبلي","وَنأَتْ، وَخالَفَ شَكْلُها شَكْلي"],["2DBE7BF3-5915-5790-A178-CCBF079DB44F","وَعَدا العَوادي عَنْ زِيارَتِها","إلاَّ تلاقينا على شغلِ"],["20D51E48-5E60-5901-8852-B23E9A8F2369","وَرَجاهُمُ يَوْمَ الدَّوارِ كَما","يرجو المقامرُ نيلَ الخصلِ"],["9E7AEE2F-33CC-592B-8D8C-EC3F3F8150FC","وَلقَدْ عَرَفْت لَئن نَأَتْ وَتباعَدَتْ","ألاَّ تلاقيها سني الحسلِ"],["8700E22D-A3C1-59EF-9BE4-3D02F67A5989","فِيئي إِلَيْكِ فَإِنَّني رَجُلٌ","لمْ يخزني حسبي وَ لا أصلي"],["B1F13FFC-3B84-5E4F-91B9-2F4C809EF309","أدعُ الفواحشَ أنْ أسبَّ بها","وَ شريكها فكليهما أقلي"],["38240319-4C61-542B-9E62-15857E488606","وَوَجَدْتُ آبابي لَهُمْ خُلُقٌ","عَفُّ الشَّمائِل غَيْرُ ذي دَخْلِ"],["98661C6C-0B9C-526B-A2BD-0156161F06F7","لو تَصْدُقينَ لَقُلْتِ إِنَّهُمُ","صُبُرٌ على النَّجَداتِ والأَزْلِ"],["36CF2337-35E2-583D-9E19-F881ED65FA92","و على الرزيةِ منْ نفوسهم","وَ تلاتلِ اللزباتِ والقتلِ"],["5C69BC47-717C-5F3E-B32B-D759F3654BC4","هَلاَّ سَأَلْتِ إِذا هُمُ احْتَمَلُوا","فَتَحَوَّلُوا لِخَطِيطَةٍ مَحْلِ"],["20205E41-2A4A-5A0E-A3ED-AC80600C3A0E","يُعْيي الرِّعاءَ بها مَسارِحُهُمْ","وَجَفَتْ مَراتِعُها عَنِ البُزْلِ"],["99C211C0-DB31-5E3B-BC0F-075CE4763808","إذْ لا يدنسنا الشتاء وَ لا","نطأُ الضعيفَ إرادةَ الأكلِ"],["726BF0E0-C6FA-54F2-B5C0-10765CEA629B","وَيُنَفِّسونَ عَن المُضاف إِذا","نظرَ الفوارسُ عورةَ الرجلِ"],["ECAB051C-8C72-54FF-9858-FB8A5AEDDCE0","المُقْبِلينَ نُحورَ خَيْلِهم","حدَّ الرماحِ وَ غبيةَ النبلِ"]]},"7F9970A6-EB19-598B-AE46-E8CE79DE720D":{"t":"أَخذوا قِسِيَّهُمُ بأَيْمُنِهِمْ","p":38,"s":"أخذوا قسيهم بأيمنهم","r":"436144","v":[["B88ECBD2-45CC-54F3-88DF-F013C759E167","أَخذوا قِسِيَّهُمُ بأَيْمُنِهِمْ","يتعظلون تعظلَ النمل"],["AD7664FD-35BC-51B1-91B2-A1E98F6155A6","وَ ترى الذميمَ على مراسنهمْ","غبَّ العجاجِ كمازنِ الجثل"]]},"099F0F1E-3FEC-5268-ADE5-F4CFC9F407BC":{"t":"بكرتْ سميةُ غدوةً فتمتعِ","p":38,"s":"بكرت سمية غدوة فتمتع","r":"436132","v":[["A993C2CD-3E08-568A-9885-656217506C47","بكرتْ سميةُ غدوةً فتمتعِ","وَغَدَتْ غُدُوَّ مُفارقٍ لَمْ يَرْجِعِ"],["34548009-FC64-5AFE-B423-300FE3228726","وَ تزودتْ عيني غداةَ لقيتها","بلوى عنيزةَ نظرةً لم تنفعِ"],["3720DE80-200A-55FD-992D-E207378023B8","وَ تصدفتْ حتى استبتكَ بواضح","صلتٍ كمنتصبِ الغزال الأتلعِ"],["099ABE8C-8D46-57A7-B588-0B8E64AA9BDC","و بمقلتيْ حوراءَ تحسبُ طرفها","وَ سنانَ، حرةِ مستهلَّ الأدمعِ"],["F1B310ED-80CA-5EEB-A2B6-5C437A60CFB0","وإِذا تُنازعُكَ الحديثَ رَأَيْتَها","حسناً تبسمها لذيذَ المكرعِ"],["ED2E8065-5B85-5C6D-B956-44DB8C046648","كغريضِ ساريةٍ أدارتهُ الصبا","مِنْ ماءِ أَسْجَرَ طَيِّبِ المُسْتَنْقَعِ"],["C03F99E3-80D7-57BF-9A63-339FDB4A874C","ظَلَمَ البِطاحَ به انْهلالُ حَريصَةٍ","فصفا النطافُ بها بعيدَ المقلعِ"],["45599B4E-4935-56F8-9672-F77873C78243","لعبَ السيولُ به فأصبحَ ماؤهُ","غللاً تقطعَ في أصول الخروعِ"],["96581E04-E63F-59CB-8720-8D8D96306C54","فسميَّ، ويحكِ! هلْ سمعتِ بغدرةٍ","رفعَ اللواءُ بها لنا في مجمعِ"],["D5CA5E94-EDD0-5463-AD0D-F83B4BDAB55E","إِنَّا نَعِفُّ فَلا نَريبُ حليفَنا","ونَكُفُّ شُحَّ نفوسنا في المَطْمَع"],["30574AFA-4759-5748-9BE6-5338F90AD8BE","وَ نقي بآمن مالنا أحسابنا","وَنُجِرُّ في الهَيْجا الرِّماحَ وَنَدَّعي"],["666EE301-730E-5B46-9AF9-9790335C61D8","وَ نخوضُ غمرةَ كلَّ يوم كريهةٍ","تردي النفوسَ وَ غنمها للأشجعِ"],["43BB9F59-EB24-5DF0-9097-CE72B65E8FEA","وَ نقيمُ في دار الحفاظ بيوتنا","زَمَناً، وَيَظْعَنُ غَيْرُنا للأَمْرَعِ"],["36F44763-957E-500D-9647-8F205CA8F194","بسَبيل ثَغْرٍ لا يُسَرِّحُ أَهْلُه","سَقِمٍ يُشارُ لقاؤهُ بالإِصبَعِ"],["4C3B1EFB-884C-57A5-9EB2-68FE399903ED","فسميَّ ما يدريكِ أنْ ربَ فتيةٍ","باكرتُ لذتهمْ بأدكنَ مترعِ"],["8748BD05-9156-597C-AD35-FE4D67EDF1DB","محمرةٍ عقبَ الصبوح عيونهم","بمرىً هناكَ منَ الحياة وَ مسمع"],["F8C0D1BC-6408-5231-8662-5D88144E86E2","مُتَبَطِّحينَ على الكَنيف كَأَنَّهُمْ","يبكونَ حولَ جنازةٍ لمْ ترفعِ"],["83FCCD8A-D47F-5474-84E2-68E1DCDFBBA4","بَكَرُوا عَليَّ بسُحْرَةٍ فَصَبَحْتُهُم","منْ عاتقٍ كدم الذبيح مشعشعِ"],["D290C925-228A-59FF-BAE5-1F1DE5AF5FC9","وَ معرضٍ تغلي المراجلُ تحته","عجلتُ طبختهُ لرهط جوعِ"],["409447E3-1A54-5DBF-8299-59F549EAEDEC","وَ لديَّ أشعثُ باذلٌ ليمينه:","قسماً لقدْ أنضجتَ، لمْ يتورعِ"],["AC936DF9-20B7-56AF-AC94-0442DFC89EEC","وَ مسهدينَ منَ الكلال بعثتهم","بعدَ الرقاد إلى سواهمَ ظلعِ"],["D22E21C4-9B93-5BF3-9D6F-80D94DB5E2D8","أَوْدَى السِّفارُ برِمِّها فَتخالُها","هيماً مقطعةً حبالَ الأذرعِ"],["F1F000C9-D649-572A-9EAF-F081A396E920","تخدُ الفيافي بالرحال وكلها","يعدو بمنخرق القميص سميدعِ"],["AFBDBBEB-BD45-57B0-A05E-26B2A2FA9092","وَ مطيةٍ حملتُ رحلَ مطيةٍ","حَرَجٍ تُتَمُّ مِنَ العِثارِ بِدَعْدَع"],["1ADF05F1-920C-5DAA-86FB-3624359FD069","وَ مناخِ غيرِ تئيةٍ عرستهُ","قَمِنٍ مِنَ الحِدْثان نابي المَضْجَعِ"],["D80EB2F2-BCE1-5857-BE3E-0AFAFDD190F4","عَرَّسْتُهُ وَوِسادُ رَأْسِي ساعِدٌ","خاظي البَضيعِ عُروقُهُ لم تَدْسَعِ"],["F7E315D5-52B8-50B4-9691-09D7D7A0D8CB","فَرَفَعْتُ عنْهُ وهو أَحْمَرُ فاتِرٌ","قَدْ بان مِنِّي غَيْرَ أَنْ لَمْ يُقْطَعِ"],["3CB87805-38E3-5F2F-AEAC-15DA3D8D77B5","فَتَرَى بِحَيْثُ تَوَكَّأَتْ ثَفِناتُها","أثراً كمفتحصِ القطا للمضجعِ"]]},"1BC9423A-B0C6-5ACE-AE81-818D61658418":{"t":"تَرَكْتَ رَفيقَ رَحْلِكَ قَدْ تَرَاهُ","p":38,"s":"تركت رفيق رحلك قد تراه","r":"436139","v":[["62064F0B-3353-5F64-832E-1737E586E34E","تَرَكْتَ رَفيقَ رَحْلِكَ قَدْ تَرَاهُ","وَ أنتَ لفيكَ في الظلماءِ هادِ"]]},"84231CCC-F47E-5052-BFA3-2DF7C86F3BA6":{"t":"ذَكَرْتُ اليَوْمَ داراً هَيَّجَتْني","p":38,"s":"ذكرت اليوم دارا هيجتني","r":"436140","v":[["7A7A04AA-C055-5907-B519-4142CE53B1B2","ذَكَرْتُ اليَوْمَ داراً هَيَّجَتْني","لزبانَ بنِ سيارِ بنِ عمرو"],["07FF18BD-3479-511E-B311-CF28356E6468","لَيالِيَ تَسْتَبيكَ بِجيدِ رِئمٍ","و مفلوق عليهِ الفرمُ يجري"]]},"2C29FD79-DE26-5EEB-90FB-75232296B61D":{"t":"سَمْحَ الخَلائقِ مِكْراماً ضَريبَتُهُ","p":38,"s":"سمح الخلائق مكراما ضريبته","r":"436143","v":[["7454BB8F-31E9-54EB-AE0C-4667EB67365F","سَمْحَ الخَلائقِ مِكْراماً ضَريبَتُهُ","إذا تهشمتهُ للنائلِ اختالا"]]},"4B3DDFF9-547D-5A07-A5B7-4DB37EB5C129":{"t":"فقلتُ تزردها يزيدُ فإنني","p":38,"s":"فقلت تزردها يزيد فإنني","r":"436138","v":[["7BF7757A-AF03-5C2B-866B-C32726D297FF","فقلتُ تزردها يزيدُ، فإنني","لِدُرْدِ المَوالي في السِّنينَ مُزَرِّدُ"]]},"D31CBC84-AE9D-56C1-B62B-0A299A884966":{"t":"كَأَنَّ عُقَيْلاً في الضُّحى حَلَّقَتْ بِهِ","p":38,"s":"كأن عقيلا في الضحى حلقت به","r":"436135","v":[["0CBFB253-D487-5264-B1B2-D5E23DACEB1B","كَأَنَّ عُقَيْلاً في الضُّحى حَلَّقَتْ بِهِ","وطارتْ بِهِ في الجَوِّ عَنْقاءُ مُغْرِبُ"],["ACA5E3DA-0F6F-5BD9-B963-48E077E189BA","وَذي كَرَمٍ يَدْعوكُمُ آل عامِرٍ","لدى معركٍ سربالهُ يتصببُ"],["CB0AA667-E6E1-5055-9CD8-320F99A66A64","رَأَتْ عامِرٌ وَقْعَ السُّيوفِ فَأَسْلَمُوا","أَخاهُمْ وَلمْ يَعْطِفْ من الخيل مُرْهِبُ"],["C49DD9C0-6D8D-5684-A51E-326E5E354DC9","وَسَلَّمَ لمَّا أَنْ رَأَى المَوْتَ عامِرٌ","لهُ مركبٌ فوقَ الأسنةِ أحدبُ"],["222694F7-33DC-506D-8970-D9B78936F7B2","إذا ما أظلتهُ عوالي رماحنا","تَدَلَّى بهِ نَهْدُ الجُزارَةِ مِنْهَبُ"],["79896EEF-980C-54FA-AB07-255226B88AD2","على صلويهِ مرهفاتٌ كأنها","قَوَادِمُ نَسْرٍ بُزَّ عَنْهُنَّ مَنْكِبُ"]]},"80D7750A-94CB-5AEF-AFD7-EBCCC7E7EE92":{"t":"كَم للمَنَازل مِنْ شَهْرٍ وأَعْوامِ","p":38,"s":"كم للمنازل من شهر وأعوام","r":"436145","v":[["A4B74127-02A6-5413-8C9A-A957917D0A0C","كَم للمَنَازل مِنْ شَهْرٍ وأَعْوامِ","بالمنحنى بينَ أنهارٍ وآجامِ"],["79D2AA8A-5CB2-5227-89DB-FE903FF8AD42","مضى ثلاثُ سنينٍ منذُ حلَّ بها","و عامَُ حلتْ وهذا التابعُ الخامي"]]},"7C4E0033-C132-57F0-B655-6CB46B54CD7C":{"t":"لعمرةَ بينَ الأخرمينِ طلولُ","p":38,"s":"لعمرة بين الأخرمين طلول","r":"436142","v":[["76F53DD1-ED35-5D98-8C7E-631837DE985B","لعمرةَ بينَ الأخرمينِ طلولُ","تَقادَمَ مِنْها مُشْهِرٌ ومُحيلُ"],["18C7E60A-D304-5DD9-88B5-3B71C082A316","وقفتُ بها حتى تعالى ليَ الضحى","لأخبرَ عنها، إنني لسؤولُ"],["FBECD1A2-F18D-5F7D-B495-758954FEDBF6","فَإِنْ تَحْسَبوها بالحجاب ذَليلَةً","فما أنا يوماً إنْ ركبتُ ذليلُ"],["3079C50F-F7B4-5A0C-81DB-41BBB8E0B5C0","سأمنعها في عصبةٍ ثعلبية","لَهُمْ عَدَدٌ وَافٍ وَعِزٌّ أَصيلُ"],["7833030D-1428-5226-BA8A-A5884728C4BE","فإِنْ شِئْتُمُ عُدْنا صَديقاً وعُدْتُمُ","وَ إما أبيتم فالمقامُ زحولُ"]]},"9FDAECA4-A84D-55D4-B225-D7D1C3DC446D":{"t":"لعمركَ لا أهجو منولةَ كلها","p":38,"s":"لعمرك لا أهجو منولة كلها","r":"436131","v":[["412852DF-08A9-5B5A-8D4A-35CFEBA112A0","لعمركَ لا أهجو منولةَ كلها","ولكنَّما أَهجو اللئامَ بني عَمْرِو"],["E2560B13-6402-5B6E-8C58-1D4609626304","مَشاتِيم لابنِ العَمِّ في غَيْر كُنْهِهِ","مَباشيم عن لَحْم العَوارض والتَّمْرِ"],["1213216A-83FD-524E-B791-9A43192B89F9","مَفاريط للْماءِ الظَّنونِ بسُحْرَةٍ","تغاديكَ قبلَ الصبح عانتهمْ تجري"],["71BB663A-4C13-54F8-9134-9381926FB65F","يُزَجُّونَ أَسْدامَ المياه بأَيْنُقٍ","مثاليبَ، مسودًّ مغابنها، أدرِْ"]]},"C53A1105-7CD3-59C1-9E14-495AB97FA3CD":{"t":"لَحا اللَّهُ زَبَّانَ مِنْ شاعرٍ","p":38,"s":"لحا الله زبان من شاعر","r":"436130","v":[["2FCAC350-EB00-5AAF-9EC0-CCB44209F828","لَحا اللَّهُ زَبَّانَ مِنْ شاعرٍ","أخي خنعة غادرٍ فاجرِ"],["A1F298C2-5998-597A-8187-2D7C414ECB48","كأنكَ فقاحةٌ نورتْ","مَعَ الصُّبْح في طَرَفِ الحائرِ"]]},"847FFB1B-09BF-5160-968B-24EA7E5AB863":{"t":"و منشقَّ أعطافِ القميصِ كأنه","p":38,"s":"و منشق أعطاف القميص كأنه","r":"436137","v":[["6B9AB95E-A55E-5190-B583-407541334D1F","و منشقَّ أعطافِ القميصِ كأنه","إِذا لاحَتِ الظَّلْماءُ نارٌ تَوَقَّدُ"],["8F345BC7-B0E8-532B-B4FF-5065B902B2E1","فتًى لا يَنالُ الزَّادَ إِلاَّ مُعذِّراً","كأَعْلى سِنانِ الرُّمْح بل هو أَنْجَدُ"]]},"A8B170B0-289B-5C7A-A2BD-3506B3478309":{"t":"وَ تقي إذا مستْ مناسمها الحصى","p":38,"s":"و تقي إذا مست مناسمها الحصى","r":"436141","v":[["94E51A6F-0868-58A8-AB1B-7E6752D85C66","وَ تقي إذا مستْ مناسمها الحصى","وجعاً وإنْ تزجرْ بهِ تترفعِ"],["C29DC1CA-0B30-5DA6-9E62-B84B75B6F4B8","وَ متاعِ ذعلبة تخبُّ براكبٍ","ماضٍ بشيعتهِ وَ غيرِ مشيعِ"],["9607DA90-E6D6-5378-9C38-AED04DA94315","وَمَحَلِّ مَجْدٍ لا يُسَرِّحُ أَهْلُه","يومَ الإقامةِ والحلولِ لمرتعِ"]]},"25334408-DDE5-5652-A006-959576C2B10B":{"t":"وَ نحنُ منعنا منْ تميمٍ وَ قدْ طغت","p":38,"s":"و نحن منعنا من تميم و قد طغت","r":"436136","v":[["EF836B67-B76D-5646-A98D-D9A0773BDF34","وَ نحنُ منعنا منْ تميمٍ وَ قدْ طغت","مَراعي المَلا حتى تَضَمَّنَها نَجْدُ"],["1B32F466-ACFB-51CF-95A2-380563B5F0BF","على حينَ شالتْ واسْتَخَفَّتْ رجالَهُمْ","جلائبُ أَحياءٍ يَسِيلُ بها الشَّدُّ"]]}}}