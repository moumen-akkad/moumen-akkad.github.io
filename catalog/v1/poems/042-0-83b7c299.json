{"v":1,"poems":{"89CB574A-93D6-56D7-BB9E-71F7C8E71B66":{"t":"أعددتُ للحربِ فَضْفَاضَةً","p":42,"s":"أعددت للحرب فضفاضة","r":"440737","v":[["29A57BA7-D68F-50BB-B265-367EEBAB3597","أعددتُ للحربِ فَضْفَاضَةً","دِلاصاً تَثَنَّى على الرَّاهِشِ"],["2088B55A-C27A-59B0-AD8A-29108DD9C7DA","وأجْرَدَ مُطَّرِداً كالرِّشاءِ","وسَيفَ سَلاَمَةَ ذهي فائِشِ"],["B61E2C70-2977-5158-88EF-FB24BD7728D1","وعِزٍّ يَفُوتُ يَدَ النَّاهِشِ","بَرَتْها رُماةُ بَنِي وابِشِ"],["BCC3BD0B-5EA7-5A97-AA6F-A94279B26DD2","وكلَّ نَحِيصٍ فَتيقِ الغِرارِ","عَزُوفٍ على ظُفُرِ الرائشِ"],["0D87F9BE-51D3-585E-813D-2F099E8CB4BE","وأجْرَدَ سَاطٍ كشاة الإرا","نِ رِيْعَ فَعَنَّ على النَّاجِشِ"],["0A9D0578-96BE-5AC6-A212-A79F7584E066","تَمَتَّعْتُ ذاكَ وكنتُ أمرأً","أصُدُّ عن الخُلُقِ الفاحشِ"]]},"05335905-3195-5527-BD50-A24665717702":{"t":"أمِنْ رَيْحانةَ الدَّاعي السَّميعُ","p":42,"s":"أمن ريحانة الداعي السميع","r":"440738","v":[["99E833BD-D612-5A9C-AAA8-A66700791265","أمِنْ رَيْحانةَ الدَّاعي السَّميعُ","يُؤرِّقُنِي وأصحابي هُجوعُ"],["4A542661-E431-596D-8B7C-972AF320D964","يُنادِي مِن بَرَاقِشَ أو مَعِينٍ","فأسْمَعَ واتْلأَبَّ بنا مَلِيْعُ"],["5B58609F-2220-5D4F-9683-D26CC50FB2FA","وقد جاوزْنَ من غُمدانَ داراً","لأبوالِ البغال بها وَقيعُ"],["837E4A2E-F3E6-51A3-AA9B-B15FD4E2BA38","وَرُبَّ مُحَرَّشٍ في جَنْبِ سلمى","يُعَلُّ بِعَيْبِها، عندي، شفيعُ"],["AA0D4483-8701-58B8-BDCD-8889A1E6E847","كأنَّ الأثْمِدَ الحارِيَّ فيها","ُيَسُّف بحيثُ تَبْتَدِرُ الدُموعُ"],["2F5D84BA-35D1-5129-B520-ABCA271118B8","وأبكارٍ لَهَوْتُ بِهنَّ حيناً","نواعمَ في أسرَّتِها الرُّدُوعُ"],["545B24E9-061C-5305-854F-43C928C1C5D1","أُمشِّي حولَها وأطوف فيها","وتُعجبني المَحاجِرُ والفُزوعُ"],["FCEB13E9-45E2-5C33-8B17-1F3ECF901BCE","إذا يَضحكنَ أو يَبْسِمْن يوماً","تَرَى بَرَداً ألَحَّ به الصَّقيعُ"],["8FB6D05A-3DD4-542E-A5F1-CC6F744ECDBE","كأنَّ على عَوارِضِهنَّ راحا","يُفَضُّ عليه رُمَّانٌ يَنِيْعُ"],["A46E0DE0-A1C5-5C7B-B6C8-091D44444D19","تَراها الدَّهْرَ مُقْتِرَةً كِباءً","وتَقدحُ صَحْفةً فيها نَقيعُ"],["A8C61BC9-200B-5F84-8966-560FBBB43014","وصِبْغُ ثيابها في زَعْفَرانٍ","بِجُدَّتِها كما احْمرَّ النَّجيعُ"],["7C5FA389-CC5E-5E22-BD39-BF0E83ADA813","وقد عجِبتْ أمامةُ أنْ رأتني","تَفَرَّعَ لِمَّتِي شَيْبٌ فَظيعُ"],["D570817D-F47C-5A00-8252-F06B8A1B7327","وقد أغْدُو يُدَافعني سَبُوحٌ","شديدٌ أسْرُه فَعْمٌ سَرِيعُ"],["FC66D3BF-35BE-53E4-B167-1E2DA3EE4737","وأحْمِرَةُ الهُجَيْرَةِ كلَّ يومٍ","يَضُوْعُ جِحاشَهُنَّ بما يَضُوْعُ"],["6A161969-1EAF-5F61-BC3B-AD2F9AE6870C","فأرسَلْنَا رَبِيئَتَنَا فأوْفَى","فقال: ألا أُولى خَمْسٌ رُتُوعُ"],["2382E95A-F19C-5B6C-8430-3AC49163D5C2","رَبَاعِيَةٌ وقاِرحُها وجَحْشٌ","وهاديةٌ وتاليةٌ زَمُوعُ"],["291B1D73-D32C-5DC8-B118-6415010FCE9E","فنادانا: أنَكْمُنُ أم نُبادي؟","فلما مَسّ حالِبَهُ القَطيعُ"],["776DAA35-FE3B-5B08-8165-4C08045663C1","أَرَنَّ عَشيَّةً فاستعجَلَتْهِ","قوائمُ كلُّها رَبذٌ سطُوعُ"],["1859BC3E-8F7A-5F2F-B6D6-A09F3C888D51","فأوفى عندَ أقصاهُنَّ شخصٌ","يلوحُ كأنه سيفٌ صَنِيعُ"],["222572D3-CF43-5938-9A65-31D283A5FE1E","تَرَاهُ حين يَعْثُرُ في دماءٍ","كما يمشي بأقْدُحِهِ الخَليعُ"],["E76862E6-7B4B-5167-9531-86FB31F15A9A","أشابَ الرأسَ أيّامٌ طِوالٌ","وَهَمَّ ما تَبَلَّغُهُ الضُلوعُ"],["26C53924-CE98-5933-B8F1-E2850A5F3BE7","وسَوْقُ كَتيبةٍ دَلفَتْ لأخْرَى","كأنَّ زُهاءَها رأسٌ صَلِيعُ"],["4DDE9376-A7F4-5E68-B772-65325911BC0C","دَنَتْ واستأْخَرَ الأوغالُ عنها","وخُلِّيَ بينهم إلاَّ الوَرِيعُ"],["B258778F-9690-525E-AA09-0A753A2ACC9B","فِدىً لهمُ معاً عَمِّي وخالي","وشَرخُ شبابهِم إنْ لم يُضِيعُوا"],["0559EA4D-52BD-5A99-8D3E-53D20C06FF09","وإسنادُ الأسِنَّةِ نحوَ نَحْري","وهَزَّ المَشْرَفِيَّةِ والوُقوعُ"],["185F601B-E5F2-5B52-8154-9DC7B4BC228F","فإنْ تَنُبِ النَّوائِبُ آلَ عُصْمٍ","تُرَى حَكَماتُهمْ فيها رُفُوعُ"],["9A6755B6-D9A1-5F76-84DF-A131BE69D014","إذا لم تستطعْ شيئاً فَدَعْهُ","وجاوِزْهُ إلى ما تستطيعُ"],["2C948EA9-451C-520B-A6CD-0158D0231118","وَصِلْهُ بالزِّماعِ فكلُّ أمرٍ","سَمَا لكَ أو سَمَوْتَ له وَلُوعُ"],["59E6A4EA-D592-503B-867F-C1367791FD8A","فكمْ مِن غائِطٍ مِنْ دُونَ سَلْمَى","قليلِ الأُنْسِ ليس به كَتِيْعُ"],["D7492FD2-CE4A-5AB7-942D-9BBB82BB61B6","به السِّرحانُ مفترشاً يديه","كأنَّ بياضَ لَبَّتِه الصَّدِيعُ"],["C6B88B85-E796-550A-B884-E3CDD9A40D14","وأرضٍ قد قطعتُ، بها الهَوَاهي","من الجِنَّانِ، سَرْبَخُها مَلِيعُ"],["456B95AC-3538-5C88-B230-3E894F7EED9D","تَرَى جِيَفَ المَطِيِّ بحافَتَيْه","كأنَّ عِظامَها الرَّخَمُ الوُقُوعُ"],["094FF1B7-EDDB-5385-AAB4-5B67FBDB7CAE","لَعَمْرُكَ ما ثلاثٌ حائماتٌ","على رُبَعٍ يَرِعْنَ وما يَرِيعُ"],["DD81DF4C-1CE4-54D4-B9CE-4F81E9DEF103","ونابٌ ما يَعِيشُ لها حُوارٌ","شديدُ الطَّعْنِ مِثْكالٌ جَزُوعُ"],["D636364B-5F3E-504B-BCC8-048FA7F4D837","سَدِيسٌ نَضَّجَتْهُ بعدَ حَمْلٍ","تَحَرَّى في الحَنينِ وتَسْتَلِيْعُ"],["0E514A03-B23F-563E-8260-706F6EB5586D","بأَوْجَعَ لَوْعًة منِّي وَوَجْداً","غداةَ تَحَمَّلَ الأنَسُ الجَميعُ"],["D22BC50C-12C3-5687-ABE0-9CAEA49DFC93","فإمَّا كنتِ سائلةً بمُهْرِي","فمُهْرِي إن سألتِ به الرَّفِيعُ"]]},"6CB97BD6-C38B-56CE-AF35-45D9F5DAD36F":{"t":"أَخْبَرَ المُخْبِرُ عنكم أنكم","p":42,"s":"أخبر المخبر عنكم أنكم","r":"440741","v":[["3F70239A-FAE1-5E9F-9583-A964DF1DFACC","أَخبَرَ المُخبِرُ عنكم أنكم","يومَ فَيفِ الريحِ أُبتُم بالفَلَج"]]},"6393ED86-DF22-5B64-8098-436B4A016CDE":{"t":"الحَرْبُ أوّلَ مَا تَكونُ فُتَيّةً","p":42,"s":"الحرب أول ما تكون فتية","r":"440739","v":[["195064A6-A4CB-5629-B302-E86487A744DA","الحَرْبُ أوّلَ مَا تَكونُ فُتَيّةً","تَبْدُو بِزِينَتِهَا لِكُلّ جَهُولِ"],["8EFBF215-6C9A-50F0-81E5-EF70AB5176C1","حتى إذا حَمِيّتْ وَشُبّ ضِرَامُها","عادتْ عجوزاً غيرَ ذاتِ خليلِ"],["C7A40D0C-FB1B-519A-B3A5-BC53324D94B4","شَمطاءُ جَزّتْ رَأسَها وَتَنَكّرَتْ","مكروهةً للشَّمِّ والتقبيلِ"]]},"7B3FE672-CC67-5349-B397-A18081D802ED":{"t":"تَطَاوَلَ لَيْلُكَ بالأثْمُدِ","p":42,"s":"تطاول ليلك بالأثمد","r":"440742","v":[["99D82442-1EED-53BA-82D9-ED2C23D1803A","تَطَاوَلَ لَيْلُكَ بالأثْمُدِ","ونَامَ الخَلُيُّ، وَلَمْ تَرْقُدِ"],["6812FC55-7D30-5E16-8C5D-D59A63A587FF","وَباتَ وَباتَتْ لَهُ لَيْلَةٌ،","كَلَيْلَةِ ذِي العائِرِ، الأرْمَدِ"],["DE6097B7-7FCB-57A2-841E-B4245A09CE06","وذلكَ من نَبَأٍ جاءني","وَخُبِّرْتُهُ عَنْ أبي الأسْوَدِ"],["8DF5A163-D3E4-5677-A015-53BBC977C5D2","وَلَوْ عَنْ نَثَا غَيْرِه جاءَني،","وَجَرْحُ اللِّسانِ كَجُرْحِ اليَدِ،"],["F74529FE-BB0C-50C9-9091-07018E27E3F1","لَقُلْتُ، مِنَ القَوْلِ، ما لا يَزَا","لُ يُؤْثَرُ عَنِّي، يَدَ المُسُنَدِ"],["E93F2EBA-F555-5C0E-B867-C7D79F18CD11","بأيِّ علاقتنا ترغبونَ","أعَنْ دَمِ عَمْرٍو على مَرْثَدِ؟"],["4AF89E83-AF63-5975-8D13-077DA7AF7522","فإنْ تَدْفِنوا الداءَ لا نُخْفِهِ","وَإنْ تَبْعَثُوا الحرْبَ لا نَقْعُدِ"],["96A0090C-FF71-5498-BAA0-9EE13C2C1CCE","فإنْ تَقُتُلُونا نُقَتِّلْكُمُ؛","وَإنْ تَقْصِدُوا لِدَم نَقْصِدِ"],["AB634B2D-E6A7-559D-A701-B6EA987957A6","متى عَهْدُنا بطِعانِ الكُما","ةِ، وَالحَمدِ والمَجْدِ وَالسُّؤدُدِ"],["7BF861C4-2B99-5BC5-919E-AD56F528A870","وَبَنْيِ القِبابِ، وَمَلْءِ الجِفا","نِ والنَّارِ والحَطَبِ المُفْأدِ"],["E3EFDAFD-74DB-5B8F-9CDD-DB757C48D833","وَأعْدَدْتُ، لِلْحَرْبِ، وَثَّابَةً،","جوادَ المحَثَّةِ والمَرْوَدِ"],["D72C6A60-433C-58CF-8C6C-BC7D1304EECD","سَبُوحاً، جَمُوحاً، وَإحْضارُها","كَمَعْمَعَةِ السَّعَفِ المُوقَدِ"],["E71C2F56-861F-5DD6-94F6-6E9027958979","وَمَشدُودَةَ السَّكِّ مَوْضُونَةً","تَضاءَلُ في الطَّيِّ، كالمِبْرَدِ"],["26025B49-639A-5BDF-9A53-222E1E965840","تَفِيضُ عَلى المَرْءِ أرْدانُها،","كفَيْضِ الأتِيِّ على الجَدْجَدِ"],["376D91ED-59D3-573A-B7CB-85010115E9BF","وَمُطّرِداً كَرِشاءِ الجَرُو","رِ، مِنْ خُلُبِ النَّخْلَةِ الأجْرَدِ"],["4E5F7FE6-D7E5-58D5-BBEA-9DCA02B6605C","وذا شُطَبٍ غامضاً كَلْمُهُ","إذا صالَ بِالعظْمِ لَم يَنْأدِ"]]},"A2450068-0D10-5C90-8869-E43142356D47":{"t":"قومٌ إذا سمعوا الصَّرِيخَ رأيتَهم","p":42,"s":"قوم إذا سمعوا الصريخ رأيتهم","r":"440743","v":[["B1D296B7-D4CE-5428-8BA2-9B3EAD8388F4","قومٌ إذا سمعوا الصَّرِيخَ رأيتَهم","مِن بَينِ مُلْجِمِ مُهْرِهِ أو سافِعِ"]]},"A4F544B4-538B-51E8-B3C9-85192C845F72":{"t":"لَقِيْتُ أبا شأسٍ وشأساً","p":42,"s":"لقيت أبا شأس وشأسا","r":"440736","v":[["D47D89CB-C760-5A67-B245-AE4479C33957","لَقِيْتُ أبا شأسٍ وشأساً ومالكاً","وقيساً فجاشَتْ من لقائِهِمُ نفسي"],["83FC24B5-0017-533E-9285-D30F5C947731","لَقُوْنا فضمُّوا جانبَيْنا بصادقٍ","من الطَّعنِ حَشّ النارِ في الحطبِ اليَبْس"],["01C59D50-2787-5AE0-914F-6B3427891F8E","كأنَّ جُلُودَ النُّمْرِ جِبيَتْ عليهِمُ","إذا جَعْجَعُوا بينَ الإناخة والحَبْسِ"],["9868DFF6-B75E-5766-AA70-B684E2974225","ولمّا دخلنا تحت فِيْءِ رماحهمْ","خَبَطْتُ بكفّي أطلبُ الأرْض باللّمسِ"],["B567919C-C483-5774-9EF2-45C2FDC55922","فأُبْتُ سَليماً لم تُمَزَّقْ عِمامتي","ولكنّهم بالطّعنِ قد خرّقوا تُرْسي"],["D052DFC8-9DE0-53CF-B4FF-0287E2F90994","وَليسَ يُعابُ المرْءُ من جُبنِ يوْمِهِ","إذا عُرِفَتْ منه الشجاعةُ بالأمسِ"]]},"4848C8A4-C72B-5287-BAFA-AB63B6442407":{"t":"ومُرْدِ على جُرْدٍ شَهِدْتُ طِرَادَهَا","p":42,"s":"ومرد على جرد شهدت طرادها","r":"440735","v":[["64E1398C-6C54-578A-9E8D-09786E1FF73C","ومُرْدِ على جُرْدٍ شَهِدْتُ طِرَادَهَا","قُبَيَلَ طُلوعِ الشمسِ أو حينَ ذَرَّتِ"],["AC367EF9-C437-5376-9417-BE02EF776F5A","صَبَحْتُهُمُ بَيْضَاءَ يَبْرُقُ بَيْضُها","إذَا نَظَرَتْ فيها العُيُونُ ازْمَهَرَّتِ"],["70E9763E-3C81-5481-8849-954EC63B2FC3","ولمَّا رأيتُ الخيلَ رَهْواً كَأنَّها","جَدَاوِلُ زَرْعٍ أُرْسِلَتْ فاسْبَطَرَّتِ"],["90FE1158-BBBB-51AD-9F69-F848FD1F5544","فَجَاشتْ إليَّ النفسُ أوَّلَ مرّةٍ","فَرُدَّتْ على مَكروهها فاسْتَقَرَّتِ"],["BF2522A2-51F2-59FD-881A-313B04447831","عَلامِ تقولُ الرُمْحُ يُثْقِلُ عاتقي","إذا أنا أطعن إذا الخيلُ كَرَّتِ؟"],["AC39D39C-C82B-5126-A949-FF6BF9ACDEE4","عَقَرْتُ جوادَ ابْني دُرَيْدٍ كليهما","ومَا أخَذَتْنِي في الخُتُونَةِ عِزَّتي"],["52A508D4-81A3-529D-B3CC-D198C187F2A6","لَحَا الله جَرْماً كلَّما ذَرَّ شارِقٌ","وُجُوهَ كلابٍ هارَشَتْ فازْبَأرَّتِ"],["2D6EB6DD-7B87-523A-B7A0-B74310A9119D","ظَلِلْتُ كأنِّي للرِّماح دَريئةٌ","أُقاتِلُ عن أبناءِ جَرْمٍ وفَرِّتِ"],["E6131FF6-574D-5532-BDC0-73AC96F32F7C","فلم تُغْنِ جَرْمٌ نَهْدَهَا إذ تَلاقَتا","ولكنَّ جَرْما في اللقاء ابْذَعَرَّتِ"],["707BF168-76D5-5811-BD3C-A019FE937B7F","فلو أنَّ قومي أنطقتْني رماحُهم","نَطَقْتُ، ولكنَّ الرماحَ أجَرَّتِ"]]},"D6F26449-F1D5-5164-B9DD-ED0B3DC88295":{"t":"يا دارَ أسماءَ بين السَفْحِ فالرُّحَبِ","p":42,"s":"يا دار أسماء بين السفح فالرحب","r":"440734","v":[["6354029C-7476-5ED1-B80F-672A5431B1A5","يا دارَ أسماءَ بين السَفْحِ فالرُّحَبِ","أقْوَتْ وعَفَّى عليها ذَاهِبُ الحقبِ"],["328F16A1-F59C-510D-9A5E-9F19A6F3465E","فما تَبَيَّنَ منها غيرُ مُنْتًضَدٍ","وراسياتٍ ثلاثٍ حولَ مُنْتَصِبِ"],["A7390303-FE3C-5B44-8BA4-60570220C9D2","وعَرْصَةُ الدارِ تَسْتَنُّ الرِّيَاحُ بِها","تَحِنُّ فيها حَنينَ الوُلَّهِ السُّلُبِ"],["4A7A3F12-6524-5112-AE0F-6A088189E058","دَارٌ لأسْمَاءَ إذْ قلبي بها كَلِفٌ","وإذ أُقَرِّب منها غيرَ مُقترِبِ"],["BA17B3B1-F923-5527-AF46-FC646BA379DA","إنَّ الحبيبَ الذي أمسيتُ أهجرُهُ","من غيرِ مَقْلِيَةٍ مِنِّي ولا غَضَبِ"],["D050AB97-0537-54BB-8260-E3AA9936B4E0","أصُدُّ عنه ارتقاباً أنْ أُلَمَّ به","ومَن يَخفْ قالةَ الوشينَ يَرْتَقبِ"],["A2931AEA-B8F9-535C-A23B-3F4121378B8F","إنِّي حَوَيْتُ على الأقوامِ مَكْرُمَةً","قِدْمَاً وحَذَّرَنِي ما يَتَّقُونَ أبِي"],["54C3C2A9-6648-5983-9987-0DC2F8F363A6","فقال لي قولَ ذي رأيٍ ومَقدِرةٍ","بسَالِفَاتِ أُمُورِ الدَّهْرِ والحِقَبِ"],["B42F9678-D034-540F-A7EB-5C3D8D57BD15","قد نِلْتَ مجداً فحاذِرْ أنْ تُدَنِّسِهُ","أبٌ كريمٌ وجَدٌ غيرُ مُؤْتَشَبِ"],["ED942CE1-3BBB-5BD7-93B1-CB9E62ECD58C","أمَرْتٌكَ الخيرَ فافعلْ ما أُمِرتَ به","فَقَدْ تَرَكْتُكَ ذَا مَالٍ وذَا نَشَبِ"],["509D1FE0-5210-53E9-8F4E-3CF8C6ED8184","واتْرُكْ خَلائِقَ قَوْمٍ لا خَلاَقَ لَهُمْ","واعْمَدْ لأخْلاقِ أهلِ الفَضْلِ والأدَبِ"],["5C8A228C-482C-5007-9C9A-67145C782F48","وإن دُعِيتَ لغدرٍ أو أُمِرْتَ به","فاهرُبْ بنفسِكَ عنه آبِدَ الهَرَبِ"]]}}}