{"v":1,"poems":{"A5C12494-44E4-5AFF-BE28-7A9C0B2BFAE6":{"t":"أفاطمُ! قبلَ بينكِ متِّعينى","p":22,"s":"أفاطم! قبل بينك متعينى","r":"436198","v":[["BE9BB561-012E-54AF-BCDA-7D1D482124FA","أفاطمُ! قبلَ بينكِ متِّعينى","ومنعكِ ما سألتكِ أنْ تبينى"],["6E6A0C68-50B3-5DA5-A4D1-F7F1294B60DD","فَلا تَعِدي مَواعِدَ كاذِباتٍ","تمر بها رياحُ الصيفِ دوني"],["9D4752DA-1B55-52E8-A83B-249F052016F3","فإنِّى لوْ تخالفني شمالى","خلافكِ ما وصلتُ بها يميني"],["766689FD-CA3C-56AE-A160-06631823943A","إذاً لَقَطَعتُها ولقُلتُ: بِيني","كذلكَ أجتوى منْ يجتويني"],["1DEF7BF2-AD7B-5D44-A950-2DE0010AE24A","لِمَن ظُعُنٌ تَطَلَّعَ مِن ضُبَيبٍ","فَما خَرَجَت مِنَ الوادي لِحينِ"],["173E03B3-6010-5B51-88D0-5F52AF13F4EF","يشَّبهنَ السَّفينَ وهنَّ بختُ","عُراضاتُ الأباهِرِ والشُّؤونِ"],["759D8928-DAE7-5E0A-B4C3-638D727C8190","وهُنَّ على الرَّجائزِ واكِناتٌ","قَواتِلُ كُلِّ أَشجَعَ مُسْتكينِ"],["A014F392-BA93-54C9-9DF6-D84BAAC258F3","كغزلانٍ خذلنَ بذاتِ ضالٍ","تنوشُ الدَّانياتِ منَ الغصونِ"],["D49EA0EC-156E-5A46-B73C-F6BD548D6FBF","ظهرنَ بكلَّةِ، وسدلنَ رقماً","وثقبنَ الوصاوصَ للعيونِ"],["CAA48DD4-B800-58C9-91C2-1AD5A873E555","أَرَينَ مَحاسِناً وكنَنَّ أُخرى","من الأجيادِ والبَشَرِ المَصونِ"],["0A863FBA-1EC3-5991-8210-FDD46E3B3944","ومن ذَهَبٍ يَلوحُ على تَريبٍ","كلَونِ العاجِ ليسَ بذي غُضونِ"],["A6875939-B56C-5A15-A57A-94FB03C6E7E1","وهُنّ على الظِّلام مُطَلَّباتٌ","طويلاتُ الذُّوائبِ والقرونِ"],["E9985F7E-F7ED-5FB7-8648-D58D404D7179","إذا ما فتنهُ يوماً برهنٍ","يعزُّ عليهِ لم يرجعْ يحينِ"],["4D0AFB7A-99E8-5479-992B-4C653C712E1E","بتَلهِيَةٍ أَريشُ بها سِهامي","تبذُّ المرشقاتِ منَ الفطينِ"],["2FF7E750-41A0-595A-A390-A52A24A01994","علونَ رباوةً، وهبطنَ غيباً","فلَمْ يَرجِعْنَ قائلةً لحِينِ"],["30057EE5-CF30-5E96-AFE5-FDC0DD5BD381","فقلتُ لبعضهنَّ، وشدَّ رحلى","لهاجرةٍ عصبتُ لها جبينى:"],["5CE53159-4A6F-5AFE-8D9B-25A111F9340D","لعلّكِ إنْ صَرَمتِ الحَبلَ منِّي","أكونُ كذاكِ مصحبتي قرونى"],["DE26578C-6606-59A9-BC68-47656647148C","فسلِّ الهمَّ بذاتِ لوثٍ","عُذافِرةٍ كمِطرَقَةٍ القُيونِ"],["2C04F3B5-D893-5EF1-9E42-CD9D4C7CBA04","كَساها تامِكاً قَرِداً عَلَيها","سَوادِيُّ الرَّضيحِ من اللَّجينِ"],["3517A755-09E3-5FF7-869B-5DC937ACA38D","إذا قلقتْ أشدُّ لها سنافا","أمامَ الزَّورِ منْ قلقِ الوضينِ"],["7CDD75F4-52C9-53B8-8F53-0E7CB957CC53","كأنّ مَواقِعَ الثَّفِناتِ مِنها","مُعَرَّسُ باكِراتِ الوِرْدِ جُونِ"],["FE38BC5C-A4D7-5005-BA92-7805F84871B6","يَجُدُّ تَنَقُّسُ الصُّعَداءِ منها","قوى النِّسعِ المحرمِ ذى المئونِ"],["4F5DFD05-5B2E-51C8-A91C-3F25C2CF2A34","تَصُكُّ الجانِبَينِ بِمُشفَتِرّ","لهُ صوتٌ أبحُّ منَ الرَّنينِ"],["14DFF1CB-2AFC-57B0-A792-D2B669C8E8AC","كأنَّ نفىَّ ما تتفى يداها","قذافُ غريبةٍ بيدىْ معينِ"],["EFE8E521-7B61-5C65-82B8-AD29A686FCCD","تسدُّ بدائمِ الخطرانِ جثلٍ","يُباريها ويأخُذُ بالوَضينِ"],["8502CE9C-C334-5078-A050-67E6C048C801","وتسعُ للذُّباب إذا تغنَّى","كتغريدِ الحمامِ على الوكونِ"],["4513F4C1-94B4-5D46-BB23-01DAED9CD5C7","وأَلقَيتُ الزِّمامَ لها فنامَتْ","لعادنها منَ السَّدفِ المبينِ"],["7070C741-9951-5910-AA92-D6DDA0E320F1","كأنّ مُناخَها مُلقى لِجامٍ","على معزائها وعلى الوجنينِ"],["AC578861-51E9-5B94-9B9B-687070DAFF3D","كأنّ الكُورَ والأنساعَ منها","على قَرْواءَ ماهِرَةٍ دَهينِ"],["DB1D30D2-C27C-526C-9565-287F8BFA859E","يشقُّ الماءَ جؤجؤها، وتعلو","غَوارِبَ كُلِّ ذي حَدَبٍ بَطينِ"],["152E92BF-8703-5BC7-B74A-3375DA98AAC3","غَدَت قَوداءَ مُنشَقّاً نَساها","تجاسرُ بالنُّخاعِ وبالوتينِ"],["9203EB2D-5589-5AF0-A1E7-28EDAF4C1643","إذا ما قمتُ أرحلها بليلٍ","تأوَّهُ آهةَ الرَّجلِ الحزينِ"],["C6A2AF45-47A8-56A5-963B-BB74DACAA281","تقولُ إذا دَرأْتُ لها وَضِيني","أهذا دينهُ أبداً ودينى؟"],["1D880CFC-9882-5F2C-9889-4B0D7EE8BD2D","أكلَّ الدَّهرِ حلٌّ وارتحالٌ","أما يبقى علىَّ وما بقينى!"],["246802DF-53F6-598D-9E7F-9120B99B2123","فأَبقى باطِلي والجِدُّ منها","كدُكّانِ الدَّرابِنَةِ المَطِينِ"],["8407B29B-A525-54BE-AAD6-53D80F0261A5","ثَنَيتُ زِمامَها ووَضَعتْ رَحْلي","ونمرقةً رفدتُ بها يمينى"],["D2EEA929-93A9-5754-A47D-2A7395A52C51","فَرُحْتُ بها تُعارِضُ مُسبَكِرّاً","على ضحضاحهِ وعلى المتونِ"],["39F33C30-9014-5C2D-A627-AAC1234B213F","إلى عمروٍ، ومنْ عمروٍ أتتني","أخى النَّجداتِ والحلمِ الرَّصينِ"],["CBD6DDA4-7EDF-5C76-AEF8-5ADEB3E46ECA","فإمَّا أنْ تكونَ أخى بحقِّ","فأَعرِفَ منكَ غَثِّي من سَميني"],["81A30DB3-AC89-535A-B23B-EDFDA4EA3BED","وإلاَّ فاطَّرحني واتخذنى","عَدُوّاً أَتَّقيكَ وتَتَّقيني"],["260C538F-BA4C-5EA8-AF7C-6E3BF60EE0FD","وما أَدري إذا يَمَّمتُ وَجهاً","أُريدُ الخَيرَ أَيُّهُما يَليني"],["32BEF263-D655-54E8-8FD1-B2EB76465043","أَأَلخَيرُ الذي أنا أَبْتَغيهِ","أَمِ الشَّرُّ الذي هو يَبْتَغيني"]]},"37FC7041-6974-589D-84E5-21BE71889F93":{"t":"ألا تلكَ العمودُ تصدُّ عنَّا","p":22,"s":"ألا تلك العمود تصد عنا","r":"436206","v":[["7200CEEC-5939-5FF8-8E92-CD35C7B41F1B","ألا تلكَ العمودُ تصدُّ عنَّا","كأنَّا في الرَّخيمةِ منْ جديسِ"],["4AAEDDF9-C205-52D0-9D90-CD89A8B4EEE8","لَحَى الرَّحمنُ أَقواماً أَضاعوا","على الوَعواعِ أَفراسي وعيسي"],["3717134F-FDA6-5A58-87F8-CE5B825A42E0","ونَصْبُ الحيِّ قد عَطَّلتُموهُ","ونقرٌ بالأثامجِ والوكوسِ"]]},"EA7F4DA2-656A-5B70-A737-AF0851160002":{"t":"ألا مَن مُبلِغٌ عَدوانَ عَنِّي","p":22,"s":"ألا من مبلغ عدوان عني","r":"436201","v":[["71BCD195-CA22-5838-AA0F-404F1815D490","ألا مَن مُبلِغٌ عَدوانَ عَنِّي","وما يغنى التَّوعُّدُ منْ بعيدِ"],["0902F640-1DAA-5F61-8019-97ED0EE6E8EE","فإنّكَ لو رأيتَ رجالَ أبْوَى","غداةَ تسربلوا حلقَ الحديدِ"],["7EDF1335-59F9-554B-8408-2047CEC0B2A1","إذَّا لظننتَ جنَّةَ ذى عرينٍ","وآسادَ الغُرَيفَةِ في صَعيدِ"]]},"79BE5CD0-9DA7-5136-A8A9-3D171E7E91DF":{"t":"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","p":22,"s":"ألا إن هتدا أمس رث جديدها","r":"436196","v":[["28DA02FB-27FE-5CA3-B2E6-1C38A9432FAF","ألاَ إنَّ هتداً أمسِ رثَّ جديدها","وَضَنَّت وما كانَ المَتاعُ يَؤودَها"],["91EFEA12-400F-5425-A9FA-AF8A9727B45F","فلوْ أنَّها منْ قبلُ جادتْ لنا بهِ","على العهدِ إذْ تصطادني وأصيدها"],["3387F46B-71D8-5F09-B089-32DDB4D3DAC0","ولكنّها مِمّا تَميطُ بِوُدِّها","بَشاشَةُ أَدنَى خُلَّةٍ تَستَفيدُها"],["D6541988-D033-584C-834D-D0DE7C9CB14A","أعاذلُ ما يدريكَ أنْ ربَّ بلدةٍ","إذا الشَّمسُ في الأيَّامِطالَ ركودها"],["721EA7FA-2FE4-5BCE-8A15-77529932149D","وآمَت صَواديحُ النَّهارِ وأَعرَضَتْ","لَوامِعُ يُطوَى رَيطُها وبُرودُها"],["770D16DE-1569-5AC8-B480-CE61F9D0DA02","قطعتُ بفتلاءِ اليدينِ ذريعةٍ","يَغُولُ البِلادَ سَوْمُها وبَريدُها"],["E16C46FB-04D8-51D6-9D22-CDBBDA72991F","فَبِتُّ وباتَتْ بالتَّنوفَةِ ناقَتي","وباتَتْ عَلَيها صَفنَتي وقُتودُها"],["F084813B-943F-53C5-BAF0-47D2EA2BDF62","وأَغضَتْ كما أَغضَيتُ عَيني فَعَرَّسَت","على الثَّفِناتِ والجِرانِ هُجودُها"],["AF11F09F-8AAC-5C04-A85C-CA372494C2CE","على طريقٍ عندَ اليراعةِ تارةً","تؤازى شريمَ البحرِ وهوَ قعيدها"],["1D16E3BC-58F1-59D2-B7E7-4407CC6D39DD","كأنَّ جنيباً عندَ معقدِ غرزها","تراودهُ عن نفسهِ ويريدها"],["2CFB280E-B393-5EE3-B0EF-26A30BF87397","تَهالَكُ منهُ في النَّجاءِ تَهالُكاً","تَقاذُفَ إحدَى الجُونِ حانَ وُرودُها"],["DDCBC121-0711-57FF-8249-95B3469D0380","فنهنهتُ منها، والمناسمُ ترنمى","بِمَعزاءَ شَتّى لا يُرَدُّ عَنودُها"],["4579FA4E-9EB7-5414-8F11-FAC708F824BC","وأيقنتُ إنْ شاءَ الإلهُ بأنَّهُ","سيبلغني أجلادها وقصيدها"],["8DCB4146-340F-5959-80C2-4CA0AB0ACB68","فإنّ أَبا قابوسَ عندي بَلاؤهُ","جَزاءً بِنُعمًى لا يَحِلُّ كُنودُها"],["2553BA45-F2D6-5D69-81DE-1744B2F9B87A","وجدتُ زنادَ الصَّالحينَ نمينهُ","قديماً كما بَذَّ النُّجومَ سُعودُها"],["F5F5623E-0484-589D-8D85-6F980D9538EC","فلو عَلِمَ اللَّهُ الجِبالَ ظَلَمْنَهُ","أتاهُ بأَمراسِ الجبالِ يَقودُها"],["91FB44CD-752A-5699-8A9B-D98428BF37C6","فإنْ تَكُ منّا في عُمانَ قَبيلةٌ","تَواصَتْ بإجنابٍ وطالَ عُنودُها"],["71108B4D-E8B6-527E-B173-75D82B9A90FD","وقد أدرَكَتْها المُدرِكاتُ فأَصبَحَتْ","إلى خَيرِ مَن تحتَ السَّماءِ وُفودُها"],["1FB103AC-4B63-59F4-8D7F-8F907BCE1AEA","إلى مَلِكٍ بَذَّ المُلوكَ بِسَعيِهِ","أفاعليهُ حزمُ الملوكِ وجودها"],["2FCFE43A-0CCF-5A03-81A2-415180EDF04D","وَأيَّ أُناسٍ لا يُبيحُ بقَتْلَةٍ","يؤازى كبيداتِ السَّماءَ عمودها"],["5A92BCA6-5D91-5B84-A162-2FB54815523B","وجأواءَ -فيها كوكبُ الموتِ-فخمةٍ","تَقَمَّصَ بالأرضِ الفَضاءِ وَئيدُها"],["70A1F271-784A-5117-BDEC-0485330C4AC5","لها فَرَطٌ يَحمي النِّهابَ كأنَّهُ","لَوامِعُ عِقبانٍ مَرُوعٍ طَريدُها"],["85C76BEA-73C8-5693-AEED-90F90C12EC28","وأَمكَنَ أطرافَ الأسِنَّةِ والقَنا","يَعاسيبُ قُودٌ ما تُثَنَّى قُتودُها"],["FE1BA368-87DF-5E33-9F4B-122EF132E057","تنبَّعَ منْ أعطافها وجلودها","حَميمٌ وآضَتْ كالحَماليجِ قُودُها"],["F405FE81-EDEC-5AC2-84E9-534E1E48ADC7","وطارَ قشارىُّ الحديدِ كأنَّهَ","نُخالَةُ أَقواعٍ يَطيرُ حَصيدُها"],["41CCFB76-D8DE-5779-844D-2E7354596A06","بكلِّ مَقَصِّيٍّ وكلِّ صَفيحةٍ","تتابعُ، بعدَ الحارشىَّ، خدودها"],["C19ABDF1-CA98-509D-9DC2-757DC0C918EB","فأنعمْ -أبيتَ اللَّعنَ- إنَّكَ أصبحتْ","لدَيْكَ لُكَيزٌ كَهْلُها ووَليدُها"],["41979A60-4A0F-504B-B32E-F319EBC75C55","وأطلِقهُمُ تَمشي النِّساءُ خِلالَهُم","مُفكَّكَةً وَسطَ الرِّجالِ قُيودُها"]]},"D57ABAAE-1FE4-5240-94E0-AB7758F8BDC0":{"t":"أَخي وَأَخوكَ بِبَطنِ النُسَي","p":22,"s":"أخي وأخوك ببطن النسي","r":"436215","v":[["5D3F855D-5509-59EB-A123-E3FBCB866316","أَخي وَأَخوكَ بِبَطنِ النُسَي","رِ لَيس لَنا مِن مَعَدٍّ عَريب"]]},"6EDA8224-B44E-50EF-9C8B-509C7D7670C9":{"t":"أَلا حَيِّيا الدّارَ المُحيلَ رُسُومُها","p":22,"s":"ألا حييا الدار المحيل رسومها","r":"436199","v":[["CA3320E9-0BA9-5B0E-AA97-8D3B5A0CC4ED","أَلا حَيِّيا الدّارَ المُحيلَ رُسُومُها","تهيجُ علينا ما يهيجُ قديمها"],["527939E1-7852-5C49-93B0-341574A84C13","سقى تلكَ منْ دارٍ ومنْ حلَّ ربعها","ذِهابُ الغَوادي وَبْلُها ومُديمُها"],["16A7D8CB-C926-52C4-849E-C2164C97DAB1","ظَلَلتُ أَوُدُّ العَينَ عن عَبَراتِها","إذا نزفتْ كانتْ سراعاً جمومها"],["FB48C07E-5332-54A8-B18F-CEED9A0187E4","كأنّي أُقاسي من سَوابِقِ عَبرةٍ","ومن ليلةٍ قد ضافَ صَدري هُمومُها"],["A60FDBCD-7E74-5116-A893-00903537FD95","تُرَدُّ بأَثناءٍ كأنّ نُجومَها","حيارى إذا ما قلت: غابَ نجومه"],["9C5C9F4C-8308-5FDA-92C5-376E98ECEA06","افبتُّ أضمُّ الرّثكبتينِ إلى الحثا","كأنِّي راقي حَيَّةٍ أو سَليمُها"]]},"F62C6E7B-2F8A-5A09-8A39-428112212557":{"t":"إذا ما تَدَبَّرتَ الأُمورَ تَبَيَّنَت","p":22,"s":"إذا ما تدبرت الأمور تبينت","r":"436204","v":[["C7AECE84-04E7-5485-A4F3-0768D8066D79","إذا ما تَدَبَّرتَ الأُمورَ تَبَيَّنَت","عياناً صحيحاتُ الأمورِ وعورها"]]},"3D13F1CD-29CC-521A-918B-B4DFAD599DDC":{"t":"إِنَّ الأُمورَ إِذا اِستَقبَلَتها اِشتَبَهَت","p":22,"s":"إن الأمور إذا استقبلتها اشتبهت","r":"436210","v":[["D30094AB-1452-53CB-8B23-5C0900A27396","إِنَّ الأُمورَ إِذا اِستَقبَلَتها اِشتَبَهَت","وَفي تَدَبُّرِها التِبيانُ وَالعِبَرُ"]]},"0806E9E2-3E51-5242-8EA1-2E9649E60DE0":{"t":"تَهَزَّأَتْ عِرْسيَ واستَنكَرَتْ","p":22,"s":"تهزأت عرسي واستنكرت","r":"436205","v":[["0E23AC3C-2D22-5FF4-97C2-060B370A3C1C","تَهَزَّأَتْ عِرْسيَ واستَنكَرَتْ","شَيبي، فَفيها جَنَفٌ وازْوِرارْ"],["353A1C32-1AAB-5E9B-9A49-76EE9E56EEE9","لا تكثرى هزءاً، ولا تعجبي،","فليسَ بالشَّيبِ على المرءِ عارْ"],["620693CB-2B9C-58C9-9EE7-E909F347D3D6","عَمْرَكِ هل تَدرينَ أنَّ الفَتى","شبابهُ ثوبٌ عليهِ معارْ"],["523963C9-0F10-55B1-A533-5CBB5C784B3E","ولا أرى مالاً إذا لمْ يكنْ","زغفٌ، وخطَّارٌ، نهدٌ مغارْ"],["6CC8CB51-87EB-5056-8A80-97799FF9F913","مُستَشرِفُ القُطَرينِ، عَبلُ الشَّوَى","محنَّبُ الرِّجلينِ، فيهِ اقورارْ"],["5B431BDF-8533-5031-B646-B3E7CAE6BA29","فذاكَ عصرٌ قد خلا والفتى","تُلوي لَياليهِ به والنَّهارْ"],["B05D534F-4C27-5460-B89A-91CA3EDD5D56","لا يَنفَعُ الهاربَ إيغالُهُ","ولا ينحِّى ذا الحذارِ الحذارْ"]]},"A3417C25-C3EF-5853-A232-067154001EB6":{"t":"داويتهُ بالمحضِ حتَّى شتا","p":22,"s":"داويته بالمحض حتى شتا","r":"436203","v":[["45EFC68F-6613-5874-B5E5-19408BE5F1B4","داويتهُ بالمحضِ حتَّى شتا","يجتذبُ الآرىَّ بالمرودِ"]]},"DB33FC65-DF15-5954-9E54-54B5007D2400":{"t":"ذادَ عَنى النَومَ هَمٌّ بَعدَ هَمّ","p":22,"s":"ذاد عنى النوم هم بعد هم","r":"436212","v":[["5534A745-9BCC-5950-AAA5-C2206DEE8FF8","ذادَ عَنى النَومَ هَمٌّ بَعدَ هَمّ","وَمِن الهَمِّ عَناءٌ وَسَقَم"],["0394897B-BDE4-50F6-AC4D-35B43F0DF972","طَرَقَت طَلحَةُ رَحلي بَعدَما","نامَ أَصحابى وَلَيلي لَم أَنَم"],["32A63DDF-5353-573D-88EF-08AAF5E9D43E","طَرَقَتنا ثُمَّ قُلنا إِذ أَتَت","مَرحَباً بِالزَورِ لَمّا أَن أَلَمّ"],["F82E28A6-F35A-516D-88AC-64ADCF8B718B","ضَرَبَت لَمّا اِستَقَلَت مَثَلاً","قالَهُ القُوّالُ عَن غَيرِ وَهَم"],["5DB21D51-10FB-5CB2-91C3-7774A0DC2FD2","مَثَلاً يَضرِبُهُ حُكامُنا","قَولُهُم فى بَيتِهِ يُؤتى الحَكَم"],["1411ADA3-72A4-5602-B2AD-5BDF74B848B6","فَأَجابَت بِصوابٍ قَولَها","مَن يَجُد يُحمَد وَمَن يَبخَل يُذَم"],["F88BFF8B-3CA6-537E-A977-59CC90B04185","إِنَّما جادَ بِشَأسٍ خالِدٌ","بَعدَما حاقَت بِهِ إِحدى العِظَم"],["49187A6D-72DF-51D6-B3D2-097657317BF3","مِن مَنايا يَتَخاسَينَ بِهِ","يَبتَدِرنَ الزولَ مِن لَحمٍ وَدَم"],["FCA775BF-140E-54D9-AA1E-FBC34371A6C3","باكِرُ الجَفنَةِ رِبعِيُّ النَدى","حَسَنٌ مَجلِسُهُ غَيرُ لُطَم"],["BD396218-0D86-5A8E-9C39-E71EAB5551A8","يَجعَلُ المالَ عَطايا جَمَّةً","إِنَّ بَذلَ المالِ في العِرضِ أُمَم"],["64CE1BBD-AC35-58F0-9AA8-219EBD8AD6E0","لا يُبالي طَيِّبُ النَفسِ بِهِ","عَطَبَ المالِ إِذا العِرضُ سَلِم"],["239E8F9F-8DFF-5451-BFE7-EAFC7D0ABBD3","لا تَقولَنَّ إِذا ما لَم تُرِد","أَن تُتِمَّ الوَعدَ في شَيءٍ نَعَم"],["E79C7207-3A58-5B7B-BB0D-F3F44E2F9126","حَسَنٌ قَولُ نَعَم مِن بَعدِ لا","وَقَبيحٌ قَولُ لا بَعدَ نَعَم"],["FA6E7D7D-1528-57B4-BD43-A600DBBF47E3","إِنَّ لا بَعدَ نَعَم فاحِشَةٌ","فَبِلا فَاِبدَأ إِذا خِفتَ النَدَم"],["6DEBEC66-CF4C-538C-9A12-8E8E2D39C7B9","فَإِذا قُلتَ نَعَم فَاِصبِر لَها","بِنَجاحِ الوَعدِ إِنَّ الخُلفَ ذَم"],["D957B2EA-F1C5-516D-B7EC-FCE9CFC8BDFB","وَاِعلَمَ أَنَّ الذَمَّ نَقصٌ لِلفَتى","وَمَتى لا يَتَّقِ الذَمَّ يُذَم"],["81A8999C-4321-58AA-BDAC-A14D3A764968","أُكرِمُ الجارَ وَأَرعى حَقَّهُ","إِنَّ عِرفانَ الفَتى الحقَّ كَرَم"],["5B2EF3B0-DAAA-5F73-84B0-948CE3FBDE38","أَنا بَيتي مِن مَعَدٍّ في الذُرى","وَلِيَ الهامَةُ وَالفَرعُ الأَشَم"],["FCB68C39-CD51-54C6-8720-6EE43818A1F2","لا تَراني راتِعاً في مَجلِسٍ","في لُحومِ الناسِ كَالسَبعِ الضَرِم"],["DF91F814-0F89-5C1A-887A-328030BFFB4A","إِنَّ شَرَّ الناسِ مَن يَكشِرُ لي","حينَ يَلقاني وَإِن غِبتُ شَتَم"],["50BBC062-8D74-501E-B4D5-CAFE34747EED","وَكلامٍ سَيِّئٍ قَد وَقَرَت","عَنهُ أُذُنايَ وَما بي مِن صَمَم"],["12672991-DA7B-5338-A289-52DB39BF92A1","فَتَعَزَّيتُ خَشاة أَن يَرى","جاهِلٌ أَنّي كَما كانَ زَعَم"],["B63DAFF8-4026-5CE1-AC7B-5BE5FCE8C2C1","وَلَبَعضُ الصَفحِ وَالإِعراضِ عَن","ذي الخَنا أَبقى وَإِن كانَ ظَلَم"],["F6C227EE-83C2-5663-B65D-9F429329EE7F","أَجعَلُ المالَ لِعِرضي جُنَّةً","إِنَّ خَيرَ المالِ ما أَدّى الذِّمَم"]]},"E84981A5-2C4A-5ED4-A531-1C538F77777E":{"t":"ظَعائِنُ لا توفي بِهِنَّ ظَعائِنٌ","p":22,"s":"ظعائن لا توفي بهن ظعائن","r":"436214","v":[["40BB4A56-22A5-5AD3-9166-5087DC0EB686","ظَعائِنُ لا توفي بِهِنَّ ظَعائِنٌ","وَلا الثاقِباتُ مِن لُؤَيِّ بِنِ غالِبِ"],["FE46E2FF-811B-5395-A288-B1E37A22877C","وَلا ثَعلَبِيّاتٌ حَلَلنَ عُباعِباً","وَلا أُسرَةُ القَعقاعِ مِن رَهطِ حاجِبِ"]]},"95C47A57-FB84-5B25-A1C1-38D1266F2277":{"t":"غَلَبتَ مُلوكَ الأَرضِ بِالحَزمِ وَالنُهى","p":22,"s":"غلبت ملوك الأرض بالحزم والنهى","r":"436209","v":[["794F1171-6349-5B24-97C5-ECCCC1D284DA","غَلَبتَ مُلوكَ الأَرضِ بِالحَزمِ وَالنُهى","فَأَنتَ اِمرُؤٌ في سورَةِ المَجدِ تَرتَقي"],["A1024286-02C6-571A-A301-66785A586E85","وَأَنجِب بِهِ مِن آلِ نَصرٍ سَمَيدَعٍ","أَغَرَّ كَلَونِ الهُندُوانِيَّ رَونَقِ"]]},"D2FC42EC-A68E-58AA-9C3C-CCA0B11EFFA5":{"t":"فَباتَ يَجتابُ شُقارَى كما","p":22,"s":"فبات يجتاب شقارى كما","r":"436202","v":[["2A855688-F297-53B9-843C-D85DA356BA53","فَباتَ يَجتابُ شُقارَى كما","بيقرَ منْ يمشى إلى الجلدِ"]]},"C3E75137-42F1-553C-BF31-2A12337255C8":{"t":"فَلا يَدعُني قَومي لِنَصرِ عَشيرَتي","p":22,"s":"فلا يدعني قومي لنصر عشيرتي","r":"436213","v":[["F3A131A8-31AB-5B35-90ED-0A499326F30B","فَلا يَدعُني قَومي لِنَصرِ عَشيرَتي","لَئِن أَنا لَم أَجلِب عَلَيهِم وَأُثقِبِ"]]},"5B9FF1CE-786F-57DD-94E9-1413A437B61B":{"t":"لعمركَ إنَّني وأبا رياحٍ","p":22,"s":"لعمرك إنني وأبا رياح","r":"436208","v":[["ECF55A6F-1B5B-5D12-B8A7-B3F10A2F3392","لعمركَ إنَّني وأبا رياحٍ","على طولِ التَّهاجُرِ منذ حينِ"],["3B09E374-E86D-56FF-BB07-441D76864316","لَيُبغِضُني وأُبغِضُهُ، وأَيضاً","يراني دونهُ وأراهُ دونى"],["0AA4C94A-85C9-58C2-93DF-B11C28FE8A7C","فَلَو أَنّا على حَجَرٍ ذُبِحنا","جَرى الدَّمَيانِ بالخَبَرِ اليَقينِ"]]},"B9282EE9-2A6E-59F9-BA8A-4DE10B320283":{"t":"هلْ لهذا القلبِ سمعٌ أوْ بصرْ","p":22,"s":"هل لهذا القلب سمع أو بصر","r":"436195","v":[["9B57D0D5-12A6-578E-8023-405742D7BDF8","هلْ لهذا القلبِ سمعٌ أوْ بصرْ","أو تناهٍ عن حبيب يذكرْ"],["22D615CE-998F-5557-AC05-998A765574EF","أو لِدَمعٍ عن سَفاهٍ نُهْيَةٌ","تمنرى منهُ أسابىُّ الدِّررْ"],["9F60382E-5973-563F-A96B-097D34A025A4","مُرمَعِلاتٌ كَسِمْطَي لُؤلؤ","خذلتْ أخراتهُ، فيهِ مغرْ"],["20CB3310-817D-5CAC-9F17-9A452939FC9A","إنْ رأى ظعناً لليلى غدوةً","قد عَلا الحَزماءِ منهنَّ أُسَرْ"],["EEE55A19-4D1C-5931-97B8-DC7A63F85FE6","قد عَلَتْ من فَوقِها أَنْماطُها","وعلى الأحداجِ رَقمٌ كالشَّقِرْ"],["4F4D45FD-28DF-530B-917F-41AD7D4B60EF","وإلى عمرٍو ـ وإنْ لم آتِهِ ـ","تجلبُ المدحةُ أو يمضى السَّفرْ"],["7EF935D1-C816-59CD-A72D-394583F18C73","واضحِ الوجهِ، كريم نجرهُ","مَلَكَ السَّيْفَ إلى بَطنِ العُشَرْ"],["ADDE2C2E-EF9F-57F3-98C1-8A7D77250EEC","حَجَريٌّ عائديٌّ نَسَباً","ثمَّ للمنذرِ إذْ حلَّى الخمرْ"],["8A11125F-4F48-555D-B8E7-02755C9DBEFF","باحرىُّ الدَّمِ، مرٌّ طعمهُ","يُبرِىءُ الكَلبَ إذا عَضَّ وَهَرْ"],["B4117035-A88E-5016-9124-EE900678BB60","كلُّ يومٍ كانَ عنَّا جللاً","غيرَ يَومِ الحِنوِ في جَنَبيْ قَطَرْ"],["42E02E1E-5C91-5177-9CDD-C35E90B52384","ضربتْ دوسرُ فينا ضربةَ","أثْبَتَتْ أوْتادَ مُلْكٍ مُستَقْرِ"],["3F4EA700-8948-5CD3-A816-4034CD723EEA","صبَّحَتنا فَيلَقٌ مَلمُومَةٌ","تمنع الأعقابَ منهنَّ الأخرْ"],["FA18DBB6-22A0-56EF-9927-6A34C48A63D1","فجزاهُ اللهُ منْ ذى نعمةٍ","وَجَزاهُ اللهُ إنْ عَبدٌ كَفَرْ"],["1F40D1FC-945F-5B33-819B-12A039A90324","وأَقامَ الرَّأْسَ وَقْعٌ صادِقٌ","بعدَ ما صافَ، وفي الخدِّ صعرْ"],["05E77631-7F56-5862-9A15-7374C74EA662","ولَقَد راموا بسَعيٍ ناقِصٍ","كيْ يُزيلوهُ فأعْيا وأَبَرْ"],["85459850-4D4C-53BC-85C3-3E6D8BE4D92A","ولقدْ أودى بمنْ أودى بهِ","عيشُ دهرٍ كانَ حلواً فأمرْ"]]},"B6634F06-7259-5E51-99F8-B4B0C5639558":{"t":"هَلْ عند غانٍ لِفؤادٍ صَدِ","p":22,"s":"هل عند غان لفؤاد صد","r":"437803","v":[["05C63FA5-17E6-53CA-AD73-B8845876B885","هَلْ عند غانٍ لِفؤادٍ صَدِ","من نَهلةٍ في اليومِ أو في غَدِ"],["CBBC5CA3-4402-5FA6-9182-16B1626F2B42","يَجزي بها الجازونَ عنِّي ولو","يمنعُ شربى لسقتني يدى"],["FA4CE0EF-DFE3-5709-8D94-4475DE5CBF7D","قاتلْ: ألا لا يشترى ذاكمُ","إلاّ بما شِئنا ولم يوجدِ"],["62A2607A-9C90-5568-B8BD-BE360BAA20C7","إلاّ بِبَدرَيْ ذَهَبٍ خالِصٍ","كلَّ صباحٍ آخرَ السند"],["6B684DD7-1576-577F-887E-00431F0F62CA","منْ مالِ منْ يجني ويجنى لهُ","سبعونَ قنطاراً منَ المسجدِ"],["D3A07D96-AB08-560D-9333-B87BDCF774A3","أو مائةٌ تُجعَلُ أولادُها","لَغْواً وعُرضُ المائةِ الجلمَدُ"],["3BB737B0-9239-5551-A627-F07B02155964","إذْ لمْ أجدْ حبلاً لهُ مرَّةٌ","إذْ أنا بين الخلِّ والأوبدِ"],["5794FE0B-9CCD-5B96-A33F-03A8BDEC6CBC","حتَّى تُلُوفِيتُ بِلَكِّيَّةٍ","معجمةِ الحاركِ والموقدِ"],["1B4C9751-9E76-51C9-82E4-ACFC5A4304CD","تعطيكَ مشياً حسناً مرَّةً","حثَّكَ بالمرودِ والمحصدِ"],["69CE52E2-A1FE-53A2-A70E-0A34CC7FE6AA","في بَلدةٍ تَعزِفُ جَنَّاتُها","ناوٍ كَرأسِ الفَدَّنِ المُؤْيَدِ"],["7CFB25DF-89CA-5BE8-B480-1522DA213FF3","عَـرقـاءَ وَجـناءَ جُمالِيَّةٍ","مُكْرَبَةٍ أَرْساغُها جَلْمَدِ"],["7235CEC3-73E2-5A26-A3FB-C8DFC8504DB0","كأنما أوبُ يديها إلى","حَيزومِها فوقَ حَصى الفَدْفَدِ"],["88D94BDD-38CB-56F0-A122-25A565C0A2CB","نوحُ أبنهِ الجونِ على هالكٍ","تَندُبُهُ رافِعَةَ المِجْلَدِ"],["9F4D95B8-ABC9-53DA-AA54-7E95FCA7452D","كلَّفتها تهجيرَ داويَّةٍ","منْ بعدِ شأوىْ ليلها الأبعدِ"],["22B04FDF-2889-55E4-AF44-DAC3A36424B6","لا يرفعُ السَّوطَ لها راكبٌ","إذا المَهارى خَوَّدَت في البَدِ"],["09DDD93D-9925-5872-924C-02E6EB0737E3","تَسْمَعُ تَعْزافاً لهُ رَنَّةٌ","في باطِنِ الوادي وفي القَرْدَدِ"],["F33A4B7D-131E-5CFA-A576-2CA221E08289","كأنَّها أسفعُ ذو جدَّةٍ","يمسدهُ الوبلُ وليلٌ سدِ"],["C40741E6-0B19-5BF2-AF58-E9C32EB56149","ملمَّمعُ الخدَّينِ قد أردفتْ","أكرعهُ بالزَّمعِ الأسودِ"],["D9B863BF-30E7-5F76-AC71-95EEED03A2FF","كأنَّما ينظرُ في برقغ","من تحتِ رَوقٍ سَلِبِ المِذوَدِ"],["A9F50E49-554E-502F-9B8B-25FF7AD0BAC3","ضمَّ صماخيهِ لنكرَّبةٍ","من خَشيَةِ القانِصِ والموسَدِ"],["D4F70BD1-75EB-58B5-A963-266FB77D6B4B","وانتصبَ القلبُ لتقسيمهِ","أمراً فَريقَينِ وَلم يَبلُدِ"],["A4B151CC-B4FC-54FF-862A-7F405586FAD1","يتبعهُ في إثرهِ واصلٌ","مثلُ رشاءِ الخلبِ الأجردِ"],["CD64BD67-664B-50BA-8392-17F3C62BDE2F","في بلدةٍ تعزف جنَّانها","فيها خَناطيلُ من الرُّوَّدِ"],["45C71FC9-3C77-58E6-9DD0-0D7D427809EE","قاظَ إلى العليا إلى المنتهى","مُستَعرِضَ المَغربِ لم يَعضُدِ"],["78062AAC-C4BF-5AE1-827A-F9464DD0A8CA","فذاكمُ شبهَّتهُ ناقتي","مُرتَجِلاً فيها ولم أعتَدِ"],["53AEEBFA-190A-5D38-BC7F-97DBBD2A5897","بالمربأ المرهوبِ أعلامهُ","بالمُفرِعِ الكاثِبَةِ الأكبَدِ"],["46D45756-73CD-5BD0-9CB3-D7099B7D09E8","لمَّا رأى فاليهِ ما عندهُ","أعجبَ ذا الرَّوحةِ والمغتدى"],["5DBF35BD-3E5C-52C9-852A-289E4A3B0F8A","كالأجدلِ الطَّالب رهوَ القطا","مُستَنْشِطاً في العُنُقِ الأَصْيَدِ"],["C7943069-CFB0-5D40-9EF5-F3DD10595C31","يجمعُ في الوكرِ وزيماً كما","يجمعُ ذو الوفضةِ في المزودِ"]]},"ABF24044-FCF3-592C-ABDE-4AFDF8C21E5B":{"t":"وسارٍ تعنَّاهُ المبيتُ فلمْ يدعْ","p":22,"s":"وسار تعناه المبيت فلم يدع","r":"436197","v":[["990B61D2-7C63-5A54-ACBE-EDCDE73AFD59","وسارٍ تعنَّاهُ المبيتُ فلمْ يدعْ","لهُ طامسُ الظَّلماءِ واللَّيلِ مذهباً"],["A2AFD973-4983-5704-844C-17DF4BC75719","رأى ضوءَ نارٍ منْ بعيدٍ فخالها","لقدْ أكذبتهُ النَّفسُ، بلْ راءَ، كوكباً"],["94EAFA4E-CB92-573B-A3BF-03108FFDD105","فلَمّا استْبانَ أنّها آنِسيَّةٌ","وصَدَّقَ ظَنّاً بعدَ ماكان كَذَّبا"],["79AF01E1-BF19-5D75-A08D-BE0E6C151519","رفعت لهُ بالكفِّ ناراً تشبُّهاً","شآميَّةٌ نَكباءُ أو عاصِفٌ صَبا"],["1852550C-2BD3-558F-9505-753C522530F9","وقُلتُ: ارفَعاها بالصّعيدِ كفَى بها","منادٍ لسارٍ ليلةً إنْ تأوَّبا"],["56E32DA3-6344-5BCA-894F-BDADB9B9F3A4","فلمَّا اتاني والسَّماء تبلهُ","فلَّقيتهُ: أهلاً وسهلاًومرحبا"],["EC9E3358-821C-592C-8422-464FB0C14B59","وقُمتُ إلى البَرْكِ الهَواجِدِ فاتَّقَتْ","بِكَوماءِ لم يَذهَبْ بها النَّيُّ مَذهَبا"],["060A14F8-9EE6-50D3-9062-7C5F6E129443","فرحَّبتُ أعلى الجنبِ متها بطعنةٍ","دعتْ مستكنَّ الجوفِ حتَّى تصبَّبا"],["030D818C-791E-5B0D-BF2F-083964511849","تَسامَى بَناتُ الغَلْيِ في حُجُراتِها","تَسامي عِتاقِ الخَيلِ وَرداً وأَشْهَبا"]]},"4733F75B-CD65-584C-9043-5098ECDAC136":{"t":"وقد تَخِذَتْ رِجلي إلى جَنْبِ غَرْزِها","p":22,"s":"وقد تخذت رجلي إلى جنب غرزها","r":"436207","v":[["50A38759-000F-53BF-BE4D-8094F0CBA163","وقد تَخِذَتْ رِجلي إلى جَنْبِ غَرْزِها","نَسيفاً كأُفحُوصِ القَطاةِ المُطَرَّقِ"]]},"14B41A01-A60A-5DCE-8D5B-081C15F2631E":{"t":"ولَلمَوتُ خيرٌ للفتى من حياتِه","p":22,"s":"وللموت خير للفتى من حياته","r":"436200","v":[["5BFC33C8-8115-5385-B86A-F5B863C7D3A6","ولَلمَوتُ خيرٌ للفتى من حياتِه","إذا لم يَثِبْ للأمرِ إلاّ بقائدِ"],["F674289D-9B13-5AC2-B843-044E3A76E698","فعالجْ جسيماتِ الأمورِ، ولا تكنْ","هبيتَ الفؤادِ همهُ للوسائدِ"],["E772027B-52AD-5868-BF56-1EF4B638AC4E","إذا الرِّيحُ جاءَت بالجَهامِ تَشُلُّهُ","هذا ليلهُ شلَّ القلاصِ الطَّرائدِ"],["D1C32743-CFA0-5E6F-9A2C-2B43950060F2","وأَعقَبَ نَوءَ المِرزَمَينِ بغُبرَةٍ","وقطٍ قليلِ الماءِ بالَّليلِ باردِ"],["5FF8D691-8D9D-58C0-B693-1C6DB7FAF69F","كفى حاجةَ الاضيافِ حتى يريحها","على الحيِّ منَّا كلُّ أروعَ ماجدِ"],["B67A8B8E-C87B-5FA1-8955-D53621C3B287","تراهُ بتفريجِ الأمورِ ولفِّها","لما نالَ منْ معروفها غيرَ زاهدِ"],["A572FD04-FEB4-5880-B5E6-4231A98BE5D4","وليسَ أخونا عند شَرٍّ يَخافُهُ","ولا عندَ خيرٍ إن رَجاهُ بواحدِ"],["BFD430E8-9EC0-5EB0-A9EE-B89BA84D9A5B","إذا قيل: منْ للمعضلاتِ؟ أجابهُ:","عِظامُ اللُّهى منّا طِوالُ السَّواعدِ"]]},"30F7D5F8-0908-56B3-9815-6E9619A806D2":{"t":"وَجاءَت جَيأَلٌ وَأَبو بَنيها","p":22,"s":"وجاءت جيأل وأبو بنيها","r":"436211","v":[["17493CDA-12B2-58F4-8A75-2C16097EB08E","وَجاءَت جَيأَلٌ وَأَبو بَنيها","أَجَمُّ المَأقَيَينِ بِهِ خُماعُ"]]},"CA9BC9A7-AC16-582C-907B-1B139F80C44F":{"t":"يُطيفُ بِنُصبِهِم حُجنٌ صِغارٌ","p":22,"s":"يطيف بنصبهم حجن صغار","r":"436216","v":[["644D3566-1B20-5218-981B-92C61BC67AF9","يُطيفُ بِنُصبِهِم حُجنٌ صِغارٌ","فَقَد كادَت حواجِبُهُم تَشيبُ"]]}}}