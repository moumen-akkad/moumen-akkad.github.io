{"v":1,"poems":{"30656052-8A7D-5CB7-93D9-EEEAD217F388":{"t":"يا أبا إسْحَاقَ زادَ ال","p":128,"s":"يا أبا إسحاق زاد ال","r":"458592","v":[["9D376772-2E67-5D15-836F-274AB8E8342E","يا أبا إسْحَاقَ زادَ ال","لهُ في حُسْنِ حُبورِكْ"],["F78C0B43-942C-59EF-B192-D7E46FAE2D4F","و غَدا شانيك ذا هَمْ","مٍ طويلٍ بِسُرورِكْ"],["A7404965-2C41-54AB-A49D-727553FF2820","عمَّرَ اللّهُ بِطُلاَّ","بِ النَّدى أبوابَ دُورِكْ"],["C68067A2-0357-5C92-84BA-A74AC0031BBC","أَشرَقَ الدَّهرُو ما إش","راقُه إلاَّ بنُورِكْ"],["3FAD5EA4-6B24-52A8-A42A-B6A03FF1D085","و أرى الأيامَ لا تَبْ","خَلُ إلاَّ بنَظيرِكْ"],["657CD98E-B08E-55A5-813E-31E14C3B9EA1","قلتُ للحاسِدِصبراً","إذ نَوى نَيلَ صَبيرِكْ"],["5A0F62C0-0079-5925-8420-D9DEAB424D89","أنتَ غَيْثٌ لموالي","كَو لَيثٌ لمُثيرِكْ"],["0D0E41BD-C3AF-5027-8A1C-734820C0ADF3","فالوَرَى في بَرْدِ آصا","لِكَأو حَرِّ هَجيرِكْ"],["ED4C5DA5-F6D5-54E0-8EEF-9B03E8CDFABB","لا تنَبِّي عن مَعالي","كَ الورى مثلُ خبيرِكْ"],["7B804052-7446-5033-87FC-24F972390C99","شِدْتَ عَلياكَ بتَغلي","سِك فيها وبُكورِكْ"],["E8331BFB-674C-58E7-A507-DC6370405535","ظاهراً للحمدِ تُنبي","هِ على بُعْدِ ظَهيرِكْ"],["C73F68D7-0086-57F3-B85D-CDA4AB0B223D","كَيْفَمَا جرَّدْتَ أقلا","مَكَ أغنَتْ عن ذُكورِكْ"],["87BD7F23-BE17-53B2-B24F-ABC71FE9A392","فكأنَّ الدَّهرَ قد سَطْ","طَرَ ما بينَ سُطورِكْ"],["AB6BAC05-B9C5-5F37-802D-A63A8937D9D7","بِدَعٌ ترتَعُ منها ال","عينُ في وَشْيِ حَبيرِكْ"],["F45F27B6-1CE1-507D-BFCB-096F7F3C468A","حسْبُنا من جُودِكَ العَم","رِو من فَيضِ بُحورِكْ"],["F5E28161-A879-5AA5-A8E0-69FB4258C455","قد أتانا منه ما زا","دَ على شُكْرِ شُكورِكْ"],["F332D74E-BB18-5304-81E2-BE3AA4E527FD","بينَ صُفْرٍ من دناني","رِكَأو صُفرِ خُمورِكْ"],["285A5F1D-92C2-5244-B409-172365426C6F","فاشفَعِ العُرْفَ بعَرْفٍ","تَرتضيه من بَخُورِكْ"],["6A0A7A88-AFE0-5FA7-B4F2-9F45D885F3AD","وَبْقَ لا أَقصرَ صوبُ ال","مُزْنِ عن فِيحِ قُصورِكْ"]]},"8D74F9AC-411B-5B80-86D6-3CFDD54D9B77":{"t":"يا ابنَ فَهْدٍو أنتَ بدرُ تَمامِ","p":128,"s":"يا ابن فهدو أنت بدر تمام","r":"458837","v":[["F58AA1AD-2DDB-57FA-8C2D-DDD76AB2656A","يا ابنَ فَهْدٍو أنتَ بدرُ تَمامِ","وَ حَياً صوبُه حياةُ الأنامِ"],["014100D7-8440-5805-9307-B8AF07E1225A","لَحَظَتْ عَزْمَتِي العِراقَفَسلَّتْ","هِمَّتي للرَّحيلِ سيفَ اعتِزامِ"],["B1F28B65-7ADB-52F0-ABA4-115BFEAA0E6E","فسَلامٌ على جَنابِكَ والمَن","هَلِ والظِّلِّ والأيادي الجِسامِ"],["DCF3CB76-C6BB-5A9A-8EBB-1572AAAF282A","غيرَ أني أريدُ منك كِتاباً","مُفْرَداً يحتوي فريدَ الكَلامِ"],["C48ACB8C-2345-5B01-B95D-B1EF27395755","و نِظامٌ فيه الحَلالُ من السِّحْ","رِ تَعالَى عن كلِّ سِحْرٍ حَرامِ"],["B3C98B83-A3B9-5BC1-AFE6-BDF120FA20BE","يَغْتَدي منه سَمْعُ كلِّ لبيبٍ","في استماعٍو قلبُه في ابتِسامِ"],["D800E65F-E534-57A2-A330-3F84CB891266","فيه من ظاهرِ العِنايَةِ ما يُو","جِبُ حَقِّي على الأميرِ الهُمامِ"],["C12B2295-060A-50C2-8ED5-26AAC07C52A7","فاقضِ حَقِّي فيه بساعدِ فِكْرٍ","تُحْيِ شُكْري بها مَدَى الأيَّامِ"]]},"40E68EAB-5AD5-5478-A36D-F5640D113E32":{"t":"يا ابْنَ حَسَّانَو الأنامُ ضُروبٌ","p":128,"s":"يا ابن حسانو الأنام ضروب","r":"458720","v":[["0C7DE532-5BBF-5AD3-A9A5-1BB46250F47A","يا ابْنَ حَسَّانَو الأنامُ ضُروبٌ","حينَ تَتلو أخبارَهمو صُنوفُ"],["ADD992CB-7660-5A0C-95FC-E2413D5A6D15","غَرَّني منك ناظِرٌ يُكثرُ الإط","راقَ سَمتاًو شارِبٌ مَحفوفُ"],["072A1262-07B7-5C08-A587-8B45586FDC78","وَ تَكَشَّفْتَفالعَوارُ الذي ما","زِلْتَ تُخفيهِ ظاهِرٌ مَكشوفُ"],["F4B79322-4610-5767-9912-CADFEAE1E37D","مُولَعٌ بالقُطوبِ يُظْهِرُ سُخْطاً","و رِضاهإذا استشاطَطَفيفُ"],["A44C0DBB-A7ED-578A-84C1-F78439055A38","كنتُ أُبقي على العَذولِو ما أد","ري بأنَّ العَذولَ طُرّاً لَفيفُ"]]},"9F301BE2-6D4C-5E04-ACFF-E40E911C59BB":{"t":"يا حَبَّذا تحيَّةٌ","p":128,"s":"يا حبذا تحية","r":"458649","v":[["DD61F4D4-3AEA-5A8E-B280-7A09AA7DBE36","يا حَبَّذا تحيَّةٌ","رُحْتُ بها مسرورا"],["83167044-5C1C-5E94-ABC4-33740D645CB0","إذ جاءَني يَحمِلُها","ظبْيٌ يُباهي الحُورا"],["B13BFFA0-5DA2-5F21-9359-61BBCCCF53E7","شبَّهْتُها في كَفِّهِ","و قد كَساها نُورا"],["06526CD1-B135-59EE-AD43-3CDAEC8270EA","مَخْزَنَةً من ذَهَبٍ","قد مُلِئَتْ كافورا"]]},"A9DBAD98-03C8-5CC8-9860-889886759671":{"t":"يا حُسْنَ لَيْنُوفَرٍ شُغِفْتُ به","p":128,"s":"يا حسن لينوفر شغفت به","r":"458492","v":[["A52B3964-2E4D-59BD-8B7C-284E77CC3F04","يا حُسْنَ لَيْنُوفَرٍ شُغِفْتُ به","يمنَحُه الماءُ صفْوَ مشروبِهْ"],["39AA757D-2F29-5473-855C-78F95ADBEBE7","كأنه عاشقٌ به ظمأٌ","توهَّمَ الماءَ ريقَ محبوبِهْ"]]},"F7FC9009-18BA-5DC7-812D-F0C402DBB61A":{"t":"يا دارَ يُوسُفَ لا عَدَتْكِ تَحيَّةٌ","p":128,"s":"يا دار يوسف لا عدتك تحية","r":"458756","v":[["4917BDA5-7E26-5530-B1FF-7B5827A49F3D","يا دارَ يُوسُفَ لا عَدَتْكِ تَحيَّةٌ","للمُزْنِ بينَ رَواعِدٍ وبَوارِقِ"],["FC224151-C823-54C5-A602-2BCC7B7142E4","غَرَّاءُ ضَاحِكَةٌ إليكِ ثُغورُها","ضَحِكَ الحبيبِ إلى المُحِبِّ الوامقِ"],["AB73E650-FA0F-59EB-996D-1DF7B732F681","سَقْياً لتلكَ مَنازِلاً مَعْمورَةً","من بينِ مطروقِ الفِناءِ وطَارقِ"],["DCA8EDAE-AD3C-5007-BA82-879BF25B4B27","حُمْرَ القَواعدِ والقِبابِكأنَّما","أُشْرِبْنَ رَقْراقَ الخَلوقِ الرَّائقِ"],["242E8AB5-DCEF-561E-B550-8C6F2B5DE2EB","يَلقاكَ من نُوَّارِها وغُيومِها","ما بينَ دُكْنِ مَطارفٍ ونمارقِ"],["EA25B07D-FDE8-5EC3-BEDF-8D997E7AEBD9","و الهَيْكَلُ المُبيَضُّ يَلمَعُ وَسْطَها","كالأُقحُوانَةِ في بِساطِ شَقائقِ"],["CBC5BC33-D5C3-5593-A6AF-8544D83CD032","كم دُمْيَةٍ خَرساءَ فيهو دُمْيَةٍ","فَضَلَتْ عليها باللِّسانِ النَّاطقِ"],["CD465477-F774-5D3F-80F1-E05C1866E70E","من أَهْيَفَ تَيجُانهُ من شَعرِه","فكأنّما هو شارِقٌ من غاسقِ"],["D4944FDC-76CA-578A-A4B1-D9D5C9DE45D7","و مُهَفهَفٍ لو كنتُ أَملِكُ أمرَه","بدَّلْتُ سُحْمَ مُسوحِه بقَراطقِ"],["CD7D4D4A-9E02-5F54-8144-AE299579740B","كم قد رَمَقْتُ به المُنى فغَشِيتُها","ما بين مَرموقِ الجَمالِ ورامقِ"],["1AFD4108-547C-5DF2-8304-C6875C055C73","و مُعّذَّلٍ أخذَ الصِّبا بيمينِه","فجَرى به جَرْيَ الجَموحِ السابقِ"],["56561F84-137F-517D-AF95-52B8B255794C","وَ رَقَدْتُ عن غِزلانِه وذِئابِهِ","ما بينَ مَسروقِ الوِصالِ وسارقِ"],["5879863F-55D6-5876-8409-8148797297A2","أيامَ كنتُإذا ادلَهَمَّ ظَلامُه","أهدَى إليه من الخَيالِ الطَّارقِ"],["CB2542A2-DCCD-57C9-A775-41ADCF90389E","عَصراً لَبِستُ ظِلالَهو كأنَّه","في ظُلمَةِ الأيَّامِ غُرَّةُ شَارِقِ"]]},"217A9C9D-1E76-5F30-92CA-298384AF518C":{"t":"يا دَهْرُصافيتَ اللِّئامَ مُساعِدا","p":128,"s":"يا دهرصافيت اللئام مساعدا","r":"458560","v":[["DE15A5AD-F689-5D0A-A76A-BFBC624A4BAE","يا دَهْرُصافيتَ اللِّئامَ مُساعِدا","لهُمُو جانَبْتَ الكِرامَ مُعانِدا"],["96C6B954-14E0-5E3A-8639-091BBBEEAAD3","فغَدَوْتَ كالمِيزانِ يَرْفَعُ ناقِصاً","فيناو يَخْفِضُلا محالةَزائدا"]]},"72E53643-E74B-506C-AFBE-AD3427D937BA":{"t":"يا رُبَّ جسمٍ كلُّه نواظرُ","p":128,"s":"يا رب جسم كله نواظر","r":"458642","v":[["330AECDE-F727-5429-B5CD-BC55F176C78B","يا رُبَّ جسمٍ كلُّه نواظرُ","بآمُقٍليسَت لها مَحاجِرُ"],["983D4BD7-3EA8-57E9-8C32-51E55C9F6C9D","تستُرُ عنك الشيءَ وهو ظاهرُ","محبوبةٌ خلالُها الغَوَادِرُ"],["63F4C3F5-6386-5A8B-80D8-730904230AC5","إذا ارتدَتْها اللُّجَجُ الزَّواخِرُ","وَ ضَمَّها مِثلَ المِرَاةِ مائرُ"],["1138EA23-4232-5D2A-BAD5-844924B2597F","جاءَت من الرِّزقِ بها جواهرُ","صَغَائِرٌ تُومِضُ أو كبائرُ"],["F6BABC3C-041F-5D34-BC41-9A75C6D891FB","كأنهاإذا انتحاها الناظرُ","مَخازِنُ الفِضَّةِأو خَناجرُ"]]},"8BE1C70C-8B38-50D4-93B2-9E6BD33BE86D":{"t":"يا رُبَّ مِقنَعةٍ حمراءَ تَلبَسُها","p":128,"s":"يا رب مقنعة حمراء تلبسها","r":"458625","v":[["DFD4E663-9A87-5280-BF45-05AA7CFE2E66","يا رُبَّ مِقنَعةٍ حمراءَ تَلبَسُها","سَوداءُ للَّيلِ من تَركيبِها قَارُ"],["D7A3FB5F-1F42-50B3-8D23-2D6447926F89","تَلوحُ في العيدِو الأبصارُ تَرمُقُها","كأنها فَحمَةٌ في رأسِها نارُ"]]},"0AF90D32-CE32-5806-AFBF-9C344C2D4931":{"t":"يا رُبَّ نائيةٍ كأنَّ ضِرامَها","p":128,"s":"يا رب نائية كأن ضرامها","r":"458640","v":[["56CD8F7E-483A-571B-8013-19834E1B434F","يا رُبَّ نائيةٍ كأنَّ ضِرامَها","دانٍإذا شِمناه بالأَبصارِ"],["A163BBF0-7279-5F5F-8E43-4EAAE32FCD9C","خَفَقَتْ كما خَفقَتْ ذَوائبُ رايَةٍ","حَمراءَ في لَدُنِ الذُّرى خَطَّارِ"],["43FE6BB8-C7DA-5EB3-9941-DE27CC40FE09","تَفري من الليل البهيمِ سُرادِقاً","دونَ النواظرِ مُغْدَفَ الأستارِ"],["C28552DB-9C09-510A-B420-2FE4B4AAF445","عَبِثَتْ بها ريحُ الصَّبافكأنها","كفٌّ تُشير بِبَارَقٍ وسِوارِ"],["807B5149-335F-5CB1-8C49-27EF1EE0B125","يا حبَّذا هيَ في سُرادِقِ ليلِنا","و الصُّبحُ يفضَحُ كامنَ النُّوَّارِ"]]},"C521FAAB-05C8-5F6A-B1ED-BBDDEDD714C7":{"t":"يا سارِقَ الشُّعَراءِ ما نَظَمُوهُ من","p":128,"s":"يا سارق الشعراء ما نظموه من","r":"458785","v":[["6ED31504-AD98-528D-A81B-1F8C6323E9DA","يا سارِقَ الشُّعَراءِ ما نَظَمُوهُ من","دُرٍّ كَزَاهِرَةِ النُّجومِ مُفَصَّلِ"],["42A5C72B-CFC3-5B8E-AB6A-FD2DE721E7F4","إن كانَ شِعْري في إِسارِكَ مُوثَقاً","ما بينَ مَغلولٍ وبينَ مُكَبَّلِ"],["522A425F-4D8F-543A-B924-484A69F12541","لو كُنتَ لا تُعْطي الأمانَ مَدائحي","من وَثْبةٍأو غارَةٍ لا تَنْجَلي"],["D1D8F369-BBE3-56F6-9228-14C9F9E42DCD","فخَفِ الإلَهَو ما أظُنُّكَ خَائِفاً","أن تَدَّعي سُوَرَ الكِتابِ المُنزَلِ"],["3CC7ACBD-33DB-5E22-9183-84FDBFCA8B79","فالناسُ مِنْكَ مُحَيَّرونَ تَخوُّفاً","أن تَمْتَحِي سُنَنَ النَّبيِّ المُرسَلِ"],["F20C775C-8D42-54AB-B6A3-F3BA94E2F7DE","يا خالديُّو كلُّ خِزْيِكَ خالدٌ","لا يَنْقَضي للناظرِ المُتأمِّلِ"],["0B9E3A18-0F8F-5DEB-BA37-7E9A0AFA42C9","ما زِلْتَ إنْ عُدَّ الفَضائِلُ خامِلاً","لكنَّ نَقصَكَ ظاهِرٌ لم يَخمُلِ"]]},"0DD13270-68DB-5EB8-87F5-B4F5894E1395":{"t":"يا ليلةً جَمَعَتْنا بعدَ مُفتَرَقٍ","p":128,"s":"يا ليلة جمعتنا بعد مفترق","r":"458735","v":[["31127F18-E856-5486-ACFB-9422CD99603A","يا ليلةً جَمَعَتْنا بعدَ مُفتَرَقٍ","فبِتُّ من صُبْحِهاحتَّى بدافَرِقا"],["1F0C5F7C-2908-5DC5-A390-E803D57FAFF3","لمَّا خَلَوتُبمن أَهوى بها","فكادَ يَسبُقُ منها فجرُها الشَّفَقا"]]},"C80D6CD1-1101-5729-95EB-F3077D57A56B":{"t":"يا مَنْ أنامِلُه كالعارضِ السَّاري","p":128,"s":"يا من أنامله كالعارض الساري","r":"458610","v":[["2501B24A-E01D-54F9-8E3E-EFFE6DEDE99D","يا مَنْ أنامِلُه كالعارضِ السَّاري","و فِعْلُه أبداً عَارٍ من العارِ"],["51A2FF80-58FA-57E7-A5BD-415E06E0C0F8","أما ترى الثَّلجَ قد خاطَتْ أنامِلُه","ثوباً يُزَرُّ على الدُّنيا بأزرارِ"],["D3293FE2-560C-58B9-A069-1A6E55515A25","نارٌو لكنَّها ليسَت بمُبدِيَةٍ","نُوراًو ماءٌ ولكنْ ليسَ بالجاري"],["B4AF5867-6F43-5A79-A9C0-5A7E06E9A96C","و الرَّاحُ قد أعوَزَتْنا في صَبيحَتِنا","بَيْعاًو لو وَزنَ دينارٍ بدينارِ"]]},"0B971F02-E75B-5BA9-AAF9-5A788BAF9ECC":{"t":"يا مَنْ لَدَيْهِ العَفافُ والوَرَعُ","p":128,"s":"يا من لديه العفاف والورع","r":"458688","v":[["10AFEEA9-7A15-5D84-A643-895423EC0069","يا مَنْ لَدَيْهِ العَفافُ والوَرَعُ","و شيمتاه العَلاءُ والرِّفَعُ"],["04302557-4309-59DF-ABB3-C6044121D081","كأسُكَ قد فُرِّقَتْ مَفاصِلُه","بين النَّدامى فليسَ تَجتَمِعُ"],["621A2AD5-24C7-5724-B1DC-7483D359F04F","كأنَّما الشَّمْسُ بينَهم سَقَطَتْ","فجِسمُها في أكُفِّهِم قِطَعُ"],["498A741B-BF5B-5370-8A4E-7251DA83EAA5","لو لم أَكُنْ واثقاً بمُشبِهِه","منكلكادَ الفُؤادُ يَنْصَدِعُ"],["1B00691F-C9A5-53C9-986D-5BD7476C16D0","فجُدْ به بِدْعَةًفعِنْدي من","جُودِكَ أشياءُ كلُّها بِدَعُ"]]},"29227FF7-03A7-5785-A72E-550D2C96A503":{"t":"يومُ رَذاذٍ مُمسَّكُ الحُجُبِ","p":128,"s":"يوم رذاذ ممسك الحجب","r":"458488","v":[["FCF96A95-0EF6-51CF-8C34-59CFE2F2497C","يومُ رَذاذٍ مُمسَّكُ الحُجُبِ","يَضحَكُ فيه السُّرورُ من كَثَبِ"],["81E0C78D-951B-5126-82B2-F4C2178DAEE9","و مَجلِسٌ أُسبِلَتْ ستائرُه","على شُموسِ البَهاءِ والحَسَبِ"],["648D1650-A872-57AF-981C-DA94BD81CF9F","و قد جرَتْ خيلُ راحِنا خَبَباً","في جَرْيِهاأو همَمْنَ بالخَبَبِ"],["A8E0BD04-A5AE-5002-AD79-77D81F4B0691","و التهَبَت نَارُنَافمنظرُها","يُغنيكَ عن كلِّ منظرٍ عَجَبِ"],["70B6D4AF-94B9-5A90-AAB4-3F359FA4EE01","إذا ارتمَتْ بالشَّرارِ واطَّرَدَتْ","على ذُراها مَطاردُ اللَّهَبِ"],["B30D6725-1307-5EB2-95E8-070E606FB18F","رأيتَ ياقوتةً مشبَّكةً","تَطِيرُ عنها قُراضَةُ الذَّهَبِ"],["44F2E761-133A-5E29-851C-D7DD8CBE6E1D","فسِرْ إلى المجلسِ الذي ابتسمَتْ","فيه رياضُ الجَمالِ والأدَبِ"]]},"5A7B4087-0CC0-51CC-95AC-CEFFE5DFC4E6":{"t":"يَأبَى إذا خَطَرَ العقيقُ ببالِه","p":128,"s":"يأبى إذا خطر العقيق بباله","r":"458796","v":[["6658A9BF-6FB1-54BF-A5F3-462E7C738FC5","يَأبَى إذا خَطَرَ العقيقُ ببالِه","إلا اطِّراحَ العَذلِ من عُذَّالِه"],["1A9F0B60-A691-5C81-94C8-A1FE4C5F3AF4","قَسَمَ الدّموعَ على المنازلِ عالماً","أنّ الجوى فيهنَّ من أنذالِه"],["723C6812-DCC2-5B8F-9944-93AA77260B80","وَهُوَ الكَثِيبُ تلاعبَت أيدي النَّوى","بكثِيبِهِ وقضيبِه وهِلالِه"],["B11B527D-A49E-5E67-86AF-B7F854B0D989","رَاحُوا به واللّحظُ يقدَحُ جُرأةً","فَيكُرُّ بينَ حُجولِه وحِجالِه"],["904C7EEA-89C7-5B03-9257-1060473308AB","و الشَّوقُ ينثُرُ دمعَه في خَدِّهِ","فيقَرُّأو يَجري على جِريالِه"],["D0597971-A7D7-5B74-848D-54A73AA8F1C5","يا دارُ جادَ بها الفِراقُ جَمالَها","فغدا وراحَ على ظُهورِ جِمالِه"],["242BFBFB-8815-50CF-ABFD-99A2173DB882","ما بالُ رِيمِكَ لا يُتاحُ لِقاؤُه","لمُحبِّه إلا غداةَ زِيالِه"],["92EE59AE-9C15-5FDB-B282-3D2F2ABE605F","فسُقِيتِ رَجعَ حُدوجِه وسَقى الحيا","محتلَّهُو سُقيتُ عَودَ وِصالِه"],["584E0BFA-EC30-50A2-97F0-F859A716020E","و رقيقةٍ كالآلِ نادمني بها","كِسرى فرُحتُ كأنَّني من آلِه"],["D0B86E07-B12C-5728-A1D7-5B87384692F3","ألقَاه إمَّا حَاسِراً لصَبوحِه","فيهاو إمَّا دارعاً لقِتالِه"],["78581053-5DAA-5C14-B7B3-5298BC621F6F","وأداه ساقَ لنا أداةَ شَمولِهِ","مجموعةً بيمينِه وشِمالِه"],["269695EB-662C-5D8D-A576-48597559D00F","أو نابِل لمّا تَكامَلَ نَزعُه","لم تتَّصل أغراضُه بنِبالِه"],["E02E52E8-582F-562A-BC6C-CFA3F2FF8C09","أتُراه صانَ عن الرَّمِيَّةِ سَهمَه","أم رأفةٌ مَنَعته عن إِرسالِه"],["754F76CA-3056-5BA5-A052-48C8F273483F","عصرٌ مَزَجتُ شَمائلي بشَمولِه","و ظِلالُه ممزوجةٌ بشَمالِه"],["59CEA1E1-F532-5B1B-9D49-84FCEE3A137A","حتَّى حَسِبتُ الوَردَ من أشجارِه","عَبِقاًأو الرَّيحانَ من آصالِه"],["D9704405-1534-51F1-B2E5-C36D716D50CA","و كأنني لمّا ارتديتُ ظِلالَه","جارُ الوزيرِ المُرتدي بظِلالِه"],["F6340E77-4283-56D9-AB12-6C2763802DFA","الواترِ الأموالِ يومَ عَطائِه","و النافضِ الأوتارِ يومَ نِزالِه"],["BBA43198-FB06-5F0A-9960-E215A5C3C85B","مَلِكٌ تُحاذرُه الملوكُفمُمسِكٌ","بحبالِهأو هالكٌ بِصِيالِه"],["7474E439-F0F2-5C50-9968-F46861B26B19","أموالُه في السِّلمِ من أنفالِها","و نفوسُها في الحربِ من أنفالِه"],["D59CE0A3-4772-5492-9C1C-5F8FC98773DB","صُقِلَ الزمانُفعادَ في أيامِه","كالبُردِ في تفويفِه وصَقالِه"],["21296B3F-79E1-5D13-876E-CB2572678114","إن كنتَ تشتاقُ الحِمامَفعادِه؛","أو كنتَ تختارُ الحياةَ فوالِه"],["0C0101AE-177A-5901-BCA7-241941352D21","يُعطِيك ما يُعطيه كرُّ جيادِه","و شَبا أَسِنَّتِه وحَدُّ نِصالِه"],["E53E189F-9578-558B-AEF8-718D04749CDA","حملَ القنَا فاهتزَّ في مُهتزَّهِ","طرَباً لهو اختالَ في مُختالِه"],["B0781496-0847-589C-990C-91A21F63669E","فأَرى العدوَّ نقيصةً في عُمرهِ؛","و أرَى الصديقَ زيادةً في حالِه"],["1257FEE2-8679-5375-9061-959A7BD6DCE4","بوقائعٍ للبأسِ في أعدائه","و وقائعٍ للجود في أموالِه"],["D2CAE6AB-B636-50BD-A6C9-B169920D54CB","عَذَلوه في الجَدوَى وَمن يَثنِي الحيا","أم من يَسُدُّ عليه طُرْقَ سِجالِه"],["D4D4C4A4-D001-5941-A3F7-5F201A5D34EA","متشابهُ الطَّرَفينِ أصبحَ عمُّه","في ذُروةٍ لم تَعْدُ ذُروةَ خالِه"],["2B0BA1E7-E3F8-50EF-A8A7-6D2197772DD9","شرَفٌ أطالَ قَنا المُهَلَّبِ سَمْكَه","حتَى أظلَّ وعمَّ في إِظلالِه"],["8CA3F12A-07FF-519B-9028-98B2F0E9C0C4","فإذا بدَت زُهْرُ الكواكبِ حولَه","كانَت عمائمُهنَّ من أذيالِه"],["8B867DF8-B637-5B5B-BF31-78D25318BA1F","راحَ المُغِيرةُو هو من أجوادِه","و غَدا قُبَيصةُ وهو من أبطالِه"],["719314F6-48E7-5D66-B31C-F1D7DD35234B","فارَت صدورُ رِماحِكم بصُدورِه","و الناسُ مشتركون في أكفالِه"],["D084874D-178D-57A3-95BE-FF8A44965A38","أما السَّماحُفقد تبسَّمَ نَوْرُه","بعدَ الذَبولِ وعادَ نُورُ ذُبالِه"],["512CF328-AD78-51F1-AF90-F4EC11FA0A61","أطلقْتَ من أغلالِه وشَفَيتَ من","أَعلالِه وفتحتَ من أقفالِه"],["01897259-B663-55CB-BEC5-342E02D64231","إنَّ الوزيرَ دَعا إلى عمرِ النَّدى","من كان موقوفاً على أوشالِه"],["9CC39F35-15DC-502F-8E59-4EBD79F09457","أُثني عليه ثناءَ رَوضٍ هَزَّه","سَيلُ الحيا فاهتزَّ في إسبالِه"],["58C63858-C9F9-502E-BA47-36CF904FFFA1","و أقولُ للسَّاعي ليُدرِكَ شأوَه","أنتَ الجوادُ ولستَ من أشكالِه"],["59053053-EE71-5937-BD1B-133225B55E2E","كَمَلَتْ مَناقبُه فلو زادَ امرؤٌ","بعدَ الكمالِ لزادَ بعدَ كمالِه"],["BF87700F-1942-52AE-AD73-1274C6F13139","و غَدَت خَلائقُه أحَقَّ بمنطِقي","فمزَجتُ صفوَ زُلالِها بزُلالِه"],["A06B4FD9-7450-5E2E-B59C-7AA37604362D","أُهدي له ما رَقَّ من أَفوافِه","و أُبيحُه ما رَقَّ من سَلسالِه"],["6D761490-A090-50EA-9D44-FC82E905426F","و يقولُ لي قومٌفَضَلْتَ وإنّما","فَضلُ الثَّناءِ عليهِ من إفضالِه"],["DA4766F3-7B4B-5590-87A1-BFDFC3229043","لا حمدَ لي إن راحَ دُرُّ مدائحي","عِقداًو قد فصَّلتُه بخِلالِه"]]},"98BB3551-2416-5750-9DC7-390847039804":{"t":"يَغُضُّ الطَّرْفَ عن وَرْدِ الخدُودِ","p":128,"s":"يغض الطرف عن ورد الخدود","r":"458543","v":[["2C0F0E54-89B7-52D8-BF2B-0195C65DB341","يَغُضُّ الطَّرْفَ عن وَرْدِ الخدُودِ","و يُعْرِضُ عن مُهَفْهَفَةِ القُدودِ"],["949BD5A8-C4BD-56F2-AF11-158585EFEB71","مُقِرٌ للعَواذلِ بالتَّصابي؛","مُقيمٌ للوُشاةِ على الجُحودِ"],["8DE9DBD4-F1F4-5EA0-A7EB-11AB66EF8E36","أَفادَ به الهَوى شَوْقاً طَريفاً","يُضَرِّمُ لوعةَ الشَّوقِ التَّليدِ"],["7B86771C-C064-5DBA-A9C4-D16FDBEBB852","و من جَوْرِ الهَوى أن راحَ يُزْجي","مَطايا البَيْنِ في أَثَرِ الصُّدودِ"],["5E3906A0-5EF7-5CDF-AB67-1258802945E0","و فَوقَ العِيشِ بِيضٌ وكَّلَتْنا","بأيامٍ من الهِجرانِ سُودِ"],["8E7C115A-83C6-52CE-8E4D-F9E83F84F948","و غِزلانٌ تُزيلُ الوَشيَ صَوْناً","لوَشْيِ جمالِها الغَضِّ الجديدِ"],["D48418D5-099D-59CE-82A6-DBB9B7BE4DFB","إذا خطرَت فما للقُمْصِ إلا","مصافحةُ الرَّوادِفِ والنُّهودِ"],["EDDE5463-B24E-53C3-86E7-90D6F23EB19B","هيَ الأيامُ إن جمحَتْ عِناداً","أذَلَّتْ كلَّ جبَّارٍ عنيدِ"],["E7052981-14AC-5AE5-9DE1-AF64FFFC9D04","تنامُ وَتُطْرِقُ الأحداثُ يَقْظَى","و لوعَ الطَّيفِ بالرَّكْبِ الهُجُودِ"],["311095D2-F86E-5044-9CF1-1043A0D7297B","إليكَفرُبَّ هاجرةٍ أفاءَتْأيخشى الخطب ذو قلب حداد وخطب غياهبه حديد","عليَّ إفاءَةَ الظِّلِّ المَديدِسقط بيت"],["464AC13B-6B55-5764-8529-146D281DAC97","إذا لم آوِ فيه إلى ابنِ فهدٍ","فما آوي إلى رُكْنٍ شَديدِ"],["2E5C4D8A-69B0-53A1-A5C3-1DF4B02E93FF","إذا حَلَّ الوفودُ له مَحَلاًّ","غدَوا وحملُّهم عَطَنُ الوُفودِ"],["FDE05EEF-389A-57FF-9D79-2D2DD28C5C46","أتيتُ مُروِّعاً يهتزُّ جأشي","فأُبتُ محسَّداً يَهتزُّ عودي"],["03B9C7A7-AE09-5A0B-822A-DE399D71C727","فَعِشْ للمجدِ تُنْجِزُ فيه وَعْداً","من الجَدوى وتَصفَحُ عن وَعيدِ"]]},"2A246151-F8AE-514C-9C6D-0410A3C0EEC1":{"t":"يَكْفيكَ أنَّ قُنافاً راعَه غَضَبي","p":128,"s":"يكفيك أن قنافا راعه غضبي","r":"458744","v":[["C9317C88-0DCC-522D-8A11-BD28CA820B62","يَكْفيكَ أنَّ قُنافاً راعَه غَضَبي","قبلَ الهِجاءِفلاقى الحَينَ من فَرَقِ"],["4C88173D-7F9D-5571-B360-67BC1D4BA2CD","لو أنَّ قَمْلَ قُنافٍ ثَلَّةٌ رَتَعَتْ","ليلاً من النَّقْعِ يَمحو غُرَّةَ الفَلَقِ"],["033A3695-BA11-5D4A-8AF0-998A85C6D487","يا قاتلَ الفأرِ حتَّى ما يُحِسُّهُمُ","أهلُ المنازلِ في صُبْحٍ ولا غَسَقِ"],["D6E7A4E0-3A74-5593-9C2D-277C4E4A6195","قد كانَ لي وَطَرٌ في الشِّعْرِ أَخْلَقَهُ","ما جالَ في أُذُني من شِعرِكَ الخَلَقِ"],["0CDCB329-7115-52BE-951F-1DE533F1C389","ليسَ القَريضُ دَواً للفأرِ تَحمِلُه","من الشَّوارِعِ والأَسواقِ في طَبَقِ"],["DDEB8CA1-5AE9-5AB6-A6B5-65410E33BF32","سَرَقْتَ شِعْري وكُردوسٌ أَخوكَ فقَد","شُهِرْتُما عندَ كلِّ الناسِ بالسَّرَقِ"]]},"077103A8-FC41-5F71-A82F-5E7A2D7CB68A":{"t":"يَومٌ خَلعتُ به عِذاري","p":128,"s":"يوم خلعت به عذاري","r":"458608","v":[["6F6411DE-113C-5050-8A25-11377A5EC8AD","يَومٌ خَلعتُ به عِذاري","فعَرِيتُ من حُلَلِ الوَقارِ"],["B9BB6B08-A916-53DD-BE97-FAD78F7FC1A5","وَ صَبَوْتُ فيه إلى الصِّبا","و الشَّيبُ يَضحَكُ في عِذاري"],["E928F54E-06ED-5A7E-89D1-9C26EB047F71","مُتَلَوِّنٌ يُبْدي لنا","طُرَفاً بأطرافِ النَّهارِ"],["55D223F5-0790-545A-A6DD-4446AD34B3CF","فَهواؤُه سَكْبُ الرِّدا","ءِو غيمُه صافي الإزارِ"],["65A22123-F5D0-53D1-87F7-DEE4901CF1B0","و سماؤُه تخبُو الرُّبى","بشبيهِ مكنونِ البِحارِ"],["F7A26909-F864-5DBB-9776-6A2EBAE2DA23","تَبكي فيجمُدُ ماؤُها","و البرقُ يَكحَلُها بنارِ"]]},"EEED771E-7A26-5119-A4E3-BF9607F7CE05":{"t":"يُؤَرِّقُهُإذا البرقُ استنارا","p":128,"s":"يؤرقهإذا البرق استنارا","r":"458582","v":[["C5E3C6F4-006E-587F-977E-B4B31BDB19F0","يُؤَرِّقُهُإذا البرقُ استنارا","هوىً يقتادُ عَبْرَتَه اقتسَارا"],["FB57C67A-5003-52D1-A7B9-C4CBCE43672A","بَدا مِشْقاً تَرودُ العينُ فيه","فتَقرَأُ من لوامِعِه ادِّكارا"],["778E78E0-7943-58E6-B342-1A007E7F3280","و نَمنمةً تُضيءُ له وتَخبُو","كما طَيَّرْتَ عن زَندٍ شَرارا"],["F23215D0-5C3C-53B9-B738-5DF4EB7BC3B9","و إيماضاً يَشُقُّ الجوَّ شَقّاً","كما قَْتَبَسَتْ إِماءُ الحيِّ نارا"],["83E41C08-2A6D-5E67-9A9E-DA598100A2C3","فرُحْتُ أُسائِلُ الرُّكبانَ عنه","بأيِّ جَنوبِ كاظمةَ استطارا"],["021527CA-553F-5B75-B24A-91031D05EB8D","لأَذكرَني أَعزَّ الناسِ جاراً","و أحلى الأرضِ في عينيَّ دَارا"],["59AEA2E7-6BD6-5458-99AA-29309910EBFA","و عِدْلَ الحبِّ من قومٍ تَعدَّى","عليَّ الشَّوقُ بعدَهُمُفَجارا"],["535570F0-94BD-50C5-8F13-6DECDD5212BD","و ناعمةَ الصِّبا تسجُوفتشجُو","قلوباً من صبابَتِها مِرارا"],["A413C67A-35C7-5F13-A1CE-935C4A585336","أقولُ لهاإذا سفرَتْ ومارَتْ","أَغُصْنُ البانِ أثمَرَ جُلَّنارا"],["632C631B-12F4-5A05-97F5-63D5BA77EF39","أصابَهمُو إن بَعُدُوا منالاً","على العُشَّاقِأو بَعُدُوا مَزارا"],["D3F0C662-8465-5AD4-A3A5-AB5B99AF9993","نسيمُ الرِّيحِ ما راحَتْ جَنوباً","و صوبُ المُزْنِ ما ابتكرَتْ عِشارا"],["97219416-7047-577C-9899-685D8DCBEB7B","سأُعفي الدهرَ من تكديرِ عَذلي","فأَعذِرُهُو إنْ خلعَ العِذارا"],["E43A83B1-0C9B-5C69-A043-0D871F581213","لَقِينا من حوادثِهِ جيوشاً","و خُضْنا من نَوائِبهِ غِمارا"],["66E5A4D9-827E-5070-8E5A-89F7677400F6","فلم نُظْهِرْ له إلا قِراعاً؛","و لم نَلْبَسْ له إلا وَقارا"],["39621311-1DAA-52A0-9438-F948539A9693","و مَنْ يكُنِ الأميرُ له مُجيراً","يكُنْ للكَوكبِ العَلويِّ جَارا"],["392FE7B3-632D-543A-9FBB-40F346BA9451","هو الجبلُ الأَشمُّ حِمىً وعِزّاً","ترَفَّعْ أن تَرى جبلاً مُغارا"],["54C39375-1D6B-50D1-9A8B-1B7692B51FCB","فرَرْتُ إليه من صَرْفِ اللَّيالي","فنكَّبَ جَورُها عني فِرارا"],["1A0995AF-DF62-5B3A-893A-BF52E5B4D4AB","و لمَّا اختَرتُهُ ليَفُلَّ عني","شبَاةَ الدَّهْرِ لم آلُ اختِيارا"],["7719AA4A-8C86-5D90-9734-22B09CB8F2D7","و كانَ القُربُ منه جمالَ دنيا","ترى أيامَهاحُسناًقِصارا"],["9B48642E-25F9-59D1-885D-AF9FEEB9EEC2","و عيشاً ناضرَ الأفنانِ غَضّاً","يَرِفُّإذا اهتصرناهُ اهتِصارا"],["2AA45CC7-F8FE-5EDB-94AB-DAD3F8E12103","فَما بَرِحَ العِدا حتَّى أَعادوا","حلاوَةَ نَشوتي منه خُمارا"],["853B2D79-D150-58E7-9BA8-7D016193D7A8","فعوَّضَني من الأُنسِ انحرافاً؛","و بدَّلَني من البِشْرِ ازوِرارا"],["F8DB547E-72AA-5CF2-A038-339E731FD882","فصِرْتُ أرى نهاري منه ليلاً","و كنتُ أرى به ليلي نَهارا"],["EACD17CE-35F0-5435-AE8C-74AFC01F74B4","أَبِيتُو مُقلتي تُذري نجيعاً","و قد أفنَت مدامعَها الغِزارا"],["B11AD606-4E8A-53EE-A4EF-95105BF9CF88","تَرى الأشفارَ منه مُعَصْفَراتٍ","فتحسَبُ أنها لاقَتْ شِفارا"],["F31A9D4B-39CA-52ED-ACA7-DC9B3FCAD631","أبا الهيجاءِ أصبحَتِ القوافي","تَخُبُّ إليكَ حجّاً واعتِمارا"],["2D2C0E83-9CEA-5860-84B2-6A37215839AA","عِتاباً كالنَّسيمِ جَرى لعَتْبٍ","تضَرِّمُ في الحَشا مني استِعارا"],["F6A2EDC2-43CC-59BF-9019-C12485828576","أُشَعشِعُه لأُطرِبَ سامعيه","كما شَعشَعْتُ بالماءِ العُقارا"],["21920540-6299-543E-9606-8310BB42C4C8","أَيجمُلُ أن أَرى منك انحرافاً","و لا عاراً أتيتُو لا شَنارا"],["3E7038AC-47B9-5A85-B156-BF13897416B0","و لم أَجحَدْ صنائعَ مِنْكَ جلَّتْ","و لم أسلُبْكَ مدحاً فيك سارا"],["7F704D3C-EC06-556C-8F81-B06717E18D36","و لكنِّي كَسَوْتُكَ حَلْيَ قَوْمٍ","رأيتُكَ منهم أزكَى نِجارا"],["5508803C-97A1-50AE-822D-2383AFE74579","و أيُّ غريبَةٍ للشِّعرِ لاقَتْ","عُلاكَفحاولَتْ عنها اصطِبارا"],["AE91DA10-DC96-522C-8CEE-D58ABCDF01BA","تَحِنُّ إليكَ أبكارُ القوافي","إذا اجتُلِيَت رَواحاً وابتِكارا"],["E98E9D7F-D526-5A4B-96E2-E106094B541F","فتقرَبُ منك أُنساً بالمعالي","و تبعُدُ من بُعولتِها نِفارا"],["59273866-2F04-52E3-9975-9EE80E80BA42","و يُؤثرُكَ الثَّناءُ على مُلوكٍ","تَعُدُّ مقامَها فيهم حسارا"],["171BAA7B-9254-5423-8735-738835E015E3","و كيفَ تُلامُ خَيِّرَةُ القَوافي","إذا اختارَتْ من القومِ الخِيارا"],["31E363AA-F6A4-544C-8BF3-4AB750ADBBAB","تبيَّنَ زهوُها في العيدِ لمَّا","رأَتْ مولىً يُتوِّجُها فَخارا"],["78FC13BC-D715-5BFF-A427-A6A49BDC8590","فهزَّتْ عِطْفَها طَرَباً إليه","و أَلقَتْ عن مَحاسِنها الخِمارا"],["ABC71D9C-CFC6-575C-BE6E-50FD293415C8","فإنْ تَكُ هفوةٌ عرَضَتْ سِراراً","فقد أَصْحَبْتُها عُذراً جِهارا"],["A09C32ED-FF78-5401-8D55-40A6CB1C6826","و ممَّا شَيَّدَ الشَّرَفَ المُعَلَّى","ذُنُوبٌ صادَفَتْ منك اغتِفارا"],["0FED3A27-D07A-5DA6-A020-9728C0E4035B","فَضَلْتَ الناسَ فضلاً واقتصاداً","وإشراقاً من الجَدوى ابتِدارا"],["04EE469D-2AEB-5CC3-9355-A7EC251D17A4","و لولا أن أَعوذَكَ من عدوِّي","حَسِبناهُ لنَضرتِه نُضارا"]]},"810B35E8-F876-5001-9FA0-C5BDFD7D99EC":{"t":"يُحيِّي اشتياقاً بعضُنا بك بعضَنا","p":128,"s":"يحيي اشتياقا بعضنا بك بعضنا","r":"458489","v":[["BA8E51E6-D46B-5A7E-977F-DEC02B7ABDD7","يُحيِّي اشتياقاً بعضُنا بك بعضَنا","إذا قَبَّلَ الكاسَ الرَّويَّةَ شاربُ"],["67E0AFBB-F9B0-5415-850E-D9879D20E4DD","و عندي لك الرَّيحانُ زِينَ بَساطُه","بِزَهْرٍ كما زانَتْ سماءً كو اكبُ"],["BA0948CF-15BA-537C-A929-9C2C80B6C1E5","و ذيْلٌ كما انجرَّتْ ذُيولُ غَلائلٍ","مُصَنْدَلَةٍ تختالُ فيها الكواعبُ"],["2E2C4CE0-E4F6-5719-B463-2835DC5D685D","سقاه دموعَ الوَردِ سافٍ أَسالَه","و شابَ له الكافورَ بالمِسكِ شائبُ"],["3D299D9D-F91E-57E3-AD56-B1DD7F3AED5D","و قد أُطلِقَت فيه الشمائلُ وانثَنتْ","مقيّدةً في جانِبَيْهِ الجَنائبُ"],["4D3FEA07-3C48-5822-BE43-B8EC11096013","و حافظةٌ ماءَ الحياةِ لِفتيةٍ","حياتُهمُ أن تُسْتَلَذَّ المَشارِبُ"],["EC10403A-0474-5EEF-B985-6F0BAC071FC8","يسربلُها أجفى اللِّباسِو إنما","يَليقُ بها أفوافُه والسَّبائبُ"],["2FA953F9-86CA-5F12-90FE-CB58FFCDE237","على جَسَدٍ مثلِ الزَّبَرْجَدِ لم يَزَلْ","يُشاكِلُه في لَونِه ويُناسِبُ"],["D6B0CE19-6CC1-57E2-B256-898110D2E4FD","إذا استُودِعَتْ حُرَّ اللُّجَينِ سبائكاً","يُصوَّبُ من أجسامِها وهو ذائبُ"]]},"403AA520-B923-5468-AE60-840B5765CF57":{"t":"يُريكَ قوامَها الغصنُ الرطيبُ","p":128,"s":"يريك قوامها الغصن الرطيب","r":"458450","v":[["44C0E567-8504-54B0-8A8B-96A0A8A4A8AE","يُريكَ قوامَها الغصنُ الرطيبُ","ولحظَ جفونِها الرشأُ الربيبُ"],["B0F301B4-6297-55DA-84AF-D6F509EE4739","غَداةَ بَدا لها خدٌّ أسيلٌ","يُنَمنِمُ وشيَه كفٌّ خَضيبُ"],["DD7B7DDC-09E4-53D0-A671-E53760721785","وأدناها من الصبِّ التنائي؛","كذاكَ الشمسُ يُدنيها الغروبُ"],["EA098432-2021-50B4-8EB9-92D67010A384","فمن خدٍّ تخدِّدُه دموعٌ؛","ومن قلبٍ يُقلِّبُهُ حبيبُ"],["03079F2C-51B4-5EAA-A140-C4C88BFCA508","بظبيٍ في الخيامِ له مُرادٌ","وبدرٍ في الخدورِ له مَغيبُ"],["29984F36-67B1-5BDB-AE30-4E9F3C774519","فكم بَعُدَ الرقيبُفأسعفَتْني","صروفُ الدهرِإذ بَعُدَ الرقيبُ"],["F2C0B9BD-A7DC-5C96-880D-0FD2EA65CB96","بصبحٍ من محاسنِه تجلَّى؛","وليلٍ من ذوائبِه يذوبُ"],["409B0657-B517-5985-A358-FC120E5BF66E","رويدَك أيُّها القلبُ المُعنَّى","وقَصرُكَ أيُّها الدمعُ السَّكوبُ"],["386DC9F9-B8D7-547B-B0C4-A25F1ED3AA64","تناءى الجودُ حتى ليس يدنو","وغابَ البِشرُ حتى ما يَؤبُ"],["7DE15526-C61F-5826-9C9D-27A96637B70C","وآخِرَ حاذقٌ في الشِّعرِ طِبٌّ","وقُدِّمَ سارقٌ فيه مُرِيبُ"],["2C62EA1F-F80D-5531-8025-1C68FA448854","كبعضِ الصَّيدِ يُرزَقُ منه مُخطٍ","ويُحرَمُ خيرَه الرامي المصيبُ"],["CF7A45B2-CF7F-5F56-9D22-B615FC78AB1F","سأُغرِبُ في الثناءِ على ابنِ فهدٍ","فما هوفي الورى إلا غريبُ"],["2F47A0F0-6930-5455-A30B-0CA3498FB830","تألَّقَ والخطوبُ لها ظَلامٌ","فأسفرَ والظَّلامُ له قُطوبُ"],["BD9775A5-42A2-53FB-8396-5F40B5DBBB00","وقد قَرِحَتْ على الجُودِ المآقي؛","وقد شُقَّتْ على الشِّعْرِ الجُيوبُ"],["074364CB-B789-5D28-A34A-1558558FE86E","حُلِيٌّ من حِلَى الآدابِ يُغْني","بحِليَتهِ وشيمَتِه الأديبُ"],["47426BAA-9850-5847-BAC1-7529EBE0E579","إذا شيمَتْ بوارقُه استهلَّت","سماءٌمن مواهبِهتصوَّبُ"],["E1F506EA-C367-53F3-9554-877CD49447F0","سَمَتْ بأبي الفوارس في المعالي","ضرائبُ ما له فيها ضريبُ"],["139701F1-63B2-5F3B-B80D-24CFDD4ADA58","فَمِنْ حَزمٍ تَدينُ له الليالي؛","ومِنْ رأيٍ تَدِينُ به الغُيوبُ"],["B4B6A913-1CEB-5E60-A7A9-443BE6550722","وزادَ الأَزْدَ مأثَرةً فأمسَى","لها من كلِّ مكرُمَةٍ نَصيبُ"],["F142A25C-EDEF-5D63-9FF1-8D5726B753DD","منَحْتَ وليَّكَ النِّعَمَ اللواتي","كفَتْه كلَّ نائبةٍ تنوبُ"],["CE5F74BC-AF59-5B2F-93F4-BF0E0980F90D","وبُيِّنَ رَحْبُ صدرِكَ من خلالٍ","يَضيقُبوسْعِها الصَّدرُ الرَّحيبُ"],["B2D95310-FBFA-5D78-9EB0-0CEBC1381E3B","فلما راقَ ناظِرَةَ الليالي","شبابُ الأُنسِ عاجلَه المَشيبُ"],["2DFBB6B1-E0BB-5C37-BDC0-DC0D29D955D7","متى يَثني إليه عِنانَ بِشْرٍ","فتَثْني عنه أوجُهُها الخطوبُ"],["A472A10B-77EC-5AC4-80EC-769C555766D8","فقد نشرَ الثَّناءَ عليك منه","خطيبٌ ليس يُشْبِهُه خَطيبُ"],["AEF6BD31-AF2D-5F1F-8169-7B48871B67C7","فسيَّرَ منه وَشْياً ليسَ يَبْلى","وأطلعَ منه شَمْساً لا تَغيبُ"],["CB4B7BB6-D5BA-5791-AFDE-79649F1CD955","وقد غرسَتْ يمينُك منه غَرْساً","فصُنْهُ أن يُلِمَّ به شُحوبُ"],["9F8BC220-8C32-53CC-B807-1D7777F509B3","أَيقُرُبُ منك ذونَسَبٍ بعيدٍ","ويبعُدُ مَنْ له نَسَبٌ قريبُ"],["354F98E6-C8FC-568B-B172-7A02ECA828F8","ومَدْحٍ فوَّقَتْه لك المعالي","فجاء كأنه بُردٌ قَشيبُ"],["90B291B2-8953-5C9A-B918-2BDD7FF4C46F","إذا ما صافحَ الأسماعَ يوماً","تبسَّمَتِ الضَّمائرُ والقلوبُ"],["5B34EE37-17A5-5093-B4F6-DE9DF1443E6E","فمن حُسْنِ الصنائعِ فيه حُسْنٌ؛","ومن طيبِ المحامدِ فيه طيبُ"],["C490EC71-B987-5D90-9532-6956C7C6427F","وليسَ يَفُوحُ زَهرُ الرَّوضِ حتى","تفتِّحَهُ شَمالٌ أوجَنوبُ"]]},"D0CDEDBD-D4C9-5066-9D45-ECB9C39C2330":{"t":"يُعنِّفني أن أنْ أطَلْتُ النَّحيبَا","p":128,"s":"يعنفني أن أن أطلت النحيبا","r":"458474","v":[["CA319443-7B79-5A97-BED7-A49EE5C71F68","يُعنِّفني أن أنْ أطَلْتُ النَّحيبَا","و أسكُبُ للبَيْنِ دمعاً سَكوبا"],["EFEAE399-405E-5D72-8F43-18DFFA41DBC0","وَ أَدْنَى المُحبِّين مِنْ نحبِه","مُحِبٌّ بكى يومَ بَيْنٍ حَبيبا"],["5FBF2D4D-9DDE-51B8-ABBD-2F5FB469686C","دعا دمعَه ودعَتْ دمعَها","فبلَّلَ منها ومنه الجُيوبا"],["5AFB6093-FE1E-5C8F-BCA1-0F7BF35D4DD7","فتاةٌ رمتْه بِسَهْمِ الجفونِ","و مدَّت إليه بَناناً خَضيبا"],["611FFB5A-375E-58BE-B097-E051625B3780","فعاينَ منهم غزالاً رَبيباً","و بَدراً مُنيراًو غُصْناً رَطيبا"],["27187DA4-8937-5353-B25B-30E23D5102B9","و عَهْدي بها لا تُديمُ الصدودَ","و لا تتجنَّى عليَّ الذُنوبا"],["E2299A16-B903-565A-BFA9-6120592DE92A","لياليَ لا وَصلُنا خِلسةً","نراقبُ للخوفِ فيها الرَّقيبا"],["A3A123CF-8FC6-5200-9D8E-2024A7196536","و لا برقُ لذَّاتِنا خُلَّبٌ","إذا ما دعَونا لوصلٍ قُلوبا"],["661099A3-FD6F-50EE-8B64-35EF36CA1991","و كم لي وللبَيْنِ من مَوقِفٍ","يُميتُ بِلَحْظِ العيونِ القُلوبا"],["4FF77C99-C046-5BEB-BCD2-01F8A78F6BA3","إذا شَهَرَ اللَّحْظُ أسيافَهُ","تدرَّعْتُ للصَّبرِ بُرداً قَشيبا"],["F6DA855A-EC3D-54E0-8CD2-34F1C047B6C1","كأنِّيَ في هَبْوَتَيْه ابنُ فَهْدٍ","إذا اليومُ أصبحَ يوماً عَصيبا"],["8764EBA6-47E1-5474-A22D-B64243B08E5A","فَتىً يَسْتَقِلُّ جَزيلَ الثَّوابِ","سَماحاً لمن جاءه مُستَثيبا"],["D20B1774-B4DF-5DF8-A493-1005BA284D7A","و يُربي على سُنَنِ المكرُماتِ","فيُظْهِرُ فيهنَّ مجداً غَريبا"],["D365C768-2415-59E6-AC64-9B29435BF848","و تَلقاه مبتسماً واضحاً","إذا ما الحوادثُ أبدَتْ قُطوبا"],["13817877-F39F-5289-A35A-671108234064","كريمٌ إذا خابَ راجي النَّدى","حَمَتْنا مكارمُه أن نَخيبا"],["FC5F43E0-6089-5BAE-B9CE-14A04992113C","رأى لحظُه ما تُجِنُّ الصُّدورُ","فخِلناه يعلمُ منها الغُيوبا"],["937B5AD5-DDAD-5A6B-B496-85090BE3A1DF","بعيدٌإذا رُمْتَ إدراكَهُ","و إن كانَ في الجُودِ سهلاً قريبا"],["A127573E-42B3-5AA4-ABD7-DEB97E05B529","نَمَتْهُ من الأَزدِ صِيدُ المُلوكِ","و ما زال يَنْمِي النَّجيبُ النَّجيبا"],["658CA579-6EE5-5260-9FE5-B8E4591E74EB","سَلِمتَ سلامَةُ للمَكْرُماتِ","و ما زِلْتَ تَبسُطُ باعاً رَحيبا"],["FA9B840E-0430-5FF3-98A2-22B84FD3D223","تَزُفُّ إليك تِجارُ المديحِ","عَذارى تَروقُكَ حُسْناً وطِيبا"],["F4E87DDB-7D4B-5A7B-8851-A011BD6C3379","فكم لك من سُؤدُدٍ كالعبيرِ","أصابّ من المدحِ ريحاً جَنوبا"],["9446B534-72F0-50E3-955B-172587DD7DEE","و رأيٍ يُكشِّفُ ليل الخُطوبِ","ضياءًإذا الخَطْبُ أعيا اللَّبيبا"],["122C75D2-2186-54C3-BD10-331722E489F4","و مُشتمِلٍ بنِجادِ الحُسامِ","يَفُلُّ شبا الحربِ بأساً مَهيبا"],["76B700A4-B389-5B10-BBFD-D24F7D96EF1F","ملأْتَ جوانِحَه رَهبةً","فأطرقَو القلبُ يُبدي وَجيبا"],["FA3F1443-734B-52D2-A41B-55DB583AF097","كسوْتَ المكارمَ ثوبَ الشَّبابِ","و قد كُنَّ أُلبِسْنَ فينا المَشيبا"],["5B2E5AAC-B0B2-5402-87A2-BC5A460F38D7","ضرائبُ أبدَعْتَها في السَّماحِ","فلَسْنا نرى لك فيها ضَريبا"],["5F6AEE86-E21D-5E41-B503-4A4779A6ACD2","تَخلَّصْتَني من يَدِ النَّائباتِ","و أحلَلْتَني منك رَبعاً خَصيبا"],["90D1B084-3F18-5A31-B560-BF2164849F74","و مُلِّكْتَ مَدحي كما مُلِّكَتْ","بنو هاشمٍ بُرْدَها والقّضيبا"],["5C427B31-A81B-5BCB-A8B9-2E4FB95C8A98","و أنَّى لواردِ بحرِ القريضِ","إذا وردَ المادحون القَليبا"],["6A1D424A-16F6-59C2-8E2B-67795818FAAC","و لسْتُ كمَنْ يَستردُّ المديحَ","إذا ما كساه الكريمَ المُثِيبا"],["61588F63-52CA-5968-80EA-CF181B14B95B","يُحلِّي بمَدْحَتِه غيرَه","فيُمسي مُحلًّى ويُضحي سَليبا"]]},"35E4BD9B-ACF8-57D6-B2A7-A96B2BD68F8A":{"t":"يُنافسُني في الشِّعْرِو الشِّعرُ كاسدُ","p":128,"s":"ينافسني في الشعرو الشعر كاسد","r":"458559","v":[["5BE874B4-BE85-5C8D-B8F8-0EA15138957E","يُنافسُني في الشِّعْرِو الشِّعرُ كاسدُ","حَسودٌ كَبا عن غايتيو مُعانِدُ"],["7120ECE1-2F63-59E9-987B-E88F1E868BB0","و كلُّ غَبيٍّ لو يُباشِرُ بَرْدُهُ","لظَى النَّارِ أَضحَى حرَّهاو هو بارِدُ"],["A70D1468-3FC2-5766-B63D-C748EAA74307","إذا سُئلُوا عمَّا يَلوحُ تبلَّدوا","كأنَّهمُ عندَ السُؤالِ جَلامِدُ"],["8E3DF0BE-406C-547B-B177-258E0B5C6758","قِيامٌ يَهُزُّونَ النُّسوعَكأنَّما","بأيديهمُ حيَّاتُ رَمْلٍ أساوِدُ"],["EB475E37-5922-517E-8CEC-C5205A057A72","يَموتُ ذَكاءُ الطِّفْلِ ما دامَ عندَهُمْ","و كيفَ صَلاحُ الفَرْعِ والأصلُ فاسِدُ"],["C822A381-299B-5C53-B114-793F2974B334","أَفيقُوا فلن يُعطى القريضَ مُعلِّمٌ","و هل يتولَّى الأغبياءَ عطارِدُ"],["2EC15399-B36E-55D4-B9E5-17739E6F46A4","فلا تمنحوا منه الكرامَ قلائداً","فليسَ من الحَصباءِ تُهدَى القَلائِدُ"]]},"22D756B7-5D14-5895-B9DC-2AC2F121C366":{"t":"يُنبيكَ عن صِحَّةِ أخباري","p":128,"s":"ينبيك عن صحة أخباري","r":"458620","v":[["2E42549E-5D6F-5338-AE92-04A71401CC08","يُنبيكَ عن صِحَّةِ أخباري","عُسريو من العِشقِو إيساري"],["0D43389D-66C7-577A-A816-24B2CD5D53ED","و سُوقَةٌ أفضلُهم مُرتَدٍ","نَقْصاًففخري بينَهم عاري"],["767E7E74-F6B9-51A8-8EA5-BCE96C9606CA","و كانتِ الإبرَةُفيما مضَى","صائنةً وجهي وأشعاري"],["851668FD-CED0-54D5-A9AF-03D9B4C90AD6","فأصبحَ الرِّزقُ بها ضيِّقاً","كأنَّهمن ثُقبِهاجاري"]]}}}