{"v":1,"poems":{"8C52B3E3-5972-5DC6-9EA3-0949CB4086D9":{"t":"القصيدة التائية","p":188,"s":"القصيدة التائية لابن تيمية","r":"425150","v":[["A8DF7842-E735-5ED5-816E-46B5022398B2","أنا الفقيـر إلـى رب السموات","أنا المسيكين فى مجموع حالاتـى"],["CF440B52-677C-53E5-8C62-46ECC6FE96F2","أنا الظلوم لنفسي وهـي ظالمتـى","والخير إن جائنا من عنده ياتـي"],["31FA2563-D9DE-5BE1-B41F-60958F0627BE","لا أستطيع لنفسى جلـب منفعـة","ولا عن النفس فى دفع المضـرات"],["BF435043-550A-5B28-9481-79E5D8455295","وليس لي دونـه مـولا يدبرنـي","ولا شفيـع إلـى رب البـريـات"],["6D1D8836-4098-51C5-9FD7-E0F0286C954C","إلا بـإذن مـن الرحمـن خالقنـا","رب السماء كما قد جاء فى الآيـات"],["1B830608-21DA-5D58-BF14-A1792CE999A6","ولست أملك شيئـا دونـه أبـدا","ولا شريك أنا فى بعض ضراتـي"],["19144513-718C-5CBE-8CE8-0A67EA304541","ولا ظهيـر لـه كـي أعاظـمـه","كمـا يكـون لأربـاب الولايـات"],["CF0F4F21-29E4-5268-B193-93263FC94725","والفقـر لي وصـف لازم أبـدا","كمـا الغنـى وصـف لــه ذات"],["DC7A1CD9-BB76-59EB-9384-673770EB9B36","وهذه الحال حال الخلق أجمعهـم","وكلهـم عنـده عبـد لــه آت"],["ACD3147B-4F2F-5FD7-A848-8E83D0F311A0","فمـن بغـى مطلبـا دون خالقـه","فهو الظلوم الجهول المشرك العات"],["F9A9CFC3-0BFB-5957-938F-867D71CA80AC","والحمد لله ملء الكـون أجمعـه","ماكان منـه ومـن بعـده ياتـي"],["D6EA2C6F-1C85-5404-8900-443C84FD56BB","ثم الصلاة على المختار من مضر","خير البرية من مـاض ومـن آت"]]},"8DFB6CCF-41B5-5C0E-911B-B8BBB5EC7579":{"t":"القصيدة اللامية","p":188,"s":"القصيدة اللامية لابن تيمية","r":"478050","v":[["C45B126B-518A-57B6-B396-5F8EA045A733","يَا سَائِلي عَنْ مَذْهَبِي وعَقِيدَتِي","رُزِقَ الهُدَى مَنْ لِلْهِدَايَةِ يَسْأَلُ"],["EBD60958-BBB9-5BAF-844F-E4563B6A8D83","اسْمَعْ كَلامَ مُحَقِّقٍ فِي قَـولـِه","لاَ يَنْـثَنِي عَنْـهُ وَلاَ يَتَبَـدَّلُ"],["CAC2DDA1-C8B4-5364-B8E9-46C42B0D9EA2","حُبُّ \" الصَّحابَةِ \" كلِّهِمْ لِي مَذْهَبٌ","وَمَوَدَّةُ القُرْبَى بِهَا أَتَوَسّــلُ"],["A54DF0B8-EA2C-5BD3-A763-F1A90B52D4D9","وَلِكُلِّهِمْ قَـدْرٌ عَلاَ وَفَضَائلٌ","لكِنَّمَا \" الصِّدِّيقُ \" مِنْهُمْ أَفْضَـلُ"],["27C07855-6CB8-54F3-B161-512B2C32833A","وَأَقُولُ فِي \" القُرْآنِ \" مَا جَاءَتْ بِـهِ","آياتُـهُ فَهْوَ الْكَرِيمُ الْـمُنزَلُ"],["D2B1E54C-858D-5699-B588-184228428D3C","وَأَقُولُ قَالَ اللهُ جَلَّ جَلاَلُهُ","وَ\" الْمُصْطَفَى \" الْهَادِي وَلاَ أَتَأَوَّلُ"],["7DC7A34B-1ACB-5C9B-B34A-5482D9C08F8A","وَجَمِيعُ \" آيَاتِ الصِّفَاتِ \" أُمِرُّهَـا","حَقّـاً كَمَا نَقَـلَ الطِّرَازُ الأَوَّلُ"],["723986E3-FB8C-590A-B502-5DFFCC034C00","وأَرُدُّ عُهْدَتَها إِلَى نُقَّالِهَِـِاُ","وَأَصُونُها عـَنْ كُلِّ مَا يُتَخَيَّلُ"],["DE01A673-FC65-5D62-BC1E-CBDFF36DBF0B","قُبْحاً لِمَنْ نَبَذَ \" القُرَانَ \" وَرَاءَهُ","وَإِذَا اسْتَدَلَّ يَقُولُ قَالَ \" الأَخْطَلُ"],["F9982F93-3D47-5F3D-B12C-5E9BB1830D5B","وَالمُؤْمِنُونَ \" يَـرَوْنَ \" حَقّـاً ربَّهُمْ","وَإلَى السَّمَـاءِ بِغَيْرِ كَيْفٍ \" يَنْزِلُ"],["B72A9829-9276-54F3-8597-A9A0A9D7AAE3","وأُقِرُ بـ\" الْمِيـزَانِ \" وَ \"الْحَوضِ \" الَّذِي","أَرجُـو بأَنِّي مِنْـهُ رَيّاً أَنْهَـلُ"],["CD7F8E2D-D7C2-5EC2-B9AE-30076C5AB664","وَكَذَا \" الصِّراطُ \" يُمَدُّ فَوْقَ جَهَنَّمٍ","فَمُسَلَّمٌ نَـاجٍ وَآخَـرَ مُهْمَـلُ"],["891B5EB8-9635-5B15-BB54-528353C55A3F","و النَّارُ \" يَصْلاَهَا الشَّقِيُّ بِحِكْمَةٍ","وَكَذَا التَّقِيُّ إِلى \" الجِنَانِ \" سَيَدْخُلُ"],["1025BB8A-EBF6-5455-B8C3-3D75EF5A9193","ولِكُلِّ حَيٍّ عَاقِـلٍ في قَبْـرِهِ","عَمَلٌ يُقارِنُـهُ هُنَـاكَ وَيُسْـأَلُ"],["E41B4627-BE30-5333-BBE8-6C15AE9624FC","هذا اعْتِقَـادُ \" الشَّافِعيِِّ و مَالِكٍ","وَأَبِي حَنِيفَـَةَ \" ثُمَّ \" أَحْـمَدَ \" يُنْقَـلُ"],["9135DA38-593C-58C4-A066-C373F2A2C08D","فَإِنِ اتَّبَعْتَ سَبِيلَهُمْ فَمُوَفَّقٌ","وَإِنِ ابْتَدَعْتَ فَمَا عَلَيْكَ مُعَـوَّلُ"]]}}}