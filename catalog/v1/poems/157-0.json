{"v":1,"poems":{"6E04D1AE-9EEE-5E66-9048-771125BF07A5":{"t":"أنا واللَه أصلح للمعالي","p":157,"s":"أنا والله أصلح للمعالي","r":"447314","v":[["66F15949-50E6-5806-8DCA-99FFCF48FB26","أنا واللَه أصلح للمعالي","وأَمشي مشيتي وأتيهُ تيها"],["8ABF6E7A-5A53-5009-B39F-505E97A73500","َأمكنُ عاشقي من صحن خدّي","وأعطي قُبلتي مَن يشتهيها"]]},"AF5BBBBA-7B5E-5F94-AD3A-3CD5E82B67E9":{"t":"أنتَ الخصيبُ وهذه مصر","p":157,"s":"أنت الخصيب وهذه مصر","r":"447307","v":[["640AEE9D-D4EE-5D28-95B5-BB1A53EAC31D","أنتَ الخصيبُ وهذه مصر","فتدفّقا فكلاكما بحرُ"]]},"B4A976AE-A127-50D6-988F-0DC90DF131DA":{"t":"أَلا هَل لنا من بعد هذا التفرّق","p":157,"s":"أَلا هَل لنا من بعد هذا التفرّق","r":"447310","v":[["2982A645-4DE3-5E77-AEDF-C0CE08EF1993","أَلا هَل لنا من بعد هذا التفرّق","سبيلٌ فيشكو كلّ صبّ بما لقي"],["16098572-85F8-5519-8FCA-CB0C658312B2","وَقد كنت أوقات التزاورِ في الشتا","أبيتُ على جمرٍ من الشوق محرقِ"],["F3DEA53B-5B24-5812-9AC0-11EAD14021BA","فَكيفَ وقد أمسيت في حال قطعة","لَقد عجّل المقدور ما كنت أتّقي"],["0AB837FF-F222-5FE1-AFBF-212790D7D8A8","تمرُّ الليالي لا أرى البين ينقضي","وَلا الصبر من رقّ التشوّق معتقي"],["87CA877A-BCC4-5B5F-B181-D29FF99B7887","سَقى اللَه أرضاً قد غدت لك منزلاً","بكلّ سكوب هاطل الوبل مغدقِ"]]},"E91DAA98-5A75-5B38-AC3A-0B8646A47541":{"t":"إنّ ابن زيدون له فقحة","p":157,"s":"إن ابن زيدون له فقحة","r":"447312","v":[["9DF3DBFE-515E-5178-9B02-ECA28736993A","إنّ ابن زيدون له فقحة","تعشقُ قضبان السراويلِ"],["D785D4A0-A6CA-5813-9E69-54C86E2684EF","لَو أبصرت أيراً على نخلة","صارَت منَ الطيرِ الأبابيلِ"]]},"8F74EAB2-0F2D-5C7C-91E5-BFB8A2E95AD6":{"t":"إنّ اِبن زيدون على فضلهِ","p":157,"s":"إن ابن زيدون على فضله","r":"447315","v":[["8B4E206A-ED54-5510-A6C2-7A1C6D0314F6","إنّ اِبن زيدون على فضلهِ","يغتابني ظلماً ولا ذنب لي"],["70BA72A1-E46F-5D70-A741-F9E506730D3C","يلحظُني شزراً إذا جئته","كأنّني جئت لأخصي علي"]]},"09330D04-5A28-589B-B98A-7AA27DD1EC20":{"t":"ترقّب إذا جنّ الظلام زيارتي","p":157,"s":"ترقب إذا جن الظلام زيارتي","r":"447309","v":[["6AC6B85E-9627-5089-8C88-C667E8FF5EBE","ترقّب إذا جنّ الظلام زيارتي","فإنّي رأيت الليل أكتم للسرِّ"],["118BDE0C-A2EA-5A2A-95D8-851359BC492B","وَبي منك ما لو كانَ بالشمسِ لم تلح","وبالبدر لم يطلع وَبالنجم لم يسرِ"]]},"48A71001-0FC3-5D91-B8D5-92E178610E7D":{"t":"لحاظُكم تجرحُنا في الحشا","p":157,"s":"لحاظكم تجرحنا في الحشا","r":"447306","v":[["E578B581-2511-52A8-A9CF-1AFC000A9A4D","لحاظُكم تجرحُنا في الحشا","وَلَحظنا يجرحكم في الخدود"],["C6151778-6C00-5711-B084-A178DD0AD234","جرح بجرحٍ فاِجعلوا ذا بذا","فما الّذي أوجبَ جرح الصدود"]]},"967B0029-C8D6-559D-A644-9AE20B8F4B89":{"t":"لَو كنت تنصفُ في الهوى ما بيننا","p":157,"s":"لو كنت تنصف في الهوى ما بيننا","r":"447308","v":[["1FADB7E2-9D2A-5ABA-977D-67B094688863","لَو كنت تنصفُ في الهوى ما بيننا","لم تهوَ جاريتي ولم تتخيّرِ"],["571454C6-AA48-534D-A152-AA00A5D99AF3","وَتركتَ غصناً مثمراً بجماله","وجنحتَ للغصنِ الذي لم يثمرِ"],["F4D5A04E-DCF5-55A4-A702-49D2B4FC0692","ولقد علمت بأنّني بدر السما","لَكن دهيت لشقوتي بالمشتري"]]},"514B7F90-1A3D-595A-B5AD-B6BA26FA27DB":{"t":"ولقّبت المسدّس وهو نعت","p":157,"s":"ولقبت المسدس وهو نعت","r":"447311","v":[["9EBF223B-8530-5FC8-800C-2358AD036D83","ولقّبت المسدّس وهو نعت","تفارقك الحياة ولا يفارق"],["CDF29621-BAB8-569A-BD7D-796D34E682E0","فَلوطيّ ومأبون وزانٍ","وديّوث وقرنان وسارق"]]},"F7F4F584-EE72-5F79-87AB-27922268A18E":{"t":"يا أصبحي اِهنأ فكم نعمة","p":157,"s":"يا أصبحي اهنأ فكم نعمة","r":"447313","v":[["607A6FFF-FD7D-5DA7-A7D1-D5232069CC21","يا أصبحي اِهنأ فكم نعمة","جاءَتك من ذي العرشِ ربّ المنن"],["EF9C8DBD-1AFA-5CAD-9F48-499C4EDF2B95","قد نلت باِست اِبنك ما لم ينل","بفرجِ بورانَ أبوها الحسَن"]]}}}