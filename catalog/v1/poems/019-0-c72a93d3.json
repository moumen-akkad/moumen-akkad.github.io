{"v":1,"poems":{"897AF758-2115-5D33-831E-06FB99C17ABB":{"t":"آَذَنَتنا بِبَينِها أَسماءُ","p":19,"s":"آذنتنا ببينها أسماء","r":"436147","v":[["198B139B-BC7F-5C08-8D20-2BB404109CD5","آَذَنَتنا بِبَينِها أَسماءُ","رُبَّ ثاوٍ يُمَلُّ مِنهُ الثَواءُ"],["5EB1BA49-529C-5DE2-9B8F-C8B0C07725A7","آَذَنَتنا بِبَينِها ثُمَّ وَلَّت","لَيتَ شِعري مَتى يَكونُ اللِقاءُ"],["FF3FAD20-6285-5AC8-A5F4-A4C01535D61D","بَعدَ عَهدٍ لَها بِبُرقَةِ شَمّا","ءَ فَأَدنى ديارَها الخَلصَاءُ"],["67397E72-2BC5-5A22-928E-C62B4FD338D3","فَمَحيّاةٌ فَالصَفاحُ فَأَعلى","ذي فِتاقٍ فَغَاذِبٌ فَالوَفاءُ"],["7FBBF19F-A028-5426-B3EB-40360FBBDD41","فَرياضُ القَطا فَأَودِيَةُ الشُر","بُبِ فَالشُعبَتانِ فَالأَبلاءُ"],["B263F670-693B-5D9C-A60E-C442E4E63B6D","لا أَرى مَن عَهِدتُ فيها فَأَبكي ال","يَومَ دَلهاً وَما يَرُدُّ البُكاءُ"],["68EA90AD-B660-5E50-95B5-07D68ACB1370","وَبِعَينَيكَ أَوقَدَت هِندٌ النا","رَ أَخيراً تُلوي بِها العَلياءُ"],["7DF1B4CA-E50E-589E-BEC3-B1F1DA27F904","أَوقَدَتها بَينَ العَقيقِ فَشَخصَي","نِ بِعودٍ كَما يَلوحُ الضِياءُ"],["E89F7D29-89D1-5692-A6C0-2B1DCD22EA66","فَتَنَوَّرتُ نارَها مِن بَعيدٍ","بِخَزارٍ هَيهاتَ مِنكَ الصلاءُ"],["009655DB-86D8-59FC-A22D-AD32CD18C736","غَيرَ أَنّي قَد أَستَعينُ عَلى الهَ","مِّ إِذا خَفَّ بِالثَوِيِّ النَجاءُ"],["9E4E3FB3-D089-5C32-97B9-04CB6FD71007","بِزَفُوفٍ كَأَنَّها هِقلَةٌ أَ","مُّ رِئالٍ دَوِّيَّةٌ سَقفاءُ"],["87C57E85-8A4C-5B2C-B221-171344B2570E","آَنَسَت نَبأةً وَأَفزَعَها القَ","نّاصُ عَصراً وَقَد دَنا الإِمساءُ"],["917DC6BC-D061-5F4D-8D1D-734EFB8EE9DB","فَتَرى خَلفَها مِنَ الرَجعِ وَالوَق","عِ مَنيناً كَأَنَّهُ إِهباءُ"],["571BA884-ED01-505D-A32D-C5E5ADC818CD","وَطِراقاً مِن خَلفِهِنَّ طِراقٌ","ساقِطاتٌ تُلوي بِها الصَحراءُ"],["4A721FBA-3377-527B-9D4F-FBFA79D2D753","أَتَلَهّى بِها الهَواجِرَ إِذ كُ","لُّ اِبنَ هَمٍّ بَلِيَّةٌ عَمياءُ"],["2C1CDC5F-856B-528D-B6EC-561F00685DC0","وَأَتانا عَن الأَراقِمِ أَنبا","ءٌ وَخَطبٌ نُعنى بِهِ وَنُساءُ"],["D400023B-6ACC-53C6-9B23-E4647000BB30","أَنَّ إِخوانِنا الأَرَاقِمَ يَغلو","نَ عَلَينا في قَولِهِم إِحفاءُ"],["BDA409DD-9C3C-54EB-8071-10093030C9C8","يَخلِطونَ البَريءَ مِنّا بِذي الذَن","بِ وَلا يَنفَعُ الخَلِيَّ الخِلاءُ"],["393DED3F-D160-5AC8-8E5F-40D717823164","زَعَمُوا أَنَّ كُلَّ مَن ضَرَبَ العَي","رَ مَوالٍ لَنا وَأَنّا الوَلاءُ"],["E7F8A96A-0599-5046-B90B-ACE89D8C326D","أَجمَعوا أَمرَهُم بِلَيلٍ فَلَمّا","أَصبَحُوا أَصبَحَت لَهُم ضَوضاءُ"],["63618695-C12F-5727-84AD-72C194F88980","مِن مُنادٍ وَمِن مُجيبٍ وَمِن تَص","هالِ خَيلٍ خِلالَ ذاكَ رُغاءُ"],["9FA6CA65-70DE-586C-AD63-59377FED4D9B","أَيُّها الناطِقُ المُرَقِّشُ عَنّا","عِندَ عَمرَوٍ وَهَل لِذاكَ بَقَاءُ"],["26D169C8-0FBD-5E25-A234-BD5FFB3ED648","لا تَخَلنا عَلى غَرائِكَ إِنّا","قَبلُ ما قَد وَشى بِنا الأَعداءُ"],["D789E058-B861-5C10-B5BC-F435C8FAEDE1","فَبَقينا عَلى الشَناءَةِ تَنمِي","نا حُصونٌ وَعِزَّةٌ قَعساءُ"],["9113D686-6C7D-59F3-920E-EBDE50D759EA","قَبلَ ما اليَومِ بَيَّضَت بِعُيونِ ال","ناسِ فيها تَعَيُّطٌ وَإِباءُ"],["8364947A-7137-52B1-A65B-CCCCD2082F55","وَكأَنَّ المَنونَ تَردِي بِنا أَر","عَنَ جَوناً يَنجابُ عَنهُ العَماءُ"],["F2A9B949-0719-56B6-A92C-FDE65C9EC725","مُكفَهِراً عَلى الحَوادِثِ لا تَر","توهُ لِلدَهرِ مُؤيِدٌ صَمّاءُ"],["66FFAF0B-04A0-54AE-A82B-5472E190D4EE","اَيّما خُطَّةٍ أَرَدتُم فَأَدّ","ها إِلَينا تَمشي بِها الأَملاءُ"],["A2ED962E-6C9F-58E9-B40C-84780B961BBF","إِن نَبَشتُم ما بَينَ مِلحَةَ فَالصا","قِبِ فيهِ الأَمواتُ وَالأَحياءُ"],["77CA14A2-4843-5DFA-96B8-FB1A411A1AC3","أَو نَقَشتُم فَالنَقشُ تَجشَمُهُ النا","سُ وَفيهِ الصَلاحُ وَالإِبراءُ"],["6DC186DC-ADDB-55C1-81CB-F3655D0A757B","أَوسَكَتُم عَنّا فَكُنّا كَمَن أَغ","مَضَ عَيناً في جَفنِها أَقذاءُ"],["2794F3CE-85FC-5E45-ABD2-F495E3971421","أَو مَنَعتُم ما تُسأَلونَ فَمَن حُ","دِّثتُمُوهُ لَهُ عَلَينا العَلاءُ"],["B68B5944-7599-59D5-8CB5-DCBE67D71273","هَل عَلِمتُم أَيّامَ يُنتَهَبُ النا","سُ غِواراً لِكُلِّ حَيٍّ عُواءُ"],["E751603E-EDF4-567B-9A66-8F6284537241","إِذ رَفَعنا الجِمالَ مِن سَعَفِ البَح","رَينِ سَيراً حَتّى نَهاها الحِساءُ"],["B64C27AE-4102-570A-AB50-F8E2F3127A60","ثُمَ مِلنا عَلى تَميمٍ فَأَحرَم","نا وَفينا بَناتُ مُرٍّ إِماءُ"],["7B16AA75-4DD8-5F2A-9F8B-77927A49D4E7","لا يُقيمُ العَزيزُ في البَلَدِ السَه","لِ وَلا يَنفَعُ الذَليلَ النِجاءُ"],["6A28E780-ADE0-5F2A-87FD-E4EC758015BC","لَيسَ يُنجي مُوائِلاً مِن حِذارِ","رَأَسُ طَودٍ وَحَرَّةٌ رَجلاءُ"],["BE584336-1AAB-5785-B35F-ACA1170E1911","فَمَلَكنا بِذَلِكَ الناسَ حَتّى","مَلَكَ المُنذِرُ بِنُ ماءِ السَماءِ"],["DA8744EB-DAFD-5979-B3FC-12D822A98B64","وَهُوَ الرَبُّ وَالشَهيدُ عَلى يَو","مِ الحَيارَينِ وَالبَلاءُ بَلاءُ"],["A7AC3F71-C769-5EF7-8C11-659E299AF492","مَلِكٌ أَضلَعُ البَرِيَّةِ لا يو","جَدُ فيها لِما لَدَيهِ كِفاءُ"],["086001C9-D75D-58E8-AD68-29873BB1697D","فَاِترُكوا البَغيَّ وَالتَعَدي وَإِما","تَتَعاشوا فَفي التَعاشي الدَاءُ"],["9E45A6AB-22AB-5115-AC35-DF81D76D9A8E","وَاِذكُرُوا حِلفَ ذي المَجازِ وَما قُ","دِّمَ فيهِ العُهودُ وَالكُفَلاءُ"],["3C45836E-6572-50C6-8F47-CB8CD507A011","حَذَرَ الخَونِ وَالتَعَدّي وَهَل يَن","قُضُ ما في المَهارِقِ الأَهواءُ"],["B836269B-4E85-5063-9AA2-C7EABDFE1A00","وَاِعلَموا أَنَّنا وَإِيّاكُم في","ما اِشتَرَطنا يَومَ اِختَلَفنا سَواءُ"],["86E1047F-F75D-5392-A3F6-ED69C4529605","أَعَلَينا جُناحُ كِندَةَ أَن يَغ","نَمَ غازِيهُمُ وَمِنّا الجَزاءُ"],["EA15C306-2C2E-5D63-A6BB-688A2042993D","أم عَلَينا جُرّى حَنيفَةَ أَو ما","جَمَّعَت مِن مُحارِبٍ غَبراءُ"],["2F9F8EAA-2D57-5DDF-BC27-10C10FA0FB77","أَم جَنايا بَني عَتيقٍ فَمَن يَغ","دِر فَإِنّا مِن حَربِهِم بُراءُ"],["4C948A88-9FFA-5270-8AB7-990655DE27E6","أَم عَلَينا جَرّى العِبادُ كَما ني","طَ بِجَوزِ المَحمَلِ الأَعباءُ"],["14F7E5FC-53A4-5206-8554-BC2AC55BB70F","أَم عَلَينا جَرّى قُضاعَةَ أَم لَي","سَ عَلَينا مِمّا جَنوا أَنداءُ"],["E6848885-CB54-5FA1-88F5-F967EBDCE26B","لَيسَ مِنّا المُضَرَّبونَ وَلا قَي","سٌ وَلا جَندَلٌ وَلا الحَدَاءُ"],["CFAA7DA6-3FBB-5039-9DF9-6AA51074369F","أَم عَلَينا جَرّى إِيادٍ كَما قي","لَ لِطَسمٍ أَخوكُم الأَبّاءُ"],["46EAA358-9F40-5769-B4A7-8FD6A9E74DA8","غَنَناً باطِلاً وَظُلماً كَما تُع","تَرُ عَن حَجرَةِ الرَبيضِ الظَباءُ"],["3A41AECC-75BB-5C81-8B02-B212D26D5AFE","وَثَمانونَ مَن تَميمٍ بِأيدي","هم رِماحٌ صُدُورُهُنَّ القَضاءُ"],["2A70746A-31AA-5BAC-8A56-DE8FFB7B1748","لَم يُخَلّوا بَني رِزاحٍ بِبَرقا","ءِ نِطاعٍ لَهُم عَلَيهُم دُعاءُ"],["3F843934-18C2-5FF2-AB66-4F781D63A853","تَرَكوهُم مُلَحَّبينَ فَآبوا","بِنهابٍ يَصَمُّ فيهِ الحُداء"],["A445C6F9-3115-5C49-BCCD-88E768CEA5F8","وَأَتَوهُم يَستَرجِعُونَ فَلَم تَر","جِعُ لَهُم شامَةٌ وَلا زَهراءُ"],["71926031-AF7A-505C-B387-DA66E75E2D5C","ثُمَّ فاءَوا مِنهُم بِقاصِمَةِ ال","ظَّهرِ وَلا يَبرُدُ الغَليلَ الماءُ"],["2CF9ADFA-7505-5FF5-83B5-44B3F84A79B9","ثُمَّ خَيلٌ مِن بَعدِ ذاكَ مَعَ الغَ","لّاقِ لا رَأَفَةٌ وَلا إِبقاءُ"],["3FB503B5-87E0-5051-9F3E-07E414DCC6AD","ما أصابوا مِن تَغلَبِيِّ فَمَطَلو","لٌ عَلَيهِ إِذا تَوَلّى العَفاءُ"],["30BAD554-217A-55CC-A38D-8A8E881CE1CE","كَتَكاليفِ قَومِنا إِذ غَزا المُن","ذِرُ هَلِ نَحنُ لابنِ هِندٍ رِعاءُ"],["10DC666A-63A2-51B2-BE09-80EA60F3E28B","إِذ أَحَلَّ العَلاَةَ قُبَّةَ مَيسو","نَ فَأَدنى دِيارِها العَوصاءُ"],["468114A2-2867-5057-B9E9-047A397102DD","فَتَأَوَّت لَهُم قَراضِبَةٌ مِن","مُحلِّ حَيٍّ كَأَنَّهُم أَلقاءُ"],["DAF71881-99E7-56D2-BE89-DBE0B4FDA435","فَهَداهُم بِالأَسوَدَينِ وَأَمرُ اللَ","هِ بَلغٌ يَشقى بِهِ الأَشقياءُ"],["7381FCCD-A573-5DEB-A1C7-872F2F0CF3AC","إِذ تَمَنّونَهُم غُروراً فَساقَت","هُمِ إِلَيكُم أُمنِيَّةٌ أَشراءُ"],["404AF54C-CA5A-5033-8479-6ADD880449E1","لَم يَغُرّوكُم غُروراً وَلَكن","يَرفَعُ الآلُ جَمعَهُم وَالضَحاءُ"],["40FB102B-1941-5E5F-BC49-E1889DCF2D95","أَيُّها الشانِئُ المُبلِّغُ عَنّا","عِندَ عَمرَوٍ وَهَل لِذاكَ اِنتهاءُ"],["CC100A43-8D1D-5110-9906-3C2271DE950C","مَلِكٌ مُقسِطٌ وَأَكمَلُ مَن يَم","شي وَمِن دونَ ما لَدَيهِ الثَناءُ"],["17E14E84-FB5E-5B74-BC63-AEB32D2EA3AD","إِرمي بِمثلِهِ جالَتِ الجِنُّ","فَآبَت لِخَصمِها الأَجلاءُ"],["4C01DF12-02AA-5ED3-B113-8FC66370ABC6","مَن لَنا عِندَهُ مِنَ الخَيرِ آيا","تٌ ثَلاثٌ في كُلِّهِنَّ القَضاءُ"],["2FE1C7BF-4DC1-5505-8299-42FFF70741C8","آيةٌ شارِقُ الشَقيقَةِ إِذ جا","ءَوا جَميعاً لِكُلِّ حَيٍّ لِوَاءُ"],["1D623635-819B-544A-A543-E707F9E47657","حَولَ قَيسٍ مُستَلئِمِينَ بِكَبشٍ","قَرَظِيٍّ كَأَنَّهُ عَبلاءُ"],["A4D07251-A6EB-5FA2-865C-B2967D6D79C5","وَصَتيتٍ مِنَ العَواتِكِ ما تَن","هاهُ إِلّا مُبيَضَّةٌ رَعلاءُ"],["E4C8ED77-C7C7-5645-8638-63043BFDB361","فَجَبَهناهُمُ بِضَربٍ كَما يَخرُجُ","مِن خُربَةِ المَزادِ الماءُ"],["4899A89A-A7DA-5A76-AE9B-6330BB1938FE","وَحَمَلناهُمُ عَلى حَزمِ ثَهلا","نِ شِلالاً وَدُمِّيَ الأَنساءُ"],["28609890-7794-5868-AF8D-3AD86B3C712B","وَفَعَلنا بِهِم كَما عَلِمَ اللَ","هُ وَما إِن لِلحائِنينَ دِماءُ"],["D67EDD93-2B7D-5DE0-8D80-FE1015392778","ثُمَّ حُجراً أَعني اِبنَ أُمِّ قَطَامٍ","وَلَهُ فَارِسِيَّةٌ خَضراءُ"],["B359A673-C19D-51C9-85D2-70FA8DAE5DB8","أَسَدٌ في اللِقاءَ وَردٌ هَموسٌ","وَرَبيعٌ إِن شَنَّعَت غَبراءُ"],["3BC7CD8A-D727-5266-A3A7-9BDFD5039033","فَرَدَدناهُم بِطَعنٍ كَما تُن","هَزُ عَن جَمَّةِ الطَوِيِّ الدِلاءُ"],["99B5DC9B-144B-5212-9349-1D5538863A5B","وَفَكَكنا غُلَّ اِمرِئِ القَيسِ عَنهُ","بَعدَ ما طالَ حَبسُهُ وَالعَناءُ"],["1874AB13-67B1-5489-8E43-54354970E49F","وَأَقَدناهُ رَبَّ غَسانَ بِالمُن","ذِرِ كَرهاً إِذ لا تُكالُ الدَماءُ"],["281D3ECF-92F1-5C47-830F-AEEF7644B545","وَفَدَيناهُمُ بِتِسعَةِ أَملا","كٍ نَدَامى أَسلابُهُم أَغلاءُ"],["2E86D55C-B2FD-5417-B7FD-6D356470F5BE","وَمَعَ الجَونِ جَونِ آَلِ بَني الأَو","سِ عَنُودٌ كَأَنَّها دَفواءُ"],["B92B364B-5467-53FE-99B2-5F0B8A0207BE","ما جَزِعنا تَحتَ العَجاجَةِ إِذ وَ","لَّت بِأَقفائِها وَحَرَّ الصِلاءُ"],["C83522E1-077D-5E48-95C4-8DAB9C01619A","وَوَلَدنا عَمرو بِن أُمِّ أُناسٍ","مِن قَريبٍ لَمّا أَتانا الحِباءُ"],["E6166A34-D102-55EB-8C68-5E5E88F99E21","مِثلُها تُخرِجُ النَصيحةَ لِلقَو","مِ فَلاةٌ مِن دونِها أَفلاءُ"]]},"5DDFD715-0194-5FAC-937D-DD42AADFB08E":{"t":"أَسَنَا ضَوْءِ نَارِ صُحْرَةَ بالقُفْـ","p":19,"s":"أسنا ضوء نار صحرة بالقفـ","r":"436157","v":[["D3D6316F-0005-5027-8F36-4F9884EA2932","أَسَنَا ضَوْءِ نَارِ صُحْرَةَ بالقُفْـ","ــرَةِ أَبصرتَ أمْ تَنصَّبَ بَرقُ"]]},"1C7AB699-7646-54F7-B1D6-3AE236B8972D":{"t":"أَعمرَو ابنَ فرَّاشةِ الأشيمِ","p":19,"s":"أعمرو ابن فراشة الأشيم","r":"436160","v":[["6EED9869-AE10-55FE-BFD1-1E183B364116","أَعمرَو ابنَ فرَّاشةِ الأشيمِ","صرمتَ الحِبالَ ولَمْ تُصرمِ"],["C9777491-594E-5425-8C63-EF1786A4F490","وَأفْسَدْتَ قَوْمَكَ بَعْدَ الصَّلاَحِ","بَنِي يَشْكُرَ الصِّيدَ بالمَلهمِ"],["CDC081D0-56B0-50C8-B7BE-A34AD315DEA1","دَعَوْتَ أبَاك إلى غَيْرِهِ","وَذَاكَ العُقُوقُ من المَأْثَمِ"],["FB81DEAE-4A0C-53E2-AAD8-3EBB752DA6BE","كفى شاهداً بمُباحِ الصَّفا","إلى مُلْتَقَى الحَجِّ بِالمَوْسِمِ"],["4B0AB72A-7E00-51A5-87A5-CC1E0668108D","فَهَلاَّ سَعَيْتَ لِصُلْحِ الصَّدِيقِ","كَسَعْيِ کبْنِ مَارِيَةَ الأَقْصَمِ"],["E8E0E7AC-52CD-582F-A569-6762E81EBF94","وقيسٌ تداركَ بَكرَ العراقِ","وتَغْلِبَ منْ شرِّها الأعظمِ"],["3AD45645-FC21-5C83-9920-317F3AFF6848","وَأصْلَحَ مَا أَفْسَدُوا بَيْنَهُمْ","وذلكَ فِعْلُ الفتى الأكرمِ"],["01A0DC44-FDB8-5CBD-A791-7D138DD8D2CF","وَبَيْتُ شَرَاحِيلَ مِنْ وَائِلٍ","مَكَانَ الثُّرَيّا مِنَ الأَنْجُمِ"]]},"14984F3E-58D4-5E51-AD86-6F24EE254873":{"t":"أَلاَبَانَ بالرَّهْنِ الغَدَاةَ الحَبَائِبُ","p":19,"s":"ألابان بالرهن الغداة الحبائب","r":"436149","v":[["B121FB05-23D4-5A9E-83DF-8AF94596F38D","أَلاَبَانَ بالرَّهْنِ الغَدَاةَ الحَبَائِبُ","كَأَنَّكَ مَعْتُوبٌ عَلَيْكَ وَعَاتِبُ"],["AF52F117-8CEB-5B9E-A32A-1D847CB35527","لَعَمْرُ أَبِيكَ الخَيْرِ لَوْ ذَا أَطَاعَنِي","لغُـدِّيَ منهُ بالرَّحيـلِ الرَّكائبُ"],["2C8B5ECA-72DD-58AE-91D6-AA22F57BE339","تَعَلَّمْ بأنَّ الحَيَّ بَكْرَ بْنَ وَائلٍ","هُمُ العِزُّ لا يَكْذِبْكَ عَنْ ذَاكَ كَاذِبُ"],["91134FD0-7434-545B-BE7A-B14356F350B3","فَإِنَّكَ إنْ تَعْرِضْ لَهُمْ أو تَسُؤْهُمُ","تَعَرَّضْ لأِقْوَامٍ سِوَاكَ المذاهبُ"],["1FEECD9C-43BD-5421-9763-9BB33A01AA65","فنحنُ غداةَ العينِ يومَ دعوْتنَـا","أتَيْناكَ إذ ثابَتْ عَلَيْكَ الحَلاَئِبُ"],["ED07F91B-247E-5EAB-8389-47C02EE387D9","فَجِئْنَاهُمُ قَسْرا نَقُودُ سَرَاتَها","كما ذُبِّبتْ منَ الجمالِ المصاعبُ"],["390D1D56-8745-5181-9EC0-8160D29BC718","بِضَرْبٍ يُزِيلُ الهَامَ عَن سَكَنَاتِها","كما ذِيدَ عنْ ماءِ الحياضِ الغرائبُ"]]},"224637B1-2AC4-59E2-B6D4-ACC43F92D0D3":{"t":"أَهْلِي فِدَاءُ بَنِي شَبِيمٍ كُلَّهِمْ","p":19,"s":"أهلي فداء بني شبيم كلهم","r":"436155","v":[["8FF1F0DF-D63D-57A8-90BF-C0A92E8518B1","أَهْلِي فِدَاءُ بَنِي شَبِيمٍ كُلَّهِمْ","وَبَنِي الحَرَامِ وَجَمْعِ آلِ مُطيّعِ"],["9D402192-DA79-50CB-990A-005267F5DBD4","والعَامرينَ شبابِها وكُهولِها","وَبَنِي المسَيَّبِ يَوْمَ دَعْوَةِ لَعْلَعِ"],["1D2DD46B-53F9-5C21-8833-00CF7CBE6CE5","أمَّـا بنو عمروٍ فإنَّ مقيلَهُم","منْ ذاتِ أصداءٍ كسيلِ الأدرعِ"],["65E9A86A-9D11-5237-AD01-6638D8683C32","وَبَنُو صُبَاحٍ أفْلَتُونَا عَنْوَةَّ","والكَيسُ أينَ ما تنلهُ ينفَعِ"]]},"F71F782D-BC29-563D-8685-B610C90419F5":{"t":"إخْوَةٌ قَرَّشُوا الذُنُوبَ عَلَيْنَا","p":19,"s":"إخوة قرشوا الذنوب علينا","r":"436161","v":[["650F0991-8613-51CA-8186-276128A896C0","إخْوَةٌ قَرَّشُوا الذُنُوبَ عَلَيْنَا","فِي حَدِيثٍ مِنْ دَهْرِنَا وَقَدَيمِ"]]},"47E443B3-8A93-5204-9E8B-35B00270227C":{"t":"طَرقَ الخَيالِ ولا كليلةِ مدلجِ","p":19,"s":"طرق الخيال ولا كليلة مدلج","r":"437582","v":[["184CE8CE-592D-59B9-8E88-F96EB66275C2","‌طَرقَ ‌الخَيالُ ‌وَلا ‌كَلَيلَةِ ‌مُدلِجِ","سَدِكاً بِأَرحُلِنا وَلَم يَتَعَرَّجِ"],["E0FCDA78-8AAC-524F-BC49-C527714FD62B","أَنّى اِهتَدَيتِ وَكُنتِ غَيرَ رَجيلَةٍ","وَالقَومُ قَد قَطَعوا مِتانَ السَجسَجِ"],["A51205AD-6F83-5A44-9DA5-A550EB0F7891","وَالقَومُ قَد آنوا وَكَلَّ مَطِيُّهُم","إِلّا مُواشِكَةَ النَجا بِالهَودَجِ"],["021DB92A-093C-5A73-B10C-4FE2EBBEF007","وَمُدامَةٍ قَرَّعتُها بِمُدامَةٍ","وَظِباءِ محنِيَةٍ ذَعَرتُ بِسَمحَجِ"],["E56D3B9C-D0B2-5ECE-A73D-617CF6ED3D5F","فَكَأَنَّهُنَّ لآلِئٌ وَكَأَنَّهُ","صَقرٌ يَلوذُ حَمامَةً لَم تَدرُجِ"],["70A39B17-ED69-5939-A866-E33235B79190","صَقرٌ يَصيدُ بِظُفرِهِ وَجَناحِهِ","فَإِذا أَصابَ حَمامَةً بِالعَوسَجِ"],["8DF4A402-2058-5216-9253-A77E882BFB9F","وَلَئِن سَأَلتِ إِذا الكَتيبَةُ أَحجَمَت","وَتَبَيَّنَت رُعبَ الجَبانِ الأَهوَجِ"],["DF2225CB-E6D1-5E30-9A92-A6326ADAB2F4","وَسَمِعتَ وَقعَ سُيوفِنا بِرُؤُسِهِم","وَقَعَ السَحابَةِ بِالطَرافِ المُسرَجِ"],["3D62322A-63EA-5F86-8FC9-70337D1AA844","وَإِذا اللِقاحُ تَرَوَّحَت بِعَشِيَّةٍ","رَتكَ النَعامِ إِلى كَنيفِ العَوسَجِ"],["B74ECC70-AF3C-503E-81FB-2BF26D0FDC7D","أَلفَيتَنا لِلضَيفِ خَيرَ عِمارَةٍ","إِن لَم يَكُن لَبَنٌ فَعَطفُ المُدمَجِ"],["2A7060C4-05AB-5D0D-B121-28E770DC55E5","وَبَعَثتَ مِن وُلدِ الأَغرِّ مُعَتِّباً","صَقراً يَلوذُ حَمامُهُ بِالعَوسَجِ"],["0CC0BB63-7E62-515D-B2EC-3FB3D5D2DEE1","فَإِذا طَبَختَ بِنارِهِ نَضَّجتَهُ","وَإِذا طَبَختَ بِغَيرِها لَم يَنضَجِ"]]},"3A7C30A2-5B35-5479-A668-CB5D81B31403":{"t":"فَمَـا يُنْجيكُمُ منَّـا شِبَـامٌ","p":19,"s":"فمـا ينجيكم منـا شبـام","r":"436163","v":[["B91DFCAF-A287-5DC6-A0BE-04E0636B1CD8","فَمَـا يُنْجيكُمُ منَّـا شِبَـامٌ","ولا قَطَـنٌ ولا أهلُ الحَجُـونِ"]]},"197F5FCF-3ADE-5DCA-9878-8CDA7F73553E":{"t":"لا أَعْرِفَنَّكَ إنْ أرْسَلْتَ قَافِيَةً","p":19,"s":"لا أعرفنك إن أرسلت قافية","r":"436152","v":[["36818E19-36B4-543B-8FE7-AB6C810650AA","لا أَعْرِفَنَّكَ إنْ أرْسَلْتَ قَافِيَةً","تُلقي المعاذيرَ إنْ لَمْ تنفَعِ العِذرُ"],["212FA540-B238-5EE3-91A5-F2957AD60EDC","إنَّ السَّعِيدَ لَهُ في غَيْرِهِ عِظَةٌ","وَفِي التَّجَارِبِ تَحْكِيمٌ وَمُعْتَبَرُ"]]},"1F58372C-1CBB-5D32-906E-743CCDF2E801":{"t":"لَمَّا جَفَانِي أخِلاَّئي وَأَسْلَمَنِي","p":19,"s":"لما جفاني أخلائي وأسلمني","r":"436156","v":[["F125BADB-1636-5A96-83BD-170A802E7FD9","لَمَّا جَفَانِي أخِلاَّئي وَأَسْلَمَنِي","دَهْرِي وَلَحْمُ عِظَامِي اليَوْمَ يُعْتَرَقُ"],["8909F595-31FF-5D6C-AAB9-AA6AD9BADD27","أقْبَلْتُ نَحْوَأبي قَابُوسَ أمْدَحُهُ","إنَّ الثَّنَاءَ لَهُ وَالحَمْدُ يَتَّفقُ"],["ED7B966A-0154-5E87-9081-9085CF3B50D0","سهلَ المبَاءةِ محضراً محلُّـهُ","مَا يُصْبحُ الدَّهْرُ إلا حَوْلَهُ حَلَقُ"],["94350CEF-C23A-5FDA-9128-7FF4B2188FAB","للمنذرينَ وللمعصوبِ لـمَّـتُهُ","أنتَ الضِّياءُ الذي يُجلى به الأُفقُ"]]},"96E12465-6A92-571C-B6F2-AE7ABE83CD49":{"t":"لِمنِ الدِّيارُ عفونَ بالحَبسِ","p":19,"s":"لمن الديار عفون بالحبس","r":"436154","v":[["76280CC4-1D2C-5FFE-8956-8DE3D7351F34","لِمنِ الدِّيارُ عفونَ بالحَبسِ","آياتُها كمهارقِ الفُرسِ"],["8D8531A0-9B13-51BE-BC80-683F69E258FF","لا شيءَ فيها غيرُ أَصْورةٍ","سُفْعِ الخُدودِ يَلحنَ في الشَّمسِ"],["510C08AA-C5B0-5B37-87A9-F9C0E78869E1","وغيرُ آثَـارِ الجيادِ بأعْـ","ــراضِ الجمادِ وآيةِ الدَّعسِ"],["A0FE7B2C-FA38-51B3-B216-A58735E56EF9","فحَبْستُ فيها الرَّكبَ أَحدِسُ في","جُلِّ الأمورِ وكنتُ ذا حَدسِ"],["4EAB5E33-7A40-51E8-A2BC-DA6F436F303E","حَتَّى إذا کلْتَفَعَ الظِّبَاءُ بِأطْـ","ـرَافِ الظّلاَلِ وَقِلْنَ فِي الكُنْسِ"],["BFC41BF2-9A10-5722-A479-76A840D7D42A","وَيَئِسْتُ مِمَّا كَانَ يَشْعَفُني","فيها ولا يُسليكَ كـاليأسِ"],["B7A0E014-33F6-5ECA-89F2-E5D2CCFB6146","أنمِي إلى حرفٍ مُذَكَّرةٍ","تهصُ الحَصا بمواقعٍ خُنسِ"],["955DCBBC-B2C5-5F9D-80EB-34B912FDA5DE","خَذِمٍ نَقَائِلُهَا يَطِرْنَ كَأقْـ","ـطَاعِ الفِرَاءِ بِصَحْصَحٍ شَأْسِ"],["A6445118-AD7D-5839-B9B4-E072F9ABA8C3","أفَلا نُعدّيها إلى مَلِكٍ","شهمِ الَمقَادةِ حازمِ النَّفسِ"],["58AD5246-FB50-59B7-A5CE-5FD0196339A8","فَإِلى کبْنِ مَارِيَةَ الجَوَادِ وَهَلْ","شَرْوَى أبي حَسَّانَ في الإنْسِ"],["7AF74034-C4DE-5845-8785-06A61C824D60","يحبُوكَ بالزَّغفِ الفيُوضِ على","هِميانِهَـا والدُّهمِ كالغَرسِ"],["95FD6B98-F80F-5C90-AA4F-DE9BB69ACE7D","وَبالسَّبِيْكِ الصُّفْرِ يُعْقِبُهَا","بالآنِسَاتِ البِيضِ واللُّعْسِ"],["B8E039AD-DFA3-5274-B901-39C76B925BE6","لا مُمْسِكٌ لِلْمَالِ يُهْلِكُهُ","طَلْقُ النُّجُومِ لَدَيْهِ كالنَّحْسِ"],["74F72FF6-A513-5981-B2A8-0462234C28A2","فَلَهُ هُنَالِكَ لا عَلَيْهِ إذا","رغمتْ أُنوفُ القومِ للتعسِ"]]},"93551F0E-83E2-557C-BCBA-ADFF0CC7D739":{"t":"معلقة الحارث بن حلزة اليشكري","p":19,"s":"معلقة الحارث بن حلزة اليشكري","r":"492673","v":[["CE59D67E-9EF9-5AE9-9C7D-956C89A4A78F","آذَنَـتــنَـا بِــبَــيــنــهــا أَســمَــــاءُ","رُبَّ ثَـــاوٍ يَــمَـلُّ مِــنــهُ الثَّــواءُ"],["B6687FF2-13B4-50BE-9BA4-16D85FB5AFE7","بَـعــدَ عَـهــدٍ لَـنـا بِبُـرقَـةِ شَمَّــاءَ","فَــأَدنَــى دِيَــارِهــا الـخَـلـْصَــاءُ"],["7C29619A-F955-5AB1-9656-01DB1DDFA196","فَـالـمـحيّـاةُ فَـالصـّفاجُ فَـأعْـنَـاقُ","فِـــتَــاقٍ فَـــعــاذِبٌ فَــالــوَفــــاءُ"],["CC9587EB-8044-59DA-976B-5017A246C2A5","فَــريَـاضُ الـقَـطَـا فَـأوْدِيَـةُ الشُـ","ــربُـبِ فَـالشُـعــبَـتَـانِ فَـالأَبْــلاءُ"],["802E7F9A-2B8E-5832-AD7D-D0913F44D9AD","لا أَرَى مَـن عَهِـدتُ فِيـهَا فَأبْكِي","اليَــومَ دَلهاً وَمَـا يُـحَيِّـرُ الـبُكَـاءُ"],["C8692553-07E0-573F-9779-AF79E8934F1E","وبِـعَــيـنَـيـكَ أَوقَـدَت هِـنـدٌ النَّـارَ","أَخِـيــراً تُـلــوِي بِـهَـا الـعَـلْـيَــاءُ"],["C8F53297-15D4-5FCC-A1E8-A53805E3C5E8","فَـتَـنَــوَّرتُ نَـارَهَــا مِـن بَـعِـيــدٍ","بِخـَزَازى هَيـهَاتَ مِـنكَ الصَّـلاءُ"],["2263BD8C-FDD3-5757-A25D-079FC01B8B6A","أَوقَـدتها بَيـنَ العَـقِيقِ فَـشَخصَينِ","بِــعُــودٍ كَــمَـا يَـلُــوحُ الـضِـيــاءُ"],["E74E1418-7AB0-54BA-BC8A-46A3B4A043CD","غَـيرَ أَنِّي قَـد أَستَعِينُ عَلَى الهَـمِّ","إِذَا خَـــفَّ بِــالــثَّــوِيِّ الـنَـجَــاءُ"],["51C793F1-40F6-5768-ADAA-4858331F2CE3","بِــــزَفُـــوفٍ كَـــأَنَّــهــا هِــقَـلــةٌ","أُمُّ رِئَـــــالٍ دَوِيَّــــةٌ سَــقْـــفَـــاءُ"],["94FDC5B2-81B7-5E10-83B9-A5A16AA63F03","آنَـسَت نَـبأَةً وأَفْـزَعَها الـقَنَّـاصُ","آعَــصــراً وَقَــد دَنَـا الإِمـْسَـــاءُ"],["56021D65-C748-594A-9301-1304D3A7171D","فَـتَـرَى خَلـْفَها مِـنَ الرَّجـعِ وَالـ","ــوَقْــعِ مَـنِـيـنــاً كَــأَنَّـهُ إِهْــبَـــاءُ"],["931FF17C-BF05-56B3-971F-0347B0EB2A4F","وَطِــرَاقـاً مِـن خَـلفِـهِـنَّ طِــرَاقٌ","سَـاقِطَاتٌ أَلـوَتْ بِـهَا الصَحـرَاءُ"],["1ECAE0F6-499A-5562-80B0-3DE22E752DB3","أَتَـلَـهَّـى بِـهَا الـهَـوَاجِـرَ إِذ كُــلُّ","ابـــنَ هَـــمٍّ بَـلِــيَّـــةٌ عَــمــيَـــاءُ"],["8EA9492B-3F47-5B73-9002-2E627B074EC9","وأَتَـانَـا مِـنَ الحَــوَادِثِ والأَنبَــاءِ","خَـطــبٌ نُــعـنَــى بِــهِ وَنُـسَـــاءُ"],["72D9C903-5BD9-54B1-9516-A41083DAD0B4","إِنَّ إِخــوَانَـنـا الأَرَاقِـمَ يَـغـلُــونَ","عَـلَـيـنَــا فِــي قَـيـلِـهِــم إِخْـفَـــاءُ"],["295B7DDD-2984-56AF-9611-67E22BD2C591","يَـخـلِـطُـونَ البَرِيءَ مِنَّا بِـذِي الـ","ـذَنـبِ وَلا يَـنـفَـعُ الخَـلِيَّ الخِلاءُ"],["D3FBB6C8-D818-5198-9D42-D70218386CD2","زَعَمُوا أَنَّ كُلَّ مَن ضَرَبَ العِيرَ","مُـــوَالٍ لَـــنَـــا وَأَنَـــا الـــــوَلاءُ"],["C38FF217-D2C2-5D6A-8BD6-AFBE3570C8FF","أَجــمَـعُـوا أَمـرَهُـم عِـشاءً فَلَمَّـا","أَصبَحُوا أَصبَحَت لَهُم ضَوْضَـاءُ"],["37C21234-5E89-5364-9441-4220FA6881AA","مِـن مُـنَــادٍ وَمِـن مُـجِيـبٍ وَمِـن","تَـصهَالِ خَـيلٍ خِلالَ ذَاكَ رُغَـاءُ"],["40448F47-9019-5CFF-9D06-C6EBE4E6F040","أَيُّـهَـا الـنَـاطِــقُ الـمُـرَقِّــشُ عَنَّـا","عِـنــدَ عَـمــروٍ وَهَـل لِذَاكَ بَقَـاءُ"],["28E2BC27-64A1-58AD-946C-2D53A1976C05","لا تَخـَلـنَــا عَـلَـى غِــرَاتِـك إِنّــا","قَـبلُ مَـا قَـد وَشَـى بِـنَا الأَعْــدَاءُ"],["BFC70EE7-D37D-5961-AE92-61A1F7F6844C","فَـبَــقَـيـنَـــا عَـلَـــى الـشَـنــــاءَةِ","تَـنـمِـينَـا حُصُونٌ وَعِزَّةٌ قَعسَــاءُ"],["96DBFFD6-994A-5BD2-A087-A23F80300D72","قَـبـلَ مَـا الـيَـومِ بَيَّـضَت بِعُيــونِ","الـنَّــاسِ فِـيـهَــا تَــغَـيُّــظٌ وَإِبَـــاءُ"],["4C662C4E-A3EA-5CB5-B926-C2BC07551465","فَكَـأَنَّ المَنونَ تَردِي بِنَـا أَرعَــنَ","جَــونـاً يَـنـجَــابُ عَـنـهُ العَـمــاءُ"],["4E12CFB9-A31D-5B4A-A5AB-81996B8533F2","مُكفَهِراً عَلَى الحَوَادِثِ لا تَرتُـوهُ","لــلـــدَهـــرِ مُــؤَيِّـــدٌ صَــمَّــــاءُ"],["019E9D4B-4497-5038-B141-D9B74C2BCAF1","رمِــيٌّ بِـمِـثـلِــهِ جَـالَـتِ الخَـيــلُ","فَــآبَـت لِـخَـصـمِــهَــا الإِجـــلاَءُ"],["2EBEF22E-BDA3-59C5-AD89-B8BF3F420500","مَـلِكٌ مُقسِطٌ وأَفضَلُ مَن يَمـشِـي","وَمِــن دُونَ مَــا لَــدَيــهِ الـثَّـنَــاءُ"],["565CC245-1B15-5B52-94A1-366822E75D51","أَيَّـمَــا خُـطَّــةٍ أَرَدتُــم فَــأَدوهَـــا","إِلَــيـنَــا تُـشـفَــى بِهَــا الأَمـــلاءُ"],["6824AC28-BED9-59C4-9C6C-37F5AB5B05C6","إِن نَبَشتُـم مَا بَـيــنَ مِـلـحَــةَ فَـالـ","ـصَاقِبِ فِيهِ الأَموَاتُ وَالأَحَـيَــاءُ"],["A8DDC220-1829-5BDD-9DD8-DB053B3350C1","أَو نَقَشتُـم فَالـنَّـقــشُ يَـجـشَـمُـــهُ","النَّـاسُ وَفِيهِ الإِسقَـامُ وَالإِبـــرَاءُ"],["2E4902EA-D836-5297-9219-BA673C6988DF","أَو سَكَتُّم عَنَّا فَكُنَّا كَمَن أَغـمَـضَ","عَـيـنــاً فِــي جَـفـنِـهَــا الأَقــــذَاءُ"],["D72FAE6A-02B9-5040-A132-3B96B987916E","أَو مَنَعتُم مَا تُسأَلُونَ فَـمَـن حُـــدِّ","ثـتُـمُــوهُ لَــهُ عَـلَـيـنَــا الـعَـتــلاءُ"],["3C9B3BF5-5DE6-5B05-9757-C190CAF5030C","هَـل عَـلِـمـتُـم أَيَّامَ يُنتَهَبُ النَّــاسُ","غِــــوَاراً لِــكُــلِّ حَـــيٍّ عُـــواءُ"],["5C5F4349-4B2D-5455-86B1-22FAD9E4F05A","إِذ رَفَـعـنَا الجِمَـالَ مِن سَعَفِ الـ","بَحرَينِ سَيراً حَتَّى نَهَاهَا الحِسَاءُ"],["588D2707-6C87-5AF4-9CD4-E8B61D11FD3B","ثُــمَّ مِــلنَـــا عَلَـــى تَمِيمٍ فَأَحرَمنَــا","وَفِـيـنَـــا بَـنَـــــاتُ قَـــومٍ إِمَـــــاءُ"],["A564E457-365B-51CA-BBE3-8843B056877B","لا يُقِــيـــمُ العَــزيـزُ بِالبَلَدِ السَهــلِ","وَلا يَــنــفَـــعُ الـــذَّلِــيـــلَ النِجَــاءُ"],["B56598B3-8231-52D5-AE41-1137E7D476CB","لَيـــسَ يُــنــجِــي الذِي يُوَائِل مِنَّــا","رَأْسُ طَــــوْدٍ وَحَـــرَّةٌ رَجـــــلاءُ"],["37518091-B51C-57C2-AC66-A2EFC8A112CF","مَــلِكٌ أَضــلَـــعَ البَرِيَّةِ لا يُــوجَــدُ","فِـــيــهَـا لِــمَـــا لَــدَيـــهِ كِــفَـــــاءُ"],["28C51FF0-A6B0-5A47-A58F-6909D285235A","كَـتَـكَــالِيفِ قَومِـنَا إِذَا غَـزَا المَنـذِرُ","هَــلِ نَحـــنُ لابــنِ هِـنـــدٍ رِعَـــاءُ"],["B5711882-F38E-59A5-A571-32B785B1EBE3","مَــا أَصَـابُـوا مِـن تَغلَبِي فَمَطَلــولٌ","عَلَــــيـهِ إِذَا أُصِيـــــبَ الـعَـفَـــــاءُ"],["267A1CE5-AC11-5333-B60F-4F525A0F4E94","إِذَ أَحَـــلَّ العَـــلاةَ قُبَّـــةَ مَـيسُــونَ","فَـــأَدنَــــى دِيَارِهَــــا العَوصَــــــاءُ"],["F59C685C-F02E-595C-ADEF-E012F57D0267","فَتَــــأَوَّت لَــــهُ قَــرَاضِبَـــةٌ مِـــن","كُـــلِّ حَـــيٍّ كَــأَنَّــهُـــم أَلــقَــــــاءُ"],["F5208578-BC1A-505A-804A-6694C2BBA7DD","فَهَــداهُــم بِالأَســـوَدَينِ وأَمـرُ اللهِ","بَـالِــغٌ تَـشـقَـــى بِــهِ الأَشـقِـيَــــاءُ"],["47D2CB82-8D34-54AF-AFE6-ED190B8C2271","إِذ تَـمَـنَّـونَـهُـم غُــرُوراً فَسَـاقَتهُـم","إِلَيـــكُـــم أُمـــنِـــيَّــــةٌ أَشــــــرَاءُ"],["4678A9D5-CA69-5291-B26C-E2F7306470A8","لَــم يَغُـــرّوكُــم غُــرُوراً وَلَكـــن","رَفـَــعَ الآلُ شَـخـصَهُم وَالضَحَـاءُ"],["70330173-97E2-595C-AE9A-72E8340A9982","أَيُّهـــا النَــاطِـــقُ المُــبَلِّـــغُ عَــنَّــا","عِنـــدَ عَــمروٍ وَهَـل لِـذَكَ انتِـهَـاءُ"],["13989EA4-C81B-5D8A-809B-B6B4A61E8E3D","مَــن لَــنَـــا عِــنـــدَهُ مِـــنَ الخَيـرِ","آيَــاتٌ ثَــلاثٌ فِــي كُلِّهِـنَّ القَضَـاءُ"],["F35F68AE-9EB4-5A64-87D3-74D287DFDB0D","آيَــةٌ شَــارِقُ الشّــقِيقَةِ إِذَا جَــاءَت","مَـــعَــــدٌّ لِـــكُــــلِّ حَــــيٍّ لِــــوَاءُ"],["535FBAD2-2337-572B-8A22-7076A341C9C5","حَــولَ قَــيــسٍ مُـستَلئِمِيـنَ بِـكَبـشٍ","قَـــرَظِـــيٍ كَـــأَنَّـــهُ عَــبــــــــلاءُ"],["4BF60C1E-8FAC-5104-B5C0-37F7470F0361","وَصَـتِـيـتٍ مِـنَ الـعَـواتِـكِ لا تَنهَاهُ","إِلاَّ مُـــبـــيَـــضَّـــــةٌ رَعــــــــلاءُ"],["A302B81F-4155-519D-8871-AF45B2660698","فَــرَدَدنَــاهُــمُ بِـطَـعـنٍ كَـمَا يَخـرُجُ","مِـن خُـربَـةِ الـــمَــزَادِ الــمَــــــاءُ"],["BC5833D1-0E8E-5E1A-8D80-08FAA906C859","وَحَـمَـلـنَـاهُـمُ عَـلَـى حَـزمِ ثَـهـلانِ","شِـــــلالاً وَدُمِّـــــيَ الأَنسَــــــــاءُ"],["6E435918-935C-51D6-A7D2-B49351EF78C3","وَجَــبَــهــنَـــاهُــمُ بِطَعنٍ كَمَا تُنهَـزُ","فِــي جَـــمَّــةِ الــطَـــوِيِّ الـــدِلاءُ"],["13576E60-BA41-5846-B117-A21D9EA59CB7","وَفَــعَــلــنَـــا بِــهِـم كَـمَا عَلِـمَ اللهُ","ومَـــا أَن للــحَــائِــنِـيـــنَ دِمَــــاءُ"],["003B7127-EB1F-54FC-A915-5156A3BCC844","ثُــمَّ حُــجـــراً أَعـنَي ابنَ أُمِّ قَطَـامٍ","وَلَــــهُ فـَــارِسِــيَّـــةٌ خَــضــــرَاءُ"],["DA2D7CAC-C8F7-5414-AECB-FB13C9657EE6","أَسَـــدٌ فِــي اللِــقَــاءِ وَردٌ هَمُـوسٌ","وَرَبِيـــعٌ إِن شَــمَّـــرَت غَــبــرَاءُ"],["5E3E7DD0-4B2B-55B3-8071-2F8C7FAD3F74","وَفَـكَكـنَا غُـلَّ امـرِيِء القَيسِ عَنـهُ","بَــعـــدَ مَــا طَــالَ حَبسُـهُ والعَنَـاءُ"],["5DCFE7A2-0217-520F-BFB1-C5C2F9134242","وَمَعَ الجَـونِ جَونِ آلِ بَنِي الأَوسِ","عَــتُـــــودٌ كَـــأَنَّــهـــــا دَفـــــوَاءُ"],["A3D91AEE-E397-5DAF-B5D1-3267EB7B4039","مَا جَزِعنَا تَحتَ العَجَاجَةِ إِذ وَلُّوا","شِـــلالاً وَإِذ تَــلَــظَّـــى الصِــلاءُ"],["614825C4-6890-5444-B9A3-7642576479B4","وَأَقَـــدنَــاهُ رَبَّ غَــسَّـانَ بِالمُنـذِرِ","كَـــرهــاً إِذ لا تُــكَـــالُ الــدِمَــاءُ"],["8EAD358A-CCBB-53BC-9173-77F9B6DA0C15","وأَتَــيــنَـــاهُــمُ بِــتِسعَـةِ أَمـــلاكٍ","كِـــرَامٍ أَســـلابُــهُـــم أَغـــــــلاءُ"],["E0DF456E-93A0-56ED-9D71-C10320F3F32E","وَوَلَـــدنَا عَــمـــرو بــنِ أُمِّ أنَـاسٍ","مِــن قَـــرِيــبٍ لَــمَّــا أَتَانَا الحِبَـاءُ"],["4F765493-7395-5827-AC6F-BE94D9C76150","مِـثــلُـهَــا تُـخرِجُ النَصِيحةَ للقَـومِ","فَــــلاةٌ مِــــن دُونِــهَــــا أَفــــلاءُ"],["F7FBEE68-1786-5FEA-8CD9-C20022D3DCDE","فَـاتْـرُكُوا الطَيـخَ والتَعَاشِي وَإِمّـا","تَتَـعَاشَــوا فَفِــي التَعَـاشِي الــدَّاءُ"],["7B390792-F237-5220-8C90-FF4F9737C8EA","وَاذكُرُوا حِلفَ ذِي المَـجَازِ وَمَـا","قُـــدِّمَ فِـيــهِ الـعُـهُــودُ وَالكُـفَـلاءُ"],["D0FD3803-0D7B-5E29-ABAF-2D41D8BA0A75","حَذَرَ الجَورِ وَالتَعدِّي وَهَل يَنقُضُ","مَــا فِــي الـمَـهَــارِقِ الأَهــــوَاءُ"],["5F17020C-20B8-51BD-B7D9-0B9CA9280CB5","وَاعـلَـمُــوا أَنَّـنَــا وَإِيَّـاكُم فِي مَـا","إِشـتَـرَطـنَـا يَـومَ إِخـتَلَفنَـا سَـوَاءُ"],["A3B16AD0-99CA-5320-8CDD-6FC907477779","عَـنَـنــاً بَـاطِـلاً وَظُـلماً كَمَا تُعتَـرُ","عَـن حَـجــرَةِ الـرَبِـيـضِ الظَّبَـاءُ"],["4569061E-E86A-5A12-A5F0-72AED40E0B44","أَعَـلَـيـنَـا جُـنَـاحُ كِـنــدَةَ أَن يَـغنَـمَ","غَــازِيــهُـــمُ وَمِــنَّـــا الــجَــــزَاءُ"],["5BB15456-4A7A-5CB6-8EE8-C1EEC577ED57","أَم عَـلَــيـنَـــا جَرَّى إيَادٍ كَمَا نِيـطَ","بِــجَـــوزِ الـمُــحـمَّــلِ الأَعــبَــاءُ"],["DFF46C30-538F-5BD9-8B91-C6B1BDE759DE","لَيــسَ منَّا المُضَـرَّبُونَ وَلا قَيــسٌ","وَلا جَــــنـــدَلٌ وَلا الـــحَــــــذَّاءُ"],["BECED53B-904A-5DD1-8208-40BF7CD683D1","أَم جَـــنَـايَـا بَـنِــي عَـتِـيــقٍ فَــإِنَّـا","مِـــنــكُــم إِن غَـــدَرتُـــم بُــــرَآءُ"],["973496EC-7222-539A-A74F-C1496A560542","وَثَـمَـانُـــونَ مِـن تَــمِـيـمٍ بِأَيدِيهِـم","رِمَــاحٌ صُــدُورُهُـــنَّ الـقَـضَــاءُ"],["AA025A12-D352-57F3-8A90-19CEFCCF60EF","تَـرَكُــوهُــم مُـلَـحَّـبِـيـــنَ فَـآبُـــوا","بِـنَـهــابٍ يَـصَــمُّ مِـنـهَا الـحُـــدَاءُ"],["CB9FFFED-69E6-5525-81A6-60CBC0C7685A","أَم عَـلَـيـنَــا جَــرَّى حَـنِـيـفَةَ أَمَّــا","جَـمَّـعَــت مِـن مُـحَـارِبٍ غَبـرَاءُ"],["62C84C32-45E6-5423-8F91-9051A3381948","أَم عَلَينَا جَـرَّى قُضَـاعَةَ أَم لَيـسَ","عَــلَـيـنَــا فِــي مَـا جَــنَـوا أَنــدَاءُ"],["871782AC-806C-5795-ACE0-D10224E40436","ثُمَّ جَـاؤوا يَستَرجِعُونَ فَلَم تَرجِـع","لَــهُـــم شَـــامَـــةٌ وَلا زَهـــــرَاءُ"],["81F1AC59-4B82-52CB-8C39-533BBE1274DA","لَم يُـخَـلَّوا بَـنِــي رِزَاحٍ بِـبَـرقَــاءِ","نِــطَــاعٍ لَـهُـم عَــلــَيـهُــم دُعَــاءُ"],["624F61B3-82FD-5DA9-B03D-F106E50FBE86","ثُمَّ فَـاؤوا مِنهُـم بِـقَاصِمَـةِ الظَّهـرِ","وَلا يَــبـــرُدُ الــغَــلِـيــلَ المَــــاءُ"],["EECC2E46-E544-5022-960F-6CA461FB206D","ثُمَّ خَيلٌ مِن بَعدِ ذَاكَ مَعَ الـغَـلاَّقِ","لا رَأَفَـــــــةٌ وَلا إِبـــــقَـــــــــاءُ"],["D147F1C4-576A-555A-8585-E0024722EDE8","وَهُوَ الرَّبُّ وَالشَّهِـيـدُ عَلَى يَــومِ","الـحَـيــارَيــنِ وَالـبَـــلاءُ بَـــــلاءُ"],["26447629-CAF3-5B51-AFA1-94EED297C4BB","آذنـتــنـا بــبــيــنــهــا أســمــــاء","رب ثـــاو يــمـل مــنــه الثــواء"],["FCE627EA-7D8F-5726-BF60-E86646383129","بـعــد عـهــد لـنـا ببـرقَـة شمــاء","فــأدنــى ديــارهــا الـخـلـصــاء"],["65530468-41B9-5F14-8CC4-3D7BE8B7A708","فـالـمـحيـاة فـالصـفاج فـأعـنـاق","فـــتــاق فـــعــاذب فــالــوفــــاء"],["F3289EEB-6F6C-59E8-9662-3435E783BFA4","فــريـاض الـقـطـا فـأوديـة الشـ","ــربـب فـالشـعــبـتـان فـالأبــلاء"],["B2E96676-00BE-5582-85CA-CC63AB724CE7","لا أرى مـن عهـدت فيـها فأبكي","اليــوم دلها ومـا يـحيِـر الـبكـاء"],["280886E4-0DA8-5B22-A01C-722455AC98CD","وبـعــيـنـيـك أوقَـدت هـنـد النـار","أخـيــرا تـلــوِي بـهـا الـعـلـيــاء"],["42CB7B09-D0E6-5737-946C-E7F81079E5EB","فـتـنــورت نـارهــا مـن بـعـيــد","بخـزازى هيـهات مـنك الصـلاء"],["DD9416A2-FBBE-5A99-B564-126213C678A8","أوقـدتها بيـن العـقيقِ فـشخصين","بــعــود كــمـا يـلــوح الـضـيــاء"],["FCB904C2-2D7B-5AD0-B45E-EA6D29049894","غـير أني قـد أستعين على الهـم","إذا خـــف بــالــثــوِي الـنـجــاء"],["75ACA47A-DBA0-5FD2-A6ED-B10579DB3B99","بــــزفـــوف كـــأنــهــا هــقـلــة","أم رئـــــال دوِيــــة ســقـــفـــاء"],["A2DD767A-9F35-52E8-942A-F426885AC4AA","آنـست نـبأة وأفـزعها الـقنـاص","آعــصــرا وقــد دنـا الإِمـســـاء"],["F5A42DC9-9A6F-5A08-81CF-80C24E6C5325","فـتـرى خلـفها مـن الرجـع والـ","ــوقــع مـنـيـنــا كــأنـه إهــبـــاء"],["DBE25DF8-F915-5FD7-AF51-3E44773FB733","وطــراقـا مـن خـلفـهـن طــراق","سـاقطات ألـوت بـها الصحـراء"],["CA652F65-68B1-503D-815B-1DF7896117E7","أتـلـهـى بـها الـهـواجـر إذ كــل","ابـــن هـــم بـلــيـــة عــمــيـــاء"],["AB451816-3296-540C-AF8F-B2F1C41C2F7A","وأتـانـا مـن الحــوادث والأنبــاء","خـطــب نــعـنــى بــه ونـســـاء"],["F609DF1D-4F34-565B-9426-C00781CABA68","إن إخــوانـنـا الأراقـم يـغـلــون","عـلـيـنــا فــي قـيـلـهــم إِخـفـــاء"],["DED037C8-D5A8-505F-B286-4DD570084145","يـخـلـطـون البريء منا بـذي الـ","ـذنـب ولا يـنـفـع الخـلي الخلاء"],["5A821F8A-DE43-5B11-8904-FD07BFE49AE1","زعموا أن كل من ضرب العير","مـــوال لـــنـــا وأنـــا الـــــولاء"],["A52F7D43-FD39-5070-8BAE-9C11ADD72A03","أجــمـعـوا أمـرهـم عـشاء فلمـا","أصبحوا أصبحت لهم ضوضـاء"],["2BDE776D-1E81-5974-8180-6C5588EEFA6A","مـن مـنــاد ومـن مـجيـب ومـن","تـصهال خـيل خلال ذاك رغـاء"],["D5C11562-C860-5EFB-B3B5-82F0F089A5CF","أيـهـا الـنـاطــق الـمـرقــش عنـا","عـنــد عـمــروٍ وهـل لذاك بقـاء"],["BE45E48F-6BA7-5C88-9C5A-E8377CD3001E","لا تخـلـنــا عـلـى غــراتـك إنــا","قَـبل مـا قَـد وشـى بـنا الأعــداء"],["00B4929B-4922-524F-BA2F-8205AD3B7EEF","فـبــقـيـنـــا عـلـــى الـشـنــــاءة","تـنـمـينـا حصون وعزة قَعســاء"],["06CAF984-68EE-5816-84C0-78D69F7FF729","قـبـل مـا الـيـوم بيـضت بعيــون","الـنــاس فـيـهــا تــغـيــظ وإبـــاء"],["1B49897A-CC89-589A-9573-3174A3CE134D","فكـأن المنون تردي بنـا أرعــن","جــونـا يـنـجــاب عـنـه العـمــاء"],["C3F54AE3-D2A7-513E-9502-4A13CB518156","مكفهرا على الحوادث لا ترتـوه","لــلـــدهـــر مــؤيِـــد صــمــــاء"],["4F3CAEA5-FD42-54A9-8E01-8E91E9C5C675","رمــي بـمـثـلــه جـالـت الخـيــل","فــآبـت لـخـصـمــهــا الإِجـــلاء"],["346E0792-13DD-56A6-AECB-7B538FF9AE41","مـلك مقسط وأفضل من يمـشـي","ومــن دون مــا لــديــه الـثـنــاء"],["09853F4A-F448-594E-889C-00DF53AA25BE","أيـمــا خـطــة أردتــم فــأدوهـــا","إلــيـنــا تـشـفــى بهــا الأمـــلاء"],["E19A35D0-5828-569C-9A67-73A5CE0E42AE","إن نبشتـم ما بـيــن مـلـحــة فـالـ","ـصاقب فيه الأموات والأحـيــاء"],["AD5226C9-6D8A-5159-A918-88C95269EA93","أو نقشتـم فالـنـقــش يـجـشـمـــه","النـاس وفيه الإسقـام والإبـــراء"],["0E9F1989-18F0-5992-AAEF-AC2F7FEF11C0","أو سكتم عنا فكنا كمن أغـمـض","عـيـنــا فــي جـفـنـهــا الأقــــذاء"],["43230E33-1B53-53ED-81BA-9860F1A8A8C0","أو منعتم ما تسألون فـمـن حـــد","ثـتـمــوه لــه عـلـيـنــا الـعـتــلاء"],["35C62404-B209-58D2-A0B5-E1300E82F339","هـل عـلـمـتـم أيام ينتهب النــاس","غــــوارا لــكــل حـــي عـــواء"],["16492D12-4BB7-5F35-A13D-BED90F576DEC","إذ رفـعـنا الجمـال من سعف الـ","بحرين سيرا حتى نهاها الحساء"],["25F1CD1F-D9DA-5B4F-8DA5-61F3BDF5B9FA","ثــم مــلنـــا علـــى تميم فأحرمنــا","وفـيـنـــا بـنـــــات قَـــوم إِمـــــاء"],["1465A461-DC38-50EF-BACC-F2CFAD9F91F7","لا يقــيـــم العــزيـز بالبلد السهــل","ولا يــنــفـــع الـــذلــيـــل النجــاء"],["17A33E33-BF31-5D95-8873-185B73FF1C35","ليـــس يــنــجــي الذي يوائل منــا","رأس طــــود وحـــرة رجـــــلاء"],["7299732D-6928-522D-BF98-4CB231399E04","مــلك أضــلـــع البرِية لا يــوجــد","فـــيــهـا لــمـــا لــديـــه كــفـــــاء"],["2849F8BE-3E8C-5C02-A9C8-026DDED8B0FE","كـتـكــاليف قومـنا إذا غـزا المنـذر","هــل نحـــن لابــن هـنـــد رعـــاء"],["D918B805-025C-5D46-882B-1A704104BCE9","مــا أصـابـوا مـن تغلبي فمطلــول","علــــيـه إذا أصيـــــب الـعـفـــــاء"],["9A0C4FC2-1AA9-5789-85D5-D0763FE03608","إذ أحـــل العـــلاة قبـــة مـيســون","فـــأدنــــى ديارهــــا العوصــــــاء"],["B446428B-0E16-51FD-A93B-8E74DB4895D5","فتــــأوت لــــه قــراضبـــة مـــن","كـــل حـــي كــأنــهـــم ألــقــــــاء"],["EA4EB83A-E40A-5283-A54A-C7333D0940CF","فهــداهــم بالأســـودين وأمـر الله","بـالــغ تـشـقـــى بــه الأشـقـيــــاء"],["9230CAA6-345D-5987-B80C-F5D3A8057B6E","إذ تـمـنـونـهـم غــرورا فسـاقتهـم","إليـــكـــم أمـــنـــيــــة أشــــــراء"],["BCAB0D32-74FA-5ED9-B36B-EC63335760CF","لــم يغـــروكــم غــرورا ولكـــن","رفـــع الآل شـخـصهم والضحـاء"],["F2BDD2FE-C9D5-5338-93FA-01884C581ACE","أيهـــا النــاطـــق المــبلـــغ عــنــا","عنـــد عــمرو وهـل لـذك انتـهـاء"],["F083279C-8731-5645-BC04-0F04514BAB4C","مــن لــنـــا عــنـــده مـــن الخيـر","آيــات ثــلاث فــي كلهِـن القضـاء"],["0768FB88-07BB-5700-BE0F-22C9F27A6F5E","آيــة شــارِق الشــقيقة إذا جــاءت","مـــعــــد لـــكــــل حــــي لــــواء"],["C70F7C9F-7369-5855-9E89-693E2B965851","حــول قــيــس مـستلئميـن بـكبـش","قـــرظـــي كـــأنـــه عــبــــــــلاء"],["C1A17248-0C10-5FA4-88EB-CB0E050207C0","وصـتـيـت مـن الـعـواتـك لا تنهاه","إلا مـــبـــيـــضـــــة رعــــــــلاء"],["CB6B2C0F-3EF4-5250-9BF7-4687C017EDD2","فــرددنــاهــم بـطـعـن كـما يخـرج","مـن خـربـة الـــمــزاد الــمــــــاء"],["54AF7456-0331-5E01-8A9F-B7D2AAE72F80","وحـمـلـنـاهـم عـلـى حـزم ثـهـلان","شـــــلالا ودمـــــي الأنســــــــاء"],["633D858A-F008-5E2D-B9EF-66D5E3A44619","وجــبــهــنـــاهــم بطعن كما تنهـز","فــي جـــمــة الــطـــوِي الـــدلاء"],["F4889EF5-0019-57FB-A3EC-DDF1C6841520","وفــعــلــنـــا بــهـم كـما علـم الله","ومـــا أن للــحــائــنـيـــن دمــــاء"],["D39FF147-F156-5C71-AF17-062E63A43AB5","ثــم حــجـــرا أعـني ابن أم قطـام","ولــــه فـــارســيـــة خــضــــراء"],["E93F567E-D1D1-5253-B0E2-E38362B8B69E","أســـد فــي اللــقــاء ورد همـوس","وربيـــع إن شــمـــرت غــبــراء"],["F6AA7D97-65FE-5346-950E-05D4A5C0F184","وفـككـنا غـل امـرِيء القيسِ عنـه","بــعـــد مــا طــال حبسـه والعنـاء"],["E0ED7880-800F-5190-B80C-687BDD7B4332","ومع الجـون جون آل بني الأوس","عــتـــــود كـــأنــهـــــا دفـــــواء"],["0AA5C14D-337F-5D4F-B781-BCEDABC8D6CB","ما جزعنا تحت العجاجة إذ ولوا","شـــلالا وإذ تــلــظـــى الصــلاء"],["27C0B25B-FF02-5929-8B02-4CD8B2C39A4F","وأقـــدنــاه رب غــسـان بالمنـذر","كـــرهــا إذ لا تــكـــال الــدمــاء"],["8F7D1E34-70B8-5EF7-9FEB-9542AC627519","وأتــيــنـــاهــم بــتسعـة أمـــلاك","كـــرام أســـلابــهـــم أغـــــــلاء"],["FE45472A-07E9-5704-BC60-BFA357933C7F","وولـــدنا عــمـــرو بــن أم أنـاسٍ","مــن قـــريــب لــمــا أتانا الحبـاء"],["5552BDC8-A108-5ECA-A92E-36CCA651D9EE","مـثــلـهــا تـخرج النصيحة للقـوم","فــــلاة مــــن دونــهــــا أفــــلاء"],["97375C5A-673A-5EFA-AEDE-164349FCDD9A","فـاتـركوا الطيـخ والتعاشي وإمـا","تتـعاشــوا ففــي التعـاشي الــداء"],["DBE8096E-7129-5DBF-A3FF-1FBF1416EAAF","واذكروا حلف ذي المـجاز ومـا","قـــدم فـيــه الـعـهــود والكـفـلاء"],["81895714-0BB5-59A5-A708-387DCE7DC655","حذر الجور والتعدي وهل ينقض","مــا فــي الـمـهــارق الأهــــواء"],["B7AED3EB-EF13-541B-978F-7376E03DE0CD","واعـلـمــوا أنـنــا وإيـاكم في مـا","إشـتـرطـنـا يـوم إخـتلفنـا سـواء"],["2B5FCE11-92C7-5008-A9F4-2A3FFC3AEECE","عـنـنــا بـاطـلا وظـلما كما تعتـر","عـن حـجــرة الـربـيـضِ الظبـاء"],["B12A3BEE-1343-5379-9DDB-C5B426744166","أعـلـيـنـا جـنـاح كـنــدة أن يـغنـم","غــازيــهـــم ومــنـــا الــجــــزاء"],["B6E4A527-E005-547A-9580-84CACEE6B691","أم عـلــيـنـــا جرى إياد كما نيـط","بــجـــوز الـمــحـمــل الأعــبــاء"],["78AA2781-CECC-50AC-A2DC-3757BEC9ABE9","ليــس منا المضـربون ولا قَيــس","ولا جــــنـــدل ولا الـــحــــــذاء"],["246151CB-40F8-5571-BACF-2FE539A68F43","أم جـــنـايـا بـنــي عـتـيــق فــإنـا","مـــنــكــم إن غـــدرتـــم بــــرآء"],["C40B44AE-90B3-5147-8913-D70FB6CDE6CF","وثـمـانـــون مـن تــمـيـم بأيديهـم","رمــاح صــدورهـــن الـقـضــاء"],["6876B391-588A-5121-A811-90ECF28EE51C","تـركــوهــم مـلـحـبـيـــن فـآبـــوا","بـنـهــاب يـصــم مـنـها الـحـــداء"],["7B155A72-3DF0-5E6A-BD09-076007A61813","أم عـلـيـنــا جــرى حـنـيـفة أمــا","جـمـعــت مـن مـحـارِب غبـراء"],["2A0F17AA-1D5B-502D-A2EC-25A04F276301","أم علينا جـرى قضـاعة أم ليـس","عــلـيـنــا فــي مـا جــنـوا أنــداء"],["B26C8D75-3551-5E61-A880-854D3D7134BD","ثم جـاؤوا يسترجعون فلم ترجـع","لــهـــم شـــامـــة ولا زهـــــراء"],["86244576-2490-5133-935E-9F3E4E044ECB","لم يـخـلوا بـنــي رِزاح بـبـرقَــاء","نــطــاع لـهـم عــلــيـهــم دعــاء"],["44F6A0FF-945B-50B0-8048-EB9943AB2FF1","ثم فـاؤوا منهـم بـقاصمـة الظهـر","ولا يــبـــرد الــغــلـيــل المــــاء"],["87D7BC70-415B-5D43-A37C-951157CB02F7","ثم خيل من بعد ذاك مع الـغـلاق","لا رأفـــــــة ولا إبـــــقـــــــــاء"],["6C0C31F9-F5A3-5812-8B32-E290BC33CCC0","وهو الرب والشهـيـد على يــوم","الـحـيــاريــن والـبـــلاء بـــــلاء"]]},"4081D55D-E3E7-56D7-A9D9-F94E9D0D9729":{"t":"نَحْنُ مِنْ عَامِرِ بْنِ ذُبْيَانَ وَالنَّا","p":19,"s":"نحن من عامر بن ذبيان والنا","r":"436153","v":[["58955590-DC73-5195-B8C3-360F0A123196","نَحْنُ مِنْ عَامِرِ بْنِ ذُبْيَانَ وَالنَّا","سُ كَهَامٍ مَحَارُهُمْ لِلْقُبُوِرِ"],["B88BC112-7342-594F-90DF-12F1CDED5852","إنَّما العَجْزُ أنْ تَهُمَّ وَلاَ تَفْـ","ـعَلَ والهَمُّ نَاشِبٌ فِي الضَّمِيرِ"],["5F4C7AE6-1AE6-5698-B2A4-1DE62CB9F558","أَرِقاً بِتُّ ما ألذُّ رُقاداً","تَعْتَرِيني مُبَرَّحَاتُ الأُمُورِ"],["C0680889-24E3-575D-A8C6-C7BB9EDC9A71","وارداتٍ وضاجراتٍ إلى أنْ","حَسَرَ المُدْلَهِمُّ ضَوْءَ البَشِيرِ"],["13162289-E369-569E-80E3-324288C547D4","قَذَفتكَ الأيَّـامُ بالحدثِ الأكْـ","ـبَرِ منها وشابَ رأسُ الصَّغيرِ"],["785A6791-1D06-5C61-BCE5-8BF22BD2D3D2","وَتَفَانَى بَنُو أَبِيكَ فَأَصْبَحْـ","ـتَ عَقيراً للدَّهرِ أو كالعَقيرِ"],["00AA9842-70E6-5E4A-B5A9-012E26FA85BC","ليسَ منْ حادثِ الزَّمانِ إذا حـَ","ـلَّ على أهلِ غبطةٍ مِن مُجيرِ"]]},"1B9B61D2-FE1C-5313-BD6A-4FF906ADA4AA":{"t":"ولوَ أنَّ ما يأوِي إلَيَّ م","p":19,"s":"ولو أن ما يأوي إلي م","r":"436151","v":[["D844C69B-8412-55A3-BC2F-C0F01FFF4D8B","ولوَ أنَّ ما يأوِي إلَيَّ م","أصَابَ مِنْ ثَهْلاَنَ فِنْدَا"],["B07ACE43-DA4F-5A8E-B5E5-ABD3EC211849","أو رأسَ رهـوَةَ أو رُؤُو","سَ شوامخٍ لَهِدِدْنَ هدَّا"],["F2B9F1EA-F58D-52E3-9C76-21A72EFEF33C","خَيْلِي وَفَارِسُها، لَعَمْرُ","ــرُ أبيكَ كانَ أجلَّ فَقدا"],["A80ADE00-E4FF-5AEB-98EB-D39261F8C4A7","فَضَعِي قِنَاعَكِ إنَّ رَيْـ","ـبَ مُخبِّلٍ أفْنى مَعَدَّا"],["3F17E7C0-B732-5655-9FF7-4C4C32F70ECE","مَنْ حَاكِمٌ بَيْنِي وَبَيْـ","ـنَ الدَّهْرِ مَالَ عَلَيَّ عُمْدَا"],["B5273C07-F49B-508B-96EB-B4548F12E04B","أودى بسادتِنَـا وقـدْ","تَرَكُوا لَنَا حَلَقا وَجُرْدَاَ"],["A2C98A29-2B47-5CA8-995F-84F007157AF5","وَلَقَدْ رَأَيْتُ مَعَاشِرا","قدْ جمَّعوا مالاً وَوُلْدَا"],["98EFC8C0-E8E9-5B28-B57E-2D88D342A028","وَهُمُ زَبابٌ حَائِرٌ","لا يَسْمَعُ الآذَان رَعْدَا"],["C73C0EEC-2D84-5962-B3DD-334D04E3466F","فانْعَمْ بجَـدٍ لا يَضِرْ","كَ النُّوْكُ ما أُعْطِيتَ جَدّا"],["81D83544-3B19-5C87-8F29-74FDAD5B22AF","فالنُّـوكُ خيرٌ في ظِلا","لِ العَيْشِ مِمَّنْ عَاشَ كَدَّا"],["27FE9233-E80C-5E76-A40B-9A00C8984EDA","هَلْ يُحْرَمُ المَرْءُ القَوِيُّ","وقدْ ترى للنُّـوكِ رُشْدَا"]]},"4298504F-E262-5409-9A4F-209E22268B3F":{"t":"وَتنوءُ تُثْقِلُهَـا روادِفُهَـا","p":19,"s":"وتنوء تثقلهـا روادفهـا","r":"436158","v":[["B6E0DA40-47FB-5567-896F-64F3FD1F9BDD","وَتنوءُ تُثْقِلُهَـا روادِفُهَـا","فِعْلَ الضَّعِيفِ يَنُوءُ بالوَسَقِ"]]},"40B83B1A-4CC8-5CBC-840E-C90DA8ED36BF":{"t":"وَلَمَّا أنْ رَأيْتُ سَرَاةَ قَوْمِي","p":19,"s":"ولما أن رأيت سراة قومي","r":"436162","v":[["FD9CDF24-1CAC-5094-89F6-EF68FE48A7E4","وَلَمَّا أنْ رَأيْتُ سَرَاةَ قَوْمِي","مَسَاكَى لا يثوبُ لَهمْ زعيمُ"]]},"631CF739-B55C-51B7-A047-C49568D5365D":{"t":"يا آلَ زَيْدِ مَنَاةَ هَلْ مِنْ زَاجِرٍ","p":19,"s":"يا آل زيد مناة هل من زاجر","r":"436159","v":[["8B579ABE-8DD6-595E-ABA3-93A20FED38CD","يا آلَ زَيْدِ مَنَاةَ هَلْ مِنْ زَاجِرٍ","لَكُمُ فَيَنْهَى الجَهْلَ عَنْ هَمَّامِ"],["EF75D34D-4B69-5616-B4B4-00FC7285A9A0","مَاإنْ يُسَافِهُنا أُنَاسٌ سُوقَةٌ","إلاَّ سنشعَبُ هامَهُمْ في الهَامِ"],["76ACB10F-B921-51E1-AC6A-E9CD032B887C","مِنَّا سَلاَمَةُ إذْ أَتَانَا ثَائِرا","يَعدو بأَبيضَ كالغديرِ حُسامِ"],["0C3ECB83-9135-56BA-BDD9-FE5474239C8F","فَعَلاَ بِهِ شَعَرَ القَذَالِ وَيَدَّعي","فِعْلَ المُخَايِلِ مُقْعَدَ الإعْصَامِ"],["AA05581D-380E-5895-8F50-22D290E3C34A","وثنى لهُ تحتَ الغُبارِ يجرُّهُ","جَرَّ المُفَاشِغِ هَمَّ بالإرْآمِ"],["66532A5A-1A48-5DDD-B465-5365665C2B51","وسَما فيمَّمَهَـا المفازَةَ قائِظاً","يعلو المهامِهَ في سبيلٍ حامِ"]]},"A8D8D936-2D1C-5A94-886B-F642FB8522EF":{"t":"يا أيُّها المُزْمعُ ثُمَّ کنْثَنَى","p":19,"s":"يا أيها المزمع ثم کنثنى","r":"436150","v":[["26E5C42A-9CD4-502E-BA72-4C30869F8CE9","يا أيُّها المُزْمعُ ثُمَّ کنْثَنَى","لا يَثْنِكَ الحَازِي وَلاَ الشّاحِجُ"],["7349046F-A866-58AA-8E76-0BAA74C84181","ولا قَعيـدٌ أعْضبٌ قـرنُـهُ","هَاجَ لَهُ مِنْ مَرْتَعٍ هَائِجُ"],["D6E79E88-1B0E-5228-A487-A6EFADD019B1","قُلْتُ لِعَمْرٍو حِينَ أرْسَلْتُهُ","وَقَدْ حَبَا مِنْ دُونِهِ عَالِجُ"],["9B373FBB-B0AA-5941-928A-CB2F735DE9B6","لاَ تَكْسَعِ الشَّوْلَ بأغْبَارِهَا","إنكَ لاَ تَدْرِي مَنِ النَاتِجُ"],["0B167E0D-680A-5716-908E-0FDE61DCBBD5","قَدْ كُنْتَ يَوْما تَرْتَجِي رِسْلَهَا","فَأُطْرِدَ الحَائِلُ وَالدَّالِجُ"],["30B83AE7-9737-5A3C-97EC-816EF75F7DF0","رُبَّ عِشَارٍ سَوْفَ يَغْتَالُهَا","لا مبطىءُ السَّيرِ ولا عائجُ"],["0D239C32-88DA-5B05-BD89-F9C0F2147D79","يطيرها شـلاً إلَى أهلِهِ","كما يُطيرُ البَكرةَ الفَالجُ"],["33CB3602-2256-5D3A-9F60-6FF9305E4712","بينا الفتى يَسعى وَيُسْعَى لهُ","تيحَ لهُ منْ أمرهِ خالجُ"],["3E2DE3E8-F394-5745-B3CA-58DD1CC540AB","يَتْرُكُ مَا رَقَّحَ مِنْ عَيْشِهِ","يعيثُ فيهِ همَـجٌ هامـجُ"],["15332559-4E8D-5E11-A5A6-A2EDFB39D05E","فَکصْبُبْ لأَضْيَافِكَ ألْبَانها","فإنَّ شَرَّ اللَّبَنِ الوَالِجُ"],["777C31F8-C896-50FA-A33F-2D296E0118C6","واعلمْ بأنَّ النَّفسَ إنْ عُمِّرتْ","يَوْماً لها مِنْ سَنَةِ لاَعِجُ"],["34195592-BD37-57B5-B893-F5095E1FDBBF","كذاكَ للإنْسَان فِـي عيشهِ","غاليةٌ قـامَ لهـا ناشجُ"]]},"B80CA1E5-0128-5D40-A116-090D06C2954B":{"t":"يا للــرِّجــالِ ليومِ الأربعاءِ أمـا","p":19,"s":"يا للــرجــال ليوم الأربعاء أمـا","r":"436148","v":[["E4E85106-A01B-5F81-A48A-63C004AB8C37","يا للــرِّجــالِ ليومِ الأربعاءِ أمـا","ينفــكُّ يحدثُ لي بعدَ النُّهي طرَبــا"]]}}}