{"v":1,"poems":{"FB5BE797-3D99-55B8-9225-DAF21C03B383":{"t":"معلقة لبيد بن ربيعة","p":53,"s":"معلقة لبيد بن ربيعة","r":"613112","v":[["7F2DAE8B-67EA-5FCB-96EC-F5E5B0F4F5E4","عـفـتِ الـديـارُ مـحـلُّـهـا فـمُـقـامُـهَــا","بـمـنًـى تـأبَّـدَ غَـوْلُــهـا فَـرِجَــامُـهَــا"],["D333C0E8-1D8D-556B-8B11-0FD80E783C6A","فـمـدافـعُ الـرَّيَّـانِ عـرِّيَ رسْــمُــهــا","خـلـقـاً كـمـا ضَـمِنَ الوُحِيَّ سِـلامُـها"],["AF234B9F-D46A-5DD7-B0B3-E31F401A6DA1","دمِـنٌ تَـجَـرَّمَ بـعـدَ عَـهْـدِ أنِـيـسِــهَــا","حِـجَـجٌ خَـلَـوْنَ حَـلالُـهَـا وحَـرَامُـهَـا"],["B15B2407-30E7-5FFD-A52B-501AA71E60B9","رزقَـتْ مـرابـيـعَ الـنُّـجـومِ وصـابَهَا","ودقُ الـرواعـدِ جـوْدُهَـا فـرهـامُـهـا"],["BB48E7B3-E9BC-5413-86A8-353111D4FE6D","مـنْ كـلِّ سَـارِيَــةٍ وغــادٍ مُــدْجِــنٍ","وعـشــيَّـةٍ مــتــجــاوبٍ إرْزامُــهَــا"],["98238F8A-F25E-526C-8759-EC9923245A68","فَـعَـلا فُـرُوعُ الأيْـهُـقَـانِ وَأطْـفَــلَـتْ","بـالـجـلـهـتـيـن ظـبـاؤهَـا ونـعـامُـها"],["F7476A70-2741-5810-B570-0717100C621A","والـعـيـنُ سـاكِـنــةٌ عـلـى أطْـلائِـهـا","عُـوذاً تَـأجَّـلُ بـالـفـضَـاءِ بِـهَـامُـهــا"],["C239A6E5-4729-5AC8-8141-7555949788CC","وجَـلا الـسُّـيـولُ عـن الـطّلُولِ كأنّها","زبـرٌ تــجِـدُّ مــتــونَــهــا أقْـلامُــهــا"],["A0C08195-E09E-5FDA-9A8E-A6C4EE9E04F0","أوْ رَجْـعُ واشِـمـةٍ أُسِـفَّ نَـؤورُهَــا","كـفـفـاً تـعـرَّضَ فـوقَـهـنَّ وشـامُـهــا"],["7B2BA557-6DAF-5646-9900-001D66A6A7C6","فـوقـفـتُ أسْـألُـهَـا،وكـيـفَ سُـؤالُـنَـا","صُـمّـاً خـوالـدَ مـا يُـبــيـنُ كـلامُـهـا"],["5C0B6034-42FE-5048-97FB-3EDD8B295DEA","عـرِيـتْ وكـان بـها الجميعُ فأبكرُوا","مـنـهـا وَغُـودرَ نُـؤيُـهَـا وَثُـمَـامُــهـا"],["5E2121BA-48E2-511F-A241-46325FEEFBDE","شـاقـتـكَ ظُـعْـنُ الـحيِّ حينَ تحمّلُوا","فـتـكـنَّـسُـوا قُـطُـنـاً تَـصِـرُّ خِـيَامُـها"],["C6B8D8DA-0919-5415-AEBA-64581B78162A","مـن كـلِّ مَـحْـفُـوفٍ يُـظِـلُّ عِـصِـيَّـهُ","زوْجٌ عــلــيــه كــلَّــةٌ وقـرامُـــهَــا"],["C8FE9970-7AC3-51CD-851B-07D4EC86F1F6","زُجَـلاً كـأنَّ نِـعَـاجَ تُـوضِـحَ فَـوْقَـهَا","وظِـبـاءَ وجـرَةَ عُــطَّـفـاً آرَامُــهَــا"],["9608BFC6-5C4A-5D15-8943-09738D3EA56A","حُـفِـزَتْ وَزَايَـلَـهَـا الـسَّـرَابُ كـأنها","أجْـزَاعُ بِـيـشـةَ أثْـلُـهَـا وَرُضَـامُهَا"],["E7FC4EA1-79AA-5F79-839B-B3C4E2F47EB4","بـلْ مـا تـذكـرُ مـنْ نـوارَ وقـد نـأتْ","وَتَـقَـطَّـعَـتْ أسْـبَـابُـهَـا وَرِمَــامُـهَــا"],["3FB4D7B4-827D-5D4E-9FF9-E659E4A13D7B","مُـرِّيَّــةٌ حَـلَّــتْ بِـفَــيْـدَ وَجَــاوَرَتْ","أهْـلَ الـحِـجَـازِ فـأيْنَ مِـنْكَ مَـرَامُهَا"],["6D764899-017F-5C1F-8B13-7F5D51D5EFB6","بـمـشـارقِ الـجـبـلـيـن أو بِـمُـحَجَّرٍ","فَـتَـضَـمَّـنَـتْـهَـا فَـرْدَةٌ فَـرُخَـامُــهَــا"],["72B864F5-AE8E-5FA3-AC28-91F1A9CAAAED","فَـصُـوَائــقٌ إنْ أيْـمَــنَـتْ فَـمَـظِــنَّـةٌ","فـيـهـا وحـافُ الـقَـهْرِ أوْ طِلْـخامُهَا"],["CC1A7B3E-9493-573C-BEFB-ECCBE5B9644A","فـاقـطـعْ لُـبـانَةَ مَنْ تَعَرَّضَ وَصْلُهُ","ولَـشـرُّ واصـلِ خُـلَّـةٍ صَـرَّامُــهــا"],["DC18690C-7212-58EE-BB85-FACDDA184F84","واحـبُ المُجَامِلَ بالجزيلِ وصرمُهُ","بـاقٍ إذا ضـلـعَـتْ وزاغَ قــوامُــهَـا"],["EDF30DA1-0F58-5E3D-9F6A-464212304271","بِـطَـلــيـحِ أسْــفَـارٍ تَــرَكْـنَ بـقــيَّـةً","مـنـهـا فـأحـنـقَ صُـلْـبُـها وسـنامُها"],["77B912BF-F135-5DFD-8F8F-FA18E1156AFC","وإذا تـغـالـى لـحـمُـهـا وتـحـسَّـرتْ","وتَـقَـطَّـعَـتْ بـعـد الـكَـلالِ خِـدَامُـهَا"],["E140FECA-0A90-505F-B542-AAE8F4404F91","فـلـهـا هـبـابٌ فـي الـزِّمــامِ كـأنَّـها","صهباءُ خَفَّ مع الجنوبِ جَـهَامُـها"],["7C52DE60-3B3F-5050-955F-E2F685ECC1E3","أو مـلـمِـعٌ وسـقَـتْ لأحـقـبَ لاحَـهُ","طَـرْدُ الـفُـحـول وَضَـرْبُهَا وَكِدَامُهَا"],["675CB858-6E77-59DF-8E7B-6767CBAD6682","يـعـلـوُ بـهـا حـدبُ الإكـامِ مـسحَّجٌ","قَـد رابَـهُ عـصـيـانُـهَـا ووحَـامُـهـا"],["7518D2DB-6C66-5097-9D60-3FA2A5D1C683","بـأحِـزَّةِ الـثَّـلَـبُـوتِ يَـرْبَـأُ فَـوْقَـهَـا","قَـفْـر الـمَـرَاقِـبِ خَـوْفُـهَـا آرامُـهَــا"],["3894A77D-8374-5849-8FAC-2123DAF08302","حـتـى إذا سَــلَـخَـا جُـمَــادَى سـتَّـةً","جَـزءاً فـطـالَ صِـيـامُـهُ وَصِـيَامُها"],["BCDEC977-48CD-517E-828D-7A66355B65AF","رَجَـعَـا بـأمـرهــمـا إلـى ذي مِـرَّةٍ","حـصـدٍ، ونـجـحُ صـريمةٍ إبرامُهَا"],["19786B3D-9395-57C6-9365-A305D8805BA5","ورمـى دوابـرَهَـا الـسَّـفَـا وتهيَّجَتْ","ريـحُ المـصايِـفِ سَـوْمُهَا وسِهامُهَا"],["8FE8D290-8C25-5D6F-9740-672B7B7C383C","فـتـنـازعـا سَـبِـطـاً يـطـيـرُ ظـلالُهُ","كـدخـانِ مُـشْـعَـلـةٍ يُشَبُّ ضِرَامُهَا"],["DF86284D-0E13-5D24-AF6A-EC7C206DC95F","مـشـمُـولـةٍ غلِـثَتْ بنابـتِ عـرْفَـجٍ","كَـدُخَـانِ نـارٍ سَــاطِـعٍ أسْــنَـامُـهـا"],["2E2680C1-4DB4-5C80-ADE2-71BB494135BC","فـمـضـى وَقَـدَّمَـهَـا وكـانـتْ عـادةً","مـنـه إذا هِـيَ عَــرَّدَتْ إقــدامُــهــا"],["AC991052-7310-5295-BC14-168A43D7EB2F","فتوسَّطا عرضَ السَّريَّ وصـدَّعـا","مـسـجـورةً مـتـجـاوراً قُـلاَّمُــهَــا"],["CC5D222D-2900-520C-B098-322C42421D19","مـحـفـوفـةً وسـطَ الـيـراعِ يُـظِـلُّها","مِـنـه مُـصَـرَّعُ غَــابـةٍ وقِـيـامُـهـا"],["597A156F-E059-5700-A0CD-0B3A662F818A","أفَـتِــلْـكَ أم وحْــشِـيَّـةٌ مــسبـوعَـةٌ","خـذلتْ وهـاديـةُ الصِّـوارِ قِـوَامُـها"],["0F36DE80-935F-5EDF-B622-44FC08B13E1E","خَـنْسـاءُ ضَـيَّـعَـتِ الفَـريرَ فلمْ يَرِمْ","عـرضَ الشَّـقـائِـقِ طوفُها وبغامُها"],["1A8097CB-F1B5-5CE5-A86D-75ADD0137BDE","لِــمُـعَــفَّـرٍ قَــهْــدٍ تَــنَــازَعَ شِــلْـوَهُ","غُـبْـسٌ كـواسِـبُ لا يُـمَـنُّ طَـعَامُها"],["E8E8D28B-F135-53DB-AD06-E49B3CFCE44A","صَـادَفْـنَ مـنـهـا غِـرَّةً فَـأصَـبْـنَهَا","إنَّ الـمـنـايـا لا تـطـيـشُ سهـامُـهَا"],["42DA5FBF-7D7C-52D5-9978-3F7811363A54","بـاتَـتْ وَأسْبَـلَ واكـفٌ مـن ديـمـةٍ","يـروِي الـخـمـائـلَ دائـماً تسجامُها"],["1D2A8436-8CF8-52C8-8B50-2603D9DB507F","يـعـدُو طـريـقـةَ مـتـنِـهَـا مـتـواتِرٌ","فـي لـيـلـةٍ كَـفَـرَ الـنُّـجومَ غَمَامُهَا"],["0C215E92-644F-5162-9C5B-794DCD2FEAD4","تـجـتـافُ أصْـلاً قـالِـصـاً مـتـنـبّذاً","بـعـجـوبِ أنْـقـاءٍ يـمـيـلُ هُـيَـامُـها"],["3A2FAC59-9970-5752-84E4-CFBAE22F4D08","وتُضـيءُ في وَجْـهِ الظـلام مُنِـيرةً","كـجـمـانَـةِ البـحريِّ سُـلَّ نـظامُها"],["BAFF5E46-F216-51EF-8CF6-45F2088EEF18","حتى إذا انحـسَرَ الظلامُ وَأسْفَرَتْ","بـكـرتْ تـزلُّ عـن الثَّرَى أزْلامُها"],["8F4864CA-8EB9-5C7D-9943-11DC76951F13","عَـلِـهَـتْ تَـرّدَّدُ فـي نِـهاءِ صَعَائِـدٍ","سَـبْــعــاً تُــؤامــاً كـامـلاً أيَّـامُـهـا"],["1C3CDB3C-36A8-5505-AB4F-0860DCEE3657","حـتـى إذا يَـئسَـتْ وأسْـحَقَ حَالِقٌ","لـم يُـبـلـهِ إرْضـاعُـهـا وفِـطَـامُـها"],["7D4FA99F-E038-5FAA-840F-9A875FDED37A","وتـوجـسَّـتْ رزَّ الأنـيـسِ فَرَاعَها","عن ظهرِ غَيْبٍ، والأنيسُ سَقَامُها"],["5F66DD2F-8A19-5DF4-BA78-A1F27A8C1518","فَـغَـدَتْ كـلا الفَرجَينِ تَحْسَبُ أنَّهُ","مَـولـى المخـافة خلفُـها وأمـامُهـا"],["37D07D9E-432C-5830-9FE8-FA359ED71ED8","حتـى إذا يئـسَ الـرُّماةُ وأرْسَلُوا","غـضـفـاً دواجـنَ قافلاً أعْصامُها"],["784DC2FD-2115-53AE-92F0-9ECFB6AE13E9","فَـلَـحِـقْـنَ واعـتـكـرتْ لها مَدْرِيَّةٌ","كـالـسَّـمـهـريَّـةِ حَـدَّهَـا وتَمَامُهَا"],["426425B0-713A-5841-8FCA-84D371B4238C","لِـتـذَودَهُـنَّ وَأيـقـنـتْ إن لم تَـذُدْ","أن قد أحمَّ مع الحتوفِ حمـامُها"],["8AB69546-4CBC-5ED7-B3FD-EC487546A76C","فتقصدَتْ منها كَسابِ فضُرِّجتْ","بدمٍ وغودرَ في المَكَرِّ سُخَـامُـها"],["6C65D999-6F6D-57A7-8E2C-D9CCB8ACD5B9","فبتلْكَ إذْ رقَصَ اللوامعُ بالضُّحى","واجتابَ أرديةَ السَّرَابِ إكامُها"],["834FD14E-5A63-5F95-81D2-FBCAF0AD3977","أقضـي اللُّـبانةَ لا أفـرِّطُ ريـبـةً","أو أن يـلـومَ بـحـاجـةٍ لُـوَّامُـهَـا"],["01D3CBC6-10DC-5F75-A5D7-73D3A791CE68","أوَلـم تـكـنْ تـدري نَـوَارُ بـأنَّني","وَصَّـالُ عَـقْـدِ حَـبَـائِـلٍ جَـذَّامُـها"],["9145B045-E08A-51ED-AD7E-94B70A9338F4","تَـرَّاكُ أمـكـنـةٍ إذا لـم أرْضَـهَـا","أوْ يعتلقْ بعضَ النفوسِ حِمامُها"],["6C15E4B6-DF5D-5EBF-A7B6-D2639A7E63FB","بـل أنـتِ لا تـدريـن كـم مِنْ ليلةٍ","طَـلْـقٍ لـذيـذٍ لَـهْـوُهـا ونِـدَامُـهــا"],["35DD8C99-A61A-5508-9B39-7EA80D8C3E80","قَـد بِـتُّ سـامِـرَها، وغَـاية تاجرٍ","وافـيـتُ إذ رُفِـعَـتْ وَعَـزَّ مُدَامُها"],["E222D534-BA0C-5680-8905-467981EAC1B0","أُغْلي السِّـباءَ بكـلِّ أدْكَـنَ عاتـقٍ","أو جَوْنَةٍ قُدِحَـتْ وفُضَّ خِتـامُها"],["93582A3C-DDF1-5CCD-90CE-9BFA5BF0B2B4","بـصَـبـوحِ صافيةٍ وجذبِ كرينةٍ","بــمــوَتَّــرٍ تــأتــالُــهُ إبــهـامُـهَــا"],["ED594D66-E14F-53F1-AEF9-54576EF7719A","بادرتُ حاجتَها الدّجاجَ بسـحرَةٍ","لأعَـلَّ مـنـهـا حـيـنَ هـبّ نـيامُها"],["5930D714-C70B-5C60-97A0-CA3E099E3484","وغـداةِ ريـحٍ قَـدْ وزعـتُ وَقَـرَّةٍ","إذ أصْبَـحَتْ بيدِ الشَّـمالِ زمامُها"],["8BFDD8F5-7EE1-5388-849F-BC17E70B7BA4","ولقَد حمـيْتُ الحـيَّ تحملُ شِكَّـتي","فرطٌ، وشاحـي إذْ غدوتُ لجامُها"],["6B80C366-7F72-5C89-8DED-53BF2363497E","فعَـلوتُ مرتـقـباً عَلـى ذي هَبْـوَةٍ","حَـرِجٍ إلـى أعـلامِـهِـنَّ قَـتَـامُـهـا"],["127E3BDC-89C1-53DE-B53F-AB52CAF690C6","حـتـى إذا ألْـقَـتْ يـداً فـي كــافـرٍ","وَأجَـنَّ عَـوْرَاتِ الثُّغُـورِ ظَـلامُها"],["61D33856-D762-50B5-BFF8-43068D066429","أسْـهلْـتُ وانتصَـبتْ كجذع منيفَةٍ","جَـرْدَاءَ يَـحْـصَـرُ دونـها جُرَّامُها"],["050E652B-1E52-5F18-AEDE-DE736F348E14","رَفَّـعْـتُـهَـا طَـرَدَ الـنَّــعـامِ وَشَــلَّـهُ","حتى إذا سَخِنَـتْ وَخَـفَّ عـظامُها"],["6AF369B2-250D-5BD8-B7B6-77C5BA1699A2","قَلِـقَتْ رِحَـالَتُـهَا وَأسْـبَلَ نَحْـرُهَـا","وابـتـلَّ مـن زَبَـدِ الحمِـيمِ حِزَامُهَا"],["DD8BF23E-1328-549A-AE6A-FF9E5DF440BE","تَرْقَى وَتَطَعْنُ في العِنَانِ وتَنْتَحي","وِرْدَ الـحـمَـامـة إذ أجَـدَّ حَـمَـامُها"],["98B3F50B-44F6-5010-A2AC-6A787398C48B","وكـثـيـرةٍ غُـرَبـاؤهَـا مَـجْـهُـولَةٍ","تـرجَـى نـوافِـلُـهـا ويـخْشَى ذامُها"],["5F3B2898-C8F3-545C-AFA5-4DC4047AA932","غُـلْـبٌ تَـشَـذَّرُ بـالـذُّحُـولِ كـأنَّـهَـا","جـنُّ الـبــديِّ رواســيـاً أقــدامُـهـا"],["2BA2137E-5736-537C-BA1E-C31BE15717FF","أنكـرتُ باطـلَـهـا وَبُـؤْتُ بـحـقِّـها","عنـدي، ولـم يَفْـخَرْ عليَّ كرامُـها"],["A247DE1B-0544-548C-94EA-8DBF028AE416","وَجـزَورِ أيْـسَـارٍ دَعَـوْتُ لحتـفِها","بِـمَـغَـالِـقٍ مُـتَـشَـابـهٍ أجـسـامُــهـا"],["EF495A56-AE94-5B72-92E8-4F2F72DE9BE2","أدعُـو بـهـنَّ لـعـاقِـرِ أوْ مــطـفِــلٍ","بـذلَـتْ لجـيرانِ الجـمـيعِ لحـامُهـا"],["C3E09862-EAE2-53BF-BFDB-C094F96D018E","فالضـيفُ والجـارُ الجنـيبُ كأنّـما","هبَـطَا تبـالَةَ مخـصِباً أهْــضَامُها"],["96B3DCEF-460C-5C3F-9FEA-FB5B6303331F","تـأوِي إلـى الأطـْنـابِ كـلُّ رذيَّـةٍ","مِـثْـلُ الـبَـلِيّـةِ قَـالـصٌ أهـدَامُـهــا"],["1A32DA5B-3281-51CA-8095-B47462303004","ويـكـلّلُـونَ إذا الـريـاحُ تـنـاوحَـتْ","خُـلُـجاً تـمـدُّ شـوارعـاً أيْـتَـامُـهـا"],["6D177BF9-E695-5CCE-9DD0-63D7934937AF","إنّـا إذا الـتقـتِ المـجَامِعُ لـم يَـزَلْ","مـنّـا لِـزَازُ عـظـيمـةٍ جَـشّـامُـهـا"],["9793C53D-F1AD-55CB-836E-6AF79F79BAD5","وَمُـقَسِّـمٌ يُعْــطِي العشـيرةَ حَقَّــهَا","وَمُــغَــذْمِرٌ لــحقوقِــها هَــضَّامُـها"],["D542112C-BFE6-51E1-ABCA-7DB177AD88B8","فضلاً،وذو كـرمٍ يعينُ على النَّدى","ســمحٌ كــسُوبُ رغــائبٍ غـنّامُها"],["5A6C41D7-B10A-5A8F-B0F1-35247A2846F6","مِــنْ مــعــشرٍ ســنَّتْ لـهمْ آباؤهُمْ","ولــكــلِّ قــومٍ سُــنَّةٌ وإمــامُــهَـــا"],["2A920B20-6B91-573E-BA10-D1FDDDEF34FA","لا يَـطبَــعونَ وَلا يَبــورُ فَعــالُــهُم","إِذ لا يَمــيلُ مَــعَ الهَــوى أَحلامُها"],["C65B2C0A-F2FB-5408-AF3D-4C0DA09B0126","فــاقْــنَعْ بــما قَــسَمَ المــليكُ فـإنّمَا","قســمَ الخــلائقَ بيــنَنا عــلاَّمُـــها"],["B353105D-A372-54C8-AC5D-0DD3BDF2B876","وإذا الأمــانةُ قُسِّــمَتْ في مَـعْشَرٍ","أوْفَــى بــأوْفَــرِ حَــظِّــنَا قَسّـامُهَا"],["7545456C-5A18-5D46-A248-11C692F4AD45","فــبنــى لــنا بيــتاً رفيــعاً سمــكُهُ","فَـسَمـا إلــيه كَـهْـلُـهـَا وَغُـلامُــهـا"],["7D7ED77F-803A-5C6E-A361-8B608C56CB09","وَهُمُ السُّعَاةُ إذا العشيرةُ أُفْظِعَتْ","وهـمُ فـوارِسُـهَــا وَهـمْ حُـكّـامُـهـا"],["14EF804B-7818-5DC5-AFA8-593A252F9478","وهــمُ رَبـيــعٌ للـمُـجَــاورِ فـيـهــمُ","والمرمــلاتِ إذا تطـــاولَ عَامُـها"],["FB55EA53-D1BF-5EFE-8400-12F1B527F8AF","وَهُمُ العَشيرةُ أنْ يُبَطِّىءَ حــاسدٌ","أو أن يـمـيلَ مـعَ الـعـدوِّ لئـــامُهـا"],["1A7520E5-0103-5650-A0EE-AA34AFBD8330","عـفـت الـديـار مـحـلـهـا فـمـقـامـهــا","بـمـنـى تـأبـد غـولــهـا فـرجــامـهــا"],["68A874F7-4B06-5C5D-8D13-4D05AAC0FC34","فـمـدافـع الـريـان عـري رســمــهــا","خـلـقـا كـمـا ضـمن الوحي سـلامـها"],["6DC28E30-B0EF-5802-9F17-046E570DEB15","دمـن تـجـرم بـعـد عـهـد أنـيـســهــا","حـجـج خـلـون حـلالـهـا وحـرامـهـا"],["B545B59E-9C71-5963-9BC7-FBFB7DE9E213","رزقـت مـرابـيـع الـنـجـوم وصـابها","ودق الـرواعـد جـودهـا فـرهـامـهـا"],["B0551F7F-AFCE-5C80-8682-0A0FD32DD64A","مـن كـل سـاريــة وغـــاد مــدجــن","وعـشــيـة مـــتــجــاوب إرزامــهــا"],["A6F8532D-A410-5E4F-A830-9BB5EDB502D0","فـعـلا فـروع الأيـهـقـان وأطـفــلـت","بـالـجـلـهـتـيـن ظـبـاؤهـا ونـعـامـها"],["1D8DBF8F-3066-560E-8E77-42CF2759513B","والـعـيـن سـاكـنــة عـلـى أطـلائـهـا","عـوذا تـأجـل بـالـفـضـاء بـهـامـهــا"],["99C65E98-1D4A-532F-9545-E6973B6E635F","وجـلا الـسـيـول عـن الـطلول كأنها","زبـر تــجـد مــتــونــهــا أقـلامــهــا"],["6FC307F4-CDB7-553B-AD18-9425548949DB","أو رجـع واشـمـة أســف نـؤورهــا","كـفـفـا تـعـرض فـوقـهـن وشـامـهــا"],["1E87E990-FBD3-5D8B-91D6-FB37A75995EF","فـوقـفـت أسـألـهـا،وكـيـف سـؤالـنـا","صـمـا خـوالـد مـا يـبــيـن كـلامـهـا"],["A4AD74C2-2E60-5DA6-B5E2-1BAE8C209337","عـريـت وكـان بـها الجميع فأبكروا","مـنـهـا وغـودر نـؤيـهـا وثـمـامــهـا"],["CB1B964D-01BA-5E0E-BBFD-C92EAE83E8DB","شـاقـتـك ظـعـن الـحي حين تحملوا","فـتـكـنـسـوا قـطـنـا تـصـر خـيامـها"],["85354F37-09AE-515E-A9B4-A54C6C888A57","مـن كـل مـحـفـوف يـظـل عـصـيـه","زوج عــلــيــه كــلـــة وفـرامـــهــا"],["C769C2F0-F68D-511F-882C-549AB4353415","زجـلا كـأن نـعـاج تـوضـح فـوقـها","وظـبـاء وجـرة عــطـفـا آرامــهــا"],["D71244AF-077F-57A6-98F5-9B3101F3582E","حـفـزت وزايـلـهـا الـسـراب كـأنها","أجـزاع بـيـشــة أثـلـهـا ورضـامها"],["F6693F5D-587F-5462-B053-621DE15B2428","بـل مـا تـذكـر مـن نـوار وقـد نـأت","وتـقـطـعـت أسـبـابـهـا ورمــامـهــا"],["A910D90B-7FF3-5AE4-B220-211C0D8647B9","مـريـــة حـلــت بـفــيـد وجــاورت","أهـل الـحـجـاز فـأين مـنك مـرامها"],["EB56834A-59A9-5B27-B77C-F11BAE6F31CA","بـمـشـارق الـجـبـلـيـن أو بـمـحجر","فـتـضـمـنـتـهـا فــردة فـرخـامــهــا"],["7D2AA63B-CB63-5C68-ACEE-B5946592688F","فـصـوائــق إن أيـمــنـت فـمـظــنـة","فـيـهـا وحـافُ الـقَـهْرِ أوْ طِلْـخامُهَا"],["52A50666-2CE1-5130-9E41-D4FAF301A891","فـاقـطـع لـبـانـة من تعرض وصله","ولـشـر واصـل خـلــة صـرامــهــا"],["254DA654-8165-5A0B-B359-04BC273D582F","واحـب المجامل بالجزيل وصرمه","بـاق إذا ضـلـعـت وزاغ قــوامــهـا"],["C8F9BD2F-BFE5-5098-BBD3-2C364166A2F3","بـطـلــيـح أســفـار تــركـن بـقــيــة","مـنـهـا فـأحـنـق صـلـبـها وسـنامها"],["93020058-67AE-5909-830A-34323C1836DD","وإذا تـغـالـى لـحـمـهـا وتـحـسـرت","وتـقـطـعـت بـعـد الـكـلال خـدامـها"],["62BEE628-B0AE-5D21-A319-72C571E53D6F","فـلـهـا هـبـاب فـي الـزمــام كـأنـها","صهباء خف مع الجنوب جـهامـها"],["7A26D4B2-BE02-5D65-8CC1-05BD9A9A508E","أو مـلـمـع وسـقـت لأحـقـب لاحـه","طـرد الـفـحـول وضـربها وكدامها"],["C354B92B-65BD-528A-AC0D-BF6F52A54023","يـعـلـو بـهـا حـدب الإكـام مـسحج","قـد رابـه عـصـيـانـهـا ووحـامـهـا"],["F2C8ACE1-10AF-5681-90EE-F156A6D3ED3B","بـأحــزة الـثـلـبـوت يـربـأ فـوقـهـا","قـفـر الـمـراقـب خـوفـهـا آرامـهــا"],["2620DDA3-048B-55DE-AD39-9C7B98339986","حـتـى إذا ســلـخـا جـمــادى سـتــة","جـزءا فـطـال صـيـامـه وصـيامها"],["9A0A758E-A072-5EB3-B18C-6690231E5C4D","رجـعـا بـأمـرهــمـا إلـى ذي مــرة","حـصـد، ونـجـح صـريمـة إبرامها"],["C7D73C24-0F0E-56AA-B8B2-4A102646F24B","ورمـى دوابـرهـا الـسـفـا وتهيجت","ريـح المـصايِـف سـومها وسهامها"],["721BA8D9-379E-58B1-A5B3-81383E806F1D","فـتـنـازعـا سـبـطـا يـطـيـر ظـلاله","كـدخـان مـشـعـلــة يشب ضرامها"],["CAB3D7DE-0115-52E8-93AB-28ADFCD8A42C","مـشـمـولــة غلـثت بنابـت عـرفـج","كـدخـان نـار ســاطـع أســنـامـهـا"],["7B2F9719-D257-5574-B661-DA86F3B9AC4A","فـمـضـى وقـدمـهـا وكـانـت عــادة","مـنـه إذا هـي عــردت إقــدامــهــا"],["3D2EFD3B-7196-5F44-9530-3874353C0A65","فتوسطا عرض السري وصـدعـا","مـسـجـورة مــتـجـاورا قـلامــهــا"],["3C178ABA-2F32-576C-8FA5-C8F91405D05E","مـحـفـوفــة وسـط الـيـراع يـظـلها","مـنـه مـصـرع غــابــة وقـيـامـهـا"],["83C8EE0A-F7B0-5DB4-A8DD-161691DA6BE3","أفـتــلـك أم وحــشـيــة مــسبـوعـة","خـذلت وهـاديــة الصـوار قـوامـها"],["E3F4EB53-080F-5ECC-A1DD-F0813E6B1EBB","خـنسـاء ضـيـعـت الفـرير فلم يرم","عـرض الشـقـائـق طوفها وبغامها"],["B75DB7C7-C2CE-5869-A628-D4923EFD56C0","لــمـعــفـر قــهــد تــنــازع شــلـوه","غـبـس كـواسـب لا يـمـن طـعامها"],["9E745ED5-99BA-5D9F-B415-3151DE3897A0","صـادفـن مـنـهـا غــرة فـأصـبـنها","إن الـمـنـايـا لا تـطـيـش سهـامـها"],["223626B5-9B5D-5591-A15C-134F5BF129A1","بـاتـت وأسبـل واكـف مـن ديـمــة","يـروي الـخـمـائـل دائـما تسجامها"],["1B09CD63-4966-59ED-A2FD-56086A856595","يـعـدو طـريـقــة مـتـنـهـا مـتـواتر","فـي لـيـلــة كـفـر الـنـجوم غمامها"],["626186BE-D4B7-5788-8DE3-1B0A973271F1","تـجـتـاف أصـلا قـالـصـا مـتـنـبذا","بـعـجـوب أنـقـاء يـمـيـل هـيـامـها"],["0F32C12A-B6C9-51DE-9B6C-B648E78EC008","وتضـيء في وجـه الظـلام منـيرة","كـجـمـانــة البـحري سـل نـظامها"],["2456DF1E-FCE9-59EC-BFEA-5C56B2D5FB93","حتى إذا انحـسر الظلام وأسفرت","بـكـرت تـزل عـن الثرى أزلامها"],["9E611414-9F54-5F79-A579-6E8B85DDFB68","عـلـهـت تـردد فـي نـهاء صعائـد","سـبــعــا تــؤامــا كـامـلا أيـامـهـا"],["963091CA-A991-5F43-9B85-9FD6F5CDA26E","حـتـى إذا يـئسـت وأسـحق حالق","لـم يـبـلـه إرضـاعـهـا وفـطـامـها"],["4D224BF0-C1B1-591C-8CE9-79C9EAD1FADB","وتـوجـسـت رز الأنـيـس فراعها","عن ظهر غيب، والأنيس سقامها"],["D71995E7-FAE8-559C-A6E5-346B4BD1F26E","فـغـدت كـلا الفرجين تحسب أنه","مـولـى المخـافة خلفـها وأمـامهـا"],["6A7DFFB4-F572-5D66-B375-FA9436211C06","حتـى إذا يئـس الـرمـاة وأرسلوا","غـضـفـا دواجـن قافلا أعصامها"],["851884A3-7821-5504-BBB1-2AA13EC0A573","فـلـحـقـن واعـتـكـرت لها مدريـة","كـالـسـمـهـريــة حـدهـا وتمامها"],["860A7783-B657-5458-A190-432382EBC490","لـتـذودهـن وأيـقـنـت إن لم تـذد","أن قد أحم مع الحتوف حمـامها"],["04CE638E-8488-5788-A65B-4DC596E22C11","فتقصدت منها كساب فضرجت","بدم وغودر في المكر سخـامـها"],["33F82AE1-E043-5848-AC4B-5FD625613A57","فبتلك إذ رقص اللوامع بالضحى","واجتاب أرديـة السراب إكامها"],["723D0134-B156-500E-92BE-70351C85B02F","أقضـي اللـبـانة لا أفـرط ريـبــة","أو أن يـلـوم بـحـاجــة لـوامـهـا"],["A93A8EC7-FBE0-5770-8624-B0F366D46BF5","أولـم تـكـن تـدري نـوار بـأنني","وصـال عـقـد حـبـائـل جـذامـها"],["9F96BCDF-8012-5C1C-A916-451FD5F36A3A","تـراك أمـكـنــة إذا لـم أرضـهـا","أو يعتلق بعض النفوس حمامها"],["5CF841DC-CF82-5E68-8752-D3B99958B9B0","بـل أنـت لا تـدريـن كـم من ليلـة","طـلـق لـذيـذ لـهـوهـا ونـدامـهــا"],["3CEC3058-1A97-56FF-8982-026F7665379E","قـد بـت سـامـرها، وغـاية تاجر","وافـيـت إذ رفـعـت وعـز مدامها"],["606010E5-5D5D-50D4-A6FF-7532F93EAD73","أغلي السـباء بكـل أدكـن عاتـق","أو جونـة قدحـت وفض ختـامها"],["F94DB404-9622-5F52-9A42-2722C8DBD5AE","بـصـبـوح صافيـة وجذب كرينـة","بــمــوتــر تــأتــالــه إبــهـامـهــا"],["7772D6E0-2BBE-554D-96CE-A99C1D42C103","بادرت حاجتها الدجاج بسـحـرة","لأعـل مـنـهـا حـيـن هـب نـيامها"],["91A9789B-0A03-510D-947E-477CBA07F67C","وغــداة ريـح قـد وزعـت وقــرة","إذ أصبـحت بيد الشـمال زمامها"],["72393116-4BE9-59C9-9E14-C1093A508F7B","ولقد حمـيت الحـي تحمل شكـتي","فرط، وشاحـي إذ غدوت لجامها"],["4ABA3F2E-163E-51AF-84CD-15B57A373CC1","فعـلوت مرتـقـبا علـى ذي هـبـوة","حـرج إلـى أعـلامـهـن قـتـامـهـا"],["8FA6F4BC-F184-5FB9-9649-1EA9C0B94837","حـتـى إذا ألـقـت يـدا فـي كــافـر","وأجـن عـورات الثغـور ظـلامها"],["CAC1EAA9-8739-51B3-9C16-26D21556C521","أسـهلـت وانتصـبت كجذع منيفـة","جـرداء يـحـصـر دونـها جرامها"],["0C82D30C-3BDC-5AA5-9F3A-FF3168245751","رفـعـتـهـا طـرد الـنــعـام وشــلـه","حتى إذا سخنـت وخـف عـظامها"],["A32BEA85-9F62-5E86-9FA2-7FE5FD8F8365","قلـقت رحـالتـها وأسـبل نحـرهـا","وابـتـل مـن زبـد الحمـيم حزامها"],["209160B9-A699-548B-8B57-1CF80E2208F7","ترقى وتطعن في العنان وتنتحي","ورد الـحـمـامـة إذ أجـد حـمـامها"],["EDB25467-205A-53A2-93DA-630B734D14D2","وكـثـيــرة غـربـاؤهـا مـجـهـولـة","تـرجـى نـوافـلـهـا ويـخشى ذامها"],["9A5A6CA4-8FA5-5933-A1C0-6E7B82BCE8CC","غـلـب تـشـذر بـالـذحـول كـأنـهـا","جـن الـبــدي رواســيـا أقــدامـهـا"],["BB07FD1A-6272-563A-A1B8-F7FC3BB19AA2","أنكـرت باطـلـهـا وبـؤت بـحـقـها","عنـدي، ولـم يفـخر علي كرامـها"],["56795C7E-EC27-511C-8F23-4334AA1BF2D4","وجـزور أيـسـار دعـوت لحتـفها","بـمـغـالـق مـتـشـابـه أجـسـامــهـا"],["38CBB04B-F4BB-50A0-AADF-DB2D9772B383","أدعـو بـهـن لـعـاقـر أو مــطـفــل","بـذلـت لجـيران الجـمـيع لحـامهـا"],["AD77170E-BC36-534C-B3E7-D9BA963A5A95","فالضـيف والجـار الجنـيب كأنـما","هبـطا تبـالـة مخـصبا أهــضامها"],["D7A0F4B1-2A95-5F0B-9E3A-154A0C210541","تـأوي إلـى الأطـنـاب كـل رذيــة","مـثـل الـبـليــة قـالـص أهـدامـهــا"],["6EF36541-1C56-5C69-981D-3E7A44097D40","ويـكـللـون إذا الـريـاح تـنـاوحـت","خـلـجا تـمـد شـوارعـا أيـتـامـهـا"],["3286A7F7-D411-52D0-BBB9-66049F1D47AB","إنـا إذا الـتقـت المـجامع لـم يـزل","مـنـا لـزاز عـظـيمــة جـشـامـهـا"],["469A2941-1730-59AA-A1F7-EC894E19AA2F","ومـقسـم يعــطي العشـيـرة حقــها","ومــغــذمر لــحقوقــها هــضامـها"],["FF8F2576-8BAE-5821-9972-B26CC3023F65","فضلا،وذو كـرم يعين على الندى","ســمح كــسوب رغــائب غـنامها"],["02F6D636-00EA-5067-962A-620D80AD5155","مــن مــعــشر ســنت لـهم آباؤهم","ولــكــل قــوم ســنـة وإمــامــهـــا"],["30C9480D-129A-5E04-AC36-451DC11D60AB","لا يـطبــعون ولا يبــور فعــالــهم","إذ لا يمــيل مــع الهــوى أحلامها"],["58783647-F21B-5A73-B19A-AADA28931C59","فــاقــنع بــما قــسم المــليك فـإنما","قســم الخــلائق بيــننا عــلامـــها"],["0419091F-4C52-53F8-BCF4-D0C7AF36E625","وإذا الأمــانـة قســمت في مـعشر","أوفــى بــأوفــر حــظــنا قسـامها"],["329ECD14-9010-52B5-BB02-2D00AF4D8E41","فــبنــى لــنا بيــتا رفيــعا سمــكه","فـسمـا إلــيه كـهـلـهـا وغـلامــهـا"],["2B5BB858-14E2-5902-A13B-19E9EA2F191A","وهم السعـاة إذا العشيـرة أفظعت","وهـم فـوارسـهــا وهـم حـكـامـهـا"],["9E02CD02-0F84-5B03-949F-9D1D122CF557","وهــم ربـيــع للـمـجــاور فـيـهــم","والمرمــلات إذا تطـــاول عامـها"],["465C8764-0B8E-5695-891C-1D2581587383","وهم العشيـرة أن يبطـىء حــاسد","أو أن يـمـيل مـع الـعـدو لئـــامهـا"]]},"4FCDF35E-BBF1-5E8C-A086-16ED6833435D":{"t":"مَنْ كانَ مِنّي جاهلاً أوْ مغمّراً","p":53,"s":"من كان مني جاهلا أو مغمرا","r":"436961","v":[["4DB5E941-E32A-5142-BA69-01F2979CB46C","مَنْ كانَ مِنّي جاهلاً أوْ مغمّراً","فَما كانَ بدعاً منْ بلائيَ عامرُ"],["D7045BD3-C9CD-5677-BA1A-93C81972306E","ألِفْتُكَ حتّى أخْمَرَ القوْمُ ظِنَّةً","عليَّ بنُو أُمِّ البنينَ الأكابِرُ"],["32201EA4-B2DD-54EC-B5C9-2D89D0DFA92B","ودافعتُ عنكَ الصّيدَ مِن آلِ دارمٍ","ومِنهُمْ قَبيلٌ في السُّرادِقِ فاخِرُ"],["37630800-3F2B-5613-BCFE-50B2B44A23EF","فقيمٌ وعبدُ اللهِ في عزِّ نهشلٍ","بِثَيْتَلَ، كُلٌّ حاضِرٌ مُتَناصِرُ"],["9C89B82A-21EA-5C93-82DA-D1F42F239021","فذدتُ معدّأً والعبادَ وطيئاً","وكَلباً كَمَا ذِيدَ الخِماسُ البَوَاكِرُ"],["A4532ABE-7023-5DDD-A066-5738AB793A5A","على حينَ مَنْ تَلْبَثْ عَلَيهِ ذَنُوبُهُ","يجدْ فقدَها، وفي الذنابِ تداثرُ"],["544CFC8C-D37A-50E3-B47C-852A30108CCB","وسُقْتُ رَبِيعاً بالفنَاءِ كأنّهُ","قريعُ هجانٍ يبتغي منْ يخاطرُ"],["FF9EF318-A6AC-50FC-82E2-0B947E1E8329","فأفحمتهُ حتّى استكانَ كأنّهُ","قريحُ سلالٍ يكتفُ المشيَ فاترُ"],["FDDB8B8C-363B-5597-8616-59B24085A1E8","ويومَ ظعنتمْ فاصْمعدّتْ وفودكُمْ","بأجمادِ فاثورٍ كريمٌ مصابرُ"],["0D75D85F-C231-546C-8EBF-A8F75B88503B","ويَوْمَ مَنَعْتُ الحَيَّ أنْ يَتَفَرَّقُوا","ينجرانَ، فقري ذلك اليومَ فاقِرُ"],["E795AFD0-EC06-5F69-AF23-DBF60D767B37","ويوماً بصحراءِ الغبيطِ وشاهِدي الـ","ـمُلُوكُ وأرْدافُ المُلوكِ العَراعِرُ"],["8019140B-7A96-5466-9658-37EFC6E4F8DD","وفي كلِّ يومٍ ذي حفاظٍ بلوتَني","فقمتُ مقاماً لم تقمهُ العَواوِرُ"],["38BCDB72-E034-54C3-8E36-203582CCD6AB","ليَ النصرُ منهمْ والولاءُ عليكمُ","وما كنتُ فَقْعاً أنْبَتَتْهُ القَرَاقِرُ"],["693E20D0-C332-5CE9-B351-2685681EA8F4","وأنتَ فَقيرٌ لمْ تُبَدَّلْ خَلِيفَةً","سِوايَ، وَلمْ يَلْحَقْ بَنُوكَ الأصاغرُ"],["C8663194-FFB4-50F0-987D-79DD9C2E882C","فقلتُ ازدجرْ أحناءَ طيرِكَ واعلمنْ","بأنّكَ إنْ قَدَّمْتَ رِجْلَكَ عاثِرُ"],["73A5D8AB-D458-5521-8A98-A9BC9C548FE9","وإنَّ هوانَ الجَارِ للجَارِ مُؤلِمٌ","وفاقرةٌ تأوي إليْها الفواقِرُ"],["F835073C-4BB5-53DE-84D7-5B10BF3B0827","فأصْبَحْتَ أنَّى تأتِها تَبْتَئِسْ بِها","كلا مرْكبيْها تحتَ رِجليك شاجرُ"],["0B0B9AE0-2E67-5A87-8731-2A840617152F","فإنْ تَتَقَدَّمْ تَغْشَ منها مُقَدَّماً","عظيماً وإنْ أخرتَ فالكفلِ فاجِرُ"],["F6D90932-1798-5097-8904-B14AB3E1EC2C","وما يكُ منْ شيءٍ فقدْ رُعتَ روعةً","أبا مالِكٍ تَبيَضُّ مِنها الغَدائِرُ"],["66F5A16B-8BB9-52FB-B86B-7D2626D5C78C","فلوْ كانَ مولايَ أمرأً ذا حفيظةٍ","إذاً زفَّ راعي البهمِ والبهمُ نافِرُ"],["57C23693-91FE-58EF-8AA2-E9F17934F39E","فَلا تبغيني إنْ أخذتَ وسيقةً","منَ الأرْضِ إلاَّ حيثُ تُبغى الجعافرُ"],["BDB9C630-8286-5D12-A8C6-C478068FD190","أُولئِكَ أدْنَى لي وَلاءً ونَصْرُهُمْ","قَريبٌ، إذا ما صَدَّ عَنّي المَعَاشِرُ"],["2A01D8A4-710F-581D-B494-187A07B68023","متى تَعْدُ أفْراسي وَرَاءَ وَسِيقَتي","يَصِرْ مَعْقِلَ الحَقِّ الذي هوَ صَائِرُ"],["C5838477-A6E5-5FC4-A235-3E4B083A061F","فجمَّعتُها بعدَ الشتاتِ فأصبحتْ","لدَى ابنِ أسيدٍ مؤنقاتٌ خناجرُ"]]},"CF031244-929F-564B-B590-86E92EE42F72":{"t":"هَلْ تَعرِفُ الدَّارَ بسَفْحِ الشَّرْبَبَهْ","p":53,"s":"هل تعرف الدار بسفح الشرببه","r":"437169","v":[["77A5C3E7-9F26-551F-83DE-EEB18F2F3663","هَلْ تَعرِفُ الدَّارَ بسَفْحِ الشَّرْبَبَهْ","مِن قُلَلِ الشِّحرِ فذاتِ العُنظُبَهْ"],["95A9A2D9-1BFD-5550-B878-73DCCBB6452D","جَرَّتْ علَيها، أنْ خوَتْ من أهلِها","أذْيالَها كلُّ عَصُوفٍ حَصِبَهْ"],["403FF656-223E-52E9-AF98-C146A156F484","يَمَّمْنَ أعداداً بلُبْنَى أوْ أجَا","مُضَفْدَعاتٌ كُلُّها مُطَحْلَبَهْ"],["64E580F1-1F81-5AA3-967F-A8C7667D29F0","أرْوَى الأناويضَ وأرْوَى مِذنَبَهْ",""]]},"7B27E144-C70C-5E80-B4E5-9F5308C17131":{"t":"وَلمْ تَحْمَ عَبدُ اللّهِ لا درَّ دَرُّها","p":53,"s":"ولم تحم عبد الله لا در درها","r":"436959","v":[["D5198542-CA3F-580A-8651-A573B0ED8FC4","وَلمْ تَحْمَ عَبدُ اللّهِ، لا درَّ دَرُّها،","على خيرِ قَتْلاها، ولم تَحْمَ جَعفرُ"],["1754CCC2-A612-5D1E-8355-192CDF7AAC7F","ولمْ تَحْمَ أولادُ الضِّبابِ كأنَّمَا","تُساقُ بِهِمْ وَسْطَ الصَّريمَةِ أَبكُرُ"],["43C6C60D-3AD0-5775-BED3-9C2AE215F463","وَدَوْكُمْ غَضَا الوادي فلم تَكُ دِمنةٌ","وَلا ترةٌ يسعَى بها المتذكِّرُ"],["DAFAB782-52ED-5701-8F8A-5C283C1977D2","أجِدَّكُمُ لمْ تَمْنَعُوا الدَّهرَ تَلْعَةً","كما منعتْ عرضَ الحجازِ مبشّرُ"],["17D5A73B-29CB-5E26-8C61-9C61841BD2A9","لَوَشْكانَ ماأعطَيتني القَوْمَ عَنْوَةً","هيَ السُّنَّةُ الشَّنْعاءُ والطّعْنُ يَظْأرُ"],["7F639DFF-35D6-5542-A66E-F96C65F794BD","لشتانَ حربٌ أوْ تبوءُوا بخزيةٍ","وَقد يَقبَلُ الضَّيمَ الذَّليلُ المُسَيَّرُ"]]},"E894C852-60B9-5DA7-8D8F-CA4BF392831A":{"t":"وَلَدَتْ بَنُو حُرْثانَ فَرْخَ مُحَرِّقٍ","p":53,"s":"ولدت بنو حرثان فرخ محرق","r":"436946","v":[["78F8DE74-F6BD-56C4-A569-55B808CA2543","وَلَدَتْ بَنُو حُرْثانَ فَرْخَ مُحَرِّقٍ","بِلوَى الوَضيعةِ مُرْتجَ الأبوابِ"],["51036657-DB13-5659-A9F5-6B6373E03665","لا تَسقني بيديكَ إنْ لمِ ألتمسْ","نَعَمَ الضُّجُوعِ بِغارَةٍ أسْرابِ"],["33E00D4E-2FE0-5806-8908-37AB4F9603D9","تهدي أواثلهنَ كُلُّ طمرّةٍ","جَرْداءَ مِثْلَ هِرَاوَةِ الأعْزابِ"],["1702554C-244F-5635-A01B-54449BA0788D","ومُقطَّعٍ حلقَ الرّحالةِ سابحٍ","ما إنْ يَجُودُ لِوَافِدٍ بِخِطَابِ"],["593C3177-F41E-52C0-B15C-15B779B2CDE3","يَخرُجْنَ من خللِ الغُبارِ عَوابساً","تَحْتَ العَجاجَةِ في الغُبارِ الكَابي"],["6C679B3D-B9A3-5DD4-885D-E1F5F87A9996","وإذا الأسِنَّةُ أُشْرِعَتْ لنُحورِها","أبدينَ حَدَّ نَواجِذِ الأنْيابِ"],["968AF940-8745-594B-970E-754630A53E19","يَحْمِلْنَ فِتْيانَ الوَغَى مِنْ جَعفرٍ","شُعْثاً كأنَّهُمُ أُسُودُ الغابِ"],["FB7FFF7D-E183-5D1B-AEF1-43AFE410A625","وَمُدَجَّجينَ تَرى المغاوِلَ وَسْطَهمْ","وذُبابَ كُلِّ مُهنَّدٍ قِرضابِ"],["F1973E25-BA64-53AA-BD63-FEE1195904A1","يَرْعَوْنَ مُنْخرِقَ اللديدِ كأنَّهُمْ","في العزِّ أسرَةُ حاجِبٍ وشِهَابِ"],["352CDC62-F384-584E-BB7D-8723CE63C16A","أبَني كِلابٍ كَيفَ تُنْفَى جَعْفَرٌ","وبَنُو ضُبَيْنَةَ حاضِرُو الأجبابِ"],["DC7B9A94-6D47-506B-B93E-4ED2A6C17328","قَتلوا ابنَ عُروةَ ثمَّ لَطُّوا دُونَهُ","حتى نُحاكِمَهُمْ إلى جَوَّابِ"],["18CE9A07-19D8-55D4-AC6B-95ACCD46780A","قَومٌ لَهُمْ عرفتْ معدٌّ فضلها","والحَقُّ يَعرِفُهُ ذَوُو الألْبَابِ"]]},"890FB24A-97BA-5280-9CF6-9581970268FD":{"t":"يا بشرُ بشرَ بني إيادٍ أيّكُمْ","p":53,"s":"يا بشر بشر بني إياد أيكم","r":"436960","v":[["92F51522-D535-5D86-AA51-5117AD99C3BB","يا بشرُ بشرَ بني إيادٍ أيّكُمْ","أدّى أريكةَ يومَ هضبِ الأجشرِ"],["8230B35D-E48C-530B-B36C-2CA39C9E21C0","يَتَرادَفُ الولدانُ فَوْقَ فَقَارِها","بِنِهَا الرّدافِ إلى أسنةِ محضرِ"],["9620D883-7F74-5B44-BE16-22CECC698BF7","جاءَتْ على قتبٍ وعدلِ مزادَةٍ","وأَرَحْتُمُوها مِنْ علاجِ الأيْصَرِ"]]},"ED620D4E-76F3-5DD8-B5CB-60E5917ABCD0":{"t":"يا مَيَّ قُومي في المَآتِمِ وَانْدُبي","p":53,"s":"يا مي قومي في المآتم واندبي","r":"436972","v":[["13648A77-9B4A-5C67-9BD3-138F04848748","يا مَيَّ قُومي في المَآتِمِ وَانْدُبي","فتىً كانَ ممّن يَبتني المَجدَ أرْوَعَا"],["1F0D7636-A188-5264-B78B-8CC330A12D68","وَقُولي: ألا لا يُبْعِدِ اللّهُ أرْبَدَا","وهَدّي بهِ صَدْعَ الفُؤادِ المُفَجَّعَا"],["AB70F459-05F7-5B4C-9060-6D6826704BC2","عَمِيدُ أُنَاسٍ قَدْ أتَى الدَّهْرُ دونَهُ","وخَطُّوا له يوْماً منَ الأرْضِ مضْجعَا"],["B1B0E0D8-5BA6-5640-9BF7-E48C5BA926EF","دَعا أرْبَداً داعٍ مُجيباً فَأسمعَا","ولمْ يستطعْ أنْ يستمرَّ فيمنعَا"],["4324A974-6D17-548E-AA31-FFD031410255","وكانَ سَبيلَ النّاسِ، مَن كانَ قَبلَهُ","وذاكَ الذي أفْنَى إيَاداً وتُبَّعَا"],["D28EEF67-59AA-5BAE-8432-23D45C026CDC","لَعَمْرُ أبيكِ الخَيرِ يا ابنَةَ أرْبَدٍ","لقَد شفَّني حزُنٌ أصابَ فأوْجَعَا"],["93082DFC-A723-54A6-A44D-6FA17885B066","فِراقُ أخٍ كانَ الحبيبَ فَفَاتَني","وَوَلَّى بهِ رَيْبُ المَنُونِ فَأسْرَعَا"],["A07CA41A-6A3F-554B-974F-181CD232D217","فعَيْنَيَّ إذْ أوْدَى الفِراقُ بأرْبَدٍ","فَلا تَجْمُدَا أنْ تَسْتَهِلاَّ فتَدمَعَا"],["D3EA39CC-265B-5D8D-87C0-5661A529136A","فتىً عارِفٌ للحَقِّ لا ينكِرُ القِرَى","ترَى رَفْدَهُ للضَّيفِ ملآنَ مُتْرَعَا"],["AB0C5AFE-DAB9-531B-A02C-B3BEEFF29199","لحَا اللّهُ هَذا الدَّهرَ إنّي رَأيْتُهُ","بصِيراً بما سَاءَ ابنَ آدَمَ مُولعاً"]]},"FDEA9182-4EC3-5A61-B578-A96AD5D5B07C":{"t":"يُذَكِّرُني بأرْبَدَ كُلُّ خَصْمٍ","p":53,"s":"يذكرني بأربد كل خصم","r":"436964","v":[["697E54F7-0C0D-5FA2-9069-20BA76EFC2AE","يُذَكِّرُني بأرْبَدَ كُلُّ خَصْمٍ","ألَدَّ تَخَالُ خُطَّتَهُ ضِرَارَا"],["6ADDD05F-0279-5F19-B930-FC6DFD5183B9","إذا اقْتَصَدوا فمُقْتَصِدٌ أريبٌ","وإنْ جاروا سَواءَ الحَقِّ جارَا"],["7B7AF6AC-42EB-501C-B198-DFC2056098CC","ويهْدي القومَ، مضطلعاً، إذا ما","رئيسُ القومِ بالموماةِ حارَا"]]}}}