{"v":1,"poems":{"276D9852-9A78-5A16-8323-C0392FDAC4A0":{"t":"أخلق الربع من سعاد فَأمسى","p":8,"s":"أخلق الربع من سعاد فأمسى","r":"437373","v":[["864E80FA-2FF3-5834-887A-1BC79CCBDEF5","أَخلَقَ الرَبعُ مِن سُعادَ فَأَمسى","رَبعُهُ مُخلَقاً كَدَرسِ المَلاةِ"],["1117F92C-31D0-5B04-9E9B-AAE5E858F17C","بالياً بَعدَ حاضِرِ ذي أَنيسٍ","مِن سُلَيمى إِذ تَغتَدي كَالمَهاةِ"]]},"4E5E3A77-52A0-55C2-92E7-2AA767B705C8":{"t":"ألا أبلغ سُهيلاً أن","p":8,"s":"ألا أبلغ سهيلا أن","r":"437381","v":[["EAE7B55C-C1BB-5726-B227-1F170A51B088","أَلا أَبلِغ سُهَيلاً أَنَّ","ني ما عِشتُ كافيكا"],["EEE41685-0E8E-5EE4-BF6B-5BCA88C6EC96","فَلا يُلهيكَ عِن مالِ","كَ في قَومٍ تَرائِيكا"],["C922DF73-F6FC-53A9-952B-F31DF128D52E","وَشَدِّد طَبَقَ الحَيزو","مِ إِنَّ المَوتَ لاقيكا"],["3812BF4B-E32D-5245-924B-1151339D5D3B","وَلا تَجزَع مِنَ المَوتِ","إِذا حَلَّ بَواديكا"],["051D8F25-60B3-5BFD-9CA8-F49B54C4010B","فَقَد أَعلَمُ أَقواماً","وَإِن كانوا صَعاليكا"],["91C132EF-55D2-5FDC-986B-FDD4AE6D3390","مَساريعاً إِلى النَجدا","تِ لِلغَيِّ مِتاريكا"],["A11B0121-BD49-50A3-A22E-334BD0169B63","وَخَفِّض عَنكَ في المِش","يَةِ لا يُغني تَبازيكا"]]},"012ECA8A-F15C-5C9E-9F4B-95653A3AC72B":{"t":"ألا إِن عيني بالبكاء تهلل","p":8,"s":"ألا إن عيني بالبكاء تهلل","r":"437388","v":[["6B883445-8B98-5BAF-B410-A63B217925CE","أَلاّ إِنَّ عَيني بِالبُكاءِ تُهلِّلُ","جُزوعَ صَبورٍ كُلُّ ذَلِكَ تَفعَلُ"],["08A595A7-98FF-56D2-87D2-449006CB334D","فَإِن تَعتَريني بِالنَهارِ كَآبَةٌ","فَلَيلي إِذا أَمسى أَمَرُّ وَأَطوَلُ"],["C48691C5-F911-5958-A539-FBF265BD45EB","فَما هَبرَزىٌّ مِن دَنانيرِ أَيلَةٍ","بِأَيدي الوُشاةِ ناصِعٌ يَتَأَكَّلُ"],["74E1D3F7-D64C-5EA3-8B98-A9907BD91807","بِأَحسَنَ مِنهُ يَومَ أُصبِحُ غادِياً","وَنَفَّسَني فيهِ الحِمامُ المُعَجَّلُ"]]},"FCFC263F-22A8-5424-9313-0B473BA7397C":{"t":"ألا يا لهف نفسي أَي لهف","p":8,"s":"ألا يا لهف نفسي أي لهف","r":"437384","v":[["2DF6A86A-22D0-510E-AAF3-D182EF502C36","أَلاّ يا لَهفَ نَفسي أَيَّ لَهفٍ","عَلى أَهلِ الفَقارَةِ أَيَّ لَهفِ"],["EF408AF5-0FC3-53EA-9657-CE4EFD88ABB4","مَضَوا قَصدَ السَبيلِ وَخلَّفوني","إِلى خَلَفٍ مِنَ الإِبرامِ خَلفِ"],["97EA455D-1C26-5424-944C-46337FEAE4DC","سُدىً لا يَكتَفونَ وَلا أَراهُم","يُطيعونَ اِمرَءاً إِن كانَ يَكفي"]]},"BF48CF89-8E06-5C79-8E1A-72CF869BA518":{"t":"أَرسم ديارٍ بالستارينِ تعرِف","p":8,"s":"أَرسم ديارٍ بالستارينِ تعرِف","r":"437385","v":[["5142EA56-2A8C-5307-BB4B-52AE3821F084","أَرَسمَ دِيارٍ بِالسِتارَينِ تَعرِفُ","عَفَتها شَمالٌ ذاتُ نيرَينِ حَرجَفُ"],["4B873949-9637-52A0-B323-C416CB0D2535","مُبَكِّرَةٌ لِلدارِ أَيما ثُمامُها","فَيَبقى وَأَيما عَن حَصاها فَتَقرِفُ"],["3CCF131E-3F2F-568D-A77B-601551760FF3","حَرونٌ عَلى الأَطلالِ مِن كُلِّ صَيفَةٍ","وَفَقّا عَلَيها ذو عَثانينَ أَكلَفُ"],["FE1C0EA0-BFDE-5FCE-8821-DE4C1E30C426","إِذا حَنَّ سُلّافُ الرَبيعِ أَمامَها","وَراحَت رَواياهُ عَلى الأَرضِ تَرجُفُ"],["D1B824D3-2AB1-5697-B3AF-2E357ABE3649","فَلَم تَدَعِ الأَرواحُ وَالماءُ وَالبِلى","مِنَ الدارِ إِلّا مايَشوقُ وَيَشعَفُ"],["380EAB25-9BE6-5B93-8D9D-1B0ED13A6A34","رُسوماً كَآياتِ الكِتابِ مُبينَةٍ","بِها لِلحَزينِ الصَبِّ مَبكى وَمَوقِفُ"],["2A7C4FD7-E620-56E6-A742-AD259FC1EA14","وَقَفتُ بِها وَالدَمعُ يَجري حَبابَهُ","عَلى النَحرِ حَتّى كادَتِ الشَمسُ تُكسَفُ"],["ED95B3B5-E243-52A7-B6E0-2FAB1A1BBA2C","تَذَكَّرتَ أَيّاماً تَسَلَّفتُ لينَها","عَلى لِذَّةٍ لَو يُرجَعُ المُتَسَلَّفُ"],["D249CFD1-D90F-527D-ACB8-84ADBDE65C18","كَأَنَّكَ لَم تَعهَد بِها الحَيَّ جيرَةً","جَميعَ الهَوى في عَيشِهِ ماتُصَرِّفُ"],["7C6D45E7-60A9-51B9-AD56-A7A49D713050","إِذِ الناسُ ناسٌ وَالبِلادُ بِغِرَّةٍ","وَأَنتَ بِها صَبُّ القَرينَةِ مولِفُ"],["8AC4484E-8BE6-572C-A4FE-3DD7A241E13D","وَقَد كانَ في الهِجرانِ لَو كُنتَ ناسِياً","رَميمَ وَهَل يُنسى رَبيعٌ وَصَيَّفُ"],["D4EF0EA3-1B39-5340-BD04-26EE035FB219","وَلَم تُنسِني الأَيّامُ وَالبَغيُ بَينَنا","رَميمُ وَلا قَذفُ النَوى حينَ تَقذِفُ"],["1ED4D1A1-165A-54B8-A9B2-AE26DEA17A57","وَلَم يَحلُ في عَيني بَديلٌ مَكانَها","وَلَم يَلتَبِس بي حَبلُ مَن يَتَعَطَّفُ"],["AEE1F1CF-23FD-5D66-A65E-76DA33A571AC","وَقَد حَلَفَت وَالسِترُ بَيني وَبَينَها","بِرَبِّ حَجيجٍ قَد أَهَلّوا وَعَرَّفوا"],["253FC162-BCE4-510D-9F69-1E17F42F91E0","عَلى ضُمَّرٍ في الميسِ يَنفُخنَ في البُرى","إِذا شابَكَت أَنيابُها اللَجنَ تَصرِفِ"],["69F8736A-5A4B-5507-8F8E-F3BE1D4E9A2B","لَقَد مَسَّني مِنكِ الجَوى غَيرَ أَنَّني","أَخافُ كَما يَخشى عَلى ذاكَ أَحِلفُ"],["079251CC-12E9-535B-8821-19F7DF6E7266","وَكانَ صُدودٌ بَعدَ ناءَبطَنَ الهَوى","قُلوباً فَكادَت لِلَّذي كانَ تُجنَفُ"],["49CDD1F5-544B-55D7-8AAC-BA1B17575B83","كَتَركِ الأَميمِ الهائِمِ الماءَ بَعدَما","تَنَحّى بِكَفَّيهِ يَسوفُ وَيَغرِفُ"],["8E9210C2-9D86-5F66-8A22-05BB68B851A4","وَداوِيَّةٌ لايَأمَنُ الرَكبُ جَوزَها","بِها صارِخاتُ الهامِ وَالبومِ يَهتِفُ"],["5C5685E1-2539-58F5-AE7D-B827A519553E","دَعاني بِها داعي رَميمٍ وَبَينَنا","بَهيمُ الحَواشي ذو أَهاويلِ أَغضَفُ"],["ABD5506E-2D70-5AD0-8583-B2A6951727ED","تَقَحَّمتُ لَيلَ العيسِ وَهيَ رَذِيَّةٌ","وَكَلَّفتُ أَصحابي الوَجيفَ فَأَوجَفوا"],["BE6DB723-3903-5652-B500-6884A51E7056","لِنِخبِرَ عَنها أَو نَرى سَروَ أَرضِها","وَقَد يُتعِبُ الرَكبَ المُحِبُّ المُكَلَّفُ"],["3CFBD371-BF50-5F43-B4CA-3E6751B4523C","وَلَو لَم تَمِل بِالعيسِ مَعوِيَّةُ العُرى","لَمالَ بِها أَيكٌ أَثيثٌ وَغَريفُ"],["A5685091-5549-5087-BAF4-4C8E8793995E","وَمَكنونَةٌ سودُ المَجاثِمِ لَم يَزَل","يُهَيِّرَها لِلعَيكَتَينِ التَلَهُّفِ"],["D140EF5F-FEC5-5FBB-A62E-B05EE4E799C1","وَما العَيشُ إِلّا في ثَلاثٍ هِيَ المُنى","فَمَن نالَها مِن بَعدُ لا يَتَخَوَّفُ"],["7BFB1AF9-7273-5FA2-B0C8-BB6185499FC4","صِحابَةُ فِتيانٍ عَلى ناعِجِيَّةٍ","مَناسِمُها بِالأَمعَزِ المَحلِ تَرعُفُ"],["82366C4B-D6FD-5B87-95EE-83884FF86DC4","وَكَأسٌ بِأَيدي الساقِيَينِ رَوِيَّةٌ","يُمِدّانِ راوُقيهِما حينَ تُنزَفُ"],["6379406B-CA52-5D04-A61A-86C98CA1A21A","وَرَبَّةُ خِدرٍ يَنفُحُ المِسكَ جَيبُها","تَضَوَّعَ رَيّاها بِهِ حينَ تَصدِفُ"],["9693E4EF-3E7E-5193-9985-800527220425","إِذا سُلِبَت فَوقَ الحَشِيّاتِ أَشرَقَت","كَما أَشرَقَ الدِعصَ الهِجانُ المُصَيَّفُ"]]},"FED122B3-1F5E-55D2-9D38-90F8CD14A3F1":{"t":"أَلا هل فؤادي إِذ صبا اليوم نازِع","p":8,"s":"ألا هل فؤادي إذ صبا اليوم نازع","r":"435847","v":[["0A20064E-D580-5FF1-86A0-BBDDA2A2EBB5","أَلا هَل فُؤادي إِذ صَبا اليَومَ نازِعُ","وَهَل عَيشُنا الماضي الَّذي زالَ رايِعُ"],["6BAAD0AE-363E-59C8-83B4-FF8B8324915D","وَهَل مِثلُ أَيّامٍ تَسَلَّفنَ بِالحِمى","عَوايِدُ أَو عَيشُ السِتارَينِ راجِعُ"],["C2CE2453-44FD-5DBB-9F60-09BAA22A41BB","كَأَن لَم تُجاوِرنا رَميمٌ وَلَم نَقُم","بِفَيضِ الحِمى إِذ أَنتَ بِالعَيشِ قانِعُ"],["97DD8E86-4A42-57AD-AC67-6DBD597F5D9B","وَبُدِّلتُ بَعدَ القُربِ سُخطاً وَأَصبَحَت","مُضابِعَةً وَاِستَشرَفَتكَ الأَضابِعُ"],["22CDFCDB-F0E8-55EE-8A8F-5DA016AF6333","وَكُلُّ قَرينٍ ذي قَرينٍ يَوَدَّهُ","سَيُفجِعَهُ يَوماً مِنَ البَينِ فاجِعُ"],["02511AEB-F806-5FAD-A3D8-212C25331D0B","لَعَمري لَقَد هاجَت لَكَ الشَوقَ عَرصَةٌ","بِمَرّانَ تَعفوها الرِياحُ الزَعازِعُ"],["B5546128-40A8-5232-9A1E-CEA64C4071AA","بِها رَسمُ أَطلالٍ وَخَيمٌ خَواشِعٌ","عَلى أَلِهِنَّ الهاتِفاتُ السَواجِعُ"],["5B9C60A5-B2B0-51AD-9C42-1186AD7ACDEB","فَظَلتُ وَلَم تَعلَم رَميمُ كَأَنَّني","مُهَمٌّ أَلَثَّتهُ الدُيونُ الخَوالِعُ"],["F06D9E92-7C7D-5D74-985A-6F57D470FE79","تَذَكَّرَ أَيّامَ الشَبابِ الَّذي مَضى","وَلَمّا تَرُعنا بِالفِراقِ الرَوايِعُ"],["5E053D53-FCCD-593F-98AB-1A47E88068A9","بِأَهلي خَليلٌ إِن تَحَمَّلتُ نَحوَهُ","عَصاني وَإِن هاجَرتُهُ فَهوَ جازِعُ"],["066525C0-E693-5896-AD38-73DB171D4EC1","وَكَيفَ التَعَزّي عَن رَميمَ وَحُبُّها","عَلى النَأيِ وَالهِجرانِ في القَلبِ نافِعُ"],["E4531F82-3067-5D29-BBDC-B58CD2E5F902","طَوَيتُ عَلَيهِ فَهوَ في القَلبِ شامَةٌ","شَريكُ المَنايا ضُمِّنَتهُ الأَضالِعُ"],["394913AF-A8A7-589F-9493-0384E371BC7F","وَبيضٍ تَهادى في الرِياطِ كَأَنَّها","نِهى لَسلَسٍ طابَت لَهُنَّ المَراتِعُ"],["52DDC9D6-EAE2-583B-9D24-0BB4D5A128C8","تَخَيَّرنَ مِنّا مَوعِداً بَعدَ رِقبَةٍ","بِأَعفَرَ تَعلوهُ الشُروجُ الدَوافِعُ"],["FAB6695A-A951-5366-92AD-86755A94952B","فَجُنَّ هُدُوّاً وَالثِيابُ كَأَنَّها","مِنَ الطَلِّ بَلَّتها الرِهامُ النَواشِعُ"],["A09A2ECC-A226-5123-8282-BB989AE29C0A","جَرى بَينَنا مِنهُم رَسيسٌ يَزيدُنا","سَقاماً إِذا ما اِستَيقَنَتهُ المَسامِعُ"],["9E88BB0E-38B5-5DA9-B30F-8A0039E8E7A6","قَليلاً وَكانَ اللَيلُ في ذاكَ ساعَةً","فَقُمنَ وَمَعروفٌ مِنَ الصُبحِ صادِعُ"],["0A8A5349-5199-5653-A0C1-019F6C2A70C7","وَأَدبَرنَ مِن وَجهٍ بِمِثلِ الَّذي بِنا","فَسالَت عَلى آثارِهِنَّ المَدامِعُ"],["2C8D7129-66A5-5CC2-9E0E-556D36A89D7B","يُزَجّينَ بِكراً يَنهَزُ الرَيطُ مَشيَها","كَما مارَ ثُعبانُ الفَضا المُتَدافِعُ"],["89BC891E-1CB5-5B46-BA38-409CCAA14970","تُبادِرُ عَينَيها بِكُحلٍ كَأَنَّهُ","جُمانٌ هَوى مِن سِلكِهِ مُتَتابِعُ"],["0C1B208B-AD42-5742-8923-3F17AB92A29A","وَقُمنا إِلى خَوصٍ كَأَنَّ عُيونَها","قِلاتٌ تَراخى مائُها فَهوَ واضِعُ"],["8039579E-182A-58C5-AD6E-6C7994F6A730","فَوَلَّت بِنا تَغشى الخَبارَ مُلِحَّةً","مَعاً حولُها وَاللاقِحاتُ المَلامِعُ"],["7A654531-2AF4-562E-8F06-40423CBBBA35","وَإِنّي لَصَرّامٌ وَلَم يُخلِقِ الهَوى","جَميلٌ فِراقي حينَ تَبدو الشَرايِعُ"],["122487D5-D624-5584-A957-AB5CB58BFCC6","وَإِنّي لَأَستَبقي إِذا العُسرُ مَسَّني","بَشاشَةَ نَفسي حينَ تُبلى المَنافِعُ"],["EEE93B00-E7BB-596B-A62E-B76974AD3457","وَأَعفي عَن قَومي وَلَو شِئتُ نَوَّلوا","إِذا ماتَشَكّى المُلحِفُ المُتَضارِعُ"],["9DF978A3-AD53-5E19-81E0-48973B83CFEC","مَخافَةَ أَن أَقلى إِذا شِئتُ سائِلاً","وَتُرجِعَني نَحوَ الرِجالِ المَطامِعُ"],["87C621B4-4C25-599A-9896-4CA1BB88838C","فَأَسمَعَ مِنّا أَو أُشَرِّفَ مُنعِماً","وَكُلُّ مُصادي نِعمَةٍ مُتَواضِعُ"],["E953101E-D73F-5BE9-84CC-90C56CB296FD","وَأُعرِضُ عَن أَشياءَ لَو شِئتُ نِلتُها","حَياءً إِذا ماكانَ فيها مَقاذِعُ"],["CBDFCA6F-DECC-559D-990F-D8B6B7A16271","وَلا أَدفَعُ اِبنَ العَمِّ يَمشي عَلى شَفا","وَلَو بَلَغَتني مِن أَذاهُ الجَنادِعُ"],["8A491CD1-5421-5C0D-8A18-86ECC9CE3887","وَلَكِن أُواسيهِ وَأَنسى ذُنوبَهُ","لِتُرجِعَهُ يَوماً إِلَيَّ الرَواجِعُ"],["71BE2F56-5717-5837-8EE5-97560891D800","وَأُفرِشُهُ مالي وَأَحفَظُ عَيبَهُ","لِيَسمَعَ إِنّي لاأُجازِهِ سامِعُ"],["0CFB4EC3-A195-5F7D-AA67-EFE5DC729CA2","وَحَسبُكَ مِن جَهلٍ وَسورِ صَنيعَةٍ","مُعاداةَ ذي القُربى وَإِن قيلَ قاطِعُ"],["EE429027-9CF5-50FB-91BA-62D7806514D9","فَأَسلِم عَناكَ الأَهلَ تَسلَم صُدورُهُم","وَلا بُدَّ يَوماً أَن يَروعَكَ رايِعُ"],["B9048E8A-0A8D-547B-B8F2-4207D53635CD","فَتَبلوهُ ما سَلَّفتَ حَتّى يَرُدَّهُ","إِلَيكَ الجَوازي وافِراً وَالصَنايِعُ"],["2E63D0BE-9867-5D72-A816-EA5627195812","فَإِن تُبلِ عَفواً يُعفَ عَنكَ وَإِن تَكُن","تُقارِعُ بِالأُخرى تُصِبكَ القَوارِعُ"],["70B488A1-FDB4-5E66-852C-2953F18BF224","وَلا تَبتَدِع حَرباً تُطيقُ اِجتِنابَها","فَيَلحَمَكَ الناسَ الحُروبُ البَدايِعُ"],["9CE1CF4A-ABCE-5E67-B060-EF351798E435","لَعَمري لِنِعمَ الحَيُّ إِن كُنتَ مادِحاً","هُمُ الأَزدُ إِنَّ القَولَ بِالصِدقِ شايِعُ"],["6A19ED1F-B295-58BC-A783-79A797009502","كِرامٌ مَساعيهِم جِسامٌ سَماعُهُم","إِذا أَلغَتِ الناسُ الأُمورُ الشَرايِعُ"],["CBF744A4-9DDA-54EE-B52C-EBABA996F951","لَنا الغُرَفُ العُليا مِنَ المَجدِ وَالعُلى","ظَفِرنا بِها وَالناسُ بَعدُ تَوابِعُ"],["93AF172A-F824-5AC9-AD09-7B29697885C8","لَنا جَبَلا عِزٍّ قَديمٌ بَناهُما","تَليعانِ لا يَألوهُما مَن يُتالِعُ"],["EC52A6B4-B87C-53D9-A9BD-B26E5431C0BA","فَكَم وافِدٍ مِنا شَريفٌ مَقامَهُ","وَكَم حافِظٍ لِلقِرنِ وَالقِرنُ وادِعُ"],["7AB9C4FE-D175-5B8B-95F6-55A5C013898A","وَمِن مُطعِمٍ يَومَ الصَبا غَيرَ جامِدٍ","إِذا شَصَّ عَن أَبنائِهِنَّ المَراضِعُ"],["5D592121-6D3A-5D41-816D-1EC9141A3033","يُشَرِّفُ أَقواماً سِوانا ثِيابُنا","وَتَبقى لَهُم أَن يَلبَسوها سَمايِعُ"],["D58B95D4-8C54-5CE8-BFC1-24B1E36C186B","إِذا نَحنُ ذارَعنا إِلى المَجدِ وَالعُلى","قَبيلاً فَما يَسطيعُنا مَن يُذارِعُ"],["EF12E879-8179-5CE6-9934-0C2C7843241F","وَمِنّا بَنو ماءِ السَماءِ وَمُنذِرٌ","وَجَفنَةُ مِنّا وَالقُرومُ النَزايِعُ"],["0EBB0187-938A-5C0E-A3DC-6001737FBD9B","قَبائِلُ مِن غَسّانَ تَسمو بِعامِرٍ","إِذا اِنتَسَبَت وَالأُزدُ بَعدُ الجَوامِعُ"],["17E47F66-E8DF-57AC-9BCA-2509AE358683","أَدانَ لَنا النُعمانُ قَيساً وَخِندَقاً","أَدانَ وَلَم يَمنَع رَبيعَةَ مانِعُ"]]},"3D07C800-EA64-5293-A874-E7E3E7DD5057":{"t":"أَلا يا قيس لا تسمن درعي","p":8,"s":"ألا يا قيس لا تسمن درعي","r":"437379","v":[["E04221F3-CED0-5917-A635-F231D9C090E0","أَلا يا قَيسُ لا تَسِمنَ دِرعي","فَما مِثلي يُساوِمُ بَالدُروعِ"],["F2AEA26F-1E97-54A4-BBE7-3C80CC4C5A59","فَلَولا خَلَّةٍ لِأَبي جَوَىًّ","وَأَنّي لَستُ عَنها بِالنَزوعِ"],["2DD3A7F6-276F-5363-8F72-B971FB297C2E","لَأَبَت بِمِثلِها عَشرٌ وَطِرفٌ","لَحوقُ الأَطلِ جَيّاشُ تَليعِ"],["4422793C-BE5D-5C01-92F8-455DBBE1126E","وَلَكِن سَمِّ ما أَحبَبتَ فيها","فَلَيسَ بِمُنكِرٍ غِبنَ البُيوعِ"],["125CDECB-D60B-5011-8817-FD1C66C149CD","فَما هِبَةُ الدُروعِ أَخا بَغيضٍ","وَلا الخَيلُ السَوابِقِ بِالبَديعِ"]]},"7E992E25-32A8-5592-A19C-EB7AC6A71B99":{"t":"إِذا جمادى منعت قطرها","p":8,"s":"إذا جمادى منعت قطرها","r":"437383","v":[["DECD388B-0AC0-5150-BF7B-92CF0264A384","إِذا جَمادى مَنَعَت قِطرَها","زانَ جَناني عَطنٌ مُغضَفِ"],["8E75FBD6-230F-516F-8898-D1BE28E8F1A1","مُعرَورِفٌ أَسبَلَ جُبَّارَهُ","أَسوَدُ كَالغابَةِ مُغدَودِفِ"],["FCC17B1A-EC29-5FBA-8586-E1EA265F251E","يَزخَرُ في أَقطارِهِ مُغدِقٌ","بِجَما فَتيِهِ الشوعَ وَالغِريَفِ"]]},"380B3AE3-6E7A-59E1-BC65-F627D6CA1412":{"t":"إِذا ما جئتها قد بعت عذقاً","p":8,"s":"إذا ما جئتها قد بعت عذقا","r":"437387","v":[["16092883-AF75-5FF8-B732-85FA7091BB1A","إِذا ما جِئتُها قَد بِعتُ عِذقاً","تُعانِقُ أَو تُقَبِّلُ أَو تَفدّى"],["00F9485F-2227-5DEA-82D9-0763C2CE5ED5","أَهَنتُ المالَ في الشَهَواتِ حَتّى","أَصارَتني أَسيَفاً عَبدَ عَبدِ"],["11101615-9AC3-5ADE-A252-78B15D60C55B","فَمَن نالَ الغِنى فَليَصطَنِعهُ","صَنيعَتَهُ وَيَجهَدَ كُلَّ جُهدِ"],["B15DD0B8-5183-5B4B-897C-6845C4866741","أُعلِمُكُم وَقَد أَردَيتُ نَفسي","فَمَن أَهدى سَبيلَ الرُشدِ بَعدي"]]},"4DBEABC6-FA0B-5A43-81AB-928C6DDF414B":{"t":"إِن ترد حربي تلاق فتى","p":8,"s":"إن ترد حربي تلاق فتى","r":"437395","v":[["B7667E58-969B-5226-BCB7-E8DE5630892D","إِن تُرد حَربي تُلاقِ فَتىً","غَيرَ مَملوكٍ وَلا بِرمَه"],["168D3D6B-9F71-5D45-8F41-99E5265C6F84","قَسَماً ما غَيرَ ذي الذَبِّ","أَن نُبيحَ الخَدنَ وَالحُرمَه"]]},"0F1066BD-745C-5713-993B-EE91F41C6A47":{"t":"اِستغن أَو مت ولا يغررك ذو نشب","p":8,"s":"استغن أو مت ولا يغررك ذو نشب","r":"437389","v":[["C12949AF-6217-5C50-95A8-9A973A78AE78","اِستَغنِ أَو مُت وَلا يَغرُركَ ذو نَشَبٍ","مِن اِبنِ عَمٍّ وَلا عَمٍّ وَلا خالِ"],["515CD8BA-897C-53FB-90D0-E0412028D49F","يَلوونَ ما لَهُم عَن حَقِّ أَقرَبِهِم","وَعَن عَشيرَتِهِم وَالحَقُّ لِلوالي"],["3D8CBCA6-3A5B-5838-A3C1-791772E5FA88","فَاِجمَع وَلا تَحقِرَنَّ شَيئاً تَجَمِّعُهُ","وَلا تُضَيعَّنَهُ يَوماً عَلى حالِ"],["F8B5DF38-DB86-5C7F-895A-7B9F09B40F64","إِنّي أُقيمُ عَلى الزَوراءِ أَعمُرُها","إن الكَريمَ عَلى الإِخوانِ ذو المالِ"],["C2C95AEF-887C-532E-A7E7-5CC93ADF0100","لَها ثَلاثُ بِئارٍ في جَوانِبِها","في كُلِها عَقِبٌ تُسقى بِاِقبالِ"],["C745A6D8-A68B-570C-827C-9D853086ED12","كُلُّ النِداءِ إِذا ناديتُ يَخذِلُني","إِلاّ نِدائي إِذا نادَيتُ يا مالي"],["0AEFF3E2-01FE-5E18-9B77-38CA12C7C6B0","ما إِن أَقولُ لِشَيءٍ حينَ أَفعَلُهُ","لا أَستَطيعُ وَلا يَنبو عَلى حالِ"]]},"3465E64D-2003-5064-BF68-4AFDF0806449":{"t":"اِستغن عن كل ذي قربى وذي رحمٍ","p":8,"s":"استغن عن كل ذي قربى وذي رحم","r":"437377","v":[["4540FF1D-85DF-5767-8DE9-85D39F0882E2","اِستَغنِ عَن كُلِّ ذي قُربى وَذي رَحِمٍ","إِنَّ الغَنِيَّ مَن اِستَغنى عَنِ الناسِ"],["58C05563-C342-5C59-AE32-9AA4BAA4B85B","وَاِلبِس عَدوَّكَ في رِفقٍ وَفي دَعَه","لِباسَ ذي إِربَةٍ لِلدَّهرِ لَبّاسِ"],["B3106811-FA49-58EB-86AF-75A103BE7CAB","وَلا تَغُرَنَّكَ أَضغانُ مُزَمِّلِهِ","قَد يَضرِبُ الدُبرَ الدامي بِأَحلاسِ"]]},"37BF83CE-569E-5A25-90B8-6A63726E20E1":{"t":"به أَحمي المضاف إِذا دعاني","p":8,"s":"به أحمي المضاف إذا دعاني","r":"437374","v":[["ABC911C1-A691-5099-BF17-1E6A65F89625","بِهِ أَحمي المُضافَ إِذا دَعاني","إِذا ما قيلَ لِلأَبطالِ هَيتا"]]},"D8D40758-ADA6-5222-BF76-CB5BCD92194B":{"t":"تذر العناجيج الجياد بقفرة","p":8,"s":"تذر العناجيج الجياد بقفرة","r":"437394","v":[["9900C41F-AA1C-531A-A10A-C9EE68BF6EB0","تَذَرُ العَناجيجَ الجيادَ بِقَفرَةٍ","مَرَّ الدَموكِ بِمِحصَدٍ وَرِجامِ"]]},"5CB42737-9186-5AD6-A843-4A7734F7C8D5":{"t":"صحوت عن الصبا والدهر غول","p":8,"s":"صحوت عن الصبا والدهر غول","r":"437392","v":[["E883A966-BB61-5207-8DF5-5A332089F8D0","صَحَوتُ عَنِ الصِبا وَالدَهرُ غولُ","وَنَفسُ المَرءِ آمِنَةٌ قَتولُ"],["A7F507EC-0A78-5641-BC46-DFFCA62BBFF9","وَلَو أَنّي أَشاءُ نَعِمتُ حالاً","وَباكَرَني صَبوحٌ أَو نَشيلُ"],["C402EBF5-791E-5A9C-AB43-2B28A6244546","وَلاعَبَني عَلى الأَنماطِ لُعسٌ","عَلى أَفواهِهِنَّ الزَنجَبيلُ"],["FCDEBF19-4D43-5FC1-9679-AF80226104C2","وَلَكِنّي جَعَلتُ إِزاءَ مالي","فأَقلل بعد ذلك أَو أَنيل"],["FEC5B072-5BBD-57DD-BC60-D4745B43F100","فَهَل مِن كاهِنٍ أَو ذي إِلَهٍ","إِذا ما حانَ مِن رَبٍّ أُفولُ"],["DC3B9859-1C99-5ED7-9D67-81152E5B5AD8","يُراهِنُني فَيُرهِنُني بَنيهِ","وَأُرهِنُهُ بَنِيَّ بِما أَقولُ"],["08895C6A-C90F-5D2D-8EDF-EFDDA1C631EF","وَما يَدري الفَقيرُ مَتى غِناهُ","وَما يَدري الغَنِيُّ مَتى يُعيلُ"],["5F68E156-5123-584A-9C51-D0FDDA43A4E7","وَما تَدري وَإِن أَلقَحتَ شَولاً","أَتُلقَحُ بَعدَ ذَلِكَ أَم تَحيلُ"],["6AA687E9-BBAB-52D5-B330-6D3F8D4A16BA","وَما تَدري إِذا ذَمَّرتَ سَقباً","لِغَيرِكَ أَم يَكونُ لَكَ الفَصيلُ"],["5EF78D70-8B99-51D7-BE53-CA162524C97D","وَما تَدري وَإِن أَجمَعتَ أَمراً","بِأَيِّ الأَرضِ يُدرِكُكَ المَقيلُ"],["B8845E3F-A5E7-546D-8B6F-E012027DD56A","لَعَمرُ أَبيكَ ما يُغني مَقامي","مِنَ الفِتيانِ أَنجيهِ حُفولُ"],["C9D68DCC-1DE8-5DEB-B2FD-A96D77F57D09","يَرومُ وَلا يُعَلِّصُ مُشمَعِلّاً","عَنِ العَوراءِ مَضجَعُهُ ثَقيلُ"],["22B86113-CCA7-55F6-BF83-968AF2A9EECA","تَبوعٌ لِلحَليلَةِ حَيثُ كانَت","كَما يَعتادُ لَقحَتَهُ الفَصيلُ"],["4362DE74-8484-5DD6-AC40-57399BC353AD","إِذا ما بِتُّ أَعصِبُها فَباتَت","عَلَيَّ مَكانَها الحُمّى النَسولُ"],["51BCF504-A764-5895-83CC-E0A813DF15DC","لَعَلَّ عُصابَها يَبغيكَ حَرباً","وَيأَتيهِم بِعَورَتِكََ الدَليلُ"],["1A83A02A-C065-5612-8A5A-1224AD89512C","وَقَد أَعدَدتُ لِلحَدَثانِ حِصناً","لَوَ اَنَّ المَرءَ تَنفَعُهُ العُقولُ"],["38EA2A9D-F0C3-56FE-A7F1-AC3989A18F02","طَويلَ الرَأسِ أَبيَضَ مُشمَخِرّاً","يَلوحُ كَأَنَّهُ سَيفٌ صَقيلُ"],["5E647C9F-0491-522F-8959-CF8CC89F9B2C","جَلاهُ القَينُ ثَمَّتَ لَم يَشِنهُ","بناحية وَلا فِيهِ فلول"],["8ECE1EFB-EE16-553F-98FF-B04FAFB07A5A","هُنالِكَ لا يُشاكِلُني لَئيمٌ","لَهُ حَسَبٌ أَلَفُّ وَلا دَخيلُ"],["32638EBF-56FD-5F86-8BFB-648D1093006E","وَقَد عَلِمَت بَنو عَمرٍو بِأَنّي","مِنَ السَرَواتِ أَعدَلُ ما يَميلُ"],["B09909CD-7DE8-5ED0-B27C-5B3146253B9D","وَما مِن أُخوَةٍ كَثُروا وَطابوا","بِناشِئَةٍ لِأَمَّهَمُ الهَبولُ"],["ABD6AC14-5779-5970-928D-70D49B11001C","سَتُشكِلُ أَو يُفارِقُها بِنَوَها","سَريعاً أَو يَهِمُّ بِهِم قَبيلُ"],["2EC39DD9-74E9-5BF0-A1F7-DFC9331B3509","تَفَهَّم أَيُّها الرَجُلُ الجَهولُ","وَلا يَذهَب بِكَ الرَأيُ الوَبيلُ"],["20BB9493-848D-5927-94D6-A9231B7732CA","فَإِنّ الجَهلَ مَحمِلُهُ خَفيفٌ","وَإِنَّ الحِلمَ مَحمِلُهُ ثَقيلُ"]]},"25D3D33C-9EAD-5537-9537-2CDF834A5903":{"t":"قالت ولم تقصد لقول الخنا","p":8,"s":"قالت ولم تقصد لقول الخنا","r":"437378","v":[["DC98DEA4-49E9-59B5-BEC0-1A3F9223E594","قالَت وَلَم تَقصِد لِقَولِ الخَنا","مَهلاً فَقَد أَبلَغتَ أَسماعِ"],["EEEE3985-21BC-5955-B981-7E6FFC4E6760","أَنكَرتُهُ حَتّى تَوَسَّمتُهُ","وَالحَربُ غولٌ ذاتُ أَوجاعِ"],["F8A310F9-BFF1-5688-9529-229A631A00C8","مَن يَذُقِ الحَربَ يَجِد طَعمَها","مُرّاً وَتَحبِسهُ بِجَعجاعِ"],["DFA6730C-EB04-59D4-9122-9C1907036E13","قَد حَصَّتِ البَيضَتُ رَأسي فَما","أَطعَمُ نَوماً غَيرَ تَهجاعِ"],["8D090255-74F3-58A1-917D-9A1B89DC07D2","أَسعى عَلى جُلِّ بَني مالِكٍ","كُلُّ اِمرِئٍ في شَأنِهِ ساعِ"],["785F39D3-E823-57E0-B68E-6342EC310112","بَينَ يَدَي فَضفاضَةٍ فَخمَةٍ","ذاتَ عَرانَينَ وَدَفّاعِ"],["06B4B120-F4BC-5D61-BD17-E969A89BB518","أَعدَدتُ لِلهَيجاءِ موضونَةً","مُتَرَصَّةً كَالنَهيِ بِالقاعِ"],["EDDD5E52-9CF7-5D02-B595-F5D67B98CF19","أَخفُرُها عَنّي بِذي رَونَقٍ","أَبيَضَ مِثلَ المِلحِ قَطّاعِ"],["CE7AA731-F0C2-5201-B582-5440149C86CB","صَدقٍ حُسامٍ وادِقٌ حَدُّهُ","وَمَجنَإٍ أَسمَرَ فَزّاعِ"],["63D283A3-3903-5001-86A2-C038BCD2CE6A","لا نَألَمُ القَتلَ وَنَجزي بِهِ ال","أَعداءَ كَيلَ الصاعِ بِالصاعِ"],["99FC8F82-68E5-5E1D-AAD7-168919C04A90","كَأَنَّنا أُسدٌ لَدى أَشبُلٍ","يَنهَتنَ في غَيلٍ وَأَجزاعِ"],["5CEFFCBD-289C-5F7B-AFF1-7CC2AC093F60","ثُمَّ اِلتَقَينا وَلَنا غابَةٌ","مِن بَينِ جَمعٍ غَيرِ جُمّاعِ"],["BE33AE5F-162F-51D4-B4D0-E57975BD2C80","وَالكَيسُ وَالقُوَّةُ خَيرٌ مِنَ ال","إِشفاقِ وَالفَكَّةِ وَالهاعِ"],["BF04B41C-A785-547E-B850-D625D3A63304","لَيسَ قَطا مِثلَ قُطَيٍّ وَلا ال","مَرعِيُّ في الأَقوامِ كَالراعي"],["C61CA06F-96B3-5F47-B537-B5DDCBF6B4E3","فَسائِلِ الأَحلافَ إِذ قَلَّصَت","ما كانَ إِبطائي وَإِسراعي"],["5A75AF34-4EEA-52BD-B64F-CEA24107A453","هَل أَبذُلُ المالَ عَلى حُبِّهِ","فيكُم وَآتي دَعوَةَ الداعي"],["60D66AD6-1ACC-589F-9718-EC09AB10F16D","وَأَضرِبُ القَونَسَ بِالسَيفِ في ال","هَيجاءِ لَم يَقصُر بِهي باعي"],["45EB8816-EB9E-5B2B-9A65-BC53F0AD90BD","فَتِلكَ أَفعالي وَقَد أَقطَعُ ال","خَرقَ عَلى أَدماءِ هِلواعِ"],["AD1AF626-4D1F-5486-8B25-EE95FDC7760B","ذاتِ شَقائِقٍ جَماليَّةٍ","زينَت بِحَيريٍّ وَأَقطاعِ"],["7535A8B0-248E-5BF1-8CDB-717DAA78E71C","تَمطو عَلى الزَجرِ وَتَنجو مِنَ ال","سَوطِ أَمونٌ غَيرُ مِظلاعِ"],["AC933165-B351-5421-AB59-446B56BACAF8","أَفضي بِها الحاجاتِ إِنَّ الفَتى","رَهنٌ لِذي لَونَينِ خَدّاعِ"]]},"29711B23-1C32-5BE3-BFC3-9B90CF751EBC":{"t":"قد كنت أَغنى الناس شخصاً واحداً","p":8,"s":"قد كنت أغنى الناس شخصا واحدا","r":"437393","v":[["A34FD9EE-54C0-5237-B7F1-92189D71A215","قَد كُنتُ أَغنى الناسِ شَخصاً واحِداً","سَكَنَ المَدينَةَ عَن زِراعَةِ قَومِ"]]},"957A9921-844D-575C-95B9-6BF9DEC840E0":{"t":"لم أَر مثل الأقوام في غبن ال","p":8,"s":"لم أر مثل الأقوام في غبن ال","r":"437371","v":[["B3068023-1E66-571B-9BD0-7F719E961FBE","لَم أَرَ مِثلَ الأَقوامِ في غَبَنِ ال","أَيّامِ يَنسونَ ما عَواقِبُها"],["CAAD7791-44E7-51A3-9D51-1EA0658F37F3","يَرَونَ إِخوانَهُم وَمَصرَعَهُم","وَكَيفَ تَعتاقُهُم مَخالِبُها"],["ECB10E7B-AB35-588A-A90B-ACEE5AB405C0","فَما تُرَجّي النُفوسُ مِن طَلَبِ ال","خَيرِ وَحُبُّ الحَياةِ كاذِبُها"]]},"6147C91A-828B-5F3A-AC63-23C680D556CC":{"t":"ليت حظي من أبي كرب","p":8,"s":"ليت حظي من أبي كرب","r":"437390","v":[["6162C8AD-1C1F-5D98-988E-C5F7719A9AA8","لَيتَ حَظي مِن أَبي كَربٍ","أَن يَرِدَّ خَيرَهُ خَبلُهُ"]]},"A9E762D8-E0D5-51B2-81E0-046756DDF890":{"t":"مهلاً بني عمنا فإِنكم","p":8,"s":"مهلا بني عمنا فإنكم","r":"437375","v":[["5173AEB2-C0A8-54FE-8D97-D1266239EEC6","مَهلاً بَني عَمِّنا فَإِنَّكُم","أَجَرتُم في الضَلالِ فَاِقتَصِروا"],["632A9152-5126-5686-A1D6-E800B634F631","نَحنُ المَراجيعُ في مَجالِسِنا","قِدماً وَنَحنُ المَصالِتُ الصُبرُ"],["E25B9DD7-2054-5736-8D5E-3506F68C86B3","الضارِبو الكَبشَ في قَوانِسِهِ","وَحَولَهُ في الكَتيبَةِ الوَزَرُ"],["0DA1B340-0025-5F0C-A121-5091BB12FBFA","وَالمُطعِمونَ الشَحمَ في الجِفانِ إِذا","هَبَّت رِياحُ الشِتاءِ وَالفَزَرُ"],["8AB7D895-979E-5271-8590-3B710619D138","إِنّي وَالمِشعَرُ الحَرامُ وَما","حَجَّت قُرَيشُ لَهُ وَما نَحَروا"],["B40FA45E-B684-5BBC-AAB2-11EDFAB64B04","لا آخُذُ الخُطَّةَ الدَنيَةَ ما","دامَ يُرى مِن تَضارُعٍ حِجرُ"]]},"19F43BC3-D0F9-5DAE-92BC-E54D8549D32E":{"t":"نُبئت أَنك جئت تس","p":8,"s":"نبئت أنك جئت تس","r":"437397","v":[["7737FAFA-CD4B-5921-ACFC-E423706A9CF2","نُبِّئتُ أَنَّكَ جِئتَ تَس","ري بَينَ داري وَالقِبابَه"],["3856E5AE-8815-5D17-84B9-9ED030CA7184","فَلَقَد وَجَدتُ بِجانِبِ الضُح","يانِ شُبّانا مَهابَه"],["34A0C94D-E310-5F3E-A158-9021488D7356","فِتيانُ حَربٍ في الحَدي","دِ وَشامِرينَ كَأُسدِ غابَه"],["BCCDC57E-8949-5E79-99C2-6CD3B207D395","هُم نَكَّبوكَ عَنِ الطَري","قِ فَبِتَّ تَركَبُ كُلَّ لابَه"],["01240E4C-6A6F-5B78-9894-28F1C0AA83BB","أَعَصيَمَ لا تَجزَع فَإِنَّ ال","حَربَ لَيسَت بِالدُعابَه"],["857D14DD-9A7E-59D3-9755-58429CDDC0E9","فَأَنا الَّذي صَبَّحتُكُم","بِالقَومِ إِذ دَخَلوا الرَحابَه"],["DF8FC88D-85BC-5E25-B513-1868D83ECACB","وَقَتَلتُ كَعباً قَبلَها","وَعَلَوتُ بِالسَيفِ الذُؤابَه"],["958CA7E6-C923-59CB-9EA2-283BF4ED2FB2","أَقسَمتُ لا أُعطيكَ في","كَعبٍ وَمَقتَلِهِ سيابَه"]]},"87B3D074-DC00-57F5-A3B9-1DAC09B9FAF4":{"t":"والصمت خير للفتى","p":8,"s":"والصمت خير للفتى","r":"437399","v":[["DBC396D0-A72D-5087-B626-4E088F1A71DB","وَالصَمتُ خَيرٌ لِلفَتى","ما لَم يَكُن رَعِيٌّ يَشينُهُ"],["D27DAAFD-92FF-5F9C-AEE9-B89B4FE62AE8","وَالقَولُ ذو خَطلٍ إِذا","ما لَم يَكُن لُبٌّ يُعينُهُ"]]},"93F9F6EC-BA0D-5252-8E56-F1E23B3269B9":{"t":"والمرء قد يرجو الرحا","p":8,"s":"والمرء قد يرجو الرحا","r":"437396","v":[["94D4E61B-C8BF-529E-A3C1-EC8D2FDB58A7","وَالمَرءُ قَد يَرجو الرَحا","ءَ مُغَيِّبا وَالمَوتُ دونَهُ"]]},"B1E4E3D3-4F91-5E4A-A4ED-9B8961D42964":{"t":"وذي ضغنٍ كففت النفس عنه","p":8,"s":"وذي ضغن كففت النفس عنه","r":"437372","v":[["5E6154E0-4DAC-57AE-8086-06F4FE2589BE","وّذي ضِغنٍ كَفَفتُ النَفسَ عَنهُ","وَكُنتُ عَلى مَساءَتِهِ أُقيتُ"]]},"CBDA592B-C626-5E10-8E2A-464D8A6A3846":{"t":"وقد لاح في الصبح الثريا لمن يرى","p":8,"s":"وقد لاح في الصبح الثريا لمن يرى","r":"437376","v":[["481A0E1A-1C4C-5F1B-9662-0A641C309DBB","وَقَد لاحَ في الصُبحِ الثُرَيّا لِمَن يَرى","كَعُنقودِ مُلّاحِيَّةِ حينَ نَوَّرا"]]},"E6B370B5-C5FE-501E-A7EB-893C7ECA6600":{"t":"وكريمٍ نال الكرامة منا","p":8,"s":"وكريم نال الكرامة منا","r":"437402","v":[["D59D1054-048F-5457-A391-CA48B78F66E8","وَكَريمٍ نالَ الكَرامِةِ مِنّا","وَلَئيمٍ ذي نَخوَةٍ قَد أَهَنّا"],["94FD0BD6-A709-5442-B8D3-22966D63F8C3","ثُمَّ لَم يَرجِعِ الكَلامُ إِلَينا","لَو تَرى في الكَلامِ أِن قَد أَذِنّا"]]},"B78FBAE2-7218-5595-A9D1-F010460E6DAA":{"t":"يا بنِي التخوم لا تظلموها","p":8,"s":"يا بني التخوم لا تظلموها","r":"437391","v":[["A49D89F6-07D2-566F-BB23-85670EFB2E71","يا بَنِيَّ التُخومَ لا تَظلِموها","إِنَّ ظُلمَ التُخومِ ذو عِقالِ"]]},"6175B5F3-E8FC-55C0-A921-6545E8A4F676":{"t":"يا مال لا تلتمس ظلامتنا","p":8,"s":"يا مال لا تلتمس ظلامتنا","r":"437386","v":[["AE4FA063-80DA-5BAC-9221-2ACE697A23DE","يا مالَ لا تَلتَمِس ظُلامَتَنا","فَإِنَّنا مالِ مَعشَرٍ أُنُفُ"],["452FD474-BCEF-5C68-90B7-30D69C0F1D20","إِنَّ كُعَيباً عَبدٌ لِغَيرِكُم","وَالحَقُّ فيهِ لِأَمرِكُم نَصَفُ"],["EF6F995F-73DD-52E4-9457-275BF61FF2D5","قَد سَلَكوا في سَبيلِهِ وَضَحَ ال","قَصدِ وَفيكُم غَيرُ قَصدِهِ جَنَفُ"]]},"57CC74DC-433E-5165-9317-D4CB27378F1C":{"t":"يا مال والسيد المعمم قد","p":8,"s":"يا مال والسيد المعمم قد","r":"437380","v":[["EBB48598-AD90-59E5-A756-BFC377D5E3DE","يا مالُ وَالسَيِّدُ المُعَمَّمُ قَد","يُبطِرُهُ بَعضُ رَأيِهِ السَرِفُ"],["462723C1-0D9C-5308-81FD-5B6EBE5E588E","خالَفتَ في الرَأيِ كُلَّ ذي فَخَرٍ","وَالحَقُّ يا مالُ غَيرُ ما تَصِفُ"],["B3E345DF-A032-5D61-B790-FBEFFC322233","لا يَرفَعُ العَبدُ فَوقَ سُنَّتِهِ","وَالحَقُّ يوفى بِهِ وَيُعتَرَفُ"],["12D30C29-BD34-5F31-A482-15EBB73CF905","إِنَّ بُحَيراً عَبدٌ لِغَيرِكُمُ","يا مالُ وَالحَقُّ عِندَهُ فَقِفوا"],["9A8E2657-AFDE-5681-B1BD-0D30DA6553A9","أوتيتُ فيهِ الوَفاءَ مُعتَرِفاً","بِالحَقِّ فيهِ لَكُم فَلاتَكِفوا"],["DD52AEB2-3AC7-5C93-98D1-D17CFBD84C69","نَحنُ بِما عِندِنا وَأَنتَ بِما","عِندَكَ راضٍ وَالرَأيُ مُختَلِفُ"],["6857DB88-BDCA-51BD-B9E1-BA96EAEE00C9","نَحنُ المَكيثونَ حَيثُ يَحمَدُنا ال","مُكثُ وَنَحنُ المَصالِتُ الأُنُفُ"],["0C6E0573-747B-593C-A111-B925BAE3F780","وَالحافِظو عَورَةِ العَشيرَةِ لا","يَأتيهُمُ مِن وَرائِهِم وَكَفُ"],["01480E41-3BE5-5110-8B30-C6F34F1B6F81","وَاللَهُ لا يَزدَهي كَتيبَتَنا","أُسدُ عَرينٍ مَقيلُها غُرَفُ"],["A9EB555E-F8CF-506E-8C93-7BBE015A7DC7","إِذا مَشَينا في الفارِسِيِّ كَما","تَمشي جِمالٌ مَصاعِبٌ قُطُفُ"],["0C9F927E-87D9-5A77-B87C-05864916BAEC","نَمشي إِلى المَوتِ مِن حَفائِظِنا","مَشياً ذَريعاً وَهُكمُنا نَصَفُ"],["06C0321C-7706-5175-AADD-AF5AE62CB604","إِنَّ سَميراً أَبَت عَشيرَتُهُ","أَن يَعرِفوا فَوقَ مابِهِ نَطِفوا"],["0A5C5E08-E5A3-534A-8C54-3837EFE70E4D","أَو تَصدُرِ الخَيلُ وَهيَ حامِلَةٌ","تَحتَ صُواها جَماجِمٌ جُفُفُ"],["CCFA5206-ED75-5C47-AB65-A627CFABEEED","أَو تَجرَعوا الغَيظَ مابَدا لَكُمُ","فَهارِشوا الحَربَ حَيثُ تَنصَرِفُ"],["FB0F54AC-7B7C-56BD-992F-9F30D0B7B175","إِنّي لَأُنمى إِذا اِنتَمَيتُ إِلى","غُرٍّ كِرامٍ وَقَومُنا شَرَفُ"],["579BE7FE-728D-5979-8BB2-B10FF11F27AB","بيضٌ جِعادٌ كَأَنَّ أَعيُنَهُم","يُكحِلُها في المَلاحِمِ السَدَفُ"]]},"C0538824-4FF8-5D8D-8474-A9F686EA066D":{"t":"يشتاق قلبي إِلى مليكة لو","p":8,"s":"يشتاق قلبي إلى مليكة لو","r":"437400","v":[["1CE964F8-68F0-5361-B0D1-D512B986C4F8","يَشتاقُ قَلبي إِلى مَليكَةٍ لَو","أَمسَت قَريباً مِمَّن يُطالِبُها"],["04CBD6B4-DD7F-5870-B627-2208D603D21A","ما أَحسَنَ الجيدِ مِن مَليكَةٍ وَال","لَبّاتِ إِذ زانَها تَرائِبُها"],["CEA3396B-E981-5D6A-8A6E-FF862457FDC4","يا لَيتَني لَيلَةً إِذا هَجعَ النّا","سُ وَنامَ الكِلابَ صاحِبُها"],["ACAC650D-ABC2-5C9F-BC9A-1A339E3F6B74","في لَيلَةٍ لا يُرى بِها أَحَدٌ","يَسعى عَلَينا إِلاّ كَواكِبُها"],["32DAAC6C-F9A5-5CBB-B325-DA68AD517642","لِتَبكِني قَينَةٌ وَمَزهَرُها","وَلتَبكِني قَهوَةٌ وَشارِبُها"],["A13FCABA-9B39-5EA7-BD00-977910CB9006","وَلتَبكِني ناقَةٌ إِذا رَحَلَت","وَغابَ في سَردَحٍ مَناكِبُها"],["8278A7AA-195A-5BA0-BBC1-2786EF73ED76","وَلتَبكِني عُصبَةٌ إِذا إِجتَمَعَت","لَم يَعلَمِ الناسُ ما عَواقِبُها"],["3C92CF0C-87DD-5083-BDB9-246946732CBD","فَما تُرَجّي النُفوسُ مِن طَلَبِ ال","خَيرِ وَحُبُّ الحَياةِ كاذِبُها"]]},"692191CA-7110-5552-821A-E97FF875140B":{"t":"يلومونني في اِشتراء النخي","p":8,"s":"يلومونني في اشتراء النخي","r":"437398","v":[["FA65360D-1087-5406-A45E-2ED0208A2D1F","يَلومونَني في اِشتِراءِ النَخي","لِ قَومي فَكُلُّهُمُ يَعذِلُ"],["4460053F-0035-5333-AFDF-AEDBDC14B82B","وَأَهلُ الَّذي باعَ يَلحَونَهُ","كَما عُذِلَ البائِعُ الأَولُ"],["B6E880AD-AF41-5E6D-AB80-BD03A86D724E","هِيَ الظِلُّ في الحَرِّ حَقُّ الظَلي","لِ وَالمَنظَرُ الأَحسَنُ الأَجمَلُ"],["20A0819F-323A-5F61-8865-F6F06D386172","تَعَشّى أَسافِلُها بِالجَبوبِ","وَتَأتي حَلوبَتَها مِن عَلُ"],["CEB37E4E-0C72-5431-8C00-D7F7D7BB3B44","وَتُصبِحُ حَيثُ يَبيتُ الرِعاءُ","وَإِن ضَيَّعوها وَإِن أَهمَلوا"],["EA909E56-B0B8-505D-AEAD-F3BB47CF55C5","وَلا يُصبِحونَ يُبَغّونَها","خِلالَ المَلا كُلُّهُمُ يَسأَلُ"],["9DEA0CF4-BBB2-5E91-A693-3AC9448AAA7C","فَعَمٌّ لِعَمِّكُمُ نافِعٌ","وَطِفلٌ لِطِفلِكُمُ يُؤمَلُ"]]}}}