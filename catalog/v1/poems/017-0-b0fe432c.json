{"v":1,"poems":{"B84A21B4-61EA-520D-BC49-910E1AD2AED2":{"t":"أرى عبدَ عمروٍ قد أساطَ ابنَ عمهِ","p":17,"s":"أرى عبد عمرو قد أساط ابن عمه","r":"436175","v":[["F7E5DF71-BD27-518D-B58E-1B266F9DAEA2","أرى عبدَ عمروٍ قد أساطَ ابنَ عمهِ","و أنضجهُ في غليِ قدرٍ وما يدري"],["DC2440D0-F11E-5BAA-87E9-0519EBBA4708","فَهْلاّ ابن حَسْحَاس قَتَلْتَ ومَعْبَداً","هما تركاكَ لا تريشُ ولا تبري"],["1B9F61FF-4DE1-55B7-9A71-2C527406BA14","هما طعنا مولاكَ في خرجِ دبرهِ","و أقبلتَ ما تلوي على محجرٍ تجري"]]},"2B247BE7-FEEB-53E4-931B-4E42B009BE40":{"t":"أعاذلتي على رزءٍ أفيقي","p":17,"s":"أعاذلتي على رزء أفيقي","r":"436166","v":[["A1A3DDD3-28E4-515C-9E2A-D6393B9E026E","أعاذلتي على رزءٍ أفيقي","فقد أشرفتني بِالعَذلِ ريقي"],["EBAA5AE6-9695-50B3-8CE4-7169CD41B4B2","ألا أقسْمتُ آسى بعد بِشرٍ","على حيًّ يموتُ ولا صديقِ"],["519F543D-97F6-5ADA-95FB-D4B4898A4BA1","و يعدَ الخيرِ علقمةَ بنِ بشرٍ","إذا نزتِ النفوسُ إلى الحلوقِ"],["B05657ED-A8BB-5ABA-B34B-0F717AB1B343","وبَعْدَ بني ضُبيعة حَوْلَ بِشرٍ","كما مَالَ الجذوعُ من الحريقِ"],["21634830-4C2C-507F-838D-6C2B40B7D28E","مَنَتْ لهمُ بوالبة المنايا","بجنبِ قلابَ للحينِ المسوقِ"],["5105DDB2-8651-55E6-BA9D-2EA171F01405","فكمْ بقلابَ من أوصالِ خرقٍ","أخي ثقةٍ وجُمْجُمةٍ فَلِيقِ"],["B0B22C15-971A-5D31-8901-C8CB9D05EB48","ندامى للملوكِ إذا لقوهمْ","حُبُوا وسقوا بِكأسِهمُ الرحيق"],["76207B97-A091-5189-A4BA-B7146F5575F2","همُ جدعوا الأنوفَ وأوعبوها","فما ينساغُ لي من بعدُ ريقي"],["00BBA6D0-97E1-53CF-9D7F-8FB37F5287B4","و بيضٍ قد قعدنَ وكلُّ كحلٍ","بأعينهنَّ أصبحَ لا يليقُ"],["C9F70653-0BD5-55EB-B75D-44AD94020359","أضاع بضوعَهن مُصابُ بشرٍ","و طعنةُ فاتكٍ، فمتى تفيقُ؟."]]},"A98B7AA9-F354-58C9-A349-1087D28863C6":{"t":"ألا ذَهَبَ الحَلاَّلُ في القَفَرَاتِ","p":17,"s":"ألا ذهب الحلال في القفرات","r":"436170","v":[["8E832C6E-4ADF-51A6-A323-7C7D19A2B8B9","ألا ذَهَبَ الحَلاَّلُ في القَفَرَاتِ","و من يملأُ الجفناتِ في الجحراتِ"],["2D8686F9-BEE0-5339-A685-238711B6B600","و من يرجعُ الرمحَ الأصمَّ كعوبهُ","عليهِ دماءُ القومِ كالشقراتِ"]]},"43A5306E-495D-5DE2-8828-9B6F0D8C1E2C":{"t":"ألا لاتْفَخرَنْ أسَدُ عَلَيْنَا","p":17,"s":"ألا لاتفخرن أسد علينا","r":"436168","v":[["0231F993-8456-5F80-8C86-4E653CA6505A","ألا لاتْفَخرَنْ أسَدُ عَلَيْنَا","بِيَوم كان حِينَا في الكِتَابِ"],["CC749A4C-E47E-5133-8B84-D1F64A8F810B","فقدْ قطعتْ رؤوسٌ من قعينٍ","وَقَدْ نَقَعَتُ صُدُورُ مِن شَرَابِ"],["C6875CA5-6D13-5EFD-96ED-40550B585335","وأرْدَيْنَا ابنَ حَسْحاسٍ فأَضْحى","تجولُ بشلوهِ نجسُ الذئابِ"]]},"FBD24F83-4E03-5ABC-B8E0-6D9BF4A14CA8":{"t":"ألا من مبلغٌ عمرو بنَ هندٍ","p":17,"s":"ألا من مبلغٌ عمرو بنَ هندٍ","r":"436173","v":[["C1DEE64A-4D15-5621-AC5A-73C4DDF906D8","ألا من مبلغٌ عمرة بنَ هندٍ","وقد لا تَعْدَمُ الحَسْنَاءُ ذاما"],["80DCE157-1542-5CEC-AC78-E9C089939BD3","كما أخْرَجْتَنَا مِنْ أرْضِ صِدْقٍ","تَرى فِيها لمُغَتبِط مُقاما"],["FC91F2B1-75BD-5327-BCCB-E57136D0D031","كَمَا قالتْ فتاةُ الحيّ لَمَّا","أحسَّ جنانها جيشاً لهاما"],["EE62F86A-68E5-5D5C-8E8D-29AAEC36B3C5","لوالِدها وأرْأتْه بِلَيْل","قَطًا ولَقَلّ ما تَسْرِي ظَلاَمًا"],["BADD0C64-3F82-5CEF-A128-51F0E9886E6B","ألَسْتَ تَرى القَطا مُتَوتراتٍ","وَلَوْ تُرِكَ القطا لغَفَا وَناما"]]},"68B54389-118F-5665-B3EC-03F65262A5D3":{"t":"ألاَ هَلَكَ المُلوكُ وعَبْدُ عَمْرو","p":17,"s":"ألا هلك الملوك وعبد عمرو","r":"436174","v":[["D99EEBAB-A32E-5518-A300-C008AD790AF9","ألاَ هَلَكَ المُلوكُ وعَبْدُ عَمْرو","و خليتِ العراقُ لمن بغاها"],["C1992E7D-4B17-5EDF-A348-7E8EEA9DFBF9","فَكَمْ مِنْ والدٍ لَكَ يابنَ بِشْرٍ","تَأَزَّرَ بالمكَارِم وارْتَدَاهَا"],["23FDF132-066D-5014-BCA3-B0B3EAF21C8E","بَنىَ لَكَ مَرْثَد وأُبوك بِشْرٌ","عَلى الشم البَواذِخِ مِنْ ذُراهَا"]]},"E235596A-A215-5519-84EE-D46AC1303ACA":{"t":"إنَّ بني الحصنِ استحلتْ دماءهمْ","p":17,"s":"إن بني الحصن استحلت دماءهم","r":"436165","v":[["C1931595-D9AF-5B13-AEDC-AFA56DC8678C","إنَّ بني الحصنِ استحلتْ دماءهمْ","بنو أسدٍ حاربها ثمَّ والبهْ"],["AC7AC6CB-7CE6-599F-BA4A-BC4AB22A359C","همُ جدعوا الأنفَ الأشمَّ فأوعبوا","وجبوا السنام فالتحوه وغاربه"]]},"89C4513B-0912-52F3-94D4-5711ECDE87BD":{"t":"سَمِعَتْ بنُو أسَدَ الصيَاح فَزَادَهَا","p":17,"s":"سمعت بنو أسد الصياح فزادها","r":"436169","v":[["8F5F9A2B-17C2-5236-8646-7F45E20A6346","سَمِعَتْ بنُو أسَدَ الصيَاح فَزَادَهَا","عِنْدَ اللِّقَاءِ مع النِّفارِ نِفارا"],["0EDEBE0F-5821-5C90-92A2-637242C39EEB","و رأتْ فوارسَ من صليبةِ وائلٍ","صُبُراً إذا نَقْعُ السَّنَابكِ ثَارَا"],["E6F7F771-56AA-5AC8-B285-45E7D1E56DA4","بيضا يُحَزِّزْنَ العِظام كأنما","يُوقِدْنَ في حَلق الَمَغاِفِر نارا"]]},"67174110-FCCE-5A68-9825-A925E99D5F16":{"t":"عفا من آل ليلى السهـ","p":17,"s":"عفا من آل ليلى السهـ","r":"436176","v":[["D118A40C-1A9B-598A-A5A1-55788A74217A","عفا من آل ليلى السهـ","ـبُ فالأملاح فالغمر"],["E92BBB99-9140-500F-8622-80C519D386FB","فعرقٌ فالرماح فالـ","ـسلوى من أهله قفر"],["16A8BAC6-E058-5200-BE04-73A2003AEADF","وأبليَّ إلى العزا","فالمأوان فالحجرِ"],["765A9B53-B74B-5BCE-9FBB-6398507BD6C5","فأمواهُ الدنا فالنجـ","ـدُ فالصحراء فالنسر"],["25D17887-883D-596B-9541-69C4C82F26D7","فلاةٌ ترتعيها العيـ","ـنُ، فالظلمانُ فالعفرُ"]]},"BE4C5095-B3A7-5349-847B-07D812183992":{"t":"عَدَدْنالهُ خَمْسا وعشرين حجَّةً","p":17,"s":"عددناله خمسا وعشرين حجة","r":"436164","v":[["3F7118F4-DBCE-5CC4-9C5D-B2F86CDF9E8E","عَدَدْنالهُ خَمْسا وعشرين حجَّةً","فلما توفاها استوى سيداً ضخما"],["A3716183-DBC4-5B53-BF2E-CB67143CBEFA","فُجِعْنا به لما رجونا إيابهُ","على خيرِ حالٍ لا وليداً ولا قحما"]]},"BECA39C7-128D-50D5-B40B-540EDC3665FB":{"t":"لايبعدنْ قوْمي الذين هُمُ","p":17,"s":"لايبعدن قومي الذين هم","r":"436167","v":[["D796C31E-1AAA-5CF5-9AB3-670F1E2EFE20","لايبعدنْ قوْمي الذين هُمُ","سمُّ العداةِ وآفةُ الجزرِ"],["E9BC0031-4189-54C2-B7B7-B5AE705D8D5F","النازلون بكُلّ مُعْتركٍ","و الطيبونَ معاقدَ الأزرِ"],["6FC19655-B808-5060-8C46-50916345880F","الضّارِبون بحَوْمةٍ نُزِلَتْ","والطَّاعِنُونَ بأذْرُعٍ شُعرِ"],["B76DEA07-0552-5460-889A-DA6C5C752965","والخالطونَ نَحيتُهُمْ بِنُضَارِهِم","و ذوي الغنى منهمْ بذي الفقرِ"],["88541C61-8241-53B5-8495-EF76A3B3CBDC","إنْ يشْرَبُوا يَهَبُوا وإن يَذَرُوا","يَتَواعَظُوا عَنْ مَنْطِقِ الهُجْرِ"],["87365053-CBA8-5F67-AEC1-022714087793","قومٌ إذا ركبوا سمعتَ لهمْ","لَغَطاً من التَّأْيِيْهِ والزّجر"],["7E3B17D3-DBC6-55C4-AEF9-92D88D074805","من غيْرِ ما فُحْشٍ يَكُونُ بِهم","في منتجِ المهراتِ والمهرِ"],["4828E3E9-22E7-599F-85EE-A9832E19D211","لاقَوْا غَدَاة قُلابَ حتفهمُ","سَوْقَ العَتِيرِ يُساق لِلعَتر"],["F6A6CD9F-D16B-5AAC-B310-C749AD16AF54","هذا ثنائي ما بقيتُ لهمْ","فإذا هلكتُ أجنني قبري"]]},"7660B4BE-E38E-5679-9614-F2F894AE6591":{"t":"لَقَدْ عَلِمَتْ جَديلَةُ أن بِشْرا","p":17,"s":"لقد علمت جديلة أن بشرا","r":"436172","v":[["F2769D97-6840-5357-9427-563614B6A7CF","لَقَدْ عَلِمَتْ جَديلَةُ أن بِشْرا","غَدَاةَ مُربِّحٍ مُرُّ التقَاضي"],["F221C37F-1535-5A08-B591-32FCAB9B0C81","غداةَ أتاهمُ بالخيلِ شعثاً","يَدُّق نُسُورَهاحدّ القِضَاضِ"],["438461A1-483B-5805-AE94-8986334F4100","عليها كلُّ أصيدَ تغلبيًّ","كريمِ مركبِ الحدينِ ماضِ"],["76087E96-2909-5120-8295-1EA7383F0563","بأيديهمْ صوارمُ مرهفاتٌ","جلاها القينُ، خالصةُ البياضِ"],["2A1949FB-5F06-53C1-AF44-7E39665FEC3A","و كلُّ مثقفٍ بالكفَّ لدنٍ","وسابغةٍ مِن الحلَقَ المُفَاض"],["80189759-9D2C-53EE-917F-7C92B4DF53B5","فغادرَ معقلاً وأخاهُ حصناً","عفيرَ الوجهِ ليس بذي انتهاضِ"]]},"02EFB93F-71A3-5999-B012-E93188D49637":{"t":"يارُبَّ غَيْث قَدْ قَرَى عَازِبٍ","p":17,"s":"يارب غيث قد قرى عازب","r":"436171","v":[["57BE1D14-B5C7-57BE-8854-D08E85BB9402","يارُبَّ غَيْث قَدْ قَرَى عَازِبٍ","أجَشَّ أحْوَى في جُمَادَى مَطِير"],["A872D896-D17C-5BD6-8D3C-AC7A6B04AC95","قادَ به أجردُ ذو ميعةٍ","عبلاً شواهُ غيرُ كابٍ عثورْ"],["4834516C-B8DE-569C-9F07-A9A879A441EC","فألبسَ الوحشَ بحافاتهِ","و التقطَ البيضَ بجنبِ السديرِ"],["44DBF9F1-C7A2-57D4-B221-5E4D6F427B9A","ذاك وقِدما يُعجل البازِل الـ","ـكوماءَ بالموتِ كشبهِ الحصيرْ"],["5B26AB5B-0634-56A4-99C3-B8466A9CDE10","يَبْغِي عَلَيْها الْقَوْمَ إذ أرْمَلُوا","و ساءَ ظنُّ الألمعيَّ القرورْ"],["4908EF7D-BF32-50B3-B58D-48F91981957A","آب وقَدْ غَنَّم أصْحَابَهُ","يلوي على أصحابهِ بالبشيرْ"]]}}}