{"v":1,"poems":{"8FF4B6F8-D317-50DE-AD7E-6D30AB36428A":{"t":"معلقة عبيد بن الأبرص","p":14,"s":"معلقة عبيد بن الأبرص","r":"532030","v":[["5E3AD641-F7C9-5FA4-9462-669DDED6DA25","أَقفَرَ مِن أَهلِهِ مَلْحوبُ","فالقُطبيَّات فالذَّنوبُ"],["2B5A5775-05AD-5372-8032-265F3BCCBE67","فَراكِسٌ فثُعَيلٍباتٌ","فَذاتَ فَرقَينِ فالقَلِيبُ"],["B980B32A-DEDF-5E58-A6B1-66F0664A5E73","فَعَرْدةٌ، فَقَفا حِبِرٍّ","لَيسَ بِها مِنهُمُ عَريبُ"],["F6FE4A13-F2D2-53BD-A9FD-37CBE663B659","إن بُدِّلَتْ أهْلِها وُحوشًا","وغًيَّرتْ حالَها الخُطُوبُ"],["90AA2897-1C46-535D-B00F-EAFE9173E08E","أرضٌ تَوارَثَها الجُدوبُ","فَكُلُّ من حَلَّها مَحْروبُ"],["3E0DA58D-E6C2-58F6-9E90-4FDCD983A72E","إمَّا قَتيلاً وإمَّا هَلْكًا","والشَّيْبُ شَيْنٌ لِمَنْ يَشِيبُ"],["B445D52B-0D33-5ECC-B36B-77A426B1C269","عَيناكَ دَمْعُهما سَروبٌ","كأنَّ شَأنَيهِما شَعِيبُ"],["7796C34E-FEA6-5457-B50B-F1BCE9CD7B41","واهِيةٌ أو مَعينُ مَمعْنٍ","مِنْ هَضْبةٍ دونَها لَهوبُ"],["3D819C0B-131C-56A1-BB7C-975763169979","أو فَلْجُ وادٍ بِبَطْنِ وادٍ","لِلماءِ مِنْ تَحتِها سَكوبُ"],["6759BFEA-FCEB-596E-B79E-E34CBCA1FB11","أوْ جَدولٌ في ظِلالِ نَخْلٍ","لِلماءِ مِنْ تَحْتِها قَسيبُ"],["C6396ADA-C7D7-5D5E-8A87-6DBB51E27BCA","تَصْبو وأنَّى لكَ التَّصابي؟","أنَّي وقَد راعَكَ المَشيبُ؟"],["C0BB29EB-411B-5C33-8992-8050064B92E2","فإنْ يَكُنْ حالَ أجْمَعِها","فلا بَدِيٌّء ولا عَجيبُ"],["93B16164-D422-5B13-8AFA-44CF90CBF887","أوْ يكُ أقْفَرَ مِنها جَوُّها","وعادَها المَحْلُ والجُدوبُ"],["DD7FE64A-3031-50B0-A1E1-62A619FEF194","وكُلُّ ذي نِعْمةٍ مَخلوسٌ","وكُلُّ ذي أمَلٍ مَكذوبُ"],["405BAF87-A85B-5E8F-9AB7-E404C3345BD5","وكُلُّ ذي إبِلٍ مَوْروثٌ","وكُلُّ ذي سَلْبٍ مَسْلوبُ"],["314B3E83-2361-54C2-8EAA-F77BD7B922C8","وكُلُّ ذي غَيْبةٍ يَؤوبُ","وغائِبُ المَوْتِ لا يَؤوبُ"],["90628CA8-87D5-580B-939D-BFCE56315FBB","أعاقِرٌ مِثْلُ ذاتِ رَحْمٍ؟","أم غانِمٌ مِثْلُ مَنْ يَخيبُ؟"],["06A31756-1A6F-5F8D-AB3E-9B336413E2E5","مَنْ يَسْألِ النَّاسَ يَحْرِمُوهُ","وسائِلُ اللهِ لا يَخيبُ"],["FBE739FA-A78D-59F1-86D0-FE7383F067C4","أفْلِحْ بِما شِئْتَ قدْ يَبلُغُ بال","ضَّعْفِ وقَدْ يُخْدَعُ الأرِيبُ"],["AF8D16A0-F8F8-52BB-8F8C-F7E9D74D5297","لا يَعِظُ النَّاسُ مَنْ لا يَعِظُ الدْ","دَهْرُ ولا يَنْفَعُ التَّلْبِيبُ"],["57D7B657-9786-56C7-8357-9347B8BBA42D","إلاَّ سَجِيَّاتُ ما القُلُوبُ","وكم يُصَيِّرْنَ شانئاً حَبِيبُ"],["32A131D4-A92E-5591-B558-16A0D29521F0","ساعِدْ بِأرضٍ إنْ كُنتَ فيها","ولا تَقُلْ إنَّني غَريبُ"],["274E50D4-4EA5-50FF-A741-49C578B813B9","قدْ يُوصَلُ النَّازِحُ النَّائي وقد","يُقْطَعُ ذو السُّهْمَةِ القَريبُ"],["7C028890-2CF0-5E88-A286-1A50013474E3","والمَرْءُ ما عاشَ في تَكْذيبٍ","طُولُ الحَياةِ لهُ تَعْذيبُ"],["AEDF3594-6F3D-5062-984D-846523DEC613","بل رُبَّ ماءٍ وَرَدتُّ آجِنٍ","سَبيلُهُ خائفٌ جَدِيبُ"],["8E033432-C5BE-5FA5-BB6E-6FFC2E3AFCA0","رِيشُ الحَمامِ على أرْجائِهِ","لِلقَلبِ مِنْ خَوْفِهِ وَجِيبُ"],["4D2AC7B6-2204-5B4F-A417-10A684858BAB","قَطَعتهُ غُدْوة مُشِيحاً","وصاحِبي بادِنٌ خَبوبُ"],["579A4A28-1621-5D3D-9D48-C3768CEAAB42","غَيْرانةٌ مُوجَدٌ فَقارُها","كأنَّ حارِكَها كَثِيبُ"],["0B75B927-22C7-5D1B-838A-4C1E5D31CA5D","أَخلَفَ ما باذلاً سَديسُها","لا حِقَّةٌ هِيَ ولا نَيُوبُ"],["041C43B0-4474-5AD4-A98B-29F3529A2F8E","كَأنَّها مِن حَميرِ غابٍ","جَوْنٌ بِصَفْحَتِهِ نُدوبُ"],["2AED4E8B-3BD1-5DD5-9308-7E9FBB24A6E4","أَو شَبَبٌ يَحفِرُ الرُخامى","تَلُفُّهُ شَمألٌ هُبوبُ"],["2B4AB80C-0B05-5A93-B79D-FF746C7A091D","فذاكَ عَصْرٌ، وقدْ أراني","تَحمِلُني نَهدَةٌ سُرحوبُ"],["3B3E92BC-84C3-55F0-AAFA-5DB6611E931D","مُضَبَّرٌ خَلقُها تَضبيراً","يَنْشَقُّ عَنْ وَجْهِها السَّبيبُ"],["374798A9-4574-58A2-922D-025D983EBAEE","زَيتِيَّةٌ ناعِمٌ عُروقُها","وَلَيِّنٌ أَسرُها رَطيبُ"],["503F1883-E006-52C3-B976-31FD686039FE","كَأَنَّها لِقوةٌ طَلوبُ","تُخزَنُ في وَكرِها القُلوبُ"],["C0EFCDA7-0C6A-5B66-974B-390147D069AF","بانَت عَلى إِرَمٍ عَذوباً","كَأَنَّها شَيخَةٌ رَقوبُ"],["BF353A6C-7031-5221-ABB8-BDEE25BCB9BC","فَأَصبَحَت في غَداةِ قِرَّةٍ","يَسْقُطُ عَنْ رِيشِها الضَّريبُ"],["DC4824D2-91E0-544A-BCF0-F8BB1985A236","فَأَبصَرَت ثَعلَباً مِن ساعَةٍ","وَدونَهُ سَبسَبٌ جَديبُ"],["A4DB9C18-C034-57FA-AA43-140232145A7D","فَنَفَضَت ريشَها وَاِنتَفَضَت","وَهيَ مِن نَهضَةٍ قَريبُ"],["A343F72F-916C-51CC-87F3-068B5DB53E79","فَاِشتالَ وَاِرتاعَ مِن حَسيسِها","وَفِعلَهُ يَفعَلُ المَذؤوبُ"],["B89C624E-C8CC-564F-AC9C-1A94D88E68D5","فَنَهَضَت نَحوَهُ حَثيثَةً","وَحَرَدَت حَردَةً تَسيبُ"],["49563DA4-24A0-5CC5-BB31-BACD21641DE2","يَدِبُّ مِن حِسِّها دَبيباً","وَالعَينُ حِملاقُها مَقلوبُ"],["BFC45CA6-74FE-511C-819E-BB5B507C6C4A","فَأَدرَكَتهُ فَطَرَّحَتهُ","والصَّيْدُ مِنْ تَحْتِها مَكْروبُ"],["7417360A-49D4-54F3-8B29-D7BA5DEA6F13","فَجَدَّلَتهُ فَطَرَّحَتهُ","فكَدَّحَتْ وَجْهَهُ الجَبوبُ"],["4BAE7768-C46A-57EB-A803-FA3635757E5B","فعاوَدَتْهُ فَرَفَّعَتْهُ","فأرْسَلَتْهُ وهُوَ مَكْروبُ"],["9F6A4519-A1FB-55C1-9465-EC783D1D48A2","يَضغو وَمِخلَبُها في دَفِّهِ","لا بُدَّ حَيْزومُهُ مَنقُوبُ"],["205AF141-CFF3-50D8-8CF6-DED82D94A9B5","أقفر من أهله ملحوب","فالقطبيات فالذَنوب"],["566FBDE5-1CD6-5B8B-84AD-1E0854945B5A","فراكس فثعيلبات","فذات فرقين فالقليب"],["6ECA33A8-057D-550E-A189-58421BB5E2C5","فعردة، فقفا حبر","ليس بها منهم عريب"],["9BD4EF4E-3409-5711-A369-880B0BCC6993","إن بدلت أهلها وحوشا","وغيرت حالها الخطوب"],["749F25B2-3AA7-58B9-B0A6-7158BED52F19","أرض توارثها الجدوب","فكل من حلها محروب"],["E39BD312-2E27-516B-AAC0-CC62A841A1E1","إما قتيلا وإما هلكا","والشيب شين لمن يشيب"],["34CEB2B3-DBCB-5E2F-B485-3FDE75D36B4F","عيناك دمعهما سروب","كأن شأنيهما شعيب"],["CAE45EA5-7794-5053-8ED8-EE1EAC883D62","واهية أو معين ممعن","من هضبة دونها لهوب"],["C5A8D499-BA84-51C1-B25B-6964C29AF010","أو فلج واد ببطن واد","للماء من تحتها سكوب"],["FE9CD8BA-D4F3-5E3D-B785-07CB4F8E6D82","أو جدول في ظلال نخل","للماء من تحتها قَسيب"],["F56461B4-2AC1-5F11-8A4A-09FD1B99FFAD","تصبو وأنى لك التصابي؟","أني وقَد راعك المشيب؟"],["24D50076-7D40-5543-8FB8-56886C0B523E","فإن يكن حال أجمعها","فلا بديء ولا عجيب"],["57B50947-6550-58AE-AD70-C2AF205EEE63","أو يك أقفر منها جوها","وعادها المحل والجدوب"],["4573F655-05AF-5F41-9BE4-B0CBEA896917","وكل ذي نعمة مخلوس","وكل ذي أمل مكذوب"],["4E249965-0B92-5EA5-A0F6-A07A7838CF21","وكل ذي إبل موروث","وكل ذي سلب مسلوب"],["EFF0AC09-01D9-5DC8-A046-A8FFD0317705","وكل ذي غيبة يؤوب","وغائب الموت لا يؤوب"],["78115823-D447-5370-8C73-AB8136BC9DCE","أعاقر مثل ذات رحم؟","أم غانم مثل من يخيب؟"],["E0850859-F938-5233-83B8-6B6D8AEA70C7","من يسأل الناس يحرِموه","وسائل الله لا يخيب"],["AE95E93E-41F4-51D9-95B5-466C054555D8","أفلح بما شئت قد يبلغ بال","ضعف وقد يخدع الأريب"],["C1B706D4-C04A-5FA8-8A62-CD203BE0333A","لا يعظ الناس من لا يعظ الد","دهر ولا ينفع التلبيب"],["3AF8C6B5-C45B-5834-9F72-1842D0F23E8C","إلا سجيات ما القلوب","وكم يصيِرن شانئا حبيب"],["69B1FF57-B63A-5F94-9CE0-AE99A896F8B3","ساعد بأرض إن كنت فيها","ولا تقل إنني غريب"],["F32CFB1E-367C-57EF-9FEE-E4C6D7C7B1D4","قد يوصل النازِح النائي وقد","يقطع ذو السهمة القريب"],["351C3CED-D7AE-55C6-BE03-B4F71D9D6DC2","والمرء ما عاش في تكذيب","طول الحياة له تعذيب"],["824E58CD-0B9B-5D30-AE09-A05DAF2265AE","بل رب ماء وردت آجن","سبيله خائف جديب"],["47A47996-AD11-5354-80FE-C5A6AEA93CC8","رِيش الحمام على أرجائه","للقلب من خوفه وجيب"],["E34CEB1A-3B2F-5BA6-B047-B914F267669E","قطعته غدوة مشيحا","وصاحبي بادن خبوب"],["A6D1A95D-0F0A-569C-9797-BE86CAB635B9","غيرانة موجد فقارها","كأن حارِكها كثيب"],["7E4179E4-B79C-54BA-A541-AB57754CC814","أخلف ما باذلا سديسها","لا حقة هي ولا نيوب"],["6C0B1A4F-E4B3-5628-83D3-C66C43AD534A","كأنها من حمير غاب","جون بِصفحته ندوب"],["7BBA4811-3064-5934-AACF-4C31731D4C9C","أو شبب يحفر الرخامى","تلفه شمأل هبوب"],["D39634BF-A447-5B28-99CA-84F772FE2C43","فذاك عصر، وقد أراني","تحملني نهدة سرحوب"],["361577F2-8106-59B6-AE8E-B38AEBF99B1B","مضبر خلقها تضبيرا","ينشق عن وجهها السبيب"],["19CD19F8-38EB-5635-AA9A-300FD018F7C9","زيتية ناعم عروقها","وليِن أسرها رطيب"],["3A90E986-A870-5C58-8992-AFC82E1BDB04","كأنها لقوة طلوب","تخزن في وكرها القلوب"],["D8AC7EF1-5EA3-52AD-8A30-C84C8D211ECC","بانت على إِرم عذوبا","كأنها شيخة رقوب"],["4DD53497-614E-573B-B956-3D42DE76DACE","فأصبحت في غداة قرة","يسقط عن ريشها الضريب"],["B9EBDDD5-62DF-5AB6-BEB4-8FD6587F7AE1","فأبصرت ثعلبا من ساعة","ودونه سبسب جديب"],["4F3E65FB-E4C8-5207-BC58-F9E5867634B8","فنفضت ريشها وانتفضت","وهي من نهضة قَريب"],["625FA8D1-0428-5275-8067-A91870786A92","فاشتال وارتاع من حسيسها","وفعله يفعل المذؤوب"],["1105C5EC-4662-5A60-A213-F87D7D4A28C8","فنهضت نحوه حثيثة","وحردت حردة تسيب"],["6FF26C92-6183-5206-8965-35DA72E0C1E5","يدب من حسها دبيبا","والعين حملاقها مقلوب"],["0046879E-005E-5D8B-B19E-D08F8EB91527","فأدركته فطرحته","والصيد من تحتها مكروب"],["788C18AB-1AA9-584C-986A-2BE13A2E6AAC","فجدلته فطرحته","فكدحت وجهه الجبوب"],["0E9FEC52-18B6-5905-9A22-AFB43F39B958","فعاودته فرفعته","فأرسلته وهو مكروب"],["AF06DEAE-4F13-50D0-AD03-93C07514E428","يضغو ومخلبها في دفه","لا بد حيزومه منقوب"]]}}}